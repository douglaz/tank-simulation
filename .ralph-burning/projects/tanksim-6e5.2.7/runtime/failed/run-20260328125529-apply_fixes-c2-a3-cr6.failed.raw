## Authoritative JSON Schema

The JSON schema below is authoritative. Return only JSON that conforms exactly to it.

```json
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ExecutionStep": {
      "properties": {
        "description": {
          "type": "string"
        },
        "order": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "status": {
          "$ref": "#/definitions/StepStatus"
        }
      },
      "required": [
        "description",
        "order",
        "status"
      ],
      "type": "object"
    },
    "StepStatus": {
      "enum": [
        "intended",
        "completed",
        "skipped"
      ],
      "type": "string"
    }
  },
  "description": "Payload for execution/update stages.\n\nRequires structured change summaries, intended or completed steps, validation evidence or plans, and outstanding-risk fields.",
  "properties": {
    "change_summary": {
      "type": "string"
    },
    "outstanding_risks": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
