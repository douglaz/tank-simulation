          "type": "string"
        },
        "order": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "status": {
          "$ref": "#/definitions/StepStatus"
        }
      },
      "required": [
        "description",
        "order",
        "status"
      ],
      "type": "object"
    },
    "StepStatus": {
      "enum": [
        "intended",
        "completed",
        "skipped"
      ],
      "type": "string"
    }
  },
  "description": "Payload for execution/update stages.\n\nRequires structured change summaries, intended or completed steps, validation evidence or plans, and outstanding-risk fields.",
  "properties": {
    "change_summary": {
      "type": "string"
    },
    "outstanding_risks": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "steps": {
      "items": {
        "$ref": "#/definitions/ExecutionStep"
      },
      "type": "array"
    },
    "validation_evidence": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "change_summary",
    "outstanding_risks",
    "steps",
    "validation_evidence"
  ],
  "title": "ExecutionPayload",
  "type": "object"
}
