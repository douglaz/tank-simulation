{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HWEvLvNhnr9AZUw5gkPTJq","type":"tool_result","content":"     1→use std::collections::VecDeque;\n     2→\n     3→use crate::{\n     4→    invariants::enforce_invariants,\n     5→    rng::SimSeed,\n     6→    systems,\n     7→    types::{\n     8→        EventCause, EventKind, EventSeverity, PlayerAction, SimError, SimEvent, TankSnapshot,\n     9→        TankState,\n    10→    },\n    11→};\n    12→\n    13→pub trait SimulationEngine {\n    14→    fn apply_action(&mut self, action: PlayerAction) -> Result<(), SimError>;\n    15→    fn step_hours(&mut self, hours: u32) -> Result<(), SimError>;\n    16→    fn snapshot(&self) -> TankSnapshot;\n    17→    fn full_state(&self) -> &TankState;\n    18→}\n    19→\n    20→#[derive(Debug, Clone, PartialEq)]\n    21→pub struct Engine {\n    22→    state: TankState,\n    23→    queued_actions: VecDeque<PlayerAction>,\n    24→}\n    25→\n    26→impl Engine {\n    27→    pub fn new(seed: SimSeed) -> Self {\n    28→        Self {\n    29→            state: TankState::new(seed),\n    30→            queued_actions: VecDeque::new(),\n    31→        }\n    32→    }\n    33→\n    34→    pub fn from_parts(state: TankState, queued_actions: Vec<PlayerAction>) -> Self {\n    35→        Self {\n    36→            state,\n    37→            queued_actions: queued_actions.into(),\n    38→        }\n    39→    }\n    40→\n    41→    pub fn queued_actions(&self) -> Vec<PlayerAction> {\n    42→        self.queued_actions.iter().cloned().collect()\n    43→    }\n    44→\n    45→    fn step_one_hour(&mut self) -> Result<(), SimError> {\n    46→        // Pre-validate all water changes for known source profiles before any mutations.\n    47→        let actions_slice: Vec<_> = self.queued_actions.iter().cloned().collect();\n    48→        systems::water_change::validate_water_changes(&self.state, &actions_slice)?;\n    49→\n    50→        // Process all queued actions\n    51→        while let Some(action) = self.queued_actions.pop_front() {\n    52→            self.process_action(action);\n    53→        }\n    54→\n    55→        // Step 4: update water temperature from ambient and heater\n    56→        systems::temperature::step_temperature(&mut self.state);\n    57→\n    58→        // Advance time\n    59→        self.state.environment.hour_of_day = (self.state.environment.hour_of_day + 1) % 24;\n    60→        if self.state.environment.hour_of_day == 0 {\n    61→            self.state.environment.day += 1;\n    62→        }\n    63→\n    64→        enforce_invariants(&mut self.state)\n    65→    }\n    66→\n    67→    fn process_action(&mut self, action: PlayerAction) {\n    68→        match action {\n    69→            PlayerAction::Feed { grams } => {\n    70→                self.state.detritus.particulate_organics_g_total += grams;\n    71→                self.push_event(\n    72→                    EventSeverity::Info,\n    73→                    EventKind::CycleProgressing,\n    74→                    vec![EventCause::Overfeeding],\n    75→                    format!(\"Queued feed processed: {grams:.2} g\"),\n    76→                );\n    77→            }\n    78→            PlayerAction::WaterChangePercent {\n    79→                percent,\n    80→                source_profile_id,\n    81→            } => {\n    82→                if percent <= 0.0 {\n    83→                    return;\n    84→                }\n    85→                // Profile was pre-validated; look it up (guaranteed to exist).\n    86→                let profile = self\n    87→                    .state\n    88→                    .source_water_catalog\n    89→                    .get(&source_profile_id)\n    90→                    .cloned();\n    91→                if let Some(profile) = profile {\n    92→                    systems::water_change::apply_water_change(\n    93→                        &mut self.state,\n    94→                        percent,\n    95→                        &profile,\n    96→                    );\n    97→                    self.push_event(\n    98→                        EventSeverity::Info,\n    99→                        EventKind::StabilityImproving,\n   100→                        vec![EventCause::WaterChange],\n   101→                        format!(\"Water change processed: {percent:.1}% with {source_profile_id}\"),\n   102→                    );\n   103→                }\n   104→            }\n   105→            PlayerAction::TrimPlants { fraction } => {\n   106→                for plant in &mut self.state.plant_guilds {\n   107→                    plant.biomass_g *= 1.0 - fraction;\n   108→                }\n   109→            }\n   110→            PlayerAction::SiphonDetritus { fraction } => {\n   111→                self.state.detritus.particulate_organics_g_total *= 1.0 - fraction;\n   112→                self.state.detritus.fine_detritus_g_total *= 1.0 - fraction;\n   113→            }\n   114→            PlayerAction::CleanFilter { intensity } => {\n   115→                self.state.hardware.filter.cleanliness_index = 1.0;\n   116→                self.state.filter_state.biofilter_maturity_index *= 1.0 - (intensity * 0.5);\n   117→                self.state.filter_state.clogging_index *= 1.0 - intensity;\n   118→                self.push_event(\n   119→                    EventSeverity::Warning,\n   120→                    EventKind::FilterCleaningSetback,\n   121→                    vec![EventCause::FilterMaintenance],\n   122→                    format!(\"Filter cleaned at intensity {intensity:.2}\"),\n   123→                );\n   124→            }\n   125→            PlayerAction::AddShrimp { count } => {\n   126→                self.state.animal.adults_count =\n   127→                    self.state.animal.adults_count.saturating_add(count);\n   128→            }\n   129→            PlayerAction::RemoveShrimp { count } => {\n   130→                self.state.animal.adults_count =\n   131→                    self.state.animal.adults_count.saturating_sub(count);\n   132→            }\n   133→            PlayerAction::ChangePhotoperiod { hours } => {\n   134→                self.state.hardware.light.photoperiod_hours = hours;\n   135→            }\n   136→            PlayerAction::ChangeLightIntensity { intensity_index } => {\n   137→                self.state.hardware.light.intensity_index = intensity_index;\n   138→            }\n   139→            PlayerAction::ChangeHeaterSetpoint { setpoint_c } => {\n   140→                self.state.hardware.heater.setpoint_c = setpoint_c;\n   141→            }\n   142→            PlayerAction::ChangeAmbientTemperature { target_c } => {\n   143→                self.state.environment.ambient_temp_c = target_c;\n   144→            }\n   145→            PlayerAction::ChangeAeration { enabled, intensity } => {\n   146→                self.state.hardware.aeration.enabled = enabled;\n   147→                self.state.hardware.aeration.intensity = intensity;\n   148→            }\n   149→        }\n   150→    }\n   151→\n   152→    fn push_event(\n   153→        &mut self,\n   154→        severity: EventSeverity,\n   155→        kind: EventKind,\n   156→        cause_codes: Vec<EventCause>,\n   157→        summary: String,\n   158→    ) {\n   159→        self.state.event_log.push(SimEvent::new(\n   160→            self.state.environment.day,\n   161→            self.state.environment.hour_of_day,\n   162→            severity,\n   163→            kind,\n   164→            cause_codes,\n   165→            summary,\n   166→        ));\n   167→    }\n   168→}\n   169→\n   170→impl SimulationEngine for Engine {\n   171→    fn apply_action(&mut self, action: PlayerAction) -> Result<(), SimError> {\n   172→        action.validate()?;\n   173→        self.queued_actions.push_back(action);\n   174→        Ok(())\n   175→    }\n   176→\n   177→    fn step_hours(&mut self, hours: u32) -> Result<(), SimError> {\n   178→        for _ in 0..hours {\n   179→            self.step_one_hour()?;\n   180→        }\n   181→        enforce_invariants(&mut self.state)\n   182→    }\n   183→\n   184→    fn snapshot(&self) -> TankSnapshot {\n   185→        TankSnapshot::from_state(&self.state)\n   186→    }\n   187→\n   188→    fn full_state(&self) -> &TankState {\n   189→        &self.state\n   190→    }\n   191→}\n   192→"}]},"parent_tool_use_id":"toolu_01SdK2x77EeKtVykT9EyhLAo","session_id":"6255bc57-f0df-446f-b528-6846cbe58c9c","uuid":"c59d08b5-9956-4c5b-a7df-77aad7c525c5"}
