nt,\n    95→                        &profile,\n    96→                    );\n    97→                    self.push_event(\n    98→                        EventSeverity::Info,\n    99→                        EventKind::StabilityImproving,\n   100→                        vec![EventCause::WaterChange],\n   101→                        format!(\"Water change processed: {percent:.1}% with {source_profile_id}\"),\n   102→                    );\n   103→                }\n   104→            }\n   105→            PlayerAction::TrimPlants { fraction } => {\n   106→                for plant in &mut self.state.plant_guilds {\n   107→                    plant.biomass_g *= 1.0 - fraction;\n   108→                }\n   109→            }\n   110→            PlayerAction::SiphonDetritus { fraction } => {\n   111→                self.state.detritus.particulate_organics_g_total *= 1.0 - fraction;\n   112→                self.state.detritus.fine_detritus_g_total *= 1.0 - fraction;\n   113→            }\n   114→            PlayerAction::CleanFilter { intensity } => {\n   115→                self.state.hardware.filter.cleanliness_index = 1.0;\n   116→                self.state.filter_state.biofilter_maturity_index *= 1.0 - (intensity * 0.5);\n   117→                self.state.filter_state.clogging_index *= 1.0 - intensity;\n   118→                self.push_event(\n   119→                    EventSeverity::Warning,\n   120→                    EventKind::FilterCleaningSetback,\n   121→                    vec![EventCause::FilterMaintenance],\n   122→                    format!(\"Filter cleaned at intensity {intensity:.2}\"),\n   123→                );\n   124→            }\n   125→            PlayerAction::AddShrimp { count } => {\n   126→                self.state.animal.adults_count =\n   127→                    self.state.animal.adults_count.saturating_add(count);\n   128→            }\n   129→            PlayerAction::RemoveShrimp { count } => {\n   130→                self.state.animal.