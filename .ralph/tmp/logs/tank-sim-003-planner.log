{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DkZXG39b9LV4wCybJmYzbn","type":"tool_result","content":"     1→mod presets;\n     2→\n     3→use serde::de::DeserializeOwned;\n     4→use thiserror::Error;\n     5→\n     6→pub use presets::{\n     7→    PlantPreset, ProcessParamsPreset, Provenance, ScenarioPreset, ShrimpPreset, SourceWaterPreset,\n     8→    SubstratePreset,\n     9→};\n    10→\n    11→#[derive(Debug, Error)]\n    12→pub enum PresetError {\n    13→    #[error(\"unknown preset `{id}` in category `{category}`\")]\n    14→    UnknownPreset { category: &'static str, id: String },\n    15→    #[error(\"failed to parse preset `{id}` in category `{category}`: {message}\")]\n    16→    Parse {\n    17→        category: &'static str,\n    18→        id: String,\n    19→        message: String,\n    20→    },\n    21→    #[error(\"validation failed for preset `{id}` in category `{category}`: {message}\")]\n    22→    Validation {\n    23→        category: &'static str,\n    24→        id: String,\n    25→        message: String,\n    26→    },\n    27→}\n    28→\n    29→pub fn load_source_water(id: &str) -> Result<SourceWaterPreset, PresetError> {\n    30→    let preset: SourceWaterPreset = load_from_registry(\"source_water\", id, SOURCE_WATER_PRESETS)?;\n    31→    preset\n    32→        .validate()\n    33→        .map_err(|message| PresetError::Validation {\n    34→            category: \"source_water\",\n    35→            id: id.to_string(),\n    36→            message,\n    37→        })?;\n    38→    Ok(preset)\n    39→}\n    40→\n    41→pub fn load_substrate(id: &str) -> Result<SubstratePreset, PresetError> {\n    42→    load_from_registry(\"substrate\", id, SUBSTRATE_PRESETS)\n    43→}\n    44→\n    45→pub fn load_plant(id: &str) -> Result<PlantPreset, PresetError> {\n    46→    load_from_registry(\"plants\", id, PLANT_PRESETS)\n    47→}\n    48→\n    49→pub fn load_shrimp(id: &str) -> Result<ShrimpPreset, PresetError> {\n    50→    load_from_registry(\"shrimp\", id, SHRIMP_PRESETS)\n    51→}\n    52→\n    53→pub fn load_process_params(id: &str) -> Result<ProcessParamsPreset, PresetError> {\n    54→    load_from_registry(\"process\", id, PROCESS_PRESETS)\n    55→}\n    56→\n    57→pub fn load_scenario(id: &str) -> Result<ScenarioPreset, PresetError> {\n    58→    load_from_registry(\"scenarios\", id, SCENARIO_PRESETS)\n    59→}\n    60→\n    61→pub fn source_water_ids() -> &'static [&'static str] {\n    62→    &[\"soft_acidic\", \"moderate\", \"hard_shrimp\", \"ro_like\"]\n    63→}\n    64→\n    65→pub fn substrate_ids() -> &'static [&'static str] {\n    66→    &[\n    67→        \"inert_sand\",\n    68→        \"inert_gravel\",\n    69→        \"active_planted\",\n    70→        \"coarse_porous\",\n    71→    ]\n    72→}\n    73→\n    74→pub fn plant_ids() -> &'static [&'static str] {\n    75→    &[\"fast_stem\", \"root_rosette\"]\n    76→}\n    77→\n    78→pub fn shrimp_ids() -> &'static [&'static str] {\n    79→    &[\"neocaridina_davidi\"]\n    80→}\n    81→\n    82→pub fn process_ids() -> &'static [&'static str] {\n    83→    &[\"default\"]\n    84→}\n    85→\n    86→pub fn scenario_ids() -> &'static [&'static str] {\n    87→    &[\"nano_cycle\", \"medium_planted\", \"warm_room\"]\n    88→}\n    89→\n    90→fn load_from_registry<T>(\n    91→    category: &'static str,\n    92→    id: &str,\n    93→    registry: &[(&str, &str)],\n    94→) -> Result<T, PresetError>\n    95→where\n    96→    T: DeserializeOwned,\n    97→{\n    98→    let Some((_, raw)) = registry.iter().find(|(entry_id, _)| *entry_id == id) else {\n    99→        return Err(PresetError::UnknownPreset {\n   100→            category,\n   101→            id: id.to_string(),\n   102→        });\n   103→    };\n   104→\n   105→    toml::from_str(raw).map_err(|error| PresetError::Parse {\n   106→        category,\n   107→        id: id.to_string(),\n   108→        message: error.to_string(),\n   109→    })\n   110→}\n   111→\n   112→const SOURCE_WATER_PRESETS: &[(&str, &str)] = &[\n   113→    (\n   114→        \"soft_acidic\",\n   115→        include_str!(\"../data/source_water/soft_acidic.toml\"),\n   116→    ),\n   117→    (\n   118→        \"moderate\",\n   119→        include_str!(\"../data/source_water/moderate.toml\"),\n   120→    ),\n   121→    (\n   122→        \"hard_shrimp\",\n   123→        include_str!(\"../data/source_water/hard_shrimp.toml\"),\n   124→    ),\n   125→    (\"ro_like\", include_str!(\"../data/source_water/ro_like.toml\")),\n   126→];\n   127→\n   128→const SUBSTRATE_PRESETS: &[(&str, &str)] = &[\n   129→    (\n   130→        \"inert_sand\",\n   131→        include_str!(\"../data/substrate/inert_sand.toml\"),\n   132→    ),\n   133→    (\n   134→        \"inert_gravel\",\n   135→        include_str!(\"../data/substrate/inert_gravel.toml\"),\n   136→    ),\n   137→    (\n   138→        \"active_planted\",\n   139→        include_str!(\"../data/substrate/active_planted.toml\"),\n   140→    ),\n   141→    (\n   142→        \"coarse_porous\",\n   143→        include_str!(\"../data/substrate/coarse_porous.toml\"),\n   144→    ),\n   145→];\n   146→\n   147→const PLANT_PRESETS: &[(&str, &str)] = &[\n   148→    (\"fast_stem\", include_str!(\"../data/plants/fast_stem.toml\")),\n   149→    (\n   150→        \"root_rosette\",\n   151→        include_str!(\"../data/plants/root_rosette.toml\"),\n   152→    ),\n   153→];\n   154→\n   155→const SHRIMP_PRESETS: &[(&str, &str)] = &[(\n   156→    \"neocaridina_davidi\",\n   157→    include_str!(\"../data/shrimp/neocaridina_davidi.toml\"),\n   158→)];\n   159→\n   160→const PROCESS_PRESETS: &[(&str, &str)] =\n   161→    &[(\"default\", include_str!(\"../data/process/default.toml\"))];\n   162→\n   163→const SCENARIO_PRESETS: &[(&str, &str)] = &[\n   164→    (\n   165→        \"nano_cycle\",\n   166→        include_str!(\"../data/scenarios/nano_cycle.toml\"),\n   167→    ),\n   168→    (\n   169→        \"medium_planted\",\n   170→        include_str!(\"../data/scenarios/medium_planted.toml\"),\n   171→    ),\n   172→    (\n   173→        \"warm_room\",\n   174→        include_str!(\"../data/scenarios/warm_room.toml\"),\n   175→    ),\n   176→];\n   177→"}]},"parent_tool_use_id":"toolu_01SdK2x77EeKtVykT9EyhLAo","session_id":"6255bc57-f0df-446f-b528-6846cbe58c9c","uuid":"71f8a94f-20f3-4fce-9a45-78d727a9b56e"}
