{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Es51C3qPBLTdZeDRavg3pD","type":"tool_result","content":"     1→use crate::types::{SimError, TankState};\n     2→\n     3→pub fn enforce_invariants(state: &mut TankState) -> Result<(), SimError> {\n     4→    check_non_negative(\n     5→        \"ammonia_total_mg_n_total\",\n     6→        state.water.ammonia_total_mg_n_total,\n     7→    )?;\n     8→    check_non_negative(\"nitrite_mg_n_total\", state.water.nitrite_mg_n_total)?;\n     9→    check_non_negative(\"nitrate_mg_n_total\", state.water.nitrate_mg_n_total)?;\n    10→    check_non_negative(\"phosphate_mg_p_total\", state.water.phosphate_mg_p_total)?;\n    11→    check_non_negative(\n    12→        \"dissolved_oxygen_mg_total\",\n    13→        state.water.dissolved_oxygen_mg_total,\n    14→    )?;\n    15→    check_non_negative(\n    16→        \"dissolved_inorganic_carbon_mg_c_total\",\n    17→        state.water.dissolved_inorganic_carbon_mg_c_total,\n    18→    )?;\n    19→    check_non_negative(\n    20→        \"dissolved_organic_carbon_mg_c_total\",\n    21→        state.water.dissolved_organic_carbon_mg_c_total,\n    22→    )?;\n    23→    check_non_negative(\n    24→        \"dissolved_organic_nitrogen_mg_n_total\",\n    25→        state.water.dissolved_organic_nitrogen_mg_n_total,\n    26→    )?;\n    27→    check_non_negative(\"alkalinity_meq_total\", state.water.alkalinity_meq_total)?;\n    28→    check_non_negative(\"calcium_mg_total\", state.water.calcium_mg_total)?;\n    29→    check_non_negative(\"magnesium_mg_total\", state.water.magnesium_mg_total)?;\n    30→    check_non_negative(\"sodium_mg_total\", state.water.sodium_mg_total)?;\n    31→    check_non_negative(\"potassium_mg_total\", state.water.potassium_mg_total)?;\n    32→    check_non_negative(\"bicarbonate_mg_total\", state.water.bicarbonate_mg_total)?;\n    33→    check_non_negative(\"chloride_mg_total\", state.water.chloride_mg_total)?;\n    34→    check_non_negative(\"sulfate_mg_total\", state.water.sulfate_mg_total)?;\n    35→    check_non_negative(\n    36→        \"particulate_organics_g_total\",\n    37→        state.detritus.particulate_organics_g_total,\n    38→    )?;\n    39→    check_non_negative(\n    40→        \"fine_detritus_g_total\",\n    41→        state.detritus.fine_detritus_g_total,\n    42→    )?;\n    43→    check_non_negative(\n    44→        \"dissolved_feed_residue_g_total\",\n    45→        state.detritus.dissolved_feed_residue_g_total,\n    46→    )?;\n    47→    check_non_negative(\"decomposer_biomass_g\", state.microbe.decomposer_biomass_g)?;\n    48→    check_non_negative(\n    49→        \"ammonia_oxidizer_biomass_g\",\n    50→        state.microbe.ammonia_oxidizer_biomass_g,\n    51→    )?;\n    52→    check_non_negative(\n    53→        \"nitrite_oxidizer_biomass_g\",\n    54→        state.microbe.nitrite_oxidizer_biomass_g,\n    55→    )?;\n    56→    check_non_negative(\"comammox_biomass_g\", state.microbe.comammox_biomass_g)?;\n    57→    for plant in &state.plant_guilds {\n    58→        check_non_negative(\"plant.biomass_g\", plant.biomass_g)?;\n    59→    }\n    60→    for layer in &state.substrate_layers {\n    61→        check_non_negative(\"substrate.depth_cm\", layer.depth_cm)?;\n    62→        check_non_negative(\n    63→            \"substrate.nutrient_store_mg_n_total\",\n    64→            layer.nutrient_store_mg_n_total,\n    65→        )?;\n    66→        check_non_negative(\n    67→            \"substrate.nutrient_store_mg_p_total\",\n    68→            layer.nutrient_store_mg_p_total,\n    69→        )?;\n    70→        check_non_negative(\"substrate.colonizable_area_cm2\", layer.colonizable_area_cm2)?;\n    71→    }\n    72→    check_non_negative(\"water.temperature_c\", state.water.temperature_c)?;\n    73→    if state.water.temperature_c <= 0.0 {\n    74→        return Err(SimError::TemperatureTooLow {\n    75→            field: \"water.temperature_c\",\n    76→            value: state.water.temperature_c,\n    77→        });\n    78→    }\n    79→\n    80→    state.geometry.lid_exchange_factor = state.geometry.lid_exchange_factor.clamp(0.0, 1.0);\n    81→    state.hardware.light.intensity_index = state.hardware.light.intensity_index.clamp(0.0, 1.0);\n    82→    state.hardware.filter.cleanliness_index =\n    83→        state.hardware.filter.cleanliness_index.clamp(0.0, 1.0);\n    84→    state.hardware.aeration.intensity = state.hardware.aeration.intensity.clamp(0.0, 1.0);\n    85→    state.filter_state.biofilter_maturity_index =\n    86→        state.filter_state.biofilter_maturity_index.clamp(0.0, 1.0);\n    87→    state.filter_state.clogging_index = state.filter_state.clogging_index.clamp(0.0, 1.0);\n    88→    state.filter_state.seeded_biomass_index =\n    89→        state.filter_state.seeded_biomass_index.clamp(0.0, 1.0);\n    90→    state.algae.nuisance_index = state.algae.nuisance_index.clamp(0.0, 1.0);\n    91→    state.microbe.maturity_index = state.microbe.maturity_index.clamp(0.0, 1.0);\n    92→    state.microfauna.population_index = state.microfauna.population_index.clamp(0.0, 1.0);\n    93→    state.microfauna.grazing_pressure_index =\n    94→        state.microfauna.grazing_pressure_index.clamp(0.0, 1.0);\n    95→    state.animal.condition_index = state.animal.condition_index.clamp(0.0, 1.0);\n    96→    state.animal.molt_stress_index = state.animal.molt_stress_index.clamp(0.0, 1.0);\n    97→    state.animal.reproductive_readiness_index =\n    98→        state.animal.reproductive_readiness_index.clamp(0.0, 1.0);\n    99→\n   100→    for plant in &mut state.plant_guilds {\n   101→        plant.health_index = plant.health_index.clamp(0.0, 1.0);\n   102→        plant.crowding_index = plant.crowding_index.clamp(0.0, 1.0);\n   103→        plant.habitat_index = plant.habitat_index.clamp(0.0, 1.0);\n   104→    }\n   105→    for layer in &mut state.substrate_layers {\n   106→        layer.cation_exchange_capacity_index = layer.cation_exchange_capacity_index.clamp(0.0, 1.0);\n   107→        layer.detritus_trapping_index = layer.detritus_trapping_index.clamp(0.0, 1.0);\n   108→        layer.low_oxygen_tendency_index = layer.low_oxygen_tendency_index.clamp(0.0, 1.0);\n   109→        layer.grazing_surface_index = layer.grazing_surface_index.clamp(0.0, 1.0);\n   110→    }\n   111→\n   112→    if state.event_log.len() > 200 {\n   113→        let keep_from = state.event_log.len() - 200;\n   114→        state.event_log.drain(0..keep_from);\n   115→    }\n   116→\n   117→    Ok(())\n   118→}\n   119→\n   120→fn check_non_negative(field: &'static str, value: f64) -> Result<(), SimError> {\n   121→    if !value.is_finite() || value < 0.0 {\n   122→        Err(SimError::InvariantViolation { field, value })\n   123→    } else {\n   124→        Ok(())\n   125→    }\n   126→}\n   127→"}]},"parent_tool_use_id":"toolu_01SdK2x77EeKtVykT9EyhLAo","session_id":"6255bc57-f0df-446f-b528-6846cbe58c9c","uuid":"18402c42-4668-4483-b010-4f462190fa4a"}
