{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D5D8mnPcjhme2jFEgN4Shm","type":"tool_result","content":"     1→use std::collections::BTreeMap;\n     2→\n     3→use tank_core::{\n     4→    PlantGuild, PlantGuildState, ProcessParams, SimMeta, SimSeed, SourceWaterProfile,\n     5→    SubstrateLayerState, TankGeometry, TankState, WaterState,\n     6→};\n     7→use tank_data::{load_scenario, ScenarioPreset};\n     8→\n     9→pub fn default_scenario_ids() -> &'static [&'static str] {\n    10→    tank_data::scenario_ids()\n    11→}\n    12→\n    13→pub fn load_named_scenario(id: &str) -> Result<ScenarioPreset, tank_data::PresetError> {\n    14→    load_scenario(id)\n    15→}\n    16→\n    17→/// Converts a `tank_data::SourceWaterPreset` into a `tank_core::SourceWaterProfile`.\n    18→fn source_water_to_profile(preset: &tank_data::SourceWaterPreset) -> SourceWaterProfile {\n    19→    SourceWaterProfile {\n    20→        temperature_c: preset.temperature_c,\n    21→        ammonia_mg_n_per_l: preset.ammonia_mg_n_per_l,\n    22→        nitrite_mg_n_per_l: preset.nitrite_mg_n_per_l,\n    23→        nitrate_mg_n_per_l: preset.nitrate_mg_n_per_l,\n    24→        phosphate_mg_p_per_l: preset.phosphate_mg_p_per_l,\n    25→        dic_mg_c_per_l: preset.dic_mg_c_per_l,\n    26→        doc_mg_c_per_l: preset.doc_mg_c_per_l,\n    27→        don_mg_n_per_l: preset.don_mg_n_per_l,\n    28→        alkalinity_meq_per_l: preset.alkalinity_meq_per_l,\n    29→        calcium_mg_per_l: preset.calcium_mg_per_l,\n    30→        magnesium_mg_per_l: preset.magnesium_mg_per_l,\n    31→        sodium_mg_per_l: preset.sodium_mg_per_l,\n    32→        potassium_mg_per_l: preset.potassium_mg_per_l,\n    33→        bicarbonate_mg_per_l: preset.bicarbonate_mg_per_l,\n    34→        chloride_mg_per_l: preset.chloride_mg_per_l,\n    35→        sulfate_mg_per_l: preset.sulfate_mg_per_l,\n    36→    }\n    37→}\n    38→\n    39→/// Converts a `tank_data::ProcessParamsPreset` into `tank_core::ProcessParams`.\n    40→fn process_preset_to_params(preset: &tank_data::ProcessParamsPreset) -> ProcessParams {\n    41→    ProcessParams {\n    42→        mineralization_rate_per_day: preset.mineralization_rate_per_day,\n    43→        nitrification_vmax: preset.nitrification_vmax,\n    44→        reaeration_kla: preset.reaeration_kla,\n    45→        k_surface_w_per_m2_k: preset.k_surface_w_per_m2_k,\n    46→        k_wall_w_per_m2_k: preset.k_wall_w_per_m2_k,\n    47→    }\n    48→}\n    49→\n    50→/// Materializes a scenario preset into a fully resolved `TankState`.\n    51→///\n    52→/// - Geometry comes from the scenario.\n    53→/// - `environment.ambient_temp_c` comes from the scenario.\n    54→/// - Initial `WaterState` totals come from the source-water profile × fill volume.\n    55→/// - Substrate layers come from the scenario's substrate preset IDs.\n    56→/// - Plant guilds come from the scenario's plant preset IDs.\n    57→/// - Source-water catalog is populated with all known source-water presets.\n    58→/// - Process parameters come from the scenario's process params preset.\n    59→pub fn seeded_state(seed: SimSeed, scenario_id: &str) -> Result<TankState, tank_data::PresetError> {\n    60→    let scenario = load_named_scenario(scenario_id)?;\n    61→\n    62→    // Geometry\n    63→    let geometry = TankGeometry {\n    64→        length_cm: scenario.tank_length_cm,\n    65→        width_cm: scenario.tank_width_cm,\n    66→        height_cm: scenario.tank_height_cm,\n    67→        fill_height_cm: scenario.fill_height_cm,\n    68→        glass_thickness_mm: 5.0,\n    69→        open_top: true,\n    70→        lid_exchange_factor: 0.25,\n    71→    };\n    72→\n    73→    // Source water profile for initial fill\n    74→    let source_water_preset = tank_data::load_source_water(&scenario.source_water_id)?;\n    75→    let source_profile = source_water_to_profile(&source_water_preset);\n    76→\n    77→    // Initial water state from source-water profile\n    78→    let water = WaterState::from_source_profile(&source_profile, &geometry);\n    79→\n    80→    // Build source-water catalog with all known presets\n    81→    let mut source_water_catalog = BTreeMap::new();\n    82→    for sw_id in tank_data::source_water_ids() {\n    83→        let sw_preset = tank_data::load_source_water(sw_id)?;\n    84→        source_water_catalog.insert(sw_id.to_string(), source_water_to_profile(&sw_preset));\n    85→    }\n    86→\n    87→    // Process parameters\n    88→    let process_preset = tank_data::load_process_params(&scenario.process_params_id)?;\n    89→    let process_params = process_preset_to_params(&process_preset);\n    90→\n    91→    // Substrate layers\n    92→    let mut substrate_layers = Vec::new();\n    93→    for sub_id in &scenario.substrate_ids {\n    94→        let sub_preset = tank_data::load_substrate(sub_id)?;\n    95→        let footprint = geometry.footprint_area_cm2();\n    96→        substrate_layers.push(SubstrateLayerState {\n    97→            kind: match sub_preset.id.as_str() {\n    98→                \"inert_sand\" => tank_core::SubstrateKind::InertSand,\n    99→                \"inert_gravel\" => tank_core::SubstrateKind::InertGravel,\n   100→                \"active_planted\" => tank_core::SubstrateKind::ActivePlanted,\n   101→                \"coarse_porous\" => tank_core::SubstrateKind::CoarsePorous,\n   102→                other => {\n   103→                    return Err(tank_data::PresetError::Validation {\n   104→                        category: \"substrate\",\n   105→                        id: other.to_string(),\n   106→                        message: format!(\"unsupported substrate kind: `{other}`\"),\n   107→                    });\n   108→                }\n   109→            },\n   110→            depth_cm: sub_preset.depth_cm,\n   111→            nutrient_store_mg_n_total: sub_preset.nutrient_charge_mg_n_total,\n   112→            nutrient_store_mg_p_total: sub_preset.nutrient_charge_mg_p_total,\n   113→            cation_exchange_capacity_index: sub_preset.cation_exchange_capacity_index,\n   114→            detritus_trapping_index: sub_preset.detritus_trapping_index,\n   115→            colonizable_area_cm2: footprint * sub_preset.colonizable_area_factor,\n   116→            low_oxygen_tendency_index: sub_preset.low_oxygen_tendency_index,\n   117→            grazing_surface_index: sub_preset.grazing_surface_index,\n   118→        });\n   119→    }\n   120→    if substrate_layers.is_empty() {\n   121→        substrate_layers.push(SubstrateLayerState::default());\n   122→    }\n   123→\n   124→    // Plant guilds\n   125→    let mut plant_guilds = Vec::new();\n   126→    for plant_id in &scenario.plant_ids {\n   127→        let plant_preset = tank_data::load_plant(plant_id)?;\n   128→        let guild = match plant_preset.guild.as_str() {\n   129→            \"FastStem\" => PlantGuild::FastStem,\n   130→            \"RootFeedingRosette\" => PlantGuild::RootFeedingRosette,\n   131→            other => {\n   132→                return Err(tank_data::PresetError::Validation {\n   133→                    category: \"plants\",\n   134→                    id: plant_id.clone(),\n   135→                    message: format!(\"unsupported plant guild: `{other}`\"),\n   136→                });\n   137→            }\n   138→        };\n   139→        plant_guilds.push(PlantGuildState {\n   140→            guild,\n   141→            biomass_g: 5.0,\n   142→            health_index: 0.8,\n   143→            crowding_index: 0.1,\n   144→            habitat_index: if guild == PlantGuild::RootFeedingRosette {\n   145→                // Habitat factor depends on substrate quality\n   146→                substrate_layers\n   147→                    .iter()\n   148→                    .map(|l| l.cation_exchange_capacity_index)\n   149→                    .fold(0.0_f64, f64::max)\n   150→                    .max(0.3)\n   151→            } else {\n   152→                0.8\n   153→            },\n   154→        });\n   155→    }\n   156→    if plant_guilds.is_empty() {\n   157→        plant_guilds.push(PlantGuildState::default());\n   158→    }\n   159→\n   160→    // Environment\n   161→    let mut environment = tank_core::EnvironmentState::default();\n   162→    environment.ambient_temp_c = scenario.ambient_temp_c;\n   163→\n   164→    let mut state = TankState::new(seed);\n   165→    state.meta = SimMeta {\n   166→        scenario_id: Some(scenario.id),\n   167→        notes: Some(scenario.name),\n   168→    };\n   169→    state.geometry = geometry;\n   170→    state.environment = environment;\n   171→    state.water = water;\n   172→    state.substrate_layers = substrate_layers;\n   173→    state.plant_guilds = plant_guilds;\n   174→    state.source_water_catalog = source_water_catalog;\n   175→    state.process_params = process_params;\n   176→\n   177→    Ok(state)\n   178→}\n   179→"}]},"parent_tool_use_id":"toolu_01SdK2x77EeKtVykT9EyhLAo","session_id":"6255bc57-f0df-446f-b528-6846cbe58c9c","uuid":"485c63a9-30b5-4a0e-90e4-20825cc809a2"}
