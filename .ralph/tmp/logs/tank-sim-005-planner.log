36→    /// Hourly decay rate of decomposer biomass under starvation.\n    37→    pub decomposer_decay_rate_per_hour: f64,\n    38→\n    39→    // -- Nitrifier guild kinetics --\n    40→    /// AOB vmax: max mg N oxidized per g AOB biomass per hour.\n    41→    pub aob_vmax_mg_n_per_g_per_hour: f64,\n    42→    /// AOB half-saturation for TAN (mg N total).\n    43→    pub aob_k_tan_mg: f64,\n    44→    /// AOB half-saturation for DO (mg total).\n    45→    pub aob_k_do_mg: f64,\n    46→    /// AOB growth yield (g biomass per mg N oxidized).\n    47→    pub aob_growth_yield: f64,\n    48→    /// AOB decay rate per hour.\n    49→    pub aob_decay_rate_per_hour: f64,\n    50→\n    51→    /// NOB vmax: max mg N oxidized per g NOB biomass per hour.\n    52→    pub nob_vmax_mg_n_per_g_per_hour: f64,\n    53→    /// NOB half-saturation for nitrite (mg N total).\n    54→    pub nob_k_nitrite_mg: f64,\n    55→    /// NOB half-saturation for DO (mg total).\n    56→    pub nob_k_do_mg: f64,\n    57→    /// NOB growth yield (g biomass per mg N oxidized).\n    58→    pub nob_growth_yield: f64,\n    59→    /// NOB decay rate per hour.\n    60→    pub nob_decay_rate_per_hour: f64,\n    61→\n    62→    /// Comammox vmax multiplier relative to AOB (must be < 1.0).\n    63→    pub comammox_vmax_fraction: f64,\n    64→    /// Comammox half-saturation for TAN (mg N total).\n    65→    pub comammox_k_tan_mg: f64,\n    66→    /// Comammox half-saturation for DO (mg total).\n    67→    pub comammox_k_do_mg: f64,\n    68→    /// Comammox growth yield (g biomass per mg N oxidized).\n    69→    pub comammox_growth_yield: f64,\n    70→    /// Comammox decay rate per hour.\n    71→    pub comammox_decay_rate_per_hour: f64,\n    72→\n    73→    // -- Stoichiometric constants --\n    74→    /// mg O2 consumed per mg N fully nitrified to nitrate.\n    75→    pub o2_per_mg_n_nitrified: f64,\n    76→    /// meq alkalinity consumed per mg N nitrified.\n    77→    pub alkalinity_meq_per_mg_n_nitrified: f64,\n    78→}\n    79→\n    80→impl Default for ProcessParams {\n    81→    fn default() -> Self {\n    82→        Self {\n    83→            mineralization_rate_per_day: 0.15,\n    84→            nitrification_vmax: 0.08,\n    85→            reaeration_kla_base: 0.35,\n    86→            aeration_kla_boost: 0.9,\n    87→            background_bod_mg_o2_per_g_biomass_per_hour: 0.05,\n    88→            plant_photosynthesis_o2_mg_per_g_per_hour: 0.2,\n    89→            respiration_dic_rate_mg_c_per_g_per_hour: 0.0,\n    90→            photosynthesis_dic_rate_mg_c_per_g_per_hour: 0.0,\n    91→            k_surface_w_per_m2_k: 10.0,\n    92→            k_wall_w_per_m2_k: 5.0,\n    93→\n    94→            feed_leach_rate_per_hour: 0.12,\n    95→            fine_detritus_dissolution_rate_per_hour: 0.08,\n    96→            feed_n_to_c_ratio: 0.16,\n    97→\n    98→            decomposer_vmax_per_hour: 0.02,\n    99→            decomposer_k_doc_mg: 5.0,\n   100→            decomposer_growth_yield: 0.3,\n   101→            decomposer_decay_rate_per_hour: 0.002,\n   102→\n   103→            aob_vmax_mg_n_per_g_per_hour: 1.5,\n   104→            aob_k_tan_mg: 0.5,\n   105→            aob_k_do_mg: 1.0,\n   106→            aob_growth_yield: 0.001,\n   107→            aob_decay_rate_per_hour: 0.003,\n   108→\n   109→            nob_vmax_mg_n_per_g_per_hour: 1.2,\n   110→            nob_k_nitrite_mg: 0.3,\n   111→            nob_k_do_mg: 1.0,\n   112→            nob_growth_yield: 0.001,\n   113→            nob_decay_rate_per_hour: 0.003,\n   114→\n   115→            comammox_vmax_fraction: 0.4,\n   116→            comammox_k_tan_mg: 0.8,\n   117→            comammox_k_do_mg: 1.5,\n   118→            comammox_growth_yield: 0.0008,\n   119→            comammox_decay_rate_per_hour: 0.004,\n   120→\n   121→            o2_per_mg_n_nitrified: 4.57,\n   122→            alkalinity_meq_per_mg_n_nitrified: 0.1428,\n   123→        }\n   124→    }\n   125→}\n   126→"}]},"parent_tool_use