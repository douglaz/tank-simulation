ity_meq_per_mg_n_nitrified),\n   243→        ];\n   244→        for (name, value) in fields {\n   245→            if !value.is_finite() {\n   246→                return Err(format!(\"field `{name}` must be finite, got {value}\"));\n   247→            }\n   248→            if *value < 0.0 {\n   249→                return Err(format!(\"field `{name}` must be non-negative, got {value}\"));\n   250→            }\n   251→        }\n   252→        // comammox_vmax_fraction must be <= 1.0 (spec requires lower vmax than AOB)\n   253→        if self.comammox_vmax_fraction > 1.0 {\n   254→            return Err(format!(\n   255→                \"comammox_vmax_fraction must be <= 1.0, got {}\",\n   256→                self.comammox_vmax_fraction\n   257→            ));\n   258→        }\n   259→        Ok(())\n   260→    }\n   261→}\n   262→\n   263→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n   264→pub struct ScenarioPreset {\n   265→    pub id: String,\n   266→    pub name: String,\n   267→    pub source_water_id: String,\n   268→    pub substrate_ids: Vec<String>,\n   269→    pub plant_ids: Vec<String>,\n   270→    pub shrimp_profile_id: String,\n   271→    pub process_params_id: String,\n   272→    pub tank_length_cm: f64,\n   273→    pub tank_width_cm: f64,\n   274→    pub tank_height_cm: f64,\n   275→    pub fill_height_cm: f64,\n   276→    pub ambient_temp_c: f64,\n   277→    pub provenance: Option<Provenance>,\n   278→}\n   279→"}]},"parent_tool_use_id":"toolu_013aSVJ6RroqQ847pQy5QRmW","session_id":"8646385e-534a-4d68-9ebc-889753621e92","uuid":"ce2d0527-3749-4e61-a8cb-0c970b9d03a7"}
