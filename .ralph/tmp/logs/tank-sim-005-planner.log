n    46→        let geometry = TankGeometry::default();\n    47→        Self {\n    48→            meta: SimMeta::default(),\n    49→            geometry: geometry.clone(),\n    50→            environment: EnvironmentState::default(),\n    51→            hardware: HardwareState::default(),\n    52→            water: WaterState::default_for_geometry(&geometry),\n    53→            substrate_layers: vec![SubstrateLayerState::default()],\n    54→            filter_state: FilterState::default(),\n    55→            plant_guilds: vec![\n    56→                PlantGuildState::default(),\n    57→                PlantGuildState {\n    58→                    guild: PlantGuild::RootFeedingRosette,\n    59→                    biomass_g: 3.0,\n    60→                    health_index: 0.8,\n    61→                    crowding_index: 0.1,\n    62→                    habitat_index: 0.7,\n    63→                },\n    64→            ],\n    65→            algae: AlgaeState::default(),\n    66→            microbe: MicrobeState::default(),\n    67→            microfauna: MicrofaunaState::default(),\n    68→            animal: AnimalState::default(),\n    69→            detritus: DetritusState::default(),\n    70→            event_log: Vec::new(),\n    71→            last_event_day: BTreeMap::new(),\n    72→            rng: SimRng::new(seed),\n    73→            source_water_catalog: BTreeMap::new(),\n    74→            process_params: ProcessParams::default(),\n    75→        }\n    76→    }\n    77→\n    78→    pub fn seeded_example(seed: SimSeed) -> Self {\n    79→        let mut state = Self::new(seed);\n    80→        state.meta.scenario_id = Some(\"seeded_example\".to_string());\n    81→        state.substrate_layers = vec![\n    82→            SubstrateLayerState {\n    83→                kind: SubstrateKind::ActivePlanted,\n    84→                depth_cm: 2.0,\n    85→                nutrient_store_mg_n_total: 40.0,\n    86→                nutrient_store_mg_p_total: 10.0,\n    87→                cation_exchange_capacity_index: 0.8,\n    88→                detritus_trapping_index: 0.4,\n    89→                colonizable_area_cm2: 400.0,\n    90→                low_oxygen_tendency_index: 0.5,\n    91→                grazing_surface_index: 0.5,\n    92→            },\n    93→            SubstrateLayerState {\n    94→                kind: SubstrateKind::CoarsePorous,\n    95→                depth_cm: 1.0,\n    96→                nutrient_store_mg_n_total: 5.0,\n    97→                nutrient_store_mg_p_total: 1.0,\n    98→                cation_exchange_capacity_index: 0.2,\n    99→                detritus_trapping_index: 0.6,\n   100→                colonizable_area_cm2: 250.0,\n   101→                low_oxygen_tendency_index: 0.6,\n   102→                grazing_surface_index: 0.7,\n   103→            },\n   104→        ];\n   105→        state\n   106→    }\n   107→}\n   108→\n   109→impl Default for SimMeta {\n   110→    fn default() -> Self {\n   111→        Self {\n   112→            scenario_id: None,\n   113→            notes: None,\n   114→        }\n   115→    }\n   116→}\n   117→\n   118→impl Default for TankState {\n   119→    fn default() -> Self {\n   120→        Self::new(SimSeed(0))\n   121→    }\n   122→}\n   123→"}]},"parent_tool_use_id":"toolu_013aSVJ6RroqQ847pQy5QRmW","session_id":"8646385e-534a-4d68-9ebc-889753621e92","uuid":"6ac7b3a5-d3b4-484e-ba4f-8e47b06a0505"}
