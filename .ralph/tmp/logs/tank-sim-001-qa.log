{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nix shell nixpkgs#cargo nixpkgs#rustc nixpkgs#gcc -c bash -lc 'rustc --edition 2021 -o /tmp/qa_workspace -L dependency=target/debug/deps --extern tank_core=\"'$(ls target/debug/deps/libtank_core-*.rlib | head -n1) --extern tank_data=$(ls target/debug/deps/libtank_data-*.rlib | head -n1) --extern tank_tui=$(ls target/debug/deps/libtank_tui-*.rlib | head -n1) --extern tank_scenarios=$(ls target/debug/deps/libtank_scenarios-*.rlib | head -n1) - <<'\"'\\\"'\\\"'RS'\\\"'\\\"'\nuse tank_core::{PlayerAction, SimSeed, TankSnapshot, TankState};\nuse tank_data::{\n    load_plant, load_process_params, load_scenario, load_shrimp, load_source_water, load_substrate,\n    plant_ids, process_ids, scenario_ids, shrimp_ids, source_water_ids, substrate_ids,\n};\nuse tank_scenarios::{default_scenario_ids, load_named_scenario, seeded_state};\nuse tank_tui::{Screen, TuiApp};\n\nfn main() -> Result<(), Box<dyn std::error::Error>> {\n    println\"'!(\n        \"PRESET_IDS source={:?} substrate={:?} plants={:?} shrimp={:?} process={:?} scenarios={:?}\",\n        source_water_ids(),\n        substrate_ids(),\n        plant_ids(),\n        shrimp_ids(),\n        process_ids(),\n        scenario_ids(),\n    );\n\n    let soft = load_source_water(\"soft_acidic\")?;\n    let substrate = load_substrate(\"active_planted\")?;\n    let plant = load_plant(\"root_rosette\")?;\n    let shrimp = load_shrimp(\"neocaridina_davidi\")?;\n    let process = load_process_params(\"default\")?;\n    let scenario = load_scenario(\"warm_room\")?;\n    println!(\"PRESET_LOAD source={} ph={:.1} substrate={} cec={:.1} plant={} guild={} shrimp={} species={} process={} nitrification_vmax={:.2} scenario={} ambient_c={:.1}\",\n        soft.id, soft.ph, substrate.id, substrate.cation_exchange_capacity_index, plant.id, plant.guild, shrimp.id, shrimp.species, process.id, process.nitrification_vmax, scenario.id, scenario.ambient_temp_c);\n\n    println!(\"SCENARIO_API ids={:?}\", default_scenario_ids());\n    let named = load_named_scenario(\"nano_cycle\")?;\n    let state = seeded_state(SimSeed(77), \"nano_cycle\")?;\n    println!(\"SCENARIO_LOAD id={} seeded_meta_id={:?} seeded_meta_notes={:?} plant_guilds={} substrate_layers={} adult_shrimp={}\",\n        named.id, state.meta.scenario_id, state.meta.notes, state.plant_guilds.len(), state.substrate_layers.len(), state.animal.adults_count);\n\n    let snapshot = TankSnapshot::from_state(&TankState::new(SimSeed(11)));\n    let mut app = TuiApp::new(snapshot);\n    println!(\"TUI_INIT screen={:?} pending_actions={} water_temp_c={:.1}\", app.active_screen, app.pending_actions.len(), app.snapshot.water_temp_c);\n    app.active_screen = Screen::Actions;\n    app.queue_action(PlayerAction::Feed { grams: 0.5 });\n    app.queue_action(PlayerAction::ChangeAmbientTemperature { target_c: 26.0 });\n    println!(\"TUI_QUEUE screen={:?} pending_actions={} first_action={:?} second_action={:?}\", app.active_screen, app.pending_actions.len(), app.pending_actions.get(0), app.pending_actions.get(1));\n\n    Ok(())\n}\nRS\n/tmp/qa_workspace'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
