{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nix shell nixpkgs#cargo nixpkgs#rustc nixpkgs#gcc -c bash -lc 'rustc --edition 2021 -o /tmp/qa_core -L dependency=target/debug/deps --extern tank_core=\"'$(ls target/debug/deps/libtank_core-*.rlib | head -n1) - <<'\"'\\\"'\\\"'RS'\\\"'\\\"'\nuse tank_core::{\n    enforce_invariants, Engine, EventCause, EventKind, EventSeverity, PlayerAction, SaveFile,\n    SimEvent, SimSeed, SimulationEngine, TankGeometry, TankState,\n};\n\nfn approx(label: &str, actual: f64, expected: f64) {\n    let diff = (actual - expected).abs();\n    println\"'!(\"{label}: actual={actual:.6}, expected={expected:.6}, diff={diff:.6}\");\n    assert!(diff < 1e-6, \"{label} mismatch\");\n}\n\nfn main() -> Result<(), Box<dyn std::error::Error>> {\n    let mut geometry = TankGeometry::default();\n    geometry.length_cm = 50.0;\n    geometry.width_cm = 20.0;\n    geometry.height_cm = 25.0;\n    geometry.fill_height_cm = 20.0;\n    geometry.open_top = false;\n\n    println!(\"GEOMETRY volume_l={:.3} surface_cm2={:.3} footprint_cm2={:.3} wall_cm2={:.3} mean_depth_cm={:.3} sav_ratio={:.3} wav_ratio={:.3} top_factor={:.3}\",\n        geometry.water_volume_l(),\n        geometry.surface_area_cm2(),\n        geometry.footprint_area_cm2(),\n        geometry.wall_area_cm2(),\n        geometry.mean_depth_cm(),\n        geometry.surface_area_to_volume_ratio(),\n        geometry.wall_area_to_volume_ratio(),\n        geometry.top_exchange_factor(),\n    );\n\n    approx(\"water_volume_l\", geometry.water_volume_l(), 20.0);\n    approx(\"surface_area_cm2\", geometry.surface_area_cm2(), 1000.0);\n    approx(\"wall_area_cm2\", geometry.wall_area_cm2(), 2800.0);\n    approx(\"top_exchange_factor\", geometry.top_exchange_factor(), 0.25);\n\n    let mut state = TankState::new(SimSeed(123));\n    state.geometry = geometry.clone();\n    state.water.temperature_c = 24.0;\n    state.water.ammonia_total_mg_n_total = 40.0;\n    state.water.nitrite_mg_n_total = 10.0;\n    state.water.nitrate_mg_n_total = 100.0;\n    state.water.phosphate_mg_p_total = 20.0;\n    state.water.dissolved_oxygen_mg_total = 160.0;\n    state.water.dissolved_inorganic_carbon_mg_c_total = 400.0;\n    state.water.alkalinity_meq_total = 30.0;\n    state.water.calcium_mg_total = 400.0;\n    state.water.magnesium_mg_total = 100.0;\n    state.water.sodium_mg_total = 200.0;\n    state.water.potassium_mg_total = 60.0;\n    state.water.bicarbonate_mg_total = 1400.0;\n    state.water.chloride_mg_total = 240.0;\n    state.water.sulfate_mg_total = 160.0;\n\n    let snapshot = tank_core::TankSnapshot::from_state(&state);\n    println!(\"SNAPSHOT tan={:.3} nh3={:.6} nitrite={:.3} nitrate={:.3} phosphate={:.3} do={:.3} gh={:.3} kh={:.3} tds={:.3} conductivity={:.3} ph={:.6}\",\n        snapshot.tan_mg_l,\n        snapshot.nh3_mg_l,\n        snapshot.nitrite_mg_l,\n        snapshot.nitrate_mg_l,\n        snapshot.phosphate_mg_l,\n        snapshot.do_mg_l,\n        snapshot.gh_d,\n        snapshot.kh_d,\n        snapshot.tds_mg_l,\n        snapshot.conductivity_us_cm,\n        snapshot.ph,\n    );\n    approx(\"tan_mg_l\", snapshot.tan_mg_l, 2.0);\n    approx(\"nitrite_mg_l\", snapshot.nitrite_mg_l, 0.5);\n    approx(\"nitrate_mg_l\", snapshot.nitrate_mg_l, 5.0);\n    approx(\"phosphate_mg_l\", snapshot.phosphate_mg_l, 1.0);\n    approx(\"do_mg_l\", snapshot.do_mg_l, 8.0);\n    approx(\"gh_d\", snapshot.gh_d, ((2.497 * 20.0) + (4.118 * 5.0)) / 17.848);\n    approx(\"kh_d\", snapshot.kh_d, ((1.5 * 50.0) / 17.848));\n    approx(\"tds_mg_l\", snapshot.tds_mg_l, 128.0);\n    approx(\"conductivity_us_cm\", snapshot.conductivity_us_cm, 128.0 / 0.65);\n    approx(\"ph\", snapshot.ph, (6.3 + 1.5f64.log10() - (400.0 / 12.0 / 20.0).log10()).clamp(5.5, 8.5));\n\n    let mut engine = Engine::new(SimSeed(42));\n    engine.apply_action(PlayerAction::Feed { grams: 1.25 })?;\n    engine.apply_action(PlayerAction::ChangeAmbientTemperature { target_c: 25.5 })?;\n    println!(\"QUEUE_BEFORE_STEP queued={} detritus_g={:.2} ambient_c={:.1}\", engine.queued_actions().len(), engine.full_state().detritus.particulate_organics_g_total, engine.full_state().environment.ambient_temp_c);\n    engine.step_hours(1)?;\n    println!(\"QUEUE_AFTER_STEP queued={} detritus_g={:.2} ambient_c={:.1} day={} hour={} events={} first_event_kind={:?}\", engine.queued_actions().len(), engine.full_state().detritus.particulate_organics_g_total, engine.full_state().environment.ambient_temp_c, engine.full_state().environment.day, engine.full_state().environment.hour_of_day, engine.full_state().event_log.len(), engine.full_state().event_log.first().map(|e| &e.kind));\n\n    let save = SaveFile::from_engine(&engine);\n    let json = save.to_json_pretty()?;\n    let parsed: serde_json::Value = serde_json::from_str(&json)?;\n    println!(\"SAVEFILE keys={:?} schema={} app_version={} has_rng={} queued_actions_len={}\", parsed.as_object().unwrap().keys().collect::<Vec<_>>(), parsed[\"schema_version\"], parsed[\"app_version\"], parsed[\"state\"][\"rng\"].is_object(), parsed[\"queued_actions\"].as_array().unwrap().len());\n    let restored = SaveFile::from_json(&json)?;\n    let restored_engine = restored.into_engine();\n    println!(\"SAVE_RESTORE equal_state={} equal_queue={}\", engine.full_state() == restored_engine.full_state(), engine.queued_actions() == restored_engine.queued_actions());\n\n    match Engine::new(SimSeed(9)).apply_action(PlayerAction::Feed { grams: -0.1 }) {\n        Err(err) => println!(\"INVALID_FEED {err}\"),\n        Ok(_) => panic!(\"negative feed should fail\"),\n    }\n    match Engine::new(SimSeed(9)).apply_action(PlayerAction::WaterChangePercent { percent: 120.0, source_profile_id: \"moderate\".into() }) {\n        Err(err) => println!(\"INVALID_WATER_CHANGE {err}\"),\n        Ok(_) => panic!(\"invalid percent should fail\"),\n    }\n\n    let mut invariant_state = TankState::new(SimSeed(5));\n    invariant_state.hardware.light.intensity_index = 1.5;\n    invariant_state.microfauna.population_index = -0.2;\n    match enforce_invariants(&mut invariant_state) {\n        Err(err) => println!(\"INVARIANT_NEGATIVE {err}\"),\n        Ok(_) => panic!(\"negative population index should fail\"),\n    }\n\n    let mut clamp_state = TankState::new(SimSeed(6));\n    clamp_state.hardware.light.intensity_index = 1.5;\n    clamp_state.animal.condition_index = 1.4;\n    for i in 0..205 {\n        clamp_state.event_log.push(SimEvent::new(0, 0, EventSeverity::Info, EventKind::CycleProgressing, vec![EventCause::RoutineAction], format!(\"event-{i}\")));\n    }\n    enforce_invariants(&mut clamp_state)?;\n    println!(\"INVARIANT_CLAMP light_intensity={:.1} condition={:.1} event_log_len={} oldest_kept={} newest_kept={}\", clamp_state.hardware.light.intensity_index, clamp_state.animal.condition_index, clamp_state.event_log.len(), clamp_state.event_log.first().unwrap().summary, clamp_state.event_log.last().unwrap().summary);\n\n    Ok(())\n}\nRS\n/tmp/qa_core'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
