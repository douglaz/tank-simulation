{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc 'CORE_LIB=$(ls target/debug/deps/libtank_core-*.rlib | head -n1)\nDATA_LIB=$(ls target/debug/deps/libtank_data-*.rlib | head -n1)\ncat <<'\"'RS' >/tmp/tank_manual_qa.rs\nextern crate tank_core;\nextern crate tank_data;\n\nuse tank_core::{\n    Engine, EventCause, EventKind, EventSeverity, PlayerAction, SaveFile, SimEvent, SimSeed,\n    SimulationEngine, TankGeometry, TankSnapshot, TankState, WaterState,\n};\nuse tank_data::{\n    load_plant, load_process_params, load_scenario, load_shrimp, load_source_water,\n    load_substrate, plant_ids, process_ids, scenario_ids, shrimp_ids, source_water_ids,\n    substrate_ids,\n};\n\nfn main() -> Result<(), Box<dyn std::error::Error>> {\n    let closed = TankGeometry {\n        length_cm: 40.0,\n        width_cm: 20.0,\n        height_cm: 30.0,\n        fill_height_cm: 25.0,\n        glass_thickness_mm: 5.0,\n        open_top: false,\n        lid_exchange_factor: 0.25,\n    };\n    let open = TankGeometry { open_top: true, ..closed.clone() };\n    println\"'!(\n        \"GEOMETRY volume_l={:.3} surface_cm2={:.1} footprint_cm2={:.1} wall_cm2={:.1} mean_depth_cm={:.1} s2v={:.3} w2v={:.3} closed_top_factor={:.2} open_top_factor={:.2}\",\n        closed.water_volume_l(),\n        closed.surface_area_cm2(),\n        closed.footprint_area_cm2(),\n        closed.wall_area_cm2(),\n        closed.mean_depth_cm(),\n        closed.surface_area_to_volume_ratio(),\n        closed.wall_area_to_volume_ratio(),\n        closed.top_exchange_factor(),\n        open.top_exchange_factor(),\n    );\n\n    let mut state = TankState::new(SimSeed(11));\n    state.geometry = closed.clone();\n    state.water = WaterState {\n        temperature_c: 25.0,\n        ammonia_total_mg_n_total: 50.0,\n        nitrite_mg_n_total: 10.0,\n        nitrate_mg_n_total: 200.0,\n        phosphate_mg_p_total: 5.0,\n        dissolved_oxygen_mg_total: 160.0,\n        dissolved_inorganic_carbon_mg_c_total: 120.0,\n        dissolved_organic_carbon_mg_c_total: 30.0,\n        dissolved_organic_nitrogen_mg_n_total: 15.0,\n        alkalinity_meq_total: 40.0,\n        calcium_mg_total: 400.0,\n        magnesium_mg_total: 80.0,\n        sodium_mg_total: 100.0,\n        potassium_mg_total: 20.0,\n        bicarbonate_mg_total: 200.0,\n        chloride_mg_total: 60.0,\n        sulfate_mg_total: 40.0,\n    };\n    state.event_log = (0..25)\n        .map(|i| SimEvent::new(0, i as u8 % 24, EventSeverity::Info, EventKind::CycleProgressing, vec![EventCause::RoutineAction], format!(\"event-{i}\")))\n        .collect();\n    let snap = TankSnapshot::from_state(&state);\n    println!(\n        \"SNAPSHOT tan_mg_l={:.3} nh3_mg_l={:.5} nitrite_mg_l={:.3} nitrate_mg_l={:.3} phosphate_mg_l={:.3} do_mg_l={:.3} gh_d={:.3} kh_d={:.3} tds_mg_l={:.3} conductivity_us_cm={:.3} ph={:.3} recent_events={} first_recent={}\",\n        snap.tan_mg_l,\n        snap.nh3_mg_l,\n        snap.nitrite_mg_l,\n        snap.nitrate_mg_l,\n        snap.phosphate_mg_l,\n        snap.do_mg_l,\n        snap.gh_d,\n        snap.kh_d,\n        snap.tds_mg_l,\n        snap.conductivity_us_cm,\n        snap.ph,\n        snap.recent_events.len(),\n        snap.recent_events.first().map(|e| e.summary.as_str()).unwrap_or(\"<none>\"),\n    );\n\n    println!(\n        \"STATE_SHAPE layers={} plants={} events={} ambient_c={} light_enabled={} heater_enabled={} filter_enabled={} aeration_enabled={} algae_nuisance={} microbe_maturity={} microfauna_population={} adults={} detritus_g={} rng_seed={} rng_draws={}\",\n        state.substrate_layers.len(),\n        state.plant_guilds.len(),\n        state.event_log.len(),\n        state.environment.ambient_temp_c,\n        state.hardware.light.enabled,\n        state.hardware.heater.enabled,\n        state.hardware.filter.enabled,\n        state.hardware.aeration.enabled,\n        state.algae.nuisance_index,\n        state.microbe.maturity_index,\n        state.microfauna.population_index,\n        state.animal.adults_count,\n        state.detritus.particulate_organics_g_total,\n        state.rng.seed().0,\n        state.rng.draws(),\n    );\n\n    let event_kinds = [\n        EventKind::CycleProgressing,\n        EventKind::AmmoniaWarning,\n        EventKind::NitriteWarning,\n        EventKind::OxygenDip,\n        EventKind::AlgaeRiskRising,\n        EventKind::AlgaeBloom,\n        EventKind::BiofilmMaturityIncrease,\n        EventKind::ShrimpBerried,\n        EventKind::EggFailure,\n        EventKind::MoltStressWarning,\n        EventKind::FilterCleaningSetback,\n        EventKind::SubstrateFoulingWarning,\n        EventKind::StabilityImproving,\n    ];\n    let severities = [EventSeverity::Info, EventSeverity::Warning, EventSeverity::Critical];\n    println!(\"EVENT_ENUMS kind_count={} severity_count={}\", event_kinds.len(), severities.len());\n\n    let mut queue_engine = Engine::new(SimSeed(7));\n    queue_engine.apply_action(PlayerAction::ChangeAmbientTemperature { target_c: 26.0 })?;\n    println!(\n        \"QUEUED_ACTION before_step ambient_c={} hour={} queued={}\",\n        queue_engine.full_state().environment.ambient_temp_c,\n        queue_engine.full_state().environment.hour_of_day,\n        queue_engine.queued_actions().len(),\n    );\n    queue_engine.step_hours(1)?;\n    println!(\n        \"QUEUED_ACTION after_step ambient_c={} hour={} queued={} events={}\",\n        queue_engine.full_state().environment.ambient_temp_c,\n        queue_engine.full_state().environment.hour_of_day,\n        queue_engine.queued_actions().len(),\n        queue_engine.full_state().event_log.len(),\n    );\n\n    let mut order_engine = Engine::new(SimSeed(12));\n    order_engine.apply_action(PlayerAction::RemoveShrimp { count: 1 })?;\n    order_engine.apply_action(PlayerAction::AddShrimp { count: 1 })?;\n    order_engine.step_hours(1)?;\n    println!(\"QUEUE_ORDER adults_after_remove_then_add={}\", order_engine.full_state().animal.adults_count);\n\n    println!(\"VALIDATION feed_negative={:?}\", PlayerAction::Feed { grams: -0.1 }.validate());\n    println!(\n        \"VALIDATION water_change_bad={:?}\",\n        PlayerAction::WaterChangePercent { percent: 120.0, source_profile_id: \"moderate\".into() }.validate()\n    );\n    println!(\"VALIDATION trim_bad={:?}\", PlayerAction::TrimPlants { fraction: 1.1 }.validate());\n    println!(\"VALIDATION clean_bad={:?}\", PlayerAction::CleanFilter { intensity: -0.5 }.validate());\n    println!(\n        \"VALIDATION light_bad={:?}\",\n        PlayerAction::ChangeLightIntensity { intensity_index: 1.2 }.validate()\n    );\n    println!(\n        \"VALIDATION ambient_bad={:?}\",\n        PlayerAction::ChangeAmbientTemperature { target_c: 0.0 }.validate()\n    );\n    println!(\n        \"VALIDATION source_blank={:?}\",\n        PlayerAction::WaterChangePercent { percent: 50.0, source_profile_id: \"   \".into() }.validate()\n    );\n\n    let mut save_engine = Engine::new(SimSeed(42));\n    save_engine.apply_action(PlayerAction::Feed { grams: 1.25 })?;\n    save_engine.apply_action(PlayerAction::ChangeAmbientTemperature { target_c: 25.5 })?;\n    save_engine.step_hours(1)?;\n    save_engine.apply_action(PlayerAction::ChangeLightIntensity { intensity_index: 0.6 })?;\n    let save = SaveFile::from_engine(&save_engine);\n    let json = save.to_json_pretty()?;\n    println!(\n        \"SAVEFILE schema={} app={} queued={} contains_schema={} contains_app={} contains_state={} contains_rng={} contains_queued={} seed_in_json={} draws_in_json={}\",\n        save.schema_version,\n        save.app_version,\n        save.queued_actions.len(),\n        json.contains(\"'\"\\\\\\\"schema_version\\\\\\\"\\\"),\n        json.contains(\\\"\\\\\\\"app_version\\\\\\\"\\\"),\n        json.contains(\\\"\\\\\\\"state\\\\\\\"\\\"),\n        json.contains(\\\"\\\\\\\"rng\\\\\\\"\\\"),\n        json.contains(\\\"\\\\\\\"queued_actions\\\\\\\"\\\"),\n        json.contains(\\\"\\\\\\\"seed\\\\\\\"\\\"),\n        json.contains(\\\"\\\\\\\"draws\\\\\\\"\\\"),\n    );\n    println\"'!(\"SAVEFILE preview={} \", json.lines().take(14).collect::<Vec<_>>().join(\" | \"));\n    let restored = SaveFile::from_json(&json)?;\n    let restored_engine = restored.clone().into_engine();\n    println!(\n        \"SAVE_ROUNDTRIP save_equal={} state_equal={} queue_equal={}\",\n        save == restored,\n        save_engine.full_state() == restored_engine.full_state(),\n        save_engine.queued_actions() == restored_engine.queued_actions(),\n    );\n\n    let mut deterministic_left = Engine::new(SimSeed(99));\n    let mut deterministic_right = Engine::new(SimSeed(99));\n    deterministic_left.step_hours(24)?;\n    deterministic_right.step_hours(24)?;\n    println!(\n        \"DETERMINISM snapshot_equal={} state_equal={}\",\n        deterministic_left.snapshot() == deterministic_right.snapshot(),\n        deterministic_left.full_state() == deterministic_right.full_state(),\n    );\n\n    let mut bad_state = TankState::new(SimSeed(3));\n    bad_state.water.ammonia_total_mg_n_total = -1.0;\n    let mut bad_engine = Engine::from_parts(bad_state, vec![]);\n    println!(\"INVARIANT negative_water_pool={:?}\", bad_engine.step_hours(1));\n\n    let mut clamp_state = TankState::new(SimSeed(4));\n    clamp_state.hardware.light.intensity_index = 1.7;\n    clamp_state.hardware.filter.cleanliness_index = -0.2;\n    clamp_state.filter_state.biofilter_maturity_index = 1.4;\n    clamp_state.animal.condition_index = -0.2;\n    clamp_state.geometry.lid_exchange_factor = 3.0;\n    let mut clamp_engine = Engine::from_parts(clamp_state, vec![]);\n    println!(\"INVARIANT clamp_run={:?}\", clamp_engine.step_hours(1));\n    println!(\n        \"INVARIANT clamped_light={} clamped_cleanliness={} clamped_biofilter={} clamped_condition={} clamped_lid={}\",\n        clamp_engine.full_state().hardware.light.intensity_index,\n        clamp_engine.full_state().hardware.filter.cleanliness_index,\n        clamp_engine.full_state().filter_state.biofilter_maturity_index,\n        clamp_engine.full_state().animal.condition_index,\n        clamp_engine.full_state().geometry.lid_exchange_factor,\n    );\n\n    let sources: Vec<_> = source_water_ids().iter().map(|id| load_source_water(id).unwrap().name).collect();\n    let substrates: Vec<_> = substrate_ids().iter().map(|id| load_substrate(id).unwrap().name).collect();\n    let plants: Vec<_> = plant_ids().iter().map(|id| load_plant(id).unwrap().name).collect();\n    let shrimp: Vec<_> = shrimp_ids().iter().map(|id| load_shrimp(id).unwrap().name).collect();\n    let process: Vec<_> = process_ids().iter().map(|id| load_process_params(id).unwrap().name).collect();\n    let scenarios: Vec<_> = scenario_ids().iter().map(|id| load_scenario(id).unwrap().name).collect();\n    println!(\n        \"PRESETS source={} substrate={} plant={} shrimp={} process={} scenario={}\",\n        sources.join(\",\"),\n        substrates.join(\",\"),\n        plants.join(\",\"),\n        shrimp.join(\",\"),\n        process.join(\",\"),\n        scenarios.join(\",\"),\n    );\n\n    Ok(())\n}\nRS\nnix shell nixpkgs#cargo nixpkgs#rustc nixpkgs#gcc -c rustc --edition=2021 /tmp/tank_manual_qa.rs -L dependency=target/debug/deps --extern tank_core=\"$CORE_LIB\" --extern tank_data=\"$DATA_LIB\" -o /tmp/tank_manual_qa && /tmp/tank_manual_qa'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
