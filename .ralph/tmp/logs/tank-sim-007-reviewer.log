{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RdBkUyfQNW8p4Z8ps4yenc","type":"tool_result","content":"     1→use crossterm::event::{KeyCode, KeyEvent, KeyEventKind};\n     2→\n     3→use crate::{screens::actions::ActionKind, Screen, StatusLevel, TuiApp};\n     4→\n     5→#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n     6→pub enum InputOutcome {\n     7→    Continue,\n     8→    Quit,\n     9→}\n    10→\n    11→pub fn handle_key_event(app: &mut TuiApp, key: KeyEvent) -> InputOutcome {\n    12→    if key.kind != KeyEventKind::Press {\n    13→        return InputOutcome::Continue;\n    14→    }\n    15→\n    16→    match key.code {\n    17→        KeyCode::Char('q') => return InputOutcome::Quit,\n    18→        KeyCode::Tab => app.next_screen(),\n    19→        KeyCode::Char(' ') => app.toggle_auto_advance(),\n    20→        KeyCode::Char('h') => app.step_hours(1),\n    21→        KeyCode::Char('d') => app.step_hours(24),\n    22→        KeyCode::Char('w') => app.step_hours(24 * 7),\n    23→        KeyCode::Char('s') => {\n    24→            if let Err(error) = app.save_to_disk() {\n    25→                app.show_status(StatusLevel::Error, format!(\"Save failed: {error:#}\"));\n    26→            }\n    27→        }\n    28→        KeyCode::Char('l') => {\n    29→            if let Err(error) = app.load_from_disk() {\n    30→                app.show_status(StatusLevel::Error, format!(\"Load failed: {error:#}\"));\n    31→            }\n    32→        }\n    33→        KeyCode::Char(digit) if Screen::from_digit(digit).is_some() => {\n    34→            if let Some(screen) = Screen::from_digit(digit) {\n    35→                app.set_screen(screen);\n    36→            }\n    37→        }\n    38→        _ => {\n    39→            if app.active_screen == Screen::Actions {\n    40→                handle_actions_input(app, key.code);\n    41→            }\n    42→        }\n    43→    }\n    44→\n    45→    InputOutcome::Continue\n    46→}\n    47→\n    48→fn handle_actions_input(app: &mut TuiApp, code: KeyCode) {\n    49→    match code {\n    50→        KeyCode::Up => app.action_form.select_previous_action(),\n    51→        KeyCode::Down => app.action_form.select_next_action(),\n    52→        KeyCode::Left => app.action_form.select_previous_field(),\n    53→        KeyCode::Right => app.action_form.select_next_field(),\n    54→        KeyCode::Char('[') => {\n    55→            if !app.action_form.cycle_choice(false) {\n    56→                app.show_status(StatusLevel::Warning, \"Selected field is not a choice field\");\n    57→            }\n    58→        }\n    59→        KeyCode::Char(']') => {\n    60→            if !app.action_form.cycle_choice(true) {\n    61→                app.show_status(StatusLevel::Warning, \"Selected field is not a choice field\");\n    62→            }\n    63→        }\n    64→        KeyCode::Char('t') => {\n    65→            if !app.action_form.toggle_boolean() {\n    66→                app.show_status(StatusLevel::Warning, \"Selected field is not a toggle\");\n    67→            }\n    68→        }\n    69→        KeyCode::Backspace => {\n    70→            if !app.action_form.backspace() {\n    71→                app.show_status(StatusLevel::Warning, \"Selected field is not numeric\");\n    72→            }\n    73→        }\n    74→        KeyCode::Enter => match app.action_form.submit() {\n    75→            Ok(action) => app.apply_action(action),\n    76→            Err(error) => app.show_status(StatusLevel::Error, error),\n    77→        },\n    78→        KeyCode::Char(ch) if ch.is_ascii_digit() || ch == '.' => {\n    79→            if !app.action_form.edit_char(ch) {\n    80→                let target = app.action_form.selected_action();\n    81→                let message = if matches!(\n    82→                    target,\n    83→                    ActionKind::WaterChangePercent | ActionKind::ChangeAeration\n    84→                ) {\n    85→                    \"Use [ ] or t for non-numeric fields\"\n    86→                } else {\n    87→                    \"Selected field only accepts numeric input\"\n    88→                };\n    89→                app.show_status(StatusLevel::Warning, message);\n    90→            }\n    91→        }\n    92→        _ => {}\n    93→    }\n    94→}\n    95→"}]},"parent_tool_use_id":null,"session_id":"25802005-47b4-42a6-9ace-9ceabaa42d42","uuid":"bff94d87-1bef-42a7-baed-caae1243e43a","tool_use_result":{"type":"text","file":{"filePath":"/root/tank-simulation/crates/tank_tui/src/input.rs","content":"use crossterm::event::{KeyCode, KeyEvent, KeyEventKind};\n\nuse crate::{screens::actions::ActionKind, Screen, StatusLevel, TuiApp};\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum InputOutcome {\n    Continue,\n    Quit,\n}\n\npub fn handle_key_event(app: &mut TuiApp, key: KeyEvent) -> InputOutcome {\n    if key.kind != KeyEventKind::Press {\n        return InputOutcome::Continue;\n    }\n\n    match key.code {\n        KeyCode::Char('q') => return InputOutcome::Quit,\n        KeyCode::Tab => app.next_screen(),\n        KeyCode::Char(' ') => app.toggle_auto_advance(),\n        KeyCode::Char('h') => app.step_hours(1),\n        KeyCode::Char('d') => app.step_hours(24),\n        KeyCode::Char('w') => app.step_hours(24 * 7),\n        KeyCode::Char('s') => {\n            if let Err(error) = app.save_to_disk() {\n                app.show_status(StatusLevel::Error, format!(\"Save failed: {error:#}\"));\n            }\n        }\n        KeyCode::Char('l') => {\n            if let Err(error) = app.load_from_disk() {\n                app.show_status(StatusLevel::Error, format!(\"Load failed: {error:#}\"));\n            }\n        }\n        KeyCode::Char(digit) if Screen::from_digit(digit).is_some() => {\n            if let Some(screen) = Screen::from_digit(digit) {\n                app.set_screen(screen);\n            }\n        }\n        _ => {\n            if app.active_screen == Screen::Actions {\n                handle_actions_input(app, key.code);\n            }\n        }\n    }\n\n    InputOutcome::Continue\n}\n\nfn handle_actions_input(app: &mut TuiApp, code: KeyCode) {\n    match code {\n        KeyCode::Up => app.action_form.select_previous_action(),\n        KeyCode::Down => app.action_form.select_next_action(),\n        KeyCode::Left => app.action_form.select_previous_field(),\n        KeyCode::Right => app.action_form.select_next_field(),\n        KeyCode::Char('[') => {\n            if !app.action_form.cycle_choice(false) {\n                app.show_status(StatusLevel::Warning, \"Selected field is not a choice field\");\n            }\n        }\n        KeyCode::Char(']') => {\n            if !app.action_form.cycle_choice(true) {\n                app.show_status(StatusLevel::Warning, \"Selected field is not a choice field\");\n            }\n        }\n        KeyCode::Char('t') => {\n            if !app.action_form.toggle_boolean() {\n                app.show_status(StatusLevel::Warning, \"Selected field is not a toggle\");\n            }\n        }\n        KeyCode::Backspace => {\n            if !app.action_form.backspace() {\n                app.show_status(StatusLevel::Warning, \"Selected field is not numeric\");\n            }\n        }\n        KeyCode::Enter => match app.action_form.submit() {\n            Ok(action) => app.apply_action(action),\n            Err(error) => app.show_status(StatusLevel::Error, error),\n        },\n        KeyCode::Char(ch) if ch.is_ascii_digit() || ch == '.' => {\n            if !app.action_form.edit_char(ch) {\n                let target = app.action_form.selected_action();\n                let message = if matches!(\n                    target,\n                    ActionKind::WaterChangePercent | ActionKind::ChangeAeration\n                ) {\n                    \"Use [ ] or t for non-numeric fields\"\n                } else {\n                    \"Selected field only accepts numeric input\"\n                };\n                app.show_status(StatusLevel::Warning, message);\n            }\n        }\n        _ => {}\n    }\n}\n","numLines":95,"startLine":1,"totalLines":95}}}
