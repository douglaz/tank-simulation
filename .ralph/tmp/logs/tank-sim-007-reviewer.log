{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ug6iw1rcVVFmvsjFWGCZfM","type":"tool_result","content":"     1→use ratatui::{\n     2→    prelude::*,\n     3→    widgets::{Block, Borders, List, ListItem, Paragraph},\n     4→};\n     5→use tank_core::PlayerAction;\n     6→\n     7→use crate::TuiApp;\n     8→\n     9→#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n    10→pub enum ActionKind {\n    11→    Feed,\n    12→    WaterChangePercent,\n    13→    TrimPlants,\n    14→    SiphonDetritus,\n    15→    CleanFilter,\n    16→    AddShrimp,\n    17→    RemoveShrimp,\n    18→    ChangePhotoperiod,\n    19→    ChangeLightIntensity,\n    20→    ChangeHeaterSetpoint,\n    21→    ChangeAmbientTemperature,\n    22→    ChangeAeration,\n    23→}\n    24→\n    25→impl ActionKind {\n    26→    pub const ALL: [Self; 12] = [\n    27→        Self::Feed,\n    28→        Self::WaterChangePercent,\n    29→        Self::TrimPlants,\n    30→        Self::SiphonDetritus,\n    31→        Self::CleanFilter,\n    32→        Self::AddShrimp,\n    33→        Self::RemoveShrimp,\n    34→        Self::ChangePhotoperiod,\n    35→        Self::ChangeLightIntensity,\n    36→        Self::ChangeHeaterSetpoint,\n    37→        Self::ChangeAmbientTemperature,\n    38→        Self::ChangeAeration,\n    39→    ];\n    40→\n    41→    pub fn label(self) -> &'static str {\n    42→        match self {\n    43→            Self::Feed => \"Feed\",\n    44→            Self::WaterChangePercent => \"Water change\",\n    45→            Self::TrimPlants => \"Trim plants\",\n    46→            Self::SiphonDetritus => \"Siphon detritus\",\n    47→            Self::CleanFilter => \"Clean filter\",\n    48→            Self::AddShrimp => \"Add shrimp\",\n    49→            Self::RemoveShrimp => \"Remove shrimp\",\n    50→            Self::ChangePhotoperiod => \"Photoperiod\",\n    51→            Self::ChangeLightIntensity => \"Light intensity\",\n    52→            Self::ChangeHeaterSetpoint => \"Heater setpoint\",\n    53→            Self::ChangeAmbientTemperature => \"Ambient temp\",\n    54→            Self::ChangeAeration => \"Aeration\",\n    55→        }\n    56→    }\n    57→\n    58→    fn field_count(self) -> usize {\n    59→        match self {\n    60→            Self::WaterChangePercent | Self::ChangeAeration => 2,\n    61→            _ => 1,\n    62→        }\n    63→    }\n    64→}\n    65→\n    66→#[derive(Debug, Clone, PartialEq)]\n    67→pub struct ActionFormState {\n    68→    selected_action: usize,\n    69→    selected_field: usize,\n    70→    replace_next_numeric: bool,\n    71→    feed_grams: String,\n    72→    water_change_percent: String,\n    73→    water_change_source_index: usize,\n    74→    trim_fraction: String,\n    75→    siphon_fraction: String,\n    76→    clean_filter_intensity: String,\n    77→    add_shrimp_count: String,\n    78→    remove_shrimp_count: String,\n    79→    photoperiod_hours: String,\n    80→    light_intensity: String,\n    81→    heater_setpoint_c: String,\n    82→    ambient_temp_c: String,\n    83→    aeration_enabled: bool,\n    84→    aeration_intensity: String,\n    85→}\n    86→\n    87→#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n    88→enum FieldKind {\n    89→    Numeric { integer_only: bool },\n    90→    Choice,\n    91→    Toggle,\n    92→}\n    93→\n    94→#[derive(Debug, Clone, PartialEq, Eq)]\n    95→pub struct ActionFieldView {\n    96→    pub label: String,\n    97→    pub value: String,\n    98→    pub hint: &'static str,\n    99→}\n   100→\n   101→impl Default for ActionFormState {\n   102→    fn default() -> Self {\n   103→        Self {\n   104→            selected_action: 0,\n   105→            selected_field: 0,\n   106→            replace_next_numeric: true,\n   107→            feed_grams: \"0.20\".to_string(),\n   108→            water_change_percent: \"25.0\".to_string(),\n   109→            water_change_source_index: 1,\n   110→            trim_fraction: \"0.25\".to_string(),\n   111→            siphon_fraction: \"0.30\".to_string(),\n   112→            clean_filter_intensity: \"0.50\".to_string(),\n   113→            add_shrimp_count: \"5\".to_string(),\n   114→            remove_shrimp_count: \"2\".to_string(),\n   115→            photoperiod_hours: \"8.0\".to_string(),\n   116→            light_intensity: \"0.70\".to_string(),\n   117→            heater_setpoint_c: \"24.0\".to_string(),\n   118→            ambient_temp_c: \"24.0\".to_string(),\n   119→            aeration_enabled: true,\n   120→            aeration_intensity: \"0.40\".to_string(),\n   121→        }\n   122→    }\n   123→}\n   124→\n   125→impl ActionFormState {\n   126→    pub fn selected_action(&self) -> ActionKind {\n   127→        ActionKind::ALL[self.selected_action]\n   128→    }\n   129→\n   130→    pub fn selected_action_index(&self) -> usize {\n   131→        self.selected_action\n   132→    }\n   133→\n   134→    pub fn selected_field_index(&self) -> usize {\n   135→        self.selected_field\n   136→    }\n   137→\n   138→    pub fn fields(&self) -> Vec<ActionFieldView> {\n   139→        match self.selected_action() {\n   140→            ActionKind::Feed => vec![ActionFieldView {\n   141→                label: \"grams\".to_string(),\n   142→                value: self.feed_grams.clone(),\n   143→                hint: \"Type a non-negative amount\",\n   144→            }],\n   145→            ActionKind::WaterChangePercent => vec![\n   146→                ActionFieldView {\n   147→                    label: \"percent\".to_string(),\n   148→                    value: self.water_change_percent.clone(),\n   149→                    hint: \"0.0 to 100.0\",\n   150→                },\n   151→                ActionFieldView {\n   152→                    label: \"source\".to_string(),\n   153→                    value: tank_data::source_water_ids()[self.water_change_source_index]\n   154→                        .to_string(),\n   155→                    hint: \"[ / ] cycle source profile\",\n   156→                },\n   157→            ],\n   158→            ActionKind::TrimPlants => vec![ActionFieldView {\n   159→                label: \"fraction\".to_string(),\n   160→                value: self.trim_fraction.clone(),\n   161→                hint: \"0.0 to 1.0\",\n   162→            }],\n   163→            ActionKind::SiphonDetritus => vec![ActionFieldView {\n   164→                label: \"fraction\".to_string(),\n   165→                value: self.siphon_fraction.clone(),\n   166→                hint: \"0.0 to 1.0\",\n   167→            }],\n   168→            ActionKind::CleanFilter => vec![ActionFieldView {\n   169→                label: \"intensity\".to_string(),\n   170→                value: self.clean_filter_intensity.clone(),\n   171→                hint: \"0.0 to 1.0\",\n   172→            }],\n   173→            ActionKind::AddShrimp => vec![ActionFieldView {\n   174→                label: \"count\".to_string(),\n   175→                value: self.add_shrimp_count.clone(),\n   176→                hint: \"Whole shrimp count\",\n   177→            }],\n   178→            ActionKind::RemoveShrimp => vec![ActionFieldView {\n   179→                label: \"count\".to_string(),\n   180→                value: self.remove_shrimp_count.clone(),\n   181→                hint: \"Whole shrimp count\",\n   182→            }],\n   183→            ActionKind::ChangePhotoperiod => vec![ActionFieldView {\n   184→                label: \"hours\".to_string(),\n   185→                value: self.photoperiod_hours.clone(),\n   186→                hint: \"0.0 to 24.0\",\n   187→            }],\n   188→            ActionKind::ChangeLightIntensity => vec![ActionFieldView {\n   189→                label: \"intensity\".to_string(),\n   190→                value: self.light_intensity.clone(),\n   191→                hint: \"0.0 to 1.0\",\n   192→            }],\n   193→            ActionKind::ChangeHeaterSetpoint => vec![ActionFieldView {\n   194→                label: \"setpoint C\".to_string(),\n   195→                value: self.heater_setpoint_c.clone(),\n   196→                hint: \"> 0.0 C\",\n   197→            }],\n   198→            ActionKind::ChangeAmbientTemperature => vec![ActionFieldView {\n   199→                label: \"target C\".to_string(),\n   200→                value: self.ambient_temp_c.clone(),\n   201→                hint: \"> 0.0 C\",\n   202→            }],\n   203→            ActionKind::ChangeAeration => vec![\n   204→                ActionFieldView {\n   205→                    label: \"enabled\".to_string(),\n   206→                    value: if self.aeration_enabled {\n   207→                        \"true\".to_string()\n   208→                    } else {\n   209→                        \"false\".to_string()\n   210→                    },\n   211→                    hint: \"Press t to toggle\",\n   212→                },\n   213→                ActionFieldView {\n   214→                    label: \"intensity\".to_string(),\n   215→                    value: self.aeration_intensity.clone(),\n   216→                    hint: \"0.0 to 1.0\",\n   217→                },\n   218→            ],\n   219→        }\n   220→    }\n   221→\n   222→    pub fn select_next_action(&mut self) {\n   223→        self.selected_action = (self.selected_action + 1) % ActionKind::ALL.len();\n   224→        self.reset_selection();\n   225→    }\n   226→\n   227→    pub fn select_previous_action(&mut self) {\n   228→        self.selected_action =\n   229→            (self.selected_action + ActionKind::ALL.len() - 1) % ActionKind::ALL.len();\n   230→        self.reset_selection();\n   231→    }\n   232→\n   233→    pub fn select_next_field(&mut self) {\n   234→        let max_fields = self.selected_action().field_count();\n   235→        self.selected_field = (self.selected_field + 1) % max_fields;\n   236→        self.replace_next_numeric = true;\n   237→    }\n   238→\n   239→    pub fn select_previous_field(&mut self) {\n   240→        let max_fields = self.selected_action().field_count();\n   241→        self.selected_field = (self.selected_field + max_fields - 1) % max_fields;\n   242→        self.replace_next_numeric = true;\n   243→    }\n   244→\n   245→    pub fn cycle_choice(&mut self, forward: bool) -> bool {\n   246→        if self.current_field_kind() != FieldKind::Choice {\n   247→            return false;\n   248→        }\n   249→\n   250→        let options = tank_data::source_water_ids();\n   251→        if forward {\n   252→            self.water_change_source_index = (self.water_change_source_index + 1) % options.len();\n   253→        } else {\n   254→            self.water_change_source_index =\n   255→                (self.water_change_source_index + options.len() - 1) % options.len();\n   256→        }\n   257→        true\n   258→    }\n   259→\n   260→    pub fn toggle_boolean(&mut self) -> bool {\n   261→        if self.current_field_kind() != FieldKind::Toggle {\n   262→            return false;\n   263→        }\n   264→\n   265→        self.aeration_enabled = !self.aeration_enabled;\n   266→        true\n   267→    }\n   268→\n   269→    pub fn edit_char(&mut self, ch: char) -> bool {\n   270→        let replace_next = self.replace_next_numeric;\n   271→        self.replace_next_numeric = false;\n   272→        let Some((buffer, integer_only)) = self.current_numeric_buffer_mut() else {\n   273→            self.replace_next_numeric = replace_next;\n   274→            return false;\n   275→        };\n   276→\n   277→        if integer_only && !ch.is_ascii_digit() {\n   278→            return false;\n   279→        }\n   280→        if !(integer_only || ch.is_ascii_digit() || ch == '.') {\n   281→            return false;\n   282→        }\n   283→        if ch == '.' && buffer.contains('.') {\n   284→            return false;\n   285→        }\n   286→\n   287→        if replace_next {\n   288→            buffer.clear();\n   289→        }\n   290→        buffer.push(ch);\n   291→        true\n   292→    }\n   293→\n   294→    pub fn backspace(&mut self) -> bool {\n   295→        let Some((buffer, _)) = self.current_numeric_buffer_mut() else {\n   296→            return false;\n   297→        };\n   298→\n   299→        buffer.pop();\n   300→        let became_empty = buffer.is_empty();\n   301→        if became_empty {\n   302→            buffer.push('0');\n   303→        }\n   304→        self.replace_next_numeric = became_empty;\n   305→        true\n   306→    }\n   307→\n   308→    pub fn submit(&mut self) -> Result<PlayerAction, String> {\n   309→        let action = match self.selected_action() {\n   310→            ActionKind::Feed => PlayerAction::Feed {\n   311→                grams: parse_f64(\"grams\", &self.feed_grams)?,\n   312→            },\n   313→            ActionKind::WaterChangePercent => PlayerAction::WaterChangePercent {\n   314→                percent: parse_f64(\"percent\", &self.water_change_percent)?,\n   315→                source_profile_id: tank_data::source_water_ids()[self.water_change_source_index]\n   316→                    .to_string(),\n   317→            },\n   318→            ActionKind::TrimPlants => PlayerAction::TrimPlants {\n   319→                fraction: parse_f64(\"fraction\", &self.trim_fraction)?,\n   320→            },\n   321→            ActionKind::SiphonDetritus => PlayerAction::SiphonDetritus {\n   322→                fraction: parse_f64(\"fraction\", &self.siphon_fraction)?,\n   323→            },\n   324→            ActionKind::CleanFilter => PlayerAction::CleanFilter {\n   325→                intensity: parse_f64(\"intensity\", &self.clean_filter_intensity)?,\n   326→            },\n   327→            ActionKind::AddShrimp => PlayerAction::AddShrimp {\n   328→                count: parse_u32(\"count\", &self.add_shrimp_count)?,\n   329→            },\n   330→            ActionKind::RemoveShrimp => PlayerAction::RemoveShrimp {\n   331→                count: parse_u32(\"count\", &self.remove_shrimp_count)?,\n   332→            },\n   333→            ActionKind::ChangePhotoperiod => PlayerAction::ChangePhotoperiod {\n   334→                hours: parse_f64(\"hours\", &self.photoperiod_hours)?,\n   335→            },\n   336→            ActionKind::ChangeLightIntensity => PlayerAction::ChangeLightIntensity {\n   337→                intensity_index: parse_f64(\"intensity_index\", &self.light_intensity)?,\n   338→            },\n   339→            ActionKind::ChangeHeaterSetpoint => PlayerAction::ChangeHeaterSetpoint {\n   340→                setpoint_c: parse_f64(\"setpoint_c\", &self.heater_setpoint_c)?,\n   341→            },\n   342→            ActionKind::ChangeAmbientTemperature => PlayerAction::ChangeAmbientTemperature {\n   343→                target_c: parse_f64(\"target_c\", &self.ambient_temp_c)?,\n   344→            },\n   345→            ActionKind::ChangeAeration => PlayerAction::ChangeAeration {\n   346→                enabled: self.aeration_enabled,\n   347→                intensity: parse_f64(\"intensity\", &self.aeration_intensity)?,\n   348→            },\n   349→        };\n   350→\n   351→        action.validate().map_err(|error| error.to_string())?;\n   352→        self.replace_next_numeric = true;\n   353→        Ok(action)\n   354→    }\n   355→\n   356→    fn current_field_kind(&self) -> FieldKind {\n   357→        match (self.selected_action(), self.selected_field) {\n   358→            (ActionKind::WaterChangePercent, 1) => FieldKind::Choice,\n   359→            (ActionKind::ChangeAeration, 0) => FieldKind::Toggle,\n   360→            (ActionKind::AddShrimp, 0) | (ActionKind::RemoveShrimp, 0) => {\n   361→                FieldKind::Numeric { integer_only: true }\n   362→            }\n   363→            _ => FieldKind::Numeric {\n   364→                integer_only: false,\n   365→            },\n   366→        }\n   367→    }\n   368→\n   369→    fn current_numeric_buffer_mut(&mut self) -> Option<(&mut String, bool)> {\n   370→        let integer_only = matches!(\n   371→            self.current_field_kind(),\n   372→            FieldKind::Numeric { integer_only: true }\n   373→        );\n   374→\n   375→        let buffer = match (self.selected_action(), self.selected_field) {\n   376→            (ActionKind::Feed, 0) => &mut self.feed_grams,\n   377→            (ActionKind::WaterChangePercent, 0) => &mut self.water_change_percent,\n   378→            (ActionKind::TrimPlants, 0) => &mut self.trim_fraction,\n   379→            (ActionKind::SiphonDetritus, 0) => &mut self.siphon_fraction,\n   380→            (ActionKind::CleanFilter, 0) => &mut self.clean_filter_intensity,\n   381→            (ActionKind::AddShrimp, 0) => &mut self.add_shrimp_count,\n   382→            (ActionKind::RemoveShrimp, 0) => &mut self.remove_shrimp_count,\n   383→            (ActionKind::ChangePhotoperiod, 0) => &mut self.photoperiod_hours,\n   384→            (ActionKind::ChangeLightIntensity, 0) => &mut self.light_intensity,\n   385→            (ActionKind::ChangeHeaterSetpoint, 0) => &mut self.heater_setpoint_c,\n   386→            (ActionKind::ChangeAmbientTemperature, 0) => &mut self.ambient_temp_c,\n   387→            (ActionKind::ChangeAeration, 1) => &mut self.aeration_intensity,\n   388→            _ => return None,\n   389→        };\n   390→\n   391→        Some((buffer, integer_only))\n   392→    }\n   393→\n   394→    fn reset_selection(&mut self) {\n   395→        self.selected_field = 0;\n   396→        self.replace_next_numeric = true;\n   397→    }\n   398→}\n   399→\n   400→pub fn render(frame: &mut Frame<'_>, area: Rect, app: &TuiApp) {\n   401→    let layout = Layout::horizontal([Constraint::Length(28), Constraint::Min(30)]).split(area);\n   402→    let actions = ActionKind::ALL\n   403→        .iter()\n   404→        .enumerate()\n   405→        .map(|(index, action)| {\n   406→            let style = if index == app.action_form.selected_action_index() {\n   407→                Style::default()\n   408→                    .fg(Color::Cyan)\n   409→                    .add_modifier(Modifier::BOLD)\n   410→            } else {\n   411→                Style::default()\n   412→            };\n   413→            ListItem::new(action.label()).style(style)\n   414→        })\n   415→        .collect::<Vec<_>>();\n   416→    let action_list = List::new(actions).block(\n   417→        Block::default()\n   418→            .title(\"Action variants\")\n   419→            .borders(Borders::ALL),\n   420→    );\n   421→    frame.render_widget(action_list, layout[0]);\n   422→\n   423→    let field_items = app\n   424→        .action_form\n   425→        .fields()\n   426→        .into_iter()\n   427→        .enumerate()\n   428→        .map(|(index, field)| {\n   429→            let prefix = if index == app.action_form.selected_field_index() {\n   430→                \">\"\n   431→            } else {\n   432→                \" \"\n   433→            };\n   434→            let style = if index == app.action_form.selected_field_index() {\n   435→                Style::default().fg(Color::Yellow)\n   436→            } else {\n   437→                Style::default()\n   438→            };\n   439→            ListItem::new(Line::from(vec![\n   440→                Span::styled(format!(\"{prefix} {}: \", field.label), style),\n   441→                Span::raw(field.value),\n   442→                Span::styled(\n   443→                    format!(\"  ({})\", field.hint),\n   444→                    Style::default().fg(Color::DarkGray),\n   445→                ),\n   446→            ]))\n   447→        })\n   448→        .collect::<Vec<_>>();\n   449→\n   450→    let right = Layout::vertical([Constraint::Min(7), Constraint::Length(5)]).split(layout[1]);\n   451→    let fields = List::new(field_items).block(\n   452→        Block::default()\n   453→            .title(format!(\n   454→                \"{} form\",\n   455→                app.action_form.selected_action().label()\n   456→            ))\n   457→            .borders(Borders::ALL),\n   458→    );\n   459→    frame.render_widget(fields, right[0]);\n   460→\n   461→    let help = Paragraph::new(vec![\n   462→        Line::from(\"Up/Down change action  Left/Right change field\"),\n   463→        Line::from(\"Type digits or '.' to edit numeric fields  Backspace deletes\"),\n   464→        Line::from(\"[ and ] cycle source water  t toggles booleans  Enter queues action\"),\n   465→    ])\n   466→    .block(Block::default().title(\"Controls\").borders(Borders::ALL))\n   467→    .wrap(ratatui::widgets::Wrap { trim: true });\n   468→    frame.render_widget(help, right[1]);\n   469→}\n   470→\n   471→fn parse_f64(field: &'static str, raw: &str) -> Result<f64, String> {\n   472→    raw.parse::<f64>()\n   473→        .map_err(|_| format!(\"{field} must be a number\"))\n   474→}\n   475→\n   476→fn parse_u32(field: &'static str, raw: &str) -> Result<u32, String> {\n   477→    raw.parse::<u32>()\n   478→        .map_err(|_| format!(\"{field} must be a whole number\"))\n   479→}\n   480→\n   481→#[cfg(test)]\n   482→mod tests {\n   483→    use super::*;\n   484→\n   485→    #[test]\n   486→    fn builds_water_change_action_with_profile_selection() {\n   487→        let mut form = ActionFormState::default();\n   488→        form.select_next_action();\n   489→        form.select_next_field();\n   490→        form.cycle_choice(true);\n   491→\n   492→        let action = form.submit().expect(\"water change action should parse\");\n   493→        assert_eq!(\n   494→            action,\n   495→            PlayerAction::WaterChangePercent {\n   496→                percent: 25.0,\n   497→                source_profile_id: \"hard_shrimp\".to_string(),\n   498→            }\n   499→        );\n   500→    }\n   501→\n   502→    #[test]\n   503→    fn rejects_invalid_integer_counts() {\n   504→        let mut form = ActionFormState::default();\n   505→        for _ in 0..5 {\n   506→            form.select_next_action();\n   507→        }\n   508→        form.add_shrimp_count = \"1.5\".to_string();\n   509→\n   510→        let error = form.submit().expect_err(\"count should require integers\");\n   511→        assert!(error.contains(\"whole number\"));\n   512→    }\n   513→}\n   514→"}]},"parent_tool_use_id":null,"session_id":"25802005-47b4-42a6-9ace-9ceabaa42d42","uuid":"b6fd049d-183b-4c73-bfbd-31cb95e329a7","tool_use_result":{"type":"text","file":{"filePath":"/root/tank-simulation/crates/tank_tui/src/screens/actions.rs","content":"use ratatui::{\n    prelude::*,\n    widgets::{Block, Borders, List, ListItem, Paragraph},\n};\nuse tank_core::PlayerAction;\n\nuse crate::TuiApp;\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum ActionKind {\n    Feed,\n    WaterChangePercent,\n    TrimPlants,\n    SiphonDetritus,\n    CleanFilter,\n    AddShrimp,\n    RemoveShrimp,\n    ChangePhotoperiod,\n    ChangeLightIntensity,\n    ChangeHeaterSetpoint,\n    ChangeAmbientTemperature,\n    ChangeAeration,\n}\n\nimpl ActionKind {\n    pub const ALL: [Self; 12] = [\n        Self::Feed,\n        Self::WaterChangePercent,\n        Self::TrimPlants,\n        Self::SiphonDetritus,\n        Self::CleanFilter,\n        Self::AddShrimp,\n        Self::RemoveShrimp,\n        Self::ChangePhotoperiod,\n        Self::ChangeLightIntensity,\n        Self::ChangeHeaterSetpoint,\n        Self::ChangeAmbientTemperature,\n        Self::ChangeAeration,\n    ];\n\n    pub fn label(self) -> &'static str {\n        match self {\n            Self::Feed => \"Feed\",\n            Self::WaterChangePercent => \"Water change\",\n            Self::TrimPlants => \"Trim plants\",\n            Self::SiphonDetritus => \"Siphon detritus\",\n            Self::CleanFilter => \"Clean filter\",\n            Self::AddShrimp => \"Add shrimp\",\n            Self::RemoveShrimp => \"Remove shrimp\",\n            Self::ChangePhotoperiod => \"Photoperiod\",\n            Self::ChangeLightIntensity => \"Light intensity\",\n            Self::ChangeHeaterSetpoint => \"Heater setpoint\",\n            Self::ChangeAmbientTemperature => \"Ambient temp\",\n            Self::ChangeAeration => \"Aeration\",\n        }\n    }\n\n    fn field_count(self) -> usize {\n        match self {\n            Self::WaterChangePercent | Self::ChangeAeration => 2,\n            _ => 1,\n        }\n    }\n}\n\n#[derive(Debug, Clone, PartialEq)]\npub struct ActionFormState {\n    selected_action: usize,\n    selected_field: usize,\n    replace_next_numeric: bool,\n    feed_grams: String,\n    water_change_percent: String,\n    water_change_source_index: usize,\n    trim_fraction: String,\n    siphon_fraction: String,\n    clean_filter_intensity: String,\n    add_shrimp_count: String,\n    remove_shrimp_count: String,\n    photoperiod_hours: String,\n    light_intensity: String,\n    heater_setpoint_c: String,\n    ambient_temp_c: String,\n    aeration_enabled: bool,\n    aeration_intensity: String,\n}\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\nenum FieldKind {\n    Numeric { integer_only: bool },\n    Choice,\n    Toggle,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct ActionFieldView {\n    pub label: String,\n    pub value: String,\n    pub hint: &'static str,\n}\n\nimpl Default for ActionFormState {\n    fn default() -> Self {\n        Self {\n            selected_action: 0,\n            selected_field: 0,\n            replace_next_numeric: true,\n            feed_grams: \"0.20\".to_string(),\n            water_change_percent: \"25.0\".to_string(),\n            water_change_source_index: 1,\n            trim_fraction: \"0.25\".to_string(),\n            siphon_fraction: \"0.30\".to_string(),\n            clean_filter_intensity: \"0.50\".to_string(),\n            add_shrimp_count: \"5\".to_string(),\n            remove_shrimp_count: \"2\".to_string(),\n            photoperiod_hours: \"8.0\".to_string(),\n            light_intensity: \"0.70\".to_string(),\n            heater_setpoint_c: \"24.0\".to_string(),\n            ambient_temp_c: \"24.0\".to_string(),\n            aeration_enabled: true,\n            aeration_intensity: \"0.40\".to_string(),\n        }\n    }\n}\n\nimpl ActionFormState {\n    pub fn selected_action(&self) -> ActionKind {\n        ActionKind::ALL[self.selected_action]\n    }\n\n    pub fn selected_action_index(&self) -> usize {\n        self.selected_action\n    }\n\n    pub fn selected_field_index(&self) -> usize {\n        self.selected_field\n    }\n\n    pub fn fields(&self) -> Vec<ActionFieldView> {\n        match self.selected_action() {\n            ActionKind::Feed => vec![ActionFieldView {\n                label: \"grams\".to_string(),\n                value: self.feed_grams.clone(),\n                hint: \"Type a non-negative amount\",\n            }],\n            ActionKind::WaterChangePercent => vec![\n                ActionFieldView {\n                    label: \"percent\".to_string(),\n                    value: self.water_change_percent.clone(),\n                    hint: \"0.0 to 100.0\",\n                },\n                ActionFieldView {\n                    label: \"source\".to_string(),\n                    value: tank_data::source_water_ids()[self.water_change_source_index]\n                        .to_string(),\n                    hint: \"[ / ] cycle source profile\",\n                },\n            ],\n            ActionKind::TrimPlants => vec![ActionFieldView {\n                label: \"fraction\".to_string(),\n                value: self.trim_fraction.clone(),\n                hint: \"0.0 to 1.0\",\n            }],\n            ActionKind::SiphonDetritus => vec![ActionFieldView {\n                label: \"fraction\".to_string(),\n                value: self.siphon_fraction.clone(),\n                hint: \"0.0 to 1.0\",\n            }],\n            ActionKind::CleanFilter => vec![ActionFieldView {\n                label: \"intensity\".to_string(),\n                value: self.clean_filter_intensity.clone(),\n                hint: \"0.0 to 1.0\",\n            }],\n            ActionKind::AddShrimp => vec![ActionFieldView {\n                label: \"count\".to_string(),\n                value: self.add_shrimp_count.clone(),\n                hint: \"Whole shrimp count\",\n            }],\n            ActionKind::RemoveShrimp => vec![ActionFieldView {\n                label: \"count\".to_string(),\n                value: self.remove_shrimp_count.clone(),\n                hint: \"Whole shrimp count\",\n            }],\n            ActionKind::ChangePhotoperiod => vec![ActionFieldView {\n                label: \"hours\".to_string(),\n                value: self.photoperiod_hours.clone(),\n                hint: \"0.0 to 24.0\",\n            }],\n            ActionKind::ChangeLightIntensity => vec![ActionFieldView {\n                label: \"intensity\".to_string(),\n                value: self.light_intensity.clone(),\n                hint: \"0.0 to 1.0\",\n            }],\n            ActionKind::ChangeHeaterSetpoint => vec![ActionFieldView {\n                label: \"setpoint C\".to_string(),\n                value: self.heater_setpoint_c.clone(),\n                hint: \"> 0.0 C\",\n            }],\n            ActionKind::ChangeAmbientTemperature => vec![ActionFieldView {\n                label: \"target C\".to_string(),\n                value: self.ambient_temp_c.clone(),\n                hint: \"> 0.0 C\",\n            }],\n            ActionKind::ChangeAeration => vec![\n                ActionFieldView {\n                    label: \"enabled\".to_string(),\n                    value: if self.aeration_enabled {\n                        \"true\".to_string()\n                    } else {\n                        \"false\".to_string()\n                    },\n                    hint: \"Press t to toggle\",\n                },\n                ActionFieldView {\n                    label: \"intensity\".to_string(),\n                    value: self.aeration_intensity.clone(),\n                    hint: \"0.0 to 1.0\",\n                },\n            ],\n        }\n    }\n\n    pub fn select_next_action(&mut self) {\n        self.selected_action = (self.selected_action + 1) % ActionKind::ALL.len();\n        self.reset_selection();\n    }\n\n    pub fn select_previous_action(&mut self) {\n        self.selected_action =\n            (self.selected_action + ActionKind::ALL.len() - 1) % ActionKind::ALL.len();\n        self.reset_selection();\n    }\n\n    pub fn select_next_field(&mut self) {\n        let max_fields = self.selected_action().field_count();\n        self.selected_field = (self.selected_field + 1) % max_fields;\n        self.replace_next_numeric = true;\n    }\n\n    pub fn select_previous_field(&mut self) {\n        let max_fields = self.selected_action().field_count();\n        self.selected_field = (self.selected_field + max_fields - 1) % max_fields;\n        self.replace_next_numeric = true;\n    }\n\n    pub fn cycle_choice(&mut self, forward: bool) -> bool {\n        if self.current_field_kind() != FieldKind::Choice {\n            return false;\n        }\n\n        let options = tank_data::source_water_ids();\n        if forward {\n            self.water_change_source_index = (self.water_change_source_index + 1) % options.len();\n        } else {\n            self.water_change_source_index =\n                (self.water_change_source_index + options.len() - 1) % options.len();\n        }\n        true\n    }\n\n    pub fn toggle_boolean(&mut self) -> bool {\n        if self.current_field_kind() != FieldKind::Toggle {\n            return false;\n        }\n\n        self.aeration_enabled = !self.aeration_enabled;\n        true\n    }\n\n    pub fn edit_char(&mut self, ch: char) -> bool {\n        let replace_next = self.replace_next_numeric;\n        self.replace_next_numeric = false;\n        let Some((buffer, integer_only)) = self.current_numeric_buffer_mut() else {\n            self.replace_next_numeric = replace_next;\n            return false;\n        };\n\n        if integer_only && !ch.is_ascii_digit() {\n            return false;\n        }\n        if !(integer_only || ch.is_ascii_digit() || ch == '.') {\n            return false;\n        }\n        if ch == '.' && buffer.contains('.') {\n            return false;\n        }\n\n        if replace_next {\n            buffer.clear();\n        }\n        buffer.push(ch);\n        true\n    }\n\n    pub fn backspace(&mut self) -> bool {\n        let Some((buffer, _)) = self.current_numeric_buffer_mut() else {\n            return false;\n        };\n\n        buffer.pop();\n        let became_empty = buffer.is_empty();\n        if became_empty {\n            buffer.push('0');\n        }\n        self.replace_next_numeric = became_empty;\n        true\n    }\n\n    pub fn submit(&mut self) -> Result<PlayerAction, String> {\n        let action = match self.selected_action() {\n            ActionKind::Feed => PlayerAction::Feed {\n                grams: parse_f64(\"grams\", &self.feed_grams)?,\n            },\n            ActionKind::WaterChangePercent => PlayerAction::WaterChangePercent {\n                percent: parse_f64(\"percent\", &self.water_change_percent)?,\n                source_profile_id: tank_data::source_water_ids()[self.water_change_source_index]\n                    .to_string(),\n            },\n            ActionKind::TrimPlants => PlayerAction::TrimPlants {\n                fraction: parse_f64(\"fraction\", &self.trim_fraction)?,\n            },\n            ActionKind::SiphonDetritus => PlayerAction::SiphonDetritus {\n                fraction: parse_f64(\"fraction\", &self.siphon_fraction)?,\n            },\n            ActionKind::CleanFilter => PlayerAction::CleanFilter {\n                intensity: parse_f64(\"intensity\", &self.clean_filter_intensity)?,\n            },\n            ActionKind::AddShrimp => PlayerAction::AddShrimp {\n                count: parse_u32(\"count\", &self.add_shrimp_count)?,\n            },\n            ActionKind::RemoveShrimp => PlayerAction::RemoveShrimp {\n                count: parse_u32(\"count\", &self.remove_shrimp_count)?,\n            },\n            ActionKind::ChangePhotoperiod => PlayerAction::ChangePhotoperiod {\n                hours: parse_f64(\"hours\", &self.photoperiod_hours)?,\n            },\n            ActionKind::ChangeLightIntensity => PlayerAction::ChangeLightIntensity {\n                intensity_index: parse_f64(\"intensity_index\", &self.light_intensity)?,\n            },\n            ActionKind::ChangeHeaterSetpoint => PlayerAction::ChangeHeaterSetpoint {\n                setpoint_c: parse_f64(\"setpoint_c\", &self.heater_setpoint_c)?,\n            },\n            ActionKind::ChangeAmbientTemperature => PlayerAction::ChangeAmbientTemperature {\n                target_c: parse_f64(\"target_c\", &self.ambient_temp_c)?,\n            },\n            ActionKind::ChangeAeration => PlayerAction::ChangeAeration {\n                enabled: self.aeration_enabled,\n                intensity: parse_f64(\"intensity\", &self.aeration_intensity)?,\n            },\n        };\n\n        action.validate().map_err(|error| error.to_string())?;\n        self.replace_next_numeric = true;\n        Ok(action)\n    }\n\n    fn current_field_kind(&self) -> FieldKind {\n        match (self.selected_action(), self.selected_field) {\n            (ActionKind::WaterChangePercent, 1) => FieldKind::Choice,\n            (ActionKind::ChangeAeration, 0) => FieldKind::Toggle,\n            (ActionKind::AddShrimp, 0) | (ActionKind::RemoveShrimp, 0) => {\n                FieldKind::Numeric { integer_only: true }\n            }\n            _ => FieldKind::Numeric {\n                integer_only: false,\n            },\n        }\n    }\n\n    fn current_numeric_buffer_mut(&mut self) -> Option<(&mut String, bool)> {\n        let integer_only = matches!(\n            self.current_field_kind(),\n            FieldKind::Numeric { integer_only: true }\n        );\n\n        let buffer = match (self.selected_action(), self.selected_field) {\n            (ActionKind::Feed, 0) => &mut self.feed_grams,\n            (ActionKind::WaterChangePercent, 0) => &mut self.water_change_percent,\n            (ActionKind::TrimPlants, 0) => &mut self.trim_fraction,\n            (ActionKind::SiphonDetritus, 0) => &mut self.siphon_fraction,\n            (ActionKind::CleanFilter, 0) => &mut self.clean_filter_intensity,\n            (ActionKind::AddShrimp, 0) => &mut self.add_shrimp_count,\n            (ActionKind::RemoveShrimp, 0) => &mut self.remove_shrimp_count,\n            (ActionKind::ChangePhotoperiod, 0) => &mut self.photoperiod_hours,\n            (ActionKind::ChangeLightIntensity, 0) => &mut self.light_intensity,\n            (ActionKind::ChangeHeaterSetpoint, 0) => &mut self.heater_setpoint_c,\n            (ActionKind::ChangeAmbientTemperature, 0) => &mut self.ambient_temp_c,\n            (ActionKind::ChangeAeration, 1) => &mut self.aeration_intensity,\n            _ => return None,\n        };\n\n        Some((buffer, integer_only))\n    }\n\n    fn reset_selection(&mut self) {\n        self.selected_field = 0;\n        self.replace_next_numeric = true;\n    }\n}\n\npub fn render(frame: &mut Frame<'_>, area: Rect, app: &TuiApp) {\n    let layout = Layout::horizontal([Constraint::Length(28), Constraint::Min(30)]).split(area);\n    let actions = ActionKind::ALL\n        .iter()\n        .enumerate()\n        .map(|(index, action)| {\n            let style = if index == app.action_form.selected_action_index() {\n                Style::default()\n                    .fg(Color::Cyan)\n                    .add_modifier(Modifier::BOLD)\n            } else {\n                Style::default()\n            };\n            ListItem::new(action.label()).style(style)\n        })\n        .collect::<Vec<_>>();\n    let action_list = List::new(actions).block(\n        Block::default()\n            .title(\"Action variants\")\n            .borders(Borders::ALL),\n    );\n    frame.render_widget(action_list, layout[0]);\n\n    let field_items = app\n        .action_form\n        .fields()\n        .into_iter()\n        .enumerate()\n        .map(|(index, field)| {\n            let prefix = if index == app.action_form.selected_field_index() {\n                \">\"\n            } else {\n                \" \"\n            };\n            let style = if index == app.action_form.selected_field_index() {\n                Style::default().fg(Color::Yellow)\n            } else {\n                Style::default()\n            };\n            ListItem::new(Line::from(vec![\n                Span::styled(format!(\"{prefix} {}: \", field.label), style),\n                Span::raw(field.value),\n                Span::styled(\n                    format!(\"  ({})\", field.hint),\n                    Style::default().fg(Color::DarkGray),\n                ),\n            ]))\n        })\n        .collect::<Vec<_>>();\n\n    let right = Layout::vertical([Constraint::Min(7), Constraint::Length(5)]).split(layout[1]);\n    let fields = List::new(field_items).block(\n        Block::default()\n            .title(format!(\n                \"{} form\",\n                app.action_form.selected_action().label()\n            ))\n            .borders(Borders::ALL),\n    );\n    frame.render_widget(fields, right[0]);\n\n    let help = Paragraph::new(vec![\n        Line::from(\"Up/Down change action  Left/Right change field\"),\n        Line::from(\"Type digits or '.' to edit numeric fields  Backspace deletes\"),\n        Line::from(\"[ and ] cycle source water  t toggles booleans  Enter queues action\"),\n    ])\n    .block(Block::default().title(\"Controls\").borders(Borders::ALL))\n    .wrap(ratatui::widgets::Wrap { trim: true });\n    frame.render_widget(help, right[1]);\n}\n\nfn parse_f64(field: &'static str, raw: &str) -> Result<f64, String> {\n    raw.parse::<f64>()\n        .map_err(|_| format!(\"{field} must be a number\"))\n}\n\nfn parse_u32(field: &'static str, raw: &str) -> Result<u32, String> {\n    raw.parse::<u32>()\n        .map_err(|_| format!(\"{field} must be a whole number\"))\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn builds_water_change_action_with_profile_selection() {\n        let mut form = ActionFormState::default();\n        form.select_next_action();\n        form.select_next_field();\n        form.cycle_choice(true);\n\n        let action = form.submit().expect(\"water change action should parse\");\n        assert_eq!(\n            action,\n            PlayerAction::WaterChangePercent {\n                percent: 25.0,\n                source_profile_id: \"hard_shrimp\".to_string(),\n            }\n        );\n    }\n\n    #[test]\n    fn rejects_invalid_integer_counts() {\n        let mut form = ActionFormState::default();\n        for _ in 0..5 {\n            form.select_next_action();\n        }\n        form.add_shrimp_count = \"1.5\".to_string();\n\n        let error = form.submit().expect_err(\"count should require integers\");\n        assert!(error.contains(\"whole number\"));\n    }\n}\n","numLines":514,"startLine":1,"totalLines":514}}}
