{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HTCAEPgc83nWvCs5JRuXSf","type":"tool_result","content":"     1→use std::collections::BTreeMap;\n     2→\n     3→use tank_core::{\n     4→    AnimalState, FilterState, MicrobeState, PlantGuild, PlantGuildState, ProcessParams,\n     5→    ShrimpRuntimeParams, SimMeta, SimSeed, SourceWaterProfile, SubstrateLayerState, TankGeometry,\n     6→    TankState, WaterState,\n     7→};\n     8→use tank_data::{load_scenario, ScenarioPreset};\n     9→\n    10→#[derive(Debug, Clone, Copy, PartialEq)]\n    11→pub struct ScenarioGeometryOverrides {\n    12→    pub size_scale: f64,\n    13→    pub fill_ratio: f64,\n    14→}\n    15→\n    16→impl Default for ScenarioGeometryOverrides {\n    17→    fn default() -> Self {\n    18→        Self {\n    19→            size_scale: 1.0,\n    20→            fill_ratio: 1.0,\n    21→        }\n    22→    }\n    23→}\n    24→\n    25→#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n    26→pub enum StartupSubstratePreset {\n    27→    InertSand,\n    28→    InertGravel,\n    29→    ActivePlanted,\n    30→    ActivePlantedWithCoarsePorous,\n    31→}\n    32→\n    33→impl StartupSubstratePreset {\n    34→    pub const ALL: [Self; 4] = [\n    35→        Self::InertSand,\n    36→        Self::InertGravel,\n    37→        Self::ActivePlanted,\n    38→        Self::ActivePlantedWithCoarsePorous,\n    39→    ];\n    40→\n    41→    pub fn label(self) -> &'static str {\n    42→        match self {\n    43→            Self::InertSand => \"inert_sand\",\n    44→            Self::InertGravel => \"inert_gravel\",\n    45→            Self::ActivePlanted => \"active_planted\",\n    46→            Self::ActivePlantedWithCoarsePorous => \"active_planted + coarse_porous\",\n    47→        }\n    48→    }\n    49→\n    50→    fn preset_ids(self) -> &'static [&'static str] {\n    51→        match self {\n    52→            Self::InertSand => &[\"inert_sand\"],\n    53→            Self::InertGravel => &[\"inert_gravel\"],\n    54→            Self::ActivePlanted => &[\"active_planted\"],\n    55→            Self::ActivePlantedWithCoarsePorous => &[\"active_planted\", \"coarse_porous\"],\n    56→        }\n    57→    }\n    58→\n    59→    fn from_ids(ids: &[String]) -> Option<Self> {\n    60→        let ids = ids.iter().map(String::as_str).collect::<Vec<_>>();\n    61→        match ids.as_slice() {\n    62→            [\"inert_sand\"] => Some(Self::InertSand),\n    63→            [\"inert_gravel\"] => Some(Self::InertGravel),\n    64→            [\"active_planted\"] => Some(Self::ActivePlanted),\n    65→            [\"active_planted\", \"coarse_porous\"] => Some(Self::ActivePlantedWithCoarsePorous),\n    66→            _ => None,\n    67→        }\n    68→    }\n    69→}\n    70→\n    71→#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n    72→pub enum StartupPlantSelection {\n    73→    FastStemOnly,\n    74→    RootFeedingRosetteOnly,\n    75→    BothGuilds,\n    76→    None,\n    77→}\n    78→\n    79→impl StartupPlantSelection {\n    80→    pub const ALL: [Self; 4] = [\n    81→        Self::FastStemOnly,\n    82→        Self::RootFeedingRosetteOnly,\n    83→        Self::BothGuilds,\n    84→        Self::None,\n    85→    ];\n    86→\n    87→    pub fn label(self) -> &'static str {\n    88→        match self {\n    89→            Self::FastStemOnly => \"FastStem only\",\n    90→            Self::RootFeedingRosetteOnly => \"RootFeedingRosette only\",\n    91→            Self::BothGuilds => \"Both guilds\",\n    92→            Self::None => \"None\",\n    93→        }\n    94→    }\n    95→\n    96→    fn preset_ids(self) -> &'static [&'static str] {\n    97→        match self {\n    98→            Self::FastStemOnly => &[\"fast_stem\"],\n    99→            Self::RootFeedingRosetteOnly => &[\"root_rosette\"],\n   100→            Self::BothGuilds => &[\"fast_stem\", \"root_rosette\"],\n   101→            Self::None => &[],\n   102→        }\n   103→    }\n   104→\n   105→    fn from_ids(ids: &[String]) -> Option<Self> {\n   106→        let mut normalized = ids.iter().map(String::as_str).collect::<Vec<_>>();\n   107→        normalized.sort_unstable();\n   108→        match normalized.as_slice() {\n   109→            [] => Some(Self::None),\n   110→            [\"fast_stem\"] => Some(Self::FastStemOnly),\n   111→            [\"root_rosette\"] => Some(Self::RootFeedingRosetteOnly),\n   112→            [\"fast_stem\", \"root_rosette\"] => Some(Self::BothGuilds),\n   113→            _ => None,\n   114→        }\n   115→    }\n   116→}\n   117→\n   118→#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n   119→pub enum StartupLightPreset {\n   120→    Hours6,\n   121→    Hours8,\n   122→    Hours10,\n   123→    Hours12,\n   124→}\n   125→\n   126→impl StartupLightPreset {\n   127→    pub const ALL: [Self; 4] = [Self::Hours6, Self::Hours8, Self::Hours10, Self::Hours12];\n   128→\n   129→    pub fn label(self) -> &'static str {\n   130→        match self {\n   131→            Self::Hours6 => \"6h\",\n   132→            Self::Hours8 => \"8h\",\n   133→            Self::Hours10 => \"10h\",\n   134→            Self::Hours12 => \"12h\",\n   135→        }\n   136→    }\n   137→\n   138→    pub fn hours(self) -> f64 {\n   139→        match self {\n   140→            Self::Hours6 => 6.0,\n   141→            Self::Hours8 => 8.0,\n   142→            Self::Hours10 => 10.0,\n   143→            Self::Hours12 => 12.0,\n   144→        }\n   145→    }\n   146→}\n   147→\n   148→#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n   149→pub enum StartupHeaterPreset {\n   150→    Off,\n   151→    Celsius24,\n   152→    Celsius25,\n   153→    Celsius26,\n   154→}\n   155→\n   156→impl StartupHeaterPreset {\n   157→    pub const ALL: [Self; 4] = [Self::Off, Self::Celsius24, Self::Celsius25, Self::Celsius26];\n   158→\n   159→    pub fn label(self) -> &'static str {\n   160→        match self {\n   161→            Self::Off => \"Off\",\n   162→            Self::Celsius24 => \"24 C\",\n   163→            Self::Celsius25 => \"25 C\",\n   164→            Self::Celsius26 => \"26 C\",\n   165→        }\n   166→    }\n   167→\n   168→    pub fn setpoint_c(self) -> Option<f64> {\n   169→        match self {\n   170→            Self::Off => None,\n   171→            Self::Celsius24 => Some(24.0),\n   172→            Self::Celsius25 => Some(25.0),\n   173→            Self::Celsius26 => Some(26.0),\n   174→        }\n   175→    }\n   176→}\n   177→\n   178→#[derive(Debug, Clone, PartialEq)]\n   179→pub struct StartupOverrides {\n   180→    pub geometry: ScenarioGeometryOverrides,\n   181→    pub source_water_profile_id: Option<String>,\n   182→    pub substrate_preset: Option<StartupSubstratePreset>,\n   183→    pub plant_selection: Option<StartupPlantSelection>,\n   184→    pub filter_enabled: Option<bool>,\n   185→    pub light_preset: Option<StartupLightPreset>,\n   186→    pub heater_preset: Option<StartupHeaterPreset>,\n   187→    pub aeration_enabled: Option<bool>,\n   188→    pub initial_adult_shrimp_count: Option<u32>,\n   189→}\n   190→\n   191→impl Default for StartupOverrides {\n   192→    fn default() -> Self {\n   193→        Self {\n   194→            geometry: ScenarioGeometryOverrides::default(),\n   195→            source_water_profile_id: None,\n   196→            substrate_preset: None,\n   197→            plant_selection: None,\n   198→            filter_enabled: None,\n   199→            light_preset: None,\n   200→            heater_preset: None,\n   201→            aeration_enabled: None,\n   202→            initial_adult_shrimp_count: None,\n   203→        }\n   204→    }\n   205→}\n   206→\n   207→pub fn default_scenario_ids() -> &'static [&'static str] {\n   208→    tank_data::scenario_ids()\n   209→}\n   210→\n   211→pub fn startup_source_water_ids() -> &'static [&'static str] {\n   212→    tank_data::source_water_ids()\n   213→}\n   214→\n   215→pub fn load_named_scenario(id: &str) -> Result<ScenarioPreset, tank_data::PresetError> {\n   216→    load_scenario(id)\n   217→}\n   218→\n   219→pub fn seeded_state_with_overrides(\n   220→    seed: SimSeed,\n   221→    scenario_id: &str,\n   222→    overrides: ScenarioGeometryOverrides,\n   223→) -> Result<TankState, tank_data::PresetError> {\n   224→    seeded_state_with_full_overrides(\n   225→        seed,\n   226→        scenario_id,\n   227→        StartupOverrides {\n   228→            geometry: overrides,\n   229→            ..StartupOverrides::default()\n   230→        },\n   231→    )\n   232→}\n   233→\n   234→pub fn seeded_state_with_full_overrides(\n   235→    seed: SimSeed,\n   236→    scenario_id: &str,\n   237→    overrides: StartupOverrides,\n   238→) -> Result<TankState, tank_data::PresetError> {\n   239→    validate_geometry_overrides(scenario_id, overrides.geometry)?;\n   240→    let mut scenario = load_named_scenario(scenario_id)?;\n   241→    scenario.tank_length_cm *= overrides.geometry.size_scale;\n   242→    scenario.tank_width_cm *= overrides.geometry.size_scale;\n   243→    scenario.tank_height_cm *= overrides.geometry.size_scale;\n   244→    scenario.fill_height_cm =\n   245→        (scenario.fill_height_cm * overrides.geometry.size_scale * overrides.geometry.fill_ratio)\n   246→            .min(scenario.tank_height_cm);\n   247→\n   248→    let mut state = materialize_scenario(seed, scenario)?;\n   249→    apply_startup_overrides(&mut state, overrides)?;\n   250→    Ok(state)\n   251→}\n   252→\n   253→pub fn startup_defaults_for_scenario(\n   254→    scenario_id: &str,\n   255→) -> Result<StartupOverrides, tank_data::PresetError> {\n   256→    let scenario = load_named_scenario(scenario_id)?;\n   257→    let substrate_preset =\n   258→        StartupSubstratePreset::from_ids(&scenario.substrate_ids).ok_or_else(|| {\n   259→            tank_data::PresetError::Validation {\n   260→                category: \"scenarios\",\n   261→                id: scenario_id.to_string(),\n   262→                message: format!(\n   263→                    \"startup template does not support substrate combination {:?}\",\n   264→                    scenario.substrate_ids\n   265→                ),\n   266→            }\n   267→        })?;\n   268→    let plant_selection =\n   269→        StartupPlantSelection::from_ids(&scenario.plant_ids).ok_or_else(|| {\n   270→            tank_data::PresetError::Validation {\n   271→                category: \"scenarios\",\n   272→                id: scenario_id.to_string(),\n   273→                message: format!(\n   274→                    \"startup template does not support plant combination {:?}\",\n   275→                    scenario.plant_ids\n   276→                ),\n   277→            }\n   278→        })?;\n   279→\n   280→    let (light_preset, heater_preset, aeration_enabled, initial_adult_shrimp_count) =\n   281→        match scenario_id {\n   282→            \"medium_planted\" => (\n   283→                StartupLightPreset::Hours10,\n   284→                StartupHeaterPreset::Celsius25,\n   285→                false,\n   286→                10,\n   287→            ),\n   288→            \"warm_room\" => (\n   289→                StartupLightPreset::Hours8,\n   290→                StartupHeaterPreset::Off,\n   291→                true,\n   292→                5,\n   293→            ),\n   294→            _ => (\n   295→                StartupLightPreset::Hours6,\n   296→                StartupHeaterPreset::Off,\n   297→                false,\n   298→                0,\n   299→            ),\n   300→        };\n   301→\n   302→    Ok(StartupOverrides {\n   303→        geometry: ScenarioGeometryOverrides::default(),\n   304→        source_water_profile_id: Some(scenario.source_water_id),\n   305→        substrate_preset: Some(substrate_preset),\n   306→        plant_selection: Some(plant_selection),\n   307→        filter_enabled: Some(true),\n   308→        light_preset: Some(light_preset),\n   309→        heater_preset: Some(heater_preset),\n   310→        aeration_enabled: Some(aeration_enabled),\n   311→        initial_adult_shrimp_count: Some(initial_adult_shrimp_count),\n   312→    })\n   313→}\n   314→\n   315→/// Converts a `tank_data::SourceWaterPreset` into a `tank_core::SourceWaterProfile`.\n   316→fn source_water_to_profile(preset: &tank_data::SourceWaterPreset) -> SourceWaterProfile {\n   317→    SourceWaterProfile {\n   318→        temperature_c: preset.temperature_c,\n   319→        ammonia_mg_n_per_l: preset.ammonia_mg_n_per_l,\n   320→        nitrite_mg_n_per_l: preset.nitrite_mg_n_per_l,\n   321→        nitrate_mg_n_per_l: preset.nitrate_mg_n_per_l,\n   322→        phosphate_mg_p_per_l: preset.phosphate_mg_p_per_l,\n   323→        dic_mg_c_per_l: preset.dic_mg_c_per_l,\n   324→        doc_mg_c_per_l: preset.doc_mg_c_per_l,\n   325→        don_mg_n_per_l: preset.don_mg_n_per_l,\n   326→        alkalinity_meq_per_l: preset.alkalinity_meq_per_l,\n   327→        calcium_mg_per_l: preset.calcium_mg_per_l,\n   328→        magnesium_mg_per_l: preset.magnesium_mg_per_l,\n   329→        sodium_mg_per_l: preset.sodium_mg_per_l,\n   330→        potassium_mg_per_l: preset.potassium_mg_per_l,\n   331→        bicarbonate_mg_per_l: preset.bicarbonate_mg_per_l,\n   332→        chloride_mg_per_l: preset.chloride_mg_per_l,\n   333→        sulfate_mg_per_l: preset.sulfate_mg_per_l,\n   334→    }\n   335→}\n   336→\n   337→/// Converts a `tank_data::ProcessParamsPreset` into `tank_core::ProcessParams`.\n   338→fn process_preset_to_params(preset: &tank_data::ProcessParamsPreset) -> ProcessParams {\n   339→    ProcessParams {\n   340→        mineralization_rate_per_day: preset.mineralization_rate_per_day,\n   341→        nitrification_vmax: preset.nitrification_vmax,\n   342→        reaeration_kla_base: preset.reaeration_kla_base,\n   343→        aeration_kla_boost: preset.aeration_kla_boost,\n   344→        background_bod_mg_o2_per_g_biomass_per_hour: preset\n   345→            .background_bod_mg_o2_per_g_biomass_per_hour,\n   346→        plant_photosynthesis_o2_mg_per_g_per_hour: preset.plant_photosynthesis_o2_mg_per_g_per_hour,\n   347→        respiration_dic_rate_mg_c_per_g_per_hour: preset.respiration_dic_rate_mg_c_per_g_per_hour,\n   348→        photosynthesis_dic_rate_mg_c_per_g_per_hour: preset\n   349→            .photosynthesis_dic_rate_mg_c_per_g_per_hour,\n   350→        k_surface_w_per_m2_k: preset.k_surface_w_per_m2_k,\n   351→        k_wall_w_per_m2_k: preset.k_wall_w_per_m2_k,\n   352→\n   353→        feed_leach_rate_per_hour: preset.feed_leach_rate_per_hour,\n   354→        fine_detritus_dissolution_rate_per_hour: preset.fine_detritus_dissolution_rate_per_hour,\n   355→        feed_n_to_c_ratio: preset.feed_n_to_c_ratio,\n   356→\n   357→        decomposer_vmax_per_hour: preset.decomposer_vmax_per_hour,\n   358→        decomposer_k_doc_mg: preset.decomposer_k_doc_mg,\n   359→        decomposer_growth_yield: preset.decomposer_growth_yield,\n   360→        decomposer_decay_rate_per_hour: preset.decomposer_decay_rate_per_hour,\n   361→\n   362→        aob_vmax_mg_n_per_g_per_hour: preset.aob_vmax_mg_n_per_g_per_hour,\n   363→        aob_k_tan_mg: preset.aob_k_tan_mg,\n   364→        aob_k_do_mg: preset.aob_k_do_mg,\n   365→        aob_growth_yield: preset.aob_growth_yield,\n   366→        aob_decay_rate_per_hour: preset.aob_decay_rate_per_hour,\n   367→\n   368→        nob_vmax_mg_n_per_g_per_hour: preset.nob_vmax_mg_n_per_g_per_hour,\n   369→        nob_k_nitrite_mg: preset.nob_k_nitrite_mg,\n   370→        nob_k_do_mg: preset.nob_k_do_mg,\n   371→        nob_growth_yield: preset.nob_growth_yield,\n   372→        nob_decay_rate_per_hour: preset.nob_decay_rate_per_hour,\n   373→\n   374→        comammox_vmax_fraction: preset.comammox_vmax_fraction,\n   375→        comammox_k_tan_mg: preset.comammox_k_tan_mg,\n   376→        comammox_k_do_mg: preset.comammox_k_do_mg,\n   377→        comammox_growth_yield: preset.comammox_growth_yield,\n   378→        comammox_decay_rate_per_hour: preset.comammox_decay_rate_per_hour,\n   379→\n   380→        o2_per_mg_n_nitrified: preset.o2_per_mg_n_nitrified,\n   381→        alkalinity_meq_per_mg_n_nitrified: preset.alkalinity_meq_per_mg_n_nitrified,\n   382→\n   383→        plant_max_growth_rate_fast_stem_per_day: preset.plant_max_growth_rate_fast_stem_per_day,\n   384→        plant_max_growth_rate_root_rosette_per_day: preset\n   385→            .plant_max_growth_rate_root_rosette_per_day,\n   386→        plant_respiration_fraction_per_day: preset.plant_respiration_fraction_per_day,\n   387→        plant_senescence_fraction_per_day: preset.plant_senescence_fraction_per_day,\n   388→        plant_health_recovery_per_day: preset.plant_health_recovery_per_day,\n   389→        plant_health_decline_per_day: preset.plant_health_decline_per_day,\n   390→        plant_half_saturation_n_mg_total: preset.plant_half_saturation_n_mg_total,\n   391→        plant_half_saturation_p_mg_total: preset.plant_half_saturation_p_mg_total,\n   392→        plant_half_saturation_c_mg_total: preset.plant_half_saturation_c_mg_total,\n   393→        plant_light_half_saturation: preset.plant_light_half_saturation,\n   394→        plant_temp_optimum_c: preset.plant_temp_optimum_c,\n   395→        plant_temp_sigma_c: preset.plant_temp_sigma_c,\n   396→        plant_crowding_biomass_g_per_m2: preset.plant_crowding_biomass_g_per_m2,\n   397→\n   398→        algae_max_growth_rate_per_day: preset.algae_max_growth_rate_per_day,\n   399→        periphyton_max_growth_rate_per_day: preset.periphyton_max_growth_rate_per_day,\n   400→        algae_respiration_fraction_per_day: preset.algae_respiration_fraction_per_day,\n   401→        algae_half_saturation_n_mg_total: preset.algae_half_saturation_n_mg_total,\n   402→        algae_half_saturation_p_mg_total: preset.algae_half_saturation_p_mg_total,\n   403→        algae_light_half_saturation: preset.algae_light_half_saturation,\n   404→        algae_temp_optimum_c: preset.algae_temp_optimum_c,\n   405→        algae_temp_sigma_c: preset.algae_temp_sigma_c,\n   406→        periphyton_capacity_g_per_m2: preset.periphyton_capacity_g_per_m2,\n   407→        algae_bloom_threshold_g_per_l: preset.algae_bloom_threshold_g_per_l,\n   408→        algae_nuisance_biomass_g_per_m2: preset.algae_nuisance_biomass_g_per_m2,\n   409→\n   410→        shrimp_base_mortality_per_day: preset.shrimp_base_mortality_per_day,\n   411→        shrimp_stress_mortality_scale: preset.shrimp_stress_mortality_scale,\n   412→        shrimp_juvenile_maturation_days: preset.shrimp_juvenile_maturation_days,\n   413→        shrimp_periphyton_grazing_g_per_shrimp_per_day: preset\n   414→            .shrimp_periphyton_grazing_g_per_shrimp_per_day,\n   415→        shrimp_condition_smoothing: preset.shrimp_condition_smoothing,\n   416→\n   417→        microfauna_mineralization_boost: preset.microfauna_mineralization_boost,\n   418→        microfauna_periphyton_consumption: preset.microfauna_periphyton_consumption,\n   419→        microfauna_population_smoothing: preset.microfauna_population_smoothing,\n   420→        microfauna_shrimp_pressure_threshold: preset.microfauna_shrimp_pressure_threshold,\n   421→    }\n   422→}\n   423→\n   424→/// Materializes a scenario preset into a fully resolved `TankState`.\n   425→///\n   426→/// - Geometry comes from the scenario.\n   427→/// - `environment.ambient_temp_c` comes from the scenario.\n   428→/// - Initial `WaterState` totals come from the source-water profile × fill volume.\n   429→/// - Substrate layers come from the scenario's substrate preset IDs.\n   430→/// - Plant guilds come from the scenario's plant preset IDs.\n   431→/// - Source-water catalog is populated with all known source-water presets.\n   432→/// - Process parameters come from the scenario's process params preset.\n   433→pub fn seeded_state(seed: SimSeed, scenario_id: &str) -> Result<TankState, tank_data::PresetError> {\n   434→    let scenario = load_named_scenario(scenario_id)?;\n   435→    materialize_scenario(seed, scenario)\n   436→}\n   437→\n   438→fn materialize_scenario(\n   439→    seed: SimSeed,\n   440→    scenario: ScenarioPreset,\n   441→) -> Result<TankState, tank_data::PresetError> {\n   442→    // Geometry\n   443→    let geometry = TankGeometry {\n   444→        length_cm: scenario.tank_length_cm,\n   445→        width_cm: scenario.tank_width_cm,\n   446→        height_cm: scenario.tank_height_cm,\n   447→        fill_height_cm: scenario.fill_height_cm,\n   448→        glass_thickness_mm: 5.0,\n   449→        open_top: true,\n   450→        lid_exchange_factor: 0.25,\n   451→    };\n   452→\n   453→    // Source water profile for initial fill\n   454→    let source_water_preset = tank_data::load_source_water(&scenario.source_water_id)?;\n   455→    let source_profile = source_water_to_profile(&source_water_preset);\n   456→\n   457→    // Initial water state from source-water profile\n   458→    let water = WaterState::from_source_profile(&source_profile, &geometry);\n   459→\n   460→    // Build source-water catalog with all known presets\n   461→    let mut source_water_catalog = BTreeMap::new();\n   462→    for sw_id in tank_data::source_water_ids() {\n   463→        let sw_preset = tank_data::load_source_water(sw_id)?;\n   464→        source_water_catalog.insert(sw_id.to_string(), source_water_to_profile(&sw_preset));\n   465→    }\n   466→\n   467→    // Process parameters\n   468→    let process_preset = tank_data::load_process_params(&scenario.process_params_id)?;\n   469→    let process_params = process_preset_to_params(&process_preset);\n   470→\n   471→    // Substrate layers\n   472→    let substrate_layers = build_substrate_layers(&geometry, &scenario.substrate_ids)?;\n   473→\n   474→    // Plant guilds\n   475→    let plant_guilds = build_plant_guilds(&scenario.plant_ids, &substrate_layers, true)?;\n   476→\n   477→    // Shrimp species parameters\n   478→    let shrimp_preset = tank_data::load_shrimp(&scenario.shrimp_profile_id)?;\n   479→    let shrimp_params = ShrimpRuntimeParams {\n   480→        optimal_temp_min_c: shrimp_preset.optimal_temp_min_c,\n   481→        optimal_temp_max_c: shrimp_preset.optimal_temp_max_c,\n   482→        gh_min_d: shrimp_preset.gh_min_d,\n   483→        gh_max_d: shrimp_preset.gh_max_d,\n   484→        base_spawn_rate: shrimp_preset.base_spawn_rate,\n   485→        egg_duration_days: shrimp_preset.egg_duration_days,\n   486→        hatch_success_base: shrimp_preset.hatch_success_base,\n   487→        juvenile_sensitivity: shrimp_preset.juvenile_sensitivity,\n   488→        high_temp_repro_penalty_start_c: shrimp_preset.high_temp_repro_penalty_start_c,\n   489→        high_temp_repro_penalty_full_c: shrimp_preset.high_temp_repro_penalty_full_c,\n   490→    };\n   491→\n   492→    // Environment\n   493→    let environment = tank_core::EnvironmentState {\n   494→        ambient_temp_c: scenario.ambient_temp_c,\n   495→        ..Default::default()\n   496→    };\n   497→\n   498→    let mut state = TankState::new(seed);\n   499→    state.meta = SimMeta {\n   500→        scenario_id: Some(scenario.id),\n   501→        notes: Some(scenario.name),\n   502→    };\n   503→    state.geometry = geometry;\n   504→    state.environment = environment;\n   505→    state.water = water;\n   506→    state.substrate_layers = substrate_layers;\n   507→    state.plant_guilds = plant_guilds;\n   508→    state.source_water_catalog = source_water_catalog;\n   509→    state.process_params = process_params;\n   510→    state.shrimp_params = shrimp_params;\n   511→\n   512→    Ok(state)\n   513→}\n   514→\n   515→fn apply_startup_overrides(\n   516→    state: &mut TankState,\n   517→    overrides: StartupOverrides,\n   518→) -> Result<(), tank_data::PresetError> {\n   519→    if let Some(source_water_id) = overrides.source_water_profile_id.as_deref() {\n   520→        let profile = if let Some(existing) = state.source_water_catalog.get(source_water_id) {\n   521→            existing.clone()\n   522→        } else {\n   523→            let preset = tank_data::load_source_water(source_water_id)?;\n   524→            let profile = source_water_to_profile(&preset);\n   525→            state\n   526→                .source_water_catalog\n   527→                .insert(source_water_id.to_string(), profile.clone());\n   528→            profile\n   529→        };\n   530→        state.water = WaterState::from_source_profile(&profile, &state.geometry);\n   531→    }\n   532→\n   533→    if let Some(substrate_preset) = overrides.substrate_preset {\n   534→        let substrate_ids = substrate_preset\n   535→            .preset_ids()\n   536→            .iter()\n   537→            .map(|id| (*id).to_string())\n   538→            .collect::<Vec<_>>();\n   539→        state.substrate_layers = build_substrate_layers(&state.geometry, &substrate_ids)?;\n   540→    }\n   541→\n   542→    if overrides.substrate_preset.is_some() || overrides.plant_selection.is_some() {\n   543→        let plant_ids = if let Some(plant_selection) = overrides.plant_selection {\n   544→            plant_selection\n   545→                .preset_ids()\n   546→                .iter()\n   547→                .map(|id| (*id).to_string())\n   548→                .collect::<Vec<_>>()\n   549→        } else {\n   550→            state\n   551→                .plant_guilds\n   552→                .iter()\n   553→                .map(|plant| match plant.guild {\n   554→                    PlantGuild::FastStem => \"fast_stem\".to_string(),\n   555→                    PlantGuild::RootFeedingRosette => \"root_rosette\".to_string(),\n   556→                })\n   557→                .collect::<Vec<_>>()\n   558→        };\n   559→        state.plant_guilds = build_plant_guilds(&plant_ids, &state.substrate_layers, false)?;\n   560→    }\n   561→\n   562→    if let Some(filter_enabled) = overrides.filter_enabled {\n   563→        state.hardware.filter.enabled = filter_enabled;\n   564→        if filter_enabled {\n   565→            if state.hardware.filter.flow_lph <= 0.0 {\n   566→                state.hardware.filter.flow_lph = 200.0;\n   567→            }\n   568→        } else {\n   569→            state.hardware.filter.flow_lph = 0.0;\n   570→        }\n   571→    }\n   572→\n   573→    if let Some(light_preset) = overrides.light_preset {\n   574→        state.hardware.light.enabled = true;\n   575→        state.hardware.light.photoperiod_hours = light_preset.hours();\n   576→    }\n   577→\n   578→    if let Some(heater_preset) = overrides.heater_preset {\n   579→        match heater_preset.setpoint_c() {\n   580→            Some(setpoint_c) => {\n   581→                state.hardware.heater.enabled = true;\n   582→                state.hardware.heater.setpoint_c = setpoint_c;\n   583→            }\n   584→            None => {\n   585→                state.hardware.heater.enabled = false;\n   586→                state.hardware.heater.setpoint_c = 24.0;\n   587→            }\n   588→        }\n   589→        state.hardware.heater.last_output_w = 0.0;\n   590→    }\n   591→\n   592→    if let Some(aeration_enabled) = overrides.aeration_enabled {\n   593→        state.hardware.aeration.enabled = aeration_enabled;\n   594→        state.hardware.aeration.intensity = if aeration_enabled { 0.35 } else { 0.0 };\n   595→    }\n   596→\n   597→    if let Some(initial_adult_shrimp_count) = overrides.initial_adult_shrimp_count {\n   598→        state.animal = AnimalState::with_adults(initial_adult_shrimp_count);\n   599→    }\n   600→\n   601→    Ok(())\n   602→}\n   603→\n   604→fn build_substrate_layers(\n   605→    geometry: &TankGeometry,\n   606→    substrate_ids: &[String],\n   607→) -> Result<Vec<SubstrateLayerState>, tank_data::PresetError> {\n   608→    let mut substrate_layers = Vec::new();\n   609→    for sub_id in substrate_ids {\n   610→        let sub_preset = tank_data::load_substrate(sub_id)?;\n   611→        let footprint = geometry.footprint_area_cm2();\n   612→        substrate_layers.push(SubstrateLayerState {\n   613→            kind: match sub_preset.id.as_str() {\n   614→                \"inert_sand\" => tank_core::SubstrateKind::InertSand,\n   615→                \"inert_gravel\" => tank_core::SubstrateKind::InertGravel,\n   616→                \"active_planted\" => tank_core::SubstrateKind::ActivePlanted,\n   617→                \"coarse_porous\" => tank_core::SubstrateKind::CoarsePorous,\n   618→                other => {\n   619→                    return Err(tank_data::PresetError::Validation {\n   620→                        category: \"substrate\",\n   621→                        id: other.to_string(),\n   622→                        message: format!(\"unsupported substrate kind: `{other}`\"),\n   623→                    });\n   624→                }\n   625→            },\n   626→            depth_cm: sub_preset.depth_cm,\n   627→            nutrient_store_mg_n_total: sub_preset.nutrient_charge_mg_n_total,\n   628→            nutrient_store_mg_p_total: sub_preset.nutrient_charge_mg_p_total,\n   629→            cation_exchange_capacity_index: sub_preset.cation_exchange_capacity_index,\n   630→            detritus_trapping_index: sub_preset.detritus_trapping_index,\n   631→            colonizable_area_cm2: footprint * sub_preset.colonizable_area_factor,\n   632→            low_oxygen_tendency_index: sub_preset.low_oxygen_tendency_index,\n   633→            grazing_surface_index: sub_preset.grazing_surface_index,\n   634→        });\n   635→    }\n   636→    if substrate_layers.is_empty() {\n   637→        substrate_layers.push(SubstrateLayerState::default());\n   638→    }\n   639→    Ok(substrate_layers)\n   640→}\n   641→\n   642→fn build_plant_guilds(\n   643→    plant_ids: &[String],\n   644→    substrate_layers: &[SubstrateLayerState],\n   645→    include_default_when_empty: bool,\n   646→) -> Result<Vec<PlantGuildState>, tank_data::PresetError> {\n   647→    let mut plant_guilds = Vec::new();\n   648→    for plant_id in plant_ids {\n   649→        let plant_preset = tank_data::load_plant(plant_id)?;\n   650→        let guild = match plant_preset.guild.as_str() {\n   651→            \"FastStem\" => PlantGuild::FastStem,\n   652→            \"RootFeedingRosette\" => PlantGuild::RootFeedingRosette,\n   653→            other => {\n   654→                return Err(tank_data::PresetError::Validation {\n   655→                    category: \"plants\",\n   656→                    id: plant_id.clone(),\n   657→                    message: format!(\"unsupported plant guild: `{other}`\"),\n   658→                });\n   659→            }\n   660→        };\n   661→        plant_guilds.push(PlantGuildState {\n   662→            guild,\n   663→            biomass_g: 5.0,\n   664→            health_index: 0.8,\n   665→            crowding_index: 0.1,\n   666→            habitat_index: if guild == PlantGuild::RootFeedingRosette {\n   667→                root_rosette_habitat_index(substrate_layers)\n   668→            } else {\n   669→                0.8\n   670→            },\n   671→        });\n   672→    }\n   673→    if plant_guilds.is_empty() && include_default_when_empty {\n   674→        plant_guilds.push(PlantGuildState::default());\n   675→    }\n   676→    Ok(plant_guilds)\n   677→}\n   678→\n   679→fn root_rosette_habitat_index(substrate_layers: &[SubstrateLayerState]) -> f64 {\n   680→    substrate_layers\n   681→        .iter()\n   682→        .map(|layer| layer.cation_exchange_capacity_index)\n   683→        .fold(0.0_f64, f64::max)\n   684→        .max(0.3)\n   685→}\n   686→\n   687→fn validate_geometry_overrides(\n   688→    scenario_id: &str,\n   689→    overrides: ScenarioGeometryOverrides,\n   690→) -> Result<(), tank_data::PresetError> {\n   691→    if !overrides.size_scale.is_finite() || overrides.size_scale <= 0.0 {\n   692→        return Err(tank_data::PresetError::Validation {\n   693→            category: \"scenarios\",\n   694→            id: scenario_id.to_string(),\n   695→            message: format!(\n   696→                \"size_scale must be finite and > 0.0, got {}\",\n   697→                overrides.size_scale\n   698→            ),\n   699→        });\n   700→    }\n   701→\n   702→    if !overrides.fill_ratio.is_finite() || !(0.1..=1.0).contains(&overrides.fill_ratio) {\n   703→        return Err(tank_data::PresetError::Validation {\n   704→            category: \"scenarios\",\n   705→            id: scenario_id.to_string(),\n   706→            message: format!(\n   707→                \"fill_ratio must be finite and in 0.1..=1.0, got {}\",\n   708→                overrides.fill_ratio\n   709→            ),\n   710→        });\n   711→    }\n   712→\n   713→    Ok(())\n   714→}\n   715→\n   716→/// Creates a deterministic cycling fixture pair: one seeded, one unseeded.\n   717→/// Both tanks are otherwise identical (~20L nano tank with moderate source water,\n   718→/// fed daily, with aeration enabled).\n   719→/// The seeded tank starts with elevated nitrifier biomass and higher maturity;\n   720→/// the unseeded tank starts with minimal microbes and low maturity.\n   721→pub fn cycling_fixture_pair(seed: SimSeed) -> (TankState, TankState) {\n   722→    let base = cycling_base_state(seed);\n   723→\n   724→    let mut seeded = base.clone();\n   725→    seeded.meta.scenario_id = Some(\"cycling_seeded\".to_string());\n   726→    // Seeded: same decomposer biomass but much higher nitrifier biomass + maturity\n   727→    seeded.microbe = MicrobeState {\n   728→        decomposer_biomass_g: 0.1,\n   729→        ammonia_oxidizer_biomass_g: 0.20,\n   730→        nitrite_oxidizer_biomass_g: 0.15,\n   731→        comammox_biomass_g: 0.05,\n   732→        maturity_index: 0.6,\n   733→    };\n   734→    seeded.filter_state = FilterState {\n   735→        biofilter_maturity_index: 0.6,\n   736→        clogging_index: 0.0,\n   737→        seeded_biomass_index: 0.8,\n   738→    };\n   739→\n   740→    let mut unseeded = base;\n   741→    unseeded.meta.scenario_id = Some(\"cycling_unseeded\".to_string());\n   742→    // Unseeded: same decomposer biomass but minimal nitrifier biomass + maturity\n   743→    unseeded.microbe = MicrobeState {\n   744→        decomposer_biomass_g: 0.1,\n   745→        ammonia_oxidizer_biomass_g: 0.005,\n   746→        nitrite_oxidizer_biomass_g: 0.005,\n   747→        comammox_biomass_g: 0.001,\n   748→        maturity_index: 0.05,\n   749→    };\n   750→    unseeded.filter_state = FilterState {\n   751→        biofilter_maturity_index: 0.05,\n   752→        clogging_index: 0.0,\n   753→        seeded_biomass_index: 0.0,\n   754→    };\n   755→\n   756→    (seeded, unseeded)\n   757→}\n   758→\n   759→/// Base state shared by both cycling fixtures.\n   760→fn cycling_base_state(seed: SimSeed) -> TankState {\n   761→    let geometry = TankGeometry {\n   762→        length_cm: 30.0,\n   763→        width_cm: 25.0,\n   764→        height_cm: 30.0,\n   765→        fill_height_cm: 26.0,\n   766→        glass_thickness_mm: 5.0,\n   767→        open_top: true,\n   768→        lid_exchange_factor: 0.25,\n   769→    };\n   770→\n   771→    let water = WaterState::default_for_geometry(&geometry);\n   772→\n   773→    let mut state = TankState::new(seed);\n   774→    state.geometry = geometry;\n   775→    state.water = water;\n   776→    state.water.temperature_c = 25.0;\n   777→    state.environment.ambient_temp_c = 25.0;\n   778→\n   779→    // Enable moderate aeration\n   780→    state.hardware.aeration.enabled = true;\n   781→    state.hardware.aeration.intensity = 0.3;\n   782→\n   783→    // Single fast-stem plant\n   784→    state.plant_guilds = vec![PlantGuildState {\n   785→        guild: PlantGuild::FastStem,\n   786→        biomass_g: 3.0,\n   787→        health_index: 0.8,\n   788→        crowding_index: 0.1,\n   789→        habitat_index: 0.8,\n   790→    }];\n   791→\n   792→    state.process_params = ProcessParams::default();\n   793→\n   794→    state\n   795→}\n   796→"}]},"parent_tool_use_id":"toolu_01FotGQQbawNugfBPrExKQJ6","session_id":"95326878-6ba9-4202-b437-de2ab6b6afc1","uuid":"a2df652a-fbef-4050-b5ac-97e293f24898"}
