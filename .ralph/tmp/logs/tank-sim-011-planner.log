{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AXLxAjZxhDsfHsRT6mvvzX","type":"tool_result","content":"     1→use crate::types::{SimError, TankState};\n     2→\n     3→pub fn enforce_invariants(state: &mut TankState) -> Result<(), SimError> {\n     4→    if state.water.dissolved_oxygen_mg_total.is_finite() {\n     5→        state.water.dissolved_oxygen_mg_total = state.water.dissolved_oxygen_mg_total.max(0.0);\n     6→    }\n     7→    check_non_negative(\n     8→        \"ammonia_total_mg_n_total\",\n     9→        state.water.ammonia_total_mg_n_total,\n    10→    )?;\n    11→    check_non_negative(\"nitrite_mg_n_total\", state.water.nitrite_mg_n_total)?;\n    12→    check_non_negative(\"nitrate_mg_n_total\", state.water.nitrate_mg_n_total)?;\n    13→    check_non_negative(\"phosphate_mg_p_total\", state.water.phosphate_mg_p_total)?;\n    14→    check_non_negative(\n    15→        \"dissolved_oxygen_mg_total\",\n    16→        state.water.dissolved_oxygen_mg_total,\n    17→    )?;\n    18→    check_non_negative(\n    19→        \"dissolved_inorganic_carbon_mg_c_total\",\n    20→        state.water.dissolved_inorganic_carbon_mg_c_total,\n    21→    )?;\n    22→    check_non_negative(\n    23→        \"dissolved_organic_carbon_mg_c_total\",\n    24→        state.water.dissolved_organic_carbon_mg_c_total,\n    25→    )?;\n    26→    check_non_negative(\n    27→        \"dissolved_organic_nitrogen_mg_n_total\",\n    28→        state.water.dissolved_organic_nitrogen_mg_n_total,\n    29→    )?;\n    30→    check_non_negative(\"alkalinity_meq_total\", state.water.alkalinity_meq_total)?;\n    31→    check_non_negative(\"calcium_mg_total\", state.water.calcium_mg_total)?;\n    32→    check_non_negative(\"magnesium_mg_total\", state.water.magnesium_mg_total)?;\n    33→    check_non_negative(\"sodium_mg_total\", state.water.sodium_mg_total)?;\n    34→    check_non_negative(\"potassium_mg_total\", state.water.potassium_mg_total)?;\n    35→    check_non_negative(\"bicarbonate_mg_total\", state.water.bicarbonate_mg_total)?;\n    36→    check_non_negative(\"chloride_mg_total\", state.water.chloride_mg_total)?;\n    37→    check_non_negative(\"sulfate_mg_total\", state.water.sulfate_mg_total)?;\n    38→    check_non_negative(\n    39→        \"particulate_organics_g_total\",\n    40→        state.detritus.particulate_organics_g_total,\n    41→    )?;\n    42→    check_non_negative(\n    43→        \"fine_detritus_g_total\",\n    44→        state.detritus.fine_detritus_g_total,\n    45→    )?;\n    46→    check_non_negative(\n    47→        \"dissolved_feed_residue_g_total\",\n    48→        state.detritus.dissolved_feed_residue_g_total,\n    49→    )?;\n    50→    check_non_negative(\"decomposer_biomass_g\", state.microbe.decomposer_biomass_g)?;\n    51→    check_non_negative(\n    52→        \"ammonia_oxidizer_biomass_g\",\n    53→        state.microbe.ammonia_oxidizer_biomass_g,\n    54→    )?;\n    55→    check_non_negative(\n    56→        \"nitrite_oxidizer_biomass_g\",\n    57→        state.microbe.nitrite_oxidizer_biomass_g,\n    58→    )?;\n    59→    check_non_negative(\"comammox_biomass_g\", state.microbe.comammox_biomass_g)?;\n    60→    for plant in &state.plant_guilds {\n    61→        check_non_negative(\"plant.biomass_g\", plant.biomass_g)?;\n    62→    }\n    63→    check_non_negative(\"algae.suspended_biomass_g\", state.algae.suspended_biomass_g)?;\n    64→    check_non_negative(\n    65→        \"algae.periphyton_biomass_g\",\n    66→        state.algae.periphyton_biomass_g,\n    67→    )?;\n    68→    for layer in &state.substrate_layers {\n    69→        check_non_negative(\"substrate.depth_cm\", layer.depth_cm)?;\n    70→        check_non_negative(\n    71→            \"substrate.nutrient_store_mg_n_total\",\n    72→            layer.nutrient_store_mg_n_total,\n    73→        )?;\n    74→        check_non_negative(\n    75→            \"substrate.nutrient_store_mg_p_total\",\n    76→            layer.nutrient_store_mg_p_total,\n    77→        )?;\n    78→        check_non_negative(\"substrate.colonizable_area_cm2\", layer.colonizable_area_cm2)?;\n    79→    }\n    80→    check_non_negative(\"water.temperature_c\", state.water.temperature_c)?;\n    81→    if state.water.temperature_c <= 0.0 {\n    82→        return Err(SimError::TemperatureTooLow {\n    83→            field: \"water.temperature_c\",\n    84→            value: state.water.temperature_c,\n    85→        });\n    86→    }\n    87→    if !state.water.ph.is_finite() {\n    88→        return Err(SimError::InvariantViolation {\n    89→            field: \"water.ph\",\n    90→            value: state.water.ph,\n    91→        });\n    92→    }\n    93→    state.water.ph = state.water.ph.clamp(5.5, 8.5);\n    94→\n    95→    state.geometry.lid_exchange_factor = state.geometry.lid_exchange_factor.clamp(0.0, 1.0);\n    96→    state.hardware.light.intensity_index = state.hardware.light.intensity_index.clamp(0.0, 1.0);\n    97→    state.hardware.filter.cleanliness_index =\n    98→        state.hardware.filter.cleanliness_index.clamp(0.0, 1.0);\n    99→    state.hardware.aeration.intensity = state.hardware.aeration.intensity.clamp(0.0, 1.0);\n   100→    state.filter_state.biofilter_maturity_index =\n   101→        state.filter_state.biofilter_maturity_index.clamp(0.0, 1.0);\n   102→    state.filter_state.clogging_index = state.filter_state.clogging_index.clamp(0.0, 1.0);\n   103→    state.filter_state.seeded_biomass_index =\n   104→        state.filter_state.seeded_biomass_index.clamp(0.0, 1.0);\n   105→    state.algae.nuisance_index = state.algae.nuisance_index.clamp(0.0, 1.0);\n   106→    state.microbe.maturity_index = state.microbe.maturity_index.clamp(0.0, 1.0);\n   107→    state.microfauna.population_index = state.microfauna.population_index.clamp(0.0, 1.0);\n   108→    state.microfauna.grazing_pressure_index =\n   109→        state.microfauna.grazing_pressure_index.clamp(0.0, 1.0);\n   110→    state.animal.condition_index = state.animal.condition_index.clamp(0.0, 1.0);\n   111→    state.animal.molt_stress_index = state.animal.molt_stress_index.clamp(0.0, 1.0);\n   112→    state.animal.reproductive_readiness_index =\n   113→        state.animal.reproductive_readiness_index.clamp(0.0, 1.0);\n   114→    // Shrimp population invariants: berried <= adults, no negative egg progress\n   115→    state.animal.clamp_berried_to_adults();\n   116→    state.animal.egg_progress_days = state.animal.egg_progress_days.max(0.0);\n   117→    // Remove any empty cohorts\n   118→    state.animal.egg_cohorts.retain(|c| c.count > 0);\n   119→    state.stability_tracker.instability_index =\n   120→        state.stability_tracker.instability_index.clamp(0.0, 1.0);\n   121→\n   122→    for plant in &mut state.plant_guilds {\n   123→        plant.health_index = plant.health_index.clamp(0.0, 1.0);\n   124→        plant.crowding_index = plant.crowding_index.clamp(0.0, 1.0);\n   125→        plant.habitat_index = plant.habitat_index.clamp(0.0, 1.0);\n   126→    }\n   127→    for layer in &mut state.substrate_layers {\n   128→        layer.cation_exchange_capacity_index = layer.cation_exchange_capacity_index.clamp(0.0, 1.0);\n   129→        layer.detritus_trapping_index = layer.detritus_trapping_index.clamp(0.0, 1.0);\n   130→        layer.low_oxygen_tendency_index = layer.low_oxygen_tendency_index.clamp(0.0, 1.0);\n   131→        layer.grazing_surface_index = layer.grazing_surface_index.clamp(0.0, 1.0);\n   132→    }\n   133→\n   134→    if state.event_log.len() > 200 {\n   135→        let keep_from = state.event_log.len() - 200;\n   136→        state.event_log.drain(0..keep_from);\n   137→    }\n   138→\n   139→    Ok(())\n   140→}\n   141→\n   142→fn check_non_negative(field: &'static str, value: f64) -> Result<(), SimError> {\n   143→    if !value.is_finite() || value < 0.0 {\n   144→        Err(SimError::InvariantViolation { field, value })\n   145→    } else {\n   146→        Ok(())