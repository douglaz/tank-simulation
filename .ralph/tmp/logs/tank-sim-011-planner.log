ntGuild::RootFeedingRosette => 0.9,\n   223→        }\n   224→    }\n   225→}\n   226→\n   227→impl AnimalState {\n   228→    pub fn with_adults(adults_count: u32) -> Self {\n   229→        Self {\n   230→            adults_count,\n   231→            ..Self::default()\n   232→        }\n   233→    }\n   234→\n   235→    /// Ensures `berried_females_count <= adults_count` by trimming\n   236→    /// excess from the newest egg cohorts first.\n   237→    pub fn clamp_berried_to_adults(&mut self) {\n   238→        if self.berried_females_count > self.adults_count {\n   239→            let excess = self.berried_females_count - self.adults_count;\n   240→            self.berried_females_count = self.adults_count;\n   241→            trim_egg_cohorts(&mut self.egg_cohorts, excess);\n   242→        }\n   243→    }\n   244→\n   245→    /// Derives `egg_progress_days` from the most-advanced cohort for display.\n   246→    pub fn sync_egg_progress_from_cohorts(&mut self) {\n   247→        self.egg_progress_days = self\n   248→            .egg_cohorts\n   249→            .iter()\n   250→            .map(|c| c.progress_days)\n   251→            .fold(0.0_f64, f64::max);\n   252→    }\n   253→}\n   254→\n   255→/// Trims `to_remove` berried females from cohorts, starting from the newest (last).\n   256→fn trim_egg_cohorts(cohorts: &mut Vec<EggCohort>, mut to_remove: u32) {\n   257→    while to_remove > 0 && !cohorts.is_empty() {\n   258→        let last = cohorts.last_mut().unwrap();\n   259→        if last.count <= to_remove {\n   260→            to_remove -= last.count;\n   261→            cohorts.pop();\n   262→        } else {\n   263→            last.count -= to_remove;\n   264→            to_remove = 0;\n   265→        }\n   266→    }\n   267→}\n   268→\n   269→pub fn total_colonizable_area_cm2(\n   270→    substrate_layers: &[SubstrateLayerState],\n   271→    wall_area_cm2: f64,\n   272→) -> f64 {\n   273→    wall_area_cm2\n   274→        + substrate_layers\n   275→       