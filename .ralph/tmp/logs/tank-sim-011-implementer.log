p(0.0, 1.0);\ncrates/tank_core/src/systems/shrimp.rs:276:    let f_temp = temp_repro_factor(temp, params);\ncrates/tank_core/src/systems/shrimp.rs:286:    let p_spawn = params.base_spawn_rate * f_temp * f_condition * f_stability * f_mineral;\ncrates/tank_core/src/systems/shrimp.rs:334:    let f_temp = temp_repro_factor(temp, params);\ncrates/tank_core/src/systems/shrimp.rs:345:    let egg_duration = params.egg_duration_days as f64;\ncrates/tank_core/src/systems/shrimp.rs:375:        state.animal.juveniles_count += total_successful * juveniles_per_clutch;\ncrates/tank_core/src/systems/shrimp.rs:385:        // Failure-mode invariant: on hatch failure, juveniles_count does NOT increase\ncrates/tank_core/src/systems/shrimp.rs:417:    if state.animal.juveniles_count == 0 {\ncrates/tank_core/src/systems/shrimp.rs:426:    let maturing = (state.animal.juveniles_count as f64 * maturation_rate).floor() as u32;\ncrates/tank_core/src/systems/shrimp.rs:427:    let maturing = maturing.min(state.animal.juveniles_count);\ncrates/tank_core/src/systems/shrimp.rs:429:    state.animal.juveniles_count -= maturing;\ncrates/tank_core/src/systems/shrimp.rs:457:    for _ in 0..state.animal.juveniles_count {\ncrates/tank_core/src/systems/shrimp.rs:464:    state.animal.juveniles_count = state.animal.juveniles_count.saturating_sub(juv_deaths);\ncrates/tank_core/src/systems/shrimp.rs:518:fn temp_repro_factor(temp: f64, params: &ShrimpRuntimeParams) -> f64 {\ncrates/tank_core/tests/thermal_reproduction_penalty.rs:57:    state.animal.reproductive_readiness_index = 0.5;\ncrates/tank_core/tests/thermal_reproduction_penalty.rs:67:    state.shrimp_params.base_spawn_rate = 0.03;\ncrates/tank_core/tests/thermal_reproduction_penalty.rs:116:        warm_snap.juveniles_count < cool_snap.juveniles_count,\ncrates/tank_core/tests/thermal_reproduction_penalty.rs:119:        cool_snap.juveniles_count,\ncrates/tank_core/tests/thermal_reproduction_penalty.rs:120:        warm_snap.juveniles_count\n","exit_code":0