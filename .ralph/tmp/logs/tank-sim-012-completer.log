> \"Heater setpoint\",\n    53→            Self::ChangeAmbientTemperature => \"Ambient temp\",\n    54→            Self::ChangeAeration => \"Aeration\",\n    55→        }\n    56→    }\n    57→\n    58→    fn field_count(self) -> usize {\n    59→        match self {\n    60→            Self::WaterChangePercent | Self::ChangeAeration => 2,\n    61→            _ => 1,\n    62→        }\n    63→    }\n    64→}\n    65→\n    66→#[derive(Debug, Clone, PartialEq)]\n    67→pub struct ActionFormState {\n    68→    selected_action: usize,\n    69→    selected_field: usize,\n    70→    replace_next_numeric: bool,\n    71→    feed_grams: String,\n    72→    water_change_percent: String,\n    73→    water_change_source_index: usize,\n    74→    trim_fraction: String,\n    75→    siphon_fraction: String,\n    76→    clean_filter_intensity: String,\n    77→    add_shrimp_count: String,\n    78→    remove_shrimp_count: String,\n    79→    photoperiod_hours: String,\n    80→    light_intensity: String,\n    81→    heater_setpoint_c: String,\n    82→    ambient_temp_c: String,\n    83→    aeration_enabled: bool,\n    84→    aeration_intensity: String,\n    85→}\n    86→\n    87→#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n    88→enum FieldKind {\n    89→    Numeric { integer_only: bool },\n    90→    Choice,\n    91→    Toggle,\n    92→}\n    93→\n    94→#[derive(Debug, Clone, PartialEq, Eq)]\n    95→pub struct ActionFieldView {\n    96→    pub label: String,\n    97→    pub value: String,\n    98→    pub hint: &'static str,\n    99→}\n   100→\n   101→impl Default for ActionFormState {\n   102→    fn default() -> Self {\n   103→        Self {\n   104→            selected_action: 0,\n   105→            selected_field: 0,\n   106→            replace_next_numeric: true,\n   107→            feed_grams: \"0.20\".to_string(),\n   108→            water_change_percent: \"25.0\".to_string(),\n   109→            water_change_source_index: 1,\n   110→            trim_fraction: \"0.25\".to_string(),\n   111→            siphon_fraction: \"0.30\".to_string(),\n   112→            clean_filter_intensity: \"0.50\".to_string(),\n   113→            add_shrimp_count: \"5\".to_string(),\n   114→            remove_shrimp_count: \"2\".to_string(),\n   115→            photoperiod_hours: \"8.0\".to_string(),\n   116→            light_intensity: \"0.70\".to_string(),\n   117→            heater_setpoint_c: \"24.0\".to_string(),\n   118→            ambient_temp_c: \"24.0\".to_string(),\n   119→            aeration_enabled: true,\n   120→            aeration_intensity: \"0.40\".to_string(),\n   121→        }\n   122→    }\n   123→}\n   124→\n   125→impl ActionFormState {\n   126→    pub fn selected_action(&self) -> ActionKind {\n   127→        ActionKind::ALL[self.selected_action]\n   128→    }\n   129→\n   130→    pub fn selected_action_index(&self) -> usize {\n   131→        self.selected_action\n   132→    }\n   133→\n   134→    pub fn selected_field_index(&self) -> usize {\n   135→        self.selected_field\n   136→    }\n   137→\n   138→    pub fn fields(&self) -> Vec<ActionFieldView> {\n   139→        match self.selected_action() {\n   140→            ActionKind::Feed => vec![ActionFieldView {\n   141→                label: \"grams\".to_string(),\n   142→                value: self.feed_grams.clone(),\n   143→                hint: \"Type a non-negative amount\",\n   144→            }],\n   145→            ActionKind::WaterChangePercent => vec![\n   146→                ActionFieldView {\n   147→                    label: \"percent\".to_string(),\n   148→                    value: self.water_change_percent.clone(),\n   149→                    hint: \"0.0 to 100.0\",\n   150→                },\n   151→                ActionFieldView {\n   152→                    label: \"source\".to_string(),\n   153→                    value: tank_data::source_water_ids()[self.water_change_source_index]\n   154→                        .to_string(),\n   155→                    hint: 