ate.animal.condition_index = state.animal.condition_index.clamp(0.0, 1.0);\n   111→    state.animal.molt_stress_index = state.animal.molt_stress_index.clamp(0.0, 1.0);\n   112→    state.animal.reproductive_readiness_index =\n   113→        state.animal.reproductive_readiness_index.clamp(0.0, 1.0);\n   114→    state.animal.daily_food_consumed_g = state.animal.daily_food_consumed_g.max(0.0);\n   115→    // Shrimp population invariants: berried <= adults, no negative egg progress\n   116→    state.animal.clamp_berried_to_adults();\n   117→    state.animal.egg_progress_days = state.animal.egg_progress_days.max(0.0);\n   118→    // Remove any empty cohorts\n   119→    state.animal.egg_cohorts.retain(|c| c.count > 0);\n   120→    state.stability_tracker.instability_index =\n   121→        state.stability_tracker.instability_index.clamp(0.0, 1.0);\n   122→\n   123→    for plant in &mut state.plant_guilds {\n   124→        plant.health_index = plant.health_index.clamp(0.0, 1.0);\n   125→        plant.crowding_index = plant.crowding_index.clamp(0.0, 1.0);\n   126→        plant.habitat_index = plant.habitat_index.clamp(0.0, 1.0);\n   127→    }\n   128→    for layer in &mut state.substrate_layers {\n   129→        layer.cation_exchange_capacity_index = layer.cation_exchange_capacity_index.clamp(0.0, 1.0);\n   130→        layer.detritus_trapping_index = layer.detritus_trapping_index.clamp(0.0, 1.0);\n   131→        layer.low_oxygen_tendency_index = layer.low_oxygen_tendency_index.clamp(0.0, 1.0);\n   132→        layer.grazing_surface_index = layer.grazing_surface_index.clamp(0.0, 1.0);\n   133→    }\n   134→\n   135→    if state.event_log.len() > 200 {\n   136→        let keep_from = state.event_log.len() - 200;\n   137→        state.event_log.drain(0..keep_from);\n   138→    }\n   139→\n   140→    Ok(())\n   141→}\n   142→\n   143→fn check_non_negative(field: &'static str, value: f64) -> Result<(), SimError> {\n   144→    if !value.is_finite() || value < 0.0 {\n   145→        