{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BLR7yekDqHEBv2LDsMB7Nh","type":"tool_result","content":"     1→use crate::types::{SimError, SourceWaterProfile, TankState};\n     2→\n     3→/// Validates that all water change actions in the queue reference known and valid source profiles.\n     4→/// Returns the first error found, or Ok(()) if all are valid.\n     5→/// Checks both catalog membership and runtime validity (finite, non-negative chemistry).\n     6→pub fn validate_water_changes(\n     7→    state: &TankState,\n     8→    actions: &[crate::types::PlayerAction],\n     9→) -> Result<(), SimError> {\n    10→    for action in actions {\n    11→        if let crate::types::PlayerAction::WaterChangePercent {\n    12→            source_profile_id, ..\n    13→        } = action\n    14→        {\n    15→            match state.source_water_catalog.get(source_profile_id) {\n    16→                None => {\n    17→                    return Err(SimError::UnknownSourceProfile {\n    18→                        id: source_profile_id.clone(),\n    19→                    });\n    20→                }\n    21→                Some(profile) => {\n    22→                    profile.validate(source_profile_id)?;\n    23→                }\n    24→            }\n    25→        }\n    26→    }\n    27→    Ok(())\n    28→}\n    29→\n    30→/// Applies a water change: removes `percent/100` of each dissolved total,\n    31→/// then adds replacement mass from the source-water profile using exchanged liters.\n    32→/// Also mixes water temperature proportionally by exchanged volume.\n    33→///\n    34→/// A 0% water change is a no-op.\n    35→pub fn apply_water_change(state: &mut TankState, percent: f64, source: &SourceWaterProfile) {\n    36→    if percent <= 0.0 {\n    37→        return;\n    38→    }\n    39→\n    40→    let volume_l = state.geometry.water_volume_l();\n    41→    let fraction = percent / 100.0;\n    42→    let retention = 1.0 - fraction;\n    43→    let exchanged_l = volume_l * fraction;\n    44→\n    45→    // Remove fraction of each dissolved total\n    46→    state.water.ammonia_total_mg_n_total *= retention;\n    47→    state.water.nitrite_mg_n_total *= retention;\n    48→    state.water.nitrate_mg_n_total *= retention;\n    49→    state.water.phosphate_mg_p_total *= retention;\n    50→    state.water.dissolved_inorganic_carbon_mg_c_total *= retention;\n    51→    state.water.dissolved_organic_carbon_mg_c_total *= retention;\n    52→    state.water.dissolved_organic_nitrogen_mg_n_total *= retention;\n    53→    state.water.alkalinity_meq_total *= retention;\n    54→    state.water.calcium_mg_total *= retention;\n    55→    state.water.magnesium_mg_total *= retention;\n    56→    state.water.sodium_mg_total *= retention;\n    57→    state.water.potassium_mg_total *= retention;\n    58→    state.water.bicarbonate_mg_total *= retention;\n    59→    state.water.chloride_mg_total *= retention;\n    60→    state.water.sulfate_mg_total *= retention;\n    61→\n    62→    // Add replacement mass from source water\n    63→    state.water.ammonia_total_mg_n_total += source.ammonia_mg_n_per_l * exchanged_l;\n    64→    state.water.nitrite_mg_n_total += source.nitrite_mg_n_per_l * exchanged_l;\n    65→    state.water.nitrate_mg_n_total += source.nitrate_mg_n_per_l * exchanged_l;\n    66→    state.water.phosphate_mg_p_total += source.phosphate_mg_p_per_l * exchanged_l;\n    67→    state.water.dissolved_inorganic_carbon_mg_c_total += source.dic_mg_c_per_l * exchanged_l;\n    68→    state.water.dissolved_organic_carbon_mg_c_total += source.doc_mg_c_per_l * exchanged_l;\n    69→    state.water.dissolved_organic_nitrogen_mg_n_total += source.don_mg_n_per_l * exchanged_l;\n    70→    state.water.alkalinity_meq_total += source.alkalinity_meq_per_l * exchanged_l;\n    71→    state.water.calcium_mg_total += source.calcium_mg_per_l * exchanged_l;\n    72→    state.water.magnesium_mg_total += source.magnesium_mg_per_l * exchanged_l;\n    73→    state.water.sodium_mg_total += source.sodium_mg_per_l * exchanged_l;\n    74→    state.water.potassium_mg_total += source.potassium_mg_per_l * exchanged_l;\n    75→    state.water.bicarbonate_mg_total += source.bicarbonate_mg_per_l * exchanged_l;\n    76→    state.water.chloride_mg_total += source.chloride_mg_per_l * exchanged_l;\n    77→    state.water.sulfate_mg_total += source.sulfate_mg_per_l * exchanged_l;\n    78→\n    79→    // Mix temperature proportionally by exchanged volume\n    80→    state.water.temperature_c =\n    81→        state.water.temperature_c * retention + source.temperature_c * fraction;\n    82→}\n    83→"}]},"parent_tool_use_id":"toolu_01UCaXNtFgAXHKM8s79niZTb","session_id":"5afc8472-1402-44b3-9d7c-1a241eb51364","uuid":"308c354f-bab9-4fca-821b-041fe57d3bbb"}
