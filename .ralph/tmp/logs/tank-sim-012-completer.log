pub fn into_engine(self) -> Engine {\n    51→        Engine::from_parts(self.state, self.queued_actions)\n    52→    }\n    53→}\n    54→"}]},"parent_tool_use_id":"toolu_01UCaXNtFgAXHKM8s79niZTb","session_id":"5afc8472-1402-44b3-9d7c-1a241eb51364","uuid":"6a941379-1843-45ac-b51f-29a9919ad825"}
