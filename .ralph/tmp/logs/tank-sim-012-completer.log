er_ids();\n   386→                let current_index = options\n   387→                    .iter()\n   388→                    .position(|id| *id == self.source_water_id)\n   389→                    .unwrap_or(0);\n   390→                let next_index = (current_index + 1) % options.len();\n   391→                self.source_water_id = options[next_index].to_string();\n   392→            }\n   393→            SelectionField::Substrate => {\n   394→                cycle_choice(\n   395→                    &mut self.substrate_preset,\n   396→                    &StartupSubstratePreset::ALL,\n   397→                    true,\n   398→                );\n   399→            }\n   400→            SelectionField::Plants => {\n   401→                cycle_choice(&mut self.plant_selection, &StartupPlantSelection::ALL, true);\n   402→            }\n   403→            SelectionField::Filter => self.filter_enabled = !self.filter_enabled,\n   404→            SelectionField::Light => {\n   405→                cycle_choice(&mut self.light_preset, &StartupLightPreset::ALL, true);\n   406→            }\n   407→            SelectionField::Heater => {\n   408→                cycle_choice(&mut self.heater_preset, &StartupHeaterPreset::ALL, true);\n   409→            }\n   410→            SelectionField::Aeration => self.aeration_enabled = !self.aeration_enabled,\n   411→            SelectionField::ShrimpCount => {\n   412→                cycle_choice(&mut self.initial_shrimp_count, &STARTUP_SHRIMP_COUNTS, true);\n   413→            }\n   414→            SelectionField::Launch => {}\n   415→        }\n   416→        Ok(())\n   417→    }\n   418→}\n   419→\n   420→fn select_startup_config(\n   421→    terminal: &mut Terminal<CrosstermBackend<Stdout>>,\n   422→) -> anyhow::Result<Option<StartupSelection>> {\n   423→    let mut selection = StartupSelection::default();\n   424→\n   425→    loop {\n   426→        terminal.draw(|frame| render_startup(frame, &selection))?;\n   427→\n   428→        if let Event::Key(key) = event::read().context(\"failed to read selection input\")? {\n   429→            if key.kind != KeyEventKind::Press {\n   430→                continue;\n   431→            }\n   432→\n   433→            match key.code {\n   434→                KeyCode::Char('q') => return Ok(None),\n   435→                KeyCode::Up => selection.previous_field(),\n   436→                KeyCode::Down => selection.next_field(),\n   437→                KeyCode::Left => selection.adjust_left()?,\n   438→                KeyCode::Right => selection.adjust_right()?,\n   439→                KeyCode::Enter if selection.field == SelectionField::Launch => {\n   440→                    return Ok(Some(selection));\n   441→                }\n   442→                KeyCode::Enter => selection.next_field(),\n   443→                _ => {}\n   444→            }\n   445→        }\n   446→    }\n   447→}\n   448→\n   449→fn render_startup(frame: &mut Frame<'_>, selection: &StartupSelection) {\n   450→    let area = centered_rect(frame.size(), 92, 88);\n   451→    let layout = Layout::vertical([\n   452→        Constraint::Length(4),\n   453→        Constraint::Min(16),\n   454→        Constraint::Length(3),\n   455→    ])\n   456→    .split(area);\n   457→    let body = Layout::horizontal([Constraint::Percentage(45), Constraint::Percentage(55)])\n   458→        .split(layout[1]);\n   459→\n   460→    let header = Paragraph::new(vec![\n   461→        Line::from(Span::styled(\n   462→            \"Tank Sim terminal UI\",\n   463→            Style::default()\n   464→                .fg(Color::Cyan)\n   465→                .add_modifier(Modifier::BOLD),\n   466→        )),\n   467→        Line::from(\n   468→            \"Choose a scenario template, then override water, planting, hardware, and starting stock.\",\n   469→        ),\n   470→    ])\n   471→    .block(Block::default().title(\"Startup\").borders(Borders::ALL));\n   472→    frame.render_widget(header, layout[0]);\n   473→\n   474→    let scenario = load_named_scenario(selection.scenario_id()).ok();\n   475→    let fields = vec![\n   476→        startup_item(\n   477→            selection.field == SelectionField::Scenario,\n   478→            \"Scenario\",\n   479→            scenario\n   480→                .as_ref()\n   481→                .map(|item| format!(\"{} ({})\", item.name, item.id))\n   482→                .unwrap_or_else(|| selection.scenario_id().to_string()),\n   483→        ),\n   484→        startup_item(\n   485→            selection.field == SelectionField::Size,\n   486→            \"Tank size\",\n   487→            selection.size_preset().label.to_string(),\n   488→        ),\n   489→        startup_item(\n   490→            selection.field == SelectionField::Fill,\n   491→            \"Fill height\",\n   492→            selection.fill_preset().label.to_string(),\n   493→        ),\n   494→        startup_item(\n   495→            selection.field == SelectionField::SourceWater,\n   496→            \"Source water\",\n   497→            selection.source_water_id.clone(),\n   498→        ),\n   499→        startup_item(\n   500→            selection.field == SelectionField::Substrate,\n   501→            \"Substrate\",\n   502→            selection.substrate_preset.label().to_string(),\n   503→        ),\n   504→        startup_item(\n   505→            selection.field == SelectionField::Plants,\n   506→            \"Plants\",\n   507→            selection.plant_selection.label().to_string(),\n   508→        ),\n   509→        startup_item(\n   510→            selection.field == SelectionField::Filter,\n   511→            \"Filter\",\n   512→            on_off(selection.filter_enabled).to_string(),\n   513→        ),\n   514→        startup_item(\n   515→            selection.field == SelectionField::Light,\n   516→            \"Light\",\n   517→            selection.light_preset.label().to_string(),\n   518→        ),\n   519→        startup_item(\n   520→            selection.field == SelectionField::Heater,\n   521→            \"Heater\",\n   522→            selection.heater_preset.label().to_string(),\n   523→        ),\n   524→        startup_item(\n   525→            selection.field == SelectionField::Aeration,\n   526→            \"Aeration\",\n   527→            on_off(selection.aeration_enabled).to_string(),\n   528→        ),\n   529→        startup_item(\n   530→            selection.field == SelectionField::ShrimpCount,\n   531→            \"Initial shrimp\",\n   532→            selection.initial_shrimp_count.to_string(),\n   533→        ),\n   534→        startup_item(\n   535→            selection.field == SelectionField::Launch,\n   536→            \"Launch\",\n   537→            \"Press Enter to start\".to_string(),\n   538→        ),\n   539→    ];\n   540→    let options = List::new(fields).block(\n   541→        Block::default()\n   542→            .title(\"Configuration\")\n   543→            .borders(Borders::ALL),\n   544→    );\n   545→    frame.render_widget(options, body[0]);\n   546→\n   547→    let summary = scenario\n   548→        .map(|item| {\n   549→            let geometry = selection.effective_geometry(\n   550→                item.tank_length_cm,\n   551→                item.tank_width_cm,\n   552→                item.tank_height_cm,\n   553→                item.fill_height_cm,\n   554→            );\n   555→            vec![\n   556→                Line::from(format!(\"Scenario template {} ({})\", item.name, item.id)),\n   557→                Line::from(format!(\"Ambient {:.1} C\", item.ambient_temp_c)),\n   558→                Line::from(format!(\n   559→                    \"Geometry {:.1} x {:.1} x {:.1} cm · fill {:.1} cm\",\n   560→                    geometry.length_cm,\n   561→                    geometry.width_cm,\n   562→                    geometry.height_cm,\n   563→                    geometry.fill_height_cm\n   564→                )),\n   565→                Line::from(format!(\"Water volume {:.1} L\", geometry.water_volume_l())),\n   566→                Line::from(format!(\n   567→                    \"Source water {} ({})\",\n   568→                    source_water_label(&selection.source_water_id),\n   569→                    selection.source_water_id\n   570→                )),\n   571→                Line::from(format!(\"Substrate {}\", selection.substrate_preset.label())),\n   572→                Line::from(format!(\"Plants {}\", selection.plant_selection.label())),\n   573→                Line::from(format!(\"Filter {}\", on_off(selection.filter_enabled))),\n   574→                Line::from(format!(\n   575→                    \"Light photoperiod {}\",\n   576→                    selection.light_preset.label()\n   577→                )),\n   578→                Line::from(format!(\"Heater {}\", selection.heater_preset.label())),\n   579→                Line::from(format!(\"Aeration {}\", on_off(selection.aeration_enabled))),\n   580→                Line::from(format!(\n   581→                    \"Initial shrimp {} adults\",\n   582→                    selection.initial_shrimp_count\n   583→                )),\n   584→                Line::from(\"Changing Scenario resets all override fields to that template.\"),\n   585→            ]\n   586→        })\n   587→        .unwrap_or_else(|| vec![Line::from(\"Scenario details unavailable\")]);\n   588→    let summary_widget = Paragraph::new(summary)\n   589→        .block(\n   590→            Block::default()\n   591→                .title(\"Launch summary\")\n   592→                .borders(Borders::ALL),\n   593→        )\n   594→        .wrap(ratatui::widgets::Wrap { trim: true });\n   595→    frame.render_widget(summary_widget, body[1]);\n   596→\n   597→    let help = Paragraph::new(\n   598→        \"Up/Down move between fields, Left/Right change values, Enter advances, q quits.\",\n   599→    )\n   600→    .block(Block::default().borders(Borders::ALL));\n   601→    frame.