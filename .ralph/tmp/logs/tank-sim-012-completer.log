{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014BGtv1qkKEJnM4nTgWCuwb","type":"tool_result","content":"     1→use ratatui::{\n     2→    prelude::*,\n     3→    widgets::{Block, Borders, Paragraph, Sparkline},\n     4→};\n     5→\n     6→use crate::TuiApp;\n     7→\n     8→pub fn render(frame: &mut Frame<'_>, area: Rect, app: &TuiApp) {\n     9→    let snapshot = &app.snapshot;\n    10→    let layout = Layout::vertical([Constraint::Length(9), Constraint::Min(10)]).split(area);\n    11→    let top = Layout::horizontal([Constraint::Percentage(50), Constraint::Percentage(50)])\n    12→        .split(layout[0]);\n    13→    let bottom = Layout::vertical([\n    14→        Constraint::Length(4),\n    15→        Constraint::Length(4),\n    16→        Constraint::Length(4),\n    17→        Constraint::Length(4),\n    18→    ])\n    19→    .split(layout[1]);\n    20→\n    21→    let dissolved = Paragraph::new(vec![\n    22→        Line::from(format!(\"pH {:.3}\", snapshot.ph)),\n    23→        Line::from(format!(\"TAN {:.4} mg/L\", snapshot.tan_mg_l)),\n    24→        Line::from(format!(\"NH3 {:.5} mg/L\", snapshot.nh3_mg_l)),\n    25→        Line::from(format!(\"Nitrite {:.4} mg/L\", snapshot.nitrite_mg_l)),\n    26→        Line::from(format!(\"Nitrate {:.4} mg/L\", snapshot.nitrate_mg_l)),\n    27→        Line::from(format!(\"Phosphate {:.4} mg/L\", snapshot.phosphate_mg_l)),\n    28→        Line::from(format!(\n    29→            \"DIC {:.4} mg/L\",\n    30→            snapshot.dissolved_inorganic_carbon_mg_l\n    31→        )),\n    32→    ])\n    33→    .block(\n    34→        Block::default()\n    35→            .title(\"Dissolved chemistry\")\n    36→            .borders(Borders::ALL),\n    37→    );\n    38→    frame.render_widget(dissolved, top[0]);\n    39→\n    40→    let derived = Paragraph::new(vec![\n    41→        Line::from(format!(\n    42→            \"DO {:.3}/{:.3} mg/L\",\n    43→            snapshot.do_mg_l, snapshot.do_sat_mg_l\n    44→        )),\n    45→        Line::from(format!(\"GH {:.3} d\", snapshot.gh_d)),\n    46→        Line::from(format!(\"KH {:.3} d\", snapshot.kh_d)),\n    47→        Line::from(format!(\"TDS {:.2} mg/L\", snapshot.tds_mg_l)),\n    48→        Line::from(format!(\n    49→            \"Conductivity {:.2} uS/cm\",\n    50→            snapshot.conductivity_us_cm\n    51→        )),\n    52→        Line::from(format!(\"Temp {:.2} C\", snapshot.water_temp_c)),\n    53→    ])\n    54→    .block(\n    55→        Block::default()\n    56→            .title(\"Derived display values\")\n    57→            .borders(Borders::ALL),\n    58→    );\n    59→    frame.render_widget(derived, top[1]);\n    60→\n    61→    render_trend(\n    62→        frame,\n    63→        bottom[0],\n    64→        \"pH trend\",\n    65→        snapshot.ph,\n    66→        app.history_values(|item| item.ph),\n    67→        Color::Cyan,\n    68→    );\n    69→    render_trend(\n    70→        frame,\n    71→        bottom[1],\n    72→        \"TAN trend\",\n    73→        snapshot.tan_mg_l,\n    74→        app.history_values(|item| item.tan_mg_l),\n    75→        Color::Yellow,\n    76→    );\n    77→    render_trend(\n    78→        frame,\n    79→        bottom[2],\n    80→        \"DO trend\",\n    81→        snapshot.do_mg_l,\n    82→        app.history_values(|item| item.do_mg_l),\n    83→        Color::Green,\n    84→    );\n    85→    render_trend(\n    86→        frame,\n    87→        bottom[3],\n    88→        \"Temperature trend\",\n    89→        snapshot.water_temp_c,\n    90→        app.history_values(|item| item.water_temp_c),\n    91→        Color::Magenta,\n    92→    );\n    93→}\n    94→\n    95→fn render_trend(\n    96→    frame: &mut Frame<'_>,\n    97→    area: Rect,\n    98→    title: &str,\n    99→    current_value: f64,\n   100→    history: Vec<f64>,\n   101→    color: Color,\n   102→) {\n   103→    let arrow = trend_arrow(&history);\n   104→    let sparkline_data = scale_history(history);\n   105→    let block = Block::default()\n   106→        .title(format!(\"{title} {arrow}  current {current_value:.3}\"))\n   107→        .borders(Borders::ALL);\n   108→    let inner = block.inner(area);\n   109→    frame.render_widget(block, area);\n   110→    let sparkline = Sparkline::default()\n   111→        .data(&sparkline_data)\n   112→        .style(Style::default().fg(color));\n   113→    frame.render_widget(sparkline, inner);\n   114→}\n   115→\n   116→fn scale_history(history: Vec<f64>) -> Vec<u64> {\n   117→    if history.is_empty() {\n   118→        return vec![0];\n   119→    }\n   120→\n   121→    let min = history.iter().copied().fold(f64::INFINITY, f64::min);\n   122→    let max = history.iter().copied().fold(f64::NEG_INFINITY, f64::max);\n   123→    let span = (max - min).max(0.000_001);\n   124→\n   125→    history\n   126→        .into_iter()\n   127→        .map(|value| (((value - min) / span) * 100.0).round() as u64 + 1)\n   128→        .collect()\n   129→}\n   130→\n   131→fn trend_arrow(history: &[f64]) -> &'static str {\n   132→    if history.len() < 2 {\n   133→        return \"->\";\n   134→    }\n   135→\n   136→    let last = history[history.len() - 1];\n   137→    let previous = history[history.len() - 2];\n   138→    let delta = last - previous;\n   139→    if delta > 0.000_1 {\n   140→        \"^\"\n   141→    } else if delta < -0.000_1 {\n   142→        \"v\"\n   143→    } else {\n   144→        \"->\"\n   145→    }\n   146→}\n   147→"}]},"parent_tool_use_id":"toolu_01N1Z9PEPcr3ARbXJjzcPA1Q","session_id":"5afc8472-1402-44b3-9d7c-1a241eb51364","uuid":"cc8a9db0-7a38-4f14-9b65-9c42a61c4357"}
