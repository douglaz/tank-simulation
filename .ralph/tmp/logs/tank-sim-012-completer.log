self) -> f64 {\n   223→        match self.guild {\n   224→            PlantGuild::FastStem => 0.1,\n   225→            PlantGuild::RootFeedingRosette => 0.9,\n   226→        }\n   227→    }\n   228→}\n   229→\n   230→impl AnimalState {\n   231→    pub fn with_adults(adults_count: u32) -> Self {\n   232→        Self {\n   233→            adults_count,\n   234→            ..Self::default()\n   235→        }\n   236→    }\n   237→\n   238→    /// Ensures `berried_females_count <= adults_count` by trimming\n   239→    /// excess from the newest egg cohorts first.\n   240→    pub fn clamp_berried_to_adults(&mut self) {\n   241→        if self.berried_females_count > self.adults_count {\n   242→            let excess = self.berried_females_count - self.adults_count;\n   243→            self.berried_females_count = self.adults_count;\n   244→            trim_egg_cohorts(&mut self.egg_cohorts, excess);\n   245→        }\n   246→    }\n   247→\n   248→    /// Derives `egg_progress_days` from the most-advanced cohort for display.\n   249→    pub fn sync_egg_progress_from_cohorts(&mut self) {\n   250→        self.egg_progress_days = self\n   251→            .egg_cohorts\n   252→            .iter()\n   253→            .map(|c| c.progress_days)\n   254→            .fold(0.0_f64, f64::max);\n   255→    }\n   256→}\n   257→\n   258→/// Trims `to_remove` berried females from cohorts, starting from the newest (last).\n   259→fn trim_egg_cohorts(cohorts: &mut Vec<EggCohort>, mut to_remove: u32) {\n   260→    while to_remove > 0 && !cohorts.is_empty() {\n   261→        let last = cohorts.last_mut().unwrap();\n   262→        if last.count <= to_remove {\n   263→            to_remove -= last.count;\n   264→            cohorts.pop();\n   265→        } else {\n   266→            last.count -= to_remove;\n   267→            to_remove = 0;\n   268→        }\n   269→    }\n   270→}\n   271→\n   272→pub fn total_colonizable_area_cm2(\n   273→    substrate_layers: &[SubstrateLayerState],\n   2