{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0166YMANd6UMqGsXMZKytppK","type":"tool_result","content":"     1→use crate::types::TankState;\n     2→\n     3→const FEED_P_TO_N_MASS_RATIO: f64 = 0.10;\n     4→\n     5→/// Result of one hourly nitrogen cycle step, carrying coupling values\n     6→/// that downstream systems (DO, chemistry) need.\n     7→#[derive(Debug, Clone, Copy, Default)]\n     8→pub struct NitrogenCycleOutput {\n     9→    /// Total mg N oxidized to nitrate this tick (AOB + NOB + comammox pathway).\n    10→    pub total_mg_n_nitrified: f64,\n    11→}\n    12→\n    13→/// Monod-style environmental factors shared across guilds.\n    14→struct EnvFactors {\n    15→    f_temp: f64,\n    16→    f_ph: f64,\n    17→    maturity_factor: f64,\n    18→    /// Dirty-filter penalty: 1.0 = clean, lower = clogged/dirty.\n    19→    dirty_filter_factor: f64,\n    20→    filter_enabled_factor: f64,\n    21→    flow_factor: f64,\n    22→}\n    23→\n    24→fn safe_rate(v: f64) -> f64 {\n    25→    if v.is_finite() {\n    26→        v.max(0.0)\n    27→    } else {\n    28→        0.0\n    29→    }\n    30→}\n    31→\n    32→/// Runs the full nitrogen-cycle phase for one hourly tick.\n    33→///\n    34→/// Order: feed leaching -> detritus breakdown/mineralization -> nitrification + guild growth/decay.\n    35→///\n    36→/// Returns coupling values for downstream DO and alkalinity systems.\n    37→pub fn step_nitrogen_cycle(state: &mut TankState) -> NitrogenCycleOutput {\n    38→    let volume_l = state.geometry.water_volume_l();\n    39→    if volume_l <= f64::EPSILON {\n    40→        return NitrogenCycleOutput::default();\n    41→    }\n    42→\n    43→    let pp = &state.process_params;\n    44→\n    45→    // ---- 1. Feed leaching: particulate -> fine detritus ----\n    46→    let trapping_factor =\n    47→        1.0 - (0.5 * state.avg_substrate_index(|layer| layer.detritus_trapping_index));\n    48→    let leach_rate = safe_rate(pp.feed_leach_rate_per_hour * trapping_factor);\n    49→    let leached = (state.detritus.particulate_organics_g_total * leach_rate)\n    50→        .min(state.detritus.particulate_organics_g_total);\n    51→    state.detritus.particulate_organics_g_total -= leached;\n    52→    state.detritus.fine_detritus_g_total += leached;\n    53→\n    54→    // ---- 2. Fine detritus dissolution: fine detritus -> dissolved organic pools ----\n    55→    let diss_rate = safe_rate(pp.fine_detritus_dissolution_rate_per_hour);\n    56→    let dissolved = (state.detritus.fine_detritus_g_total * diss_rate)\n    57→        .min(state.detritus.fine_detritus_g_total);\n    58→    state.detritus.fine_detritus_g_total -= dissolved;\n    59→    // dissolved mass (g) -> mg for dissolved pools: 1 g = 1000 mg\n    60→    // Split into DOC and DON using N:C ratio\n    61→    let n_to_c = safe_rate(pp.feed_n_to_c_ratio);\n    62→    let doc_mg = dissolved * 1000.0 / (1.0 + n_to_c); // carbon fraction\n    63→    let don_mg = doc_mg * n_to_c; // nitrogen fraction\n    64→    let phosphate_mg = don_mg * FEED_P_TO_N_MASS_RATIO;\n    65→    state.water.dissolved_organic_carbon_mg_c_total += doc_mg;\n    66→    state.water.dissolved_organic_nitrogen_mg_n_total += don_mg;\n    67→    // Feed introduces dissolved phosphorus alongside organic C/N, supporting algae pressure.\n    68→    state.water.phosphate_mg_p_total += phosphate_mg;\n    69→    // Track flow through dissolved_feed_residue (bookkeeping, decremented by mineralization)\n    70→    state.detritus.dissolved_feed_residue_g_total += dissolved;\n    71→\n    72→    // ---- 3. Decomposer mineralization: DOC/DON -> TAN ----\n    73→    let decomposer_biomass = state.microbe.decomposer_biomass_g;\n    74→    let doc_total = state.water.dissolved_organic_carbon_mg_c_total;\n    75→    let don_total = state.water.dissolved_organic_nitrogen_mg_n_total;\n    76→    let do_total = state.water.dissolved_oxygen_mg_total;\n    77→\n    78→    // Environmental factors for decomposers\n    79→    let temp = state.water.temperature_c;\n    80→    let f_temp_decomp = temperature_factor(temp);\n    81→    let f_do_decomp = do_total / (do_total + 2.0); // half-sat ~2 mg total\n    82→\n    83→    // Microfauna modestly improve mineralization efficiency\n    84→    let microfauna_boost =\n    85→        1.0 + pp.microfauna_mineralization_boost * state.microfauna.population_index;\n    86→    let decomp_vmax = safe_rate(pp.decomposer_vmax_per_hour) * microfauna_boost;\n    87→    let k_doc = pp.decomposer_k_doc_mg.max(0.01);\n    88→    let monod_doc = doc_total / (doc_total + k_doc);\n    89→\n    90→    let potential_doc_consumed_mg = decomp_vmax * decomposer_biomass * 1000.0 // g->mg conversion for biomass effect\n    91→        * f_temp_decomp * f_do_decomp * monod_doc;\n    92→    let potential_doc_consumed_mg = safe_rate(potential_doc_consumed_mg);\n    93→\n    94→    // Clamp: cannot consume more DOC than exists\n    95→    let doc_consumed_mg = potential_doc_consumed_mg.min(doc_total);\n    96→    // Proportional DON consumed\n    97→    let don_consumed_mg = if doc_total > f64::EPSILON {\n    98→        doc_consumed_mg * (don_total / doc_total)\n    99→    } else {\n   100→        0.0\n   101→    };\n   102→    let don_consumed_mg = don_consumed_mg.min(don_total);\n   103→\n   104→    state.water.dissolved_organic_carbon_mg_c_total -= doc_consumed_mg;\n   105→    state.water.dissolved_organic_nitrogen_mg_n_total -= don_consumed_mg;\n   106→    // Mineralized DON becomes TAN\n   107→    state.water.ammonia_total_mg_n_total += don_consumed_mg;\n   108→    // Track residue pool depletion\n   109→    let residue_consumed_g = doc_consumed_mg / 1000.0 * (1.0 + n_to_c);\n   110→    state.detritus.dissolved_feed_residue_g_total =\n   111→        (state.detritus.dissolved_feed_residue_g_total - residue_consumed_g).max(0.0);\n   112→\n   113→    // Decomposer growth/decay\n   114→    let decomp_growth = safe_rate(pp.decomposer_growth_yield) * doc_consumed_mg / 1000.0; // mg->g\n   115→    let decomp_decay = safe_rate(pp.decomposer_decay_rate_per_hour) * decomposer_biomass;\n   116→    state.microbe.decomposer_biomass_g =\n   117→        (state.microbe.decomposer_biomass_g + decomp_growth - decomp_decay).max(0.0);\n   118→\n   119→    // ---- 4. Nitrification: TAN -> nitrite -> nitrate (+ comammox TAN -> nitrate) ----\n   120→    //\n   121→    // Shared DO and alkalinity budgets enforce that combined nitrification\n   122→    // can never consume more O2 or alkalinity than available this tick.\n   123→    let env = compute_env_factors(state);\n   124→    let combined_env = env.maturity_factor * env.dirty_filter_factor * env.filter_enabled_factor;\n   125→\n   126→    let mut do_budget = state.water.dissolved_oxygen_mg_total;\n   127→    let alk_per_mg_n = safe_rate(pp.alkalinity_meq_per_mg_n_nitrified);\n   128→    let mut alk_budget = state.water.alkalinity_meq_total;\n   129→\n   130→    // Stoichiometric O2 costs per mg N for each guild step\n   131→    let o2_for_aob = 3.43_f64; // TAN -> nitrite\n   132→    let o2_for_comammox = pp.o2_per_mg_n_nitrified; // TAN -> nitrate (4.57)\n   133→    let o2_for_nob = 1.14_f64; // nitrite -> nitrate\n   134→\n   135→    // 4a. AOB: TAN -> nitrite\n   136→    let aob_env_factor =\n   137→        combined_env * env.f_temp * env.f_ph * (do_budget / (do_budget + pp.aob_k_do_mg.max(0.01)));\n   138→    let aob_potential = monod_rate(\n   139→        safe_rate(pp.aob_vmax_mg_n_per_g_per_hour) * env.flow_factor,\n   140→        state.microbe.ammonia_oxidizer_biomass_g,\n   141→        aob_env_factor,\n   142→        state.water.ammonia_total_mg_n_total,\n   143→        pp.aob_k_tan_mg.max(0.01),\n   144→    );\n   145→    let aob_rate = safe_rate(aob_potential)\n   146→        .min(state.water.ammonia_total_mg_n_total)\n   147→        .min(if o2_for_aob > 0.0 {\n   148→            do_budget / o2_for_aob\n   149→        } else {\n   150→            f64::MAX\n   151→        })\n   152→        .min(if alk_per_mg_n > 0.0 {\n   153→            alk_budget / alk_per_mg_n\n   154→        } else {\n   155→            f64::MAX\n   156→        });\n   157→\n   158→    // Debit shared budgets for AOB\n   159→    let aob_o2_cost = aob_rate * o2_for_aob;\n   160→    let aob_alk_cost = aob_rate * alk_per_mg_n;\n   161→    do_budget = (do_budget - aob_o2_cost).max(0.0);\n   162→    alk_budget = (alk_budget - aob_alk_cost).max(0.0);\n   163→\n   164→    // 4b. Comammox: TAN -> nitrate directly (lower vmax)\n   165→    let comammox_vmax =\n   166→        safe_rate(pp.aob_vmax_mg_n_per_g_per_hour * pp.comammox_vmax_fraction) * env.flow_factor;\n   167→    let tan_after_aob = (state.water.ammonia_total_mg_n_total - aob_rate).max(0.0);\n   168→    let comammox_env_factor = combined_env\n   169→        * env.f_temp\n   170→        * env.f_ph\n   171→        * (do_budget / (do_budget + pp.comammox_k_do_mg.max(0.01)));\n   172→    let comammox_potential = monod_rate(\n   173→        comammox_vmax,\n   174→        state.microbe.comammox_biomass_g,\n   175→        comammox_env_factor,\n   176→        tan_after_aob,\n   177→        pp.comammox_k_tan_mg.max(0.01),\n   178→    );\n   179→    let comammox_rate = safe_rate(comammox_potential)\n   180→        .min(tan_after_aob)\n   181→        .min(if o2_for_comammox > 0.0 {\n   182→            do_budget / o2_for_comammox\n   183→        } else {\n   184→            f64::MAX\n   185→        })\n   186→        .min(if alk_per_mg_n > 0.0 {\n   187→            alk_budget / alk_per_mg_n\n   188→        } else {\n   189→            f64::MAX\n   190→        });\n   191→\n   192→    // Debit shared budgets for comammox\n   193→    let comammox_o2_cost = comammox_rate * o2_for_comammox;\n   194→    let comammox_alk_cost = comammox_rate * alk_per_mg_n;\n   195→    do_budget = (do_budget - comammox_o2_cost).max(0.0);\n   196→    alk_budget = (alk_budget - comammox_alk_cost).max(0.0);\n   197→\n   198→    // Apply AOB + comammox TAN consumption\n   199→    let total_tan_consumed = aob_rate + comammox_rate;\n   200→    state.water.ammonia_total_mg_n_total =\n   201→        (state.water.ammonia_total_mg_n_total - total_tan_consumed).max(0.0);\n   202→    // AOB produces nitrite\n   203→    state.water.nitrite_mg_n_total += aob_rate;\n   204→    // Comammox produces nitrate directly\n   205→    state.water.nitrate_mg_n_total += comammox_rate;\n   206→\n   207→    // Apply O2 costs so far (AOB + comammox) to state\n   208→    state.water.dissolved_oxygen_mg_total =\n   209→        (state.water.dissolved_oxygen_mg_total - aob_o2_cost - comammox_o2_cost).max(0.0);\n   210→\n   211→    // 4c. NOB: nitrite -> nitrate (uses remaining DO/alk budget)\n   212→    let nob_env_factor =\n   213→        combined_env * env.f_temp * env.f_ph * (do_budget / (do_budget + pp.nob_k_do_mg.max(0.01)));\n   214→    let nob_potential = monod_rate(\n   215→        safe_rate(pp.nob_vmax_mg_n_per_g_per_hour) * env.flow_factor,\n   216→        state.microbe.nitrite_oxidizer_biomass_g,\n   217→        nob_env_factor,\n   218→        state.water.nitrite_mg_n_total,\n   219→        pp.nob_k_nitrite_mg.max(0.01),\n   220→    );\n   221→    let nob_rate = safe_rate(nob_potential)\n   222→        .min(state.water.nitrite_mg_n_total)\n   223→        .min(if o2_for_nob > 0.0 {\n   224→            do_budget / o2_for_nob\n   225→        } else {\n   226→            f64::MAX\n   227→        })\n   228→        .min(if alk_per_mg_n > 0.0 {\n   229→            alk_budget / alk_per_mg_n\n   230→        } else {\n   231→            f64::MAX\n   232→        });\n   233→\n   234→    let nob_o2_cost = nob_rate * o2_for_nob;\n   235→\n   236→    state.water.nitrite_mg_n_total = (state.water.nitrite_mg_n_total - nob_rate).max(0.0);\n   237→    state.water.nitrate_mg_n_total += nob_rate;\n   238→    state.water.dissolved_oxygen_mg_total =\n   239→        (state.water.dissolved_oxygen_mg_total - nob_o2_cost).max(0.0);\n   240→\n   241→    // Total N fully nitrified to nitrate (for alkalinity coupling)\n   242→    // AOB only takes TAN -> nitrite, NOB takes nitrite -> nitrate, comammox takes TAN -> nitrate\n   243→    // Full pathway N: nob_rate (came from AOB path) + comammox_rate\n   244→    let total_mg_n_nitrified = nob_rate + comammox_rate;\n   245→\n   246→    // ---- 5. Guild growth and decay ----\n   247→    // AOB growth from TAN oxidized\n   248→    let aob_growth = safe_rate(pp.aob_growth_yield) * aob_rate;\n   249→    let aob_decay =\n   250→        safe_rate(pp.aob_decay_rate_per_hour) * state.microbe.ammonia_oxidizer_biomass_g;\n   251→    state.microbe.ammonia_oxidizer_biomass_g =\n   252→        (state.microbe.ammonia_oxidizer_biomass_g + aob_growth - aob_decay).max(0.0);\n   253→\n   254→    // NOB growth from nitrite oxidized\n   255→    let nob_growth = safe_rate(pp.nob_growth_yield) * nob_rate;\n   256→    let nob_decay =\n   257→        safe_rate(pp.nob_decay_rate_per_hour) * state.microbe.nitrite_oxidizer_biomass_g;\n   258→    state.microbe.nitrite_oxidizer_biomass_g =\n   259→        (state.microbe.nitrite_oxidizer_biomass_g + nob_growth - nob_decay).max(0.0);\n   260→\n   261→    // Comammox growth from TAN fully oxidized\n   262→    let comammox_growth = safe_rate(pp.comammox_growth_yield) * comammox_rate;\n   263→    let comammox_decay =\n   264→        safe_rate(pp.comammox_decay_rate_per_hour) * state.microbe.comammox_biomass_g;\n   265→    state.microbe.comammox_biomass_g =\n   266→        (state.microbe.comammox_biomass_g + comammox_growth - comammox_decay).max(0.0);\n   267→\n   268→    // ---- 6. Alkalinity consumption from nitrification ----\n   269→    // AOB and comammox alkalinity was already tracked in the budget; apply the\n   270→    // total consumption (AOB + comammox + NOB path) to state.\n   271→    let total_alk_consumed = (aob_rate + comammox_rate + nob_rate) * alk_per_mg_n;\n   272→    state.water.alkalinity_meq_total =\n   273→        (state.water.alkalinity_meq_total - total_alk_consumed).max(0.0);\n   274→\n   275→    // Nitrification is a chemoautotrophic process that produces some DIC fixation\n   276→    // but for simplicity we model it as a net DIC producer via mineralization pathway above.\n   277→\n   278→    NitrogenCycleOutput {\n   279→        total_mg_n_nitrified,\n   280→    }\n   281→}\n   282→\n   283→/// Temperature factor: peaks around 25-30°C, drops off at extremes.\n   284→fn temperature_factor(temp_c: f64) -> f64 {\n   285→    // Bell-shaped factor peaking at 28°C with a half-width of ~10°C\n   286→    let opt = 28.0;\n   287→    let sigma = 10.0;\n   288→    let diff = temp_c - opt;\n   289→    (-(diff * diff) / (2.0 * sigma * sigma)).exp()\n   290→}\n   291→\n   292→/// pH factor: nitrifiers prefer 7-8, reduced at extremes.\n   293→fn ph_factor(ph: f64) -> f64 {\n   294→    let opt = 7.5;\n   295→    let sigma = 1.5;\n   296→    let diff = ph - opt;\n   297→    (-(diff * diff) / (2.0 * sigma * sigma)).exp()\n   298→}\n   299→\n   300→fn compute_env_factors(state: &TankState) -> EnvFactors {\n   301→    let f_temp = temperature_factor(state.water.temperature_c);\n   302→    let f_ph = ph_factor(state.water.ph);\n   303→\n   304→    // Maturity factor: immature filters slow nitrification\n   305→    let maturity_factor = state.filter_state.biofilter_maturity_index.clamp(0.05, 1.0);\n   306→\n   307→    // Dirty-filter factor: clogged filters reduce nitrification efficiency.\n   308→    // clogging_index of 0 = clean (factor=1), clogging_index of 1 = fully clogged (factor=0.2)\n   309→    let dirty_filter_factor = (1.0 - 0.8 * state.filter_state.clogging_index).clamp(0.2, 1.0);\n   310→    let filter_enabled_factor = if state.hardware.filter.enabled {\n   311→        1.0\n   312→    } else {\n   313→        0.1\n   314→    };\n   315→    let volume_l = state.geometry.water_volume_l().max(f64::EPSILON);\n   316→    let flow_factor = if state.hardware.filter.enabled {\n   317→        (state.hardware.filter.flow_lph / volume_l).clamp(0.1, 1.0)\n   318→    } else {\n   319→        1.0\n   320→    };\n   321→\n   322→    EnvFactors {\n   323→        f_temp,\n   324→        f_ph,\n   325→        maturity_factor,\n   326→        dirty_filter_factor,\n   327→        filter_enabled_factor,\n   328→        flow_factor,\n   329→    }\n   330→}\n   331→\n   332→/// Monod-style rate: vmax * biomass * environmental_factor * S/(K+S)\n   333→fn monod_rate(\n   334→    vmax: f64,\n   335→    biomass_g: f64,\n   336→    environmental_factor: f64,\n   337→    substrate: f64,\n   338→    k_substrate: f64,\n   339→) -> f64 {\n   340→    let monod = substrate / (substrate + k_substrate);\n   341→    safe_rate(vmax * biomass_g * environmental_factor * monod)\n   342→}\n   343→\n   344→/// Daily biofilter maturity update. Called every 24 ticks.\n   345→/// Recomputes `filter_state.biofilter_maturity_index` from guild biomass.\n   346→pub fn update_daily_biofilter_maturity(state: &mut TankState) -> f64 {\n   347→    let prev = state.filter_state.biofilter_maturity_index;\n   348→\n   349→    // Capacity reference: a \"mature\" biofilter might have ~0.5g total nitrifier biomass\n   350→    let capacity_g = 0.5;\n   351→    let total_nitrifier_g = state.microbe.ammonia_oxidizer_biomass_g\n   352→        + state.microbe.nitrite_oxidizer_biomass_g\n   353→        + state.microbe.comammox_biomass_g;\n   354→    let raw_maturity = (total_nitrifier_g / capacity_g).clamp(0.0, 1.0);\n   355→\n   356→    // Smooth towards raw_maturity\n   357→    let alpha = 0.1;\n   358→    let new_maturity = (prev + alpha * (raw_maturity - prev)).clamp(0.0, 1.0);\n   359→    state.filter_state.biofilter_maturity_index = new_maturity;\n   360→\n   361→    new_maturity - prev\n   362→}\n   363→\n   364→pub fn update_daily_filter_clogging(state: &mut TankState) -> f64 {\n   365→    if !state.hardware.filter.enabled {\n   366→        return 0.0;\n   367→    }\n   368→\n   369→    let volume_l = state.geometry.water_volume_l();\n   370→    if volume_l <= f64::EPSILON {\n   371→        return 0.0;\n   372→    }\n   373→\n   374→    let detritus_pressure = (state.detritus.fine_detritus_g_total / volume_l).clamp(0.0, 1.0);\n   375→    let clogging_delta =\n   376→        0.002 * (1.0 - state.hardware.filter.cleanliness_index.clamp(0.0, 1.0)) * detritus_pressure;\n   377→\n   378→    state.filter_state.clogging_index =\n   379→        (state.filter_state.clogging_index + clogging_delta).clamp(0.0, 1.0);\n   380→\n   381→    clogging_delta\n   382→}\n   383→"}]},"parent_tool_use_id":null,"session_id":"2ad77fc9-0efe-444c-a600-77e1b90aeddd","uuid":"f752822b-aae6-4595-aadd-0790552d229e","tool_use_result":{"type":"text","file":{"filePath":"/root/tank-simulation/crates/tank_core/src/systems/nitrogen_cycle.rs","content":"use crate::types::TankState;\n\nconst FEED_P_TO_N_MASS_RATIO: f64 = 0.10;\n\n/// Result of one hourly nitrogen cycle step, carrying coupling values\n/// that downstream systems (DO, chemistry) need.\n#[derive(Debug, Clone, Copy, Default)]\npub struct NitrogenCycleOutput {\n    /// Total mg N oxidized to nitrate this tick (AOB + NOB + comammox pathway).\n    pub total_mg_n_nitrified: f64,\n}\n\n/// Monod-style environmental factors shared across guilds.\nstruct EnvFactors {\n    f_temp: f64,\n    f_ph: f64,\n    maturity_factor: f64,\n    /// Dirty-filter penalty: 1.0 = clean, lower = clogged/dirty.\n    dirty_filter_factor: f64,\n    filter_enabled_factor: f64,\n    flow_factor: f64,\n}\n\nfn safe_rate(v: f64) -> f64 {\n    if v.is_finite() {\n        v.max(0.0)\n    } else {\n        0.0\n    }\n}\n\n/// Runs the full nitrogen-cycle phase for one hourly tick.\n///\n/// Order: feed leaching -> detritus breakdown/mineralization -> nitrification + guild growth/decay.\n///\n/// Returns coupling values for downstream DO and alkalinity systems.\npub fn step_nitrogen_cycle(state: &mut TankState) -> NitrogenCycleOutput {\n    let volume_l = state.geometry.water_volume_l();\n    if volume_l <= f64::EPSILON {\n        return NitrogenCycleOutput::default();\n    }\n\n    let pp = &state.process_params;\n\n    // ---- 1. Feed leaching: particulate -> fine detritus ----\n    let trapping_factor =\n        1.0 - (0.5 * state.avg_substrate_index(|layer| layer.detritus_trapping_index));\n    let leach_rate = safe_rate(pp.feed_leach_rate_per_hour * trapping_factor);\n    let leached = (state.detritus.particulate_organics_g_total * leach_rate)\n        .min(state.detritus.particulate_organics_g_total);\n    state.detritus.particulate_organics_g_total -= leached;\n    state.detritus.fine_detritus_g_total += leached;\n\n    // ---- 2. Fine detritus dissolution: fine detritus -> dissolved organic pools ----\n    let diss_rate = safe_rate(pp.fine_detritus_dissolution_rate_per_hour);\n    let dissolved = (state.detritus.fine_detritus_g_total * diss_rate)\n        .min(state.detritus.fine_detritus_g_total);\n    state.detritus.fine_detritus_g_total -= dissolved;\n    // dissolved mass (g) -> mg for dissolved pools: 1 g = 1000 mg\n    // Split into DOC and DON using N:C ratio\n    let n_to_c = safe_rate(pp.feed_n_to_c_ratio);\n    let doc_mg = dissolved * 1000.0 / (1.0 + n_to_c); // carbon fraction\n    let don_mg = doc_mg * n_to_c; // nitrogen fraction\n    let phosphate_mg = don_mg * FEED_P_TO_N_MASS_RATIO;\n    state.water.dissolved_organic_carbon_mg_c_total += doc_mg;\n    state.water.dissolved_organic_nitrogen_mg_n_total += don_mg;\n    // Feed introduces dissolved phosphorus alongside organic C/N, supporting algae pressure.\n    state.water.phosphate_mg_p_total += phosphate_mg;\n    // Track flow through dissolved_feed_residue (bookkeeping, decremented by mineralization)\n    state.detritus.dissolved_feed_residue_g_total += dissolved;\n\n    // ---- 3. Decomposer mineralization: DOC/DON -> TAN ----\n    let decomposer_biomass = state.microbe.decomposer_biomass_g;\n    let doc_total = state.water.dissolved_organic_carbon_mg_c_total;\n    let don_total = state.water.dissolved_organic_nitrogen_mg_n_total;\n    let do_total = state.water.dissolved_oxygen_mg_total;\n\n    // Environmental factors for decomposers\n    let temp = state.water.temperature_c;\n    let f_temp_decomp = temperature_factor(temp);\n    let f_do_decomp = do_total / (do_total + 2.0); // half-sat ~2 mg total\n\n    // Microfauna modestly improve mineralization efficiency\n    let microfauna_boost =\n        1.0 + pp.microfauna_mineralization_boost * state.microfauna.population_index;\n    let decomp_vmax = safe_rate(pp.decomposer_vmax_per_hour) * microfauna_boost;\n    let k_doc = pp.decomposer_k_doc_mg.max(0.01);\n    let monod_doc = doc_total / (doc_total + k_doc);\n\n    let potential_doc_consumed_mg = decomp_vmax * decomposer_biomass * 1000.0 // g->mg conversion for biomass effect\n        * f_temp_decomp * f_do_decomp * monod_doc;\n    let potential_doc_consumed_mg = safe_rate(potential_doc_consumed_mg);\n\n    // Clamp: cannot consume more DOC than exists\n    let doc_consumed_mg = potential_doc_consumed_mg.min(doc_total);\n    // Proportional DON consumed\n    let don_consumed_mg = if doc_total > f64::EPSILON {\n        doc_consumed_mg * (don_total / doc_total)\n    } else {\n        0.0\n    };\n    let don_consumed_mg = don_consumed_mg.min(don_total);\n\n    state.water.dissolved_organic_carbon_mg_c_total -= doc_consumed_mg;\n    state.water.dissolved_organic_nitrogen_mg_n_total -= don_consumed_mg;\n    // Mineralized DON becomes TAN\n    state.water.ammonia_total_mg_n_total += don_consumed_mg;\n    // Track residue pool depletion\n    let residue_consumed_g = doc_consumed_mg / 1000.0 * (1.0 + n_to_c);\n    state.detritus.dissolved_feed_residue_g_total =\n        (state.detritus.dissolved_feed_residue_g_total - residue_consumed_g).max(0.0);\n\n    // Decomposer growth/decay\n    let decomp_growth = safe_rate(pp.decomposer_growth_yield) * doc_consumed_mg / 1000.0; // mg->g\n    let decomp_decay = safe_rate(pp.decomposer_decay_rate_per_hour) * decomposer_biomass;\n    state.microbe.decomposer_biomass_g =\n        (state.microbe.decomposer_biomass_g + decomp_growth - decomp_decay).max(0.0);\n\n    // ---- 4. Nitrification: TAN -> nitrite -> nitrate (+ comammox TAN -> nitrate) ----\n    //\n    // Shared DO and alkalinity budgets enforce that combined nitrification\n    // can never consume more O2 or alkalinity than available this tick.\n    let env = compute_env_factors(state);\n    let combined_env = env.maturity_factor * env.dirty_filter_factor * env.filter_enabled_factor;\n\n    let mut do_budget = state.water.dissolved_oxygen_mg_total;\n    let alk_per_mg_n = safe_rate(pp.alkalinity_meq_per_mg_n_nitrified);\n    let mut alk_budget = state.water.alkalinity_meq_total;\n\n    // Stoichiometric O2 costs per mg N for each guild step\n    let o2_for_aob = 3.43_f64; // TAN -> nitrite\n    let o2_for_comammox = pp.o2_per_mg_n_nitrified; // TAN -> nitrate (4.57)\n    let o2_for_nob = 1.14_f64; // nitrite -> nitrate\n\n    // 4a. AOB: TAN -> nitrite\n    let aob_env_factor =\n        combined_env * env.f_temp * env.f_ph * (do_budget / (do_budget + pp.aob_k_do_mg.max(0.01)));\n    let aob_potential = monod_rate(\n        safe_rate(pp.aob_vmax_mg_n_per_g_per_hour) * env.flow_factor,\n        state.microbe.ammonia_oxidizer_biomass_g,\n        aob_env_factor,\n        state.water.ammonia_total_mg_n_total,\n        pp.aob_k_tan_mg.max(0.01),\n    );\n    let aob_rate = safe_rate(aob_potential)\n        .min(state.water.ammonia_total_mg_n_total)\n        .min(if o2_for_aob > 0.0 {\n            do_budget / o2_for_aob\n        } else {\n            f64::MAX\n        })\n        .min(if alk_per_mg_n > 0.0 {\n            alk_budget / alk_per_mg_n\n        } else {\n            f64::MAX\n        });\n\n    // Debit shared budgets for AOB\n    let aob_o2_cost = aob_rate * o2_for_aob;\n    let aob_alk_cost = aob_rate * alk_per_mg_n;\n    do_budget = (do_budget - aob_o2_cost).max(0.0);\n    alk_budget = (alk_budget - aob_alk_cost).max(0.0);\n\n    // 4b. Comammox: TAN -> nitrate directly (lower vmax)\n    let comammox_vmax =\n        safe_rate(pp.aob_vmax_mg_n_per_g_per_hour * pp.comammox_vmax_fraction) * env.flow_factor;\n    let tan_after_aob = (state.water.ammonia_total_mg_n_total - aob_rate).max(0.0);\n    let comammox_env_factor = combined_env\n        * env.f_temp\n        * env.f_ph\n        * (do_budget / (do_budget + pp.comammox_k_do_mg.max(0.01)));\n    let comammox_potential = monod_rate(\n        comammox_vmax,\n        state.microbe.comammox_biomass_g,\n        comammox_env_factor,\n        tan_after_aob,\n        pp.comammox_k_tan_mg.max(0.01),\n    );\n    let comammox_rate = safe_rate(comammox_potential)\n        .min(tan_after_aob)\n        .min(if o2_for_comammox > 0.0 {\n            do_budget / o2_for_comammox\n        } else {\n            f64::MAX\n        })\n        .min(if alk_per_mg_n > 0.0 {\n            alk_budget / alk_per_mg_n\n        } else {\n            f64::MAX\n        });\n\n    // Debit shared budgets for comammox\n    let comammox_o2_cost = comammox_rate * o2_for_comammox;\n    let comammox_alk_cost = comammox_rate * alk_per_mg_n;\n    do_budget = (do_budget - comammox_o2_cost).max(0.0);\n    alk_budget = (alk_budget - comammox_alk_cost).max(0.0);\n\n    // Apply AOB + comammox TAN consumption\n    let total_tan_consumed = aob_rate + comammox_rate;\n    state.water.ammonia_total_mg_n_total =\n        (state.water.ammonia_total_mg_n_total - total_tan_consumed).max(0.0);\n    // AOB produces nitrite\n    state.water.nitrite_mg_n_total += aob_rate;\n    // Comammox produces nitrate directly\n    state.water.nitrate_mg_n_total += comammox_rate;\n\n    // Apply O2 costs so far (AOB + comammox) to state\n    state.water.dissolved_oxygen_mg_total =\n        (state.water.dissolved_oxygen_mg_total - aob_o2_cost - comammox_o2_cost).max(0.0);\n\n    // 4c. NOB: nitrite -> nitrate (uses remaining DO/alk budget)\n    let nob_env_factor =\n        combined_env * env.f_temp * env.f_ph * (do_budget / (do_budget + pp.nob_k_do_mg.max(0.01)));\n    let nob_potential = monod_rate(\n        safe_rate(pp.nob_vmax_mg_n_per_g_per_hour) * env.flow_factor,\n        state.microbe.nitrite_oxidizer_biomass_g,\n        nob_env_factor,\n        state.water.nitrite_mg_n_total,\n        pp.nob_k_nitrite_mg.max(0.01),\n    );\n    let nob_rate = safe_rate(nob_potential)\n        .min(state.water.nitrite_mg_n_total)\n        .min(if o2_for_nob > 0.0 {\n            do_budget / o2_for_nob\n        } else {\n            f64::MAX\n        })\n        .min(if alk_per_mg_n > 0.0 {\n            alk_budget / alk_per_mg_n\n        } else {\n            f64::MAX\n        });\n\n    let nob_o2_cost = nob_rate * o2_for_nob;\n\n    state.water.nitrite_mg_n_total = (state.water.nitrite_mg_n_total - nob_rate).max(0.0);\n    state.water.nitrate_mg_n_total += nob_rate;\n    state.water.dissolved_oxygen_mg_total =\n        (state.water.dissolved_oxygen_mg_total - nob_o2_cost).max(0.0);\n\n    // Total N fully nitrified to nitrate (for alkalinity coupling)\n    // AOB only takes TAN -> nitrite, NOB takes nitrite -> nitrate, comammox takes TAN -> nitrate\n    // Full pathway N: nob_rate (came from AOB path) + comammox_rate\n    let total_mg_n_nitrified = nob_rate + comammox_rate;\n\n    // ---- 5. Guild growth and decay ----\n    // AOB growth from TAN oxidized\n    let aob_growth = safe_rate(pp.aob_growth_yield) * aob_rate;\n    let aob_decay =\n        safe_rate(pp.aob_decay_rate_per_hour) * state.microbe.ammonia_oxidizer_biomass_g;\n    state.microbe.ammonia_oxidizer_biomass_g =\n        (state.microbe.ammonia_oxidizer_biomass_g + aob_growth - aob_decay).max(0.0);\n\n    // NOB growth from nitrite oxidized\n    let nob_growth = safe_rate(pp.nob_growth_yield) * nob_rate;\n    let nob_decay =\n        safe_rate(pp.nob_decay_rate_per_hour) * state.microbe.nitrite_oxidizer_biomass_g;\n    state.microbe.nitrite_oxidizer_biomass_g =\n        (state.microbe.nitrite_oxidizer_biomass_g + nob_growth - nob_decay).max(0.0);\n\n    // Comammox growth from TAN fully oxidized\n    let comammox_growth = safe_rate(pp.comammox_growth_yield) * comammox_rate;\n    let comammox_decay =\n        safe_rate(pp.comammox_decay_rate_per_hour) * state.microbe.comammox_biomass_g;\n    state.microbe.comammox_biomass_g =\n        (state.microbe.comammox_biomass_g + comammox_growth - comammox_decay).max(0.0);\n\n    // ---- 6. Alkalinity consumption from nitrification ----\n    // AOB and comammox alkalinity was already tracked in the budget; apply the\n    // total consumption (AOB + comammox + NOB path) to state.\n    let total_alk_consumed = (aob_rate + comammox_rate + nob_rate) * alk_per_mg_n;\n    state.water.alkalinity_meq_total =\n        (state.water.alkalinity_meq_total - total_alk_consumed).max(0.0);\n\n    // Nitrification is a chemoautotrophic process that produces some DIC fixation\n    // but for simplicity we model it as a net DIC producer via mineralization pathway above.\n\n    NitrogenCycleOutput {\n        total_mg_n_nitrified,\n    }\n}\n\n/// Temperature factor: peaks around 25-30°C, drops off at extremes.\nfn temperature_factor(temp_c: f64) -> f64 {\n    // Bell-shaped factor peaking at 28°C with a half-width of ~10°C\n    let opt = 28.0;\n    let sigma = 10.0;\n    let diff = temp_c - opt;\n    (-(diff * diff) / (2.0 * sigma * sigma)).exp()\n}\n\n/// pH factor: nitrifiers prefer 7-8, reduced at extremes.\nfn ph_factor(ph: f64) -> f64 {\n    let opt = 7.5;\n    let sigma = 1.5;\n    let diff = ph - opt;\n    (-(diff * diff) / (2.0 * sigma * sigma)).exp()\n}\n\nfn compute_env_factors(state: &TankState) -> EnvFactors {\n    let f_temp = temperature_factor(state.water.temperature_c);\n    let f_ph = ph_factor(state.water.ph);\n\n    // Maturity factor: immature filters slow nitrification\n    let maturity_factor = state.filter_state.biofilter_maturity_index.clamp(0.05, 1.0);\n\n    // Dirty-filter factor: clogged filters reduce nitrification efficiency.\n    // clogging_index of 0 = clean (factor=1), clogging_index of 1 = fully clogged (factor=0.2)\n    let dirty_filter_factor = (1.0 - 0.8 * state.filter_state.clogging_index).clamp(0.2, 1.0);\n    let filter_enabled_factor = if state.hardware.filter.enabled {\n        1.0\n    } else {\n        0.1\n    };\n    let volume_l = state.geometry.water_volume_l().max(f64::EPSILON);\n    let flow_factor = if state.hardware.filter.enabled {\n        (state.hardware.filter.flow_lph / volume_l).clamp(0.1, 1.0)\n    } else {\n        1.0\n    };\n\n    EnvFactors {\n        f_temp,\n        f_ph,\n        maturity_factor,\n        dirty_filter_factor,\n        filter_enabled_factor,\n        flow_factor,\n    }\n}\n\n/// Monod-style rate: vmax * biomass * environmental_factor * S/(K+S)\nfn monod_rate(\n    vmax: f64,\n    biomass_g: f64,\n    environmental_factor: f64,\n    substrate: f64,\n    k_substrate: f64,\n) -> f64 {\n    let monod = substrate / (substrate + k_substrate);\n    safe_rate(vmax * biomass_g * environmental_factor * monod)\n}\n\n/// Daily biofilter maturity update. Called every 24 ticks.\n/// Recomputes `filter_state.biofilter_maturity_index` from guild biomass.\npub fn update_daily_biofilter_maturity(state: &mut TankState) -> f64 {\n    let prev = state.filter_state.biofilter_maturity_index;\n\n    // Capacity reference: a \"mature\" biofilter might have ~0.5g total nitrifier biomass\n    let capacity_g = 0.5;\n    let total_nitrifier_g = state.microbe.ammonia_oxidizer_biomass_g\n        + state.microbe.nitrite_oxidizer_biomass_g\n        + state.microbe.comammox_biomass_g;\n    let raw_maturity = (total_nitrifier_g / capacity_g).clamp(0.0, 1.0);\n\n    // Smooth towards raw_maturity\n    let alpha = 0.1;\n    let new_maturity = (prev + alpha * (raw_maturity - prev)).clamp(0.0, 1.0);\n    state.filter_state.biofilter_maturity_index = new_maturity;\n\n    new_maturity - prev\n}\n\npub fn update_daily_filter_clogging(state: &mut TankState) -> f64 {\n    if !state.hardware.filter.enabled {\n        return 0.0;\n    }\n\n    let volume_l = state.geometry.water_volume_l();\n    if volume_l <= f64::EPSILON {\n        return 0.0;\n    }\n\n    let detritus_pressure = (state.detritus.fine_detritus_g_total / volume_l).clamp(0.0, 1.0);\n    let clogging_delta =\n        0.002 * (1.0 - state.hardware.filter.cleanliness_index.clamp(0.0, 1.0)) * detritus_pressure;\n\n    state.filter_state.clogging_index =\n        (state.filter_state.clogging_index + clogging_delta).clamp(0.0, 1.0);\n\n    clogging_delta\n}\n","numLines":383,"startLine":1,"totalLines":383}}}
