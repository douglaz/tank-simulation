{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/tests/cycling.rs | sed -n '286,390p'\"","aggregated_output":"   286\t\n   287\t    Ok(())\n   288\t}\n   289\t\n   290\t/// Verify that when alkalinity is nearly exhausted, nitrification is limited\n   291\t/// to the supported fraction and alkalinity cannot go negative.\n   292\t#[test]\n   293\tfn limiter_low_alkalinity_caps_nitrification() -> Result<(), tank_core::SimError> {\n   294\t    let mut state = TankState::new(SimSeed(9500));\n   295\t    let vol = state.geometry.water_volume_l();\n   296\t\n   297\t    // Plenty of TAN and DO\n   298\t    state.water.ammonia_total_mg_n_total = 10.0 * vol;\n   299\t    state.water.dissolved_oxygen_mg_total = 50.0 * vol;\n   300\t    // Very low alkalinity: only enough for ~1 mg N at 0.1428 meq/mg N\n   301\t    state.water.alkalinity_meq_total = 0.15; // supports ~1.05 mg N total\n   302\t\n   303\t    state.microbe.ammonia_oxidizer_biomass_g = 0.5;\n   304\t    state.microbe.comammox_biomass_g = 0.3;\n   305\t    state.microbe.nitrite_oxidizer_biomass_g = 0.3;\n   306\t    state.filter_state.biofilter_maturity_index = 0.8;\n   307\t\n   308\t    let alk_before = state.water.alkalinity_meq_total;\n   309\t\n   310\t    let mut engine = Engine::from_parts(state, vec![]);\n   311\t    engine.step_hours(1)?;\n   312\t\n   313\t    let s = engine.full_state();\n   314\t    assert!(\n   315\t        s.water.alkalinity_meq_total >= 0.0,\n   316\t        \"Alkalinity must remain non-negative, got {}\",\n   317\t        s.water.alkalinity_meq_total\n   318\t    );\n   319\t\n   320\t    // Total alkalinity consumed should not exceed the starting budget\n   321\t    let alk_consumed = alk_before - s.water.alkalinity_meq_total;\n   322\t    assert!(\n   323\t        alk_consumed <= alk_before + 1e-9,\n   324\t        \"Alkalinity consumed ({alk_consumed:.6}) must not exceed initial budget ({alk_before:.6})\"\n   325\t    );\n   326\t\n   327\t    // Some nitrification should still have occurred\n   328\t    let tan_consumed = 10.0 * vol - s.water.ammonia_total_mg_n_total;\n   329\t    assert!(\n   330\t        tan_consumed > 0.0,\n   331\t        \"Some TAN should be consumed even with limited alkalinity\"\n   332\t    );\n   333\t\n   334\t    Ok(())\n   335\t}\n   336\t\n   337\t/// Verify that a dirty (clogged) filter reduces nitrification rate compared\n   338\t/// to a clean filter.\n   339\t#[test]\n   340\tfn dirty_filter_slows_nitrification() -> Result<(), tank_core::SimError> {\n   341\t    let base = {\n   342\t        let mut state = TankState::new(SimSeed(9600));\n   343\t        let vol = state.geometry.water_volume_l();\n   344\t        state.water.ammonia_total_mg_n_total = 5.0 * vol;\n   345\t        state.microbe.ammonia_oxidizer_biomass_g = 0.2;\n   346\t        state.microbe.nitrite_oxidizer_biomass_g = 0.15;\n   347\t        state.microbe.comammox_biomass_g = 0.03;\n   348\t        state.filter_state.biofilter_maturity_index = 0.6;\n   349\t        state\n   350\t    };\n   351\t\n   352\t    let mut clean_state = base.clone();\n   353\t    clean_state.filter_state.clogging_index = 0.0; // clean\n   354\t\n   355\t    let mut dirty_state = base;\n   356\t    dirty_state.filter_state.clogging_index = 0.9; // heavily clogged\n   357\t\n   358\t    let vol = clean_state.geometry.water_volume_l();\n   359\t\n   360\t    let mut clean_engine = Engine::from_parts(clean_state, vec![]);\n   361\t    let mut dirty_engine = Engine::from_parts(dirty_state, vec![]);\n   362\t\n   363\t    clean_engine.step_hours(24)?;\n   364\t    dirty_engine.step_hours(24)?;\n   365\t\n   366\t    let clean_tan = clean_engine.full_state().water.ammonia_total_mg_n_total / vol;\n   367\t    let dirty_tan = dirty_engine.full_state().water.ammonia_total_mg_n_total / vol;\n   368\t\n   369\t    // Clean filter should oxidize more TAN -> lower remaining TAN\n   370\t    assert!(\n   371\t        clean_tan < dirty_tan,\n   372\t        \"Clean filter TAN ({clean_tan:.4}) should be lower than dirty filter ({dirty_tan:.4})\"\n   373\t    );\n   374\t\n   375\t    Ok(())\n   376\t}\n","exit_code":0,"status":"completed"}}
