_total: 0.0,\n    44\t            dissolved_organic_nitrogen_mg_n_total: 0.0,\n    45\t            alkalinity_meq_total: 1.5 * volume_l,\n    46\t            calcium_mg_total: 20.0 * volume_l,\n    47\t            magnesium_mg_total: 5.0 * volume_l,\n    48\t            sodium_mg_total: 10.0 * volume_l,\n    49\t            potassium_mg_total: 3.0 * volume_l,\n    50\t            bicarbonate_mg_total: 70.0 * volume_l,\n    51\t            chloride_mg_total: 12.0 * volume_l,\n    52\t            sulfate_mg_total: 8.0 * volume_l,\n    53\t            ph: default_ph(),\n    54\t        };\n    55\t        state.ph = crate::systems::chemistry::compute_ph_from_totals(\n    56\t            state.alkalinity_meq_total,\n    57\t            state.dissolved_inorganic_carbon_mg_c_total,\n    58\t            volume_l,\n    59\t        );\n    60\t        state\n    61\t    }\n    62\t\n    63\t    /// Creates initial water state from a source-water profile and tank geometry.\n    64\t    /// All dissolved totals are the profile's per-liter values multiplied by volume.\n    65\t    pub fn from_source_profile(profile: &SourceWaterProfile, geometry: &TankGeometry) -> Self {\n    66\t        let volume_l = geometry.water_volume_l();\n    67\t        let do_sat = crate::systems::temperature::do_sat_mg_l(profile.temperature_c);\n    68\t        let mut state = Self {\n    69\t            temperature_c: profile.temperature_c,\n    70\t            ammonia_total_mg_n_total: profile.ammonia_mg_n_per_l * volume_l,\n    71\t            nitrite_mg_n_total: profile.nitrite_mg_n_per_l * volume_l,\n    72\t            nitrate_mg_n_total: profile.nitrate_mg_n_per_l * volume_l,\n    73\t            phosphate_mg_p_total: profile.phosphate_mg_p_per_l * volume_l,\n    74\t            dissolved_oxygen_mg_total: do_sat * volume_l,\n    75\t            dissolved_inorganic_carbon_mg_c_total: profile.dic_mg_c_per_l * volume_l,\n    76\t            dissolved_organic_carbon_mg_c_total: profile.doc_mg_c_per_l * volume_l,\n    77\t            dissolved_organic_nitrogen_mg_n_total: profile.don_mg_n_per_l * volume_l,\n    78\t            alkalinity_meq_total: profile.alkalinity_meq_per_l * volume_l,\n    79\t            calcium_mg_total: profile.calcium_mg_per_l * volume_l,\n    80\t            magnesium_mg_total: profile.magnesium_mg_per_l * volume_l,\n    81\t            sodium_mg_total: profile.sodium_mg_per_l * volume_l,\n    82\t            potassium_mg_total: profile.potassium_mg_per_l * volume_l,\n    83\t            bicarbonate_mg_total: profile.bicarbonate_mg_per_l * volume_l,\n    84\t            chloride_mg_total: profile.chloride_mg_per_l * volume_l,\n    85\t            sulfate_mg_total: profile.sulfate_mg_per_l * volume_l,\n    86\t            ph: default_ph(),\n    87\t        };\n    88\t        state.ph = crate::systems::chemistry::compute_ph_from_totals(\n    89\t            state.alkalinity_meq_total,\n    90\t            state.dissolved_inorganic_carbon_mg_c_total,\n    91\t            volume_l,\n    92\t        );\n    93\t        state\n    94\t    }\n    95\t\n    96\t    pub fn total_tracked_ions_mg(&self) -> f64 {\n    97\t        self.calcium_mg_total\n    98\t            + self.magnesium_mg_total\n    99\t            + self.sodium_mg_total\n   100\t            + self.potassium_mg_total\n   101\t            + self.bicarbonate_mg_total\n   102\t            + self.chloride_mg_total\n   103\t            + self.sulfate_mg_total\n   104\t    }\n   105\t}\n   106\t\n   107\timpl Default for WaterState {\n   108\t    fn default() -> Self {\n   109\t        Self::default_for_geometry(&TankGeometry::default())\n   110\t    }\n   111\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/src/types/actions.rs | sed -n '1,180p'\"","aggregated_output":"     1\tuse serde::{Deserialize, Serialize};\n     2\tuse thiserror::Error;\n     3\t\n     4\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n     5\tpub enum PlayerAction {\n     6\t    Feed {\n     7\t        grams: f64,\n     8\t    },\n     9\t    WaterChangePercent {\n    10\t        percent: f64,\n    11\t        source_profile_id: String,\n    12\t    },\n    13\t    TrimPlants {\n    14\t        fraction: f64,\n    15\t    },\n    16\t    SiphonDetritus {\n    17\t        fraction: f64,\n    18\t    },\n    19\t    CleanFilter {\n    20\t        intensity: f64,\n    21\t    },\n    22\t    AddShrimp {\n    23\t        count: u32,\n    24\t    },\n    25\t    RemoveShrimp {\n    26\t        count: u32,\n    27\t    },\n    28\t    ChangePhotoperiod {\n    29\t        hours: f64,\n    30\t    },\n    31\t    ChangeLightIntensity {\n    32\t        intensity_index: f64,\n    33\t    },\n    34\t    ChangeHeaterSetpoint {\n    35\t        setpoint_c: f64,\n    36\t    },\n    37\t    ChangeAmbientTemperature {\n    38\t        target_c: f64,\n    39\t    },\n    40\t    ChangeAeration {\n    41\t        enabled: bool,\n    42\t        intensity: f64,\n    43\t    },\n    44\t}\n    45\t\n    46\t#[derive(Debug, Clone, Error, PartialEq)]\n    47\tpub enum SimError {\n    48\t    #[error(\"field `{field}` must be finite, got {value}\")]\n    49\t    NonFiniteValue { field: &'static str, value: f64 },\n    50\t    #[error(\"field `{field}` must be non-negative, got {value}\")]\n    51\t    NegativeValue { field: &'static str, value: f64 },\n    52\t    #[error(\"field `{field}` must be in the range 0.0..=1.0, got {value}\")]\n    53\t    FractionOutOfRange { field: &'static str, value: f64 },\n    54\t    #[error(\"field `{field}` must be in the range 0.0..=100.0, got {value}\")]\n    55\t    PercentOutOfRange { field: &'static str, value: f64 },\n    56\t    #[error(\"field `{field}` must be in the range 0.0..=24.0, got {value}\")]\n    57\t    HoursOutOfRange { field: &'static str, value: f64 },\n    58\t    #[error(\"field `{field}` must be above 0.0 C, got {value}\")]\n    59\t    TemperatureTooLow { field: &'static str, value: f64 },\n    60\t    #[error(\"source profile id must not be empty\")]\n    61\t    EmptySourceProfileId,\n    62\t    #[error(\"invariant violation for `{field}` with value {value}\")]\n    63\t    InvariantViolation { field: &'static str, value: f64 },\n    64\t    #[error(\"unknown source water profile: `{id}`\")]\n    65\t    UnknownSourceProfile { id: String },\n    66\t    #[error(\"invalid source water profile `{id}`: field `{field}` has invalid value {value}\")]\n    67\t    InvalidSourceProfile {\n    68\t        id: String,\n    69\t        field: &'static str,\n    70\t        value: f64,\n    71\t    },\n    72\t    #[error(\"schema version mismatch: expected {expected}, got {actual}\")]\n    73\t    SchemaVersionMismatch { expected: u32, actual: u32 },\n    74\t    #[error(\"serialization error: {0}\")]\n    75\t    Serialization(String),\n    76\t    #[error(\"deserialization error: {0}\")]\n    77\t    Deserialization(String),\n    78\t    #[error(\"cannot remove {requested} shrimp, only {available} available\")]\n    79\t    ShrimpRemovalExceedsAvailable { requested: u32, available: u32 },\n    80\t}\n    81\t\n    82\timpl PlayerAction {\n    83\t    pub fn validate(&self) -> Result<(), SimError> {\n    84\t        match self {\n    85\t            Self::Feed { grams } => validate_non_negative(\"grams\", *grams),\n    86\t            Self::WaterChangePercent {\n    87\t                percent,\n    88\t                source_profile_id,\n    89\t            } => {\n    90\t                validate_percent(\"percent\", *percent)?;\n    91\t                if source_profile_id.trim().is_empty() {\n    92\t                    Err(SimError::EmptySourceProfileId)\n    93\t                } else {\n    94\t                    Ok(())\n    95\t                }\n    96\t            }\n    97\t            Self::TrimPlants { fraction }\n    98\t            | Self::SiphonDetritus { fraction }\n    99\t            | Self::CleanFilter {\n   100\t                intensity: fraction,\n   101\t            } => validate_fraction(field_name(self), *fraction),\n   102\t            Self::AddShrimp { .. } | Self::RemoveShrimp { .. } => Ok(()),\n   103\t            Self::ChangePhotoperiod { hours } => {\n   104\t                validate_finite(\"hours\", *hours)?;\n   105\t                if (0.0..=24.0).contains(hours) {\n   106\t                    Ok(())\n   107\t                } else {\n   108\t                    Err(SimError::HoursOutOfRange {\n   109\t                        field: \"hours\",\n   110\t                        value: *hours,\n   111\t                    })\n   112\t                }\n   113\t            }\n   114\t            Self::ChangeLightIntensity { intensity_index } => {\n   115\t                validate_fraction(\"intensity_index\", *intensity_index)\n   116\t            }\n   117\t            Self::ChangeHeaterSetpoint { setpoint_c } => {\n   118\t                validate_temperature(\"setpoint_c\", *setpoint_c)\n   119\t            }\n   120\t            Self::ChangeAmbientTemperature { target_c } => {\n   121\t                validate_temperature(\"target_c\", *target_c)\n   122\t            }\n   123\t            Self::ChangeAeration { intensity, .. } => validate_fraction(\"intensity\", *intensity),\n   124\t        }\n   125\t    }\n   126\t}\n   127\t\n   128\tfn field_name(action: &PlayerAction) -> &'static str {\n   129\t    match action {\n   130\t        PlayerAction::TrimPlants { .. } => \"fraction\",\n   131\t        PlayerAction::SiphonDetritus { .. } => \"fraction\",\n   132\t        PlayerAction::CleanFilter { .. } => \"intensity\",\n   133\t        _ => \"value\",\n   134\t    }\n   135\t}\n   136\t\n   137\tfn validate_non_negative(field: &'static str, value: f64) -> Result<(), SimError> {\n   138\t    validate_finite(field, value)?;\n   139\t    if value < 0.0 {\n   140\t        Err(SimError::NegativeValue { field, value })\n   141\t    } else {\n   142\t        Ok(())\n   143\t    }\n   144\t}\n   145\t\n   146\tfn validate_fraction(field: &'static str, value: f64) -> Result<(), SimError> {\n   147\t    validate_finite(field, value)?;\n   148\t    if (0.0..=1.0).contains(&value) {\n   149\t        Ok(())\n   150\t    } else {\n   151\t        Err(SimError::FractionOutOfRange { field, value })\n   152\t    }\n   153\t}\n   154\t\n   155\tfn validate_percent(field: &'static str, value: f64) -> Result<(), SimError> {\n   156\t    validate_finite(field, value)?;\n   157\t    if (0.0..=100.0).contains(&value) {\n   158\t        Ok(())\n   159\t    } else {\n   160\t        Err(SimError::PercentOutOfRange { field, value })\n   161\t    }\n   162\t}\n   163\t\n   164\tfn validate_temperature(field: &'static str, value: f64) -> Result<(), SimError> {\n   165\t    validate_finite(field, value)?;\n   166\t    if value > 0.0 {\n   167\t        Ok(())\n   168\t    } else {\n   169\t        Err(SimError::TemperatureTooLow { field, value })\n   170\t    }\n   171\t}\n   172\t\n   173\tfn validate_finite(field: &'static str, value: f64) -> Result<(), SimError> {\n   174\t    if value.is_finite() {\n   175\t        Ok(())\n   176\t    } else {\n   177\t        Err(SimError::NonFiniteValue { field, value })\n   178\t    }\n   179\t}\n","exit_code":0,"status":"completed"}}
