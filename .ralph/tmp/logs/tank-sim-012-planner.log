 after.environment.hour_of_day\n   289\t    );\n   290\t    assert_eq!(before.event_log.len(), after.event_log.len());\n   291\t    assert!((before.water.calcium_mg_total - after.water.calcium_mg_total).abs() < f64::EPSILON,);\n   292\t    assert!(\n   293\t        (before.water.ammonia_total_mg_n_total - after.water.ammonia_total_mg_n_total).abs()\n   294\t            < f64::EPSILON,\n   295\t    );\n   296\t    // Detritus should not have been modified (feed not applied)\n   297\t    assert!(\n   298\t        (before.detritus.particulate_organics_g_total\n   299\t            - after.detritus.particulate_organics_g_total)\n   300\t            .abs()\n   301\t            < f64::EPSILON,\n   302\t    );\n   303\t\n   304\t    Ok(())\n   305\t}\n   306\t\n   307\t#[test]\n   308\tfn invalid_resolved_profile_negative_chemistry_returns_error() -> Result<(), SimError> {\n   309\t    let mut state = TankState::new(SimSeed(800));\n   310\t    let mut bad_profile = SourceWaterProfile::zero();\n   311\t    bad_profile.nitrate_mg_n_per_l = -5.0;\n   312\t    state\n   313\t        .source_water_catalog\n   314\t        .insert(\"negative\".to_string(), bad_profile);\n   315\t\n   316\t    let mut engine = Engine::from_parts(state, vec![]);\n   317\t\n   318\t    engine.apply_action(PlayerAction::WaterChangePercent {\n   319\t        percent: 25.0,\n   320\t        source_profile_id: \"negative\".to_string(),\n   321\t    })?;\n   322\t\n   323\t    let result = engine.step_hours(1);\n   324\t    assert!(\n   325\t        matches!(result, Err(SimError::InvalidSourceProfile { .. })),\n   326\t        \"Expected InvalidSourceProfile error for negative chemistry, got: {result:?}\"\n   327\t    );\n   328\t\n   329\t    Ok(())\n   330\t}\n","exit_code":0,"status":"completed"}}
