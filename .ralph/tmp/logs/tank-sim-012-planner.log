{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/tests/chemistry.rs | sed -n '1,150p'\"","aggregated_output":"     1\tuse tank_core::{\n     2\t    systems::chemistry::{compute_nh3_mg_l, compute_ph_from_totals},\n     3\t    Engine, ProcessParams, SimSeed, SimulationEngine, TankState,\n     4\t};\n     5\t\n     6\tfn chemistry_state(seed: SimSeed, hour_of_day: u8) -> TankState {\n     7\t    let mut state = TankState::new(seed);\n     8\t    state.environment.hour_of_day = hour_of_day;\n     9\t    state.hardware.light.photoperiod_hours = 8.0;\n    10\t    state.hardware.light.intensity_index = 1.0;\n    11\t    state.algae.periphyton_biomass_g = 2.5;\n    12\t    state.plant_guilds[0].biomass_g = 14.0;\n    13\t    state.plant_guilds[1].biomass_g = 8.0;\n    14\t    state.animal.adults_count = 20;\n    15\t    state.process_params = ProcessParams {\n    16\t        respiration_dic_rate_mg_c_per_g_per_hour: 0.20,\n    17\t        photosynthesis_dic_rate_mg_c_per_g_per_hour: 0.35,\n    18\t        ..ProcessParams::default()\n    19\t    };\n    20\t    state\n    21\t}\n    22\t\n    23\t#[test]\n    24\tfn ph_drifts_with_light_driven_dic_changes() -> Result<(), tank_core::SimError> {\n    25\t    let mut night_engine = Engine::from_parts(chemistry_state(SimSeed(4000), 0), vec![]);\n    26\t    let mut day_engine = Engine::from_parts(chemistry_state(SimSeed(4000), 12), vec![]);\n    27\t\n    28\t    let night_ph_before = night_engine.full_state().water.ph;\n    29\t    let day_ph_before = day_engine.full_state().water.ph;\n    30\t\n    31\t    night_engine.step_hours(1)?;\n    32\t    day_engine.step_hours(1)?;\n    33\t\n    34\t    let night_ph_after = night_engine.full_state().water.ph;\n    35\t    let day_ph_after = day_engine.full_state().water.ph;\n    36\t    let night_dic_after = night_engine\n    37\t        .full_state()\n    38\t        .water\n    39\t        .dissolved_inorganic_carbon_mg_c_total;\n    40\t    let day_dic_after = day_engine\n    41\t        .full_state()\n    42\t        .water\n    43\t        .dissolved_inorganic_carbon_mg_c_total;\n    44\t\n    45\t    assert!(\n    46\t        night_ph_after < night_ph_before,\n    47\t        \"night respiration should lower pH: before={night_ph_before:.3}, after={night_ph_after:.3}\"\n    48\t    );\n    49\t    assert!(\n    50\t        day_ph_after > day_ph_before,\n    51\t        \"day photosynthesis should raise pH: before={day_ph_before:.3}, after={day_ph_after:.3}\"\n    52\t    );\n    53\t    assert!(\n    54\t        day_dic_after < night_dic_after,\n    55\t        \"lit hours should consume more DIC than night hours\"\n    56\t    );\n    57\t\n    58\t    Ok(())\n    59\t}\n    60\t\n    61\t#[test]\n    62\tfn nh3_speciation_matches_reference_formula() {\n    63\t    let tan_mg_l = 1.2;\n    64\t    let ph = 7.8;\n    65\t    let temp_c = 25.0;\n    66\t\n    67\t    let expected = {\n    68\t        let pka = 0.09018 + 2729.92 / (273.2 + temp_c);\n    69\t        let fraction_nh3 = 1.0 / (1.0 + 10.0_f64.powf(pka - ph));\n    70\t        tan_mg_l * fraction_nh3\n    71\t    };\n    72\t\n    73\t    let computed = compute_nh3_mg_l(tan_mg_l, ph, temp_c);\n    74\t    assert!((computed - expected).abs() < 1e-12);\n    75\t    assert!(compute_nh3_mg_l(tan_mg_l, 8.4, temp_c) > computed);\n    76\t}\n    77\t\n    78\t#[test]\n    79\tfn ph_formula_uses_state_storage_bounds() {\n    80\t    let low = compute_ph_from_totals(0.01, 500.0, 20.0);\n    81\t    let high = compute_ph_from_totals(12.0, 0.01, 20.0);\n    82\t\n    83\t    assert!((5.5..=8.5).contains(&low));\n    84\t    assert!((5.5..=8.5).contains(&high));\n    85\t}\n    86\t\n    87\t#[test]\n    88\tfn nitrification_lowers_alkalinity_and_ph() -> Result<(), tank_core::SimError> {\n    89\t    // Tank with active nitrification\n    90\t    let mut nitrifying_state = TankState::new(SimSeed(4100));\n    91\t    let vol = nitrifying_state.geometry.water_volume_l();\n    92\t    nitrifying_state.water.ammonia_total_mg_n_total = 2.0 * vol; // 2 mg/L TAN\n    93\t    nitrifying_state.microbe.ammonia_oxidizer_biomass_g = 0.2;\n    94\t    nitrifying_state.microbe.nitrite_oxidizer_biomass_g = 0.15;\n    95\t    nitrifying_state.microbe.comammox_biomass_g = 0.03;\n    96\t    nitrifying_state.filter_state.biofilter_maturity_index = 0.6;\n    97\t    nitrifying_state.process_params = ProcessParams::default();\n    98\t\n    99\t    // Control: identical but with zero nitrifier biomass\n   100\t    let mut control_state = nitrifying_state.clone();\n   101\t    control_state.microbe.ammonia_oxidizer_biomass_g = 0.0;\n   102\t    control_state.microbe.nitrite_oxidizer_biomass_g = 0.0;\n   103\t    control_state.microbe.comammox_biomass_g = 0.0;\n   104\t\n   105\t    let mut nitrifying = Engine::from_parts(nitrifying_state, vec![]);\n   106\t    let mut control = Engine::from_parts(control_state, vec![]);\n   107\t\n   108\t    let alk_before = nitrifying.full_state().water.alkalinity_meq_total;\n   109\t\n   110\t    nitrifying.step_hours(48)?;\n   111\t    control.step_hours(48)?;\n   112\t\n   113\t    let alk_nitrifying = nitrifying.full_state().water.alkalinity_meq_total;\n   114\t    let alk_control = control.full_state().water.alkalinity_meq_total;\n   115\t    let ph_nitrifying = nitrifying.full_state().water.ph;\n   116\t    let ph_control = control.full_state().water.ph;\n   117\t\n   118\t    // Active nitrification should lower alkalinity relative to control\n   119\t    assert!(\n   120\t        alk_nitrifying < alk_control,\n   121\t        \"Nitrifying tank ({alk_nitrifying:.4}) should have lower alkalinity than control ({alk_control:.4})\"\n   122\t    );\n   123\t    assert!(\n   124\t        alk_nitrifying < alk_before,\n   125\t        \"Alkalinity should decrease from nitrification\"\n   126\t    );\n   127\t\n   128\t    // Active nitrification should lower pH relative to control\n   129\t    assert!(\n   130\t        ph_nitrifying < ph_control,\n   131\t        \"Nitrifying tank pH ({ph_nitrifying:.3}) should be lower than control ({ph_control:.3})\"\n   132\t    );\n   133\t\n   134\t    // pH must still be within invariant bounds\n   135\t    assert!((5.5..=8.5).contains(&ph_nitrifying));\n   136\t\n   137\t    Ok(())\n   138\t}\n","exit_code":0,"status":"completed"}}
