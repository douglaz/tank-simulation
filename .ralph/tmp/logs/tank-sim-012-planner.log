{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/src/types/hardware.rs | sed -n '1,120p'\"","aggregated_output":"     1\tuse serde::{Deserialize, Serialize};\n     2\t\n     3\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n     4\tpub struct LightState {\n     5\t    pub enabled: bool,\n     6\t    pub photoperiod_hours: f64,\n     7\t    pub intensity_index: f64,\n     8\t}\n     9\t\n    10\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    11\tpub struct HeaterState {\n    12\t    pub enabled: bool,\n    13\t    pub setpoint_c: f64,\n    14\t    pub deadband_c: f64,\n    15\t    pub max_watts: f64,\n    16\t    pub efficiency: f64,\n    17\t    /// Last computed heater output in watts (0.0 when off or above setpoint).\n    18\t    #[serde(default)]\n    19\t    pub last_output_w: f64,\n    20\t}\n    21\t\n    22\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    23\tpub struct FilterHardware {\n    24\t    pub enabled: bool,\n    25\t    pub flow_lph: f64,\n    26\t    pub cleanliness_index: f64,\n    27\t}\n    28\t\n    29\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    30\tpub struct AerationState {\n    31\t    pub enabled: bool,\n    32\t    pub intensity: f64,\n    33\t}\n    34\t\n    35\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Default)]\n    36\tpub struct HardwareState {\n    37\t    pub light: LightState,\n    38\t    pub heater: HeaterState,\n    39\t    pub filter: FilterHardware,\n    40\t    pub aeration: AerationState,\n    41\t}\n    42\t\n    43\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    44\tpub struct FilterState {\n    45\t    pub biofilter_maturity_index: f64,\n    46\t    pub clogging_index: f64,\n    47\t    pub seeded_biomass_index: f64,\n    48\t}\n    49\t\n    50\timpl Default for LightState {\n    51\t    fn default() -> Self {\n    52\t        Self {\n    53\t            enabled: true,\n    54\t            photoperiod_hours: 8.0,\n    55\t            intensity_index: 0.7,\n    56\t        }\n    57\t    }\n    58\t}\n    59\t\n    60\timpl Default for HeaterState {\n    61\t    fn default() -> Self {\n    62\t        Self {\n    63\t            enabled: false,\n    64\t            setpoint_c: 24.0,\n    65\t            deadband_c: 0.5,\n    66\t            max_watts: 50.0,\n    67\t            efficiency: 1.0,\n    68\t            last_output_w: 0.0,\n    69\t        }\n    70\t    }\n    71\t}\n    72\t\n    73\timpl Default for FilterHardware {\n    74\t    fn default() -> Self {\n    75\t        Self {\n    76\t            enabled: true,\n    77\t            flow_lph: 200.0,\n    78\t            cleanliness_index: 1.0,\n    79\t        }\n    80\t    }\n    81\t}\n    82\t\n    83\timpl Default for AerationState {\n    84\t    fn default() -> Self {\n    85\t        Self {\n    86\t            enabled: false,\n    87\t            intensity: 0.0,\n    88\t        }\n    89\t    }\n    90\t}\n    91\t\n    92\timpl Default for FilterState {\n    93\t    fn default() -> Self {\n    94\t        Self {\n    95\t            biofilter_maturity_index: 0.1,\n    96\t            clogging_index: 0.0,\n    97\t            seeded_biomass_index: 0.0,\n    98\t        }\n    99\t    }\n   100\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/src/systems/water_change.rs | sed -n '1,140p'\"","aggregated_output":"     1\tuse crate::types::{SimError, SourceWaterProfile, TankState};\n     2\t\n     3\t/// Validates that all water change actions in the queue reference known and valid source profiles.\n     4\t/// Returns the first error found, or Ok(()) if all are valid.\n     5\t/// Checks both catalog membership and runtime validity (finite, non-negative chemistry).\n     6\tpub fn validate_water_changes(\n     7\t    state: &TankState,\n     8\t    actions: &[crate::types::PlayerAction],\n     9\t) -> Result<(), SimError> {\n    10\t    for action in actions {\n    11\t        if let crate::types::PlayerAction::WaterChangePercent {\n    12\t            source_profile_id, ..\n    13\t        } = action\n    14\t        {\n    15\t            match state.source_water_catalog.get(source_profile_id) {\n    16\t                None => {\n    17\t                    return Err(SimError::UnknownSourceProfile {\n    18\t                        id: source_profile_id.clone(),\n    19\t                    });\n    20\t                }\n    21\t                Some(profile) => {\n    22\t                    profile.validate(source_profile_id)?;\n    23\t                }\n    24\t            }\n    25\t        }\n    26\t    }\n    27\t    Ok(())\n    28\t}\n    29\t\n    30\t/// Applies a water change: removes `percent/100` of each dissolved total,\n    31\t/// then adds replacement mass from the source-water profile using exchanged liters.\n    32\t/// Also mixes water temperature proportionally by exchanged volume.\n    33\t///\n    34\t/// A 0% water change is a no-op.\n    35\tpub fn apply_water_change(state: &mut TankState, percent: f64, source: &SourceWaterProfile) {\n    36\t    if percent <= 0.0 {\n    37\t        return;\n    38\t    }\n    39\t\n    40\t    let volume_l = state.geometry.water_volume_l();\n    41\t    let fraction = percent / 100.0;\n    42\t    let retention = 1.0 - fraction;\n    43\t    let exchanged_l = volume_l * fraction;\n    44\t\n    45\t    // Remove fraction of each dissolved total\n    46\t    state.water.ammonia_total_mg_n_total *= retention;\n    47\t    state.water.nitrite_mg_n_total *= retention;\n    48\t    state.water.nitrate_mg_n_total *= retention;\n    49\t    state.water.phosphate_mg_p_total *= retention;\n    50\t    state.water.dissolved_inorganic_carbon_mg_c_total *= retention;\n    51\t    state.water.dissolved_organic_carbon_mg_c_total *= retention;\n    52\t    state.water.dissolved_organic_nitrogen_mg_n_total *= retention;\n    53\t    state.water.alkalinity_meq_total *= retention;\n    54\t    state.water.calcium_mg_total *= retention;\n    55\t    state.water.magnesium_mg_total *= retention;\n    56\t    state.water.sodium_mg_total *= retention;\n    57\t    state.water.potassium_mg_total *= retention;\n    58\t    state.water.bicarbonate_mg_total *= retention;\n    59\t    state.water.chloride_mg_total *= retention;\n    60\t    state.water.sulfate_mg_total *= retention;\n    61\t\n    62\t    // Add replacement mass from source water\n    63\t    state.water.ammonia_total_mg_n_total += source.ammonia_mg_n_per_l * exchanged_l;\n    64\t    state.water.nitrite_mg_n_total += source.nitrite_mg_n_per_l * exchanged_l;\n    65\t    state.water.nitrate_mg_n_total += source.nitrate_mg_n_per_l * exchanged_l;\n    66\t    state.water.phosphate_mg_p_total += source.phosphate_mg_p_per_l * exchanged_l;\n    67\t    state.water.dissolved_inorganic_carbon_mg_c_total += source.dic_mg_c_per_l * exchanged_l;\n    68\t    state.water.dissolved_organic_carbon_mg_c_total += source.doc_mg_c_per_l * exchanged_l;\n    69\t    state.water.dissolved_organic_nitrogen_mg_n_total += source.don_mg_n_per_l * exchanged_l;\n    70\t    state.water.alkalinity_meq_total += source.alkalinity_meq_per_l * exchanged_l;\n    71\t    state.water.calcium_mg_total += source.calcium_mg_per_l * exchanged_l;\n    72\t    state.water.magnesium_mg_total += source.magnesium_mg_per_l * exchanged_l;\n    73\t    state.water.sodium_mg_total += source.sodium_mg_per_l * exchanged_l;\n    74\t    state.water.potassium_mg_total += source.potassium_mg_per_l * exchanged_l;\n    75\t    state.water.bicarbonate_mg_total += source.bicarbonate_mg_per_l * exchanged_l;\n    76\t    state.water.chloride_mg_total += source.chloride_mg_per_l * exchanged_l;\n    77\t    state.water.sulfate_mg_total += source.sulfate_mg_per_l * exchanged_l;\n    78\t\n    79\t    // Mix temperature proportionally by exchanged volume\n    80\t    state.water.temperature_c =\n    81\t        state.water.temperature_c * retention + source.temperature_c * fraction;\n    82\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/src/systems/nitrogen_cycle.rs | sed -n '118,390p'\"","aggregated_output":"   118\t\n   119\t    // ---- 4. Nitrification: TAN -> nitrite -> nitrate (+ comammox TAN -> nitrate) ----\n   120\t    //\n   121\t    // Shared DO and alkalinity budgets enforce that combined nitrification\n   122\t    // can never consume more O2 or alkalinity than available this tick.\n   123\t    let env = compute_env_factors(state);\n   124\t    let combined_env = env.maturity_factor * env.dirty_filter_factor * env.filter_enabled_factor;\n   125\t\n   126\t    let mut do_budget = state.water.dissolved_oxygen_mg_total;\n   127\t    let alk_per_mg_n = safe_rate(pp.alkalinity_meq_per_mg_n_nitrified);\n   128\t    let mut alk_budget = state.water.alkalinity_meq_total;\n   129\t\n   130\t    // Stoichiometric O2 costs per mg N for each guild step\n   131\t    let o2_for_aob = 3.43_f64; // TAN -> nitrite\n   132\t    let o2_for_comammox = pp.o2_per_mg_n_nitrified; // TAN -> nitrate (4.57)\n   133\t    let o2_for_nob = 1.14_f64; // nitrite -> nitrate\n   134\t\n   135\t    // 4a. AOB: TAN -> nitrite\n   136\t    let aob_env_factor =\n   137\t        combined_env * env.f_temp * env.f_ph * (do_budget / (do_budget + pp.aob_k_do_mg.max(0.01)));\n   138\t    let aob_potential = monod_rate(\n   139\t        safe_rate(pp.aob_vmax_mg_n_per_g_per_hour) * env.flow_factor,\n   140\t        state.microbe.ammonia_oxidizer_biomass_g,\n   141\t        aob_env_factor,\n   142\t        state.water.ammonia_total_mg_n_total,\n   143\t        pp.aob_k_tan_mg.max(0.01),\n   144\t    );\n   145\t    let aob_rate = safe_rate(aob_potential)\n   146\t        .min(state.water.ammonia_total_mg_n_total)\n   147\t        .min(if o2_for_aob > 0.0 {\n   148\t            do_budget / o2_for_aob\n   149\t        } else {\n   150\t            f64::MAX\n   151\t        })\n   152\t        .min(if alk_per_mg_n > 0.0 {\n   153\t            alk_budget / alk_per_mg_n\n   154\t        } else {\n   155\t            f64::MAX\n   156\t        });\n   157\t\n   158\t    // Debit shared budgets for AOB\n   159\t    let aob_o2_cost = aob_rate * o2_for_aob;\n   160\t    let aob_alk_cost = aob_rate * alk_per_mg_n;\n   161\t    do_budget = (do_budget - aob_o2_cost).max(0.0);\n   162\t    alk_budget = (alk_budget - aob_alk_cost).max(0.0);\n   163\t\n   164\t    // 4b. Comammox: TAN -> nitrate directly (lower vmax)\n   165\t    let comammox_vmax =\n   166\t        safe_rate(pp.aob_vmax_mg_n_per_g_per_hour * pp.comammox_vmax_fraction) * env.flow_factor;\n   167\t    let tan_after_aob = (state.water.ammonia_total_mg_n_total - aob_rate).max(0.0);\n   168\t    let comammox_env_factor = combined_env\n   169\t        * env.f_temp\n   170\t        * env.f_ph\n   171\t        * (do_budget / (do_budget + pp.comammox_k_do_mg.max(0.01)));\n   172\t    let comammox_potential = monod_rate(\n   173\t        comammox_vmax,\n   174\t        state.microbe.comammox_biomass_g,\n   175\t        comammox_env_factor,\n   176\t        tan_after_aob,\n   177\t        pp.comammox_k_tan_mg.max(0.01),\n   178\t    );\n   179\t    let comammox_rate = safe_rate(comammox_potential)\n   180\t        .min(tan_after_aob)\n   181\t        .min(if o2_for_comammox > 0.0 {\n   182\t            do_budget / o2_for_comammox\n   183\t        } else {\n   184\t            f64::MAX\n   185\t        })\n   186\t        .min(if alk_per_mg_n > 0.0 {\n   187\t            alk_budget / alk_per_mg_n\n   188\t        } else {\n   189\t            f64::MAX\n   190\t        });\n   191\t\n   192\t    // Debit shared budgets for comammox\n   193\t    let comammox_o2_cost = comammox_rate * o2_for_comammox;\n   194\t    let comammox_alk_cost = comammox_rate * alk_per_mg_n;\n   195\t    do_budget = (do_budget - comammox_o2_cost).max(0.0);\n   196\t    alk_budget = (alk_budget - comammox_alk_cost).max(0.0);\n   197\t\n   198\t    // Apply AOB + comammox TAN consumption\n   199\t    let total_tan_consumed = aob_rate + comammox_rate;\n   200\t    state.water.ammonia_total_mg_n_total =\n   201\t        (state.water.ammonia_total_mg_n_total - total_tan_consumed).max(0.0);\n   202\t    // AOB produces nitrite\n   203\t    state.water.nitrite_mg_n_total += aob_rate;\n   204\t    // Comammox produces nitrate directly\n   205\t    state.water.nitrate_mg_n_total += comammox_rate;\n   206\t\n   207\t    // Apply O2 costs so far (AOB + comammox) to state\n   208\t    state.water.dissolved_oxygen_mg_total =\n   209\t        (state.water.dissolved_oxygen_mg_total - aob_o2_cost - comammox_o2_cost).max(0.0);\n   210\t\n   211\t    // 4c. NOB: nitrite -> nitrate (uses remaining DO/alk budget)\n   212\t    let nob_env_factor =\n   213\t        combined_env * env.f_temp * env.f_ph * (do_budget / (do_budget + pp.nob_k_do_mg.max(0.01)));\n   214\t    let nob_potential = monod_rate(\n   215\t        safe_rate(pp.nob_vmax_mg_n_per_g_per_hour) * env.flow_factor,\n   216\t        state.microbe.nitrite_oxidizer_biomass_g,\n   217\t        nob_env_factor,\n   218\t        state.water.nitrite_mg_n_total,\n   219\t        pp.nob_k_nitrite_mg.max(0.01),\n   220\t    );\n   221\t    let nob_rate = safe_rate(nob_potential)\n   222\t        .min(state.water.nitrite_mg_n_total)\n   223\t        .min(if o2_for_nob > 0.0 {\n   224\t            do_budget / o2_for_nob\n   225\t        } else {\n   226\t            f64::MAX\n   227\t        })\n   228\t        .min(if alk_per_mg_n > 0.0 {\n   229\t            alk_budget / alk_per_mg_n\n   230\t        } else {\n   231\t            f64::MAX\n   232\t        });\n   233\t\n   234\t    let nob_o2_cost = nob_rate * o2_for_nob;\n   235\t\n   236\t    state.water.nitrite_mg_n_total = (state.water.nitrite_mg_n_total - nob_rate).max(0.0);\n   237\t    state.water.nitrate_mg_n_total += nob_rate;\n   238\t    state.water.dissolved_oxygen_mg_total =\n   239\t        (state.water.dissolved_oxygen_mg_total - nob_o2_cost).max(0.0);\n   240\t\n   241\t    // Total N fully nitrified to nitrate (for alkalinity coupling)\n   242\t    // AOB only takes TAN -> nitrite, NOB takes nitrite -> nitrate, comammox takes TAN -> nitrate\n   243\t    // Full pathway N: nob_rate (came from AOB path) + comammox_rate\n   244\t    let total_mg_n_nitrified = nob_rate + comammox_rate;\n   245\t\n   246\t    // ---- 5. Guild growth and decay ----\n   247\t    // AOB growth from TAN oxidized\n   248\t    let aob_growth = safe_rate(pp.aob_growth_yield) * aob_rate;\n   249\t    let aob_decay =\n   250\t        safe_rate(pp.aob_decay_rate_per_hour) * state.microbe.ammonia_oxidizer_biomass_g;\n   251\t    state.microbe.ammonia_oxidizer_biomass_g =\n   252\t        (state.microbe.ammonia_oxidizer_biomass_g + aob_growth - aob_decay).max(0.0);\n   253\t\n   254\t    // NOB growth from nitrite oxidized\n   255\t    let nob_growth = safe_rate(pp.nob_growth_yield) * nob_rate;\n   256\t    let nob_decay =\n   257\t        safe_rate(pp.nob_decay_rate_per_hour) * state.microbe.nitrite_oxidizer_biomass_g;\n   258\t    state.microbe.nitrite_oxidizer_biomass_g =\n   259\t        (state.microbe.nitrite_oxidizer_biomass_g + nob_growth - nob_decay).max(0.0);\n   260\t\n   261\t    // Comammox growth from TAN fully oxidized\n   262\t    let comammox_growth = safe_rate(pp.comammox_growth_yield) * comammox_rate;\n   263\t    let comammox_decay =\n   264\t        safe_rate(pp.comammox_decay_rate_per_hour) * state.microbe.comammox_biomass_g;\n   265\t    state.microbe.comammox_biomass_g =\n   266\t        (state.microbe.comammox_biomass_g + comammox_growth - comammox_decay).max(0.0);\n   267\t\n   268\t    // ---- 6. Alkalinity consumption from nitrification ----\n   269\t    // AOB and comammox alkalinity was already tracked in the budget; apply the\n   270\t    // total consumption (AOB + comammox + NOB path) to state.\n   271\t    let total_alk_consumed = (aob_rate + comammox_rate + nob_rate) * alk_per_mg_n;\n   272\t    state.water.alkalinity_meq_total =\n   273\t        (state.water.alkalinity_meq_total - total_alk_consumed).max(0.0);\n   274\t\n   275\t    // Nitrification is a chemoautotrophic process that produces some DIC fixation\n   276\t    // but for simplicity we model it as a net DIC producer via mineralization pathway above.\n   277\t\n   278\t    NitrogenCycleOutput {\n   279\t        total_mg_n_nitrified,\n   280\t    }\n   281\t}\n   282\t\n   283\t/// Temperature factor: peaks around 25-30°C, drops off at extremes.\n   284\tfn temperature_factor(temp_c: f64) -> f64 {\n   285\t    // Bell-shaped factor peaking at 28°C with a half-width of ~10°C\n   286\t    let opt = 28.0;\n   287\t    let sigma = 10.0;\n   288\t    let diff = temp_c - opt;\n   289\t    (-(diff * diff) / (2.0 * sigma * sigma)).exp()\n   290\t}\n   291\t\n   292\t/// pH factor: nitrifiers prefer 7-8, reduced at extremes.\n   293\tfn ph_factor(ph: f64) -> f64 {\n   294\t    let opt = 7.5;\n   295\t    let sigma = 1.5;\n   296\t    let diff = ph - opt;\n   297\t    (-(diff * diff) / (2.0 * sigma * sigma)).exp()\n   298\t}\n   299\t\n   300\tfn compute_env_factors(state: &TankState) -> EnvFactors {\n   301\t    let f_temp = temperature_factor(state.water.temperature_c);\n   302\t    let f_ph = ph_factor(state.water.ph);\n   303\t\n   304\t    // Maturity factor: immature filters slow nitrification\n   305\t    let maturity_factor = state.filter_state.biofilter_maturity_index.clamp(0.05, 1.0);\n   306\t\n   307\t    // Dirty-filter factor: clogged filters reduce nitrification efficiency.\n   308\t    // clogging_index of 0 = clean (factor=1), clogging_index of 1 = fully clogged (factor=0.2)\n   309\t    let dirty_filter_factor = (1.0 - 0.8 * state.filter_state.clogging_index).clamp(0.2, 1.0);\n   310\t    let filter_enabled_factor = if state.hardware.filter.enabled {\n   311\t        1.0\n   312\t    } else {\n   313\t        0.1\n   314\t    };\n   315\t    let volume_l = state.geometry.water_volume_l().max(f64::EPSILON);\n   316\t    let flow_factor = if state.hardware.filter.enabled {\n   317\t        (state.hardware.filter.flow_lph / volume_l).clamp(0.1, 1.0)\n   318\t    } else {\n   319\t        1.0\n   320\t    };\n   321\t\n   322\t    EnvFactors {\n   323\t        f_temp,\n   324\t        f_ph,\n   325\t        maturity_factor,\n   326\t        dirty_filter_factor,\n   327\t        filter_enabled_factor,\n   328\t        flow_factor,\n   329\t    }\n   330\t}\n   331\t\n   332\t/// Monod-style rate: vmax * biomass * environmental_factor * S/(K+S)\n   333\tfn monod_rate(\n   334\t    vmax: f64,\n   335\t    biomass_g: f64,\n   336\t    environmental_factor: f64,\n   337\t    substrate: f64,\n   338\t    k_substrate: f64,\n   339\t) -> f64 {\n   340\t    let monod = substrate / (substrate + k_substrate);\n   341\t    safe_rate(vmax * biomass_g * environmental_factor * monod)\n   342\t}\n   343\t\n   344\t/// Daily biofilter maturity update. Called every 24 ticks.\n   345\t/// Recomputes `filter_state.biofilter_maturity_index` from guild biomass.\n   346\tpub fn update_daily_biofilter_maturity(state: &mut TankState) -> f64 {\n   347\t    let prev = state.filter_state.biofilter_maturity_index;\n   348\t\n   349\t    // Capacity reference: a \"mature\" biofilter might have ~0.5g total nitrifier biomass\n   350\t    let capacity_g = 0.5;\n   351\t    let total_nitrifier_g = state.microbe.ammonia_oxidizer_biomass_g\n   352\t        + state.microbe.nitrite_oxidizer_biomass_g\n   353\t        + state.microbe.comammox_biomass_g;\n   354\t    let raw_maturity = (total_nitrifier_g / capacity_g).clamp(0.0, 1.0);\n   355\t\n   356\t    // Smooth towards raw_maturity\n   357\t    let alpha = 0.1;\n   358\t    let new_maturity = (prev + alpha * (raw_maturity - prev)).clamp(0.0, 1.0);\n   359\t    state.filter_state.biofilter_maturity_index = new_maturity;\n   360\t\n   361\t    new_maturity - prev\n   362\t}\n   363\t\n   364\tpub fn update_daily_filter_clogging(state: &mut TankState) -> f64 {\n   365\t    if !state.hardware.filter.enabled {\n   366\t        return 0.0;\n   367\t    }\n   368\t\n   369\t    let volume_l = state.geometry.water_volume_l();\n   370\t    if volume_l <= f64::EPSILON {\n   371\t        return 0.0;\n   372\t    }\n   373\t\n   374\t    let detritus_pressure = (state.detritus.fine_detritus_g_total / volume_l).clamp(0.0, 1.0);\n   375\t    let clogging_delta =\n   376\t        0.002 * (1.0 - state.hardware.filter.cleanliness_index.clamp(0.0, 1.0)) * detritus_pressure;\n   377\t\n   378\t    state.filter_state.clogging_index =\n   379\t        (state.filter_state.clogging_index + clogging_delta).clamp(0.0, 1.0);\n   380\t\n   381\t    clogging_delta\n   382\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/src/systems/chemistry.rs | sed -n '1,120p'\"","aggregated_output":"     1\tuse crate::types::TankState;\n     2\t\n     3\tconst ADULT_SHRIMP_BIOMASS_G: f64 = 0.12;\n     4\tconst JUVENILE_SHRIMP_BIOMASS_G: f64 = 0.05;\n     5\tconst ALKALINITY_FEEDBACK_MEQ_PER_MG_C: f64 = 0.0002;\n     6\t\n     7\tpub fn compute_ph_from_totals(\n     8\t    alkalinity_meq_total: f64,\n     9\t    dissolved_inorganic_carbon_mg_c_total: f64,\n    10\t    volume_l: f64,\n    11\t) -> f64 {\n    12\t    if volume_l <= f64::EPSILON {\n    13\t        return 7.0;\n    14\t    }\n    15\t\n    16\t    let alkalinity_meq_l = alkalinity_meq_total / volume_l;\n    17\t    let dic_mmol_l = (dissolved_inorganic_carbon_mg_c_total / 12.0) / volume_l;\n    18\t\n    19\t    (6.3 + safe_log10(alkalinity_meq_l.max(0.05)) - safe_log10(dic_mmol_l.max(0.02)))\n    20\t        .clamp(5.5, 8.5)\n    21\t}\n    22\t\n    23\tpub fn compute_nh3_mg_l(tan_mg_l: f64, ph: f64, temp_c: f64) -> f64 {\n    24\t    let pka = 0.09018 + 2729.92 / (273.2 + temp_c);\n    25\t    let fraction_nh3 = 1.0 / (1.0 + 10.0_f64.powf(pka - ph));\n    26\t    tan_mg_l * fraction_nh3\n    27\t}\n    28\t\n    29\tpub fn step_hourly_chemistry(state: &mut TankState, light_on: bool) {\n    30\t    let volume_l = state.geometry.water_volume_l();\n    31\t    if volume_l <= f64::EPSILON {\n    32\t        return;\n    33\t    }\n    34\t\n    35\t    let respiration_dic_mg = state\n    36\t        .process_params\n    37\t        .respiration_dic_rate_mg_c_per_g_per_hour\n    38\t        * respiring_biomass_g(state);\n    39\t    let photosynthesis_dic_mg = if light_on {\n    40\t        state\n    41\t            .process_params\n    42\t            .photosynthesis_dic_rate_mg_c_per_g_per_hour\n    43\t            * photosynthetic_biomass_g(state)\n    44\t            * state.hardware.light.intensity_index\n    45\t    } else {\n    46\t        0.0\n    47\t    };\n    48\t    let net_dic_delta_mg = respiration_dic_mg - photosynthesis_dic_mg;\n    49\t\n    50\t    state.water.dissolved_inorganic_carbon_mg_c_total =\n    51\t        (state.water.dissolved_inorganic_carbon_mg_c_total + net_dic_delta_mg).max(0.0);\n    52\t    state.water.alkalinity_meq_total = (state.water.alkalinity_meq_total\n    53\t        - (net_dic_delta_mg * ALKALINITY_FEEDBACK_MEQ_PER_MG_C))\n    54\t        .max(0.0);\n    55\t    state.water.ph = compute_ph_from_totals(\n    56\t        state.water.alkalinity_meq_total,\n    57\t        state.water.dissolved_inorganic_carbon_mg_c_total,\n    58\t        volume_l,\n    59\t    );\n    60\t}\n    61\t\n    62\tpub(crate) fn respiring_biomass_g(state: &TankState) -> f64 {\n    63\t    let plant_biomass_g: f64 = state.plant_guilds.iter().map(|plant| plant.biomass_g).sum();\n    64\t    let algae_biomass_g = state.algae.suspended_biomass_g + state.algae.periphyton_biomass_g;\n    65\t    let microbe_biomass_g = state.microbe.decomposer_biomass_g\n    66\t        + state.microbe.ammonia_oxidizer_biomass_g\n    67\t        + state.microbe.nitrite_oxidizer_biomass_g\n    68\t        + state.microbe.comammox_biomass_g;\n    69\t    let shrimp_biomass_g = (f64::from(state.animal.adults_count) * ADULT_SHRIMP_BIOMASS_G)\n    70\t        + (f64::from(state.animal.juveniles_count) * JUVENILE_SHRIMP_BIOMASS_G);\n    71\t\n    72\t    plant_biomass_g + algae_biomass_g + microbe_biomass_g + shrimp_biomass_g\n    73\t}\n    74\t\n    75\tpub(crate) fn photosynthetic_biomass_g(state: &TankState) -> f64 {\n    76\t    let plant_biomass_g: f64 = state.plant_guilds.iter().map(|plant| plant.biomass_g).sum();\n    77\t    plant_biomass_g + state.algae.periphyton_biomass_g + state.algae.suspended_biomass_g\n    78\t}\n    79\t\n    80\tfn safe_log10(value: f64) -> f64 {\n    81\t    value.max(f64::MIN_POSITIVE).log10()\n    82\t}\n","exit_code":0,"status":"completed"}}
