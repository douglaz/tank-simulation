{"type":"item.completed","item":{"id":"item_66","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/src/systems/water_change.rs | sed -n '1,220p'\"","aggregated_output":"     1\tuse crate::types::{SimError, SourceWaterProfile, TankState};\n     2\t\n     3\t/// Validates that all water change actions in the queue reference known and valid source profiles.\n     4\t/// Returns the first error found, or Ok(()) if all are valid.\n     5\t/// Checks both catalog membership and runtime validity (finite, non-negative chemistry).\n     6\tpub fn validate_water_changes(state: &TankState, actions: &[crate::types::PlayerAction]) -> Result<(), SimError> {\n     7\t    for action in actions {\n     8\t        if let crate::types::PlayerAction::WaterChangePercent {\n     9\t            source_profile_id, ..\n    10\t        } = action\n    11\t        {\n    12\t            match state.source_water_catalog.get(source_profile_id) {\n    13\t                None => {\n    14\t                    return Err(SimError::UnknownSourceProfile {\n    15\t                        id: source_profile_id.clone(),\n    16\t                    });\n    17\t                }\n    18\t                Some(profile) => {\n    19\t                    profile.validate(source_profile_id)?;\n    20\t                }\n    21\t            }\n    22\t        }\n    23\t    }\n    24\t    Ok(())\n    25\t}\n    26\t\n    27\t/// Applies a water change: removes `percent/100` of each dissolved total,\n    28\t/// then adds replacement mass from the source-water profile using exchanged liters.\n    29\t/// Also mixes water temperature proportionally by exchanged volume.\n    30\t///\n    31\t/// A 0% water change is a no-op.\n    32\tpub fn apply_water_change(\n    33\t    state: &mut TankState,\n    34\t    percent: f64,\n    35\t    source: &SourceWaterProfile,\n    36\t) {\n    37\t    if percent <= 0.0 {\n    38\t        return;\n    39\t    }\n    40\t\n    41\t    let volume_l = state.geometry.water_volume_l();\n    42\t    let fraction = percent / 100.0;\n    43\t    let retention = 1.0 - fraction;\n    44\t    let exchanged_l = volume_l * fraction;\n    45\t\n    46\t    // Remove fraction of each dissolved total\n    47\t    state.water.ammonia_total_mg_n_total *= retention;\n    48\t    state.water.nitrite_mg_n_total *= retention;\n    49\t    state.water.nitrate_mg_n_total *= retention;\n    50\t    state.water.phosphate_mg_p_total *= retention;\n    51\t    state.water.dissolved_inorganic_carbon_mg_c_total *= retention;\n    52\t    state.water.dissolved_organic_carbon_mg_c_total *= retention;\n    53\t    state.water.dissolved_organic_nitrogen_mg_n_total *= retention;\n    54\t    state.water.alkalinity_meq_total *= retention;\n    55\t    state.water.calcium_mg_total *= retention;\n    56\t    state.water.magnesium_mg_total *= retention;\n    57\t    state.water.sodium_mg_total *= retention;\n    58\t    state.water.potassium_mg_total *= retention;\n    59\t    state.water.bicarbonate_mg_total *= retention;\n    60\t    state.water.chloride_mg_total *= retention;\n    61\t    state.water.sulfate_mg_total *= retention;\n    62\t\n    63\t    // Add replacement mass from source water\n    64\t    state.water.ammonia_total_mg_n_total += source.ammonia_mg_n_per_l * exchanged_l;\n    65\t    state.water.nitrite_mg_n_total += source.nitrite_mg_n_per_l * exchanged_l;\n    66\t    state.water.nitrate_mg_n_total += source.nitrate_mg_n_per_l * exchanged_l;\n    67\t    state.water.phosphate_mg_p_total += source.phosphate_mg_p_per_l * exchanged_l;\n    68\t    state.water.dissolved_inorganic_carbon_mg_c_total += source.dic_mg_c_per_l * exchanged_l;\n    69\t    state.water.dissolved_organic_carbon_mg_c_total += source.doc_mg_c_per_l * exchanged_l;\n    70\t    state.water.dissolved_organic_nitrogen_mg_n_total += source.don_mg_n_per_l * exchanged_l;\n    71\t    state.water.alkalinity_meq_total += source.alkalinity_meq_per_l * exchanged_l;\n    72\t    state.water.calcium_mg_total += source.calcium_mg_per_l * exchanged_l;\n    73\t    state.water.magnesium_mg_total += source.magnesium_mg_per_l * exchanged_l;\n    74\t    state.water.sodium_mg_total += source.sodium_mg_per_l * exchanged_l;\n    75\t    state.water.potassium_mg_total += source.potassium_mg_per_l * exchanged_l;\n    76\t    state.water.bicarbonate_mg_total += source.bicarbonate_mg_per_l * exchanged_l;\n    77\t    state.water.chloride_mg_total += source.chloride_mg_per_l * exchanged_l;\n    78\t    state.water.sulfate_mg_total += source.sulfate_mg_per_l * exchanged_l;\n    79\t\n    80\t    // Mix temperature proportionally by exchanged volume\n    81\t    state.water.temperature_c = state.water.temperature_c * retention\n    82\t        + source.temperature_c * fraction;\n    83\t}\n","exit_code":0,"status":"completed"}}
