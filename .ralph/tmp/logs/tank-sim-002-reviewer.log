, PLANT_PRESETS)\n    47\t}\n    48\t\n    49\tpub fn load_shrimp(id: &str) -> Result<ShrimpPreset, PresetError> {\n    50\t    load_from_registry(\"shrimp\", id, SHRIMP_PRESETS)\n    51\t}\n    52\t\n    53\tpub fn load_process_params(id: &str) -> Result<ProcessParamsPreset, PresetError> {\n    54\t    load_from_registry(\"process\", id, PROCESS_PRESETS)\n    55\t}\n    56\t\n    57\tpub fn load_scenario(id: &str) -> Result<ScenarioPreset, PresetError> {\n    58\t    load_from_registry(\"scenarios\", id, SCENARIO_PRESETS)\n    59\t}\n    60\t\n    61\tpub fn source_water_ids() -> &'static [&'static str] {\n    62\t    &[\"soft_acidic\", \"moderate\", \"hard_shrimp\", \"ro_like\"]\n    63\t}\n    64\t\n    65\tpub fn substrate_ids() -> &'static [&'static str] {\n    66\t    &[\n    67\t        \"inert_sand\",\n    68\t        \"inert_gravel\",\n    69\t        \"active_planted\",\n    70\t        \"coarse_porous\",\n    71\t    ]\n    72\t}\n    73\t\n    74\tpub fn plant_ids() -> &'static [&'static str] {\n    75\t    &[\"fast_stem\", \"root_rosette\"]\n    76\t}\n    77\t\n    78\tpub fn shrimp_ids() -> &'static [&'static str] {\n    79\t    &[\"neocaridina_davidi\"]\n    80\t}\n    81\t\n    82\tpub fn process_ids() -> &'static [&'static str] {\n    83\t    &[\"default\"]\n    84\t}\n    85\t\n    86\tpub fn scenario_ids() -> &'static [&'static str] {\n    87\t    &[\"nano_cycle\", \"medium_planted\", \"warm_room\"]\n    88\t}\n    89\t\n    90\tfn load_from_registry<T>(\n    91\t    category: &'static str,\n    92\t    id: &str,\n    93\t    registry: &[(&str, &str)],\n    94\t) -> Result<T, PresetError>\n    95\twhere\n    96\t    T: DeserializeOwned,\n    97\t{\n    98\t    let Some((_, raw)) = registry.iter().find(|(entry_id, _)| *entry_id == id) else {\n    99\t        return Err(PresetError::UnknownPreset {\n   100\t            category,\n   101\t            id: id.to_string(),\n   102\t        });\n   103\t    };\n   104\t\n   105\t    toml::from_str(raw).map_err(|error| PresetError::Parse {\n   106\t        category,\n   107\t        id: id.to_string(),\n   108\t        message: error.to_string(),\n   109\t    })\n   110\t}\n   111\t\n   112\tconst SOURCE_WATER_PRESETS: &[(&str, &str)] = &[\n   113\t    (\n   114\t        \"soft_acidic\",\n   115\t        include_str!(\"../data/source_water/soft_acidic.toml\"),\n   116\t    ),\n   117\t    (\n   118\t        \"moderate\",\n   119\t        include_str!(\"../data/source_water/moderate.toml\"),\n   120\t    ),\n   121\t    (\n   122\t        \"hard_shrimp\",\n   123\t        include_str!(\"../data/source_water/hard_shrimp.toml\"),\n   124\t    ),\n   125\t    (\"ro_like\", include_str!(\"../data/source_water/ro_like.toml\")),\n   126\t];\n   127\t\n   128\tconst SUBSTRATE_PRESETS: &[(&str, &str)] = &[\n   129\t    (\n   130\t        \"inert_sand\",\n   131\t        include_str!(\"../data/substrate/inert_sand.toml\"),\n   132\t    ),\n   133\t    (\n   134\t        \"inert_gravel\",\n   135\t        include_str!(\"../data/substrate/inert_gravel.toml\"),\n   136\t    ),\n   137\t    (\n   138\t        \"active_planted\",\n   139\t        include_str!(\"../data/substrate/active_planted.toml\"),\n   140\t    ),\n   141\t    (\n   142\t        \"coarse_porous\",\n   143\t        include_str!(\"../data/substrate/coarse_porous.toml\"),\n   144\t    ),\n   145\t];\n   146\t\n   147\tconst PLANT_PRESETS: &[(&str, &str)] = &[\n   148\t    (\"fast_stem\", include_str!(\"../data/plants/fast_stem.toml\")),\n   149\t    (\n   150\t        \"root_rosette\",\n   151\t        include_str!(\"../data/plants/root_rosette.toml\"),\n   152\t    ),\n   153\t];\n   154\t\n   155\tconst SHRIMP_PRESETS: &[(&str, &str)] = &[(\n   156\t    \"neocaridina_davidi\",\n   157\t    include_str!(\"../data/shrimp/neocaridina_davidi.toml\"),\n   158\t)];\n   159\t\n   160\tconst PROCESS_PRESETS: &[(&str, &str)] =\n   161\t    &[(\"default\", include_str!(\"../data/process/default.toml\"))];\n   162\t\n   163\tconst SCENARIO_PRESETS: &[(&str, &str)] = &[\n   164\t    (\n   165\t        \"nano_cycle\",\n   166\t        include_str!(\"../data/scenarios/nano_cycle.toml\"),\n   167\t    ),\n   168\t    (\n   169\t        \"medium_planted\",\n   170\t        include_str!(\"../data/scenarios/medium_planted.toml\"),\n   171\t    ),\n   172\t    (\n   173\t        \"warm_room\",\n   174\t        include_str!(\"../data/scenarios/warm_room.toml\"),\n   175\t    ),\n   176\t];\n","exit_code":0,"status":"completed"}}
