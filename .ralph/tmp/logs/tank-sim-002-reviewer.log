   } else {\n    52\t            self.wall_area_cm2() / volume_l\n    53\t        }\n    54\t    }\n    55\t\n    56\t    pub fn top_exchange_factor(&self) -> f64 {\n    57\t        if self.open_top {\n    58\t            1.0\n    59\t        } else {\n    60\t            self.lid_exchange_factor.clamp(0.0, 1.0)\n    61\t        }\n    62\t    }\n    63\t}\n    64\t\n    65\timpl Default for TankGeometry {\n    66\t    fn default() -> Self {\n    67\t        Self {\n    68\t            length_cm: 40.0,\n    69\t            width_cm: 25.0,\n    70\t            height_cm: 25.0,\n    71\t            fill_height_cm: 22.0,\n    72\t            glass_thickness_mm: 5.0,\n    73\t            open_top: true,\n    74\t            lid_exchange_factor: DEFAULT_LID_EXCHANGE_FACTOR,\n    75\t        }\n    76\t    }\n    77\t}\n    78\t\n    79\tfn default_lid_exchange_factor() -> f64 {\n    80\t    DEFAULT_LID_EXCHANGE_FACTOR\n    81\t}\n","exit_code":0,"status":"completed"}}
