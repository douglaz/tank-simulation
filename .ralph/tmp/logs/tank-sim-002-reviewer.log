ore_mg_p_total: 10.0,\n    84\t                cation_exchange_capacity_index: 0.8,\n    85\t                detritus_trapping_index: 0.4,\n    86\t                colonizable_area_cm2: 400.0,\n    87\t                low_oxygen_tendency_index: 0.5,\n    88\t                grazing_surface_index: 0.5,\n    89\t            },\n    90\t            SubstrateLayerState {\n    91\t                kind: SubstrateKind::CoarsePorous,\n    92\t                depth_cm: 1.0,\n    93\t                nutrient_store_mg_n_total: 5.0,\n    94\t                nutrient_store_mg_p_total: 1.0,\n    95\t                cation_exchange_capacity_index: 0.2,\n    96\t                detritus_trapping_index: 0.6,\n    97\t                colonizable_area_cm2: 250.0,\n    98\t                low_oxygen_tendency_index: 0.6,\n    99\t                grazing_surface_index: 0.7,\n   100\t            },\n   101\t        ];\n   102\t        state\n   103\t    }\n   104\t}\n   105\t\n   106\timpl Default for SimMeta {\n   107\t    fn default() -> Self {\n   108\t        Self {\n   109\t            scenario_id: None,\n   110\t            notes: None,\n   111\t        }\n   112\t    }\n   113\t}\n   114\t\n   115\timpl Default for TankState {\n   116\t    fn default() -> Self {\n   117\t        Self::new(SimSeed(0))\n   118\t    }\n   119\t}\n","exit_code":0,"status":"completed"}}
