elf.phosphate_mg_p_per_l),\n    43\t            (\"dic_mg_c_per_l\", self.dic_mg_c_per_l),\n    44\t            (\"doc_mg_c_per_l\", self.doc_mg_c_per_l),\n    45\t            (\"don_mg_n_per_l\", self.don_mg_n_per_l),\n    46\t            (\"alkalinity_meq_per_l\", self.alkalinity_meq_per_l),\n    47\t            (\"calcium_mg_per_l\", self.calcium_mg_per_l),\n    48\t            (\"magnesium_mg_per_l\", self.magnesium_mg_per_l),\n    49\t            (\"sodium_mg_per_l\", self.sodium_mg_per_l),\n    50\t            (\"potassium_mg_per_l\", self.potassium_mg_per_l),\n    51\t            (\"bicarbonate_mg_per_l\", self.bicarbonate_mg_per_l),\n    52\t            (\"chloride_mg_per_l\", self.chloride_mg_per_l),\n    53\t            (\"sulfate_mg_per_l\", self.sulfate_mg_per_l),\n    54\t        ];\n    55\t        for (name, value) in fields {\n    56\t            if !value.is_finite() {\n    57\t                return Err(format!(\"field `{name}` must be finite, got {value}\"));\n    58\t            }\n    59\t            if *value < 0.0 {\n    60\t                return Err(format!(\"field `{name}` must be non-negative, got {value}\"));\n    61\t            }\n    62\t        }\n    63\t        Ok(())\n    64\t    }\n    65\t}\n    66\t\n    67\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    68\tpub struct SubstratePreset {\n    69\t    pub id: String,\n    70\t    pub name: String,\n    71\t    pub depth_cm: f64,\n    72\t    pub cation_exchange_capacity_index: f64,\n    73\t    pub detritus_trapping_index: f64,\n    74\t    pub colonizable_area_factor: f64,\n    75\t    pub low_oxygen_tendency_index: f64,\n    76\t    pub grazing_surface_index: f64,\n    77\t    pub nutrient_charge_mg_n_total: f64,\n    78\t    pub nutrient_charge_mg_p_total: f64,\n    79\t    pub provenance: Option<Provenance>,\n    80\t}\n    81\t\n    82\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    83\tpub struct PlantPreset {\n    84\t    pub id: String,\n    85\t    pub name: String,\n    86\t    pub guild: String,\n    87\t    pub growth_rate_index: f64,\n    88\t    pub water_column_uptake_bias: f64,\n    89\t    pub substrate_uptake_bias: f64,\n    90\t    pub provenance: Option<Provenance>,\n    91\t}\n    92\t\n    93\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    94\tpub struct ShrimpPreset {\n    95\t    pub id: String,\n    96\t    pub name: String,\n    97\t    pub species: String,\n    98\t    pub optimal_temp_min_c: f64,\n    99\t    pub optimal_temp_max_c: f64,\n   100\t    pub gh_min_d: f64,\n   101\t    pub gh_max_d: f64,\n   102\t    pub provenance: Option<Provenance>,\n   103\t}\n   104\t\n   105\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n   106\tpub struct ProcessParamsPreset {\n   107\t    pub id: String,\n   108\t    pub name: String,\n   109\t    pub mineralization_rate_per_day: f64,\n   110\t    pub nitrification_vmax: f64,\n   111\t    pub reaeration_kla: f64,\n   112\t    pub k_surface_w_per_m2_k: f64,\n   113\t    pub k_wall_w_per_m2_k: f64,\n   114\t    pub provenance: Option<Provenance>,\n   115\t}\n   116\t\n   117\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n   118\tpub struct ScenarioPreset {\n   119\t    pub id: String,\n   120\t    pub name: String,\n   121\t    pub source_water_id: String,\n   122\t    pub substrate_ids: Vec<String>,\n   123\t    pub plant_ids: Vec<String>,\n   124\t    pub shrimp_profile_id: String,\n   125\t    pub process_params_id: String,\n   126\t    pub tank_length_cm: f64,\n   127\t    pub tank_width_cm: f64,\n   128\t    pub tank_height_cm: f64,\n   129\t    pub fill_height_cm: f64,\n   130\t    pub ambient_temp_c: f64,\n   131\t    pub provenance: Option<Provenance>,\n   132\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_69","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_scenarios/src/lib.rs | sed -n '1,240p'\"","aggregated_output":"     1\tuse std::collections::BTreeMap;\n     2\t\n     3\tuse tank_core::{\n     4\t    PlantGuild, PlantGuildState, ProcessParams, SimMeta, SimSeed, SourceWaterProfile,\n     5\t    SubstrateLayerState, TankGeometry, TankState, WaterState,\n     6\t};\n     7\tuse tank_data::{load_scenario, ScenarioPreset};\n     8\t\n     9\tpub fn default_scenario_ids() -> &'static [&'static str] {\n    10\t    tank_data::scenario_ids()\n    11\t}\n    12\t\n    13\tpub fn load_named_scenario(id: &str) -> Result<ScenarioPreset, tank_data::PresetError> {\n    14\t    load_scenario(id)\n    15\t}\n    16\t\n    17\t/// Converts a `tank_data::SourceWaterPreset` into a `tank_core::SourceWaterProfile`.\n    18\tfn source_water_to_profile(preset: &tank_data::SourceWaterPreset) -> SourceWaterProfile {\n    19\t    SourceWaterProfile {\n    20\t        temperature_c: preset.temperature_c,\n    21\t        ammonia_mg_n_per_l: preset.ammonia_mg_n_per_l,\n    22\t        nitrite_mg_n_per_l: preset.nitrite_mg_n_per_l,\n    23\t        nitrate_mg_n_per_l: preset.nitrate_mg_n_per_l,\n    24\t        phosphate_mg_p_per_l: preset.phosphate_mg_p_per_l,\n    25\t        dic_mg_c_per_l: preset.dic_mg_c_per_l,\n    26\t        doc_mg_c_per_l: preset.doc_mg_c_per_l,\n    27\t        don_mg_n_per_l: preset.don_mg_n_per_l,\n    28\t        alkalinity_meq_per_l: preset.alkalinity_meq_per_l,\n    29\t        calcium_mg_per_l: preset.calcium_mg_per_l,\n    30\t        magnesium_mg_per_l: preset.magnesium_mg_per_l,\n    31\t        sodium_mg_per_l: preset.sodium_mg_per_l,\n    32\t        potassium_mg_per_l: preset.potassium_mg_per_l,\n    33\t        bicarbonate_mg_per_l: preset.bicarbonate_mg_per_l,\n    34\t        chloride_mg_per_l: preset.chloride_mg_per_l,\n    35\t        sulfate_mg_per_l: preset.sulfate_mg_per_l,\n    36\t    }\n    37\t}\n    38\t\n    39\t/// Converts a `tank_data::ProcessParamsPreset` into `tank_core::ProcessParams`.\n    40\tfn process_preset_to_params(preset: &tank_data::ProcessParamsPreset) -> ProcessParams {\n    41\t    ProcessParams {\n    42\t        mineralization_rate_per_day: preset.mineralization_rate_per_day,\n    43\t        nitrification_vmax: preset.nitrification_vmax,\n    44\t        reaeration_kla: preset.reaeration_kla,\n    45\t        k_surface_w_per_m2_k: preset.k_surface_w_per_m2_k,\n    46\t        k_wall_w_per_m2_k: preset.k_wall_w_per_m2_k,\n    47\t    }\n    48\t}\n    49\t\n    50\t/// Materializes a scenario preset into a fully resolved `TankState`.\n    51\t///\n    52\t/// - Geometry comes from the scenario.\n    53\t/// - `environment.ambient_temp_c` comes from the scenario.\n    54\t/// - Initial `WaterState` totals come from the source-water profile × fill volume.\n    55\t/// - Substrate layers come from the scenario's substrate preset IDs.\n    56\t/// - Plant guilds come from the scenario's plant preset IDs.\n    57\t/// - Source-water catalog is populated with all known source-water presets.\n    58\t/// - Process parameters come from the scenario's process params preset.\n    59\tpub fn seeded_state(seed: SimSeed, scenario_id: &str) -> Result<TankState, tank_data::PresetError> {\n    60\t    let scenario = load_named_scenario(scenario_id)?;\n    61\t\n    62\t    // Geometry\n    63\t    let geometry = TankGeometry {\n    64\t        length_cm: scenario.tank_length_cm,\n    65\t        width_cm: scenario.tank_width_cm,\n    66\t        height_cm: scenario.tank_height_cm,\n    67\t        fill_height_cm: scenario.fill_height_cm,\n    68\t        glass_thickness_mm: 5.0,\n    69\t        open_top: true,\n    70\t        lid_exchange_factor: 0.25,\n    71\t    };\n    72\t\n    73\t    // Source water profile for initial fill\n    74\t    let source_water_preset = tank_data::load_source_water(&scenario.source_water_id)?;\n    75\t    let source_profile = source_water_to_profile(&source_water_preset);\n    76\t\n    77\t    // Initial water state from source-water profile\n    78\t    let water = WaterState::from_source_profile(&source_profile, &geometry);\n    79\t\n    80\t    // Build source-water catalog with all known presets\n    81\t    let mut source_water_catalog = BTreeMap::new();\n    82\t    for sw_id in tank_data::source_water_ids() {\n    83\t        let sw_preset = tank_data::load_source_water(sw_id)?;\n    84\t        source_water_catalog.insert(sw_id.to_string(), source_water_to_profile(&sw_preset));\n    85\t    }\n    86\t\n    87\t    // Process parameters\n    88\t    let process_preset = tank_data::load_process_params(&scenario.process_params_id)?;\n    89\t    let process_params = process_preset_to_params(&process_preset);\n    90\t\n    91\t    // Substrate layers\n    92\t    let mut substrate_layers = Vec::new();\n    93\t    for sub_id in &scenario.substrate_ids {\n    94\t        let sub_preset = tank_data::load_substrate(sub_id)?;\n    95\t        let footprint = geometry.footprint_area_cm2();\n    96\t        substrate_layers.push(SubstrateLayerState {\n    97\t            kind: match sub_preset.id.as_str() {\n    98\t                \"inert_sand\" => tank_core::SubstrateKind::InertSand,\n    99\t                \"inert_gravel\" => tank_core::SubstrateKind::InertGravel,\n   100\t                \"active_planted\" => tank_core::SubstrateKind::ActivePlanted,\n   101\t                \"coarse_porous\" => tank_core::SubstrateKind::CoarsePorous,\n   102\t                other => {\n   103\t                    return Err(tank_data::PresetError::Validation {\n   104\t                        category: \"substrate\",\n   105\t                        id: other.to_string(),\n   106\t                        message: format!(\"unsupported substrate kind: `{other}`\"),\n   107\t                    });\n   108\t                }\n   109\t            },\n   110\t            depth_cm: sub_preset.depth_cm,\n   111\t            nutrient_store_mg_n_total: sub_preset.nutrient_charge_mg_n_total,\n   112\t            nutrient_store_mg_p_total: sub_preset.nutrient_charge_mg_p_total,\n   113\t            cation_exchange_capacity_index: sub_preset.cation_exchange_capacity_index,\n   114\t            detritus_trapping_index: sub_preset.detritus_trapping_index,\n   115\t            colonizable_area_cm2: footprint * sub_preset.colonizable_area_factor,\n   116\t            low_oxygen_tendency_index: sub_preset.low_oxygen_tendency_index,\n   117\t            grazing_surface_index: sub_preset.grazing_surface_index,\n   118\t        });\n   119\t    }\n   120\t    if substrate_layers.is_empty() {\n   121\t        substrate_layers.push(SubstrateLayerState::default());\n   122\t    }\n   123\t\n   124\t    // Plant guilds\n   125\t    let mut plant_guilds = Vec::new();\n   126\t    for plant_id in &scenario.plant_ids {\n   127\t        let plant_preset = tank_data::load_plant(plant_id)?;\n   128\t        let guild = match plant_preset.guild.as_str() {\n   129\t            \"FastStem\" => PlantGuild::FastStem,\n   130\t            \"RootFeedingRosette\" => PlantGuild::RootFeedingRosette,\n   131\t            other => {\n   132\t                return Err(tank_data::PresetError::Validation {\n   133\t                    category: \"plants\",\n   134\t                    id: plant_id.clone(),\n   135\t                    message: format!(\"unsupported plant guild: `{other}`\"),\n   136\t                });\n   137\t            }\n   138\t        };\n   139\t        plant_guilds.push(PlantGuildState {\n   140\t            guild,\n   141\t            biomass_g: 5.0,\n   142\t            health_index: 0.8,\n   143\t            crowding_index: 0.1,\n   144\t            habitat_index: if guild == PlantGuild::RootFeedingRosette {\n   145\t                // Habitat factor depends on substrate quality\n   146\t                substrate_layers\n   147\t                    .iter()\n   148\t                    .map(|l| l.cation_exchange_capacity_index)\n   149\t                    .fold(0.0_f64, f64::max)\n   150\t                    .max(0.3)\n   151\t            } else {\n   152\t                0.8\n   153\t            },\n   154\t        });\n   155\t    }\n   156\t    if plant_guilds.is_empty() {\n   157\t        plant_guilds.push(PlantGuildState::default());\n   158\t    }\n   159\t\n   160\t    // Environment\n   161\t    let mut environment = tank_core::EnvironmentState::default();\n   162\t    environment.ambient_temp_c = scenario.ambient_temp_c;\n   163\t\n   164\t    let mut state = TankState::new(seed);\n   165\t    state.meta = SimMeta {\n   166\t        scenario_id: Some(scenario.id),\n   167\t        notes: Some(scenario.name),\n   168\t    };\n   169\t    state.geometry = geometry;\n   170\t    state.environment = environment;\n   171\t    state.water = water;\n   172\t    state.substrate_layers = substrate_layers;\n   173\t    state.plant_guilds = plant_guilds;\n   174\t    state.source_water_catalog = source_water_catalog;\n   175\t    state.process_params = process_params;\n   176\t\n   177\t    Ok(state)\n   178\t}\n","exit_code":0,"status":"completed"}}
