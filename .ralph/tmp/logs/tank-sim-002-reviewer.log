t.hour_of_day + 1) % 24;\n    50\t        if self.state.environment.hour_of_day == 0 {\n    51\t            self.state.environment.day += 1;\n    52\t        }\n    53\t\n    54\t        enforce_invariants(&mut self.state)\n    55\t    }\n    56\t\n    57\t    fn process_action(&mut self, action: PlayerAction) {\n    58\t        match action {\n    59\t            PlayerAction::Feed { grams } => {\n    60\t                self.state.detritus.particulate_organics_g_total += grams;\n    61\t                self.push_event(\n    62\t                    EventSeverity::Info,\n    63\t                    EventKind::CycleProgressing,\n    64\t                    vec![EventCause::Overfeeding],\n    65\t                    format!(\"Queued feed processed: {grams:.2} g\"),\n    66\t                );\n    67\t            }\n    68\t            PlayerAction::WaterChangePercent { percent, .. } => {\n    69\t                let retention = 1.0 - (percent / 100.0);\n    70\t                self.state.water.ammonia_total_mg_n_total *= retention;\n    71\t                self.state.water.nitrite_mg_n_total *= retention;\n    72\t                self.state.water.nitrate_mg_n_total *= retention;\n    73\t                self.state.water.phosphate_mg_p_total *= retention;\n    74\t                self.state.water.dissolved_inorganic_carbon_mg_c_total *= retention;\n    75\t                self.state.water.dissolved_organic_carbon_mg_c_total *= retention;\n    76\t                self.state.water.dissolved_organic_nitrogen_mg_n_total *= retention;\n    77\t                self.state.water.alkalinity_meq_total *= retention;\n    78\t                self.state.water.calcium_mg_total *= retention;\n    79\t                self.state.water.magnesium_mg_total *= retention;\n    80\t                self.state.water.sodium_mg_total *= retention;\n    81\t                self.state.water.potassium_mg_total *= retention;\n    82\t                self.state.water.bicarbonate_mg_total *= retention;\n    83\t                self.state.water.chloride_mg_total *= retention;\n    84\t                self.state.water.sulfate_mg_total *= retention;\n    85\t                self.push_event(\n    86\t                    EventSeverity::Info,\n    87\t                    EventKind::StabilityImproving,\n    88\t                    vec![EventCause::WaterChange],\n    89\t                    format!(\"Queued water change processed: {percent:.1}%\"),\n    90\t                );\n    91\t            }\n    92\t            PlayerAction::TrimPlants { fraction } => {\n    93\t                for plant in &mut self.state.plant_guilds {\n    94\t                    plant.biomass_g *= 1.0 - fraction;\n    95\t                }\n    96\t            }\n    97\t            PlayerAction::SiphonDetritus { fraction } => {\n    98\t                self.state.detritus.particulate_organics_g_total *= 1.0 - fraction;\n    99\t                self.state.detritus.fine_detritus_g_total *= 1.0 - fraction;\n   100\t            }\n   101\t            PlayerAction::CleanFilter { intensity } => {\n   102\t                self.state.hardware.filter.cleanliness_index = 1.0;\n   103\t                self.state.filter_state.biofilter_maturity_index *= 1.0 - (intensity * 0.5);\n   104\t                self.state.filter_state.clogging_index *= 1.0 - intensity;\n   105\t                self.push_event(\n   106\t                    EventSeverity::Warning,\n   107\t                    EventKind::FilterCleaningSetback,\n   108\t                    vec![EventCause::FilterMaintenance],\n   109\t                    format!(\"Filter cleaned at intensity {intensity:.2}\"),\n   110\t                );\n   111\t            }\n   112\t            PlayerAction::AddShrimp { count } => {\n   113\t                self.state.animal.adults_count =\n   114\t                    self.state.animal.adults_count.saturating_add(count);\n   115\t            }\n   116\t            PlayerAction::RemoveShrimp { count } => {\n   117\t                self.state.animal.adults_count =\n   118\t                    self.state.animal.adults_count.saturating_sub(count);\n   119\t            }\n   120\t            PlayerAction::ChangePhotoperiod { hours } => {\n   121\t                self.state.hardware.light.photoperiod_hours = hours;\n   122\t            }\n   123\t            PlayerAction::ChangeLightIntensity { intensity_index } => {\n   124\t                self.state.hardware.light.intensity_index = intensity_index;\n   125\t            }\n   126\t            PlayerAction::ChangeHeaterSetpoint { setpoint_c } => {\n   127\t                self.state.hardware.heater.setpoint_c = setpoint_c;\n   128\t            }\n   129\t            PlayerAction::ChangeAmbientTemperature { target_c } => {\n   130\t                self.state.environment.ambient_temp_c = target_c;\n   131\t            }\n   132\t            PlayerAction::ChangeAeration { enabled, intensity } => {\n   133\t                self.state.hardware.aeration.enabled = enabled;\n   134\t                self.state.hardware.aeration.intensity = intensity;\n   135\t            }\n   136\t        }\n   137\t    }\n   138\t\n   139\t    fn push_event(\n   140\t        &mut self,\n   141\t        severity: EventSeverity,\n   142\t        kind: EventKind,\n   143\t        cause_codes: Vec<EventCause>,\n   144\t        summary: String,\n   145\t    ) {\n   146\t        self.state.event_log.push(SimEvent::new(\n   147\t            self.state.environment.day,\n   148\t            self.state.environment.hour_of_day,\n   149\t            severity,\n   150\t            kind,\n   151\t            cause_codes,\n   152\t            summary,\n   153\t        ));\n   154\t    }\n   155\t}\n   156\t\n   157\timpl SimulationEngine for Engine {\n   158\t    fn apply_action(&mut self, action: PlayerAction) -> Result<(), SimError> {\n   159\t        action.validate()?;\n   160\t        self.queued_actions.push_back(action);\n   161\t        Ok(())\n   162\t    