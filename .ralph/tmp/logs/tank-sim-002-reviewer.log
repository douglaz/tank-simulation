_per_l * volume_l,\n    70\t            bicarbonate_mg_total: profile.bicarbonate_mg_per_l * volume_l,\n    71\t            chloride_mg_total: profile.chloride_mg_per_l * volume_l,\n    72\t            sulfate_mg_total: profile.sulfate_mg_per_l * volume_l,\n    73\t        }\n    74\t    }\n    75\t\n    76\t    pub fn total_tracked_ions_mg(&self) -> f64 {\n    77\t        self.calcium_mg_total\n    78\t            + self.magnesium_mg_total\n    79\t            + self.sodium_mg_total\n    80\t            + self.potassium_mg_total\n    81\t            + self.bicarbonate_mg_total\n    82\t            + self.chloride_mg_total\n    83\t            + self.sulfate_mg_total\n    84\t    }\n    85\t}\n    86\t\n    87\timpl Default for WaterState {\n    88\t    fn default() -> Self {\n    89\t        Self::default_for_geometry(&TankGeometry::default())\n    90\t    }\n    91\t}\n","exit_code":0,"status":"completed"}}
