{"type":"item.completed","item":{"id":"item_76","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/tests/save_load.rs | sed -n '1,220p'\"","aggregated_output":"     1\tuse tank_core::{\n     2\t    Engine, PlayerAction, ProcessParams, SaveFile, SimSeed, SimulationEngine, SourceWaterProfile,\n     3\t    TankState,\n     4\t};\n     5\t\n     6\t#[test]\n     7\tfn save_load_roundtrip() -> Result<(), tank_core::SimError> {\n     8\t    let mut engine = Engine::new(SimSeed(42));\n     9\t    engine.apply_action(PlayerAction::Feed { grams: 1.25 })?;\n    10\t    engine.apply_action(PlayerAction::ChangeAmbientTemperature { target_c: 25.5 })?;\n    11\t    engine.step_hours(1)?;\n    12\t    engine.apply_action(PlayerAction::ChangeLightIntensity {\n    13\t        intensity_index: 0.6,\n    14\t    })?;\n    15\t\n    16\t    let save = SaveFile::from_engine(&engine);\n    17\t    let json = save.to_json_pretty()?;\n    18\t    let restored = SaveFile::from_json(&json)?;\n    19\t    let restored_engine = restored.clone().into_engine();\n    20\t\n    21\t    assert_eq!(save, restored);\n    22\t    assert_eq!(engine.full_state(), restored_engine.full_state());\n    23\t    assert_eq!(engine.queued_actions(), restored_engine.queued_actions());\n    24\t\n    25\t    Ok(())\n    26\t}\n    27\t\n    28\t#[test]\n    29\tfn save_load_with_source_water_catalog() -> Result<(), tank_core::SimError> {\n    30\t    let mut state = TankState::new(SimSeed(42));\n    31\t    state\n    32\t        .source_water_catalog\n    33\t        .insert(\"ro_like\".to_string(), SourceWaterProfile::zero());\n    34\t    state.source_water_catalog.insert(\n    35\t        \"custom\".to_string(),\n    36\t        SourceWaterProfile {\n    37\t            temperature_c: 25.0,\n    38\t            ammonia_mg_n_per_l: 0.0,\n    39\t            nitrite_mg_n_per_l: 0.0,\n    40\t            nitrate_mg_n_per_l: 10.0,\n    41\t            phosphate_mg_p_per_l: 0.5,\n    42\t            dic_mg_c_per_l: 15.0,\n    43\t            doc_mg_c_per_l: 0.0,\n    44\t            don_mg_n_per_l: 0.0,\n    45\t            alkalinity_meq_per_l: 2.0,\n    46\t            calcium_mg_per_l: 30.0,\n    47\t            magnesium_mg_per_l: 8.0,\n    48\t            sodium_mg_per_l: 12.0,\n    49\t            potassium_mg_per_l: 3.0,\n    50\t            bicarbonate_mg_per_l: 80.0,\n    51\t            chloride_mg_per_l: 15.0,\n    52\t            sulfate_mg_per_l: 10.0,\n    53\t        },\n    54\t    );\n    55\t    state.process_params = ProcessParams {\n    56\t        mineralization_rate_per_day: 0.2,\n    57\t        nitrification_vmax: 0.1,\n    58\t        reaeration_kla: 0.5,\n    59\t        k_surface_w_per_m2_k: 12.0,\n    60\t        k_wall_w_per_m2_k: 6.0,\n    61\t    };\n    62\t\n    63\t    let mut engine = Engine::from_parts(state, vec![]);\n    64\t    engine.step_hours(1)?;\n    65\t\n    66\t    let save = SaveFile::from_engine(&engine);\n    67\t    let json = save.to_json_pretty()?;\n    68\t    let restored = SaveFile::from_json(&json)?;\n    69\t    let restored_engine = restored.into_engine();\n    70\t\n    71\t    // Source water catalog and process params must survive roundtrip\n    72\t    assert_eq!(\n    73\t        engine.full_state().source_water_catalog,\n    74\t        restored_engine.full_state().source_water_catalog\n    75\t    );\n    76\t    assert_eq!(\n    77\t        engine.full_state().process_params,\n    78\t        restored_engine.full_state().process_params\n    79\t    );\n    80\t    assert_eq!(\n    81\t        engine.full_state().hardware.heater.last_output_w,\n    82\t        restored_engine.full_state().hardware.heater.last_output_w\n    83\t    );\n    84\t    assert_eq!(engine.full_state(), restored_engine.full_state());\n    85\t\n    86\t    Ok(())\n    87\t}\n    88\t\n    89\t#[test]\n    90\tfn save_load_resume_determinism() -> Result<(), tank_core::SimError> {\n    91\t    // Run 240 hours, save, load, run 480 more vs uninterrupted 720\n    92\t    let mut engine_continuous = Engine::new(SimSeed(77));\n    93\t    engine_continuous.step_hours(720)?;\n    94\t\n    95\t    let mut engine_split = Engine::new(SimSeed(77));\n    96\t    engine_split.step_hours(240)?;\n    97\t\n    98\t    let save = SaveFile::from_engine(&engine_split);\n    99\t    let json = save.to_json_pretty()?;\n   100\t    let restored = SaveFile::from_json(&json)?;\n   101\t    let mut engine_resumed = restored.into_engine();\n   102\t    engine_resumed.step_hours(480)?;\n   103\t\n   104\t    assert_eq!(\n   105\t        engine_continuous.full_state(),\n   106\t        engine_resumed.full_state(),\n   107\t        \"Save/load/resume must produce identical state to uninterrupted run\"\n   108\t    );\n   109\t\n   110\t    Ok(())\n   111\t}\n","exit_code":0,"status":"completed"}}
