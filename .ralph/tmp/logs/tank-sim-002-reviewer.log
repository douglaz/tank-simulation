_l),\n    38\t            (\"doc_mg_c_per_l\", self.doc_mg_c_per_l),\n    39\t            (\"don_mg_n_per_l\", self.don_mg_n_per_l),\n    40\t            (\"alkalinity_meq_per_l\", self.alkalinity_meq_per_l),\n    41\t            (\"calcium_mg_per_l\", self.calcium_mg_per_l),\n    42\t            (\"magnesium_mg_per_l\", self.magnesium_mg_per_l),\n    43\t            (\"sodium_mg_per_l\", self.sodium_mg_per_l),\n    44\t            (\"potassium_mg_per_l\", self.potassium_mg_per_l),\n    45\t            (\"bicarbonate_mg_per_l\", self.bicarbonate_mg_per_l),\n    46\t            (\"chloride_mg_per_l\", self.chloride_mg_per_l),\n    47\t            (\"sulfate_mg_per_l\", self.sulfate_mg_per_l),\n    48\t        ];\n    49\t        for &(field, value) in fields {\n    50\t            if !value.is_finite() || value < 0.0 {\n    51\t                return Err(SimError::InvalidSourceProfile {\n    52\t                    id: profile_id.to_string(),\n    53\t                    field,\n    54\t                    value,\n    55\t                });\n    56\t            }\n    57\t        }\n    58\t        if !self.temperature_c.is_finite() || self.temperature_c <= 0.0 {\n    59\t            return Err(SimError::InvalidSourceProfile {\n    60\t                id: profile_id.to_string(),\n    61\t                field: \"temperature_c\",\n    62\t                value: self.temperature_c,\n    63\t            });\n    64\t        }\n    65\t        Ok(())\n    66\t    }\n    67\t\n    68\t    /// Creates a zero-nutrient profile (equivalent to pure RO water).\n    69\t    pub fn zero() -> Self {\n    70\t        Self {\n    71\t            temperature_c: 23.0,\n    72\t            ammonia_mg_n_per_l: 0.0,\n    73\t            nitrite_mg_n_per_l: 0.0,\n    74\t            nitrate_mg_n_per_l: 0.0,\n    75\t            phosphate_mg_p_per_l: 0.0,\n    76\t            dic_mg_c_per_l: 0.0,\n    77\t            doc_mg_c_per_l: 0.0,\n    78\t            don_mg_n_per_l: 0.0,\n    79\t            alkalinity_meq_per_l: 0.0,\n    80\t            calcium_mg_per_l: 0.0,\n    81\t            magnesium_mg_per_l: 0.0,\n    82\t            sodium_mg_per_l: 0.0,\n    83\t            potassium_mg_per_l: 0.0,\n    84\t            bicarbonate_mg_per_l: 0.0,\n    85\t            chloride_mg_per_l: 0.0,\n    86\t            sulfate_mg_per_l: 0.0,\n    87\t        }\n    88\t    }\n    89\t}\n","exit_code":0,"status":"completed"}}
