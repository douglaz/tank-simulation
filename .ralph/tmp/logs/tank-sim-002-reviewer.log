{"type":"item.completed","item":{"id":"item_77","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/tests/tank_size_thermal_response.rs | sed -n '1,220p'\"","aggregated_output":"     1\tuse tank_core::{\n     2\t    Engine, PlayerAction, ProcessParams, SimSeed, SimulationEngine, TankGeometry, TankState,\n     3\t};\n     4\t\n     5\t/// Build a state with a specific volume (adjusting geometry) and initial conditions.\n     6\tfn state_with_volume(seed: SimSeed, target_volume_l: f64) -> TankState {\n     7\t    let mut state = TankState::new(seed);\n     8\t\n     9\t    // Compute geometry: keep square footprint, adjust fill height\n    10\t    // For a 10L tank: e.g., 20×20cm footprint, fill_height = 10L * 1000 / (20*20) = 25cm\n    11\t    // For a 100L tank: e.g., 50×40cm footprint, fill_height = 100L * 1000 / (50*40) = 50cm\n    12\t    let (length, width, fill_h) = if target_volume_l <= 20.0 {\n    13\t        let side = 20.0;\n    14\t        let fill = target_volume_l * 1000.0 / (side * side);\n    15\t        (side, side, fill)\n    16\t    } else {\n    17\t        let length = 50.0;\n    18\t        let width = 40.0;\n    19\t        let fill = target_volume_l * 1000.0 / (length * width);\n    20\t        (length, width, fill)\n    21\t    };\n    22\t\n    23\t    state.geometry = TankGeometry {\n    24\t        length_cm: length,\n    25\t        width_cm: width,\n    26\t        height_cm: fill_h + 5.0,\n    27\t        fill_height_cm: fill_h,\n    28\t        glass_thickness_mm: 5.0,\n    29\t        open_top: true,\n    30\t        lid_exchange_factor: 0.25,\n    31\t    };\n    32\t\n    33\t    // Re-initialize water for new geometry\n    34\t    state.water = tank_core::WaterState::default_for_geometry(&state.geometry);\n    35\t    state.water.temperature_c = 24.0;\n    36\t    state.environment.ambient_temp_c = 24.0;\n    37\t    state.hardware.heater.enabled = false;\n    38\t    state.process_params = ProcessParams::default();\n    39\t\n    40\t    state\n    41\t}\n    42\t\n    43\t#[test]\n    44\tfn smaller_tank_responds_faster_to_ambient_change() -> Result<(), tank_core::SimError> {\n    45\t    let state_10l = state_with_volume(SimSeed(2000), 10.0);\n    46\t    let state_100l = state_with_volume(SimSeed(2000), 100.0);\n    47\t\n    48\t    let vol_10 = state_10l.geometry.water_volume_l();\n    49\t    let vol_100 = state_100l.geometry.water_volume_l();\n    50\t    assert!(\n    51\t        (vol_10 - 10.0).abs() < 0.1,\n    52\t        \"10L tank should be ~10L, got {vol_10}\"\n    53\t    );\n    54\t    assert!(\n    55\t        (vol_100 - 100.0).abs() < 0.1,\n    56\t        \"100L tank should be ~100L, got {vol_100}\"\n    57\t    );\n    58\t\n    59\t    let mut engine_10l = Engine::from_parts(state_10l, vec![]);\n    60\t    let mut engine_100l = Engine::from_parts(state_100l, vec![]);\n    61\t\n    62\t    // Change ambient to 31°C for both\n    63\t    engine_10l.apply_action(PlayerAction::ChangeAmbientTemperature { target_c: 31.0 })?;\n    64\t    engine_100l.apply_action(PlayerAction::ChangeAmbientTemperature { target_c: 31.0 })?;\n    65\t\n    66\t    let target_delta = 31.0 - 24.0; // 7°C total change\n    67\t    let half_delta = target_delta / 2.0; // 3.5°C\n    68\t\n    69\t    // Find how many ticks each takes to reach half of eventual delta\n    70\t    let mut ticks_10l = 0u32;\n    71\t    let mut ticks_100l = 0u32;\n    72\t\n    73\t    // Run 10L until half delta\n    74\t    for tick in 1..=500 {\n    75\t        engine_10l.step_hours(1)?;\n    76\t        let temp = engine_10l.full_state().water.temperature_c;\n    77\t        if temp - 24.0 >= half_delta {\n    78\t            ticks_10l = tick;\n    79\t            break;\n    80\t        }\n    81\t    }\n    82\t\n    83\t    // Run 100L until half delta\n    84\t    for tick in 1..=500 {\n    85\t        engine_100l.step_hours(1)?;\n    86\t        let temp = engine_100l.full_state().water.temperature_c;\n    87\t        if temp - 24.0 >= half_delta {\n    88\t            ticks_100l = tick;\n    89\t            break;\n    90\t        }\n    91\t    }\n    92\t\n    93\t    assert!(\n    94\t        ticks_10l > 0,\n    95\t        \"10L tank should reach half delta within 500 ticks\"\n    96\t    );\n    97\t    assert!(\n    98\t        ticks_100l > 0,\n    99\t        \"100L tank should reach half delta within 500 ticks\"\n   100\t    );\n   101\t    assert!(\n   102\t        ticks_10l * 2 < ticks_100l,\n   103\t        \"10L tank ({ticks_10l} ticks) should reach half delta in fewer than half the ticks of 100L ({ticks_100l} ticks)\"\n   104\t    );\n   105\t\n   106\t    Ok(())\n   107\t}\n   108\t\n   109\t#[test]\n   110\tfn lid_slows_surface_heat_exchange() -> Result<(), tank_core::SimError> {\n   111\t    let mut state_open = state_with_volume(SimSeed(2100), 50.0);\n   112\t    state_open.geometry.open_top = true;\n   113\t\n   114\t    let mut state_closed = state_with_volume(SimSeed(2100), 50.0);\n   115\t    state_closed.geometry.open_top = false;\n   116\t\n   117\t    let mut engine_open = Engine::from_parts(state_open, vec![]);\n   118\t    let mut engine_closed = Engine::from_parts(state_closed, vec![]);\n   119\t\n   120\t    // Change ambient for both\n   121\t    engine_open.apply_action(PlayerAction::ChangeAmbientTemperature { target_c: 31.0 })?;\n   122\t    engine_closed.apply_action(PlayerAction::ChangeAmbientTemperature { target_c: 31.0 })?;\n   123\t\n   124\t    engine_open.step_hours(10)?;\n   125\t    engine_closed.step_hours(10)?;\n   126\t\n   127\t    let temp_open = engine_open.full_state().water.temperature_c;\n   128\t    let temp_closed = engine_closed.full_state().water.temperature_c;\n   129\t\n   130\t    // Open top should warm faster (higher surface exchange)\n   131\t    assert!(\n   132\t        temp_open > temp_closed,\n   133\t        \"Open top ({temp_open:.3}°C) should warm faster than closed ({temp_closed:.3}°C)\"\n   134\t    );\n   135\t\n   136\t    Ok(())\n   137\t}\n","exit_code":0,"status":"completed"}}
