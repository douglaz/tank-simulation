{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/tests/water_change_mass_balance.rs | sed -n '1,340p'\"","aggregated_output":"     1\tuse tank_core::{Engine, PlayerAction, SimSeed, SimulationEngine, SourceWaterProfile, TankState};\n     2\t\n     3\t/// Helper: build a state with a known source-water catalog containing `ro_like`.\n     4\tfn state_with_ro_like(seed: SimSeed) -> TankState {\n     5\t    let mut state = TankState::new(seed);\n     6\t    state\n     7\t        .source_water_catalog\n     8\t        .insert(\"ro_like\".to_string(), SourceWaterProfile::zero());\n     9\t    state\n    10\t}\n    11\t\n    12\t#[test]\n    13\tfn water_change_50_percent_ro_like_halves_dissolved_totals() -> Result<(), tank_core::SimError> {\n    14\t    let state = state_with_ro_like(SimSeed(100));\n    15\t    let mut engine = Engine::from_parts(state, vec![]);\n    16\t\n    17\t    // Record pre-change totals\n    18\t    let before = engine.full_state().water.clone();\n    19\t\n    20\t    // Apply 50% water change with zero-nutrient source\n    21\t    engine.apply_action(PlayerAction::WaterChangePercent {\n    22\t        percent: 50.0,\n    23\t        source_profile_id: \"ro_like\".to_string(),\n    24\t    })?;\n    25\t    engine.step_hours(1)?;\n    26\t\n    27\t    let after = &engine.full_state().water;\n    28\t\n    29\t    // Each dissolved total should be reduced by 50% ± 0.5%\n    30\t    let tolerance = 0.005; // 0.5%\n    31\t    let expected_ratio = 0.5;\n    32\t\n    33\t    let checks: Vec<(&str, f64, f64)> = vec![\n    34\t        (\n    35\t            \"ammonia_total_mg_n_total\",\n    36\t            before.ammonia_total_mg_n_total,\n    37\t            after.ammonia_total_mg_n_total,\n    38\t        ),\n    39\t        (\n    40\t            \"nitrite_mg_n_total\",\n    41\t            before.nitrite_mg_n_total,\n    42\t            after.nitrite_mg_n_total,\n    43\t        ),\n    44\t        (\n    45\t            \"nitrate_mg_n_total\",\n    46\t            before.nitrate_mg_n_total,\n    47\t            after.nitrate_mg_n_total,\n    48\t        ),\n    49\t        (\n    50\t            \"phosphate_mg_p_total\",\n    51\t            before.phosphate_mg_p_total,\n    52\t            after.phosphate_mg_p_total,\n    53\t        ),\n    54\t        (\n    55\t            \"dissolved_inorganic_carbon_mg_c_total\",\n    56\t            before.dissolved_inorganic_carbon_mg_c_total,\n    57\t            after.dissolved_inorganic_carbon_mg_c_total,\n    58\t        ),\n    59\t        (\n    60\t            \"calcium_mg_total\",\n    61\t            before.calcium_mg_total,\n    62\t            after.calcium_mg_total,\n    63\t        ),\n    64\t        (\n    65\t            \"magnesium_mg_total\",\n    66\t            before.magnesium_mg_total,\n    67\t            after.magnesium_mg_total,\n    68\t        ),\n    69\t        (\n    70\t            \"sodium_mg_total\",\n    71\t            before.sodium_mg_total,\n    72\t            after.sodium_mg_total,\n    73\t        ),\n    74\t        (\n    75\t            \"potassium_mg_total\",\n    76\t            before.potassium_mg_total,\n    77\t            after.potassium_mg_total,\n    78\t        ),\n    79\t        (\n    80\t            \"bicarbonate_mg_total\",\n    81\t            before.bicarbonate_mg_total,\n    82\t            after.bicarbonate_mg_total,\n    83\t        ),\n    84\t        (\n    85\t            \"chloride_mg_total\",\n    86\t            before.chloride_mg_total,\n    87\t            after.chloride_mg_total,\n    88\t        ),\n    89\t        (\n    90\t            \"sulfate_mg_total\",\n    91\t            before.sulfate_mg_total,\n    92\t            after.sulfate_mg_total,\n    93\t        ),\n    94\t    ];\n    95\t\n    96\t    for (name, before_val, after_val) in &checks {\n    97\t        if *before_val > 0.0 {\n    98\t            let actual_ratio = after_val / before_val;\n    99\t            assert!(\n   100\t                (actual_ratio - expected_ratio).abs() < tolerance,\n   101\t                \"{name}: expected ratio {expected_ratio} ± {tolerance}, got {actual_ratio} (before={before_val}, after={after_val})\"\n   102\t            );\n   103\t        } else {\n   104\t            // If before was 0.0, after should also be 0.0 (ro_like adds nothing)\n   105\t            assert!(\n   106\t                after_val.abs() < f64::EPSILON,\n   107\t                \"{name}: expected 0.0 after zero water change, got {after_val}\"\n   108\t            );\n   109\t        }\n   110\t    }\n   111\t\n   112\t    Ok(())\n   113\t}\n   114\t\n   115\t#[test]\n   116\tfn water_change_0_percent_is_noop() -> Result<(), tank_core::SimError> {\n   117\t    let state = state_with_ro_like(SimSeed(200));\n   118\t    let mut engine = Engine::from_parts(state, vec![]);\n   119\t\n   120\t    let before = engine.full_state().water.clone();\n   121\t\n   122\t    engine.apply_action(PlayerAction::WaterChangePercent {\n   123\t        percent: 0.0,\n   124\t        source_profile_id: \"ro_like\".to_string(),\n   125\t    })?;\n   126\t    engine.step_hours(1)?;\n   127\t\n   128\t    let after = &engine.full_state().water;\n   129\t\n   130\t    // Chemistry should be unchanged (temperature may shift from ambient model)\n   131\t    assert!(\n   132\t        (after.calcium_mg_total - before.calcium_mg_total).abs() < f64::EPSILON,\n   133\t        \"0% water change should not change calcium\"\n   134\t    );\n   135\t    assert!(\n   136\t        (after.alkalinity_meq_total - before.alkalinity_meq_total).abs() < f64::EPSILON,\n   137\t        \"0% water change should not change alkalinity\"\n   138\t    );\n   139\t\n   140\t    Ok(())\n   141\t}\n   142\t\n   143\t#[test]\n   144\tfn water_change_100_percent_yields_source_temperature() -> Result<(), tank_core::SimError> {\n   145\t    let mut state = state_with_ro_like(SimSeed(300));\n   146\t    // Add a source with different temperature\n   147\t    let mut warm_source = SourceWaterProfile::zero();\n   148\t    warm_source.temperature_c = 30.0;\n   149\t    state\n   150\t        .source_water_catalog\n   151\t        .insert(\"warm\".to_string(), warm_source);\n   152\t\n   153\t    let mut engine = Engine::from_parts(state, vec![]);\n   154\t\n   155\t    engine.apply_action(PlayerAction::WaterChangePercent {\n   156\t        percent: 100.0,\n   157\t        source_profile_id: \"warm\".to_string(),\n   158\t    })?;\n   159\t    engine.step_hours(1)?;\n   160\t\n   161\t    // After 100% water change, temperature should be very close to source temp\n   162\t    // (may shift slightly from the temperature system running after the change)\n   163\t    let temp = engine.full_state().water.temperature_c;\n   164\t    assert!(\n   165\t        (temp - 30.0).abs() < 1.0,\n   166\t        \"100% water change should bring temp near source: got {temp}\"\n   167\t    );\n   168\t\n   169\t    Ok(())\n   170\t}\n   171\t\n   172\t#[test]\n   173\tfn water_change_50_percent_mixes_temperature() -> Result<(), tank_core::SimError> {\n   174\t    let mut state = state_with_ro_like(SimSeed(400));\n   175\t    let mut cold_source = SourceWaterProfile::zero();\n   176\t    cold_source.temperature_c = 10.0;\n   177\t    state\n   178\t        .source_water_catalog\n   179\t        .insert(\"cold\".to_string(), cold_source);\n   180\t    // Tank starts at 24°C, ambient is 24°C\n   181\t    state.water.temperature_c = 24.0;\n   182\t\n   183\t    let mut engine = Engine::from_parts(state, vec![]);\n   184\t\n   185\t    engine.apply_action(PlayerAction::WaterChangePercent {\n   186\t        percent: 50.0,\n   187\t        source_profile_id: \"cold\".to_string(),\n   188\t    })?;\n   189\t    engine.step_hours(1)?;\n   190\t\n   191\t    // Expected mixed temp: 24*0.5 + 10*0.5 = 17°C, plus thermal system may shift slightly\n   192\t    let temp = engine.full_state().water.temperature_c;\n   193\t    assert!(\n   194\t        temp > 14.0 && temp < 20.0,\n   195\t        \"50% cold water change should mix temperature proportionally: got {temp}\"\n   196\t    );\n   197\t\n   198\t    Ok(())\n   199\t}\n   200\t\n   201\t#[test]\n   202\tfn unknown_source_profile_returns_error() -> Result<(), tank_core::SimError> {\n   203\t    let state = TankState::new(SimSeed(500)); // empty catalog\n   204\t    let mut engine = Engine::from_parts(state, vec![]);\n   205\t\n   206\t    engine.apply_action(PlayerAction::WaterChangePercent {\n   207\t        percent: 50.0,\n   208\t        source_profile_id: \"nonexistent\".to_string(),\n   209\t    })?;\n   210\t\n   211\t    let result = engine.step_hours(1);\n   212\t    assert!(\n   213\t        matches!(result, Err(tank_core::SimError::UnknownSourceProfile { .. })),\n   214\t        \"Expected UnknownSourceProfile error, got: {result:?}\"\n   215\t    );\n   216\t\n   217\t    Ok(())\n   218\t}\n   219\t\n   220\t#[test]\n   221\tfn unknown_profile_leaves_state_unchanged() -> Result<(), tank_core::SimError> {\n   222\t    let mut state = TankState::new(SimSeed(600));\n   223\t    // Feed first to have some detritus, then queue a bad water change\n   224\t    state.detritus.particulate_organics_g_total = 5.0;\n   225\t    let before = state.clone();\n   226\t\n   227\t    let mut engine = Engine::from_parts(state, vec![]);\n   228\t\n   229\t    // Queue both a feed and a bad water change\n   230\t    engine.apply_action(PlayerAction::Feed { grams: 1.0 })?;\n   231\t    engine.apply_action(PlayerAction::WaterChangePercent {\n   232\t        percent: 50.0,\n   233\t        source_profile_id: \"bad_id\".to_string(),\n   234\t    })?;\n   235\t\n   236\t    let result = engine.step_hours(1);\n   237\t    assert!(result.is_err());\n   238\t\n   239\t    // State should be exactly unchanged: day, hour, event_log, water, rng all pristine\n   240\t    let after = engine.full_state();\n   241\t    assert_eq!(before.environment.day, after.environment.day);\n   242\t    assert_eq!(before.environment.hour_of_day, after.environment.hour_of_day);\n   243\t    assert_eq!(before.event_log.len(), after.event_log.len());\n   244\t    assert!(\n   245\t        (before.water.calcium_mg_total - after.water.calcium_mg_total).abs() < f64::EPSILON,\n   246\t    );\n   247\t\n   248\t    Ok(())\n   249\t}\n","exit_code":0,"status":"completed"}}
