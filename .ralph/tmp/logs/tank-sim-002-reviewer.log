ter.temperature_c <= 0.0 {\n    74\t        return Err(SimError::TemperatureTooLow {\n    75\t            field: \"water.temperature_c\",\n    76\t            value: state.water.temperature_c,\n    77\t        });\n    78\t    }\n    79\t\n    80\t    state.geometry.lid_exchange_factor = state.geometry.lid_exchange_factor.clamp(0.0, 1.0);\n    81\t    state.hardware.light.intensity_index = state.hardware.light.intensity_index.clamp(0.0, 1.0);\n    82\t    state.hardware.filter.cleanliness_index =\n    83\t        state.hardware.filter.cleanliness_index.clamp(0.0, 1.0);\n    84\t    state.hardware.aeration.intensity = state.hardware.aeration.intensity.clamp(0.0, 1.0);\n    85\t    state.filter_state.biofilter_maturity_index =\n    86\t        state.filter_state.biofilter_maturity_index.clamp(0.0, 1.0);\n    87\t    state.filter_state.clogging_index = state.filter_state.clogging_index.clamp(0.0, 1.0);\n    88\t    state.filter_state.seeded_biomass_index =\n    89\t        state.filter_state.seeded_biomass_index.clamp(0.0, 1.0);\n    90\t    state.algae.nuisance_index = state.algae.nuisance_index.clamp(0.0, 1.0);\n    91\t    state.microbe.maturity_index = state.microbe.maturity_index.clamp(0.0, 1.0);\n    92\t    state.microfauna.population_index = state.microfauna.population_index.clamp(0.0, 1.0);\n    93\t    state.microfauna.grazing_pressure_index =\n    94\t        state.microfauna.grazing_pressure_index.clamp(0.0, 1.0);\n    95\t    state.animal.condition_index = state.animal.condition_index.clamp(0.0, 1.0);\n    96\t    state.animal.molt_stress_index = state.animal.molt_stress_index.clamp(0.0, 1.0);\n    97\t    state.animal.reproductive_readiness_index =\n    98\t        state.animal.reproductive_readiness_index.clamp(0.0, 1.0);\n    99\t\n   100\t    for plant in &mut state.plant_guilds {\n   101\t        plant.health_index = plant.health_index.clamp(0.0, 1.0);\n   102\t        plant.crowding_index = plant.crowding_index.clamp(0.0, 1.0);\n   103\t        plant.habitat_index = plant.habitat_index.clamp(0.0, 1.0);\n   104\t    }\n   105\t    for layer in &mut state.substrate_layers {\n   106\t        layer.cation_exchange_capacity_index = layer.cation_exchange_capacity_index.clamp(0.0, 1.0);\n   107\t        layer.detritus_trapping_index = layer.detritus_trapping_index.clamp(0.0, 1.0);\n   108\t        layer.low_oxygen_tendency_index = layer.low_oxygen_tendency_index.clamp(0.0, 1.0);\n   109\t        layer.grazing_surface_index = layer.grazing_surface_index.clamp(0.0, 1.0);\n   110\t    }\n   111\t\n   112\t    if state.event_log.len() > 200 {\n   113\t        let keep_from = state.event_log.len() - 200;\n   114\t        state.event_log.drain(0..keep_from);\n   115\t    }\n   116\t\n   117\t    Ok(())\n   118\t}\n   119\t\n   120\tfn check_non_negative(field: &'static str, value: f64) -> Result<(), SimError> {\n   121\t    if value < 0.0 {\n   122\t        Err(SimError::InvariantViolation { field, value })\n   123\t    } else {\n   124\t        Ok(())\n   125\t    }\n   126\t}\n","exit_code":0,"status":"completed"}}
