{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/src/systems/water_change.rs | sed -n '1,260p'\"","aggregated_output":"     1\tuse crate::types::{SimError, SourceWaterProfile, TankState};\n     2\t\n     3\t/// Validates that all water change actions in the queue reference known source profiles.\n     4\t/// Returns the first error found, or Ok(()) if all are valid.\n     5\tpub fn validate_water_changes(state: &TankState, actions: &[crate::types::PlayerAction]) -> Result<(), SimError> {\n     6\t    for action in actions {\n     7\t        if let crate::types::PlayerAction::WaterChangePercent {\n     8\t            source_profile_id, ..\n     9\t        } = action\n    10\t        {\n    11\t            if !state.source_water_catalog.contains_key(source_profile_id) {\n    12\t                return Err(SimError::UnknownSourceProfile {\n    13\t                    id: source_profile_id.clone(),\n    14\t                });\n    15\t            }\n    16\t        }\n    17\t    }\n    18\t    Ok(())\n    19\t}\n    20\t\n    21\t/// Applies a water change: removes `percent/100` of each dissolved total,\n    22\t/// then adds replacement mass from the source-water profile using exchanged liters.\n    23\t/// Also mixes water temperature proportionally by exchanged volume.\n    24\t///\n    25\t/// A 0% water change is a no-op.\n    26\tpub fn apply_water_change(\n    27\t    state: &mut TankState,\n    28\t    percent: f64,\n    29\t    source: &SourceWaterProfile,\n    30\t) {\n    31\t    if percent <= 0.0 {\n    32\t        return;\n    33\t    }\n    34\t\n    35\t    let volume_l = state.geometry.water_volume_l();\n    36\t    let fraction = percent / 100.0;\n    37\t    let retention = 1.0 - fraction;\n    38\t    let exchanged_l = volume_l * fraction;\n    39\t\n    40\t    // Remove fraction of each dissolved total\n    41\t    state.water.ammonia_total_mg_n_total *= retention;\n    42\t    state.water.nitrite_mg_n_total *= retention;\n    43\t    state.water.nitrate_mg_n_total *= retention;\n    44\t    state.water.phosphate_mg_p_total *= retention;\n    45\t    state.water.dissolved_inorganic_carbon_mg_c_total *= retention;\n    46\t    state.water.dissolved_organic_carbon_mg_c_total *= retention;\n    47\t    state.water.dissolved_organic_nitrogen_mg_n_total *= retention;\n    48\t    state.water.alkalinity_meq_total *= retention;\n    49\t    state.water.calcium_mg_total *= retention;\n    50\t    state.water.magnesium_mg_total *= retention;\n    51\t    state.water.sodium_mg_total *= retention;\n    52\t    state.water.potassium_mg_total *= retention;\n    53\t    state.water.bicarbonate_mg_total *= retention;\n    54\t    state.water.chloride_mg_total *= retention;\n    55\t    state.water.sulfate_mg_total *= retention;\n    56\t\n    57\t    // Add replacement mass from source water\n    58\t    state.water.ammonia_total_mg_n_total += source.ammonia_mg_n_per_l * exchanged_l;\n    59\t    state.water.nitrite_mg_n_total += source.nitrite_mg_n_per_l * exchanged_l;\n    60\t    state.water.nitrate_mg_n_total += source.nitrate_mg_n_per_l * exchanged_l;\n    61\t    state.water.phosphate_mg_p_total += source.phosphate_mg_p_per_l * exchanged_l;\n    62\t    state.water.dissolved_inorganic_carbon_mg_c_total += source.dic_mg_c_per_l * exchanged_l;\n    63\t    state.water.dissolved_organic_carbon_mg_c_total += source.doc_mg_c_per_l * exchanged_l;\n    64\t    state.water.dissolved_organic_nitrogen_mg_n_total += source.don_mg_n_per_l * exchanged_l;\n    65\t    state.water.alkalinity_meq_total += source.alkalinity_meq_per_l * exchanged_l;\n    66\t    state.water.calcium_mg_total += source.calcium_mg_per_l * exchanged_l;\n    67\t    state.water.magnesium_mg_total += source.magnesium_mg_per_l * exchanged_l;\n    68\t    state.water.sodium_mg_total += source.sodium_mg_per_l * exchanged_l;\n    69\t    state.water.potassium_mg_total += source.potassium_mg_per_l * exchanged_l;\n    70\t    state.water.bicarbonate_mg_total += source.bicarbonate_mg_per_l * exchanged_l;\n    71\t    state.water.chloride_mg_total += source.chloride_mg_per_l * exchanged_l;\n    72\t    state.water.sulfate_mg_total += source.sulfate_mg_per_l * exchanged_l;\n    73\t\n    74\t    // Mix temperature proportionally by exchanged volume\n    75\t    state.water.temperature_c = state.water.temperature_c * retention\n    76\t        + source.temperature_c * fraction;\n    77\t}\n","exit_code":0,"status":"completed"}}
