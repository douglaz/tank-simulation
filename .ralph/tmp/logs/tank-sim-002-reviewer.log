{"type":"item.completed","item":{"id":"item_79","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_data/src/lib.rs | sed -n '1,120p'\"","aggregated_output":"     1\tmod presets;\n     2\t\n     3\tuse serde::de::DeserializeOwned;\n     4\tuse thiserror::Error;\n     5\t\n     6\tpub use presets::{\n     7\t    PlantPreset, ProcessParamsPreset, Provenance, ScenarioPreset, ShrimpPreset, SourceWaterPreset,\n     8\t    SubstratePreset,\n     9\t};\n    10\t\n    11\t#[derive(Debug, Error)]\n    12\tpub enum PresetError {\n    13\t    #[error(\"unknown preset `{id}` in category `{category}`\")]\n    14\t    UnknownPreset { category: &'static str, id: String },\n    15\t    #[error(\"failed to parse preset `{id}` in category `{category}`: {message}\")]\n    16\t    Parse {\n    17\t        category: &'static str,\n    18\t        id: String,\n    19\t        message: String,\n    20\t    },\n    21\t    #[error(\"validation failed for preset `{id}` in category `{category}`: {message}\")]\n    22\t    Validation {\n    23\t        category: &'static str,\n    24\t        id: String,\n    25\t        message: String,\n    26\t    },\n    27\t}\n    28\t\n    29\tpub fn load_source_water(id: &str) -> Result<SourceWaterPreset, PresetError> {\n    30\t    let preset: SourceWaterPreset = load_from_registry(\"source_water\", id, SOURCE_WATER_PRESETS)?;\n    31\t    preset\n    32\t        .validate()\n    33\t        .map_err(|message| PresetError::Validation {\n    34\t            category: \"source_water\",\n    35\t            id: id.to_string(),\n    36\t            message,\n    37\t        })?;\n    38\t    Ok(preset)\n    39\t}\n    40\t\n    41\tpub fn load_substrate(id: &str) -> Result<SubstratePreset, PresetError> {\n    42\t    load_from_registry(\"substrate\", id, SUBSTRATE_PRESETS)\n    43\t}\n    44\t\n    45\tpub fn load_plant(id: &str) -> Result<PlantPreset, PresetError> {\n    46\t    load_from_registry(\"plants\", id