{"type":"item.completed","item":{"id":"item_67","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/src/systems/temperature.rs | sed -n '1,220p'\"","aggregated_output":"     1\tuse crate::types::TankState;\n     2\t\n     3\t/// DO saturation in mg/L from linear interpolation over the reference table:\n     4\t/// 0°C → 14.6, 10°C → 11.3, 20°C → 9.1, 30°C → 7.6\n     5\tpub fn do_sat_mg_l(temp_c: f64) -> f64 {\n     6\t    const TABLE: [(f64, f64); 4] = [(0.0, 14.6), (10.0, 11.3), (20.0, 9.1), (30.0, 7.6)];\n     7\t\n     8\t    if temp_c <= TABLE[0].0 {\n     9\t        return TABLE[0].1;\n    10\t    }\n    11\t    if temp_c >= TABLE[TABLE.len() - 1].0 {\n    12\t        return TABLE[TABLE.len() - 1].1;\n    13\t    }\n    14\t\n    15\t    for i in 0..TABLE.len() - 1 {\n    16\t        let (t0, do0) = TABLE[i];\n    17\t        let (t1, do1) = TABLE[i + 1];\n    18\t        if temp_c >= t0 && temp_c <= t1 {\n    19\t            let frac = (temp_c - t0) / (t1 - t0);\n    20\t            return do0 + frac * (do1 - do0);\n    21\t        }\n    22\t    }\n    23\t\n    24\t    // Fallback (shouldn't reach here)\n    25\t    TABLE[TABLE.len() - 1].1\n    26\t}\n    27\t\n    28\t/// Hourly discrete heat-transfer model.\n    29\t///\n    30\t/// Updates `state.water.temperature_c` based on ambient temperature, heater,\n    31\t/// and tank geometry. Records heater output on `state.hardware.heater.last_output_w`.\n    32\tpub fn step_temperature(state: &mut TankState) {\n    33\t    let dt_s = 3600.0_f64;\n    34\t    let volume_l = state.geometry.water_volume_l();\n    35\t    if volume_l <= f64::EPSILON {\n    36\t        return;\n    37\t    }\n    38\t\n    39\t    let heat_capacity_j_per_k = volume_l * 4186.0;\n    40\t\n    41\t    let surface_area_m2 = state.geometry.surface_area_cm2() / 10_000.0;\n    42\t    let wall_area_m2 = state.geometry.wall_area_cm2() / 10_000.0;\n    43\t    let top_factor = state.geometry.top_exchange_factor();\n    44\t\n    45\t    let k_surface = state.process_params.k_surface_w_per_m2_k;\n    46\t    let k_wall = state.process_params.k_wall_w_per_m2_k;\n    47\t\n    48\t    let ua_total_w_per_k =\n    49\t        (k_surface * surface_area_m2 * top_factor) + (k_wall * wall_area_m2);\n    50\t\n    51\t    let ambient_temp_c = state.environment.ambient_temp_c;\n    52\t    let water_temp_c = state.water.temperature_c;\n    53\t\n    54\t    let q_ambient_w = ua_total_w_per_k * (ambient_temp_c - water_temp_c);\n    55\t\n    56\t    // Heater: only fires when enabled and water is below setpoint - deadband/2\n    57\t    let q_heater_w = if state.hardware.heater.enabled\n    58\t        && water_temp_c < (state.hardware.heater.setpoint_c - state.hardware.heater.deadband_c / 2.0)\n    59\t    {\n    60\t        (state.hardware.heater.max_watts * state.hardware.heater.efficiency).max(0.0)\n    61\t    } else {\n    62\t        0.0\n    63\t    };\n    64\t\n    65\t    state.hardware.heater.last_output_w = q_heater_w;\n    66\t\n    67\t    let delta_temp_c = (q_ambient_w + q_heater_w) * dt_s / heat_capacity_j_per_k;\n    68\t    state.water.temperature_c += delta_temp_c;\n    69\t}\n    70\t\n    71\t#[cfg(test)]\n    72\tmod tests {\n    73\t    use super::*;\n    74\t\n    75\t    #[test]\n    76\t    fn do_sat_boundaries() {\n    77\t        assert!((do_sat_mg_l(0.0) - 14.6).abs() < 0.01);\n    78\t        assert!((do_sat_mg_l(10.0) - 11.3).abs() < 0.01);\n    79\t        assert!((do_sat_mg_l(20.0) - 9.1).abs() < 0.01);\n    80\t        assert!((do_sat_mg_l(30.0) - 7.6).abs() < 0.01);\n    81\t    }\n    82\t\n    83\t    #[test]\n    84\t    fn do_sat_interpolation() {\n    85\t        let mid = do_sat_mg_l(15.0);\n    86\t        // Midpoint between 11.3 and 9.1 = 10.2\n    87\t        assert!((mid - 10.2).abs() < 0.01);\n    88\t    }\n    89\t\n    90\t    #[test]\n    91\t    fn do_sat_clamp() {\n    92\t        assert!((do_sat_mg_l(-5.0) - 14.6).abs() < 0.01);\n    93\t        assert!((do_sat_mg_l(40.0) - 7.6).abs() < 0.01);\n    94\t    }\n    95\t}\n","exit_code":0,"status":"completed"}}
