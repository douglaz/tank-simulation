{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/src/types/snapshot.rs | sed -n '1,260p'\"","aggregated_output":"     1\tuse serde::{Deserialize, Serialize};\n     2\t\n     3\tuse super::{SimEvent, TankState};\n     4\tuse crate::systems::temperature::do_sat_mg_l;\n     5\t\n     6\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n     7\tpub struct TankSnapshot {\n     8\t    pub day: u32,\n     9\t    pub hour: u8,\n    10\t    pub water_temp_c: f64,\n    11\t    pub water_volume_l: f64,\n    12\t    pub tan_mg_l: f64,\n    13\t    pub nh3_mg_l: f64,\n    14\t    pub nitrite_mg_l: f64,\n    15\t    pub nitrate_mg_l: f64,\n    16\t    pub phosphate_mg_l: f64,\n    17\t    pub do_mg_l: f64,\n    18\t    pub do_sat_mg_l: f64,\n    19\t    pub gh_d: f64,\n    20\t    pub kh_d: f64,\n    21\t    pub tds_mg_l: f64,\n    22\t    pub conductivity_us_cm: f64,\n    23\t    pub ph: f64,\n    24\t    pub adult_shrimp_count: u32,\n    25\t    pub total_plant_biomass_g: f64,\n    26\t    pub last_heater_output_w: f64,\n    27\t    pub recent_events: Vec<SimEvent>,\n    28\t}\n    29\t\n    30\timpl TankSnapshot {\n    31\t    pub fn from_state(state: &TankState) -> Self {\n    32\t        let volume_l = state.geometry.water_volume_l();\n    33\t        let tan_mg_l = safe_div(state.water.ammonia_total_mg_n_total, volume_l);\n    34\t        let nitrite_mg_l = safe_div(state.water.nitrite_mg_n_total, volume_l);\n    35\t        let nitrate_mg_l = safe_div(state.water.nitrate_mg_n_total, volume_l);\n    36\t        let phosphate_mg_l = safe_div(state.water.phosphate_mg_p_total, volume_l);\n    37\t        let do_mg_l_val = safe_div(state.water.dissolved_oxygen_mg_total, volume_l);\n    38\t        let ca_mg_l = safe_div(state.water.calcium_mg_total, volume_l);\n    39\t        let mg_mg_l = safe_div(state.water.magnesium_mg_total, volume_l);\n    40\t        let alkalinity_meq_l = safe_div(state.water.alkalinity_meq_total, volume_l);\n    41\t        let total_tracked_ions_mg = state.water.total_tracked_ions_mg();\n    42\t        let tds_mg_l = safe_div(total_tracked_ions_mg, volume_l);\n    43\t        let conductivity_us_cm = tds_mg_l / 0.65;\n    44\t        let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n    45\t        let kh_d = (alkalinity_meq_l * 50.0) / 17.848;\n    46\t        let dic_mmol_l = safe_div(\n    47\t            state.water.dissolved_inorganic_carbon_mg_c_total / 12.0,\n    48\t            volume_l,\n    49\t        );\n    50\t        let ph = (6.3 + safe_log10(alkalinity_meq_l.max(0.05)) - safe_log10(dic_mmol_l.max(0.02)))\n    51\t            .clamp(5.5, 8.5);\n    52\t        let pka = 0.09018 + 2729.92 / (273.2 + state.water.temperature_c);\n    53\t        let fraction_nh3 = 1.0 / (1.0 + 10.0_f64.powf(pka - ph));\n    54\t        let nh3_mg_l = tan_mg_l * fraction_nh3;\n    55\t\n    56\t        Self {\n    57\t            day: state.environment.day,\n    58\t            hour: state.environment.hour_of_day,\n    59\t            water_temp_c: state.water.temperature_c,\n    60\t            water_volume_l: volume_l,\n    61\t            tan_mg_l,\n    62\t            nh3_mg_l,\n    63\t            nitrite_mg_l,\n    64\t            nitrate_mg_l,\n    65\t            phosphate_mg_l,\n    66\t            do_mg_l: do_mg_l_val,\n    67\t            do_sat_mg_l: do_sat_mg_l(state.water.temperature_c),\n    68\t            gh_d,\n    69\t            kh_d,\n    70\t            tds_mg_l,\n    71\t            conductivity_us_cm,\n    72\t            ph,\n    73\t            adult_shrimp_count: state.animal.adults_count,\n    74\t            total_plant_biomass_g: state.plant_guilds.iter().map(|plant| plant.biomass_g).sum(),\n    75\t            last_heater_output_w: state.hardware.heater.last_output_w,\n    76\t            recent_events: state.event_log.iter().rev().take(20).cloned().collect(),\n    77\t        }\n    78\t    }\n    79\t}\n    80\t\n    81\tfn safe_div(numerator: f64, denominator: f64) -> f64 {\n    82\t    if denominator <= f64::EPSILON {\n    83\t        0.0\n    84\t    } else {\n    85\t        numerator / denominator\n    86\t    }\n    87\t}\n    88\t\n    89\tfn safe_log10(value: f64) -> f64 {\n    90\t    value.max(f64::MIN_POSITIVE).log10()\n    91\t}\n","exit_code":0,"status":"completed"}}
