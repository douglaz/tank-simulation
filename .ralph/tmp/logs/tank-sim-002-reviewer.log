{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_scenarios/tests/materialization.rs | sed -n '1,260p'\"","aggregated_output":"     1\tuse tank_core::SimSeed;\n     2\t\n     3\t#[test]\n     4\tfn nano_cycle_materializes_correctly() {\n     5\t    let state = tank_scenarios::seeded_state(SimSeed(42), \"nano_cycle\")\n     6\t        .expect(\"nano_cycle should materialize\");\n     7\t\n     8\t    // Geometry from scenario: 30×20, 20cm tall, 18cm filled\n     9\t    assert!((state.geometry.length_cm - 30.0).abs() < f64::EPSILON);\n    10\t    assert!((state.geometry.width_cm - 20.0).abs() < f64::EPSILON);\n    11\t    assert!((state.geometry.height_cm - 20.0).abs() < f64::EPSILON);\n    12\t    assert!((state.geometry.fill_height_cm - 18.0).abs() < f64::EPSILON);\n    13\t\n    14\t    // Volume: 30 * 20 * 18 / 1000 = 10.8L\n    15\t    let expected_vol = 30.0 * 20.0 * 18.0 / 1000.0;\n    16\t    let actual_vol = state.geometry.water_volume_l();\n    17\t    assert!(\n    18\t        (actual_vol - expected_vol).abs() < 0.01,\n    19\t        \"Volume should be {expected_vol}, got {actual_vol}\"\n    20\t    );\n    21\t\n    22\t    // Ambient from scenario\n    23\t    assert!((state.environment.ambient_temp_c - 24.0).abs() < f64::EPSILON);\n    24\t\n    25\t    // Meta\n    26\t    assert_eq!(state.meta.scenario_id.as_deref(), Some(\"nano_cycle\"));\n    27\t    assert_eq!(state.meta.notes.as_deref(), Some(\"Nano Cycle\"));\n    28\t\n    29\t    // Source water catalog should contain all presets\n    30\t    assert!(state.source_water_catalog.contains_key(\"soft_acidic\"));\n    31\t    assert!(state.source_water_catalog.contains_key(\"moderate\"));\n    32\t    assert!(state.source_water_catalog.contains_key(\"hard_shrimp\"));\n    33\t    assert!(state.source_water_catalog.contains_key(\"ro_like\"));\n    34\t\n    35\t    // Initial water chemistry comes from soft_acidic profile\n    36\t    let sw = &state.source_water_catalog[\"soft_acidic\"];\n    37\t    let vol = state.geometry.water_volume_l();\n    38\t    assert!(\n    39\t        (state.water.calcium_mg_total - sw.calcium_mg_per_l * vol).abs() < 0.01,\n    40\t        \"Calcium should match source water * volume\"\n    41\t    );\n    42\t    assert!(\n    43\t        (state.water.temperature_c - sw.temperature_c).abs() < 0.01,\n    44\t        \"Initial water temp should match source water\"\n    45\t    );\n    46\t\n    47\t    // Substrate: single inert_sand layer\n    48\t    assert_eq!(state.substrate_layers.len(), 1);\n    49\t    assert_eq!(\n    50\t        state.substrate_layers[0].kind,\n    51\t        tank_core::SubstrateKind::InertSand\n    52\t    );\n    53\t\n    54\t    // Plants: single fast_stem\n    55\t    assert_eq!(state.plant_guilds.len(), 1);\n    56\t    assert_eq!(state.plant_guilds[0].guild, tank_core::PlantGuild::FastStem);\n    57\t\n    58\t    // Process params should be non-default (loaded from preset)\n    59\t    assert!(state.process_params.k_surface_w_per_m2_k > 0.0);\n    60\t    assert!(state.process_params.k_wall_w_per_m2_k > 0.0);\n    61\t}\n    62\t\n    63\t#[test]\n    64\tfn medium_planted_materializes_with_two_substrates_and_plants() {\n    65\t    let state = tank_scenarios::seeded_state(SimSeed(43), \"medium_planted\")\n    66\t        .expect(\"medium_planted should materialize\");\n    67\t\n    68\t    // Two substrate layers\n    69\t    assert_eq!(state.substrate_layers.len(), 2);\n    70\t    assert_eq!(\n    71\t        state.substrate_layers[0].kind,\n    72\t        tank_core::SubstrateKind::ActivePlanted\n    73\t    );\n    74\t    assert_eq!(\n    75\t        state.substrate_layers[1].kind,\n    76\t        tank_core::SubstrateKind::CoarsePorous\n    77\t    );\n    78\t\n    79\t    // Two plant guilds\n    80\t    assert_eq!(state.plant_guilds.len(), 2);\n    81\t\n    82\t    // Geometry: 60×30, 36cm height, 32cm filled\n    83\t    assert!((state.geometry.length_cm - 60.0).abs() < f64::EPSILON);\n    84\t    assert!((state.geometry.fill_height_cm - 32.0).abs() < f64::EPSILON);\n    85\t\n    86\t    // Volume\n    87\t    let expected_vol = 60.0 * 30.0 * 32.0 / 1000.0;\n    88\t    let actual_vol = state.geometry.water_volume_l();\n    89\t    assert!(\n    90\t        (actual_vol - expected_vol).abs() < 0.01,\n    91\t        \"Expected {expected_vol}L, got {actual_vol}L\"\n    92\t    );\n    93\t}\n    94\t\n    95\t#[test]\n    96\tfn warm_room_materializes_with_high_ambient() {\n    97\t    let state = tank_scenarios::seeded_state(SimSeed(44), \"warm_room\")\n    98\t        .expect(\"warm_room should materialize\");\n    99\t\n   100\t    assert!((state.environment.ambient_temp_c - 29.0).abs() < f64::EPSILON);\n   101\t}\n   102\t\n   103\t#[test]\n   104\tfn deterministic_materialization() {\n   105\t    let state_a = tank_scenarios::seeded_state(SimSeed(99), \"nano_cycle\")\n   106\t        .expect(\"should materialize\");\n   107\t    let state_b = tank_scenarios::seeded_state(SimSeed(99), \"nano_cycle\")\n   108\t        .expect(\"should materialize\");\n   109\t\n   110\t    assert_eq!(state_a, state_b, \"Same seed + scenario must produce identical state\");\n   111\t}\n   112\t\n   113\t#[test]\n   114\tfn unknown_scenario_returns_error() {\n   115\t    let result = tank_scenarios::seeded_state(SimSeed(1), \"nonexistent_scenario\");\n   116\t    assert!(result.is_err());\n   117\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_scenarios/src/lib.rs | sed -n '1,360p'\"","aggregated_output":"     1\tuse std::collections::BTreeMap;\n     2\t\n     3\tuse tank_core::{\n     4\t    PlantGuild, PlantGuildState, ProcessParams, SimMeta, SimSeed, SourceWaterProfile,\n     5\t    SubstrateLayerState, TankGeometry, TankState, WaterState,\n     6\t};\n     7\tuse tank_data::{load_scenario, ScenarioPreset};\n     8\t\n     9\tpub fn default_scenario_ids() -> &'static [&'static str] {\n    10\t    tank_data::scenario_ids()\n    11\t}\n    12\t\n    13\tpub fn load_named_scenario(id: &str) -> Result<ScenarioPreset, tank_data::PresetError> {\n    14\t    load_scenario(id)\n    15\t}\n    16\t\n    17\t/// Converts a `tank_data::SourceWaterPreset` into a `tank_core::SourceWaterProfile`.\n    18\tfn source_water_to_profile(preset: &tank_data::SourceWaterPreset) -> SourceWaterProfile {\n    19\t    SourceWaterProfile {\n    20\t        temperature_c: preset.temperature_c,\n    21\t        ammonia_mg_n_per_l: preset.ammonia_mg_n_per_l,\n    22\t        nitrite_mg_n_per_l: preset.nitrite_mg_n_per_l,\n    23\t        nitrate_mg_n_per_l: preset.nitrate_mg_n_per_l,\n    24\t        phosphate_mg_p_per_l: preset.phosphate_mg_p_per_l,\n    25\t        dic_mg_c_per_l: preset.dic_mg_c_per_l,\n    26\t        doc_mg_c_per_l: preset.doc_mg_c_per_l,\n    27\t        don_mg_n_per_l: preset.don_mg_n_per_l,\n    28\t        alkalinity_meq_per_l: preset.alkalinity_meq_per_l,\n    29\t        calcium_mg_per_l: preset.calcium_mg_per_l,\n    30\t        magnesium_mg_per_l: preset.magnesium_mg_per_l,\n    31\t        sodium_mg_per_l: preset.sodium_mg_per_l,\n    32\t        potassium_mg_per_l: preset.potassium_mg_per_l,\n    33\t        bicarbonate_mg_per_l: preset.bicarbonate_mg_per_l,\n    34\t        chloride_mg_per_l: preset.chloride_mg_per_l,\n    35\t        sulfate_mg_per_l: preset.sulfate_mg_per_l,\n    36\t    }\n    37\t}\n    38\t\n    39\t/// Converts a `tank_data::ProcessParamsPreset` into `tank_core::ProcessParams`.\n    40\tfn process_preset_to_params(preset: &tank_data::ProcessParamsPreset) -> ProcessParams {\n    41\t    ProcessParams {\n    42\t        mineralization_rate_per_day: preset.mineralization_rate_per_day,\n    43\t        nitrification_vmax: preset.nitrification_vmax,\n    44\t        reaeration_kla: preset.reaeration_kla,\n    45\t        k_surface_w_per_m2_k: preset.k_surface_w_per_m2_k,\n    46\t        k_wall_w_per_m2_k: preset.k_wall_w_per_m2_k,\n    47\t    }\n    48\t}\n    49\t\n    50\t/// Materializes a scenario preset into a fully resolved `TankState`.\n    51\t///\n    52\t/// - Geometry comes from the scenario.\n    53\t/// - `environment.ambient_temp_c` comes from the scenario.\n    54\t/// - Initial `WaterState` totals come from the source-water profile × fill volume.\n    55\t/// - Substrate layers come from the scenario's substrate preset IDs.\n    56\t/// - Plant guilds come from the scenario's plant preset IDs.\n    57\t/// - Source-water catalog is populated with all known source-water presets.\n    58\t/// - Process parameters come from the scenario's process params preset.\n    59\tpub fn seeded_state(seed: SimSeed, scenario_id: &str) -> Result<TankState, tank_data::PresetError> {\n    60\t    let scenario = load_named_scenario(scenario_id)?;\n    61\t\n    62\t    // Geometry\n    63\t    let geometry = TankGeometry {\n    64\t        length_cm: scenario.tank_length_cm,\n    65\t        width_cm: scenario.tank_width_cm,\n    66\t        height_cm: scenario.tank_height_cm,\n    67\t        fill_height_cm: scenario.fill_height_cm,\n    68\t        glass_thickness_mm: 5.0,\n    69\t        open_top: true,\n    70\t        lid_exchange_factor: 0.25,\n    71\t    };\n    72\t\n    73\t    // Source water profile for initial fill\n    74\t    let source_water_preset = tank_data::load_source_water(&scenario.source_water_id)?;\n    75\t    let source_profile = source_water_to_profile(&source_water_preset);\n    76\t\n    77\t    // Initial water state from source-water profile\n    78\t    let water = WaterState::from_source_profile(&source_profile, &geometry);\n    79\t\n    80\t    // Build source-water catalog with all known presets\n    81\t    let mut source_water_catalog = BTreeMap::new();\n    82\t    for sw_id in tank_data::source_water_ids() {\n    83\t        let sw_preset = tank_data::load_source_water(sw_id)?;\n    84\t        source_water_catalog.insert(sw_id.to_string(), source_water_to_profile(&sw_preset));\n    85\t    }\n    86\t\n    87\t    // Process parameters\n    88\t    let process_preset = tank_data::load_process_params(&scenario.process_params_id)?;\n    89\t    let process_params = process_preset_to_params(&process_preset);\n    90\t\n    91\t    // Substrate layers\n    92\t    let mut substrate_layers = Vec::new();\n    93\t    for sub_id in &scenario.substrate_ids {\n    94\t        let sub_preset = tank_data::load_substrate(sub_id)?;\n    95\t        let footprint = geometry.footprint_area_cm2();\n    96\t        substrate_layers.push(SubstrateLayerState {\n    97\t            kind: match sub_preset.id.as_str() {\n    98\t                \"inert_sand\" => tank_core::SubstrateKind::InertSand,\n    99\t                \"inert_gravel\" => tank_core::SubstrateKind::InertGravel,\n   100\t                \"active_planted\" => tank_core::SubstrateKind::ActivePlanted,\n   101\t                \"coarse_porous\" => tank_core::SubstrateKind::CoarsePorous,\n   102\t                _ => tank_core::SubstrateKind::InertSand,\n   103\t            },\n   104\t            depth_cm: sub_preset.depth_cm,\n   105\t            nutrient_store_mg_n_total: sub_preset.nutrient_charge_mg_n_total,\n   106\t            nutrient_store_mg_p_total: sub_preset.nutrient_charge_mg_p_total,\n   107\t            cation_exchange_capacity_index: sub_preset.cation_exchange_capacity_index,\n   108\t            detritus_trapping_index: sub_preset.detritus_trapping_index,\n   109\t            colonizable_area_cm2: footprint * sub_preset.colonizable_area_factor,\n   110\t            low_oxygen_tendency_index: sub_preset.low_oxygen_tendency_index,\n   111\t            grazing_surface_index: sub_preset.grazing_surface_index,\n   112\t        });\n   113\t    }\n   114\t    if substrate_layers.is_empty() {\n   115\t        substrate_layers.push(SubstrateLayerState::default());\n   116\t    }\n   117\t\n   118\t    // Plant guilds\n   119\t    let mut plant_guilds = Vec::new();\n   120\t    for plant_id in &scenario.plant_ids {\n   121\t        let plant_preset = tank_data::load_plant(plant_id)?;\n   122\t        let guild = match plant_preset.guild.as_str() {\n   123\t            \"FastStem\" => PlantGuild::FastStem,\n   124\t            \"RootFeedingRosette\" => PlantGuild::RootFeedingRosette,\n   125\t            _ => PlantGuild::FastStem,\n   126\t        };\n   127\t        plant_guilds.push(PlantGuildState {\n   128\t            guild,\n   129\t            biomass_g: 5.0,\n   130\t            health_index: 0.8,\n   131\t            crowding_index: 0.1,\n   132\t            habitat_index: if guild == PlantGuild::RootFeedingRosette {\n   133\t                // Habitat factor depends on substrate quality\n   134\t                substrate_layers\n   135\t                    .iter()\n   136\t                    .map(|l| l.cation_exchange_capacity_index)\n   137\t                    .fold(0.0_f64, f64::max)\n   138\t                    .max(0.3)\n   139\t            } else {\n   140\t                0.8\n   141\t            },\n   142\t        });\n   143\t    }\n   144\t    if plant_guilds.is_empty() {\n   145\t        plant_guilds.push(PlantGuildState::default());\n   146\t    }\n   147\t\n   148\t    // Environment\n   149\t    let mut environment = tank_core::EnvironmentState::default();\n   150\t    environment.ambient_temp_c = scenario.ambient_temp_c;\n   151\t\n   152\t    let mut state = TankState::new(seed);\n   153\t    state.meta = SimMeta {\n   154\t        scenario_id: Some(scenario.id),\n   155\t        notes: Some(scenario.name),\n   156\t    };\n   157\t    state.geometry = geometry;\n   158\t    state.environment = environment;\n   159\t    state.water = water;\n   160\t    state.substrate_layers = substrate_layers;\n   161\t    state.plant_guilds = plant_guilds;\n   162\t    state.source_water_catalog = source_water_catalog;\n   163\t    state.process_params = process_params;\n   164\t\n   165\t    Ok(state)\n   166\t}\n","exit_code":0,"status":"completed"}}
