{"type":"item.completed","item":{"id":"item_78","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_scenarios/tests/materialization.rs | sed -n '1,220p'\"","aggregated_output":"     1\tuse tank_core::SimSeed;\n     2\t\n     3\t#[test]\n     4\tfn nano_cycle_materializes_correctly() {\n     5\t    let state = tank_scenarios::seeded_state(SimSeed(42), \"nano_cycle\")\n     6\t        .expect(\"nano_cycle should materialize\");\n     7\t\n     8\t    // Geometry from scenario: 30×20, 20cm tall, 18cm filled\n     9\t    assert!((state.geometry.length_cm - 30.0).abs() < f64::EPSILON);\n    10\t    assert!((state.geometry.width_cm - 20.0).abs() < f64::EPSILON);\n    11\t    assert!((state.geometry.height_cm - 20.0).abs() < f64::EPSILON);\n    12\t    assert!((state.geometry.fill_height_cm - 18.0).abs() < f64::EPSILON);\n    13\t\n    14\t    // Volume: 30 * 20 * 18 / 1000 = 10.8L\n    15\t    let expected_vol = 30.0 * 20.0 * 18.0 / 1000.0;\n    16\t    let actual_vol = state.geometry.water_volume_l();\n    17\t    assert!(\n    18\t        (actual_vol - expected_vol).abs() < 0.01,\n    19\t        \"Volume should be {expected_vol}, got {actual_vol}\"\n    20\t    );\n    21\t\n    22\t    // Ambient from scenario\n    23\t    assert!((state.environment.ambient_temp_c - 24.0).abs() < f64::EPSILON);\n    24\t\n    25\t    // Meta\n    26\t    assert_eq!(state.meta.scenario_id.as_deref(), Some(\"nano_cycle\"));\n    27\t    assert_eq!(state.meta.notes.as_deref(), Some(\"Nano Cycle\"));\n    28\t\n    29\t    // Source water catalog should contain all presets\n    30\t    assert!(state.source_water_catalog.contains_key(\"soft_acidic\"));\n    31\t    assert!(state.source_water_catalog.contains_key(\"moderate\"));\n    32\t    assert!(state.source_water_catalog.contains_key(\"hard_shrimp\"));\n    33\t    assert!(state.source_water_catalog.contains_key(\"ro_like\"));\n    34\t\n    35\t    // Initial water chemistry comes from soft_acidic profile\n    36\t    let sw = &state.source_water_catalog[\"soft_acidic\"];\n    37\t    let vol = state.geometry.water_volume_l();\n    38\t    assert!(\n    39\t        (state.water.calcium_mg_total - sw.calcium_mg_per_l * vol).abs() < 0.01,\n    40\t        \"Calcium should match source water * volume\"\n    41\t    );\n    42\t    assert!(\n    43\t        (state.water.temperature_c - sw.temperature_c).abs() < 0.01,\n    44\t        \"Initial water temp should match source water\"\n    45\t    );\n    46\t\n    47\t    // Substrate: single inert_sand layer\n    48\t    assert_eq!(state.substrate_layers.len(), 1);\n    49\t    assert_eq!(\n    50\t        state.substrate_layers[0].kind,\n    51\t        tank_core::SubstrateKind::InertSand\n    52\t    );\n    53\t\n    54\t    // Plants: single fast_stem\n    55\t    assert_eq!(state.plant_guilds.len(), 1);\n    56\t    assert_eq!(state.plant_guilds[0].guild, tank_core::PlantGuild::FastStem);\n    57\t\n    58\t    // Process params should be non-default (loaded from preset)\n    59\t    assert!(state.process_params.k_surface_w_per_m2_k > 0.0);\n    60\t    assert!(state.process_params.k_wall_w_per_m2_k > 0.0);\n    61\t}\n    62\t\n    63\t#[test]\n    64\tfn medium_planted_materializes_with_two_substrates_and_plants() {\n    65\t    let state = tank_scenarios::seeded_state(SimSeed(43), \"medium_planted\")\n    66\t        .expect(\"medium_planted should materialize\");\n    67\t\n    68\t    // Two substrate layers\n    69\t    assert_eq!(state.substrate_layers.len(), 2);\n    70\t    assert_eq!(\n    71\t        state.substrate_layers[0].kind,\n    72\t        tank_core::SubstrateKind::ActivePlanted\n    73\t    );\n    74\t    assert_eq!(\n    75\t        state.substrate_layers[1].kind,\n    76\t        tank_core::SubstrateKind::CoarsePorous\n    77\t    );\n    78\t\n    79\t    // Two plant guilds\n    80\t    assert_eq!(state.plant_guilds.len(), 2);\n    81\t\n    82\t    // Geometry: 60×30, 36cm height, 32cm filled\n    83\t    assert!((state.geometry.length_cm - 60.0).abs() < f64::EPSILON);\n    84\t    assert!((state.geometry.fill_height_cm - 32.0).abs() < f64::EPSILON);\n    85\t\n    86\t    // Volume\n    87\t    let expected_vol = 60.0 * 30.0 * 32.0 / 1000.0;\n    88\t    let actual_vol = state.geometry.water_volume_l();\n    89\t    assert!(\n    90\t        (actual_vol - expected_vol).abs() < 0.01,\n    91\t        \"Expected {expected_vol}L, got {actual_vol}L\"\n    92\t    );\n    93\t}\n    94\t\n    95\t#[test]\n    96\tfn warm_room_materializes_with_high_ambient() {\n    97\t    let state = tank_scenarios::seeded_state(SimSeed(44), \"warm_room\")\n    98\t        .expect(\"warm_room should materialize\");\n    99\t\n   100\t    assert!((state.environment.ambient_temp_c - 29.0).abs() < f64::EPSILON);\n   101\t}\n   102\t\n   103\t#[test]\n   104\tfn deterministic_materialization() {\n   105\t    let state_a = tank_scenarios::seeded_state(SimSeed(99), \"nano_cycle\")\n   106\t        .expect(\"should materialize\");\n   107\t    let state_b = tank_scenarios::seeded_state(SimSeed(99), \"nano_cycle\")\n   108\t        .expect(\"should materialize\");\n   109\t\n   110\t    assert_eq!(state_a, state_b, \"Same seed + scenario must produce identical state\");\n   111\t}\n   112\t\n   113\t#[test]\n   114\tfn unknown_scenario_returns_error() {\n   115\t    let result = tank_scenarios::seeded_state(SimSeed(1), \"nonexistent_scenario\");\n   116\t    assert!(result.is_err());\n   117\t}\n","exit_code":0,"status":"completed"}}
