{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/tests/ambient_temperature_action.rs | sed -n '1,260p'\"","aggregated_output":"     1\tuse tank_core::{Engine, PlayerAction, ProcessParams, SimSeed, SimulationEngine, TankState};\n     2\t\n     3\t/// Helper: build a state with heater enabled at setpoint 24°C, ambient 24°C.\n     4\tfn stable_24c_state(seed: SimSeed) -> TankState {\n     5\t    let mut state = TankState::new(seed);\n     6\t    state.water.temperature_c = 24.0;\n     7\t    state.environment.ambient_temp_c = 24.0;\n     8\t    state.hardware.heater.enabled = true;\n     9\t    state.hardware.heater.setpoint_c = 24.0;\n    10\t    state.hardware.heater.max_watts = 50.0;\n    11\t    state.process_params = ProcessParams::default();\n    12\t    state\n    13\t}\n    14\t\n    15\t#[test]\n    16\tfn ambient_change_causes_gradual_warming() -> Result<(), tank_core::SimError> {\n    17\t    let state = stable_24c_state(SimSeed(1000));\n    18\t    let mut engine = Engine::from_parts(state, vec![]);\n    19\t\n    20\t    // Change ambient from 24°C to 31°C\n    21\t    engine.apply_action(PlayerAction::ChangeAmbientTemperature { target_c: 31.0 })?;\n    22\t    engine.step_hours(1)?;\n    23\t\n    24\t    let snap_1h = engine.snapshot();\n    25\t    // After 1 hour, water should have warmed but NOT jumped to 31°C\n    26\t    assert!(\n    27\t        snap_1h.water_temp_c > 24.0,\n    28\t        \"Water should warm: got {:.3}\",\n    29\t        snap_1h.water_temp_c\n    30\t    );\n    31\t    assert!(\n    32\t        snap_1h.water_temp_c < 31.0,\n    33\t        \"Water should NOT jump to ambient: got {:.3}\",\n    34\t        snap_1h.water_temp_c\n    35\t    );\n    36\t\n    37\t    // After many hours, it should approach 31°C\n    38\t    engine.step_hours(200)?;\n    39\t    let snap_200h = engine.snapshot();\n    40\t    assert!(\n    41\t        snap_200h.water_temp_c > 30.0,\n    42\t        \"After 200h, water should be near ambient 31°C: got {:.3}\",\n    43\t        snap_200h.water_temp_c\n    44\t    );\n    45\t\n    46\t    Ok(())\n    47\t}\n    48\t\n    49\t#[test]\n    50\tfn do_saturation_decreases_with_warming() -> Result<(), tank_core::SimError> {\n    51\t    let state = stable_24c_state(SimSeed(1100));\n    52\t    let mut engine = Engine::from_parts(state, vec![]);\n    53\t\n    54\t    let do_sat_before = engine.snapshot().do_sat_mg_l;\n    55\t\n    56\t    // Warm to 31°C and run\n    57\t    engine.apply_action(PlayerAction::ChangeAmbientTemperature { target_c: 31.0 })?;\n    58\t    engine.step_hours(200)?;\n    59\t\n    60\t    let do_sat_after = engine.snapshot().do_sat_mg_l;\n    61\t    assert!(\n    62\t        do_sat_after < do_sat_before,\n    63\t        \"DO saturation should decrease with warming: before={do_sat_before:.2}, after={do_sat_after:.2}\"\n    64\t    );\n    65\t\n    66\t    Ok(())\n    67\t}\n    68\t\n    69\t#[test]\n    70\tfn heater_output_zero_when_above_setpoint() -> Result<(), tank_core::SimError> {\n    71\t    let state = stable_24c_state(SimSeed(1200));\n    72\t    let mut engine = Engine::from_parts(state, vec![]);\n    73\t\n    74\t    // Change ambient above heater setpoint\n    75\t    engine.apply_action(PlayerAction::ChangeAmbientTemperature { target_c: 31.0 })?;\n    76\t    engine.step_hours(200)?;\n    77\t\n    78\t    let snap = engine.snapshot();\n    79\t    // Water should be well above setpoint by now\n    80\t    assert!(\n    81\t        snap.water_temp_c > 24.0,\n    82\t        \"Water should be above setpoint\"\n    83\t    );\n    84\t    assert!(\n    85\t        snap.last_heater_output_w == 0.0,\n    86\t        \"Heater should be off when water > setpoint: got {:.2}\",\n    87\t        snap.last_heater_output_w\n    88\t    );\n    89\t\n    90\t    Ok(())\n    91\t}\n    92\t\n    93\t#[test]\n    94\tfn heater_never_cools_tank() -> Result<(), tank_core::SimError> {\n    95\t    let mut state = stable_24c_state(SimSeed(1300));\n    96\t    // Set water above setpoint\n    97\t    state.water.temperature_c = 28.0;\n    98\t    state.environment.ambient_temp_c = 28.0;\n    99\t    state.hardware.heater.setpoint_c = 24.0;\n   100\t\n   101\t    let mut engine = Engine::from_parts(state, vec![]);\n   102\t    engine.step_hours(1)?;\n   103\t\n   104\t    let snap = engine.snapshot();\n   105\t    assert!(\n   106\t        snap.last_heater_output_w == 0.0,\n   107\t        \"Heater should not fire when water is above setpoint\"\n   108\t    );\n   109\t    // Temperature should not decrease due to heater (ambient = water temp)\n   110\t    assert!(\n   111\t        snap.water_temp_c >= 27.9,\n   112\t        \"Heater should never cool: got {:.3}\",\n   113\t        snap.water_temp_c\n   114\t    );\n   115\t\n   116\t    Ok(())\n   117\t}\n   118\t\n   119\t#[test]\n   120\tfn heater_fires_when_below_setpoint() -> Result<(), tank_core::SimError> {\n   121\t    let mut state = stable_24c_state(SimSeed(1400));\n   122\t    state.water.temperature_c = 20.0;\n   123\t    state.environment.ambient_temp_c = 20.0;\n   124\t    state.hardware.heater.setpoint_c = 24.0;\n   125\t\n   126\t    let mut engine = Engine::from_parts(state, vec![]);\n   127\t    engine.step_hours(1)?;\n   128\t\n   129\t    let snap = engine.snapshot();\n   130\t    assert!(\n   131\t        snap.last_heater_output_w > 0.0,\n   132\t        \"Heater should fire when water is below setpoint - deadband/2\"\n   133\t    );\n   134\t    assert!(\n   135\t        snap.water_temp_c > 20.0,\n   136\t        \"Water should warm from heater: got {:.3}\",\n   137\t        snap.water_temp_c\n   138\t    );\n   139\t\n   140\t    Ok(())\n   141\t}\n","exit_code":0,"status":"completed"}}
