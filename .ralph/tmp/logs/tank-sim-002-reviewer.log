{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/src/engine.rs | sed -n '1,260p'\"","aggregated_output":"     1\tuse std::collections::VecDeque;\n     2\t\n     3\tuse crate::{\n     4\t    invariants::enforce_invariants,\n     5\t    rng::SimSeed,\n     6\t    systems,\n     7\t    types::{\n     8\t        EventCause, EventKind, EventSeverity, PlayerAction, SimError, SimEvent, TankSnapshot,\n     9\t        TankState,\n    10\t    },\n    11\t};\n    12\t\n    13\tpub trait SimulationEngine {\n    14\t    fn apply_action(&mut self, action: PlayerAction) -> Result<(), SimError>;\n    15\t    fn step_hours(&mut self, hours: u32) -> Result<(), SimError>;\n    16\t    fn snapshot(&self) -> TankSnapshot;\n    17\t    fn full_state(&self) -> &TankState;\n    18\t}\n    19\t\n    20\t#[derive(Debug, Clone, PartialEq)]\n    21\tpub struct Engine {\n    22\t    state: TankState,\n    23\t    queued_actions: VecDeque<PlayerAction>,\n    24\t}\n    25\t\n    26\timpl Engine {\n    27\t    pub fn new(seed: SimSeed) -> Self {\n    28\t        Self {\n    29\t            state: TankState::new(seed),\n    30\t            queued_actions: VecDeque::new(),\n    31\t        }\n    32\t    }\n    33\t\n    34\t    pub fn from_parts(state: TankState, queued_actions: Vec<PlayerAction>) -> Self {\n    35\t        Self {\n    36\t            state,\n    37\t            queued_actions: queued_actions.into(),\n    38\t        }\n    39\t    }\n    40\t\n    41\t    pub fn queued_actions(&self) -> Vec<PlayerAction> {\n    42\t        self.queued_actions.iter().cloned().collect()\n    43\t    }\n    44\t\n    45\t    fn step_one_hour(&mut self) -> Result<(), SimError> {\n    46\t        // Pre-validate all water changes for known source profiles before any mutations.\n    47\t        let actions_slice: Vec<_> = self.queued_actions.iter().cloned().collect();\n    48\t        systems::water_change::validate_water_changes(&self.state, &actions_slice)?;\n    49\t\n    50\t        // Process all queued actions\n    51\t        while let Some(action) = self.queued_actions.pop_front() {\n    52\t            self.process_action(action);\n    53\t        }\n    54\t\n    55\t        // Step 4: update water temperature from ambient and heater\n    56\t        systems::temperature::step_temperature(&mut self.state);\n    57\t\n    58\t        // Advance time\n    59\t        self.state.environment.hour_of_day = (self.state.environment.hour_of_day + 1) % 24;\n    60\t        if self.state.environment.hour_of_day == 0 {\n    61\t            self.state.environment.day += 1;\n    62\t        }\n    63\t\n    64\t        enforce_invariants(&mut self.state)\n    65\t    }\n    66\t\n    67\t    fn process_action(&mut self, action: PlayerAction) {\n    68\t        match action {\n    69\t            PlayerAction::Feed { grams } => {\n    70\t                self.state.detritus.particulate_organics_g_total += grams;\n    71\t                self.push_event(\n    72\t                    EventSeverity::Info,\n    73\t                    EventKind::CycleProgressing,\n    74\t                    vec![EventCause::Overfeeding],\n    75\t                    format!(\"Queued feed processed: {grams:.2} g\"),\n    76\t                );\n    77\t            }\n    78\t            PlayerAction::WaterChangePercent {\n    79\t                percent,\n    80\t                source_profile_id,\n    81\t            } => {\n    82\t                if percent <= 0.0 {\n    83\t                    return;\n    84\t                }\n    85\t                // Profile was pre-validated; look it up (guaranteed to exist).\n    86\t                let profile = self\n    87\t                    .state\n    88\t                    .source_water_catalog\n    89\t                    .get(&source_profile_id)\n    90\t                    .cloned();\n    91\t                if let Some(profile) = profile {\n    92\t                    systems::water_change::apply_water_change(\n    93\t                        &mut self.state,\n    94\t                        percent,\n    95\t                        &profile,\n    96\t                    );\n    97\t                    self.push_event(\n    98\t                        EventSeverity::Info,\n    99\t                        EventKind::StabilityImproving,\n   100\t                        vec![EventCause::WaterChange],\n   101\t                        format!(\"Water change processed: {percent:.1}% with {source_profile_id}\"),\n   102\t                    );\n   103\t                }\n   104\t            }\n   105\t            PlayerAction::TrimPlants { fraction } => {\n   106\t                for plant in &mut self.state.plant_guilds {\n   107\t                    plant.biomass_g *= 1.0 - fraction;\n   108\t                }\n   109\t            }\n   110\t            PlayerAction::SiphonDetritus { fraction } => {\n   111\t                self.state.detritus.particulate_organics_g_total *= 1.0 - fraction;\n   112\t                self.state.detritus.fine_detritus_g_total *= 1.0 - fraction;\n   113\t            }\n   114\t            PlayerAction::CleanFilter { intensity } => {\n   115\t                self.state.hardware.filter.cleanliness_index = 1.0;\n   116\t                self.state.filter_state.biofilter_maturity_index *= 1.0 - (intensity * 0.5);\n   117\t                self.state.filter_state.clogging_index *= 1.0 - intensity;\n   118\t                self.push_event(\n   119\t                    EventSeverity::Warning,\n   120\t                    EventKind::FilterCleaningSetback,\n   121\t                    vec![EventCause::FilterMaintenance],\n   122\t                    format!(\"Filter cleaned at intensity {intensity:.2}\"),\n   123\t                );\n   124\t            }\n   125\t            PlayerAction::AddShrimp { count } => {\n   126\t                self.state.animal.adults_count =\n   127\t                    self.state.animal.adults_count.saturating_add(count);\n   128\t            }\n   129\t            PlayerAction::RemoveShrimp { count } => {\n   130\t                self.state.animal.adults_count =\n   131\t                    self.state.animal.adults_count.saturating_sub(count);\n   132\t            }\n   133\t            PlayerAction::ChangePhotoperiod { hours } => {\n   134\t                self.state.hardware.light.photoperiod_hours = hours;\n   135\t            }\n   136\t            PlayerAction::ChangeLightIntensity { intensity_index } => {\n   137\t                self.state.hardware.light.intensity_index = intensity_index;\n   138\t            }\n   139\t            PlayerAction::ChangeHeaterSetpoint { setpoint_c } => {\n   140\t                self.state.hardware.heater.setpoint_c = setpoint_c;\n   141\t            }\n   142\t            PlayerAction::ChangeAmbientTemperature { target_c } => {\n   143\t                self.state.environment.ambient_temp_c = target_c;\n   144\t            }\n   145\t            PlayerAction::ChangeAeration { enabled, intensity } => {\n   146\t                self.state.hardware.aeration.enabled = enabled;\n   147\t                self.state.hardware.aeration.intensity = intensity;\n   148\t            }\n   149\t        }\n   150\t    }\n   151\t\n   152\t    fn push_event(\n   153\t        &mut self,\n   154\t        severity: EventSeverity,\n   155\t        kind: EventKind,\n   156\t        cause_codes: Vec<EventCause>,\n   157\t        summary: String,\n   158\t    ) {\n   159\t        self.state.event_log.push(SimEvent::new(\n   160\t            self.state.environment.day,\n   161\t            self.state.environment.hour_of_day,\n   162\t            severity,\n   163\t            kind,\n   164\t            cause_codes,\n   165\t            summary,\n   166\t        ));\n   167\t    }\n   168\t}\n   169\t\n   170\timpl SimulationEngine for Engine {\n   171\t    fn apply_action(&mut self, action: PlayerAction) -> Result<(), SimError> {\n   172\t        action.validate()?;\n   173\t        self.queued_actions.push_back(action);\n   174\t        Ok(())\n   175\t    }\n   176\t\n   177\t    fn step_hours(&mut self, hours: u32) -> Result<(), SimError> {\n   178\t        for _ in 0..hours {\n   179\t            self.step_one_hour()?;\n   180\t        }\n   181\t        enforce_invariants(&mut self.state)\n   182\t    }\n   183\t\n   184\t    fn snapshot(&self) -> TankSnapshot {\n   185\t        TankSnapshot::from_state(&self.state)\n   186\t    }\n   187\t\n   188\t    fn full_state(&self) -> &TankState {\n   189\t        &self.state\n   190\t    }\n   191\t}\n","exit_code":0,"status":"completed"}}
