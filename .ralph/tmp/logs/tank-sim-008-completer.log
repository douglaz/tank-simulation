   45\t\n    46\t    materialize_scenario(seed, scenario)\n    47\t}\n    48\t\n    49\t/// Converts a `tank_data::SourceWaterPreset` into a `tank_core::SourceWaterProfile`.\n    50\tfn source_water_to_profile(preset: &tank_data::SourceWaterPreset) -> SourceWaterProfile {\n    51\t    SourceWaterProfile {\n    52\t        temperature_c: preset.temperature_c,\n    53\t        ammonia_mg_n_per_l: preset.ammonia_mg_n_per_l,\n    54\t        nitrite_mg_n_per_l: preset.nitrite_mg_n_per_l,\n    55\t        nitrate_mg_n_per_l: preset.nitrate_mg_n_per_l,\n    56\t        phosphate_mg_p_per_l: preset.phosphate_mg_p_per_l,\n    57\t        dic_mg_c_per_l: preset.dic_mg_c_per_l,\n    58\t        doc_mg_c_per_l: preset.doc_mg_c_per_l,\n    59\t        don_mg_n_per_l: preset.don_mg_n_per_l,\n    60\t        alkalinity_meq_per_l: preset.alkalinity_meq_per_l,\n    61\t        calcium_mg_per_l: preset.calcium_mg_per_l,\n    62\t        magnesium_mg_per_l: preset.magnesium_mg_per_l,\n    63\t        sodium_mg_per_l: preset.sodium_mg_per_l,\n    64\t        potassium_mg_per_l: preset.potassium_mg_per_l,\n    65\t        bicarbonate_mg_per_l: preset.bicarbonate_mg_per_l,\n    66\t        chloride_mg_per_l: preset.chloride_mg_per_l,\n    67\t        sulfate_mg_per_l: preset.sulfate_mg_per_l,\n    68\t    }\n    69\t}\n    70\t\n    71\t/// Converts a `tank_data::ProcessParamsPreset` into `tank_core::ProcessParams`.\n    72\tfn process_preset_to_params(preset: &tank_data::ProcessParamsPreset) -> ProcessParams {\n    73\t    ProcessParams {\n    74\t        mineralization_rate_per_day: preset.mineralization_rate_per_day,\n    75\t        nitrification_vmax: preset.nitrification_vmax,\n    76\t        reaeration_kla_base: preset.reaeration_kla_base,\n    77\t        aeration_kla_boost: preset.aeration_kla_boost,\n    78\t        background_bod_mg_o2_per_g_biomass_per_hour: preset\n    79\t            .background_bod_mg_o2_per_g_biomass_per_hour,\n    80\t        plant_photosynthesis_o2_mg_per_g_per_hour: preset.plant_photosynthesis_o2_mg_per_g_per_hour,\n    81\t        respiration_dic_rate_mg_c_per_g_per_hour: preset.respiration_dic_rate_mg_c_per_g_per_hour,\n    82\t        photosynthesis_dic_rate_mg_c_per_g_per_hour: preset\n    83\t            .photosynthesis_dic_rate_mg_c_per_g_per_hour,\n    84\t        k_surface_w_per_m2_k: preset.k_surface_w_per_m2_k,\n    85\t        k_wall_w_per_m2_k: preset.k_wall_w_per_m2_k,\n    86\t\n    87\t        feed_leach_rate_per_hour: preset.feed_leach_rate_per_hour,\n    88\t        fine_detritus_dissolution_rate_per_hour: preset.fine_detritus_dissolution_rate_per_hour,\n    89\t        feed_n_to_c_ratio: preset.feed_n_to_c_ratio,\n    90\t\n    91\t        decomposer_vmax_per_hour: preset.decomposer_vmax_per_hour,\n    92\t        decomposer_k_doc_mg: preset.decomposer_k_doc_mg,\n    93\t        decomposer_growth_yield: preset.decomposer_growth_yield,\n    94\t        decomposer_decay_rate_per_hour: preset.decomposer_decay_rate_per_hour,\n    95\t\n    96\t        aob_vmax_mg_n_per_g_per_hour: preset.aob_vmax_mg_n_per_g_per_hour,\n    97\t        aob_k_tan_mg: preset.aob_k_tan_mg,\n    98\t        aob_k_do_mg: preset.aob_k_do_mg,\n    99\t        aob_growth_yield: preset.aob_growth_yield,\n   100\t        aob_decay_rate_per_hour: preset.aob_decay_rate_per_hour,\n   101\t\n   102\t        nob_vmax_mg_n_per_g_per_hour: preset.nob_vmax_mg_n_per_g_per_hour,\n   103\t        nob_k_nitrite_mg: preset.nob_k_nitrite_mg,\n   104\t        nob_k_do_mg: preset.nob_k_do_mg,\n   105\t        nob_growth_yield: preset.nob_growth_yield,\n   106\t        nob_decay_rate_per_hour: preset.nob_decay_rate_per_hour,\n   107\t\n   108\t        comammox_vmax_fraction: preset.comammox_vmax_fraction,\n   109\t        comammox_k_tan_mg: preset.comammox_k_tan_mg,\n   110\t        comammox_k_do_mg: preset.comammox_k_do_mg,\n   111\t        comammox_growth_yield: preset.comammox_growth_yield,\n   112\t        comammox_decay_rate_per_hour: preset.comammox_decay_rate_per_hour,\n   113\t\n   114\t        o2_per_mg_n_nitrified: preset.o2_per_mg_n_nitrified,\n   115\t        alkalinity_meq_per_mg_n_nitrified: preset.alkalinity_meq_per_mg_n_nitrified,\n   116\t\n   117\t        plant_max_growth_rate_fast_stem_per_day: preset.plant_max_growth_rate_fast_stem_per_day,\n   118\t        plant_max_growth_rate_root_rosette_per_day: preset\n   119\t            .plant_max_growth_rate_root_rosette_per_day,\n   120\t        plant_respiration_fraction_per_day: preset.plant_respiration_fraction_per_day,\n   121\t        plant_senescence_fraction_per_day: preset.plant_senescence_fraction_per_day,\n   122\t        plant_health_recovery_per_day: preset.plant_health_recovery_per_day,\n   123\t        plant_health_decline_per_day: preset.plant_health_decline_per_day,\n   124\t        plant_half_saturation_n_mg_total: preset.plant_half_saturation_n_mg_total,\n   125\t        plant_half_saturation_p_mg_total: preset.plant_half_saturation_p_mg_total,\n   126\t        plant_half_saturation_c_mg_total: preset.plant_half_saturation_c_mg_total,\n   127\t        plant_light_half_saturation: preset.plant_light_half_saturation,\n   128\t        plant_temp_optimum_c: preset.plant_temp_optimum_c,\n   129\t        plant_temp_sigma_c: preset.plant_temp_sigma_c,\n   130\t        plant_crowding_biomass_g_per_m2: preset.plant_crowding_biomass_g_per_m2,\n   131\t\n   132\t        algae_max_growth_rate_per_day: preset.algae_max_growth_rate_per_day,\n   133\t        periphyton_max_growth_rate_per_day: preset.periphyton_max_growth_rate_per_day,\n   134\t        algae_respiration_fraction_per_day: preset.algae_respiration_fraction_per_day,\n   135\t        algae_half_saturation_n_mg_total: preset.algae_half_saturation_n_mg_total,\n   136\t        algae_half_saturation_p_mg_total: preset.algae_half_saturation_p_mg_total,\n   137\t        algae_light_half_saturation: preset.algae_light_half_saturation,\n   138\t        algae_temp_optimum_c: preset.algae_temp_optimum_c,\n   139\t        algae_temp_sigma_c: preset.algae_temp_sigma_c,\n   140\t        periphyton_capacity_g_per_m2: preset.periphyton_capacity_g_per_m2,\n   141\t        algae_bloom_threshold_g_per_l: preset.algae_bloom_threshold_g_per_l,\n   142\t        algae_nuisance_biomass_g_per_m2: preset.algae_nuisance_biomass_g_per_m2,\n   143\t\n   144\t        shrimp_base_mortality_per_day: preset.shrimp_base_mortality_per_day,\n   145\t        shrimp_stress_mortality_scale: preset.shrimp_stress_mortality_scale,\n   146\t        shrimp_juvenile_maturation_days: preset.shrimp_juvenile_maturation_days,\n   147\t        shrimp_periphyton_grazing_g_per_shrimp_per_day: preset\n   148\t            .shrimp_periphyton_grazing_g_per_shrimp_per_day,\n   149\t        shrimp_condition_smoothing: preset.shrimp_condition_smoothing,\n   150\t\n   151\t        microfauna_mineralization_boost: preset.microfauna_mineralization_boost,\n   152\t        microfauna_periphyton_consumption: preset.microfauna_periphyton_consumption,\n   153\t        microfauna_population_smoothing: preset.microfauna_population_smoothing,\n   154\t        microfauna_shrimp_pressure_threshold: preset.microfauna_shrimp_pressure_threshold,\n   155\t    }\n   156\t}\n   157\t\n   158\t/// Materializes a scenario preset into a fully resolved `TankState`.\n   159\t///\n   160\t/// - Geometry comes from the scenario.\n   161\t/// - `environment.ambient_temp_c` comes from the scenario.\n   162\t/// - Initial `WaterState` totals come from the source-water profile × fill volume.\n   163\t/// - Substrate layers come from the scenario's substrate preset IDs.\n   164\t/// - Plant guilds come from the scenario's plant preset IDs.\n   165\t/// - Source-water catalog is populated with all known source-water presets.\n   166\t/// - Process parameters come from the scenario's process params preset.\n   167\tpub fn seeded_state(seed: SimSeed, scenario_id: &str) -> Result<TankState, tank_data::PresetError> {\n   168\t    let scenario = load_named_scenario(scenario_id)?;\n   169\t    materialize_scenario(seed, scenario)\n   170\t}\n   171\t\n   172\tfn materialize_scenario(\n   173\t    seed: SimSeed,\n   174\t    scenario: ScenarioPreset,\n   175\t) -> Result<TankState, tank_data::PresetError> {\n   176\t    // Geometry\n   177\t    let geometry = TankGeometry {\n   178\t        length_cm: scenario.tank_length_cm,\n   179\t        width_cm: scenario.tank_width_cm,\n   180\t        height_cm: scenario.tank_height_cm,\n   181\t        fill_height_cm: scenario.fill_height_cm,\n   182\t        glass_thickness_mm: 5.0,\n   183\t        open_top: true,\n   184\t        lid_exchange_factor: 0.25,\n   185\t    };\n   186\t\n   187\t    // Source water profile for initial fill\n   188\t    let source_water_preset = tank_data::load_source_water(&scenario.source_water_id)?;\n   189\t    let source_profile = source_water_to_profile(&source_water_preset);\n   190\t\n   191\t    // Initial water state from source-water profile\n   192\t    let water = WaterState::from_source_profile(&source_profile, &geometry);\n   193\t\n   194\t    // Build source-water catalog with all known presets\n   195\t    let mut source_water_catalog = BTreeMap::new();\n   196\t    for sw_id in tank_data::source_water_ids() {\n   197\t        let sw_preset = tank_data::load_source_water(sw_id)?;\n   198\t        source_water_catalog.insert(sw_id.to_string(), source_water_to_profile(&sw_preset));\n   199\t    }\n   200\t\n   201\t    // Process parameters\n   202\t    let process_preset = tank_data::load_process_params(&scenario.process_params_id)?;\n   203\t    let process_params = process_preset_to_params(&process_preset);\n   204\t\n   205\t    // Substrate layers\n   206\t    let mut substrate_layers = Vec::new();\n   207\t    for sub_id in &scenario.substrate_ids {\n   208\t        let sub_preset = tank_data::load_substrate(sub_id)?;\n   209\t        let footprint = geometry.footprint_area_cm2();\n   210\t        substrate_layers.push(SubstrateLayerState {\n   211\t            kind: match sub_preset.id.as_str() {\n   212\t                \"inert_sand\" => tank_core::SubstrateKind::InertSand,\n   213\t                \"inert_gravel\" => tank_core::SubstrateKind::InertGravel,\n   214\t                \"active_planted\" => tank_core::SubstrateKind::ActivePlanted,\n   215\t                \"coarse_porous\" => tank_core::SubstrateKind::CoarsePorous,\n   216\t                other => {\n   217\t                    return Err(tank_data::PresetError::Validation {\n   218\t                        category: \"substrate\",\n   219\t                        id: other.to_string(),\n   220\t                        message: format!(\"unsupported substrate kind: `{other}`\"),\n   221\t                    });\n   222\t                }\n   223\t            },\n   224\t            depth_cm: sub_preset.depth_cm,\n   225\t            nutrient_store_mg_n_total: sub_preset.nutrient_charge_mg_n_total,\n   226\t            nutrient_store_mg_p_total: sub_preset.nutrient_charge_mg_p_total,\n   227\t            cation_exchange_capacity_index: sub_preset.cation_exchange_capacity_index,\n   228\t            detritus_trapping_index: sub_preset.detritus_trapping_index,\n   229\t            colonizable_area_cm2: footprint * sub_preset.colonizable_area_factor,\n   230\t            low_oxygen_tendency_index: sub_preset.low_oxygen_tendency_index,\n   231\t            grazing_surface_index: sub_preset.grazing_surface_index,\n   232\t        });\n   233\t    }\n   234\t    if substrate_layers.is_empty() {\n   235\t        substrate_layers.push(SubstrateLayerState::default());\n   236\t    }\n   237\t\n   238\t    // Plant guilds\n   239\t    let mut plant_guilds = Vec::new();\n   240\t    for plant_id in &scenario.plant_ids {\n   241\t        let plant_preset = tank_data::load_plant(plant_id)?;\n   242\t        let guild = match plant_preset.guild.as_str() {\n   243\t            \"FastStem\" => PlantGuild::FastStem,\n   244\t            \"RootFeedingRosette\" => PlantGuild::RootFeedingRosette,\n   245\t            other => {\n   246\t                return Err(tank_data::PresetError::Validation {\n   247\t                    category: \"plants\",\n   248\t                    id: plant_id.clone(),\n   249\t                    message: format!(\"unsupported plant guild: `{other}`\"),\n   250\t                });\n   251\t            }\n   252\t        };\n   253\t        plant_guilds.push(PlantGuildState {\n   254\t            guild,\n   255\t            biomass_g: 5.0,\n   256\t            health_index: 0.8,\n   257\t            crowding_index: 0.1,\n   258\t            habitat_index: if guild == PlantGuild::RootFeedingRosette {\n   259\t                // Habitat factor depends on substrate quality\n   260\t                substrate_layers\n   261\t                    .iter()\n   262\t                    .map(|l| l.cation_exchange_capacity_index)\n   263\t                    .fold(0.0_f64, f64::max)\n   264\t                    .max(0.3)\n   265\t            } else {\n   266\t                0.8\n   267\t            },\n   268\t        });\n   269\t    }\n   270\t    if plant_guilds.is_empty() {\n   271\t        plant_guilds.push(PlantGuildState::default());\n   272\t    }\n   273\t\n   274\t    // Shrimp species parameters\n   275\t    let shrimp_preset = tank_data::load_shrimp(&scenario.shrimp_profile_id)?;\n   276\t    let shrimp_params = ShrimpRuntimeParams {\n   277\t        optimal_temp_min_c: shrimp_preset.optimal_temp_min_c,\n   278\t        optimal_temp_max_c: shrimp_preset.optimal_temp_max_c,\n   279\t        gh_min_d: shrimp_preset.gh_min_d,\n   280\t        gh_max_d: shrimp_preset.gh_max_d,\n   281\t        base_spawn_rate: shrimp_preset.base_spawn_rate,\n   282\t        egg_duration_days: shrimp_preset.egg_duration_days,\n   283\t        hatch_success_base: shrimp_preset.hatch_success_base,\n   284\t        juvenile_sensitivity: shrimp_preset.juvenile_sensitivity,\n   285\t        high_temp_repro_penalty_start_c: shrimp_preset.high_temp_repro_penalty_start_c,\n   286\t        high_temp_repro_penalty_full_c: shrimp_preset.high_temp_repro_penalty_full_c,\n   287\t    };\n   288\t\n   289\t    // Environment\n   290\t    let environment = tank_core::EnvironmentState {\n   291\t        ambient_temp_c: scenario.ambient_temp_c,\n   292\t        ..Default::default()\n   293\t    };\n   294\t\n   295\t    let mut state = TankState::new(seed);\n   296\t    state.meta = SimMeta {\n   297\t        scenario_id: Some(scenario.id),\n   298\t        notes: Some(scenario.name),\n   299\t    };\n   300\t    state.geometry = geometry;\n   301\t    state.environment = environment;\n   302\t    state.water = water;\n   303\t    state.substrate_layers = substrate_layers;\n   304\t    state.plant_guilds = plant_guilds;\n   305\t    state.source_water_catalog = source_water_catalog;\n   306\t    state.process_params = process_params;\n   307\t    state.shrimp_params = shrimp_params;\n   308\t\n   309\t    Ok(state)\n   310\t}\n   311\t\n   312\tfn validate_geometry_overrides(\n   313\t    scenario_id: &str,\n   314\t    overrides: ScenarioGeometryOverrides,\n   315\t) -> Result<(), tank_data::PresetError> {\n   316\t    if !overrides.size_scale.is_finite() || overrides.size_scale <= 0.0 {\n   317\t        return Err(tank_data::PresetError::Validation {\n   318\t            category: \"scenarios\",\n   319\t            id: scenario_id.to_string(),\n   320\t            message: format!(\n","exit_code":0,"status":"completed"}}
