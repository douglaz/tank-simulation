    Self {\n    53\t            enabled: true,\n    54\t            photoperiod_hours: 8.0,\n    55\t            intensity_index: 0.7,\n    56\t        }\n    57\t    }\n    58\t}\n    59\t\n    60\timpl Default for HeaterState {\n    61\t    fn default() -> Self {\n    62\t        Self {\n    63\t            enabled: false,\n    64\t            setpoint_c: 24.0,\n    65\t            deadband_c: 0.5,\n    66\t            max_watts: 50.0,\n    67\t            efficiency: 1.0,\n    68\t            last_output_w: 0.0,\n    69\t        }\n    70\t    }\n    71\t}\n    72\t\n    73\timpl Default for FilterHardware {\n    74\t    fn default() -> Self {\n    75\t        Self {\n    76\t            enabled: true,\n    77\t            flow_lph: 200.0,\n    78\t            cleanliness_index: 1.0,\n    79\t        }\n    80\t    }\n    81\t}\n    82\t\n    83\timpl Default for AerationState {\n    84\t    fn default() -> Self {\n    85\t        Self {\n    86\t            enabled: false,\n    87\t            intensity: 0.0,\n    88\t        }\n    89\t    }\n    90\t}\n    91\t\n    92\timpl Default for FilterState {\n    93\t    fn default() -> Self {\n    94\t        Self {\n    95\t            biofilter_maturity_index: 0.1,\n    96\t            clogging_index: 0.0,\n    97\t            seeded_biomass_index: 0.0,\n    98\t        }\n    99\t    }\n   100\t}\n","exit_code":0,"status":"completed"}}
