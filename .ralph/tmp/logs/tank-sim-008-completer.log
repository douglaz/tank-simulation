ntTemperature { target_c } => {\n   121→                validate_temperature(\"target_c\", *target_c)\n   122→            }\n   123→            Self::ChangeAeration { intensity, .. } => validate_fraction(\"intensity\", *intensity),\n   124→        }\n   125→    }\n   126→}\n   127→\n   128→fn field_name(action: &PlayerAction) -> &'static str {\n   129→    match action {\n   130→        PlayerAction::TrimPlants { .. } => \"fraction\",\n   131→        PlayerAction::SiphonDetritus { .. } => \"fraction\",\n   132→        PlayerAction::CleanFilter { .. } => \"intensity\",\n   133→        _ => \"value\",\n   134→    }\n   135→}\n   136→\n   137→fn validate_non_negative(field: &'static str, value: f64) -> Result<(), SimError> {\n   138→    validate_finite(field, value)?;\n   139→    if value < 0.0 {\n   140→        Err(SimError::NegativeValue { field, value })\n   141→    } else {\n   142→        Ok(())\n   143→    }\n   144→}\n   145→\n   146→fn validate_fraction(field: &'static str, value: f64) -> Result<(), SimError> {\n   147→    validate_finite(field, value)?;\n   148→    if (0.0..=1.0).contains(&value) {\n   149→        Ok(())\n   150→    } else {\n   151→        Err(SimError::FractionOutOfRange { field, value })\n   152→    }\n   153→}\n   154→\n   155→fn validate_percent(field: &'static str, value: f64) -> Result<(), SimError> {\n   156→    validate_finite(field, value)?;\n   157→    if (0.0..=100.0).contains(&value) {\n   158→        Ok(())\n   159→    } else {\n   160→        Err(SimError::PercentOutOfRange { field, value })\n   161→    }\n   162→}\n   163→\n   164→fn validate_temperature(field: &'static str, value: f64) -> Result<(), SimError> {\n   165→    validate_finite(field, value)?;\n   166→    if value > 0.0 {\n   167→        Ok(())\n   168→    } else {\n   169→        Err(SimError::TemperatureTooLow { field, value })\n   170→    }\n   171→}\n   172→\n   173→fn validate_finite(field: &'static str, value: f64) -> Result<(), SimError> {\n   174→    if value