{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0121tAWvq6Z1VR69gim48YDo","type":"tool_result","content":"     1→use std::collections::VecDeque;\n     2→\n     3→use crate::{\n     4→    invariants::enforce_invariants,\n     5→    rng::SimSeed,\n     6→    systems,\n     7→    types::{\n     8→        EventCause, EventKind, EventSeverity, PlayerAction, SimError, SimEvent, TankSnapshot,\n     9→        TankState,\n    10→    },\n    11→};\n    12→\n    13→pub trait SimulationEngine {\n    14→    fn apply_action(&mut self, action: PlayerAction) -> Result<(), SimError>;\n    15→    fn step_hours(&mut self, hours: u32) -> Result<(), SimError>;\n    16→    fn snapshot(&self) -> TankSnapshot;\n    17→    fn full_state(&self) -> &TankState;\n    18→}\n    19→\n    20→#[derive(Debug, Clone, PartialEq)]\n    21→pub struct Engine {\n    22→    state: TankState,\n    23→    queued_actions: VecDeque<PlayerAction>,\n    24→}\n    25→\n    26→impl Engine {\n    27→    pub fn new(seed: SimSeed) -> Self {\n    28→        Self {\n    29→            state: TankState::new(seed),\n    30→            queued_actions: VecDeque::new(),\n    31→        }\n    32→    }\n    33→\n    34→    pub fn from_parts(state: TankState, queued_actions: Vec<PlayerAction>) -> Self {\n    35→        Self {\n    36→            state,\n    37→            queued_actions: queued_actions.into(),\n    38→        }\n    39→    }\n    40→\n    41→    pub fn queued_actions(&self) -> Vec<PlayerAction> {\n    42→        self.queued_actions.iter().cloned().collect()\n    43→    }\n    44→\n    45→    fn step_one_hour(&mut self) -> Result<(), SimError> {\n    46→        let actions_slice: Vec<_> = self.queued_actions.iter().cloned().collect();\n    47→        systems::water_change::validate_water_changes(&self.state, &actions_slice)?;\n    48→\n    49→        while let Some(action) = self.queued_actions.pop_front() {\n    50→            self.process_action(action);\n    51→        }\n    52→\n    53→        // Step 4: update water temperature from ambient and heater\n    54→        systems::temperature::step_temperature(&mut self.state);\n    55→\n    56→        // Step 5: compute light state for the current hour.\n    57→        let light_on = self.state.hardware.light.enabled\n    58→            && systems::light::is_light_on(\n    59→                self.state.environment.hour_of_day,\n    60→                self.state.hardware.light.photoperiod_hours,\n    61→            );\n    62→\n    63→        // Step 6-8: nitrogen cycle phase (feed leaching, detritus breakdown,\n    64→        // mineralization, nitrification, guild growth/decay).\n    65→        // This runs between light-state resolution and chemistry/DO/event phases.\n    66→        // Nitrification O2 consumption and alkalinity depletion are handled\n    67→        // internally by the nitrogen cycle system.\n    68→        let _nc_output = systems::nitrogen_cycle::step_nitrogen_cycle(&mut self.state);\n    69→\n    70→        // Step 9: update DIC, alkalinity, and pH.\n    71→        systems::chemistry::step_hourly_chemistry(&mut self.state, light_on);\n    72→\n    73→        // Step 10 / 11-partial: update dissolved oxygen with background respiration and\n    74→        // light-driven photosynthetic support from existing biomass.\n    75→        systems::dissolved_oxygen::step_dissolved_oxygen(&mut self.state, light_on);\n    76→\n    77→        // Step 12: hourly shrimp stress accumulation.\n    78→        systems::shrimp::step_hourly_shrimp_stress(&mut self.state);\n    79→\n    80→        // Step 13: emit threshold-based chemistry warnings.\n    81→        systems::events::emit_hourly_threshold_events(&mut self.state);\n    82→\n    83→        self.state.environment.hour_of_day = (self.state.environment.hour_of_day + 1) % 24;\n    84→        if self.state.environment.hour_of_day == 0 {\n    85→            self.state.environment.day += 1;\n    86→            // Daily pipeline\n    87→            self.run_daily_update();\n    88→        }\n    89→\n    90→        enforce_invariants(&mut self.state)\n    91→    }\n    92→\n    93→    fn run_daily_update(&mut self) {\n    94→        // Daily pipeline: plants → algae → microfauna → shrimp → biofilter → stability\n    95→        systems::plant_growth::step_daily_plants(&mut self.state);\n    96→        systems::algae_growth::step_daily_algae(&mut self.state);\n    97→        systems::microfauna::step_daily_microfauna(&mut self.state);\n    98→        systems::shrimp::step_daily_shrimp(&mut self.state);\n    99→\n   100→        // Biofilter maturity summary update\n   101→        let maturity_delta =\n   102→            systems::nitrogen_cycle::update_daily_biofilter_maturity(&mut self.state);\n   103→        if maturity_delta > 0.005 {\n   104→            self.push_event(\n   105→                EventSeverity::Info,\n   106→                EventKind::BiofilmMaturityIncrease,\n   107→                vec![EventCause::BiofilterImmature],\n   108→                format!(\n   109→                    \"Biofilter maturity increased to {:.3}\",\n   110→                    self.state.filter_state.biofilter_maturity_index\n   111→                ),\n   112→            );\n   113→        }\n   114→        // Emit CycleProgressing when maturity is actively growing\n   115→        let current_maturity = self.state.filter_state.biofilter_maturity_index;\n   116→        if maturity_delta > 0.001 && current_maturity < 0.9 {\n   117→            systems::events::emit_once_per_day_pub(\n   118→                &mut self.state,\n   119→                EventSeverity::Info,\n   120→                EventKind::CycleProgressing,\n   121→                vec![EventCause::BiofilterImmature],\n   122→                format!(\"Nitrogen cycle progressing, maturity {current_maturity:.3}\"),\n   123→            );\n   124→        }\n   125→\n   126→        // Long-term stability metrics\n   127→        systems::shrimp::update_stability_tracker(&mut self.state);\n   128→    }\n   129→\n   130→    fn process_action(&mut self, action: PlayerAction) {\n   131→        match action {\n   132→            PlayerAction::Feed { grams } => {\n   133→                self.state.detritus.particulate_organics_g_total += grams;\n   134→                self.push_event(\n   135→                    EventSeverity::Info,\n   136→                    EventKind::CycleProgressing,\n   137→                    vec![EventCause::Overfeeding],\n   138→                    format!(\"Queued feed processed: {grams:.2} g\"),\n   139→                );\n   140→            }\n   141→            PlayerAction::WaterChangePercent {\n   142→                percent,\n   143→                source_profile_id,\n   144→            } => {\n   145→                if percent <= 0.0 {\n   146→                    return;\n   147→                }\n   148→                // Profile was pre-validated; look it up (guaranteed to exist).\n   149→                let profile = self\n   150→                    .state\n   151→                    .source_water_catalog\n   152→                    .get(&source_profile_id)\n   153→                    .cloned();\n   154→                if let Some(profile) = profile {\n   155→                    systems::water_change::apply_water_change(&mut self.state, percent, &profile);\n   156→                    self.push_event(\n   157→                        EventSeverity::Info,\n   158→                        EventKind::StabilityImproving,\n   159→                        vec![EventCause::WaterChange],\n   160→                        format!(\"Water change processed: {percent:.1}% with {source_profile_id}\"),\n   161→                    );\n   162→                }\n   163→            }\n   164→            PlayerAction::TrimPlants { fraction } => {\n   165→                let mut trimmed_biomass_g = 0.0;\n   166→                for plant in &mut self.state.plant_guilds {\n   167→                    let trimmed = plant.biomass_g * fraction;\n   168→                    plant.biomass_g -= trimmed;\n   169→                    trimmed_biomass_g += trimmed;\n   170→                }\n   171→                self.state.detritus.fine_detritus_g_total += trimmed_biomass_g;\n   172→            }\n   173→            PlayerAction::SiphonDetritus { fraction } => {\n   174→                self.state.detritus.particulate_organics_g_total *= 1.0 - fraction;\n   175→                self.state.detritus.fine_detritus_g_total *= 1.0 - fraction;\n   176→            }\n   177→            PlayerAction::CleanFilter { intensity } => {\n   178→                self.state.hardware.filter.cleanliness_index = 1.0;\n   179→                self.state.filter_state.biofilter_maturity_index *= 1.0 - (intensity * 0.5);\n   180→                self.state.filter_state.clogging_index *= 1.0 - intensity;\n   181→                // Proportional setback in active nitrifier and decomposer biomass\n   182→                let setback = intensity * 0.5;\n   183→                self.state.microbe.decomposer_biomass_g *= 1.0 - setback;\n   184→                self.state.microbe.ammonia_oxidizer_biomass_g *= 1.0 - setback;\n   185→                self.state.microbe.nitrite_oxidizer_biomass_g *= 1.0 - setback;\n   186→                self.state.microbe.comammox_biomass_g *= 1.0 - setback;\n   187→                self.push_event(\n   188→                    EventSeverity::Warning,\n   189→                    EventKind::FilterCleaningSetback,\n   190→                    vec![EventCause::FilterMaintenance],\n   191→                    format!(\"Filter cleaned at intensity {intensity:.2}\"),\n   192→                );\n   193→            }\n   194→            PlayerAction::AddShrimp { count } => {\n   195→                self.state.animal.adults_count =\n   196→                    self.state.animal.adults_count.saturating_add(count);\n   197→            }\n   198→            PlayerAction::RemoveShrimp { count } => {\n   199→                self.state.animal.adults_count =\n   200→                    self.state.animal.adults_count.saturating_sub(count);\n   201→                // Preserve berried_females_count <= adults_count (also trims egg cohorts)\n   202→                self.state.animal.clamp_berried_to_adults();\n   203→            }\n   204→            PlayerAction::ChangePhotoperiod { hours } => {\n   205→                self.state.hardware.light.photoperiod_hours = hours;\n   206→            }\n   207→            PlayerAction::ChangeLightIntensity { intensity_index } => {\n   208→                self.state.hardware.light.intensity_index = intensity_index;\n   209→            }\n   210→            PlayerAction::ChangeHeaterSetpoint { setpoint_c } => {\n   211→                self.state.hardware.heater.setpoint_c = setpoint_c;\n   212→            }\n   213→            PlayerAction::ChangeAmbientTemperature { target_c } => {\n   214→                self.state.environment.ambient_temp_c = target_c;\n   215→            }\n   216→            PlayerAction::ChangeAeration { enabled, intensity } => {\n   217→                self.state.hardware.aeration.enabled = enabled;\n   218→                self.state.hardware.aeration.intensity = intensity;\n   219→            }\n   220→        }\n   221→    }\n   222→\n   223→    fn push_event(\n   224→        &mut self,\n   225→        severity: EventSeverity,\n   226→        kind: EventKind,\n   227→        cause_codes: Vec<EventCause>,\n   228→        summary: String,\n   229→    ) {\n   230→        self.state.event_log.push(SimEvent::new(\n   231→            self.state.environment.day,\n   232→            self.state.environment.hour_of_day,\n   233→            severity,\n   234→            kind,\n   235→            cause_codes,\n   236→            summary,\n   237→        ));\n   238→    }\n   239→}\n   240→\n   241→impl SimulationEngine for Engine {\n   242→    fn apply_action(&mut self, action: PlayerAction) -> Result<(), SimError> {\n   243→        action.validate()?;\n   244→\n   245→        // State-aware validation for RemoveShrimp\n   246→        if let PlayerAction::RemoveShrimp { count } = &action {\n   247→            let mut available = self.state.animal.adults_count as i64;\n   248→            for queued in &self.queued_actions {\n   249→                match queued {\n   250→                    PlayerAction::RemoveShrimp { count: c } => available -= *c as i64,\n   251→                    PlayerAction::AddShrimp { count: c } => available += *c as i64,\n   252→                    _ => {}\n   253→                }\n   254→            }\n   255→            if (*count as i64) > available {\n   256→                return Err(SimError::ShrimpRemovalExceedsAvailable {\n   257→                    requested: *count,\n   258→                    available: available.max(0) as u32,\n   259→                });\n   260→            }\n   261→        }\n   262→\n   263→        self.queued_actions.push_back(action);\n   264→        Ok(())\n   265→    }\n   266→\n   267→    fn step_hours(&mut self, hours: u32) -> Result<(), SimError> {\n   268→        for _ in 0..hours {\n   269→            self.step_one_hour()?;\n   270→        }\n   271→        enforce_invariants(&mut self.state)\n   272→    }\n   273→\n   274→    fn snapshot(&self) -> TankSnapshot {\n   275→        TankSnapshot::from_state(&self.state)\n   276→    }\n   277→\n   278→    fn full_state(&self) -> &TankState {\n   279→        &self.state\n   280→    }\n   281→}\n   282→"}]},"parent_tool_use_id":"toolu_01YNVA7FgmkLcCKLLvttQAbz","session_id":"7c0cd9fe-375d-4881-87c2-86b174651532","uuid":"b3f15ad6-c7c8-469d-950a-e0f42fe08c12"}
