 {\n    53→    pub adults_count: u32,\n    54→    pub juveniles_count: u32,\n    55→    pub berried_females_count: u32,\n    56→    pub condition_index: f64,\n    57→    pub molt_stress_index: f64,\n    58→    pub reproductive_readiness_index: f64,\n    59→    pub egg_progress_days: f64,\n    60→    /// Per-cohort egg tracking for clutch-resolution invariant.\n    61→    #[serde(default)]\n    62→    pub egg_cohorts: Vec<EggCohort>,\n    63→    /// Hidden hourly stress accumulators, reset after daily processing.\n    64→    #[serde(default)]\n    65→    pub hourly_nh3_stress_accum: f64,\n    66→    #[serde(default)]\n    67→    pub hourly_nitrite_stress_accum: f64,\n    68→    #[serde(default)]\n    69→    pub hourly_low_do_stress_accum: f64,\n    70→    #[serde(default)]\n    71→    pub hourly_heat_stress_accum: f64,\n    72→    #[serde(default)]\n    73→    pub hourly_instability_stress_accum: f64,\n    74→}\n    75→\n    76→/// Species-specific shrimp parameters materialized from ShrimpPreset.\n    77→/// Stored in TankState for deterministic save/load.\n    78→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    79→pub struct ShrimpRuntimeParams {\n    80→    pub optimal_temp_min_c: f64,\n    81→    pub optimal_temp_max_c: f64,\n    82→    pub gh_min_d: f64,\n    83→    pub gh_max_d: f64,\n    84→    pub base_spawn_rate: f64,\n    85→    pub egg_duration_days: u32,\n    86→    pub hatch_success_base: f64,\n    87→    pub juvenile_sensitivity: f64,\n    88→    pub high_temp_repro_penalty_start_c: f64,\n    89→    pub high_temp_repro_penalty_full_c: f64,\n    90→}\n    91→\n    92→/// Tracks recent chemistry swings for shrimp stress calculations.\n    93→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    94→pub struct StabilityTracker {\n    95→    pub prev_temp_c: f64,\n    96→    pub prev_ph: f64,\n    97→    pub prev_gh_d: f64,\n    98→    pub prev_do_mg_l: f64,\n    99→    pub instability_index: f64,\n   100→}\n   101→\n   102→#[derive(