y_nh3_stress_accum: 0.0,\n   164→            hourly_nitrite_stress_accum: 0.0,\n   165→            hourly_low_do_stress_accum: 0.0,\n   166→            hourly_heat_stress_accum: 0.0,\n   167→            hourly_instability_stress_accum: 0.0,\n   168→        }\n   169→    }\n   170→}\n   171→\n   172→impl Default for ShrimpRuntimeParams {\n   173→    fn default() -> Self {\n   174→        Self {\n   175→            optimal_temp_min_c: 22.0,\n   176→            optimal_temp_max_c: 26.0,\n   177→            gh_min_d: 5.0,\n   178→            gh_max_d: 10.0,\n   179→            base_spawn_rate: 0.15,\n   180→            egg_duration_days: 21,\n   181→            hatch_success_base: 0.7,\n   182→            juvenile_sensitivity: 1.5,\n   183→            high_temp_repro_penalty_start_c: 28.0,\n   184→            high_temp_repro_penalty_full_c: 33.0,\n   185→        }\n   186→    }\n   187→}\n   188→\n   189→impl Default for StabilityTracker {\n   190→    fn default() -> Self {\n   191→        Self {\n   192→            prev_temp_c: 25.0,\n   193→            prev_ph: 7.0,\n   194→            prev_gh_d: 7.0,\n   195→            prev_do_mg_l: 8.0,\n   196→            instability_index: 0.0,\n   197→        }\n   198→    }\n   199→}\n   200→\n   201→impl Default for DetritusState {\n   202→    fn default() -> Self {\n   203→        Self {\n   204→            particulate_organics_g_total: 0.0,\n   205→            fine_detritus_g_total: 0.0,\n   206→            dissolved_feed_residue_g_total: 0.0,\n   207→        }\n   208→    }\n   209→}\n   210→\n   211→impl PlantGuildState {\n   212→    pub fn water_column_uptake_bias(&self) -> f64 {\n   213→        match self.guild {\n   214→            PlantGuild::FastStem => 0.9,\n   215→            PlantGuild::RootFeedingRosette => 0.1,\n   216→        }\n   217→    }\n   218→\n   219→    pub fn substrate_uptake_bias(&self) -> f64 {\n   220→        match self.guild {\n   221→            PlantGuild::FastStem => 0.1,\n   222→            PlantGuild::RootFeedingRosette => 0.9,\n   223→        }\n   224→    }\n   225→}\n   226→\n   227→impl AnimalState {\n   228→    /// Ensures `berried_females_count <= adults_count` by trimming\n   229→    /// excess from the newest egg cohorts first.\n   230→    pub fn clamp_berried_to_adults(&mut self) {\n   231→        if self.berried_females_count > self.adults_count {\n   232→            let excess = self.berried_females_count - self.adults_count;\n   233→            self.berried_females_count = self.adults_count;\n   234→            trim_egg_cohorts(&mut self.egg_cohorts, excess);\n   235→        }\n   236→    }\n   237→\n   238→    /// Derives `egg_progress_days` from the most-advanced cohort for display.\n   239→    pub fn sync_egg_progress_from_cohorts(&mut self) {\n   240→        self.egg_progress_days = self\n   241→            .egg_cohorts\n   242→            .iter()\n   243→            .map(|c| c.progress_days)\n   244→            .fold(0.0_f64, f64::max);\n   245→    }\n   246→}\n   247→\n   248→/// Trims `to_remove` berried females from cohorts, starting from the newest (last).\n   249→fn trim_egg_cohorts(cohorts: &mut Vec<EggCohort>, mut to_remove: u32) {\n   250→    while to_remove > 0 && !cohorts.is_empty() {\n   251→        let last = cohorts.last_mut().unwrap();\n   252→        if last.count <= to_remove {\n   253→            to_remove -= last.count;\n   254→            cohorts.pop();\n   255→        } else {\n   256→            last.count -= to_remove;\n   257→            to_remove = 0;\n   258→        }\n   259→    }\n   260→}\n   261→\n   262→pub fn total_colonizable_area_cm2(\n   263→    substrate_layers: &[SubstrateLayerState],\n   264→    wall_area_cm2: f64,\n   265→) -> f64 {\n   266→    wall_area_cm2\n   267→        + substrate_layers\n   268→            .iter()\n   269→            .map(|layer| layer.colonizable_area_cm2)\n   270→            .sum::<f64>()\n   271→}\n   272→"}]},"parent_tool_use_id":"toolu_016hwCVpQd88K2VLKsVuu4Po","session_id