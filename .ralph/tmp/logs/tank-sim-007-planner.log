{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EaqGH1xfNFjhauSdgPvmRE","type":"tool_result","content":"     1→use tank_core::{Engine, PlayerAction, SimError, SimSeed, SimulationEngine, SourceWaterProfile, TankState};\n     2→\n     3→/// Helper: build a state with a known source-water catalog containing `ro_like`.\n     4→fn state_with_ro_like(seed: SimSeed) -> TankState {\n     5→    let mut state = TankState::new(seed);\n     6→    state\n     7→        .source_water_catalog\n     8→        .insert(\"ro_like\".to_string(), SourceWaterProfile::zero());\n     9→    state\n    10→}\n    11→\n    12→#[test]\n    13→fn water_change_50_percent_ro_like_halves_dissolved_totals() -> Result<(), tank_core::SimError> {\n    14→    let state = state_with_ro_like(SimSeed(100));\n    15→    let mut engine = Engine::from_parts(state, vec![]);\n    16→\n    17→    // Record pre-change totals\n    18→    let before = engine.full_state().water.clone();\n    19→\n    20→    // Apply 50% water change with zero-nutrient source\n    21→    engine.apply_action(PlayerAction::WaterChangePercent {\n    22→        percent: 50.0,\n    23→        source_profile_id: \"ro_like\".to_string(),\n    24→    })?;\n    25→    engine.step_hours(1)?;\n    26→\n    27→    let after = &engine.full_state().water;\n    28→\n    29→    // Each dissolved total should be reduced by 50% ± 0.5%\n    30→    let tolerance = 0.005; // 0.5%\n    31→    let expected_ratio = 0.5;\n    32→\n    33→    let checks: Vec<(&str, f64, f64)> = vec![\n    34→        (\n    35→            \"ammonia_total_mg_n_total\",\n    36→            before.ammonia_total_mg_n_total,\n    37→            after.ammonia_total_mg_n_total,\n    38→        ),\n    39→        (\n    40→            \"nitrite_mg_n_total\",\n    41→            before.nitrite_mg_n_total,\n    42→            after.nitrite_mg_n_total,\n    43→        ),\n    44→        (\n    45→            \"nitrate_mg_n_total\",\n    46→            before.nitrate_mg_n_total,\n    47→            after.nitrate_mg_n_total,\n    48→        ),\n    49→        (\n    50→            \"phosphate_mg_p_total\",\n    51→            before.phosphate_mg_p_total,\n    52→            after.phosphate_mg_p_total,\n    53→        ),\n    54→        (\n    55→            \"dissolved_inorganic_carbon_mg_c_total\",\n    56→            before.dissolved_inorganic_carbon_mg_c_total,\n    57→            after.dissolved_inorganic_carbon_mg_c_total,\n    58→        ),\n    59→        (\n    60→            \"calcium_mg_total\",\n    61→            before.calcium_mg_total,\n    62→            after.calcium_mg_total,\n    63→        ),\n    64→        (\n    65→            \"magnesium_mg_total\",\n    66→            before.magnesium_mg_total,\n    67→            after.magnesium_mg_total,\n    68→        ),\n    69→        (\n    70→            \"sodium_mg_total\",\n    71→            before.sodium_mg_total,\n    72→            after.sodium_mg_total,\n    73→        ),\n    74→        (\n    75→            \"potassium_mg_total\",\n    76→            before.potassium_mg_total,\n    77→            after.potassium_mg_total,\n    78→        ),\n    79→        (\n    80→            \"bicarbonate_mg_total\",\n    81→            before.bicarbonate_mg_total,\n    82→            after.bicarbonate_mg_total,\n    83→        ),\n    84→        (\n    85→            \"chloride_mg_total\",\n    86→            before.chloride_mg_total,\n    87→            after.chloride_mg_total,\n    88→        ),\n    89→        (\n    90→            \"sulfate_mg_total\",\n    91→            before.sulfate_mg_total,\n    92→            after.sulfate_mg_total,\n    93→        ),\n    94→    ];\n    95→\n    96→    for (name, before_val, after_val) in &checks {\n    97→        if *before_val > 0.0 {\n    98→            let actual_ratio = after_val / before_val;\n    99→            assert!(\n   100→                (actual_ratio - expected_ratio).abs() < tolerance,\n   101→                \"{name}: expected ratio {expected_ratio} ± {tolerance}, got {actual_ratio} (before={before_val}, after={after_val})\"\n   102→            );\n   103→        } else {\n   104→            // If before was 0.0, after should also be 0.0 (ro_like adds nothing)\n   105→            assert!(\n   106→                after_val.abs() < f64::EPSILON,\n   107→                \"{name}: expected 0.0 after zero water change, got {after_val}\"\n   108→            );\n   109→        }\n   110→    }\n   111→\n   112→    Ok(())\n   113→}\n   114→\n   115→#[test]\n   116→fn water_change_0_percent_is_noop() -> Result<(), tank_core::SimError> {\n   117→    let state = state_with_ro_like(SimSeed(200));\n   118→    let mut engine = Engine::from_parts(state, vec![]);\n   119→\n   120→    let before = engine.full_state().water.clone();\n   121→\n   122→    engine.apply_action(PlayerAction::WaterChangePercent {\n   123→        percent: 0.0,\n   124→        source_profile_id: \"ro_like\".to_string(),\n   125→    })?;\n   126→    engine.step_hours(1)?;\n   127→\n   128→    let after = &engine.full_state().water;\n   129→\n   130→    // Chemistry should be unchanged (temperature may shift from ambient model)\n   131→    assert!(\n   132→        (after.calcium_mg_total - before.calcium_mg_total).abs() < f64::EPSILON,\n   133→        \"0% water change should not change calcium\"\n   134→    );\n   135→    assert!(\n   136→        (after.alkalinity_meq_total - before.alkalinity_meq_total).abs() < f64::EPSILON,\n   137→        \"0% water change should not change alkalinity\"\n   138→    );\n   139→\n   140→    Ok(())\n   141→}\n   142→\n   143→#[test]\n   144→fn water_change_100_percent_yields_source_temperature() -> Result<(), tank_core::SimError> {\n   145→    let mut state = state_with_ro_like(SimSeed(300));\n   146→    // Add a source with different temperature\n   147→    let mut warm_source = SourceWaterProfile::zero();\n   148→    warm_source.temperature_c = 30.0;\n   149→    state\n   150→        .source_water_catalog\n   151→        .insert(\"warm\".to_string(), warm_source);\n   152→\n   153→    let mut engine = Engine::from_parts(state, vec![]);\n   154→\n   155→    engine.apply_action(PlayerAction::WaterChangePercent {\n   156→        percent: 100.0,\n   157→        source_profile_id: \"warm\".to_string(),\n   158→    })?;\n   159→    engine.step_hours(1)?;\n   160→\n   161→    // After 100% water change, temperature should be very close to source temp\n   162→    // (may shift slightly from the temperature system running after the change)\n   163→    let temp = engine.full_state().water.temperature_c;\n   164→    assert!(\n   165→        (temp - 30.0).abs() < 1.0,\n   166→        \"100% water change should bring temp near source: got {temp}\"\n   167→    );\n   168→\n   169→    Ok(())\n   170→}\n   171→\n   172→#[test]\n   173→fn water_change_50_percent_mixes_temperature() -> Result<(), tank_core::SimError> {\n   174→    let mut state = state_with_ro_like(SimSeed(400));\n   175→    let mut cold_source = SourceWaterProfile::zero();\n   176→    cold_source.temperature_c = 10.0;\n   177→    state\n   178→        .source_water_catalog\n   179→        .insert(\"cold\".to_string(), cold_source);\n   180→    // Tank starts at 24°C, ambient is 24°C\n   181→    state.water.temperature_c = 24.0;\n   182→\n   183→    let mut engine = Engine::from_parts(state, vec![]);\n   184→\n   185→    engine.apply_action(PlayerAction::WaterChangePercent {\n   186→        percent: 50.0,\n   187→        source_profile_id: \"cold\".to_string(),\n   188→    })?;\n   189→    engine.step_hours(1)?;\n   190→\n   191→    // Expected mixed temp: 24*0.5 + 10*0.5 = 17°C, plus thermal system may shift slightly\n   192→    let temp = engine.full_state().water.temperature_c;\n   193→    assert!(\n   194→        temp > 14.0 && temp < 20.0,\n   195→        \"50% cold water change should mix temperature proportionally: got {temp}\"\n   196→    );\n   197→\n   198→    Ok(())\n   199→}\n   200→\n   201→#[test]\n   202→fn unknown_source_profile_returns_error() -> Result<(), tank_core::SimError> {\n   203→    let state = TankState::new(SimSeed(500)); // empty catalog\n   204→    let mut engine = Engine::from_parts(state, vec![]);\n   205→\n   206→    engine.apply_action(PlayerAction::WaterChangePercent {\n   207→        percent: 50.0,\n   208→        source_profile_id: \"nonexistent\".to_string(),\n   209→    })?;\n   210→\n   211→    let result = engine.step_hours(1);\n   212→    assert!(\n   213→        matches!(result, Err(tank_core::SimError::UnknownSourceProfile { .. })),\n   214→        \"Expected UnknownSourceProfile error, got: {result:?}\"\n   215→    );\n   216→\n   217→    Ok(())\n   218→}\n   219→\n   220→#[test]\n   221→fn unknown_profile_leaves_state_unchanged() -> Result<(), tank_core::SimError> {\n   222→    let mut state = TankState::new(SimSeed(600));\n   223→    // Feed first to have some detritus, then queue a bad water change\n   224→    state.detritus.particulate_organics_g_total = 5.0;\n   225→    let before = state.clone();\n   226→\n   227→    let mut engine = Engine::from_parts(state, vec![]);\n   228→\n   229→    // Queue both a feed and a bad water change\n   230→    engine.apply_action(PlayerAction::Feed { grams: 1.0 })?;\n   231→    engine.apply_action(PlayerAction::WaterChangePercent {\n   232→        percent: 50.0,\n   233→        source_profile_id: \"bad_id\".to_string(),\n   234→    })?;\n   235→\n   236→    let result = engine.step_hours(1);\n   237→    assert!(result.is_err());\n   238→\n   239→    // State should be exactly unchanged: day, hour, event_log, water, rng all pristine\n   240→    let after = engine.full_state();\n   241→    assert_eq!(before.environment.day, after.environment.day);\n   242→    assert_eq!(before.environment.hour_of_day, after.environment.hour_of_day);\n   243→    assert_eq!(before.event_log.len(), after.event_log.len());\n   244→    assert!(\n   245→        (before.water.calcium_mg_total - after.water.calcium_mg_total).abs() < f64::EPSILON,\n   246→    );\n   247→\n   248→    Ok(())\n   249→}\n   250→\n   251→#[test]\n   252→fn invalid_resolved_profile_returns_error_and_leaves_state_unchanged() -> Result<(), SimError> {\n   253→    let mut state = TankState::new(SimSeed(700));\n   254→    // Insert a profile with NaN in a chemistry field — simulating corrupted saved state\n   255→    let mut bad_profile = SourceWaterProfile::zero();\n   256→    bad_profile.calcium_mg_per_l = f64::NAN;\n   257→    state\n   258→        .source_water_catalog\n   259→        .insert(\"corrupted\".to_string(), bad_profile);\n   260→\n   261→    let before = state.clone();\n   262→    let mut engine = Engine::from_parts(state, vec![]);\n   263→\n   264→    // Queue a feed and a water change referencing the invalid profile\n   265→    engine.apply_action(PlayerAction::Feed { grams: 1.0 })?;\n   266→    engine.apply_action(PlayerAction::WaterChangePercent {\n   267→        percent: 50.0,\n   268→        source_profile_id: \"corrupted\".to_string(),\n   269→    })?;\n   270→\n   271→    let result = engine.step_hours(1);\n   272→    assert!(\n   273→        matches!(result, Err(SimError::InvalidSourceProfile { .. })),\n   274→        \"Expected InvalidSourceProfile error, got: {result:?}\"\n   275→    );\n   276→\n   277→    // State should be exactly unchanged\n   278→    let after = engine.full_state();\n   279→    assert_eq!(before.environment.day, after.environment.day);\n   280→    assert_eq!(before.environment.hour_of_day, after.environment.hour_of_day);\n   281→    assert_eq!(before.event_log.len(), after.event_log.len());\n   282→    assert!(\n   283→        (before.water.calcium_mg_total - after.water.calcium_mg_total).abs() < f64::EPSILON,\n   284→    );\n   285→    assert!(\n   286→        (before.water.ammonia_total_mg_n_total - after.water.ammonia_total_mg_n_total).abs()\n   287→            < f64::EPSILON,\n   288→    );\n   289→    // Detritus should not have been modified (feed not applied)\n   290→    assert!(\n   291→        (before.detritus.particulate_organics_g_total - after.detritus.particulate_organics_g_total)\n   292→            .abs()\n   293→            < f64::EPSILON,\n   294→    );\n   295→\n   296→    Ok(())\n   297→}\n   298→\n   299→#[test]\n   300→fn invalid_resolved_profile_negative_chemistry_returns_error() -> Result<(), SimError> {\n   301→    let mut state = TankState::new(SimSeed(800));\n   302→    let mut bad_profile = SourceWaterProfile::zero();\n   303→    bad_profile.nitrate_mg_n_per_l = -5.0;\n   304→    state\n   305→        .source_water_catalog\n   306→        .insert(\"negative\".to_string(), bad_profile);\n   307→\n   308→    let mut engine = Engine::from_parts(state, vec![]);\n   309→\n   310→    engine.apply_action(PlayerAction::WaterChangePercent {\n   311→        percent: 25.0,\n   312→        source_profile_id: \"negative\".to_string(),\n   313→    })?;\n   314→\n   315→    let result = engine.step_hours(1);\n   316→    assert!(\n   317→        matches!(result, Err(SimError::InvalidSourceProfile { .. })),\n   318→        \"Expected InvalidSourceProfile error for negative chemistry, got: {result:?}\"\n   319→    );\n   320→\n   321→    Ok(())\n   322→}\n   323→"}]},"parent_tool_use_id":"toolu_01NujX3AtXfHcFkqEjzxfRst","session_id":"1c400ec2-d2a3-480f-a778-7947b0a4715b","uuid":"7cb87603-473a-446d-9e32-3dd6250e4beb"}
