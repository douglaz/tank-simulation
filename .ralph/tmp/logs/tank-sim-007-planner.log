5→                }\n    96→            }\n    97→            Self::TrimPlants { fraction }\n    98→            | Self::SiphonDetritus { fraction }\n    99→            | Self::CleanFilter {\n   100→                intensity: fraction,\n   101→            } => validate_fraction(field_name(self), *fraction),\n   102→            Self::AddShrimp { .. } | Self::RemoveShrimp { .. } => Ok(()),\n   103→            Self::ChangePhotoperiod { hours } => {\n   104→                validate_finite(\"hours\", *hours)?;\n   105→                if (0.0..=24.0).contains(hours) {\n   106→                    Ok(())\n   107→                } else {\n   108→                    Err(SimError::HoursOutOfRange {\n   109→                        field: \"hours\",\n   110→                        value: *hours,\n   111→                    })\n   112→                }\n   113→            }\n   114→            Self::ChangeLightIntensity { intensity_index } => {\n   115→                validate_fraction(\"intensity_index\", *intensity_index)\n   116→            }\n   117→            Self::ChangeHeaterSetpoint { setpoint_c } => {\n   118→                validate_temperature(\"setpoint_c\", *setpoint_c)\n   119→            }\n   120→            Self::ChangeAmbientTemperature { target_c } => {\n   121→                validate_temperature(\"target_c\", *target_c)\n   122→            }\n   123→            Self::ChangeAeration { intensity, .. } => validate_fraction(\"intensity\", *intensity),\n   124→        }\n   125→    }\n   126→}\n   127→\n   128→fn field_name(action: &PlayerAction) -> &'static str {\n   129→    match action {\n   130→        PlayerAction::TrimPlants { .. } => \"fraction\",\n   131→        PlayerAction::SiphonDetritus { .. } => \"fraction\",\n   132→        PlayerAction::CleanFilter { .. } => \"intensity\",\n   133→        _ => \"value\",\n   134→    }\n   135→}\n   136→\n   137→fn validate_non_negative(field: &'static str, value: f64) -> Result<(), SimError> {\n   138→    validate_finite(field, value)?;\n   139→    if value < 0.0 {\n   140→        Err(SimError::NegativeValue { field, value })\n   141→    } else {\n   142→        Ok(())\n   143→    }\n   144→}\n   145→\n   146→fn validate_fraction(field: &'static str, value: f64) -> Result<(), SimError> {\n   147→    validate_finite(field, value)?;\n   148→    if (0.0..=1.0).contains(&value) {\n   149→        Ok(())\n   150→    } else {\n   151→        Err(SimError::FractionOutOfRange { field, value })\n   152→    }\n   153→}\n   154→\n   155→fn validate_percent(field: &'static str, value: f64) -> Result<(), SimError> {\n   156→    validate_finite(field, value)?;\n   157→    if (0.0..=100.0).contains(&value) {\n   158→        Ok(())\n   159→    } else {\n   160→        Err(SimError::PercentOutOfRange { field, value })\n   161→    }\n   162→}\n   163→\n   164→fn validate_temperature(field: &'static str, value: f64) -> Result<(), SimError> {\n   165→    validate_finite(field, value)?;\n   166→    if value > 0.0 {\n   167→        Ok(())\n   168→    } else {\n   169→        Err(SimError::TemperatureTooLow { field, value })\n   170→    }\n   171→}\n   172→\n   173→fn validate_finite(field: &'static str, value: f64) -> Result<(), SimError> {\n   174→    if value.is_finite() {\n   175→        Ok(())\n   176→    } else {\n   177→        Err(SimError::NonFiniteValue { field, value })\n   178→    }\n   179→}\n   180→"}]},"parent_tool_use_id":"toolu_01NujX3AtXfHcFkqEjzxfRst","session_id":"1c400ec2-d2a3-480f-a778-7947b0a4715b","uuid":"ee6f0c6c-845f-4c52-bde7-2e0949a882b3"}
