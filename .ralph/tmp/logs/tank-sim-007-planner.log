{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Nj1DcXUfdxtErbXRydMjhp","type":"tool_result","content":"     1→mod presets;\n     2→\n     3→use serde::de::DeserializeOwned;\n     4→use thiserror::Error;\n     5→\n     6→pub use presets::{\n     7→    PlantPreset, ProcessParamsPreset, Provenance, ScenarioPreset, ShrimpPreset, SourceWaterPreset,\n     8→    SubstratePreset,\n     9→};\n    10→\n    11→#[derive(Debug, Error)]\n    12→pub enum PresetError {\n    13→    #[error(\"unknown preset `{id}` in category `{category}`\")]\n    14→    UnknownPreset { category: &'static str, id: String },\n    15→    #[error(\"failed to parse preset `{id}` in category `{category}`: {message}\")]\n    16→    Parse {\n    17→        category: &'static str,\n    18→        id: String,\n    19→        message: String,\n    20→    },\n    21→    #[error(\"validation failed for preset `{id}` in category `{category}`: {message}\")]\n    22→    Validation {\n    23→        category: &'static str,\n    24→        id: String,\n    25→        message: String,\n    26→    },\n    27→}\n    28→\n    29→pub fn load_source_water(id: &str) -> Result<SourceWaterPreset, PresetError> {\n    30→    let preset: SourceWaterPreset = load_from_registry(\"source_water\", id, SOURCE_WATER_PRESETS)?;\n    31→    preset\n    32→        .validate()\n    33→        .map_err(|message| PresetError::Validation {\n    34→            category: \"source_water\",\n    35→            id: id.to_string(),\n    36→            message,\n    37→        })?;\n    38→    Ok(preset)\n    39→}\n    40→\n    41→pub fn load_substrate(id: &str) -> Result<SubstratePreset, PresetError> {\n    42→    load_from_registry(\"substrate\", id, SUBSTRATE_PRESETS)\n    43→}\n    44→\n    45→pub fn load_plant(id: &str) -> Result<PlantPreset, PresetError> {\n    46→    load_from_registry(\"plants\", id, PLANT_PRESETS)\n    47→}\n    48→\n    49→pub fn load_shrimp(id: &str) -> Result<ShrimpPreset, PresetError> {\n    50→    let preset: ShrimpPreset = load_from_registry(\"shrimp\", id, SHRIMP_PRESETS)?;\n    51→    preset\n    52→        .validate()\n    53→        .map_err(|message| PresetError::Validation {\n    54→            category: \"shrimp\",\n    55→            id: id.to_string(),\n    56→            message,\n    57→        })?;\n    58→    Ok(preset)\n    59→}\n    60→\n    61→pub fn load_process_params(id: &str) -> Result<ProcessParamsPreset, PresetError> {\n    62→    let preset: ProcessParamsPreset = load_from_registry(\"process\", id, PROCESS_PRESETS)?;\n    63→    preset\n    64→        .validate()\n    65→        .map_err(|message| PresetError::Validation {\n    66→            category: \"process\",\n    67→            id: id.to_string(),\n    68→            message,\n    69→        })?;\n    70→    Ok(preset)\n    71→}\n    72→\n    73→pub fn load_scenario(id: &str) -> Result<ScenarioPreset, PresetError> {\n    74→    load_from_registry(\"scenarios\", id, SCENARIO_PRESETS)\n    75→}\n    76→\n    77→pub fn source_water_ids() -> &'static [&'static str] {\n    78→    &[\"soft_acidic\", \"moderate\", \"hard_shrimp\", \"ro_like\"]\n    79→}\n    80→\n    81→pub fn substrate_ids() -> &'static [&'static str] {\n    82→    &[\n    83→        \"inert_sand\",\n    84→        \"inert_gravel\",\n    85→        \"active_planted\",\n    86→        \"coarse_porous\",\n    87→    ]\n    88→}\n    89→\n    90→pub fn plant_ids() -> &'static [&'static str] {\n    91→    &[\"fast_stem\", \"root_rosette\"]\n    92→}\n    93→\n    94→pub fn shrimp_ids() -> &'static [&'static str] {\n    95→    &[\"neocaridina_davidi\"]\n    96→}\n    97→\n    98→pub fn process_ids() -> &'static [&'static str] {\n    99→    &[\"default\"]\n   100→}\n   101→\n   102→pub fn scenario_ids() -> &'static [&'static str] {\n   103→    &[\"nano_cycle\", \"medium_planted\", \"warm_room\"]\n   104→}\n   105→\n   106→fn load_from_registry<T>(\n   107→    category: &'static str,\n   108→    id: &str,\n   109→    registry: &[(&str, &str)],\n   110→) -> Result<T, PresetError>\n   111→where\n   112→    T: DeserializeOwned,\n   113→{\n   114→    let Some((_, raw)) = registry.iter().find(|(entry_id, _)| *entry_id == id) else {\n   115→        return Err(PresetError::UnknownPreset {\n   116→            category,\n   117→            id: id.to_string(),\n   118→        });\n   119→    };\n   120→\n   121→    toml::from_str(raw).map_err(|error| PresetError::Parse {\n   122→        category,\n   123→        id: id.to_string(),\n   124→        message: error.to_string(),\n   125→    })\n   126→}\n   127→\n   128→const SOURCE_WATER_PRESETS: &[(&str, &str)] = &[\n   129→    (\n   130→        \"soft_acidic\",\n   131→        include_str!(\"../data/source_water/soft_acidic.toml\"),\n   132→    ),\n   133→    (\n   134→        \"moderate\",\n   135→        include_str!(\"../data/source_water/moderate.toml\"),\n   136→    ),\n   137→    (\n   138→        \"hard_shrimp\",\n   139→        include_str!(\"../data/source_water/hard_shrimp.toml\"),\n   140→    ),\n   141→    (\"ro_like\", include_str!(\"../data/source_water/ro_like.toml\")),\n   142→];\n   143→\n   144→const SUBSTRATE_PRESETS: &[(&str, &str)] = &[\n   145→    (\n   146→        \"inert_sand\",\n   147→        include_str!(\"../data/substrate/inert_sand.toml\"),\n   148→    ),\n   149→    (\n   150→        \"inert_gravel\",\n   151→        include_str!(\"../data/substrate/inert_gravel.toml\"),\n   152→    ),\n   153→    (\n   154→        \"active_planted\",\n   155→        include_str!(\"../data/substrate/active_planted.toml\"),\n   156→    ),\n   157→    (\n   158→        \"coarse_porous\",\n   159→        include_str!(\"../data/substrate/coarse_porous.toml\"),\n   160→    ),\n   161→];\n   162→\n   163→const PLANT_PRESETS: &[(&str, &str)] = &[\n   164→    (\"fast_stem\", include_str!(\"../data/plants/fast_stem.toml\")),\n   165→    (\n   166→        \"root_rosette\",\n   167→        include_str!(\"../data/plants/root_rosette.toml\"),\n   168→    ),\n   169→];\n   170→\n   171→const SHRIMP_PRESETS: &[(&str, &str)] = &[(\n   172→    \"neocaridina_davidi\",\n   173→    include_str!(\"../data/shrimp/neocaridina_davidi.toml\"),\n   174→)];\n   175→\n   176→const PROCESS_PRESETS: &[(&str, &str)] =\n   177→    &[(\"default\", include_str!(\"../data/process/default.toml\"))];\n   178→\n   179→const SCENARIO_PRESETS: &[(&str, &str)] = &[\n   180→    (\n   181→        \"nano_cycle\",\n   182→        include_str!(\"../data/scenarios/nano_cycle.toml\"),\n   183→    ),\n   184→    (\n   185→        \"medium_planted\",\n   186→        include_str!(\"../data/scenarios/medium_planted.toml\"),\n   187→    ),\n   188→    (\n   189→        \"warm_room\",\n   190→        include_str!(\"../data/scenarios/warm_room.toml\"),\n   191→    ),\n   192→];\n   193→"}]},"parent_tool_use_id":"toolu_01NujX3AtXfHcFkqEjzxfRst","session_id":"1c400ec2-d2a3-480f-a778-7947b0a4715b","uuid":"0f04d90a-4357-4bd5-b4cf-0b3adfab53a4"}
