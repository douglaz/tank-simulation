{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01271QffRx1RCTUFgM63HwN3","type":"tool_result","content":"     1→pub mod input;\n     2→pub mod screens;\n     3→\n     4→use std::{\n     5→    collections::VecDeque,\n     6→    fs,\n     7→    path::PathBuf,\n     8→    time::{Duration, Instant},\n     9→};\n    10→\n    11→use anyhow::Context;\n    12→use ratatui::{\n    13→    prelude::*,\n    14→    widgets::{Block, Borders, Paragraph, Tabs},\n    15→};\n    16→use screens::actions::ActionFormState;\n    17→use tank_core::{Engine, PlayerAction, SaveFile, SimulationEngine, TankSnapshot};\n    18→\n    19→pub const AUTO_ADVANCE_INTERVAL: Duration = Duration::from_millis(150);\n    20→const STATUS_TTL: Duration = Duration::from_secs(4);\n    21→const HISTORY_CAPACITY: usize = 96;\n    22→\n    23→#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n    24→pub enum Screen {\n    25→    Overview,\n    26→    Chemistry,\n    27→    Biology,\n    28→    Actions,\n    29→    Log,\n    30→}\n    31→\n    32→impl Screen {\n    33→    pub const ALL: [Self; 5] = [\n    34→        Self::Overview,\n    35→        Self::Chemistry,\n    36→        Self::Biology,\n    37→        Self::Actions,\n    38→        Self::Log,\n    39→    ];\n    40→\n    41→    pub fn title(self) -> &'static str {\n    42→        match self {\n    43→            Self::Overview => \"1 Overview\",\n    44→            Self::Chemistry => \"2 Chemistry\",\n    45→            Self::Biology => \"3 Biology\",\n    46→            Self::Actions => \"4 Actions\",\n    47→            Self::Log => \"5 Log\",\n    48→        }\n    49→    }\n    50→\n    51→    pub fn next(self) -> Self {\n    52→        let index = (self.index() + 1) % Self::ALL.len();\n    53→        Self::ALL[index]\n    54→    }\n    55→\n    56→    pub fn from_digit(digit: char) -> Option<Self> {\n    57→        match digit {\n    58→            '1' => Some(Self::Overview),\n    59→            '2' => Some(Self::Chemistry),\n    60→            '3' => Some(Self::Biology),\n    61→            '4' => Some(Self::Actions),\n    62→            '5' => Some(Self::Log),\n    63→            _ => None,\n    64→        }\n    65→    }\n    66→\n    67→    fn index(self) -> usize {\n    68→        match self {\n    69→            Self::Overview => 0,\n    70→            Self::Chemistry => 1,\n    71→            Self::Biology => 2,\n    72→            Self::Actions => 3,\n    73→            Self::Log => 4,\n    74→        }\n    75→    }\n    76→}\n    77→\n    78→#[derive(Debug, Clone, Copy, PartialEq)]\n    79→pub struct TankSizePreset {\n    80→    pub label: &'static str,\n    81→    pub size_scale: f64,\n    82→}\n    83→\n    84→#[derive(Debug, Clone, Copy, PartialEq)]\n    85→pub struct FillPreset {\n    86→    pub label: &'static str,\n    87→    pub fill_ratio: f64,\n    88→}\n    89→\n    90→pub const TANK_SIZE_PRESETS: [TankSizePreset; 3] = [\n    91→    TankSizePreset {\n    92→        label: \"Compact\",\n    93→        size_scale: 0.8,\n    94→    },\n    95→    TankSizePreset {\n    96→        label: \"Baseline\",\n    97→        size_scale: 1.0,\n    98→    },\n    99→    TankSizePreset {\n   100→        label: \"Large\",\n   101→        size_scale: 1.25,\n   102→    },\n   103→];\n   104→\n   105→pub const FILL_PRESETS: [FillPreset; 3] = [\n   106→    FillPreset {\n   107→        label: \"75%\",\n   108→        fill_ratio: 0.75,\n   109→    },\n   110→    FillPreset {\n   111→        label: \"90%\",\n   112→        fill_ratio: 0.9,\n   113→    },\n   114→    FillPreset {\n   115→        label: \"100%\",\n   116→        fill_ratio: 1.0,\n   117→    },\n   118→];\n   119→\n   120→#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n   121→pub enum StatusLevel {\n   122→    Info,\n   123→    Warning,\n   124→    Error,\n   125→}\n   126→\n   127→#[derive(Debug, Clone)]\n   128→pub struct StatusMessage {\n   129→    pub text: String,\n   130→    pub level: StatusLevel,\n   131→    expires_at: Instant,\n   132→}\n   133→\n   134→#[derive(Debug, Clone)]\n   135→pub struct TuiApp {\n   136→    pub active_screen: Screen,\n   137→    pub engine: Engine,\n   138→    pub snapshot: TankSnapshot,\n   139→    pub auto_advance: bool,\n   140→    pub status_message: Option<StatusMessage>,\n   141→    pub action_form: ActionFormState,\n   142→    pub save_file_path: PathBuf,\n   143→    pub scenario_label: String,\n   144→    snapshot_history: VecDeque<TankSnapshot>,\n   145→}\n   146→\n   147→impl TuiApp {\n   148→    pub fn new(engine: Engine, save_file_path: PathBuf, scenario_label: impl Into<String>) -> Self {\n   149→        let snapshot = engine.snapshot();\n   150→        let mut snapshot_history = VecDeque::with_capacity(HISTORY_CAPACITY);\n   151→        snapshot_history.push_back(snapshot.clone());\n   152→\n   153→        Self {\n   154→            active_screen: Screen::Overview,\n   155→            engine,\n   156→            snapshot,\n   157→            auto_advance: false,\n   158→            status_message: None,\n   159→            action_form: ActionFormState::default(),\n   160→            save_file_path,\n   161→            scenario_label: scenario_label.into(),\n   162→            snapshot_history,\n   163→        }\n   164→    }\n   165→\n   166→    pub fn set_screen(&mut self, screen: Screen) {\n   167→        self.active_screen = screen;\n   168→    }\n   169→\n   170→    pub fn next_screen(&mut self) {\n   171→        self.active_screen = self.active_screen.next();\n   172→    }\n   173→\n   174→    pub fn toggle_auto_advance(&mut self) {\n   175→        self.auto_advance = !self.auto_advance;\n   176→        let state = if self.auto_advance {\n   177→            \"enabled\"\n   178→        } else {\n   179→            \"paused\"\n   180→        };\n   181→        self.set_status(StatusLevel::Info, format!(\"Auto-advance {state}\"));\n   182→    }\n   183→\n   184→    pub fn apply_action(&mut self, action: PlayerAction) {\n   185→        match self.engine.apply_action(action.clone()) {\n   186→            Ok(()) => {\n   187→                self.refresh_snapshot();\n   188→                self.set_status(StatusLevel::Info, format!(\"Queued action: {action:?}\"));\n   189→            }\n   190→            Err(error) => {\n   191→                self.set_status(StatusLevel::Error, format!(\"Action rejected: {error}\"));\n   192→            }\n   193→        }\n   194→    }\n   195→\n   196→    pub fn step_hours(&mut self, hours: u32) {\n   197→        match self.engine.step_hours(hours) {\n   198→            Ok(()) => {\n   199→                self.refresh_snapshot();\n   200→                let label = match hours {\n   201→                    1 => \"Stepped 1 hour\".to_string(),\n   202→                    24 => \"Stepped 1 day\".to_string(),\n   203→                    168 => \"Stepped 1 week\".to_string(),\n   204→                    _ => format!(\"Stepped {hours} hours\"),\n   205→                };\n   206→                self.set_status(StatusLevel::Info, label);\n   207→            }\n   208→            Err(error) => {\n   209→                self.set_status(StatusLevel::Error, format!(\"Step failed: {error}\"));\n   210→            }\n   211→        }\n   212→    }\n   213→\n   214→    pub fn save_to_disk(&mut self) -> anyhow::Result<()> {\n   215→        let save = SaveFile::from_engine(&self.engine);\n   216→        let json = save\n   217→            .to_json_pretty()\n   218→            .context(\"failed to serialize save file\")?;\n   219→        fs::write(&self.save_file_path, json)\n   220→            .with_context(|| format!(\"failed to write {}\", self.save_file_path.display()))?;\n   221→        self.set_status(\n   222→            StatusLevel::Info,\n   223→            format!(\"Saved to {}\", self.save_file_path.display()),\n   224→        );\n   225→        Ok(())\n   226→    }\n   227→\n   228→    pub fn load_from_disk(&mut self) -> anyhow::Result<()> {\n   229→        let raw = fs::read_to_string(&self.save_file_path)\n   230→            .with_context(|| format!(\"failed to read {}\", self.save_file_path.display()))?;\n   231→        let save = SaveFile::from_json(&raw).context(\"failed to parse save file\")?;\n   232→        self.engine = save.into_engine();\n   233→        self.snapshot_history.clear();\n   234→        self.refresh_snapshot();\n   235→        self.set_status(\n   236→            StatusLevel::Info,\n   237→            format!(\"Loaded {}\", self.save_file_path.display()),\n   238→        );\n   239→        Ok(())\n   240→    }\n   241→\n   242→    pub fn clear_expired_status(&mut self) {\n   243→        if self\n   244→            .status_message\n   245→            .as_ref()\n   246→            .is_some_and(|message| Instant::now() >= message.expires_at)\n   247→        {\n   248→            self.status_message = None;\n   249→        }\n   250→    }\n   251→\n   252→    pub fn history_values<F>(&self, metric: F) -> Vec<f64>\n   253→    where\n   254→        F: Fn(&TankSnapshot) -> f64,\n   255→    {\n   256→        self.snapshot_history.iter().map(metric).collect()\n   257→    }\n   258→\n   259→    pub fn active_warning_lines(&self) -> Vec<String> {\n   260→        self.snapshot\n   261→            .recent_events\n   262→            .iter()\n   263→            .rev()\n   264→            .filter(|event| !matches!(event.severity, tank_core::EventSeverity::Info))\n   265→            .take(4)\n   266→            .map(|event| {\n   267→                format!(\n   268→                    \"Day {} {:02}:00 {:?}: {}\",\n   269→                    event.day, event.hour, event.kind, event.summary\n   270→                )\n   271→            })\n   272→            .collect()\n   273→    }\n   274→\n   275→    pub fn show_status(&mut self, level: StatusLevel, text: impl Into<String>) {\n   276→        self.set_status(level, text);\n   277→    }\n   278→\n   279→    pub fn render(&self, frame: &mut Frame<'_>) {\n   280→        let chunks = Layout::vertical([\n   281→            Constraint::Length(3),\n   282→            Constraint::Min(8),\n   283→            Constraint::Length(2),\n   284→        ])\n   285→        .split(frame.size());\n   286→\n   287→        let titles = Screen::ALL\n   288→            .iter()\n   289→            .map(|screen| Line::from(screen.title()))\n   290→            .collect::<Vec<_>>();\n   291→        let tabs = Tabs::new(titles)\n   292→            .select(self.active_screen.index())\n   293→            .block(\n   294→                Block::default()\n   295→                    .title(format!(\" Tank Sim · {} \", self.scenario_label))\n   296→                    .borders(Borders::ALL),\n   297→            )\n   298→            .highlight_style(\n   299→                Style::default()\n   300→                    .fg(Color::Cyan)\n   301→                    .add_modifier(Modifier::BOLD),\n   302→            );\n   303→        frame.render_widget(tabs, chunks[0]);\n   304→\n   305→        screens::render_screen(self.active_screen, frame, chunks[1], self);\n   306→\n   307→        let footer = Paragraph::new(self.status_line())\n   308→            .block(Block::default().borders(Borders::ALL))\n   309→            .wrap(ratatui::widgets::Wrap { trim: true });\n   310→        frame.render_widget(footer, chunks[2]);\n   311→    }\n   312→\n   313→    fn refresh_snapshot(&mut self) {\n   314→        self.snapshot = self.engine.snapshot();\n   315→        if self.snapshot_history.len() == HISTORY_CAPACITY {\n   316→            self.snapshot_history.pop_front();\n   317→        }\n   318→        self.snapshot_history.push_back(self.snapshot.clone());\n   319→    }\n   320→\n   321→    fn set_status(&mut self, level: StatusLevel, text: impl Into<String>) {\n   322→        self.status_message = Some(StatusMessage {\n   323→            text: text.into(),\n   324→            level,\n   325→            expires_at: Instant::now() + STATUS_TTL,\n   326→        });\n   327→    }\n   328→\n   329→    fn status_line(&self) -> Line<'static> {\n   330→        let mut spans = vec![\n   331→            Span::styled(\"Tab/1-5 switch\", Style::default().fg(Color::DarkGray)),\n   332→            Span::raw(\"  \"),\n   333→            Span::styled(\"h\", Style::default().fg(Color::Cyan)),\n   334→            Span::raw(\" hour  \"),\n   335→            Span::styled(\"d\", Style::default().fg(Color::Cyan)),\n   336→            Span::raw(\" day  \"),\n   337→            Span::styled(\"w\", Style::default().fg(Color::Cyan)),\n   338→            Span::raw(\" week  \"),\n   339→            Span::styled(\"space\", Style::default().fg(Color::Cyan)),\n   340→            Span::raw(\" auto  \"),\n   341→            Span::styled(\"s/l\", Style::default().fg(Color::Cyan)),\n   342→            Span::raw(\" save/load  \"),\n   343→            Span::styled(\"q\", Style::default().fg(Color::Cyan)),\n   344→            Span::raw(\" quit\"),\n   345→        ];\n   346→\n   347→        if let Some(message) = &self.status_message {\n   348→            spans.push(Span::raw(\"  |  \"));\n   349→            let color = match message.level {\n   350→                StatusLevel::Info => Color::Green,\n   351→                StatusLevel::Warning => Color::Yellow,\n   352→                StatusLevel::Error => Color::Red,\n   353→            };\n   354→            spans.push(Span::styled(\n   355→                message.text.clone(),\n   356→                Style::default().fg(color),\n   357→            ));\n   358→        }\n   359→\n   360→        Line::from(spans)\n   361→    }\n   362→}\n   363→"}]},"parent_tool_use_id":"toolu_01MseYwjJW41YZiD72AMJwjL","session_id":"94a28873-9e1b-4b56-baad-3f78c1e4f81f","uuid":"e3cda314-93e0-4e9c-bf29-fd2e61b8bb1f"}
