imp species parameters for deterministic save/load.\n    44→    #[serde(default)]\n    45→    pub shrimp_params: ShrimpRuntimeParams,\n    46→    /// Tracks recent chemistry swings for shrimp stress.\n    47→    #[serde(default)]\n    48→    pub stability_tracker: StabilityTracker,\n    49→}\n    50→\n    51→impl TankState {\n    52→    pub fn new(seed: SimSeed) -> Self {\n    53→        let geometry = TankGeometry::default();\n    54→        Self {\n    55→            meta: SimMeta::default(),\n    56→            geometry: geometry.clone(),\n    57→            environment: EnvironmentState::default(),\n    58→            hardware: HardwareState::default(),\n    59→            water: WaterState::default_for_geometry(&geometry),\n    60→            substrate_layers: vec![SubstrateLayerState::default()],\n    61→            filter_state: FilterState::default(),\n    62→            plant_guilds: vec![\n    63→                PlantGuildState::default(),\n    64→                PlantGuildState {\n    65→                    guild: PlantGuild::RootFeedingRosette,\n    66→                    biomass_g: 3.0,\n    67→                    health_index: 0.8,\n    68→                    crowding_index: 0.1,\n    69→                    habitat_index: 0.7,\n    70→                },\n    71→            ],\n    72→            algae: AlgaeState::default(),\n    73→            microbe: MicrobeState::default(),\n    74→            microfauna: MicrofaunaState::default(),\n    75→            animal: AnimalState::default(),\n    76→            detritus: DetritusState::default(),\n    77→            event_log: Vec::new(),\n    78→            last_event_day: BTreeMap::new(),\n    79→            rng: SimRng::new(seed),\n    80→            source_water_catalog: BTreeMap::new(),\n    81→            process_params: ProcessParams::default(),\n    82→            shrimp_params: ShrimpRuntimeParams::default(),\n    83→            stability_tracker: StabilityTracker::default(),\n    84→        }\n    85→    }\n    86→\n    87→    pub fn seeded_example(seed: SimSeed) -> Self {\n    88→        let mut state = Self::new(seed);\n    89→        state.meta.scenario_id = Some(\"seeded_example\".to_string());\n    90→        state.substrate_layers = vec![\n    91→            SubstrateLayerState {\n    92→                kind: SubstrateKind::ActivePlanted,\n    93→                depth_cm: 2.0,\n    94→                nutrient_store_mg_n_total: 40.0,\n    95→                nutrient_store_mg_p_total: 10.0,\n    96→                cation_exchange_capacity_index: 0.8,\n    97→                detritus_trapping_index: 0.4,\n    98→                colonizable_area_cm2: 400.0,\n    99→                low_oxygen_tendency_index: 0.5,\n   100→                grazing_surface_index: 0.5,\n   101→            },\n   102→            SubstrateLayerState {\n   103→                kind: SubstrateKind::CoarsePorous,\n   104→                depth_cm: 1.0,\n   105→                nutrient_store_mg_n_total: 5.0,\n   106→                nutrient_store_mg_p_total: 1.0,\n   107→                cation_exchange_capacity_index: 0.2,\n   108→                detritus_trapping_index: 0.6,\n   109→                colonizable_area_cm2: 250.0,\n   110→                low_oxygen_tendency_index: 0.6,\n   111→                grazing_surface_index: 0.7,\n   112→            },\n   113→        ];\n   114→        state\n   115→    }\n   116→}\n   117→\n   118→impl Default for TankState {\n   119→    fn default() -> Self {\n   120→        Self::new(SimSeed(0))\n   121→    }\n   122→}\n   123→"}]},"parent_tool_use_id":"toolu_01WdDMCtt9dEZwZBs2Y71Xy8","session_id":"94a28873-9e1b-4b56-baad-3f78c1e4f81f","uuid":"92bf15f7-6071-4f51-a97b-9e120387869a"}
