{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SG6MEDwiWW4JFQUsTQBtJ2","type":"tool_result","content":"     1→use tank_core::{\n     2→    Engine, PlayerAction, SimError, SimSeed, SimulationEngine, SourceWaterProfile, TankState,\n     3→};\n     4→\n     5→/// Helper: build a state with a known source-water catalog containing `ro_like`.\n     6→fn state_with_ro_like(seed: SimSeed) -> TankState {\n     7→    let mut state = TankState::new(seed);\n     8→    state\n     9→        .source_water_catalog\n    10→        .insert(\"ro_like\".to_string(), SourceWaterProfile::zero());\n    11→    state\n    12→}\n    13→\n    14→#[test]\n    15→fn water_change_50_percent_ro_like_halves_dissolved_totals() -> Result<(), tank_core::SimError> {\n    16→    let state = state_with_ro_like(SimSeed(100));\n    17→    let mut engine = Engine::from_parts(state, vec![]);\n    18→\n    19→    // Record pre-change totals\n    20→    let before = engine.full_state().water.clone();\n    21→\n    22→    // Apply 50% water change with zero-nutrient source\n    23→    engine.apply_action(PlayerAction::WaterChangePercent {\n    24→        percent: 50.0,\n    25→        source_profile_id: \"ro_like\".to_string(),\n    26→    })?;\n    27→    engine.step_hours(1)?;\n    28→\n    29→    let after = &engine.full_state().water;\n    30→\n    31→    // Each dissolved total should be reduced by 50% ± 0.5%\n    32→    let tolerance = 0.005; // 0.5%\n    33→    let expected_ratio = 0.5;\n    34→\n    35→    let checks: Vec<(&str, f64, f64)> = vec![\n    36→        (\n    37→            \"ammonia_total_mg_n_total\",\n    38→            before.ammonia_total_mg_n_total,\n    39→            after.ammonia_total_mg_n_total,\n    40→        ),\n    41→        (\n    42→            \"nitrite_mg_n_total\",\n    43→            before.nitrite_mg_n_total,\n    44→            after.nitrite_mg_n_total,\n    45→        ),\n    46→        (\n    47→            \"nitrate_mg_n_total\",\n    48→            before.nitrate_mg_n_total,\n    49→            after.nitrate_mg_n_total,\n    50→        ),\n    51→        (\n    52→            \"phosphate_mg_p_total\",\n    53→            before.phosphate_mg_p_total,\n    54→            after.phosphate_mg_p_total,\n    55→        ),\n    56→        (\n    57→            \"dissolved_inorganic_carbon_mg_c_total\",\n    58→            before.dissolved_inorganic_carbon_mg_c_total,\n    59→            after.dissolved_inorganic_carbon_mg_c_total,\n    60→        ),\n    61→        (\n    62→            \"calcium_mg_total\",\n    63→            before.calcium_mg_total,\n    64→            after.calcium_mg_total,\n    65→        ),\n    66→        (\n    67→            \"magnesium_mg_total\",\n    68→            before.magnesium_mg_total,\n    69→            after.magnesium_mg_total,\n    70→        ),\n    71→        (\n    72→            \"sodium_mg_total\",\n    73→            before.sodium_mg_total,\n    74→            after.sodium_mg_total,\n    75→        ),\n    76→        (\n    77→            \"potassium_mg_total\",\n    78→            before.potassium_mg_total,\n    79→            after.potassium_mg_total,\n    80→        ),\n    81→        (\n    82→            \"bicarbonate_mg_total\",\n    83→            before.bicarbonate_mg_total,\n    84→            after.bicarbonate_mg_total,\n    85→        ),\n    86→        (\n    87→            \"chloride_mg_total\",\n    88→            before.chloride_mg_total,\n    89→            after.chloride_mg_total,\n    90→        ),\n    91→        (\n    92→            \"sulfate_mg_total\",\n    93→            before.sulfate_mg_total,\n    94→            after.sulfate_mg_total,\n    95→        ),\n    96→    ];\n    97→\n    98→    for (name, before_val, after_val) in &checks {\n    99→        if *before_val > 0.0 {\n   100→            let actual_ratio = after_val / before_val;\n   101→            assert!(\n   102→                (actual_ratio - expected_ratio).abs() < tolerance,\n   103→                \"{name}: expected ratio {expected_ratio} ± {tolerance}, got {actual_ratio} (before={before_val}, after={after_val})\"\n   104→            );\n   105→        } else {\n   106→            // If before was 0.0, after should also be 0.0 (ro_like adds nothing)\n   107→            assert!(\n   108→                after_val.abs() < f64::EPSILON,\n   109→                \"{name}: expected 0.0 after zero water change, got {after_val}\"\n   110→            );\n   111→        }\n   112→    }\n   113→\n   114→    Ok(())\n   115→}\n   116→\n   117→#[test]\n   118→fn water_change_0_percent_is_noop() -> Result<(), tank_core::SimError> {\n   119→    let state = state_with_ro_like(SimSeed(200));\n   120→    let mut engine = Engine::from_parts(state, vec![]);\n   121→\n   122→    let before = engine.full_state().water.clone();\n   123→\n   124→    engine.apply_action(PlayerAction::WaterChangePercent {\n   125→        percent: 0.0,\n   126→        source_profile_id: \"ro_like\".to_string(),\n   127→    })?;\n   128→    engine.step_hours(1)?;\n   129→\n   130→    let after = &engine.full_state().water;\n   131→\n   132→    // Chemistry should be unchanged (temperature may shift from ambient model)\n   133→    assert!(\n   134→        (after.calcium_mg_total - before.calcium_mg_total).abs() < f64::EPSILON,\n   135→        \"0% water change should not change calcium\"\n   136→    );\n   137→    assert!(\n   138→        (after.alkalinity_meq_total - before.alkalinity_meq_total).abs() < f64::EPSILON,\n   139→        \"0% water change should not change alkalinity\"\n   140→    );\n   141→\n   142→    Ok(())\n   143→}\n   144→\n   145→#[test]\n   146→fn water_change_100_percent_yields_source_temperature() -> Result<(), tank_core::SimError> {\n   147→    let mut state = state_with_ro_like(SimSeed(300));\n   148→    // Add a source with different temperature\n   149→    let mut warm_source = SourceWaterProfile::zero();\n   150→    warm_source.temperature_c = 30.0;\n   151→    state\n   152→        .source_water_catalog\n   153→        .insert(\"warm\".to_string(), warm_source);\n   154→\n   155→    let mut engine = Engine::from_parts(state, vec![]);\n   156→\n   157→    engine.apply_action(PlayerAction::WaterChangePercent {\n   158→        percent: 100.0,\n   159→        source_profile_id: \"warm\".to_string(),\n   160→    })?;\n   161→    engine.step_hours(1)?;\n   162→\n   163→    // After 100% water change, temperature should be very close to source temp\n   164→    // (may shift slightly from the temperature system running after the change)\n   165→    let temp = engine.full_state().water.temperature_c;\n   166→    assert!(\n   167→        (temp - 30.0).abs() < 1.0,\n   168→        \"100% water change should bring temp near source: got {temp}\"\n   169→    );\n   170→\n   171→    Ok(())\n   172→}\n   173→\n   174→#[test]\n   175→fn water_change_50_percent_mixes_temperature() -> Result<(), tank_core::SimError> {\n   176→    let mut state = state_with_ro_like(SimSeed(400));\n   177→    let mut cold_source = SourceWaterProfile::zero();\n   178→    cold_source.temperature_c = 10.0;\n   179→    state\n   180→        .source_water_catalog\n   181→        .insert(\"cold\".to_string(), cold_source);\n   182→    // Tank starts at 24°C, ambient is 24°C\n   183→    state.water.temperature_c = 24.0;\n   184→\n   185→    let mut engine = Engine::from_parts(state, vec![]);\n   186→\n   187→    engine.apply_action(PlayerAction::WaterChangePercent {\n   188→        percent: 50.0,\n   189→        source_profile_id: \"cold\".to_string(),\n   190→    })?;\n   191→    engine.step_hours(1)?;\n   192→\n   193→    // Expected mixed temp: 24*0.5 + 10*0.5 = 17°C, plus thermal system may shift slightly\n   194→    let temp = engine.full_state().water.temperature_c;\n   195→    assert!(\n   196→        temp > 14.0 && temp < 20.0,\n   197→        \"50% cold water change should mix temperature proportionally: got {temp}\"\n   198→    );\n   199→\n   200→    Ok(())\n   201→}\n   202→\n   203→#[test]\n   204→fn unknown_source_profile_returns_error() -> Result<(), tank_core::SimError> {\n   205→    let state = TankState::new(SimSeed(500)); // empty catalog\n   206→    let mut engine = Engine::from_parts(state, vec![]);\n   207→\n   208→    engine.apply_action(PlayerAction::WaterChangePercent {\n   209→        percent: 50.0,\n   210→        source_profile_id: \"nonexistent\".to_string(),\n   211→    })?;\n   212→\n   213→    let result = engine.step_hours(1);\n   214→    assert!(\n   215→        matches!(\n   216→            result,\n   217→            Err(tank_core::SimError::UnknownSourceProfile { .. })\n   218→        ),\n   219→        \"Expected UnknownSourceProfile error, got: {result:?}\"\n   220→    );\n   221→\n   222→    Ok(())\n   223→}\n   224→\n   225→#[test]\n   226→fn unknown_profile_leaves_state_unchanged() -> Result<(), tank_core::SimError> {\n   227→    let mut state = TankState::new(SimSeed(600));\n   228→    // Feed first to have some detritus, then queue a bad water change\n   229→    state.detritus.particulate_organics_g_total = 5.0;\n   230→    let before = state.clone();\n   231→\n   232→    let mut engine = Engine::from_parts(state, vec![]);\n   233→\n   234→    // Queue both a feed and a bad water change\n   235→    engine.apply_action(PlayerAction::Feed { grams: 1.0 })?;\n   236→    engine.apply_action(PlayerAction::WaterChangePercent {\n   237→        percent: 50.0,\n   238→        source_profile_id: \"bad_id\".to_string(),\n   239→    })?;\n   240→\n   241→    let result = engine.step_hours(1);\n   242→    assert!(result.is_err());\n   243→\n   244→    // State should be exactly unchanged: day, hour, event_log, water, rng all pristine\n   245→    let after = engine.full_state();\n   246→    assert_eq!(before.environment.day, after.environment.day);\n   247→    assert_eq!(\n   248→        before.environment.hour_of_day,\n   249→        after.environment.hour_of_day\n   250→    );\n   251→    assert_eq!(before.event_log.len(), after.event_log.len());\n   252→    assert!((before.water.calcium_mg_total - after.water.calcium_mg_total).abs() < f64::EPSILON,);\n   253→\n   254→    Ok(())\n   255→}\n   256→\n   257→#[test]\n   258→fn invalid_resolved_profile_returns_error_and_leaves_state_unchanged() -> Result<(), SimError> {\n   259→    let mut state = TankState::new(SimSeed(700));\n   260→    // Insert a profile with NaN in a chemistry field — simulating corrupted saved state\n   261→    let mut bad_profile = SourceWaterProfile::zero();\n   262→    bad_profile.calcium_mg_per_l = f64::NAN;\n   263→    state\n   264→        .source_water_catalog\n   265→        .insert(\"corrupted\".to_string(), bad_profile);\n   266→\n   267→    let before = state.clone();\n   268→    let mut engine = Engine::from_parts(state, vec![]);\n   269→\n   270→    // Queue a feed and a water change referencing the invalid profile\n   271→    engine.apply_action(PlayerAction::Feed { grams: 1.0 })?;\n   272→    engine.apply_action(PlayerAction::WaterChangePercent {\n   273→        percent: 50.0,\n   274→        source_profile_id: \"corrupted\".to_string(),\n   275→    })?;\n   276→\n   277→    let result = engine.step_hours(1);\n   278→    assert!(\n   279→        matches!(result, Err(SimError::InvalidSourceProfile { .. })),\n   280→        \"Expected InvalidSourceProfile error, got: {result:?}\"\n   281→    );\n   282→\n   283→    // State should be exactly unchanged\n   284→    let after = engine.full_state();\n   285→    assert_eq!(before.environment.day, after.environment.day);\n   286→    assert_eq!(\n   287→        before.environment.hour_of_day,\n   288→        after.environment.hour_of_day\n   289→    );\n   290→    assert_eq!(before.event_log.len(), after.event_log.len());\n   291→    assert!((before.water.calcium_mg_total - after.water.calcium_mg_total).abs() < f64::EPSILON,);\n   292→    assert!(\n   293→        (before.water.ammonia_total_mg_n_total - after.water.ammonia_total_mg_n_total).abs()\n   294→            < f64::EPSILON,\n   295→    );\n   296→    // Detritus should not have been modified (feed not applied)\n   297→    assert!(\n   298→        (before.detritus.particulate_organics_g_total\n   299→            - after.detritus.particulate_organics_g_total)\n   300→            .abs()\n   301→            < f64::EPSILON,\n   302→    );\n   303→\n   304→    Ok(())\n   305→}\n   306→\n   307→#[test]\n   308→fn invalid_resolved_profile_negative_chemistry_returns_error() -> Result<(), SimError> {\n   309→    let mut state = TankState::new(SimSeed(800));\n   310→    let mut bad_profile = SourceWaterProfile::zero();\n   311→    bad_profile.nitrate_mg_n_per_l = -5.0;\n   312→    state\n   313→        .source_water_catalog\n   314→        .insert(\"negative\".to_string(), bad_profile);\n   315→\n   316→    let mut engine = Engine::from_parts(state, vec![]);\n   317→\n   318→    engine.apply_action(PlayerAction::WaterChangePercent {\n   319→        percent: 25.0,\n   320→        source_profile_id: \"negative\".to_string(),\n   321→    })?;\n   322→\n   323→    let result = engine.step_hours(1);\n   324→    assert!(\n   325→        matches!(result, Err(SimError::InvalidSourceProfile { .. })),\n   326→        \"Expected InvalidSourceProfile error for negative chemistry, got: {result:?}\"\n   327→    );\n   328→\n   329→    Ok(())\n   330→}\n   331→"}]},"parent_tool_use_id":"toolu_01KseqFhjnhaEttVJj7yqf7Y","session_id":"94a28873-9e1b-4b56-baad-3f78c1e4f81f","uuid":"0aff2ffd-a630-4832-baac-de2437546a03"}
