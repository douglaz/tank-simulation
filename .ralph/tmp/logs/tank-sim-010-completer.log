{"type":"item.completed","item":{"id":"item_85","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/src/systems/plant_growth.rs | sed -n '1,260p'\"","aggregated_output":"     1\tuse crate::types::{PlantGuild, TankState};\n     2\t\n     3\tconst PLANT_N_MG_PER_G_GROWTH: f64 = 28.0;\n     4\tconst PLANT_P_MG_PER_G_GROWTH: f64 = 4.0;\n     5\t\n     6\tpub fn step_daily_plants(state: &mut TankState) {\n     7\t    let surface_area_m2 = (state.geometry.surface_area_cm2() / 10_000.0).max(f64::MIN_POSITIVE);\n     8\t    let total_plant_biomass_g: f64 = state.plant_guilds.iter().map(|plant| plant.biomass_g).sum();\n     9\t    let crowding_index = (total_plant_biomass_g\n    10\t        / (surface_area_m2\n    11\t            * state\n    12\t                .process_params\n    13\t                .plant_crowding_biomass_g_per_m2\n    14\t                .max(1.0)))\n    15\t    .clamp(0.0, 1.0);\n    16\t    let f_light = plant_light_factor(state);\n    17\t    let f_temp = gaussian_response(\n    18\t        state.water.temperature_c,\n    19\t        state.process_params.plant_temp_optimum_c,\n    20\t        state.process_params.plant_temp_sigma_c,\n    21\t    );\n    22\t    let f_c = half_saturation(\n    23\t        state.water.dissolved_inorganic_carbon_mg_c_total,\n    24\t        state.process_params.plant_half_saturation_c_mg_total,\n    25\t    );\n    26\t\n    27\t    for index in 0..state.plant_guilds.len() {\n    28\t        let guild = state.plant_guilds[index].guild;\n    29\t        let biomass_g = state.plant_guilds[index].biomass_g;\n    30\t        let health_index = state.plant_guilds[index].health_index;\n    31\t        let habitat_index = habitat_factor(state, guild);\n    32\t\n    33\t        state.plant_guilds[index].crowding_index = crowding_index;\n    34\t        state.plant_guilds[index].habitat_index = habitat_index;\n    35\t\n    36\t        let water_n = state.water.ammonia_total_mg_n_total + state.water.nitrate_mg_n_total;\n    37\t        let water_p = state.water.phosphate_mg_p_total;\n    38\t        let substrate_n = total_substrate_n(state);\n    39\t        let substrate_p = total_substrate_p(state);\n    40\t        let water_bias = state.plant_guilds[index].water_column_uptake_bias();\n    41\t        let substrate_bias = state.plant_guilds[index].substrate_uptake_bias();\n    42\t        let accessible_n = (water_n * water_bias) + (substrate_n * substrate_bias);\n    43\t        let accessible_p = (water_p * water_bias) + (substrate_p * substrate_bias);\n    44\t        let f_n = half_saturation(\n    45\t            accessible_n,\n    46\t            state.process_params.plant_half_saturation_n_mg_total,\n    47\t        );\n    48\t        let f_p = half_saturation(\n    49\t            accessible_p,\n    50\t            state.process_params.plant_half_saturation_p_mg_total,\n    51\t        );\n    52\t        let nutrient_limitation = f_n.min(f_p).min(f_c);\n    53\t        let max_rate = match guild {\n    54\t            PlantGuild::FastStem => state.process_params.plant_max_growth_rate_fast_stem_per_day,\n    55\t            PlantGuild::RootFeedingRosette => {\n    56\t                state\n    57\t                    .process_params\n    58\t                    .plant_max_growth_rate_root_rosette_per_day\n    59\t            }\n    60\t        };\n    61\t        let gross_growth_g = biomass_g\n    62\t            * max_rate\n    63\t            * f_light\n    64\t            * f_temp\n    65\t            * nutrient_limitation\n    66\t            * habitat_index\n    67\t            * (1.0 - crowding_index);\n    68\t        let respiration_g = biomass_g * state.process_params.plant_respiration_fraction_per_day;\n    69\t        let senescence_g = biomass_g\n    70\t            * state.process_params.plant_senescence_fraction_per_day\n    71\t            * (1.0 + 0.5 * (1.0 - health_index));\n    72\t        let net_growth_g = gross_growth_g - respiration_g - senescence_g;\n    73\t        let realized_growth_g = gross_growth_g.max(0.0);\n    74\t\n    75\t        remove_plant_nutrients(\n    76\t            state,\n    77\t            realized_growth_g * PLANT_N_MG_PER_G_GROWTH,\n    78\t            realized_growth_g * PLANT_P_MG_PER_G_GROWTH,\n    79\t            water_bias,\n    80\t            substrate_bias,\n    81\t        );\n    82\t\n    83\t        let new_biomass_g = (biomass_g + net_growth_g).max(0.0);\n    84\t        state.plant_guilds[index].biomass_g = new_biomass_g;\n    85\t        state.detritus.fine_detritus_g_total += senescence_g.max(0.0);\n    86\t\n    87\t        let stress_driver = nutrient_limitation.min(f_light).min(habitat_index);\n    88\t        let poor_conditions = stress_driver < 0.55;\n    89\t        let new_health = if poor_conditions {\n    90\t            health_index - state.process_params.plant_health_decline_per_day * (1.0 - stress_driver)\n    91\t        } else {\n    92\t            health_index + state.process_params.plant_health_recovery_per_day * (1.0 - health_index)\n    93\t        };\n    94\t        state.plant_guilds[index].health_index = new_health.clamp(0.0, 1.0);\n    95\t    }\n    96\t}\n    97\t\n    98\tfn plant_light_factor(state: &TankState) -> f64 {\n    99\t    if !state.hardware.light.enabled {\n   100\t        return 0.0;\n   101\t    }\n   102\t\n   103\t    let photoperiod_factor = (state.hardware.light.photoperiod_hours / 10.0).clamp(0.0, 1.0);\n   104\t    half_saturation(\n   105\t        state.hardware.light.intensity_index * photoperiod_factor,\n   106\t        state.process_params.plant_light_half_saturation,\n   107\t    )\n   108\t}\n   109\t\n   110\tfn habitat_factor(state: &TankState, guild: PlantGuild) -> f64 {\n   111\t    match guild {\n   112\t        PlantGuild::FastStem => 0.95,\n   113\t        PlantGuild::RootFeedingRosette => {\n   114\t            if state.substrate_layers.is_empty() {\n   115\t                return 0.2;\n   116\t            }\n   117\t\n   118\t            let total_depth_cm: f64 = state\n   119\t                .substrate_layers\n   120\t                .iter()\n   121\t                .map(|layer| layer.depth_cm)\n   122\t                .sum();\n   123\t            let depth_factor = (total_depth_cm / 5.0).clamp(0.0, 1.0);\n   124\t            let weighted_cec = state\n   125\t                .substrate_layers\n   126\t                .iter()\n   127\t                .map(|layer| layer.cation_exchange_capacity_index * layer.depth_cm.max(0.1))\n   128\t                .sum::<f64>()\n   129\t                / total_depth_cm.max(0.1);\n   130\t            let active_bonus = if state\n   131\t                .substrate_layers\n   132\t                .iter()\n   133\t                .any(|layer| matches!(layer.kind, crate::types::SubstrateKind::ActivePlanted))\n   134\t            {\n   135\t                0.15\n   136\t            } else {\n   137\t                0.0\n   138\t            };\n   139\t\n   140\t            (0.2 + (0.35 * depth_factor) + (0.3 * weighted_cec) + active_bonus).clamp(0.0, 1.0)\n   141\t        }\n   142\t    }\n   143\t}\n   144\t\n   145\tfn remove_plant_nutrients(\n   146\t    state: &mut TankState,\n   147\t    n_demand_mg: f64,\n   148\t    p_demand_mg: f64,\n   149\t    water_bias: f64,\n   150\t    substrate_bias: f64,\n   151\t) {\n   152\t    let water_n_target = n_demand_mg * water_bias;\n   153\t    let substrate_n_target = n_demand_mg * substrate_bias;\n   154\t    let water_p_target = p_demand_mg * water_bias;\n   155\t    let substrate_p_target = p_demand_mg * substrate_bias;\n   156\t\n   157\t    let water_n_removed = remove_water_n(state, water_n_target);\n   158\t    remove_substrate_n(\n   159\t        state,\n   160\t        substrate_n_target + (water_n_target - water_n_removed).max(0.0),\n   161\t    );\n   162\t\n   163\t    let water_p_removed = remove_water_p(state, water_p_target);\n   164\t    remove_substrate_p(\n   165\t        state,\n   166\t        substrate_p_target + (water_p_target - water_p_removed).max(0.0),\n   167\t    );\n   168\t}\n   169\t\n   170\tfn remove_water_n(state: &mut TankState, target_mg: f64) -> f64 {\n   171\t    let ammonia_removed = state.water.ammonia_total_mg_n_total.min(target_mg);\n   172\t    state.water.ammonia_total_mg_n_total -= ammonia_removed;\n   173\t\n   174\t    let remaining = (target_mg - ammonia_removed).max(0.0);\n   175\t    let nitrate_removed = state.water.nitrate_mg_n_total.min(remaining);\n   176\t    state.water.nitrate_mg_n_total -= nitrate_removed;\n   177\t\n   178\t    ammonia_removed + nitrate_removed\n   179\t}\n   180\t\n   181\tfn remove_water_p(state: &mut TankState, target_mg: f64) -> f64 {\n   182\t    let removed = state.water.phosphate_mg_p_total.min(target_mg);\n   183\t    state.water.phosphate_mg_p_total -= removed;\n   184\t    removed\n   185\t}\n   186\t\n   187\tfn remove_substrate_n(state: &mut TankState, target_mg: f64) -> f64 {\n   188\t    remove_substrate_pool(state, target_mg, true)\n   189\t}\n   190\t\n   191\tfn remove_substrate_p(state: &mut TankState, target_mg: f64) -> f64 {\n   192\t    remove_substrate_pool(state, target_mg, false)\n   193\t}\n   194\t\n   195\tfn remove_substrate_pool(state: &mut TankState, target_mg: f64, is_nitrogen: bool) -> f64 {\n   196\t    if target_mg <= f64::EPSILON || state.substrate_layers.is_empty() {\n   197\t        return 0.0;\n   198\t    }\n   199\t\n   200\t    let weights: Vec<f64> = state\n   201\t        .substrate_layers\n   202\t        .iter()\n   203\t        .map(|layer| {\n   204\t            let store = if is_nitrogen {\n   205\t                layer.nutrient_store_mg_n_total\n   206\t            } else {\n   207\t                layer.nutrient_store_mg_p_total\n   208\t            };\n   209\t            store * (0.4 + (0.6 * layer.cation_exchange_capacity_index))\n   210\t        })\n   211\t        .collect();\n   212\t    let total_weight: f64 = weights.iter().sum();\n   213\t    if total_weight <= f64::EPSILON {\n   214\t        return 0.0;\n   215\t    }\n   216\t\n   217\t    let mut removed_total = 0.0;\n   218\t    for (layer, weight) in state.substrate_layers.iter_mut().zip(weights.iter()) {\n   219\t        let share = target_mg * (*weight / total_weight);\n   220\t        let pool = if is_nitrogen {\n   221\t            &mut layer.nutrient_store_mg_n_total\n   222\t        } else {\n   223\t            &mut layer.nutrient_store_mg_p_total\n   224\t        };\n   225\t        let removed = (*pool).min(share);\n   226\t        *pool -= removed;\n   227\t        removed_total += removed;\n   228\t    }\n   229\t\n   230\t    let mut remainder = (target_mg - removed_total).max(0.0);\n   231\t    if remainder > f64::EPSILON {\n   232\t        for layer in &mut state.substrate_layers {\n   233\t            if remainder <= f64::EPSILON {\n   234\t                break;\n   235\t            }\n   236\t            let pool = if is_nitrogen {\n   237\t                &mut layer.nutrient_store_mg_n_total\n   238\t            } else {\n   239\t                &mut layer.nutrient_store_mg_p_total\n   240\t            };\n   241\t            let removed = (*pool).min(remainder);\n   242\t            *pool -= removed;\n   243\t            remainder -= removed;\n   244\t            removed_total += removed;\n   245\t        }\n   246\t    }\n   247\t\n   248\t    removed_total\n   249\t}\n   250\t\n   251\tfn total_substrate_n(state: &TankState) -> f64 {\n   252\t    state\n   253\t        .substrate_layers\n   254\t        .iter()\n   255\t        .map(|layer| layer.nutrient_store_mg_n_total)\n   256\t        .sum()\n   257\t}\n   258\t\n   259\tfn total_substrate_p(state: &TankState) -> f64 {\n   260\t    state\n","exit_code":0,"status":"completed"}}
