{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CHTZJABSP41tEXqBspTMp4","type":"tool_result","content":"     1→use crate::systems::chemistry::compute_nh3_mg_l;\n     2→use crate::types::{\n     3→    EggCohort, EventCause, EventKind, EventSeverity, ShrimpRuntimeParams, TankState,\n     4→};\n     5→\n     6→// ── Hourly ──────────────────────────────────────────────────────────────────\n     7→\n     8→/// Accumulates NH3, nitrite, low-DO, heat, and instability stress each hour.\n     9→/// Runs after chemistry/DO updates, before hourly event emission.\n    10→pub fn step_hourly_shrimp_stress(state: &mut TankState) {\n    11→    let total = state.animal.adults_count + state.animal.juveniles_count;\n    12→    if total == 0 {\n    13→        return;\n    14→    }\n    15→\n    16→    let volume_l = state.geometry.water_volume_l();\n    17→    if volume_l <= f64::EPSILON {\n    18→        return;\n    19→    }\n    20→\n    21→    let tan_mg_l = state.water.ammonia_total_mg_n_total / volume_l;\n    22→    let nh3_mg_l = compute_nh3_mg_l(tan_mg_l, state.water.ph, state.water.temperature_c);\n    23→    let nitrite_mg_l = state.water.nitrite_mg_n_total / volume_l;\n    24→    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n    25→    let temp = state.water.temperature_c;\n    26→\n    27→    // NH3 stress (threshold 0.02 mg/L, stronger than TAN alone)\n    28→    if nh3_mg_l > 0.02 {\n    29→        state.animal.hourly_nh3_stress_accum += (nh3_mg_l - 0.02) * 2.0 / 24.0;\n    30→    }\n    31→\n    32→    // Nitrite stress (threshold 0.5 mg/L)\n    33→    if nitrite_mg_l > 0.5 {\n    34→        state.animal.hourly_nitrite_stress_accum += (nitrite_mg_l - 0.5) * 0.5 / 24.0;\n    35→    }\n    36→\n    37→    // Low DO stress (threshold 5.0 mg/L)\n    38→    if do_mg_l < 5.0 {\n    39→        state.animal.hourly_low_do_stress_accum += (5.0 - do_mg_l) * 0.3 / 24.0;\n    40→    }\n    41→\n    42→    // Heat stress (above species optimal max)\n    43→    let opt_max = state.shrimp_params.optimal_temp_max_c;\n    44→    if temp > opt_max {\n    45→        state.animal.hourly_heat_stress_accum += (temp - opt_max) * 0.1 / 24.0;\n    46→    }\n    47→\n    48→    // Instability stress from stability tracker\n    49→    state.animal.hourly_instability_stress_accum +=\n    50→        state.stability_tracker.instability_index * 0.05 / 24.0;\n    51→}\n    52→\n    53→// ── Daily ───────────────────────────────────────────────────────────────────\n    54→\n    55→/// Full daily shrimp lifecycle: feeding → condition → molt stress →\n    56→/// reproductive readiness → spawning → egg development/hatching →\n    57→/// juvenile recruitment → mortality → events.\n    58→pub fn step_daily_shrimp(state: &mut TankState) {\n    59→    let total = state.animal.adults_count + state.animal.juveniles_count;\n    60→    if total == 0 && state.animal.berried_females_count == 0 {\n    61→        reset_hourly_accumulators(state);\n    62→        return;\n    63→    }\n    64→\n    65→    let volume_l = state.geometry.water_volume_l();\n    66→    if volume_l <= f64::EPSILON {\n    67→        reset_hourly_accumulators(state);\n    68→        return;\n    69→    }\n    70→\n    71→    shrimp_feeding(state, volume_l);\n    72→    update_condition(state, volume_l);\n    73→    update_molt_stress(state, volume_l);\n    74→    update_reproductive_readiness(state);\n    75→    spawning(state);\n    76→    egg_development(state);\n    77→    juvenile_recruitment(state);\n    78→    mortality(state);\n    79→    emit_molt_stress_warning(state, volume_l);\n    80→\n    81→    reset_hourly_accumulators(state);\n    82→}\n    83→\n    84→/// Updates the stability tracker at the end of each daily cycle.\n    85→pub fn update_stability_tracker(state: &mut TankState) {\n    86→    let volume_l = state.geometry.water_volume_l().max(f64::EPSILON);\n    87→    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n    88→    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n    89→    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n    90→    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n    91→\n    92→    let tracker = &mut state.stability_tracker;\n    93→\n    94→    let temp_swing = (state.water.temperature_c - tracker.prev_temp_c).abs();\n    95→    let ph_swing = (state.water.ph - tracker.prev_ph).abs();\n    96→    let gh_swing = (gh_d - tracker.prev_gh_d).abs();\n    97→    let do_swing = (do_mg_l - tracker.prev_do_mg_l).abs();\n    98→\n    99→    // Weighted instability normalised to 0..1\n   100→    let raw_instability =\n   101→        (temp_swing / 3.0 + ph_swing / 0.5 + gh_swing / 3.0 + do_swing / 3.0).clamp(0.0, 1.0);\n   102→\n   103→    // Rises quickly, decays slowly\n   104→    if raw_instability > tracker.instability_index {\n   105→        tracker.instability_index += 0.3 * (raw_instability - tracker.instability_index);\n   106→    } else {\n   107→        tracker.instability_index += 0.1 * (raw_instability - tracker.instability_index);\n   108→    }\n   109→    tracker.instability_index = tracker.instability_index.clamp(0.0, 1.0);\n   110→\n   111→    tracker.prev_temp_c = state.water.temperature_c;\n   112→    tracker.prev_ph = state.water.ph;\n   113→    tracker.prev_gh_d = gh_d;\n   114→    tracker.prev_do_mg_l = do_mg_l;\n   115→}\n   116→\n   117→// ── Private helpers ─────────────────────────────────────────────────────────\n   118→\n   119→fn shrimp_feeding(state: &mut TankState, _volume_l: f64) {\n   120→    let adults = state.animal.adults_count as f64;\n   121→    let juveniles = state.animal.juveniles_count as f64;\n   122→    let total_feeding_units = adults + juveniles * 0.3;\n   123→    let rate = state\n   124→        .process_params\n   125→        .shrimp_periphyton_grazing_g_per_shrimp_per_day;\n   126→    let food_demand = total_feeding_units * rate;\n   127→\n   128→    // Shrimp graze periphyton (at most 50% of available per day)\n   129→    let max_periph = state.algae.periphyton_biomass_g * 0.5;\n   130→    let periph_consumed = food_demand.min(max_periph).max(0.0);\n   131→    state.algae.periphyton_biomass_g =\n   132→        (state.algae.periphyton_biomass_g - periph_consumed).max(0.0);\n   133→\n   134→    // Shrimp also eat fine detritus (biofilm, decomposing organic matter)\n   135→    let detritus_demand = total_feeding_units * rate;\n   136→    let max_detritus = state.detritus.fine_detritus_g_total * 0.2;\n   137→    let detritus_consumed = detritus_demand.min(max_detritus).max(0.0);\n   138→    state.detritus.fine_detritus_g_total =\n   139→        (state.detritus.fine_detritus_g_total - detritus_consumed).max(0.0);\n   140→}\n   141→\n   142→fn update_condition(state: &mut TankState, volume_l: f64) {\n   143→    let tan_mg_l = state.water.ammonia_total_mg_n_total / volume_l;\n   144→    let nh3_mg_l = compute_nh3_mg_l(tan_mg_l, state.water.ph, state.water.temperature_c);\n   145→    let nitrite_mg_l = state.water.nitrite_mg_n_total / volume_l;\n   146→    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n   147→    let temp = state.water.temperature_c;\n   148→\n   149→    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n   150→    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n   151→    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n   152→\n   153→    let total_shrimp = state.animal.adults_count as f64 + state.animal.juveniles_count as f64;\n   154→    let available_food =\n   155→        state.algae.periphyton_biomass_g + state.detritus.fine_detritus_g_total * 0.3;\n   156→    let food_per_shrimp = if total_shrimp > 0.0 {\n   157→        available_food / total_shrimp\n   158→    } else {\n   159→        1.0\n   160→    };\n   161→\n   162→    let food_factor = (food_per_shrimp / 0.05).clamp(0.0, 1.0);\n   163→    let do_factor = (do_mg_l / 6.0).clamp(0.0, 1.0);\n   164→    // NH3 risk: condition degrades steadily, reaching zero at ~0.33 mg/L NH3\n   165→    let nh3_factor = (1.0 - nh3_mg_l * 3.0).clamp(0.0, 1.0);\n   166→    let nitrite_factor = (1.0 - nitrite_mg_l * 0.5).clamp(0.0, 1.0);\n   167→\n   168→    let params = &state.shrimp_params;\n   169→    let temp_factor = temp_condition_factor(temp, params);\n   170→    let gh_factor = gh_mineral_factor(gh_d, params);\n   171→    let instability_factor = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n   172→\n   173→    let stress_penalty = state.animal.hourly_nh3_stress_accum\n   174→        + state.animal.hourly_nitrite_stress_accum\n   175→        + state.animal.hourly_low_do_stress_accum\n   176→        + state.animal.hourly_heat_stress_accum\n   177→        + state.animal.hourly_instability_stress_accum;\n   178→\n   179→    let target = (food_factor\n   180→        * do_factor\n   181→        * nh3_factor\n   182→        * nitrite_factor\n   183→        * temp_factor\n   184→        * gh_factor\n   185→        * instability_factor\n   186→        - stress_penalty * 0.5)\n   187→        .clamp(0.0, 1.0);\n   188→\n   189→    let smoothing = state.process_params.shrimp_condition_smoothing;\n   190→    state.animal.condition_index += smoothing * (target - state.animal.condition_index);\n   191→    state.animal.condition_index = state.animal.condition_index.clamp(0.0, 1.0);\n   192→}\n   193→\n   194→fn update_molt_stress(state: &mut TankState, volume_l: f64) {\n   195→    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n   196→    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n   197→    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n   198→    let params = &state.shrimp_params;\n   199→\n   200→    let gh_stress = if gh_d < params.gh_min_d {\n   201→        (params.gh_min_d - gh_d) / params.gh_min_d\n   202→    } else {\n   203→        0.0\n   204→    };\n   205→\n   206→    let instability_stress = state.stability_tracker.instability_index;\n   207→    let condition_stress = (0.5 - state.animal.condition_index).max(0.0);\n   208→    let thermal_stress = if state.water.temperature_c > params.optimal_temp_max_c {\n   209→        ((state.water.temperature_c - params.optimal_temp_max_c) / 8.0).clamp(0.0, 0.5)\n   210→    } else {\n   211→        0.0\n   212→    };\n   213→\n   214→    let hourly_pressure =\n   215→        state.animal.hourly_heat_stress_accum + state.animal.hourly_instability_stress_accum;\n   216→\n   217→    let stress_pressure = (gh_stress * 0.3\n   218→        + instability_stress * 0.3\n   219→        + condition_stress * 0.2\n   220→        + thermal_stress * 0.2\n   221→        + hourly_pressure * 0.3)\n   222→        .clamp(0.0, 1.0);\n   223→\n   224→    // Rises quickly, decays slowly\n   225→    if stress_pressure > state.animal.molt_stress_index {\n   226→        state.animal.molt_stress_index += 0.2 * (stress_pressure - state.animal.molt_stress_index);\n   227→    } else {\n   228→        state.animal.molt_stress_index += 0.05 * (stress_pressure - state.animal.molt_stress_index);\n   229→    }\n   230→    state.animal.molt_stress_index = state.animal.molt_stress_index.clamp(0.0, 1.0);\n   231→}\n   232→\n   233→fn update_reproductive_readiness(state: &mut TankState) {\n   234→    let temp = state.water.temperature_c;\n   235→    let params = &state.shrimp_params;\n   236→\n   237→    let f_temp = temp_repro_factor(temp, params);\n   238→    let f_condition = state.animal.condition_index;\n   239→    let f_stability = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n   240→    let f_molt = (1.0 - state.animal.molt_stress_index).clamp(0.0, 1.0);\n   241→\n   242→    let target = (f_temp * f_condition * f_stability * f_molt).clamp(0.0, 1.0);\n   243→\n   244→    state.animal.reproductive_readiness_index +=\n   245→        0.1 * (target - state.animal.reproductive_readiness_index);\n   246→    state.animal.reproductive_readiness_index =\n   247→        state.animal.reproductive_readiness_index.clamp(0.0, 1.0);\n   248→}\n   249→\n   250→fn spawning(state: &mut TankState) {\n   251→    if state.animal.adults_count == 0 {\n   252→        return;\n   253→    }\n   254→\n   255→    let eligible = ((0.5 * state.animal.adults_count as f64)\n   256→        - state.animal.berried_females_count as f64)\n   257→        .max(0.0) as u32;\n   258→\n   259→    if eligible == 0 {\n   260→        return;\n   261→    }\n   262→\n   263→    let temp = state.water.temperature_c;\n   264→    let params = &state.shrimp_params;\n   265→\n   266→    let f_temp = temp_repro_factor(temp, params);\n   267→    let f_condition = state.animal.condition_index;\n   268→    let f_stability = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n   269→\n   270→    let volume_l = state.geometry.water_volume_l().max(f64::EPSILON);\n   271→    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n   272→    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n   273→    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n   274→    let f_mineral = gh_mineral_factor(gh_d, params);\n   275→\n   276→    let p_spawn = params.base_spawn_rate * f_temp * f_condition * f_stability * f_mineral;\n   277→\n   278→    let mut new_berried = 0u32;\n   279→    for _ in 0..eligible {\n   280→        if state.rng.next_f64() < p_spawn {\n   281→            new_berried += 1;\n   282→        }\n   283→    }\n   284→\n   285→    if new_berried > 0 {\n   286→        state.animal.berried_females_count += new_berried;\n   287→        // Create a new cohort for this batch of berried females\n   288→        state.animal.egg_cohorts.push(EggCohort {\n   289→            count: new_berried,\n   290→            progress_days: 0.0,\n   291→        });\n   292→\n   293→        crate::systems::events::emit_once_per_day_pub(\n   294→            state,\n   295→            EventSeverity::Info,\n   296→            EventKind::ShrimpBerried,\n   297→            vec![EventCause::RoutineAction],\n   298→            format!(\"{new_berried} female(s) became berried\"),\n   299→        );\n   300→    }\n   301→}\n   302→\n   303→fn egg_development(state: &mut TankState) {\n   304→    if state.animal.egg_cohorts.is_empty() {\n   305→        // Legacy path: if berried females exist without cohorts (e.g. from old save),\n   306→        // migrate them into a single cohort using the current egg_progress_days.\n   307→        if state.animal.berried_females_count > 0 {\n   308→            state.animal.egg_cohorts.push(EggCohort {\n   309→                count: state.animal.berried_females_count,\n   310→                progress_days: state.animal.egg_progress_days,\n   311→            });\n   312→        } else {\n   313→            return;\n   314→        }\n   315→    }\n   316→\n   317→    let volume_l = state.geometry.water_volume_l().max(f64::EPSILON);\n   318→    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n   319→    let temp = state.water.temperature_c;\n   320→    let params = &state.shrimp_params;\n   321→\n   322→    let f_condition = state.animal.condition_index;\n   323→    let f_oxygen = (do_mg_l / 6.0).clamp(0.0, 1.0);\n   324→    let f_temp = temp_repro_factor(temp, params);\n   325→    let f_stability = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n   326→\n   327→    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n   328→    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n   329→    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n   330→    let f_mineral = gh_mineral_factor(gh_d, params);\n   331→\n   332→    let p_hatch =\n   333→        params.hatch_success_base * f_condition * f_oxygen * f_temp * f_stability * f_mineral;\n   334→\n   335→    let egg_duration = params.egg_duration_days as f64;\n   336→    let mut total_successful = 0u32;\n   337→    let mut total_failed = 0u32;\n   338→    let mut resolved_berried = 0u32;\n   339→\n   340→    // Advance each cohort; resolve only those that have reached duration\n   341→    let mut i = 0;\n   342→    while i < state.animal.egg_cohorts.len() {\n   343→        state.animal.egg_cohorts[i].progress_days += 1.0;\n   344→\n   345→        if state.animal.egg_cohorts[i].progress_days >= egg_duration {\n   346→            let cohort = state.animal.egg_cohorts.remove(i);\n   347→            resolved_berried += cohort.count;\n   348→\n   349→            for _ in 0..cohort.count {\n   350→                if state.rng.next_f64() < p_hatch {\n   351→                    total_successful += 1;\n   352→                } else {\n   353→                    total_failed += 1;\n   354→                }\n   355→            }\n   356→            // Don't increment i; the next cohort shifted into position\n   357→        } else {\n   358→            i += 1;\n   359→        }\n   360→    }\n   361→\n   362→    // Successful hatches produce juveniles (~25 per clutch for Neocaridina)\n   363→    let juveniles_per_clutch = 25u32;\n   364→    if total_successful > 0 {\n   365→        state.animal.juveniles_count += total_successful * juveniles_per_clutch;\n   366→    }\n   367→\n   368→    // Only resolved clutches leave berried_females_count\n   369→    state.animal.berried_females_count = state\n   370→        .animal\n   371→        .berried_females_count\n   372→        .saturating_sub(resolved_berried);\n   373→\n   374→    if total_failed > 0 {\n   375→        // Failure-mode invariant: on hatch failure, juveniles_count does NOT increase\n   376→        let mut causes = Vec::new();\n   377→        if f_oxygen < 0.6 {\n   378→            causes.push(EventCause::LowOxygen);\n   379→        }\n   380→        if f_temp < 0.5 {\n   381→            causes.push(EventCause::HighTemperature);\n   382→        }\n   383→        if f_mineral < 0.6 {\n   384→            causes.push(EventCause::LowMinerals);\n   385→        }\n   386→        if f_stability < 0.6 {\n   387→            causes.push(EventCause::ChemistryInstability);\n   388→        }\n   389→        if causes.is_empty() {\n   390→            causes.push(EventCause::PoorCondition);\n   391→        }\n   392→\n   393→        crate::systems::events::emit_once_per_day_pub(\n   394→            state,\n   395→            EventSeverity::Warning,\n   396→            EventKind::EggFailure,\n   397→            causes,\n   398→            format!(\"{total_failed} clutch(es) failed to hatch\"),\n   399→        );\n   400→    }\n   401→\n   402→    // Update egg_progress_days from remaining cohorts for display/snapshot\n   403→    state.animal.sync_egg_progress_from_cohorts();\n   404→}\n   405→\n   406→fn juvenile_recruitment(state: &mut TankState) {\n   407→    if state.animal.juveniles_count == 0 {\n   408→        return;\n   409→    }\n   410→\n   411→    let maturation_rate = 1.0\n   412→        / state\n   413→            .process_params\n   414→            .shrimp_juvenile_maturation_days\n   415→            .max(1.0);\n   416→    let maturing = (state.animal.juveniles_count as f64 * maturation_rate).floor() as u32;\n   417→    let maturing = maturing.min(state.animal.juveniles_count);\n   418→\n   419→    state.animal.juveniles_count -= maturing;\n   420→    state.animal.adults_count += maturing;\n   421→}\n   422→\n   423→fn mortality(state: &mut TankState) {\n   424→    let base_rate = state.process_params.shrimp_base_mortality_per_day;\n   425→    let stress_scale = state.process_params.shrimp_stress_mortality_scale;\n   426→\n   427→    let stress_total = state.animal.hourly_nh3_stress_accum\n   428→        + state.animal.hourly_nitrite_stress_accum\n   429→        + state.animal.hourly_low_do_stress_accum\n   430→        + state.animal.hourly_heat_stress_accum\n   431→        + (state.animal.molt_stress_index - 0.5).max(0.0)\n   432→        + (0.5 - state.animal.condition_index).max(0.0);\n   433→\n   434→    let p_adult_death = (base_rate + stress_total * stress_scale).clamp(0.0, 0.5);\n   435→\n   436→    let juv_sensitivity = state.shrimp_params.juvenile_sensitivity;\n   437→    let p_juv_death = (base_rate + stress_total * stress_scale * juv_sensitivity).clamp(0.0, 0.5);\n   438→\n   439→    let mut adult_deaths = 0u32;\n   440→    for _ in 0..state.animal.adults_count {\n   441→        if state.rng.next_f64() < p_adult_death {\n   442→            adult_deaths += 1;\n   443→        }\n   444→    }\n   445→\n   446→    let mut juv_deaths = 0u32;\n   447→    for _ in 0..state.animal.juveniles_count {\n   448→        if state.rng.next_f64() < p_juv_death {\n   449→            juv_deaths += 1;\n   450→        }\n   451→    }\n   452→\n   453→    state.animal.adults_count = state.animal.adults_count.saturating_sub(adult_deaths);\n   454→    state.animal.juveniles_count = state.animal.juveniles_count.saturating_sub(juv_deaths);\n   455→\n   456→    // Preserve berried_females <= adults invariant (also trims egg cohorts)\n   457→    state.animal.clamp_berried_to_adults();\n   458→}\n   459→\n   460→fn emit_molt_stress_warning(state: &mut TankState, volume_l: f64) {\n   461→    if state.animal.molt_stress_index <= 0.6 {\n   462→        return;\n   463→    }\n   464→\n   465→    let mut causes = Vec::new();\n   466→    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n   467→    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n   468→    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n   469→\n   470→    if gh_d < state.shrimp_params.gh_min_d {\n   471→        causes.push(EventCause::LowMinerals);\n   472→    }\n   473→    if state.stability_tracker.instability_index > 0.3 {\n   474→        causes.push(EventCause::ChemistryInstability);\n   475→    }\n   476→    if state.water.temperature_c > state.shrimp_params.optimal_temp_max_c {\n   477→        causes.push(EventCause::HighTemperature);\n   478→    }\n   479→    if causes.is_empty() {\n   480→        causes.push(EventCause::PoorCondition);\n   481→    }\n   482→\n   483→    crate::systems::events::emit_once_per_day_pub(\n   484→        state,\n   485→        EventSeverity::Warning,\n   486→        EventKind::MoltStressWarning,\n   487→        causes,\n   488→        format!(\n   489→            \"Molt stress elevated: {:.2}\",\n   490→            state.animal.molt_stress_index\n   491→        ),\n   492→    );\n   493→}\n   494→\n   495→fn reset_hourly_accumulators(state: &mut TankState) {\n   496→    state.animal.hourly_nh3_stress_accum = 0.0;\n   497→    state.animal.hourly_nitrite_stress_accum = 0.0;\n   498→    state.animal.hourly_low_do_stress_accum = 0.0;\n   499→    state.animal.hourly_heat_stress_accum = 0.0;\n   500→    state.animal.hourly_instability_stress_accum = 0.0;\n   501→}\n   502→\n   503→// ── Factor functions ────────────────────────────────────────────────────────\n   504→\n   505→/// Temperature factor for reproduction.\n   506→/// Best 22–26 °C, clearly worse by 30 °C, near-zero by 33 °C.\n   507→fn temp_repro_factor(temp: f64, params: &ShrimpRuntimeParams) -> f64 {\n   508→    let opt_min = params.optimal_temp_min_c;\n   509→    let opt_max = params.optimal_temp_max_c;\n   510→    let penalty_start = params.high_temp_repro_penalty_start_c;\n   511→    let penalty_full = params.high_temp_repro_penalty_full_c;\n   512→\n   513→    if temp < opt_min - 4.0 {\n   514→        0.1\n   515→    } else if temp < opt_min {\n   516→        0.1 + 0.9 * (temp - (opt_min - 4.0)) / 4.0\n   517→    } else if temp <= opt_max {\n   518→        1.0\n   519→    } else if temp <= penalty_start {\n   520→        let range = (penalty_start - opt_max).max(0.01);\n   521→        1.0 - 0.5 * (temp - opt_max) / range\n   522→    } else if temp <= penalty_full {\n   523→        let range = (penalty_full - penalty_start).max(0.01);\n   524→        0.5 - 0.45 * (temp - penalty_start) / range\n   525→    } else {\n   526→        0.05\n   527→    }\n   528→}\n   529→\n   530→/// Temperature factor for general condition (broader bell than reproduction).\n   531→fn temp_condition_factor(temp: f64, params: &ShrimpRuntimeParams) -> f64 {\n   532→    if temp >= params.optimal_temp_min_c && temp <= params.optimal_temp_max_c {\n   533→        1.0\n   534→    } else if temp < params.optimal_temp_min_c {\n   535→        (1.0 - (params.optimal_temp_min_c - temp) / 10.0).clamp(0.2, 1.0)\n   536→    } else {\n   537→        (1.0 - (temp - params.optimal_temp_max_c) / 8.0).clamp(0.2, 1.0)\n   538→    }\n   539→}\n   540→\n   541→/// GH/mineral factor for spawning and condition.\n   542→fn gh_mineral_factor(gh_d: f64, params: &ShrimpRuntimeParams) -> f64 {\n   543→    if gh_d >= params.gh_min_d && gh_d <= params.gh_max_d {\n   544→        1.0\n   545→    } else if gh_d < params.gh_min_d {\n   546→        (gh_d / params.gh_min_d.max(0.01)).clamp(0.3, 1.0)\n   547→    } else {\n   548→        (1.0 - (gh_d - params.gh_max_d) / 10.0).clamp(0.3, 1.0)\n   549→    }\n   550→}\n   551→"}]},"parent_tool_use_id":"toolu_01XhHENGYXj4UW1xu3YwzppQ","session_id":"94a28873-9e1b-4b56-baad-3f78c1e4f81f","uuid":"698dc986-6500-4415-be5a-12fa6301e3a0"}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01NbDbEXLNK4zPWABhgL4X6h","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WBtDp5DkXQjge55NAHbSX1","name":"Read","input":{"file_path":"/root/tank-simulation/crates/tank_core/src/systems/microfauna.rs"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":5,"cache_creation_input_tokens":10549,"cache_read_input_tokens":16328,"cache_creation":{"ephemeral_5m_input_tokens":10549,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":"toolu_01XhHENGYXj4UW1xu3YwzppQ","session_id":"94a28873-9e1b-4b56-baad-3f78c1e4f81f","uuid":"477e932c-fe6c-4c0f-a487-29441fb1abe5"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WBtDp5DkXQjge55NAHbSX1","type":"tool_result","content":"     1→use crate::types::TankState;\n     2→\n     3→/// Daily microfauna turnover: updates population_index and grazing_pressure_index\n     4→/// from detritus/periphyton resource availability and shrimp grazing pressure.\n     5→///\n     6→/// Microfauna effects:\n     7→/// - Modestly improves mineralization efficiency (applied in nitrogen_cycle)\n     8→/// - Consumes some periphyton/bacterial resource\n     9→/// - Declines under heavy shrimp grazing\n    10→pub fn step_daily_microfauna(state: &mut TankState) {\n    11→    let volume_l = state.geometry.water_volume_l();\n    12→    if volume_l <= f64::EPSILON {\n    13→        return;\n    14→    }\n    15→\n    16→    let pp = &state.process_params;\n    17→\n    18→    // Resource availability (detritus + periphyton as food for microfauna)\n    19→    // Reference densities are generous so microfauna don't over-respond to\n    20→    // short-term feeding pulses.\n    21→    let detritus_density = state.detritus.fine_detritus_g_total / volume_l;\n    22→    let detritus_resource = (detritus_density / 2.0).clamp(0.0, 1.0);\n    23→    let periphyton_density = state.algae.periphyton_biomass_g / volume_l;\n    24→    let periphyton_resource = (periphyton_density / 1.0).clamp(0.0, 1.0);\n    25→    let resource_availability =\n    26→        (0.5 * detritus_resource + 0.5 * periphyton_resource).clamp(0.0, 1.0);\n    27→\n    28→    // Shrimp grazing pressure on microfauna\n    29→    let total_shrimp = (state.animal.adults_count + state.animal.juveniles_count) as f64;\n    30→    let shrimp_density = total_shrimp / volume_l;\n    31→    let shrimp_pressure =\n    32→        (shrimp_density / pp.microfauna_shrimp_pressure_threshold.max(0.01)).clamp(0.0, 1.0);\n    33→\n    34→    // Population target: grows with resources, declines with shrimp pressure\n    35→    let growth_target = resource_availability * (1.0 - 0.6 * shrimp_pressure);\n    36→    let smoothing = pp.microfauna_population_smoothing;\n    37→    state.microfauna.population_index = (state.microfauna.population_index\n    38→        + smoothing * (growth_target - state.microfauna.population_index))\n    39→        .clamp(0.0, 1.0);\n    40→\n    41→    // Grazing pressure reflects population and available food\n    42→    state.microfauna.grazing_pressure_index =\n    43→        (state.microfauna.population_index * resource_availability.sqrt()).clamp(0.0, 1.0);\n    44→\n    45→    // Microfauna consume some periphyton (without driving it negative)\n    46→    let consumption_fraction =\n    47→        pp.microfauna_periphyton_consumption * state.microfauna.population_index;\n    48→    let consumed = state.algae.periphyton_biomass_g * consumption_fraction;\n    49→    state.algae.periphyton_biomass_g = (state.algae.periphyton_biomass_g - consumed).max(0.0);\n    50→\n    51→    // Microfauna also process some fine detritus (modest)\n    52→    let detritus_consumed =\n    53→        state.detritus.fine_detritus_g_total * 0.01 * state.microfauna.population_index;\n    54→    state.detritus.fine_detritus_g_total =\n    55→        (state.detritus.fine_detritus_g_total - detritus_consumed).max(0.0);\n    56→}\n    57→"}]},"parent_tool_use_id":"toolu_01XhHENGYXj4UW1xu3YwzppQ","session_id":"94a28873-9e1b-4b56-baad-3f78c1e4f81f","uuid":"a5dc0d74-93cc-4a04-a4db-a3d5228309e3"}
