{"type":"item.completed","item":{"id":"item_87","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/src/systems/shrimp.rs | sed -n '1,260p'\"","aggregated_output":"     1\tuse crate::systems::chemistry::compute_nh3_mg_l;\n     2\tuse crate::types::{\n     3\t    EggCohort, EventCause, EventKind, EventSeverity, ShrimpRuntimeParams, TankState,\n     4\t};\n     5\t\n     6\t// ── Hourly ──────────────────────────────────────────────────────────────────\n     7\t\n     8\t/// Accumulates NH3, nitrite, low-DO, heat, and instability stress each hour.\n     9\t/// Runs after chemistry/DO updates, before hourly event emission.\n    10\tpub fn step_hourly_shrimp_stress(state: &mut TankState) {\n    11\t    let total = state.animal.adults_count + state.animal.juveniles_count;\n    12\t    if total == 0 {\n    13\t        return;\n    14\t    }\n    15\t\n    16\t    let volume_l = state.geometry.water_volume_l();\n    17\t    if volume_l <= f64::EPSILON {\n    18\t        return;\n    19\t    }\n    20\t\n    21\t    let tan_mg_l = state.water.ammonia_total_mg_n_total / volume_l;\n    22\t    let nh3_mg_l = compute_nh3_mg_l(tan_mg_l, state.water.ph, state.water.temperature_c);\n    23\t    let nitrite_mg_l = state.water.nitrite_mg_n_total / volume_l;\n    24\t    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n    25\t    let temp = state.water.temperature_c;\n    26\t\n    27\t    // NH3 stress (threshold 0.02 mg/L, stronger than TAN alone)\n    28\t    if nh3_mg_l > 0.02 {\n    29\t        state.animal.hourly_nh3_stress_accum += (nh3_mg_l - 0.02) * 2.0 / 24.0;\n    30\t    }\n    31\t\n    32\t    // Nitrite stress (threshold 0.5 mg/L)\n    33\t    if nitrite_mg_l > 0.5 {\n    34\t        state.animal.hourly_nitrite_stress_accum += (nitrite_mg_l - 0.5) * 0.5 / 24.0;\n    35\t    }\n    36\t\n    37\t    // Low DO stress (threshold 5.0 mg/L)\n    38\t    if do_mg_l < 5.0 {\n    39\t        state.animal.hourly_low_do_stress_accum += (5.0 - do_mg_l) * 0.3 / 24.0;\n    40\t    }\n    41\t\n    42\t    // Heat stress (above species optimal max)\n    43\t    let opt_max = state.shrimp_params.optimal_temp_max_c;\n    44\t    if temp > opt_max {\n    45\t        state.animal.hourly_heat_stress_accum += (temp - opt_max) * 0.1 / 24.0;\n    46\t    }\n    47\t\n    48\t    // Instability stress from stability tracker\n    49\t    state.animal.hourly_instability_stress_accum +=\n    50\t        state.stability_tracker.instability_index * 0.05 / 24.0;\n    51\t}\n    52\t\n    53\t// ── Daily ───────────────────────────────────────────────────────────────────\n    54\t\n    55\t/// Full daily shrimp lifecycle: feeding → condition → molt stress →\n    56\t/// reproductive readiness → spawning → egg development/hatching →\n    57\t/// juvenile recruitment → mortality → events.\n    58\tpub fn step_daily_shrimp(state: &mut TankState) {\n    59\t    let total = state.animal.adults_count + state.animal.juveniles_count;\n    60\t    if total == 0 && state.animal.berried_females_count == 0 {\n    61\t        reset_hourly_accumulators(state);\n    62\t        return;\n    63\t    }\n    64\t\n    65\t    let volume_l = state.geometry.water_volume_l();\n    66\t    if volume_l <= f64::EPSILON {\n    67\t        reset_hourly_accumulators(state);\n    68\t        return;\n    69\t    }\n    70\t\n    71\t    shrimp_feeding(state, volume_l);\n    72\t    update_condition(state, volume_l);\n    73\t    update_molt_stress(state, volume_l);\n    74\t    update_reproductive_readiness(state);\n    75\t    spawning(state);\n    76\t    egg_development(state);\n    77\t    juvenile_recruitment(state);\n    78\t    mortality(state);\n    79\t    emit_molt_stress_warning(state, volume_l);\n    80\t\n    81\t    reset_hourly_accumulators(state);\n    82\t}\n    83\t\n    84\t/// Updates the stability tracker at the end of each daily cycle.\n    85\tpub fn update_stability_tracker(state: &mut TankState) {\n    86\t    let volume_l = state.geometry.water_volume_l().max(f64::EPSILON);\n    87\t    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n    88\t    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n    89\t    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n    90\t    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n    91\t\n    92\t    let tracker = &mut state.stability_tracker;\n    93\t\n    94\t    let temp_swing = (state.water.temperature_c - tracker.prev_temp_c).abs();\n    95\t    let ph_swing = (state.water.ph - tracker.prev_ph).abs();\n    96\t    let gh_swing = (gh_d - tracker.prev_gh_d).abs();\n    97\t    let do_swing = (do_mg_l - tracker.prev_do_mg_l).abs();\n    98\t\n    99\t    // Weighted instability normalised to 0..1\n   100\t    let raw_instability =\n   101\t        (temp_swing / 3.0 + ph_swing / 0.5 + gh_swing / 3.0 + do_swing / 3.0).clamp(0.0, 1.0);\n   102\t\n   103\t    // Rises quickly, decays slowly\n   104\t    if raw_instability > tracker.instability_index {\n   105\t        tracker.instability_index += 0.3 * (raw_instability - tracker.instability_index);\n   106\t    } else {\n   107\t        tracker.instability_index += 0.1 * (raw_instability - tracker.instability_index);\n   108\t    }\n   109\t    tracker.instability_index = tracker.instability_index.clamp(0.0, 1.0);\n   110\t\n   111\t    tracker.prev_temp_c = state.water.temperature_c;\n   112\t    tracker.prev_ph = state.water.ph;\n   113\t    tracker.prev_gh_d = gh_d;\n   114\t    tracker.prev_do_mg_l = do_mg_l;\n   115\t}\n   116\t\n   117\t// ── Private helpers ─────────────────────────────────────────────────────────\n   118\t\n   119\tfn shrimp_feeding(state: &mut TankState, _volume_l: f64) {\n   120\t    let adults = state.animal.adults_count as f64;\n   121\t    let juveniles = state.animal.juveniles_count as f64;\n   122\t    let total_feeding_units = adults + juveniles * 0.3;\n   123\t    let rate = state\n   124\t        .process_params\n   125\t        .shrimp_periphyton_grazing_g_per_shrimp_per_day;\n   126\t    let food_demand = total_feeding_units * rate;\n   127\t\n   128\t    // Shrimp graze periphyton (at most 50% of available per day)\n   129\t    let max_periph = state.algae.periphyton_biomass_g * 0.5;\n   130\t    let periph_consumed = food_demand.min(max_periph).max(0.0);\n   131\t    state.algae.periphyton_biomass_g =\n   132\t        (state.algae.periphyton_biomass_g - periph_consumed).max(0.0);\n   133\t\n   134\t    // Shrimp also eat fine detritus (biofilm, decomposing organic matter)\n   135\t    let detritus_demand = total_feeding_units * rate;\n   136\t    let max_detritus = state.detritus.fine_detritus_g_total * 0.2;\n   137\t    let detritus_consumed = detritus_demand.min(max_detritus).max(0.0);\n   138\t    state.detritus.fine_detritus_g_total =\n   139\t        (state.detritus.fine_detritus_g_total - detritus_consumed).max(0.0);\n   140\t}\n   141\t\n   142\tfn update_condition(state: &mut TankState, volume_l: f64) {\n   143\t    let tan_mg_l = state.water.ammonia_total_mg_n_total / volume_l;\n   144\t    let nh3_mg_l = compute_nh3_mg_l(tan_mg_l, state.water.ph, state.water.temperature_c);\n   145\t    let nitrite_mg_l = state.water.nitrite_mg_n_total / volume_l;\n   146\t    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n   147\t    let temp = state.water.temperature_c;\n   148\t\n   149\t    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n   150\t    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n   151\t    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n   152\t\n   153\t    let total_shrimp = state.animal.adults_count as f64 + state.animal.juveniles_count as f64;\n   154\t    let available_food =\n   155\t        state.algae.periphyton_biomass_g + state.detritus.fine_detritus_g_total * 0.3;\n   156\t    let food_per_shrimp = if total_shrimp > 0.0 {\n   157\t        available_food / total_shrimp\n   158\t    } else {\n   159\t        1.0\n   160\t    };\n   161\t\n   162\t    let food_factor = (food_per_shrimp / 0.05).clamp(0.0, 1.0);\n   163\t    let do_factor = (do_mg_l / 6.0).clamp(0.0, 1.0);\n   164\t    // NH3 risk: condition degrades steadily, reaching zero at ~0.33 mg/L NH3\n   165\t    let nh3_factor = (1.0 - nh3_mg_l * 3.0).clamp(0.0, 1.0);\n   166\t    let nitrite_factor = (1.0 - nitrite_mg_l * 0.5).clamp(0.0, 1.0);\n   167\t\n   168\t    let params = &state.shrimp_params;\n   169\t    let temp_factor = temp_condition_factor(temp, params);\n   170\t    let gh_factor = gh_mineral_factor(gh_d, params);\n   171\t    let instability_factor = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n   172\t\n   173\t    let stress_penalty = state.animal.hourly_nh3_stress_accum\n   174\t        + state.animal.hourly_nitrite_stress_accum\n   175\t        + state.animal.hourly_low_do_stress_accum\n   176\t        + state.animal.hourly_heat_stress_accum\n   177\t        + state.animal.hourly_instability_stress_accum;\n   178\t\n   179\t    let target = (food_factor\n   180\t        * do_factor\n   181\t        * nh3_factor\n   182\t        * nitrite_factor\n   183\t        * temp_factor\n   184\t        * gh_factor\n   185\t        * instability_factor\n   186\t        - stress_penalty * 0.5)\n   187\t        .clamp(0.0, 1.0);\n   188\t\n   189\t    let smoothing = state.process_params.shrimp_condition_smoothing;\n   190\t    state.animal.condition_index += smoothing * (target - state.animal.condition_index);\n   191\t    state.animal.condition_index = state.animal.condition_index.clamp(0.0, 1.0);\n   192\t}\n   193\t\n   194\tfn update_molt_stress(state: &mut TankState, volume_l: f64) {\n   195\t    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n   196\t    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n   197\t    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n   198\t    let params = &state.shrimp_params;\n   199\t\n   200\t    let gh_stress = if gh_d < params.gh_min_d {\n   201\t        (params.gh_min_d - gh_d) / params.gh_min_d\n   202\t    } else {\n   203\t        0.0\n   204\t    };\n   205\t\n   206\t    let instability_stress = state.stability_tracker.instability_index;\n   207\t    let condition_stress = (0.5 - state.animal.condition_index).max(0.0);\n   208\t    let thermal_stress = if state.water.temperature_c > params.optimal_temp_max_c {\n   209\t        ((state.water.temperature_c - params.optimal_temp_max_c) / 8.0).clamp(0.0, 0.5)\n   210\t    } else {\n   211\t        0.0\n   212\t    };\n   213\t\n   214\t    let hourly_pressure =\n   215\t        state.animal.hourly_heat_stress_accum + state.animal.hourly_instability_stress_accum;\n   216\t\n   217\t    let stress_pressure = (gh_stress * 0.3\n   218\t        + instability_stress * 0.3\n   219\t        + condition_stress * 0.2\n   220\t        + thermal_stress * 0.2\n   221\t        + hourly_pressure * 0.3)\n   222\t        .clamp(0.0, 1.0);\n   223\t\n   224\t    // Rises quickly, decays slowly\n   225\t    if stress_pressure > state.animal.molt_stress_index {\n   226\t        state.animal.molt_stress_index += 0.2 * (stress_pressure - state.animal.molt_stress_index);\n   227\t    } else {\n   228\t        state.animal.molt_stress_index += 0.05 * (stress_pressure - state.animal.molt_stress_index);\n   229\t    }\n   230\t    state.animal.molt_stress_index = state.animal.molt_stress_index.clamp(0.0, 1.0);\n   231\t}\n   232\t\n   233\tfn update_reproductive_readiness(state: &mut TankState) {\n   234\t    let temp = state.water.temperature_c;\n   235\t    let params = &state.shrimp_params;\n   236\t\n   237\t    let f_temp = temp_repro_factor(temp, params);\n   238\t    let f_condition = state.animal.condition_index;\n   239\t    let f_stability = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n   240\t    let f_molt = (1.0 - state.animal.molt_stress_index).clamp(0.0, 1.0);\n   241\t\n   242\t    let target = (f_temp * f_condition * f_stability * f_molt).clamp(0.0, 1.0);\n   243\t\n   244\t    state.animal.reproductive_readiness_index +=\n   245\t        0.1 * (target - state.animal.reproductive_readiness_index);\n   246\t    state.animal.reproductive_readiness_index =\n   247\t        state.animal.reproductive_readiness_index.clamp(0.0, 1.0);\n   248\t}\n   249\t\n   250\tfn spawning(state: &mut TankState) {\n   251\t    if state.animal.adults_count == 0 {\n   252\t        return;\n   253\t    }\n   254\t\n   255\t    let eligible = ((0.5 * state.animal.adults_count as f64)\n   256\t        - state.animal.berried_females_count as f64)\n   257\t        .max(0.0) as u32;\n   258\t\n   259\t    if eligible == 0 {\n   260\t        return;\n","exit_code":0,"status":"completed"}}
