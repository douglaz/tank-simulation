eed_g = state.algae.suspended_biomass_g.max(0.02 * volume_l / 10.0);\n    44\t    let suspended_gross_growth_g = suspended_seed_g\n    45\t        * state.process_params.algae_max_growth_rate_per_day\n    46\t        * light_factor\n    47\t        * plant_shading\n    48\t        * temp_factor\n    49\t        * nutrient_factor;\n    50\t    let suspended_respiration_g =\n    51\t        state.algae.suspended_biomass_g * state.process_params.algae_respiration_fraction_per_day;\n    52\t    let suspended_grazing_g = state.algae.suspended_biomass_g * 0.03 * microfauna_grazing;\n    53\t    let suspended_new_g = (state.algae.suspended_biomass_g + suspended_gross_growth_g\n    54\t        - suspended_respiration_g\n    55\t        - suspended_grazing_g)\n    56\t        .max(0.0);\n    57\t    consume_algae_nutrients(\n    58\t        state,\n    59\t        suspended_gross_growth_g * ALGAE_N_MG_PER_G_GROWTH,\n    60\t        suspended_gross_growth_g * ALGAE_P_MG_PER_G_GROWTH,\n    61\t    );\n    62\t    state.algae.suspended_biomass_g = suspended_new_g;\n    63\t\n    64\t    let colonizable_area_m2 =\n    65\t        total_colonizable_area_cm2(&state.substrate_layers, state.geometry.wall_area_cm2())\n    66\t            / 10_000.0;\n    67\t    let periphyton_capacity_g =\n    68\t        colonizable_area_m2.max(0.0) * state.process_params.periphyton_capacity_g_per_m2;\n    69\t    let surface_cap_factor = if periphyton_capacity_g <= f64::EPSILON {\n    70\t        0.0\n    71\t    } else {\n    72\t        (1.0 - (state.algae.periphyton_biomass_g / periphyton_capacity_g)).clamp(0.0, 1.0)\n    73\t    };\n    74\t    let periphyton_seed_g = state.algae.periphyton_biomass_g.max(0.05);\n    75\t    let periphyton_gross_growth_g = periphyton_seed_g\n    76\t        * state.process_params.periphyton_max_growth_rate_per_day\n    77\t        * light_factor\n    78\t        * plant_shading\n    79\t        * temp_factor\n    80\t        * nutrient_factor\n    81\t        * surface_cap_factor;\n    82\t    let periphyton_respiration_g =\n    83\t        state.algae.periphyton_biomass_g * state.process_params.algae_respiration_fraction_per_day;\n    84\t    let periphyton_grazing_g = state.algae.periphyton_biomass_g * 0.06 * microfauna_grazing;\n    85\t    let periphyton_new_g = (state.algae.periphyton_biomass_g + periphyton_gross_growth_g\n    86\t        - periphyton_respiration_g\n    87\t        - periphyton_grazing_g)\n    88\t        .max(0.0)\n    89\t        .min(periphyton_capacity_g.max(0.0));\n    90\t    consume_algae_nutrients(\n    91\t        state,\n    92\t        periphyton_gross_growth_g * ALGAE_N_MG_PER_G_GROWTH,\n    93\t        periphyton_gross_growth_g * ALGAE_P_MG_PER_G_GROWTH,\n    94\t    );\n    95\t    state.algae.periphyton_biomass_g = periphyton_new_g;\n    96\t\n    97\t    let suspended_pressure = (state.algae.suspended_biomass_g / volume_l)\n    98\t        / state\n    99\t            .process_params\n   100\t            .algae_bloom_threshold_g_per_l\n   101\t            .max(f64::MIN_POSITIVE);\n   102\t    let periphyton_pressure = if periphyton_capacity_g <= f64::EPSILON {\n   103\t        0.0\n   104\t    } else {\n   105\t        state.algae.periphyton_biomass_g / periphyton_capacity_g\n   106\t    };\n   107\t    state.algae.nuisance_index =\n   108\t        (0.55 * suspended_pressure + 0.45 * periphyton_pressure).clamp(0.0, 1.0);\n   109\t\n   110\t    events::emit_daily_algae_events(state, previous_nuisance_index, periphyton_capacity_g);\n   111\t}\n   112\t\n   113\tfn algae_light_factor(state: &TankState) -> f64 {\n   114\t    if !state.hardware.light.enabled {\n   115\t        return 0.0;\n   116\t    }\n   117\t\n   118\t    let photoperiod_factor = (state.hardware.light.photoperiod_hours / 9.0).clamp(0.0, 1.0);\n   119\t    half_saturation(\n   120\t        state.hardware.light.intensity_index * photoperiod_factor,\n   121\t        state.process_params.algae_light_half_saturation,\n   122\t    )\n   123\t}\n   124\t\n   125\tfn consume_algae_nutrients(state: &mut TankState, n_demand_mg: f64, p_demand_mg: f64) {\n   126\t    let ammonia_removed = state.water.ammonia_total_mg_n_total.min(n_demand_mg * 0.6);\n   127\t    state.water.ammonia_total_mg_n_total -= ammonia_removed;\n   128\t\n   129\t    let remaining_n = (n_demand_mg - ammonia_removed).max(0.0);\n   130\t    let nitrate_removed = state.water.nitrate_mg_n_total.min(remaining_n);\n   131\t    state.water.nitrate_mg_n_total -= nitrate_removed;\n   132\t\n   133\t    let phosphate_removed = state.water.phosphate_mg_p_total.min(p_demand_mg);\n   134\t    state.water.phosphate_mg_p_total -= phosphate_removed;\n   135\t}\n   136\t\n   137\tfn half_saturation(value: f64, half_sat: f64) -> f64 {\n   138\t    let half_sat = half_sat.max(f64::MIN_POSITIVE);\n   139\t    (value / (value + half_sat)).clamp(0.0, 1.0)\n   140\t}\n   141\t\n   142\tfn gaussian_response(value: f64, optimum: f64, sigma: f64) -> f64 {\n   143\t    let sigma = sigma.max(0.1);\n   144\t    let diff = value - optimum;\n   145\t    (-(diff * diff) / (2.0 * sigma * sigma))\n   146\t        .exp()\n   147\t        .clamp(0.0, 1.0)\n   148\t}\n","exit_code":0,"status":"completed"}}
