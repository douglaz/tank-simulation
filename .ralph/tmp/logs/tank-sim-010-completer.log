{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01R1ynQWJoFQJijWJfXWP8cD","type":"tool_result","content":"     1→use serde::{Deserialize, Serialize};\n     2→\n     3→use crate::types::substrate::SubstrateLayerState;\n     4→\n     5→/// A cohort of berried females that became berried on the same day.\n     6→/// Separate cohorts ensure that only completed clutches resolve,\n     7→/// preserving the clutch-resolution invariant.\n     8→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n     9→pub struct EggCohort {\n    10→    pub count: u32,\n    11→    pub progress_days: f64,\n    12→}\n    13→\n    14→#[derive(Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq)]\n    15→pub enum PlantGuild {\n    16→    FastStem,\n    17→    RootFeedingRosette,\n    18→}\n    19→\n    20→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    21→pub struct PlantGuildState {\n    22→    pub guild: PlantGuild,\n    23→    pub biomass_g: f64,\n    24→    pub health_index: f64,\n    25→    pub crowding_index: f64,\n    26→    pub habitat_index: f64,\n    27→}\n    28→\n    29→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    30→pub struct AlgaeState {\n    31→    pub suspended_biomass_g: f64,\n    32→    pub periphyton_biomass_g: f64,\n    33→    pub nuisance_index: f64,\n    34→}\n    35→\n    36→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    37→pub struct MicrobeState {\n    38→    pub decomposer_biomass_g: f64,\n    39→    pub ammonia_oxidizer_biomass_g: f64,\n    40→    pub nitrite_oxidizer_biomass_g: f64,\n    41→    pub comammox_biomass_g: f64,\n    42→    pub maturity_index: f64,\n    43→}\n    44→\n    45→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    46→pub struct MicrofaunaState {\n    47→    pub population_index: f64,\n    48→    pub grazing_pressure_index: f64,\n    49→}\n    50→\n    51→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    52→pub struct AnimalState {\n    53→    pub adults_count: u32,\n    54→    pub juveniles_count: u32,\n    55→    pub berried_females_count: u32,\n    56→    pub condition_index: f64,\n    57→    pub molt_stress_index: f64,\n    58→    pub reproductive_readiness_index: f64,\n    59→    pub egg_progress_days: f64,\n    60→    /// Per-cohort egg tracking for clutch-resolution invariant.\n    61→    #[serde(default)]\n    62→    pub egg_cohorts: Vec<EggCohort>,\n    63→    /// Hidden hourly stress accumulators, reset after daily processing.\n    64→    #[serde(default)]\n    65→    pub hourly_nh3_stress_accum: f64,\n    66→    #[serde(default)]\n    67→    pub hourly_nitrite_stress_accum: f64,\n    68→    #[serde(default)]\n    69→    pub hourly_low_do_stress_accum: f64,\n    70→    #[serde(default)]\n    71→    pub hourly_heat_stress_accum: f64,\n    72→    #[serde(default)]\n    73→    pub hourly_instability_stress_accum: f64,\n    74→}\n    75→\n    76→/// Species-specific shrimp parameters materialized from ShrimpPreset.\n    77→/// Stored in TankState for deterministic save/load.\n    78→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    79→pub struct ShrimpRuntimeParams {\n    80→    pub optimal_temp_min_c: f64,\n    81→    pub optimal_temp_max_c: f64,\n    82→    pub gh_min_d: f64,\n    83→    pub gh_max_d: f64,\n    84→    pub base_spawn_rate: f64,\n    85→    pub egg_duration_days: u32,\n    86→    pub hatch_success_base: f64,\n    87→    pub juvenile_sensitivity: f64,\n    88→    pub high_temp_repro_penalty_start_c: f64,\n    89→    pub high_temp_repro_penalty_full_c: f64,\n    90→}\n    91→\n    92→/// Tracks recent chemistry swings for shrimp stress calculations.\n    93→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    94→pub struct StabilityTracker {\n    95→    pub prev_temp_c: f64,\n    96→    pub prev_ph: f64,\n    97→    pub prev_gh_d: f64,\n    98→    pub prev_do_mg_l: f64,\n    99→    pub instability_index: f64,\n   100→}\n   101→\n   102→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n   103→pub struct DetritusState {\n   104→    pub particulate_organics_g_total: f64,\n   105→    pub fine_detritus_g_total: f64,\n   106→    pub dissolved_feed_residue_g_total: f64,\n   107→}\n   108→\n   109→impl Default for PlantGuildState {\n   110→    fn default() -> Self {\n   111→        Self {\n   112→            guild: PlantGuild::FastStem,\n   113→            biomass_g: 5.0,\n   114→            health_index: 0.8,\n   115→            crowding_index: 0.1,\n   116→            habitat_index: 0.8,\n   117→        }\n   118→    }\n   119→}\n   120→\n   121→impl Default for AlgaeState {\n   122→    fn default() -> Self {\n   123→        Self {\n   124→            suspended_biomass_g: 0.0,\n   125→            periphyton_biomass_g: 0.2,\n   126→            nuisance_index: 0.1,\n   127→        }\n   128→    }\n   129→}\n   130→\n   131→impl Default for MicrobeState {\n   132→    fn default() -> Self {\n   133→        Self {\n   134→            decomposer_biomass_g: 0.1,\n   135→            ammonia_oxidizer_biomass_g: 0.05,\n   136→            nitrite_oxidizer_biomass_g: 0.05,\n   137→            comammox_biomass_g: 0.01,\n   138→            maturity_index: 0.1,\n   139→        }\n   140→    }\n   141→}\n   142→\n   143→impl Default for MicrofaunaState {\n   144→    fn default() -> Self {\n   145→        Self {\n   146→            population_index: 0.2,\n   147→            grazing_pressure_index: 0.2,\n   148→        }\n   149→    }\n   150→}\n   151→\n   152→impl Default for AnimalState {\n   153→    fn default() -> Self {\n   154→        Self {\n   155→            adults_count: 0,\n   156→            juveniles_count: 0,\n   157→            berried_females_count: 0,\n   158→            condition_index: 0.8,\n   159→            molt_stress_index: 0.1,\n   160→            reproductive_readiness_index: 0.4,\n   161→            egg_progress_days: 0.0,\n   162→            egg_cohorts: Vec::new(),\n   163→            hourly_nh3_stress_accum: 0.0,\n   164→            hourly_nitrite_stress_accum: 0.0,\n   165→            hourly_low_do_stress_accum: 0.0,\n   166→            hourly_heat_stress_accum: 0.0,\n   167→            hourly_instability_stress_accum: 0.0,\n   168→        }\n   169→    }\n   170→}\n   171→\n   172→impl Default for ShrimpRuntimeParams {\n   173→    fn default() -> Self {\n   174→        Self {\n   175→            optimal_temp_min_c: 22.0,\n   176→            optimal_temp_max_c: 26.0,\n   177→            gh_min_d: 5.0,\n   178→            gh_max_d: 10.0,\n   179→            base_spawn_rate: 0.15,\n   180→            egg_duration_days: 21,\n   181→            hatch_success_base: 0.7,\n   182→            juvenile_sensitivity: 1.5,\n   183→            high_temp_repro_penalty_start_c: 28.0,\n   184→            high_temp_repro_penalty_full_c: 33.0,\n   185→        }\n   186→    }\n   187→}\n   188→\n   189→impl Default for StabilityTracker {\n   190→    fn default() -> Self {\n   191→        Self {\n   192→            prev_temp_c: 25.0,\n   193→            prev_ph: 7.0,\n   194→            prev_gh_d: 7.0,\n   195→            prev_do_mg_l: 8.0,\n   196→            instability_index: 0.0,\n   197→        }\n   198→    }\n   199→}\n   200→\n   201→impl Default for DetritusState {\n   202→    fn default() -> Self {\n   203→        Self {\n   204→            particulate_organics_g_total: 0.0,\n   205→            fine_detritus_g_total: 0.0,\n   206→            dissolved_feed_residue_g_total: 0.0,\n   207→        }\n   208→    }\n   209→}\n   210→\n   211→impl PlantGuildState {\n   212→    pub fn water_column_uptake_bias(&self) -> f64 {\n   213→        match self.guild {\n   214→            PlantGuild::FastStem => 0.9,\n   215→            PlantGuild::RootFeedingRosette => 0.1,\n   216→        }\n   217→    }\n   218→\n   219→    pub fn substrate_uptake_bias(&self) -> f64 {\n   220→        match self.guild {\n   221→            PlantGuild::FastStem => 0.1,\n   222→            PlantGuild::RootFeedingRosette => 0.9,\n   223→        }\n   224→    }\n   225→}\n   226→\n   227→impl AnimalState {\n   228→    pub fn with_adults(adults_count: u32) -> Self {\n   229→        Self {\n   230→            adults_count,\n   231→            ..Self::default()\n   232→        }\n   233→    }\n   234→\n   235→    /// Ensures `berried_females_count <= adults_count` by trimming\n   236→    /// excess from the newest egg cohorts first.\n   237→    pub fn clamp_berried_to_adults(&mut self) {\n   238→        if self.berried_females_count > self.adults_count {\n   239→            let excess = self.berried_females_count - self.adults_count;\n   240→            self.berried_females_count = self.adults_count;\n   241→            trim_egg_cohorts(&mut self.egg_cohorts, excess);\n   242→        }\n   243→    }\n   244→\n   245→    /// Derives `egg_progress_days` from the most-advanced cohort for display.\n   246→    pub fn sync_egg_progress_from_cohorts(&mut self) {\n   247→        self.egg_progress_days = self\n   248→            .egg_cohorts\n   249→            .iter()\n   250→            .map(|c| c.progress_days)\n   251→            .fold(0.0_f64, f64::max);\n   252→    }\n   253→}\n   254→\n   255→/// Trims `to_remove` berried females from cohorts, starting from the newest (last).\n   256→fn trim_egg_cohorts(cohorts: &mut Vec<EggCohort>, mut to_remove: u32) {\n   257→    while to_remove > 0 && !cohorts.is_empty() {\n   258→        let last = cohorts.last_mut().unwrap();\n   259→        if last.count <= to_remove {\n   260→            to_remove -= last.count;\n   261→            cohorts.pop();\n   262→        } else {\n   263→            last.count -= to_remove;\n   264→            to_remove = 0;\n   265→        }\n   266→    }\n   267→}\n   268→\n   269→pub fn total_colonizable_area_cm2(\n   270→    substrate_layers: &[SubstrateLayerState],\n   271→    wall_area_cm2: f64,\n   272→) -> f64 {\n   273→    wall_area_cm2\n   274→        + substrate_layers\n   275→            .iter()\n   276→            .map(|layer| layer.colonizable_area_cm2)\n   277→            .sum::<f64>()\n   278→}\n   279→"}]},"parent_tool_use_id":"toolu_01MGtyrVpZy6TK854d7jDZBv","session_id":"94a28873-9e1b-4b56-baad-3f78c1e4f81f","uuid":"d326b258-8c76-48a3-bd17-206b38404a25"}
