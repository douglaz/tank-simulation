{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"sed -n '1,220p' crates/tank_core/src/types/events.rs\"","aggregated_output":"use serde::{Deserialize, Serialize};\n\n#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]\npub enum EventSeverity {\n    Info,\n    Warning,\n    Critical,\n}\n\n#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]\npub enum EventKind {\n    CycleProgressing,\n    AmmoniaWarning,\n    NitriteWarning,\n    OxygenDip,\n    AlgaeRiskRising,\n    AlgaeBloom,\n    BiofilmMaturityIncrease,\n    ShrimpBerried,\n    EggFailure,\n    MoltStressWarning,\n    FilterCleaningSetback,\n    SubstrateFoulingWarning,\n    StabilityImproving,\n}\n\n#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]\npub enum EventCause {\n    RoutineAction,\n    Overfeeding,\n    WaterChange,\n    FilterMaintenance,\n    HighAmmonia,\n    HighNitrite,\n    LowOxygen,\n    HighTemperature,\n    LowMinerals,\n    BiofilterImmature,\n    SurfaceExchangeRestricted,\n    HighNutrients,\n    PlantCrowding,\n    SurfaceSaturation,\n    SubstrateExhausted,\n}\n\n#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]\npub struct SimEvent {\n    pub day: u32,\n    pub hour: u8,\n    pub severity: EventSeverity,\n    pub kind: EventKind,\n    pub cause_codes: Vec<EventCause>,\n    pub summary: String,\n}\n\nimpl SimEvent {\n    pub fn new(\n        day: u32,\n        hour: u8,\n        severity: EventSeverity,\n        kind: EventKind,\n        cause_codes: Vec<EventCause>,\n        summary: impl Into<String>,\n    ) -> Self {\n        Self {\n            day,\n            hour,\n            severity,\n            kind,\n            cause_codes,\n            summary: summary.into(),\n        }\n    }\n}\n","exit_code":0,"status":"completed"}}
