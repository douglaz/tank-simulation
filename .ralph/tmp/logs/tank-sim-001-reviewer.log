filter_state: FilterState::default(),\n    47→            plant_guilds: vec![\n    48→                PlantGuildState::default(),\n    49→                PlantGuildState {\n    50→                    guild: PlantGuild::RootFeedingRosette,\n    51→                    biomass_g: 3.0,\n    52→                    health_index: 0.8,\n    53→                    crowding_index: 0.1,\n    54→                    habitat_index: 0.7,\n    55→                },\n    56→            ],\n    57→            algae: AlgaeState::default(),\n    58→            microbe: MicrobeState::default(),\n    59→            microfauna: MicrofaunaState::default(),\n    60→            animal: AnimalState::default(),\n    61→            detritus: DetritusState::default(),\n    62→            event_log: Vec::new(),\n    63→            rng: SimRng::new(seed),\n    64→        }\n    65→    }\n    66→\n    67→    pub fn seeded_example(seed: SimSeed) -> Self {\n    68→        let mut state = Self::new(seed);\n    69→        state.meta.scenario_id = Some(\"seeded_example\".to_string());\n    70→        state.substrate_layers = vec![\n    71→            SubstrateLayerState {\n    72→                kind: SubstrateKind::ActivePlanted,\n    73→                depth_cm: 2.0,\n    74→                nutrient_store_mg_n_total: 40.0,\n    75→                nutrient_store_mg_p_total: 10.0,\n    76→                cation_exchange_capacity_index: 0.8,\n    77→                detritus_trapping_index: 0.4,\n    78→                colonizable_area_cm2: 400.0,\n    79→                low_oxygen_tendency_index: 0.5,\n    80→                grazing_surface_index: 0.5,\n    81→            },\n    82→            SubstrateLayerState {\n    83→                kind: SubstrateKind::CoarsePorous,\n    84→                depth_cm: 1.0,\n    85→                nutrient_store_mg_n_total: 5.0,\n    86→                nutrient_store_mg_p_total: 1.0,\n    87→                cation_exchange_capacity_index: 0.2,\n    88→              