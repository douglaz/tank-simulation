 range 0.0..=100.0, got {value}\")]\n    55\t    PercentOutOfRange { field: &'static str, value: f64 },\n    56\t    #[error(\"field `{field}` must be in the range 0.0..=24.0, got {value}\")]\n    57\t    HoursOutOfRange { field: &'static str, value: f64 },\n    58\t    #[error(\"field `{field}` must be above 0.0 C, got {value}\")]\n    59\t    TemperatureTooLow { field: &'static str, value: f64 },\n    60\t    #[error(\"source profile id must not be empty\")]\n    61\t    EmptySourceProfileId,\n    62\t    #[error(\"invariant violation for `{field}` with value {value}\")]\n    63\t    InvariantViolation { field: &'static str, value: f64 },\n    64\t    #[error(\"unknown source water profile: `{id}`\")]\n    65\t    UnknownSourceProfile { id: String },\n    66\t    #[error(\"invalid source water profile `{id}`: field `{field}` has invalid value {value}\")]\n    67\t    InvalidSourceProfile {\n    68\t        id: String,\n    69\t        field: &'static str,\n    70\t        value: f64,\n    71\t    },\n    72\t    #[error(\"schema version mismatch: expected {expected}, got {actual}\")]\n    73\t    SchemaVersionMismatch { expected: u32, actual: u32 },\n    74\t    #[error(\"serialization error: {0}\")]\n    75\t    Serialization(String),\n    76\t    #[error(\"deserialization error: {0}\")]\n    77\t    Deserialization(String),\n    78\t    #[error(\"cannot remove {requested} shrimp, only {available} available\")]\n    79\t    ShrimpRemovalExceedsAvailable { requested: u32, available: u32 },\n    80\t}\n    81\t\n    82\timpl PlayerAction {\n    83\t    pub fn validate(&self) -> Result<(), SimError> {\n    84\t        match self {\n    85\t            Self::Feed { grams } => validate_non_negative(\"grams\", *grams),\n    86\t            Self::WaterChangePercent {\n    87\t                percent,\n    88\t                source_profile_id,\n    89\t            } => {\n    90\t                validate_percent(\"percent\", *percent)?;\n    91\t                if source_profile_id.trim().is_empty() {\n    92\t                    Err(SimError::EmptySourceProfileId)\n    93\t                } else {\n    94\t                    Ok(())\n    95\t                }\n    96\t            }\n    97\t            Self::TrimPlants { fraction }\n    98\t            | Self::SiphonDetritus { fraction }\n    99\t            | Self::CleanFilter {\n   100\t                intensity: fraction,\n   101\t            } => validate_fraction(field_name(self), *fraction),\n   102\t            Self::AddShrimp { .. } | Self::RemoveShrimp { .. } => Ok(()),\n   103\t            Self::ChangePhotoperiod { hours } => {\n   104\t                validate_finite(\"hours\", *hours)?;\n   105\t                if (0.0..=24.0).contains(hours) {\n   106\t                    Ok(())\n   107\t                } else {\n   108\t                    Err(SimError::HoursOutOfRange {\n   109\t                        field: \"hours\",\n   110\t                        value: *hours,\n   111\t                    })\n   112\t                }\n   113\t            }\n   114\t            Self::ChangeLightIntensity { intensity_index } => {\n   115\t                validate_fraction(\"intensity_index\", *intensity_index)\n   116\t            }\n   117\t            Self::ChangeHeaterSetpoint { setpoint_c } => {\n   118\t                validate_temperature(\"setpoint_c\", *setpoint_c)\n   119\t            }\n   120\t            Self::ChangeAmbientTemperature { target_c } => {\n   121\t                validate_temperature(\"target_c\", *target_c)\n   122\t            }\n   123\t            Self::ChangeAeration { intensity, .. } => validate_fraction(\"intensity\", *intensity),\n   124\t        }\n   125\t    }\n   126\t}\n   127\t\n   128\tfn field_name(action: &PlayerAction) -> &'static str {\n   129\t    match action {\n   130\t        PlayerAction::TrimPlants { .. } => \"fraction\",\n   131\t        PlayerAction::SiphonDetritus { .. } => \"fraction\",\n   132\t        PlayerAction::CleanFilter { .. } => \"intensity\",\n   133\t        _ => \"value\",\n   134\t    }\n   135\t}\n   136\t\n   137\tfn validate_non_negative(field: &'static str, value: f64) -> Result<(), SimError> {\n   138\t    validate_finite(field, value)?;\n   139\t    if value < 0.0 {\n   140\t        Err(SimError::NegativeValue { field, value })\n   141\t    } else {\n   142\t        Ok(())\n   143\t    }\n   144\t}\n   145\t\n   146\tfn validate_fraction(field: &'static str, value: f64) -> Result<(), SimError> {\n   147\t    validate_finite(field, value)?;\n   148\t    if (0.0..=1.0).contains(&value) {\n   149\t        Ok(())\n   150\t    } else {\n   151\t        Err(SimError::FractionOutOfRange { field, value })\n   152\t    }\n   153\t}\n   154\t\n   155\tfn validate_percent(field: &'static str, value: f64) -> Result<(), SimError> {\n   156\t    validate_finite(field, value)?;\n   157\t    if (0.0..=100.0).contains(&value) {\n   158\t        Ok(())\n   159\t    } else {\n   160\t        Err(SimError::PercentOutOfRange { field, value })\n   161\t    }\n   162\t}\n   163\t\n   164\tfn validate_temperature(field: &'static str, value: f64) -> Result<(), SimError> {\n   165\t    validate_finite(field, value)?;\n   166\t    if value > 0.0 {\n   167\t        Ok(())\n   168\t    } else {\n   169\t        Err(SimError::TemperatureTooLow { field, value })\n   170\t    }\n   171\t}\n   172\t\n   173\tfn validate_finite(field: &'static str, value: f64) -> Result<(), SimError> {\n   174\t    if value.is_finite() {\n   175\t        Ok(())\n   176\t    } else {\n   177\t        Err(SimError::NonFiniteValue { field, value })\n   178\t    }\n   179\t}\n","exit_code":0,"status":"completed"}}
