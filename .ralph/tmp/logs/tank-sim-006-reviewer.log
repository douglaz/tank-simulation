r_hour: 0.004,\n   161\t\n   162\t            o2_per_mg_n_nitrified: 4.57,\n   163\t            alkalinity_meq_per_mg_n_nitrified: 0.1428,\n   164\t\n   165\t            plant_max_growth_rate_fast_stem_per_day: 0.08,\n   166\t            plant_max_growth_rate_root_rosette_per_day: 0.06,\n   167\t            plant_respiration_fraction_per_day: 0.01,\n   168\t            plant_senescence_fraction_per_day: 0.005,\n   169\t            plant_health_recovery_per_day: 0.03,\n   170\t            plant_health_decline_per_day: 0.08,\n   171\t            plant_half_saturation_n_mg_total: 8.0,\n   172\t            plant_half_saturation_p_mg_total: 1.2,\n   173\t            plant_half_saturation_c_mg_total: 20.0,\n   174\t            plant_light_half_saturation: 0.45,\n   175\t            plant_temp_optimum_c: 25.0,\n   176\t            plant_temp_sigma_c: 7.0,\n   177\t            plant_crowding_biomass_g_per_m2: 250.0,\n   178\t\n   179\t            algae_max_growth_rate_per_day: 0.2,\n   180\t            periphyton_max_growth_rate_per_day: 0.15,\n   181\t            algae_respiration_fraction_per_day: 0.03,\n   182\t            algae_half_saturation_n_mg_total: 5.0,\n   183\t            algae_half_saturation_p_mg_total: 0.8,\n   184\t            algae_light_half_saturation: 0.35,\n   185\t            algae_temp_optimum_c: 27.0,\n   186\t            algae_temp_sigma_c: 8.0,\n   187\t            periphyton_capacity_g_per_m2: 6.0,\n   188\t            algae_bloom_threshold_g_per_l: 0.08,\n   189\t            algae_nuisance_biomass_g_per_m2: 10.0,\n   190\t\n   191\t            shrimp_base_mortality_per_day: 0.002,\n   192\t            shrimp_stress_mortality_scale: 0.15,\n   193\t            shrimp_juvenile_maturation_days: 30.0,\n   194\t            shrimp_periphyton_grazing_g_per_shrimp_per_day: 0.01,\n   195\t            shrimp_condition_smoothing: 0.15,\n   196\t\n   197\t            microfauna_mineralization_boost: 0.15,\n   198\t            microfauna_periphyton_consumptio