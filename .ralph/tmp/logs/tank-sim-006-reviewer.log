{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/src/systems/shrimp.rs | sed -n '1,520p'\"","aggregated_output":"     1\tuse crate::systems::chemistry::compute_nh3_mg_l;\n     2\tuse crate::types::{\n     3\t    EggCohort, EventCause, EventKind, EventSeverity, ShrimpRuntimeParams, TankState,\n     4\t};\n     5\t\n     6\t// ── Hourly ──────────────────────────────────────────────────────────────────\n     7\t\n     8\t/// Accumulates NH3, nitrite, low-DO, heat, and instability stress each hour.\n     9\t/// Runs after chemistry/DO updates, before hourly event emission.\n    10\tpub fn step_hourly_shrimp_stress(state: &mut TankState) {\n    11\t    let total = state.animal.adults_count + state.animal.juveniles_count;\n    12\t    if total == 0 {\n    13\t        return;\n    14\t    }\n    15\t\n    16\t    let volume_l = state.geometry.water_volume_l();\n    17\t    if volume_l <= f64::EPSILON {\n    18\t        return;\n    19\t    }\n    20\t\n    21\t    let tan_mg_l = state.water.ammonia_total_mg_n_total / volume_l;\n    22\t    let nh3_mg_l = compute_nh3_mg_l(tan_mg_l, state.water.ph, state.water.temperature_c);\n    23\t    let nitrite_mg_l = state.water.nitrite_mg_n_total / volume_l;\n    24\t    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n    25\t    let temp = state.water.temperature_c;\n    26\t\n    27\t    // NH3 stress (threshold 0.02 mg/L, stronger than TAN alone)\n    28\t    if nh3_mg_l > 0.02 {\n    29\t        state.animal.hourly_nh3_stress_accum += (nh3_mg_l - 0.02) * 2.0 / 24.0;\n    30\t    }\n    31\t\n    32\t    // Nitrite stress (threshold 0.5 mg/L)\n    33\t    if nitrite_mg_l > 0.5 {\n    34\t        state.animal.hourly_nitrite_stress_accum += (nitrite_mg_l - 0.5) * 0.5 / 24.0;\n    35\t    }\n    36\t\n    37\t    // Low DO stress (threshold 5.0 mg/L)\n    38\t    if do_mg_l < 5.0 {\n    39\t        state.animal.hourly_low_do_stress_accum += (5.0 - do_mg_l) * 0.3 / 24.0;\n    40\t    }\n    41\t\n    42\t    // Heat stress (above species optimal max)\n    43\t    let opt_max = state.shrimp_params.optimal_temp_max_c;\n    44\t    if temp > opt_max {\n    45\t        state.animal.hourly_heat_stress_accum += (temp - opt_max) * 0.1 / 24.0;\n    46\t    }\n    47\t\n    48\t    // Instability stress from stability tracker\n    49\t    state.animal.hourly_instability_stress_accum +=\n    50\t        state.stability_tracker.instability_index * 0.05 / 24.0;\n    51\t}\n    52\t\n    53\t// ── Daily ───────────────────────────────────────────────────────────────────\n    54\t\n    55\t/// Full daily shrimp lifecycle: feeding → condition → molt stress →\n    56\t/// reproductive readiness → spawning → egg development/hatching →\n    57\t/// juvenile recruitment → mortality → events.\n    58\tpub fn step_daily_shrimp(state: &mut TankState) {\n    59\t    let total = state.animal.adults_count + state.animal.juveniles_count;\n    60\t    if total == 0 && state.animal.berried_females_count == 0 {\n    61\t        reset_hourly_accumulators(state);\n    62\t        return;\n    63\t    }\n    64\t\n    65\t    let volume_l = state.geometry.water_volume_l();\n    66\t    if volume_l <= f64::EPSILON {\n    67\t        reset_hourly_accumulators(state);\n    68\t        return;\n    69\t    }\n    70\t\n    71\t    shrimp_feeding(state, volume_l);\n    72\t    update_condition(state, volume_l);\n    73\t    update_molt_stress(state, volume_l);\n    74\t    update_reproductive_readiness(state);\n    75\t    spawning(state);\n    76\t    egg_development(state);\n    77\t    juvenile_recruitment(state);\n    78\t    mortality(state);\n    79\t    emit_molt_stress_warning(state, volume_l);\n    80\t\n    81\t    reset_hourly_accumulators(state);\n    82\t}\n    83\t\n    84\t/// Updates the stability tracker at the end of each daily cycle.\n    85\tpub fn update_stability_tracker(state: &mut TankState) {\n    86\t    let volume_l = state.geometry.water_volume_l().max(f64::EPSILON);\n    87\t    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n    88\t    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n    89\t    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n    90\t    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n    91\t\n    92\t    let tracker = &mut state.stability_tracker;\n    93\t\n    94\t    let temp_swing = (state.water.temperature_c - tracker.prev_temp_c).abs();\n    95\t    let ph_swing = (state.water.ph - tracker.prev_ph).abs();\n    96\t    let gh_swing = (gh_d - tracker.prev_gh_d).abs();\n    97\t    let do_swing = (do_mg_l - tracker.prev_do_mg_l).abs();\n    98\t\n    99\t    // Weighted instability normalised to 0..1\n   100\t    let raw_instability =\n   101\t        (temp_swing / 3.0 + ph_swing / 0.5 + gh_swing / 3.0 + do_swing / 3.0).clamp(0.0, 1.0);\n   102\t\n   103\t    // Rises quickly, decays slowly\n   104\t    if raw_instability > tracker.instability_index {\n   105\t        tracker.instability_index += 0.3 * (raw_instability - tracker.instability_index);\n   106\t    } else {\n   107\t        tracker.instability_index += 0.1 * (raw_instability - tracker.instability_index);\n   108\t    }\n   109\t    tracker.instability_index = tracker.instability_index.clamp(0.0, 1.0);\n   110\t\n   111\t    tracker.prev_temp_c = state.water.temperature_c;\n   112\t    tracker.prev_ph = state.water.ph;\n   113\t    tracker.prev_gh_d = gh_d;\n   114\t    tracker.prev_do_mg_l = do_mg_l;\n   115\t}\n   116\t\n   117\t// ── Private helpers ─────────────────────────────────────────────────────────\n   118\t\n   119\tfn shrimp_feeding(state: &mut TankState, _volume_l: f64) {\n   120\t    let adults = state.animal.adults_count as f64;\n   121\t    let juveniles = state.animal.juveniles_count as f64;\n   122\t    let total_feeding_units = adults + juveniles * 0.3;\n   123\t    let rate = state.process_params.shrimp_periphyton_grazing_g_per_shrimp_per_day;\n   124\t    let food_demand = total_feeding_units * rate;\n   125\t\n   126\t    // Shrimp graze periphyton (at most 50% of available per day)\n   127\t    let max_periph = state.algae.periphyton_biomass_g * 0.5;\n   128\t    let periph_consumed = food_demand.min(max_periph).max(0.0);\n   129\t    state.algae.periphyton_biomass_g =\n   130\t        (state.algae.periphyton_biomass_g - periph_consumed).max(0.0);\n   131\t\n   132\t    // Shrimp also eat fine detritus (biofilm, decomposing organic matter)\n   133\t    let detritus_demand = total_feeding_units * rate;\n   134\t    let max_detritus = state.detritus.fine_detritus_g_total * 0.2;\n   135\t    let detritus_consumed = detritus_demand.min(max_detritus).max(0.0);\n   136\t    state.detritus.fine_detritus_g_total =\n   137\t        (state.detritus.fine_detritus_g_total - detritus_consumed).max(0.0);\n   138\t}\n   139\t\n   140\tfn update_condition(state: &mut TankState, volume_l: f64) {\n   141\t    let tan_mg_l = state.water.ammonia_total_mg_n_total / volume_l;\n   142\t    let nh3_mg_l = compute_nh3_mg_l(tan_mg_l, state.water.ph, state.water.temperature_c);\n   143\t    let nitrite_mg_l = state.water.nitrite_mg_n_total / volume_l;\n   144\t    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n   145\t    let temp = state.water.temperature_c;\n   146\t\n   147\t    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n   148\t    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n   149\t    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n   150\t\n   151\t    let total_shrimp = state.animal.adults_count as f64 + state.animal.juveniles_count as f64;\n   152\t    let available_food = state.algae.periphyton_biomass_g\n   153\t        + state.detritus.fine_detritus_g_total * 0.3;\n   154\t    let food_per_shrimp = if total_shrimp > 0.0 {\n   155\t        available_food / total_shrimp\n   156\t    } else {\n   157\t        1.0\n   158\t    };\n   159\t\n   160\t    let food_factor = (food_per_shrimp / 0.05).clamp(0.0, 1.0);\n   161\t    let do_factor = (do_mg_l / 6.0).clamp(0.0, 1.0);\n   162\t    // NH3 risk: condition degrades steadily, reaching zero at ~0.33 mg/L NH3\n   163\t    let nh3_factor = (1.0 - nh3_mg_l * 3.0).clamp(0.0, 1.0);\n   164\t    let nitrite_factor = (1.0 - nitrite_mg_l * 0.5).clamp(0.0, 1.0);\n   165\t\n   166\t    let params = &state.shrimp_params;\n   167\t    let temp_factor = temp_condition_factor(temp, params);\n   168\t    let gh_factor = gh_mineral_factor(gh_d, params);\n   169\t    let instability_factor = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n   170\t\n   171\t    let stress_penalty = state.animal.hourly_nh3_stress_accum\n   172\t        + state.animal.hourly_nitrite_stress_accum\n   173\t        + state.animal.hourly_low_do_stress_accum\n   174\t        + state.animal.hourly_heat_stress_accum\n   175\t        + state.animal.hourly_instability_stress_accum;\n   176\t\n   177\t    let target = (food_factor\n   178\t        * do_factor\n   179\t        * nh3_factor\n   180\t        * nitrite_factor\n   181\t        * temp_factor\n   182\t        * gh_factor\n   183\t        * instability_factor\n   184\t        - stress_penalty * 0.5)\n   185\t        .clamp(0.0, 1.0);\n   186\t\n   187\t    let smoothing = state.process_params.shrimp_condition_smoothing;\n   188\t    state.animal.condition_index += smoothing * (target - state.animal.condition_index);\n   189\t    state.animal.condition_index = state.animal.condition_index.clamp(0.0, 1.0);\n   190\t}\n   191\t\n   192\tfn update_molt_stress(state: &mut TankState, volume_l: f64) {\n   193\t    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n   194\t    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n   195\t    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n   196\t    let params = &state.shrimp_params;\n   197\t\n   198\t    let gh_stress = if gh_d < params.gh_min_d {\n   199\t        (params.gh_min_d - gh_d) / params.gh_min_d\n   200\t    } else {\n   201\t        0.0\n   202\t    };\n   203\t\n   204\t    let instability_stress = state.stability_tracker.instability_index;\n   205\t    let condition_stress = (0.5 - state.animal.condition_index).max(0.0);\n   206\t    let thermal_stress = if state.water.temperature_c > params.optimal_temp_max_c {\n   207\t        ((state.water.temperature_c - params.optimal_temp_max_c) / 8.0).clamp(0.0, 0.5)\n   208\t    } else {\n   209\t        0.0\n   210\t    };\n   211\t\n   212\t    let hourly_pressure =\n   213\t        state.animal.hourly_heat_stress_accum + state.animal.hourly_instability_stress_accum;\n   214\t\n   215\t    let stress_pressure = (gh_stress * 0.3\n   216\t        + instability_stress * 0.3\n   217\t        + condition_stress * 0.2\n   218\t        + thermal_stress * 0.2\n   219\t        + hourly_pressure * 0.3)\n   220\t        .clamp(0.0, 1.0);\n   221\t\n   222\t    // Rises quickly, decays slowly\n   223\t    if stress_pressure > state.animal.molt_stress_index {\n   224\t        state.animal.molt_stress_index +=\n   225\t            0.2 * (stress_pressure - state.animal.molt_stress_index);\n   226\t    } else {\n   227\t        state.animal.molt_stress_index +=\n   228\t            0.05 * (stress_pressure - state.animal.molt_stress_index);\n   229\t    }\n   230\t    state.animal.molt_stress_index = state.animal.molt_stress_index.clamp(0.0, 1.0);\n   231\t}\n   232\t\n   233\tfn update_reproductive_readiness(state: &mut TankState) {\n   234\t    let temp = state.water.temperature_c;\n   235\t    let params = &state.shrimp_params;\n   236\t\n   237\t    let f_temp = temp_repro_factor(temp, params);\n   238\t    let f_condition = state.animal.condition_index;\n   239\t    let f_stability = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n   240\t    let f_molt = (1.0 - state.animal.molt_stress_index).clamp(0.0, 1.0);\n   241\t\n   242\t    let target = (f_temp * f_condition * f_stability * f_molt).clamp(0.0, 1.0);\n   243\t\n   244\t    state.animal.reproductive_readiness_index +=\n   245\t        0.1 * (target - state.animal.reproductive_readiness_index);\n   246\t    state.animal.reproductive_readiness_index =\n   247\t        state.animal.reproductive_readiness_index.clamp(0.0, 1.0);\n   248\t}\n   249\t\n   250\tfn spawning(state: &mut TankState) {\n   251\t    if state.animal.adults_count == 0 {\n   252\t        return;\n   253\t    }\n   254\t\n   255\t    let eligible = ((0.5 * state.animal.adults_count as f64)\n   256\t        - state.animal.berried_females_count as f64)\n   257\t        .max(0.0) as u32;\n   258\t\n   259\t    if eligible == 0 {\n   260\t        return;\n   261\t    }\n   262\t\n   263\t    let temp = state.water.temperature_c;\n   264\t    let params = &state.shrimp_params;\n   265\t\n   266\t    let f_temp = temp_repro_factor(temp, params);\n   267\t    let f_condition = state.animal.condition_index;\n   268\t    let f_stability = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n   269\t\n   270\t    let volume_l = state.geometry.water_volume_l().max(f64::EPSILON);\n   271\t    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n   272\t    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n   273\t    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n   274\t    let f_mineral = gh_mineral_factor(gh_d, params);\n   275\t\n   276\t    let p_spawn = params.base_spawn_rate * f_temp * f_condition * f_stability * f_mineral;\n   277\t\n   278\t    let mut new_berried = 0u32;\n   279\t    for _ in 0..eligible {\n   280\t        if state.rng.next_f64() < p_spawn {\n   281\t            new_berried += 1;\n   282\t        }\n   283\t    }\n   284\t\n   285\t    if new_berried > 0 {\n   286\t        state.animal.berried_females_count += new_berried;\n   287\t        // Create a new cohort for this batch of berried females\n   288\t        state.animal.egg_cohorts.push(EggCohort {\n   289\t            count: new_berried,\n   290\t            progress_days: 0.0,\n   291\t        });\n   292\t\n   293\t        crate::systems::events::emit_once_per_day_pub(\n   294\t            state,\n   295\t            EventSeverity::Info,\n   296\t            EventKind::ShrimpBerried,\n   297\t            vec![EventCause::RoutineAction],\n   298\t            format!(\"{new_berried} female(s) became berried\"),\n   299\t        );\n   300\t    }\n   301\t}\n   302\t\n   303\tfn egg_development(state: &mut TankState) {\n   304\t    if state.animal.egg_cohorts.is_empty() {\n   305\t        // Legacy path: if berried females exist without cohorts (e.g. from old save),\n   306\t        // migrate them into a single cohort using the current egg_progress_days.\n   307\t        if state.animal.berried_females_count > 0 {\n   308\t            state.animal.egg_cohorts.push(EggCohort {\n   309\t                count: state.animal.berried_females_count,\n   310\t                progress_days: state.animal.egg_progress_days,\n   311\t            });\n   312\t        } else {\n   313\t            return;\n   314\t        }\n   315\t    }\n   316\t\n   317\t    let volume_l = state.geometry.water_volume_l().max(f64::EPSILON);\n   318\t    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n   319\t    let temp = state.water.temperature_c;\n   320\t    let params = &state.shrimp_params;\n   321\t\n   322\t    let f_condition = state.animal.condition_index;\n   323\t    let f_oxygen = (do_mg_l / 6.0).clamp(0.0, 1.0);\n   324\t    let f_temp = temp_repro_factor(temp, params);\n   325\t    let f_stability = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n   326\t\n   327\t    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n   328\t    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n   329\t    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n   330\t    let f_mineral = gh_mineral_factor(gh_d, params);\n   331\t\n   332\t    let p_hatch =\n   333\t        params.hatch_success_base * f_condition * f_oxygen * f_temp * f_stability * f_mineral;\n   334\t\n   335\t    let egg_duration = params.egg_duration_days as f64;\n   336\t    let mut total_successful = 0u32;\n   337\t    let mut total_failed = 0u32;\n   338\t    let mut resolved_berried = 0u32;\n   339\t\n   340\t    // Advance each cohort; resolve only those that have reached duration\n   341\t    let mut i = 0;\n   342\t    while i < state.animal.egg_cohorts.len() {\n   343\t        state.animal.egg_cohorts[i].progress_days += 1.0;\n   344\t\n   345\t        if state.animal.egg_cohorts[i].progress_days >= egg_duration {\n   346\t            let cohort = state.animal.egg_cohorts.remove(i);\n   347\t            resolved_berried += cohort.count;\n   348\t\n   349\t            for _ in 0..cohort.count {\n   350\t                if state.rng.next_f64() < p_hatch {\n   351\t                    total_successful += 1;\n   352\t                } else {\n   353\t                    total_failed += 1;\n   354\t                }\n   355\t            }\n   356\t            // Don't increment i; the next cohort shifted into position\n   357\t        } else {\n   358\t            i += 1;\n   359\t        }\n   360\t    }\n   361\t\n   362\t    // Successful hatches produce juveniles (~25 per clutch for Neocaridina)\n   363\t    let juveniles_per_clutch = 25u32;\n   364\t    if total_successful > 0 {\n   365\t        state.animal.juveniles_count += total_successful * juveniles_per_clutch;\n   366\t    }\n   367\t\n   368\t    // Only resolved clutches leave berried_females_count\n   369\t    state.animal.berried_females_count =\n   370\t        state.animal.berried_females_count.saturating_sub(resolved_berried);\n   371\t\n   372\t    if total_failed > 0 {\n   373\t        // Failure-mode invariant: on hatch failure, juveniles_count does NOT increase\n   374\t        let mut causes = Vec::new();\n   375\t        if f_oxygen < 0.6 {\n   376\t            causes.push(EventCause::LowOxygen);\n   377\t        }\n   378\t        if f_temp < 0.5 {\n   379\t            causes.push(EventCause::HighTemperature);\n   380\t        }\n   381\t        if f_mineral < 0.6 {\n   382\t            causes.push(EventCause::LowMinerals);\n   383\t        }\n   384\t        if f_stability < 0.6 {\n   385\t            causes.push(EventCause::ChemistryInstability);\n   386\t        }\n   387\t        if causes.is_empty() {\n   388\t            causes.push(EventCause::PoorCondition);\n   389\t        }\n   390\t\n   391\t        crate::systems::events::emit_once_per_day_pub(\n   392\t            state,\n   393\t            EventSeverity::Warning,\n   394\t            EventKind::EggFailure,\n   395\t            causes,\n   396\t            format!(\"{total_failed} clutch(es) failed to hatch\"),\n   397\t        );\n   398\t    }\n   399\t\n   400\t    // Update egg_progress_days from remaining cohorts for display/snapshot\n   401\t    state.animal.sync_egg_progress_from_cohorts();\n   402\t}\n   403\t\n   404\tfn juvenile_recruitment(state: &mut TankState) {\n   405\t    if state.animal.juveniles_count == 0 {\n   406\t        return;\n   407\t    }\n   408\t\n   409\t    let maturation_rate =\n   410\t        1.0 / state.process_params.shrimp_juvenile_maturation_days.max(1.0);\n   411\t    let maturing = (state.animal.juveniles_count as f64 * maturation_rate).floor() as u32;\n   412\t    let maturing = maturing.min(state.animal.juveniles_count);\n   413\t\n   414\t    state.animal.juveniles_count -= maturing;\n   415\t    state.animal.adults_count += maturing;\n   416\t}\n   417\t\n   418\tfn mortality(state: &mut TankState) {\n   419\t    let base_rate = state.process_params.shrimp_base_mortality_per_day;\n   420\t    let stress_scale = state.process_params.shrimp_stress_mortality_scale;\n   421\t\n   422\t    let stress_total = state.animal.hourly_nh3_stress_accum\n   423\t        + state.animal.hourly_nitrite_stress_accum\n   424\t        + state.animal.hourly_low_do_stress_accum\n   425\t        + state.animal.hourly_heat_stress_accum\n   426\t        + (state.animal.molt_stress_index - 0.5).max(0.0)\n   427\t        + (0.5 - state.animal.condition_index).max(0.0);\n   428\t\n   429\t    let p_adult_death = (base_rate + stress_total * stress_scale).clamp(0.0, 0.5);\n   430\t\n   431\t    let juv_sensitivity = state.shrimp_params.juvenile_sensitivity;\n   432\t    let p_juv_death = (base_rate + stress_total * stress_scale * juv_sensitivity).clamp(0.0, 0.5);\n   433\t\n   434\t    let mut adult_deaths = 0u32;\n   435\t    for _ in 0..state.animal.adults_count {\n   436\t        if state.rng.next_f64() < p_adult_death {\n   437\t            adult_deaths += 1;\n   438\t        }\n   439\t    }\n   440\t\n   441\t    let mut juv_deaths = 0u32;\n   442\t    for _ in 0..state.animal.juveniles_count {\n   443\t        if state.rng.next_f64() < p_juv_death {\n   444\t            juv_deaths += 1;\n   445\t        }\n   446\t    }\n   447\t\n   448\t    state.animal.adults_count = state.animal.adults_count.saturating_sub(adult_deaths);\n   449\t    state.animal.juveniles_count = state.animal.juveniles_count.saturating_sub(juv_deaths);\n   450\t\n   451\t    // Preserve berried_females <= adults invariant (also trims egg cohorts)\n   452\t    state.animal.clamp_berried_to_adults();\n   453\t}\n   454\t\n   455\tfn emit_molt_stress_warning(state: &mut TankState, volume_l: f64) {\n   456\t    if state.animal.molt_stress_index <= 0.6 {\n   457\t        return;\n   458\t    }\n   459\t\n   460\t    let mut causes = Vec::new();\n   461\t    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n   462\t    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n   463\t    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n   464\t\n   465\t    if gh_d < state.shrimp_params.gh_min_d {\n   466\t        causes.push(EventCause::LowMinerals);\n   467\t    }\n   468\t    if state.stability_tracker.instability_index > 0.3 {\n   469\t        causes.push(EventCause::ChemistryInstability);\n   470\t    }\n   471\t    if state.water.temperature_c > state.shrimp_params.optimal_temp_max_c {\n   472\t        causes.push(EventCause::HighTemperature);\n   473\t    }\n   474\t    if causes.is_empty() {\n   475\t        causes.push(EventCause::PoorCondition);\n   476\t    }\n   477\t\n   478\t    crate::systems::events::emit_once_per_day_pub(\n   479\t        state,\n   480\t        EventSeverity::Warning,\n   481\t        EventKind::MoltStressWarning,\n   482\t        causes,\n   483\t        format!(\n   484\t            \"Molt stress elevated: {:.2}\",\n   485\t            state.animal.molt_stress_index\n   486\t        ),\n   487\t    );\n   488\t}\n   489\t\n   490\tfn reset_hourly_accumulators(state: &mut TankState) {\n   491\t    state.animal.hourly_nh3_stress_accum = 0.0;\n   492\t    state.animal.hourly_nitrite_stress_accum = 0.0;\n   493\t    state.animal.hourly_low_do_stress_accum = 0.0;\n   494\t    state.animal.hourly_heat_stress_accum = 0.0;\n   495\t    state.animal.hourly_instability_stress_accum = 0.0;\n   496\t}\n   497\t\n   498\t// ── Factor functions ────────────────────────────────────────────────────────\n   499\t\n   500\t/// Temperature factor for reproduction.\n   501\t/// Best 22–26 °C, clearly worse by 30 °C, near-zero by 33 °C.\n   502\tfn temp_repro_factor(temp: f64, params: &ShrimpRuntimeParams) -> f64 {\n   503\t    let opt_min = params.optimal_temp_min_c;\n   504\t    let opt_max = params.optimal_temp_max_c;\n   505\t    let penalty_start = params.high_temp_repro_penalty_start_c;\n   506\t    let penalty_full = params.high_temp_repro_penalty_full_c;\n   507\t\n   508\t    if temp < opt_min - 4.0 {\n   509\t        0.1\n   510\t    } else if temp < opt_min {\n   511\t        0.1 + 0.9 * (temp - (opt_min - 4.0)) / 4.0\n   512\t    } else if temp <= opt_max {\n   513\t        1.0\n   514\t    } else if temp <= penalty_start {\n   515\t        let range = (penalty_start - opt_max).max(0.01);\n   516\t        1.0 - 0.5 * (temp - opt_max) / range\n   517\t    } else if temp <= penalty_full {\n   518\t        let range = (penalty_full - penalty_start).max(0.01);\n   519\t        0.5 - 0.45 * (temp - penalty_start) / range\n   520\t    } else {\n","exit_code":0,"status":"completed"}}
