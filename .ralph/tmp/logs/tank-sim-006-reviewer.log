condition_smoothing;\n   188\t    state.animal.condition_index += smoothing * (target - state.animal.condition_index);\n   189\t    state.animal.condition_index = state.animal.condition_index.clamp(0.0, 1.0);\n   190\t}\n   191\t\n   192\tfn update_molt_stress(state: &mut TankState, volume_l: f64) {\n   193\t    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n   194\t    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n   195\t    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n   196\t    let params = &state.shrimp_params;\n   197\t\n   198\t    let gh_stress = if gh_d < params.gh_min_d {\n   199\t        (params.gh_min_d - gh_d) / params.gh_min_d\n   200\t    } else {\n   201\t        0.0\n   202\t    };\n   203\t\n   204\t    let instability_stress = state.stability_tracker.instability_index;\n   205\t    let condition_stress = (0.5 - state.animal.condition_index).max(0.0);\n   206\t    let thermal_stress = if state.water.temperature_c > params.optimal_temp_max_c {\n   207\t        ((state.water.temperature_c - params.optimal_temp_max_c) / 8.0).clamp(0.0, 0.5)\n   208\t    } else {\n   209\t        0.0\n   210\t    };\n   211\t\n   212\t    let hourly_pressure =\n   213\t        state.animal.hourly_heat_stress_accum + state.animal.hourly_instability_stress_accum;\n   214\t\n   215\t    let stress_pressure = (gh_stress * 0.3\n   216\t        + instability_stress * 0.3\n   217\t        + condition_stress * 0.2\n   218\t        + thermal_stress * 0.2\n   219\t        + hourly_pressure * 0.3)\n   220\t        .clamp(0.0, 1.0);\n   221\t\n   222\t    // Rises quickly, decays slowly\n   223\t    if stress_pressure > state.animal.molt_stress_index {\n   224\t        state.animal.molt_stress_index +=\n   225\t            0.2 * (stress_pressure - state.animal.molt_stress_index);\n   226\t    } else {\n   227\t        state.animal.molt_stress_index +=\n   228\t            0.05 * (stress_pressure - state.animal.molt_stress_index);\n   229\t    }\n   230\t    state.animal.molt_stress_index = state.animal.molt_stress_index.clamp(0.0, 1.0);\n   231\t}\n   232\t\n   233\tfn update_reproductive_readiness(state: &mut TankState) {\n   234\t    let temp = state.water.temperature_c;\n   235\t    let params = &state.shrimp_params;\n   236\t\n   237\t    let f_temp = temp_repro_factor(temp, params);\n   238\t    let f_condition = state.animal.condition_index;\n   239\t    let f_stability = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n   240\t    let f_molt = (1.0 - state.animal.molt_stress_index).clamp(0.0, 1.0);\n   241\t\n   242\t    let target = (f_temp * f_condition * f_stability * f_molt).clamp(0.0, 1.0);\n   243\t\n   244\t    state.animal.reproductive_readiness_index +=\n   245\t        0.1 * (target - state.animal.reproductive_readiness_index);\n   246\t    state.animal.reproductive_readiness_index =\n   247\t        state.animal.reproductive_readiness_index.clamp(0.0, 1.0);\n   248\t}\n   249\t\n   250\tfn spawning(state: &mut TankState) {\n   251\t    if state.animal.adults_count == 0 {\n   252\t        return;\n   253\t    }\n   254\t\n   255\t    let eligible = ((0.5 * state.animal.adults_count as f64)\n   256\t        - state.animal.berried_females_count as f64)\n   257\t        .max(0.0) as u32;\n   258\t\n   259\t    if eligible == 0 {\n   260\t        return;\n   261\t    }\n   262\t\n   263\t    let temp = state.water.temperature_c;\n   264\t    let params = &state.shrimp_params;\n   265\t\n   266\t    let f_temp = temp_repro_factor(temp, params);\n   267\t    let f_condition = state.animal.condition_index;\n   268\t    let f_stability = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n   269\t\n   270\t    let volume_l = state.geometry.water_volume_l().max(f64::EPSILON);\n   271\t    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n   272\t    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n   273\t    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n   274\t    let f_mineral = gh_mineral_factor(gh_d, params);\n   275\t\n   276\t    let p_spawn = params.base_spawn_rate * f_temp * f_condition * f_stability * f_mineral;\n   277\t\n   278\t    let mut new_berried = 0u32;\n   279\t    for _ in 0..eligible {\n   280\t        if state.rng.next_f64() < p_spawn {\n   281\t            new_berried += 1;\n   282\t        }\n   283\t    }\n   284\t\n   285\t    if new_berried > 0 {\n   286\t        state.animal.berried_females_count += new_berried;\n   287\t\n   288\t        crate::systems::events::emit_once_per_day_pub(\n   289\t            state,\n   290\t            EventSeverity::Info,\n   291\t            EventKind::ShrimpBerried,\n   292\t            vec![EventCause::RoutineAction],\n   293\t            format!(\"{new_berried} female(s) became berried\"),\n   294\t        );\n   295\t    }\n   296\t}\n   297\t\n   298\tfn egg_development(state: &mut TankState) {\n   299\t    if state.animal.berried_females_count == 0 {\n   300\t        return;\n   301\t    }\n   302\t\n   303\t    state.animal.egg_progress_days += 1.0;\n   304\t\n   305\t    if state.animal.egg_progress_days < state.shrimp_params.egg_duration_days as f64 {\n   306\t        return;\n   307\t    }\n   308\t\n   309\t    // Resolve clutch\n   310\t    let berried = state.animal.berried_females_count;\n   311\t    let volume_l = state.geometry.water_volume_l().max(f64::EPSILON);\n   312\t    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n   313\t    let temp = state.water.temperature_c;\n   314\t    let params = &state.shrimp_params;\n   315\t\n   316\t    let f_condition = state.animal.condition_index;\n   317\t    let f_oxygen = (do_mg_l / 6.0).clamp(0.0, 1.0);\n   318\t    let f_temp = temp_repro_factor(temp, params);\n   319\t    let f_stability = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n   320\t\n   321\t    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n   322\t    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n   323\t    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n   324\t    let f_mineral = gh_mineral_factor(gh_d, params);\n   325\t\n   326\t    let p_hatch =\n   327\t        params.hatch_success_base * f_condition * f_oxygen * f_temp * f_stability * f_mineral;\n   328\t\n   329\t    let mut successful = 0u32;\n   330\t    let mut failed = 0u32;\n   331\t    for _ in 0..berried {\n   332\t        if state.rng.next_f64() < p_hatch {\n   333\t            successful += 1;\n   334\t        } else {\n   335\t            failed += 1;\n   336\t        }\n   337\t    }\n   338\t\n   339\t    // Successful hatches produce juveniles (~25 per clutch for Neocaridina)\n   340\t    let juveniles_per_clutch = 25u32;\n   341\t    if successful > 0 {\n   342\t        state.animal.juveniles_count += successful * juveniles_per_clutch;\n   343\t    }\n   344\t\n   345\t    if failed > 0 {\n   346\t        // Failure-mode invariant: on hatch failure, juveniles_count does NOT increase\n   347\t        let mut causes = Vec::new();\n   348\t        if f_oxygen < 0.6 {\n   349\t            causes.push(EventCause::LowOxygen);\n   350\t        }\n   351\t        if f_temp < 0.5 {\n   352\t            causes.push(EventCause::HighTemperature);\n   353\t        }\n   354\t        if f_mineral < 0.6 {\n   355\t            causes.push(EventCause::LowMinerals);\n   356\t        }\n   357\t        if f_stability < 0.6 {\n   358\t            causes.push(EventCause::ChemistryInstability);\n   359\t        }\n   360\t        if causes.is_empty() {\n   361\t            causes.push(EventCause::PoorCondition);\n   362\t        }\n   363\t\n   364\t        crate::systems::events::emit_once_per_day_pub(\n   365\t            state,\n   366\t            EventSeverity::Warning,\n   367\t            EventKind::EggFailure,\n   368\t            causes,\n   369\t            format!(\"{failed} clutch(es) failed to hatch\"),\n   370\t        );\n   371\t    }\n   372\t\n   373\t    // All clutches resolved\n   374\t    state.animal.berried_females_count = 0;\n   375\t    state.animal.egg_progress_days = 0.0;\n   376\t}\n   377\t\n   378\tfn juvenile_recruitment(state: &mut TankState) {\n   379\t    if state.animal.juveniles_count == 0 {\n   380\t        return;\n","exit_code":0,"status":"completed"}}
