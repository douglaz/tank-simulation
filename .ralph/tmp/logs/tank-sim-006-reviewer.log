?;\n    34\t    check_non_negative(\"potassium_mg_total\", state.water.potassium_mg_total)?;\n    35\t    check_non_negative(\"bicarbonate_mg_total\", state.water.bicarbonate_mg_total)?;\n    36\t    check_non_negative(\"chloride_mg_total\", state.water.chloride_mg_total)?;\n    37\t    check_non_negative(\"sulfate_mg_total\", state.water.sulfate_mg_total)?;\n    38\t    check_non_negative(\n    39\t        \"particulate_organics_g_total\",\n    40\t        state.detritus.particulate_organics_g_total,\n    41\t    )?;\n    42\t    check_non_negative(\n    43\t        \"fine_detritus_g_total\",\n    44\t        state.detritus.fine_detritus_g_total,\n    45\t    )?;\n    46\t    check_non_negative(\n    47\t        \"dissolved_feed_residue_g_total\",\n    48\t        state.detritus.dissolved_feed_residue_g_total,\n    49\t    )?;\n    50\t    check_non_negative(\"decomposer_biomass_g\", state.microbe.decomposer_biomass_g)?;\n    51\t    check_non_negative(\n    52\t        \"ammonia_oxidizer_biomass_g\",\n    53\t        state.microbe.ammonia_oxidizer_biomass_g,\n    54\t    )?;\n    55\t    check_non_negative(\n    56\t        \"nitrite_oxidizer_biomass_g\",\n    57\t        state.microbe.nitrite_oxidizer_biomass_g,\n    58\t    )?;\n    59\t    check_non_negative(\"comammox_biomass_g\", state.microbe.comammox_biomass_g)?;\n    60\t    for plant in &state.plant_guilds {\n    61\t        check_non_negative(\"plant.biomass_g\", plant.biomass_g)?;\n    62\t    }\n    63\t    check_non_negative(\"algae.suspended_biomass_g\", state.algae.suspended_biomass_g)?;\n    64\t    check_non_negative(\n    65\t        \"algae.periphyton_biomass_g\",\n    66\t        state.algae.periphyton_biomass_g,\n    67\t    )?;\n    68\t    for layer in &state.substrate_layers {\n    69\t        check_non_negative(\"substrate.depth_cm\", layer.depth_cm)?;\n    70\t        check_non_negative(\n    71\t            \"substrate.nutrient_store_mg_n_total\",\n    72\t            layer.nutrient_store_mg_n_total,\n    73\t        )?;\n    74\t        check_non_negative(\n    75\t            \"substrate.nutrient_store_mg_p_total\",\n    76\t            layer.nutrient_store_mg_p_total,\n    77\t        )?;\n    78\t        check_non_negative(\"substrate.colonizable_area_cm2\", layer.colonizable_area_cm2)?;\n    79\t    }\n    80\t    check_non_negative(\"water.temperature_c\", state.water.temperature_c)?;\n    81\t    if state.water.temperature_c <= 0.0 {\n    82\t        return Err(SimError::TemperatureTooLow {\n    83\t            field: \"water.temperature_c\",\n    84\t            value: state.water.temperature_c,\n    85\t        });\n    86\t    }\n    87\t    if !state.water.ph.is_finite() {\n    88\t        return Err(SimError::InvariantViolation {\n    89\t            field: \"water.ph\",\n    90\t            value: state.water.ph,\n    91\t        });\n    92\t    }\n    93\t    state.water.ph = state.water.ph.clamp(5.5, 8.5);\n    94\t\n    95\t    state.geometry.lid_exchange_factor = state.geometry.lid_exchange_factor.clamp(0.0, 1.0);\n    96\t    state.hardware.light.intensity_index = state.hardware.light.intensity_index.clamp(0.0, 1.0);\n    97\t    state.hardware.filter.cleanliness_index =\n    98\t        state.hardware.filter.cleanliness_index.clamp(0.0, 1.0);\n    99\t    state.hardware.aeration.intensity = state.hardware.aeration.intensity.clamp(0.0, 1.0);\n   100\t    state.filter_state.biofilter_maturity_index =\n   101\t        state.filter_state.biofilter_maturity_index.clamp(0.0, 1.0);\n   102\t    state.filter_state.clogging_index = state.filter_state.clogging_index.clamp(0.0, 1.0);\n   103\t    state.filter_state.seeded_biomass_index =\n   104\t        state.filter_state.seeded_biomass_index.clamp(0.0, 1.0);\n   105\t    state.algae.nuisance_index = state.algae.nuisance_index.clamp(0.0, 1.0);\n   106\t    state.microbe.maturity_index = state.microbe.maturity_index.clamp(0.0, 1.0);\n   107\t    state.microfauna.population_index = state.microfauna.population_index.clamp(0.0, 1.0);\n   108\t    state.microfauna.grazing_pressure_index =\n   109\t        state.microfauna.grazing_pressure_index.clamp(0.0, 1.0);\n   110\t    state.animal.condition_index = state.animal.condition_index.clamp(0.0, 1.0);\n   111\t    state.animal.molt_stress_index = state.animal.molt_stress_index.clamp(0.0, 1.0);\n   112\t    state.animal.reproductive_readiness_index =\n   113\t        state.animal.reproductive_readiness_index.clamp(0.0, 1.0);\n   114\t    // Shrimp population invariants: berried <= adults, no negative egg progress\n   115\t    state.animal.clamp_berried_to_adults();\n   116\t    state.animal.egg_progress_days = state.animal.egg_progress_days.max(0.0);\n   117\t    // Remove any empty cohorts\n   118\t    state.animal.egg_cohorts.retain(|c| c.count > 0);\n   119\t    state.stability_tracker.instability_index =\n   120\t        state.stability_tracker.instability_index.clamp(0.0, 1.0);\n   121\t\n   122\t    for plant in &mut state.plant_guilds {\n   123\t        plant.health_index = plant.health_index.clamp(0.0, 1.0);\n   124\t        plant.crowding_index = plant.crowding_index.clamp(0.0, 1.0);\n   125\t        plant.habitat_index = plant.habitat_index.clamp(0.0, 1.0);\n   126\t    }\n   127\t    for layer in &mut state.substrate_layers {\n   128\t        layer.cation_exchange_capacity_index = layer.cation_exchange_capacity_index.clamp(0.0, 1.0);\n   129\t        layer.detritus_trapping_index = layer.detritus_trapping_index.clamp(0.0, 1.0);\n   130\t        layer.low_oxygen_tendency_index = layer.low_oxygen_tendency_index.clamp(0.0, 1.0);\n   131\t        layer.grazing_surface_index = layer.grazing_surface_index.clamp(0.0, 1.0);\n   132\t    }\n   133\t\n   134\t    if state.event_log.len() > 200 {\n   135\t        let keep_from = state.event_log.len() - 200;\n   136\t        state.event_log.drain(0..keep_from);\n   137\t    }\n   138\t\n   139\t    Ok(())\n   140\t}\n   141\t\n   142\tfn check_non_negative(field: &'static str, value: f64) -> Result<(), SimError> {\n   143\t    if !value.is_finite() || value < 0.0 {\n   144\t        Err(SimError::InvariantViolation { field, value })\n   145\t    } else {\n   146\t        Ok(())\n   147\t    }\n   148\t}\n","exit_code":0,"status":"completed"}}
