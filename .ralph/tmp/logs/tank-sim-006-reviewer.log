{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/tests/thermal_reproduction_penalty.rs | sed -n '1,240p'\"","aggregated_output":"     1\tuse tank_core::{Engine, PlayerAction, ProcessParams, SimSeed, SimulationEngine, TankState};\n     2\t\n     3\t/// Creates a stocked shrimp scenario at the given ambient temperature.\n     4\t/// Uses a large, very well-maintained tank to isolate the thermal reproduction\n     5\t/// effect from secondary dynamics (food depletion, ammonia spikes, DO crashes).\n     6\tfn stocked_scenario(seed: SimSeed, ambient_temp_c: f64) -> TankState {\n     7\t    // Large tank (~200 L) for strong dilution\n     8\t    let geometry = tank_core::TankGeometry {\n     9\t        length_cm: 80.0,\n    10\t        width_cm: 50.0,\n    11\t        height_cm: 55.0,\n    12\t        fill_height_cm: 50.0,\n    13\t        glass_thickness_mm: 5.0,\n    14\t        open_top: true,\n    15\t        lid_exchange_factor: 0.25,\n    16\t    };\n    17\t    let water = tank_core::WaterState::default_for_geometry(&geometry);\n    18\t\n    19\t    let mut state = TankState::new(seed);\n    20\t    state.geometry = geometry;\n    21\t    state.water = water;\n    22\t    state.water.temperature_c = ambient_temp_c;\n    23\t    state.environment.ambient_temp_c = ambient_temp_c;\n    24\t\n    25\t    // Excellent water quality\n    26\t    let vol = state.geometry.water_volume_l();\n    27\t    state.water.calcium_mg_total = 40.0 * vol;\n    28\t    state.water.magnesium_mg_total = 10.0 * vol;\n    29\t    state.water.alkalinity_meq_total = 12.0 * vol; // Very high buffering\n    30\t    state.water.dissolved_inorganic_carbon_mg_c_total = 5.0 * vol;\n    31\t    state.water.dissolved_oxygen_mg_total = 8.0 * vol;\n    32\t    state.water.bicarbonate_mg_total = 400.0 * vol;\n    33\t\n    34\t    // Very abundant periphyton so food is never limiting\n    35\t    state.algae.periphyton_biomass_g = 30.0;\n    36\t\n    37\t    // Very strong nitrification to prevent any ammonia buildup\n    38\t    state.microbe.decomposer_biomass_g = 0.3;\n    39\t    state.microbe.ammonia_oxidizer_biomass_g = 2.0;\n    40\t    state.microbe.nitrite_oxidizer_biomass_g = 1.5;\n    41\t    state.microbe.comammox_biomass_g = 0.5;\n    42\t    state.filter_state.biofilter_maturity_index = 1.0;\n    43\t\n    44\t    // Very strong aeration to maintain DO at both temperatures\n    45\t    state.hardware.aeration.enabled = true;\n    46\t    state.hardware.aeration.intensity = 1.0;\n    47\t\n    48\t    // Good light for periphyton regrowth\n    49\t    state.hardware.light.enabled = true;\n    50\t    state.hardware.light.intensity_index = 0.7;\n    51\t    state.hardware.light.photoperiod_hours = 10.0;\n    52\t\n    53\t    // Moderate starting population\n    54\t    state.animal.adults_count = 10;\n    55\t    state.animal.condition_index = 0.8;\n    56\t    state.animal.molt_stress_index = 0.1;\n    57\t    state.animal.reproductive_readiness_index = 0.5;\n    58\t\n    59\t    state.process_params = ProcessParams::default();\n    60\t    state.process_params.aob_vmax_mg_n_per_g_per_hour = 10.0;\n    61\t    state.process_params.nob_vmax_mg_n_per_g_per_hour = 10.0;\n    62\t    // Very high periphyton capacity: won't be food-limited\n    63\t    state.process_params.periphyton_capacity_g_per_m2 = 200.0;\n    64\t\n    65\t    // Use a low spawn rate so population growth doesn't create a food competition\n    66\t    // differential large enough to mask the direct thermal reproduction penalty.\n    67\t    state.shrimp_params.base_spawn_rate = 0.03;\n    68\t\n    69\t    // Initialize stability tracker from actual state\n    70\t    let ca_mg_l = state.water.calcium_mg_total / vol;\n    71\t    let mg_mg_l = state.water.magnesium_mg_total / vol;\n    72\t    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n    73\t    state.stability_tracker.prev_temp_c = state.water.temperature_c;\n    74\t    state.stability_tracker.prev_gh_d = gh_d;\n    75\t    state.stability_tracker.prev_do_mg_l = state.water.dissolved_oxygen_mg_total / vol;\n    76\t    state.stability_tracker.prev_ph = 7.5;\n    77\t\n    78\t    state\n    79\t}\n    80\t\n    81\t#[test]\n    82\tfn thermal_reproduction_penalty() -> Result<(), tank_core::SimError> {\n    83\t    let cool_state = stocked_scenario(SimSeed(9000), 25.0);\n    84\t    let warm_state = stocked_scenario(SimSeed(9000), 30.0);\n    85\t\n    86\t    let mut cool_engine = Engine::from_parts(cool_state, vec![]);\n    87\t    let mut warm_engine = Engine::from_parts(warm_state, vec![]);\n    88\t\n    89\t    // Run for 60 days as required by the spec.\n    90\t    // Moderate feeding to sustain population without overwhelming nitrification.\n    91\t    for _ in 0..60 {\n    92\t        cool_engine.apply_action(PlayerAction::Feed { grams: 0.1 })?;\n    93\t        warm_engine.apply_action(PlayerAction::Feed { grams: 0.1 })?;\n    94\t        cool_engine.step_hours(24)?;\n    95\t        warm_engine.step_hours(24)?;\n    96\t    }\n    97\t\n    98\t    let cool_snap = cool_engine.snapshot();\n    99\t    let warm_snap = warm_engine.snapshot();\n   100\t\n   101\t    // The 30°C tank must end with at least 20% lower reproductive readiness\n   102\t    let readiness_reduction = 1.0\n   103\t        - (warm_snap.shrimp_reproductive_readiness\n   104\t            / cool_snap.shrimp_reproductive_readiness.max(f64::EPSILON));\n   105\t    assert!(\n   106\t        readiness_reduction >= 0.20,\n   107\t        \"30°C tank should have at least 20% lower reproductive readiness than 25°C tank \\\n   108\t         after 60 days. Cool: {:.4}, Warm: {:.4}, Reduction: {:.2}%\",\n   109\t        cool_snap.shrimp_reproductive_readiness,\n   110\t        warm_snap.shrimp_reproductive_readiness,\n   111\t        readiness_reduction * 100.0\n   112\t    );\n   113\t\n   114\t    // The 30°C tank must end with fewer juveniles than the 25°C tank\n   115\t    assert!(\n   116\t        warm_snap.juveniles_count < cool_snap.juveniles_count,\n   117\t        \"30°C tank should have fewer juveniles than 25°C tank after 60 days. \\\n   118\t         Cool juveniles: {}, Warm juveniles: {}\",\n   119\t        cool_snap.juveniles_count,\n   120\t        warm_snap.juveniles_count\n   121\t    );\n   122\t\n   123\t    Ok(())\n   124\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/tests/shrimp_population.rs | sed -n '1,360p'\"","aggregated_output":"     1\tuse tank_core::{\n     2\t    EggCohort, Engine, EventKind, PlayerAction, ProcessParams, SimError, SimSeed, SimulationEngine,\n     3\t    TankState,\n     4\t};\n     5\t\n     6\t/// Creates a well-conditioned tank with shrimp for population tests.\n     7\tfn shrimp_test_state(seed: SimSeed) -> TankState {\n     8\t    let geometry = tank_core::TankGeometry {\n     9\t        length_cm: 40.0,\n    10\t        width_cm: 30.0,\n    11\t        height_cm: 35.0,\n    12\t        fill_height_cm: 30.0,\n    13\t        glass_thickness_mm: 5.0,\n    14\t        open_top: true,\n    15\t        lid_exchange_factor: 0.25,\n    16\t    };\n    17\t    let water = tank_core::WaterState::default_for_geometry(&geometry);\n    18\t\n    19\t    let mut state = TankState::new(seed);\n    20\t    state.geometry = geometry;\n    21\t    state.water = water;\n    22\t    state.water.temperature_c = 24.0;\n    23\t    state.environment.ambient_temp_c = 24.0;\n    24\t\n    25\t    let vol = state.geometry.water_volume_l();\n    26\t    state.water.calcium_mg_total = 40.0 * vol;\n    27\t    state.water.magnesium_mg_total = 10.0 * vol;\n    28\t    state.water.alkalinity_meq_total = 8.0 * vol; // high buffer to avoid pH crash from nitrification\n    29\t    state.water.dissolved_inorganic_carbon_mg_c_total = 5.0 * vol;\n    30\t    state.water.dissolved_oxygen_mg_total = 8.0 * vol;\n    31\t    state.water.bicarbonate_mg_total = 300.0 * vol;\n    32\t    state.algae.periphyton_biomass_g = 5.0;\n    33\t\n    34\t    state.microbe.decomposer_biomass_g = 0.1;\n    35\t    state.microbe.ammonia_oxidizer_biomass_g = 0.8;\n    36\t    state.microbe.nitrite_oxidizer_biomass_g = 0.5;\n    37\t    state.microbe.comammox_biomass_g = 0.15;\n    38\t    state.filter_state.biofilter_maturity_index = 1.0;\n    39\t\n    40\t    state.hardware.aeration.enabled = true;\n    41\t    state.hardware.aeration.intensity = 0.3;\n    42\t    state.hardware.light.enabled = true;\n    43\t    state.hardware.light.intensity_index = 0.6;\n    44\t    state.hardware.light.photoperiod_hours = 8.0;\n    45\t\n    46\t    state.animal.adults_count = 10;\n    47\t    state.animal.condition_index = 0.8;\n    48\t    state.animal.molt_stress_index = 0.1;\n    49\t    state.animal.reproductive_readiness_index = 0.5;\n    50\t\n    51\t    state.process_params = ProcessParams::default();\n    52\t    // Mature biofilter: faster nitrification to keep TAN near zero\n    53\t    state.process_params.aob_vmax_mg_n_per_g_per_hour = 5.0;\n    54\t    state.process_params.nob_vmax_mg_n_per_g_per_hour = 5.0;\n    55\t    // Well-established tank with good colonizable surfaces for periphyton\n    56\t    state.process_params.periphyton_capacity_g_per_m2 = 30.0;\n    57\t\n    58\t    // Initialize stability tracker from actual state to avoid day-1 instability spike\n    59\t    let ca_mg_l = state.water.calcium_mg_total / vol;\n    60\t    let mg_mg_l = state.water.magnesium_mg_total / vol;\n    61\t    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n    62\t    state.stability_tracker.prev_temp_c = state.water.temperature_c;\n    63\t    state.stability_tracker.prev_gh_d = gh_d;\n    64\t    state.stability_tracker.prev_do_mg_l = state.water.dissolved_oxygen_mg_total / vol;\n    65\t    // pH will be computed on first tick; use a reasonable estimate\n    66\t    state.stability_tracker.prev_ph = 7.5;\n    67\t\n    68\t    state\n    69\t}\n    70\t\n    71\t#[test]\n    72\tfn spawning_creates_berried_females() -> Result<(), SimError> {\n    73\t    let mut engine = Engine::from_parts(shrimp_test_state(SimSeed(7000)), vec![]);\n    74\t\n    75\t    // Run for 30 days with light feeding\n    76\t    for _ in 0..30 {\n    77\t        engine.apply_action(PlayerAction::Feed { grams: 0.1 })?;\n    78\t        engine.step_hours(24)?;\n    79\t    }\n    80\t\n    81\t    let state = engine.full_state();\n    82\t    let events = &state.event_log;\n    83\t\n    84\t    // Over 30 days at good conditions, we should see ShrimpBerried events\n    85\t    let berried_events = events\n    86\t        .iter()\n    87\t        .filter(|e| e.kind == EventKind::ShrimpBerried)\n    88\t        .count();\n    89\t    assert!(\n    90\t        berried_events > 0,\n    91\t        \"Should have at least one ShrimpBerried event in 30 days of good conditions\"\n    92\t    );\n    93\t\n    94\t    // All ShrimpBerried events must have non-empty cause codes\n    95\t    for e in events.iter().filter(|e| e.kind == EventKind::ShrimpBerried) {\n    96\t        assert!(!e.cause_codes.is_empty(), \"ShrimpBerried must have cause codes\");\n    97\t    }\n    98\t\n    99\t    Ok(())\n   100\t}\n   101\t\n   102\t#[test]\n   103\tfn hatch_produces_juveniles() -> Result<(), SimError> {\n   104\t    let mut engine = Engine::from_parts(shrimp_test_state(SimSeed(7100)), vec![]);\n   105\t\n   106\t    // Run for 60 days - enough for spawning + egg development (21 days) + hatching\n   107\t    for _ in 0..60 {\n   108\t        engine.apply_action(PlayerAction::Feed { grams: 0.1 })?;\n   109\t        engine.step_hours(24)?;\n   110\t    }\n   111\t\n   112\t    let snap = engine.snapshot();\n   113\t    // In good conditions over 60 days, at least some juveniles should appear\n   114\t    // (10 adults, 21-day egg cycle, good conditions)\n   115\t    assert!(\n   116\t        snap.juveniles_count > 0 || snap.adult_shrimp_count > 10,\n   117\t        \"After 60 days in good conditions, population should have grown. \\\n   118\t         Adults: {}, Juveniles: {}\",\n   119\t        snap.adult_shrimp_count,\n   120\t        snap.juveniles_count\n   121\t    );\n   122\t\n   123\t    Ok(())\n   124\t}\n   125\t\n   126\t#[test]\n   127\tfn egg_failure_under_stress() -> Result<(), SimError> {\n   128\t    let mut state = shrimp_test_state(SimSeed(7200));\n   129\t    // Force berried state with cohort tracking\n   130\t    state.animal.berried_females_count = 3;\n   131\t    state.animal.egg_progress_days = 20.0; // About to hatch\n   132\t    state.animal.egg_cohorts = vec![EggCohort {\n   133\t        count: 3,\n   134\t        progress_days: 20.0,\n   135\t    }];\n   136\t\n   137\t    // Create stressful conditions: low DO, high temp\n   138\t    let vol = state.geometry.water_volume_l();\n   139\t    state.water.dissolved_oxygen_mg_total = 2.0 * vol; // Low DO\n   140\t    state.water.temperature_c = 32.0;\n   141\t    state.environment.ambient_temp_c = 32.0;\n   142\t    state.water.calcium_mg_total = 5.0 * vol; // Low minerals\n   143\t    state.water.magnesium_mg_total = 1.0 * vol;\n   144\t\n   145\t    let mut engine = Engine::from_parts(state, vec![]);\n   146\t    // Run one day to trigger clutch resolution\n   147\t    engine.step_hours(24)?;\n   148\t\n   149\t    let events = &engine.full_state().event_log;\n   150\t    let egg_failures = events\n   151\t        .iter()\n   152\t        .filter(|e| e.kind == EventKind::EggFailure)\n   153\t        .collect::<Vec<_>>();\n   154\t\n   155\t    // Under these stressful conditions, egg failures should occur\n   156\t    assert!(\n   157\t        !egg_failures.is_empty(),\n   158\t        \"Should have EggFailure events under stress\"\n   159\t    );\n   160\t\n   161\t    // EggFailure must have cause codes tied to oxygen, temperature, minerals, or instability\n   162\t    for e in &egg_failures {\n   163\t        assert!(!e.cause_codes.is_empty(), \"EggFailure must have non-empty cause_codes\");\n   164\t    }\n   165\t\n   166\t    // Failure invariant: berried_females_count resolved (back to 0)\n   167\t    let state = engine.full_state();\n   168\t    assert_eq!(state.animal.berried_females_count, 0);\n   169\t    assert_eq!(state.animal.egg_progress_days, 0.0);\n   170\t\n   171\t    Ok(())\n   172\t}\n   173\t\n   174\t#[test]\n   175\tfn mortality_under_combined_stress() -> Result<(), SimError> {\n   176\t    let mut state = shrimp_test_state(SimSeed(7300));\n   177\t    state.animal.adults_count = 20;\n   178\t    state.animal.juveniles_count = 10;\n   179\t\n   180\t    // Create combined low-DO + high-NH3 stress\n   181\t    let vol = state.geometry.water_volume_l();\n   182\t    state.water.dissolved_oxygen_mg_total = 1.5 * vol; // Very low DO\n   183\t    state.water.ammonia_total_mg_n_total = 2.0 * vol; // Very high ammonia\n   184\t    state.water.alkalinity_meq_total = 8.0 * vol; // High pH -> more NH3\n   185\t    state.process_params.reaeration_kla_base = 0.05; // Slow recovery\n   186\t\n   187\t    let mut engine = Engine::from_parts(state, vec![]);\n   188\t\n   189\t    // Run 14 days under stress\n   190\t    for _ in 0..14 {\n   191\t        engine.step_hours(24)?;\n   192\t    }\n   193\t\n   194\t    let snap = engine.snapshot();\n   195\t    let total_survivors = snap.adult_shrimp_count + snap.juveniles_count;\n   196\t    assert!(\n   197\t        total_survivors < 30,\n   198\t        \"Population should decline under combined stress. Survivors: {}\",\n   199\t        total_survivors\n   200\t    );\n   201\t\n   202\t    Ok(())\n   203\t}\n   204\t\n   205\t#[test]\n   206\tfn microfauna_suppression_under_heavy_grazing() -> Result<(), SimError> {\n   207\t    // Tank with many shrimp should suppress microfauna\n   208\t    let mut state = shrimp_test_state(SimSeed(7400));\n   209\t    state.animal.adults_count = 50; // Heavy stocking\n   210\t    state.microfauna.population_index = 0.8; // Start with healthy microfauna\n   211\t\n   212\t    let initial_pop = state.microfauna.population_index;\n   213\t\n   214\t    let mut engine = Engine::from_parts(state, vec![]);\n   215\t    for _ in 0..30 {\n   216\t        engine.apply_action(PlayerAction::Feed { grams: 0.3 })?;\n   217\t        engine.step_hours(24)?;\n   218\t    }\n   219\t\n   220\t    let snap = engine.snapshot();\n   221\t    assert!(\n   222\t        snap.microfauna_population_index < initial_pop,\n   223\t        \"Heavy shrimp grazing should suppress microfauna. Start: {}, End: {}\",\n   224\t        initial_pop,\n   225\t        snap.microfauna_population_index\n   226\t    );\n   227\t\n   228\t    Ok(())\n   229\t}\n   230\t\n   231\t#[test]\n   232\tfn shrimp_removal_validation() -> Result<(), SimError> {\n   233\t    let mut state = shrimp_test_state(SimSeed(7500));\n   234\t    state.animal.adults_count = 5;\n   235\t    state.animal.berried_females_count = 2;\n   236\t\n   237\t    let mut engine = Engine::from_parts(state, vec![]);\n   238\t\n   239\t    // Try to remove more than available\n   240\t    let result = engine.apply_action(PlayerAction::RemoveShrimp { count: 10 });\n   241\t    assert!(\n   242\t        matches!(result, Err(SimError::ShrimpRemovalExceedsAvailable { .. })),\n   243\t        \"Should fail when removing more shrimp than available\"\n   244\t    );\n   245\t\n   246\t    // Verify state is unchanged after failed removal\n   247\t    assert_eq!(engine.full_state().animal.adults_count, 5);\n   248\t    assert_eq!(engine.full_state().animal.berried_females_count, 2);\n   249\t\n   250\t    // Remove valid amount\n   251\t    engine.apply_action(PlayerAction::RemoveShrimp { count: 3 })?;\n   252\t    engine.step_hours(1)?;\n   253\t\n   254\t    let state = engine.full_state();\n   255\t    assert_eq!(state.animal.adults_count, 2);\n   256\t    // berried_females_count must be <= adults_count\n   257\t    assert!(\n   258\t        state.animal.berried_females_count <= state.animal.adults_count,\n   259\t        \"berried_females ({}) must be <= adults ({})\",\n   260\t        state.animal.berried_females_count,\n   261\t        state.animal.adults_count\n   262\t    );\n   263\t\n   264\t    Ok(())\n   265\t}\n   266\t\n   267\t#[test]\n   268\tfn shrimp_removal_accounts_for_queued_actions() -> Result<(), SimError> {\n   269\t    let mut state = shrimp_test_state(SimSeed(7600));\n   270\t    state.animal.adults_count = 5;\n   271\t\n   272\t    let mut engine = Engine::from_parts(state, vec![]);\n   273\t\n   274\t    // Queue removal of 3\n   275\t    engine.apply_action(PlayerAction::RemoveShrimp { count: 3 })?;\n   276\t\n   277\t    // Try to remove 3 more (only 2 should be available)\n   278\t    let result = engine.apply_action(PlayerAction::RemoveShrimp { count: 3 });\n   279\t    assert!(\n   280\t        matches!(result, Err(SimError::ShrimpRemovalExceedsAvailable { .. })),\n   281\t        \"Should fail because only 2 adults remain after pending removal\"\n   282\t    );\n   283\t\n   284\t    // But removing 2 should succeed\n   285\t    engine.apply_action(PlayerAction::RemoveShrimp { count: 2 })?;\n   286\t\n   287\t    Ok(())\n   288\t}\n   289\t\n   290\t#[test]\n   291\tfn population_fields_never_negative() -> Result<(), SimError> {\n   292\t    let mut state = shrimp_test_state(SimSeed(7700));\n   293\t    state.animal.adults_count = 3;\n   294\t    state.animal.juveniles_count = 2;\n   295\t\n   296\t    // Very hostile environment\n   297\t    let vol = state.geometry.water_volume_l();\n   298\t    state.water.dissolved_oxygen_mg_total = 0.5 * vol;\n   299\t    state.water.ammonia_total_mg_n_total = 5.0 * vol;\n   300\t\n   301\t    let mut engine = Engine::from_parts(state, vec![]);\n   302\t\n   303\t    // Run many days under extreme stress\n   304\t    for _ in 0..60 {\n   305\t        engine.step_hours(24)?;\n   306\t    }\n   307\t\n   308\t    let state = engine.full_state();\n   309\t    // All population counts must be non-negative (u32 can't be negative, but check invariants)\n   310\t    assert!(state.animal.condition_index >= 0.0);\n   311\t    assert!(state.animal.condition_index <= 1.0);\n   312\t    assert!(state.animal.molt_stress_index >= 0.0);\n   313\t    assert!(state.animal.molt_stress_index <= 1.0);\n   314\t    assert!(state.animal.reproductive_readiness_index >= 0.0);\n   315\t    assert!(state.animal.reproductive_readiness_index <= 1.0);\n   316\t    assert!(state.animal.berried_females_count <= state.animal.adults_count);\n   317\t\n   318\t    Ok(())\n   319\t}\n","exit_code":0,"status":"completed"}}
