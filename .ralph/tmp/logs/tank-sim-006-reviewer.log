{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/src/systems/shrimp.rs | sed -n '520,620p'\"","aggregated_output":"   520\t    } else {\n   521\t        0.05\n   522\t    }\n   523\t}\n   524\t\n   525\t/// Temperature factor for general condition (broader bell than reproduction).\n   526\tfn temp_condition_factor(temp: f64, params: &ShrimpRuntimeParams) -> f64 {\n   527\t    if temp >= params.optimal_temp_min_c && temp <= params.optimal_temp_max_c {\n   528\t        1.0\n   529\t    } else if temp < params.optimal_temp_min_c {\n   530\t        (1.0 - (params.optimal_temp_min_c - temp) / 10.0).clamp(0.2, 1.0)\n   531\t    } else {\n   532\t        (1.0 - (temp - params.optimal_temp_max_c) / 8.0).clamp(0.2, 1.0)\n   533\t    }\n   534\t}\n   535\t\n   536\t/// GH/mineral factor for spawning and condition.\n   537\tfn gh_mineral_factor(gh_d: f64, params: &ShrimpRuntimeParams) -> f64 {\n   538\t    if gh_d >= params.gh_min_d && gh_d <= params.gh_max_d {\n   539\t        1.0\n   540\t    } else if gh_d < params.gh_min_d {\n   541\t        (gh_d / params.gh_min_d.max(0.01)).clamp(0.3, 1.0)\n   542\t    } else {\n   543\t        (1.0 - (gh_d - params.gh_max_d) / 10.0).clamp(0.3, 1.0)\n   544\t    }\n   545\t}\n","exit_code":0,"status":"completed"}}
