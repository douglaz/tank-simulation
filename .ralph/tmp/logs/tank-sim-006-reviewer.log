nt_temp_optimum_c,\n    97\t        plant_temp_sigma_c: preset.plant_temp_sigma_c,\n    98\t        plant_crowding_biomass_g_per_m2: preset.plant_crowding_biomass_g_per_m2,\n    99\t\n   100\t        algae_max_growth_rate_per_day: preset.algae_max_growth_rate_per_day,\n   101\t        periphyton_max_growth_rate_per_day: preset.periphyton_max_growth_rate_per_day,\n   102\t        algae_respiration_fraction_per_day: preset.algae_respiration_fraction_per_day,\n   103\t        algae_half_saturation_n_mg_total: preset.algae_half_saturation_n_mg_total,\n   104\t        algae_half_saturation_p_mg_total: preset.algae_half_saturation_p_mg_total,\n   105\t        algae_light_half_saturation: preset.algae_light_half_saturation,\n   106\t        algae_temp_optimum_c: preset.algae_temp_optimum_c,\n   107\t        algae_temp_sigma_c: preset.algae_temp_sigma_c,\n   108\t        periphyton_capacity_g_per_m2: preset.periphyton_capacity_g_per_m2,\n   109\t        algae_bloom_threshold_g_per_l: preset.algae_bloom_threshold_g_per_l,\n   110\t        algae_nuisance_biomass_g_per_m2: preset.algae_nuisance_biomass_g_per_m2,\n   111\t\n   112\t        shrimp_base_mortality_per_day: preset.shrimp_base_mortality_per_day,\n   113\t        shrimp_stress_mortality_scale: preset.shrimp_stress_mortality_scale,\n   114\t        shrimp_juvenile_maturation_days: preset.shrimp_juvenile_maturation_days,\n   115\t        shrimp_periphyton_grazing_g_per_shrimp_per_day: preset\n   116\t            .shrimp_periphyton_grazing_g_per_shrimp_per_day,\n   117\t        shrimp_condition_smoothing: preset.shrimp_condition_smoothing,\n   118\t\n   119\t        microfauna_mineralization_boost: preset.microfauna_mineralization_boost,\n   120\t        microfauna_periphyton_consumption: preset.microfauna_periphyton_consumption,\n   121\t        microfauna_population_smoothing: preset.microfauna_population_smoothing,\n   122\t        microfauna_shrimp_pressure_threshold: preset.microfauna_shrimp_pressure_threshold,\n   123\t    }\n   124\t}\n   125\t\n   126\t/// Materializes a scenario preset into a fully resolved `TankState`.\n   127\t///\n   128\t/// - Geometry comes from the scenario.\n   129\t/// - `environment.ambient_temp_c` comes from the scenario.\n   130\t/// - Initial `WaterState` totals come from the source-water profile × fill volume.\n   131\t/// - Substrate layers come from the scenario's substrate preset IDs.\n   132\t/// - Plant guilds come from the scenario's plant preset IDs.\n   133\t/// - Source-water catalog is populated with all known source-water presets.\n   134\t/// - Process parameters come from the scenario's process params preset.\n   135\tpub fn seeded_state(seed: SimSeed, scenario_id: &str) -> Result<TankState, tank_data::PresetError> {\n   136\t    let scenario = load_named_scenario(scenario_id)?;\n   137\t\n   138\t    // Geometry\n   139\t    let geometry = TankGeometry {\n   140\t        length_cm: scenario.tank_length_cm,\n   141\t        width_cm: scenario.tank_width_cm,\n   142\t        height_cm: scenario.tank_height_cm,\n   143\t        fill_height_cm: scenario.fill_height_cm,\n   144\t        glass_thickness_mm: 5.0,\n   145\t        open_top: true,\n   146\t        lid_exchange_factor: 0.25,\n   147\t    };\n   148\t\n   149\t    // Source water profile for initial fill\n   150\t    let source_water_preset = tank_data::load_source_water(&scenario.source_water_id)?;\n   151\t    let source_profile = source_water_to_profile(&source_water_preset);\n   152\t\n   153\t    // Initial water state from source-water profile\n   154\t    let water = WaterState::from_source_profile(&source_profile, &geometry);\n   155\t\n   156\t    // Build source-water catalog with all known presets\n   157\t    let mut source_water_catalog = BTreeMap::new();\n   158\t    for sw_id in tank_data::source_water_ids() {\n   159\t        let sw_preset = tank_data::load_source_water(sw_id)?;\n   160\t        source_water_catalog.insert(sw_id.to_string(), source_water_to_profile(&sw_preset));\n   161\t    }\n   162\t\n   163\t    // Process parameters\n   164\t    let process_preset = tank_data::load_process_params(&scenario.process_params_id)?;\n   165\t    let process_params = process_preset_to_params(&process_preset);\n   166\t\n   167\t    // Substrate layers\n   168\t    let mut substrate_layers = Vec::new();\n   169\t    for sub_id in &scenario.substrate_ids {\n   170\t        let sub_preset = tank_data::load_substrate(sub_id)?;\n   171\t        let footprint = geometry.footprint_area_cm2();\n   172\t        substrate_layers.push(SubstrateLayerState {\n   173\t            kind: match sub_preset.id.as_str() {\n   174\t                \"inert_sand\" => tank_core::SubstrateKind::InertSand,\n   175\t                \"inert_gravel\" => tank_core::SubstrateKind::InertGravel,\n   176\t                \"active_planted\" => tank_core::SubstrateKind::ActivePlanted,\n   177\t                \"coarse_porous\" => tank_core::SubstrateKind::CoarsePorous,\n   178\t                other => {\n   179\t                    return Err(tank_data::PresetError::Validation {\n   180\t                        category: \"substrate\",\n   181\t                        id: other.to_string(),\n   182\t                        message: format!(\"unsupported substrate kind: `{other}`\"),\n   183\t                    });\n   184\t                }\n   185\t            },\n   186\t            depth_cm: sub_preset.depth_cm,\n   187\t            nutrient_store_mg_n_total: sub_preset.nutrient_charge_mg_n_total,\n   188\t            nutrient_store_mg_p_total: sub_preset.nutrient_charge_mg_p_total,\n   189\t            cation_exchange_capacity_index: sub_preset.cation_exchange_capacity_index,\n   190\t            detritus_trapping_index: sub_preset.detritus_trapping_index,\n   191\t            colonizable_area_cm2: footprint * sub_preset.colonizable_area_factor,\n   192\t            low_oxygen_tendency_index: sub_preset.low_oxygen_tendency_index,\n   193\t            grazing_surface_index: sub_preset.grazing_surface_index,\n   194\t        });\n   195\t    }\n   196\t    if substrate_layers.is_empty() {\n   197\t        substrate_layers.push(SubstrateLayerState::default());\n   198\t    }\n   199\t\n   200\t    // Plant guilds\n   201\t    let mut plant_guilds = Vec::new();\n   202\t    for plant_id in &scenario.plant_ids {\n   203\t        let plant_preset = tank_data::load_plant(plant_id)?;\n   204\t        let guild = match plant_preset.guild.as_str() {\n   205\t            \"FastStem\" => PlantGuild::FastStem,\n   206\t            \"RootFeedingRosette\" => PlantGuild::RootFeedingRosette,\n   207\t            other => {\n   208\t                return Err(tank_data::PresetError::Validation {\n   209\t                    category: \"plants\",\n   210\t                    id: plant_id.clone(),\n   211\t                    message: format!(\"unsupported plant guild: `{other}`\"),\n   212\t                });\n   213\t            }\n   214\t        };\n   215\t        plant_guilds.push(PlantGuildState {\n   216\t            guild,\n   217\t            biomass_g: 5.0,\n   218\t            health_index: 0.8,\n   219\t            crowding_index: 0.1,\n   220\t            habitat_index: if guild == PlantGuild::RootFeedingRosette {\n   221\t                // Habitat factor depends on substrate quality\n   222\t                substrate_layers\n   223\t                    .iter()\n   224\t                    .map(|l| l.cation_exchange_capacity_index)\n   225\t                    .fold(0.0_f64, f64::max)\n   226\t                    .max(0.3)\n   227\t            } else {\n   228\t                0.8\n   229\t            },\n   230\t        });\n   231\t    }\n   232\t    if plant_guilds.is_empty() {\n   233\t        plant_guilds.push(PlantGuildState::default());\n   234\t    }\n   235\t\n   236\t    // Shrimp species parameters\n   237\t    let shrimp_preset = tank_data::load_shrimp(&scenario.shrimp_profile_id)?;\n   238\t    let shrimp_params = ShrimpRuntimeParams {\n   239\t        optimal_temp_min_c: shrimp_preset.optimal_temp_min_c,\n   240\t        optimal_temp_max_c: shrimp_preset.optimal_temp_max_c,\n   241\t        gh_min_d: shrimp_preset.gh_min_d,\n   242\t        gh_max_d: shrimp_preset.gh_max_d,\n   243\t        base_spawn_rate: shrimp_preset.base_spawn_rate,\n   244\t        egg_duration_days: shrimp_preset.egg_duration_days,\n   245\t        hatch_success_base: shrimp_preset.hatch_success_base,\n   246\t        juvenile_sensitivity: shrimp_preset.juvenile_sensitivity,\n   247\t        high_temp_repro_penalty_start_c: shrimp_preset.high_temp_repro_penalty_start_c,\n   248\t        high_temp_repro_penalty_full_c: shrimp_preset.high_temp_repro_penalty_full_c,\n   249\t    };\n   250\t\n   251\t    // Environment\n   252\t    let mut environment = tank_core::EnvironmentState::default();\n   253\t    environment.ambient_temp_c = scenario.ambient_temp_c;\n   254\t\n   255\t    let mut state = TankState::new(seed);\n   256\t    state.meta = SimMeta {\n   257\t        scenario_id: Some(scenario.id),\n   258\t        notes: Some(scenario.name),\n   259\t    };\n   260\t    state.geometry = geometry;\n   261\t    state.environment = environment;\n   262\t    state.water = water;\n   263\t    state.substrate_layers = substrate_layers;\n   264\t    state.plant_guilds = plant_guilds;\n   265\t    state.source_water_catalog = source_water_catalog;\n   266\t    state.process_params = process_params;\n   267\t    state.shrimp_params = shrimp_params;\n   268\t\n   269\t    Ok(state)\n   270\t}\n   271\t\n   272\t/// Creates a deterministic cycling fixture pair: one seeded, one unseeded.\n   273\t/// Both tanks are otherwise identical (~20L nano tank with moderate source water,\n   274\t/// fed daily, with aeration enabled).\n   275\t/// The seeded tank starts with elevated nitrifier biomass and higher maturity;\n   276\t/// the unseeded tank starts with minimal microbes and low maturity.\n   277\tpub fn cycling_fixture_pair(seed: SimSeed) -> (TankState, TankState) {\n   278\t    let base = cycling_base_state(seed);\n   279\t\n   280\t    let mut seeded = base.clone();\n   281\t    seeded.meta.scenario_id = Some(\"cycling_seeded\".to_string());\n   282\t    // Seeded: same decomposer biomass but much higher nitrifier biomass + maturity\n   283\t    seeded.microbe = MicrobeState {\n   284\t        decomposer_biomass_g: 0.1,\n   285\t        ammonia_oxidizer_biomass_g: 0.20,\n   286\t        nitrite_oxidizer_biomass_g: 0.15,\n   287\t        comammox_biomass_g: 0.05,\n   288\t        maturity_index: 0.6,\n   289\t    };\n   290\t    seeded.filter_state = FilterState {\n   291\t        biofilter_maturity_index: 0.6,\n   292\t        clogging_index: 0.0,\n   293\t        seeded_biomass_index: 0.8,\n   294\t    };\n   295\t\n   296\t    let mut unseeded = base;\n   297\t    unseeded.meta.scenario_id = Some(\"cycling_unseeded\".to_string());\n   298\t    // Unseeded: same decomposer biomass but minimal nitrifier biomass + maturity\n   299\t    unseeded.microbe = MicrobeState {\n   300\t        decomposer_biomass_g: 0.1,\n   301\t        ammonia_oxidizer_biomass_g: 0.005,\n   302\t        nitrite_oxidizer_biomass_g: 0.005,\n   303\t        comammox_biomass_g: 0.001,\n   304\t        maturity_index: 0.05,\n   305\t    };\n   306\t    unseeded.filter_state = FilterState {\n   307\t        biofilter_maturity_index: 0.05,\n   308\t        clogging_index: 0.0,\n   309\t        seeded_biomass_index: 0.0,\n   310\t    };\n   311\t\n   312\t    (seeded, unseeded)\n   313\t}\n   314\t\n   315\t/// Base state shared by both cycling fixtures.\n   316\tfn cycling_base_state(seed: SimSeed) -> TankState {\n   317\t    let geometry = TankGeometry {\n   318\t        length_cm: 30.0,\n   319\t        width_cm: 25.0,\n   320\t        height_cm: 30.0,\n   321\t        fill_height_cm: 26.0,\n   322\t        glass_thickness_mm: 5.0,\n   323\t        open_top: true,\n   324\t        lid_exchange_factor: 0.25,\n   325\t    };\n   326\t\n   327\t    let water = WaterState::default_for_geometry(&geometry);\n   328\t\n   329\t    let mut state = TankState::new(seed);\n   330\t    state.geometry = geometry;\n   331\t    state.water = water;\n   332\t    state.water.temperature_c = 25.0;\n   333\t    state.environment.ambient_temp_c = 25.0;\n   334\t\n   335\t    // Enable moderate aeration\n   336\t    state.hardware.aeration.enabled = true;\n   337\t    state.hardware.aeration.intensity = 0.3;\n   338\t\n   339\t    // Single fast-stem plant\n   340\t    state.plant_guilds = vec![PlantGuildState {\n   341\t        guild: PlantGuild::FastStem,\n   342\t        biomass_g: 3.0,\n   343\t        health_index: 0.8,\n   344\t        crowding_index: 0.1,\n   345\t        habitat_index: 0.8,\n   346\t    }];\n   347\t\n   348\t    state.process_params = ProcessParams::default();\n   349\t\n   350\t    state\n   351\t}\n","exit_code":0,"status":"completed"}}
