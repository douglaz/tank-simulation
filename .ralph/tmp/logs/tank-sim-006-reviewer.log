ine.full_state().hardware.heater.last_output_w,\n    88\t        restored_engine.full_state().hardware.heater.last_output_w\n    89\t    );\n    90\t    assert_eq!(engine.full_state(), restored_engine.full_state());\n    91\t\n    92\t    Ok(())\n    93\t}\n    94\t\n    95\t#[test]\n    96\tfn save_load_resume_determinism() -> Result<(), tank_core::SimError> {\n    97\t    // Run 240 hours, save, load, run 480 more vs uninterrupted 720\n    98\t    let mut engine_continuous = Engine::new(SimSeed(77));\n    99\t    engine_continuous.step_hours(720)?;\n   100\t\n   101\t    let mut engine_split = Engine::new(SimSeed(77));\n   102\t    engine_split.step_hours(240)?;\n   103\t\n   104\t    let save = SaveFile::from_engine(&engine_split);\n   105\t    let json = save.to_json_pretty()?;\n   106\t    let restored = SaveFile::from_json(&json)?;\n   107\t    let mut engine_resumed = restored.into_engine();\n   108\t    engine_resumed.step_hours(480)?;\n   109\t\n   110\t    assert_eq!(\n   111\t        engine_continuous.full_state(),\n   112\t        engine_resumed.full_state(),\n   113\t        \"Save/load/resume must produce identical state to uninterrupted run\"\n   114\t    );\n   115\t\n   116\t    Ok(())\n   117\t}\n   118\t\n   119\t#[test]\n   120\tfn save_load_with_active_cycle_state() -> Result<(), tank_core::SimError> {\n   121\t    let mut state = TankState::new(SimSeed(78));\n   122\t    // Set up active nitrogen cycle state\n   123\t    state.microbe = MicrobeState {\n   124\t        decomposer_biomass_g: 0.2,\n   125\t        ammonia_oxidizer_biomass_g: 0.15,\n   126\t        nitrite_oxidizer_biomass_g: 0.12,\n   127\t        comammox_biomass_g: 0.03,\n   128\t        maturity_index: 0.5,\n   129\t    };\n   130\t    state.filter_state.biofilter_maturity_index = 0.5;\n   131\t\n   132\t    let mut engine = Engine::from_parts(state, vec![]);\n   133\t\n   134\t    // Feed and run to generate active cycle state\n   135\t    engine.apply_action(PlayerAction::Fee