{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/src/types/snapshot.rs | sed -n '1,260p'\"","aggregated_output":"     1\tuse serde::{Deserialize, Serialize};\n     2\t\n     3\tuse super::{PlantGuild, SimEvent, TankState};\n     4\tuse crate::systems::{chemistry::compute_nh3_mg_l, temperature::do_sat_mg_l};\n     5\t\n     6\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n     7\tpub struct TankSnapshot {\n     8\t    pub day: u32,\n     9\t    pub hour: u8,\n    10\t    pub water_temp_c: f64,\n    11\t    pub water_volume_l: f64,\n    12\t    pub tan_mg_l: f64,\n    13\t    pub nh3_mg_l: f64,\n    14\t    pub nitrite_mg_l: f64,\n    15\t    pub nitrate_mg_l: f64,\n    16\t    pub phosphate_mg_l: f64,\n    17\t    pub do_mg_l: f64,\n    18\t    pub do_sat_mg_l: f64,\n    19\t    pub gh_d: f64,\n    20\t    pub kh_d: f64,\n    21\t    pub tds_mg_l: f64,\n    22\t    pub conductivity_us_cm: f64,\n    23\t    pub ph: f64,\n    24\t    pub adult_shrimp_count: u32,\n    25\t    pub juveniles_count: u32,\n    26\t    pub berried_females_count: u32,\n    27\t    pub shrimp_condition_index: f64,\n    28\t    pub shrimp_molt_stress_index: f64,\n    29\t    pub shrimp_reproductive_readiness: f64,\n    30\t    pub microfauna_population_index: f64,\n    31\t    pub microfauna_grazing_pressure_index: f64,\n    32\t    pub total_plant_biomass_g: f64,\n    33\t    pub fast_stem_biomass_g: f64,\n    34\t    pub root_feeding_rosette_biomass_g: f64,\n    35\t    pub suspended_algae_biomass_g: f64,\n    36\t    pub periphyton_biomass_g: f64,\n    37\t    pub algae_nuisance_index: f64,\n    38\t    pub substrate_nutrient_remaining_mg_n_total: f64,\n    39\t    pub substrate_nutrient_remaining_mg_p_total: f64,\n    40\t    pub last_heater_output_w: f64,\n    41\t    pub recent_events: Vec<SimEvent>,\n    42\t}\n    43\t\n    44\timpl TankSnapshot {\n    45\t    pub fn from_state(state: &TankState) -> Self {\n    46\t        let volume_l = state.geometry.water_volume_l();\n    47\t        let tan_mg_l = safe_div(state.water.ammonia_total_mg_n_total, volume_l);\n    48\t        let nitrite_mg_l = safe_div(state.water.nitrite_mg_n_total, volume_l);\n    49\t        let nitrate_mg_l = safe_div(state.water.nitrate_mg_n_total, volume_l);\n    50\t        let phosphate_mg_l = safe_div(state.water.phosphate_mg_p_total, volume_l);\n    51\t        let do_mg_l_val = safe_div(state.water.dissolved_oxygen_mg_total, volume_l);\n    52\t        let ca_mg_l = safe_div(state.water.calcium_mg_total, volume_l);\n    53\t        let mg_mg_l = safe_div(state.water.magnesium_mg_total, volume_l);\n    54\t        let alkalinity_meq_l = safe_div(state.water.alkalinity_meq_total, volume_l);\n    55\t        let total_tracked_ions_mg = state.water.total_tracked_ions_mg();\n    56\t        let tds_mg_l = safe_div(total_tracked_ions_mg, volume_l);\n    57\t        let conductivity_us_cm = tds_mg_l / 0.65;\n    58\t        let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n    59\t        let kh_d = (alkalinity_meq_l * 50.0) / 17.848;\n    60\t        let ph = state.water.ph;\n    61\t        let nh3_mg_l = compute_nh3_mg_l(tan_mg_l, ph, state.water.temperature_c);\n    62\t        let fast_stem_biomass_g: f64 = state\n    63\t            .plant_guilds\n    64\t            .iter()\n    65\t            .filter(|plant| plant.guild == PlantGuild::FastStem)\n    66\t            .map(|plant| plant.biomass_g)\n    67\t            .sum();\n    68\t        let root_feeding_rosette_biomass_g: f64 = state\n    69\t            .plant_guilds\n    70\t            .iter()\n    71\t            .filter(|plant| plant.guild == PlantGuild::RootFeedingRosette)\n    72\t            .map(|plant| plant.biomass_g)\n    73\t            .sum();\n    74\t\n    75\t        Self {\n    76\t            day: state.environment.day,\n    77\t            hour: state.environment.hour_of_day,\n    78\t            water_temp_c: state.water.temperature_c,\n    79\t            water_volume_l: volume_l,\n    80\t            tan_mg_l,\n    81\t            nh3_mg_l,\n    82\t            nitrite_mg_l,\n    83\t            nitrate_mg_l,\n    84\t            phosphate_mg_l,\n    85\t            do_mg_l: do_mg_l_val,\n    86\t            do_sat_mg_l: do_sat_mg_l(state.water.temperature_c),\n    87\t            gh_d,\n    88\t            kh_d,\n    89\t            tds_mg_l,\n    90\t            conductivity_us_cm,\n    91\t            ph,\n    92\t            adult_shrimp_count: state.animal.adults_count,\n    93\t            juveniles_count: state.animal.juveniles_count,\n    94\t            berried_females_count: state.animal.berried_females_count,\n    95\t            shrimp_condition_index: state.animal.condition_index,\n    96\t            shrimp_molt_stress_index: state.animal.molt_stress_index,\n    97\t            shrimp_reproductive_readiness: state.animal.reproductive_readiness_index,\n    98\t            microfauna_population_index: state.microfauna.population_index,\n    99\t            microfauna_grazing_pressure_index: state.microfauna.grazing_pressure_index,\n   100\t            total_plant_biomass_g: state.plant_guilds.iter().map(|plant| plant.biomass_g).sum(),\n   101\t            fast_stem_biomass_g,\n   102\t            root_feeding_rosette_biomass_g,\n   103\t            suspended_algae_biomass_g: state.algae.suspended_biomass_g,\n   104\t            periphyton_biomass_g: state.algae.periphyton_biomass_g,\n   105\t            algae_nuisance_index: state.algae.nuisance_index,\n   106\t            substrate_nutrient_remaining_mg_n_total: state\n   107\t                .substrate_layers\n   108\t                .iter()\n   109\t                .map(|layer| layer.nutrient_store_mg_n_total)\n   110\t                .sum(),\n   111\t            substrate_nutrient_remaining_mg_p_total: state\n   112\t                .substrate_layers\n   113\t                .iter()\n   114\t                .map(|layer| layer.nutrient_store_mg_p_total)\n   115\t                .sum(),\n   116\t            last_heater_output_w: state.hardware.heater.last_output_w,\n   117\t            recent_events: state.event_log.iter().rev().take(20).cloned().collect(),\n   118\t        }\n   119\t    }\n   120\t}\n   121\t\n   122\tfn safe_div(numerator: f64, denominator: f64) -> f64 {\n   123\t    if denominator <= f64::EPSILON {\n   124\t        0.0\n   125\t    } else {\n   126\t        numerator / denominator\n   127\t    }\n   128\t}\n","exit_code":0,"status":"completed"}}
