elf.phosphate_mg_p_per_l),\n    43\t            (\"dic_mg_c_per_l\", self.dic_mg_c_per_l),\n    44\t            (\"doc_mg_c_per_l\", self.doc_mg_c_per_l),\n    45\t            (\"don_mg_n_per_l\", self.don_mg_n_per_l),\n    46\t            (\"alkalinity_meq_per_l\", self.alkalinity_meq_per_l),\n    47\t            (\"calcium_mg_per_l\", self.calcium_mg_per_l),\n    48\t            (\"magnesium_mg_per_l\", self.magnesium_mg_per_l),\n    49\t            (\"sodium_mg_per_l\", self.sodium_mg_per_l),\n    50\t            (\"potassium_mg_per_l\", self.potassium_mg_per_l),\n    51\t            (\"bicarbonate_mg_per_l\", self.bicarbonate_mg_per_l),\n    52\t            (\"chloride_mg_per_l\", self.chloride_mg_per_l),\n    53\t            (\"sulfate_mg_per_l\", self.sulfate_mg_per_l),\n    54\t        ];\n    55\t        for (name, value) in fields {\n    56\t            if !value.is_finite() {\n    57\t                return Err(format!(\"field `{name}` must be finite, got {value}\"));\n    58\t            }\n    59\t            if *value < 0.0 {\n    60\t                return Err(format!(\"field `{name}` must be non-negative, got {value}\"));\n    61\t            }\n    62\t        }\n    63\t        Ok(())\n    64\t    }\n    65\t}\n    66\t\n    67\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    68\tpub struct SubstratePreset {\n    69\t    pub id: String,\n    70\t    pub name: String,\n    71\t    pub depth_cm: f64,\n    72\t    pub cation_exchange_capacity_index: f64,\n    73\t    pub detritus_trapping_index: f64,\n    74\t    pub colonizable_area_factor: f64,\n    75\t    pub low_oxygen_tendency_index: f64,\n    76\t    pub grazing_surface_index: f64,\n    77\t    pub nutrient_charge_mg_n_total: f64,\n    78\t    pub nutrient_charge_mg_p_total: f64,\n    79\t    pub provenance: Option<Provenance>,\n    80\t}\n    81\t\n    82\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    83\tpub struct PlantPreset {\n    84\t    pub id: String,\n    85\t    pub name: String,\n    86\t    pub guild: String,\n    87\t    pub growth_rate_index: f64,\n    88\t    pub water_column_uptake_bias: f64,\n    89\t    pub substrate_uptake_bias: f64,\n    90\t    pub provenance: Option<Provenance>,\n    91\t}\n    92\t\n    93\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    94\tpub struct ShrimpPreset {\n    95\t    pub id: String,\n    96\t    pub name: String,\n    97\t    pub species: String,\n    98\t    pub optimal_temp_min_c: f64,\n    99\t    pub optimal_temp_max_c: f64,\n   100\t    pub gh_min_d: f64,\n   101\t    pub gh_max_d: f64,\n   102\t    #[serde(default = \"default_shrimp_base_spawn_rate\")]\n   103\t    pub base_spawn_rate: f64,\n   104\t    #[serde(default = \"default_shrimp_egg_duration_days\")]\n   105\t    pub egg_duration_days: u32,\n   106\t    #[serde(default = \"default_shrimp_hatch_success_base\")]\n   107\t    pub hatch_success_base: f64,\n   108\t    #[serde(default = \"default_shrimp_juvenile_sensitivity\")]\n   109\t    pub juvenile_sensitivity: f64,\n   110\t    #[serde(default = \"default_shrimp_high_temp_repro_penalty_start\")]\n   111\t    pub high_temp_repro_penalty_start_c: f64,\n   112\t    #[serde(default = \"default_shrimp_high_temp_repro_penalty_full\")]\n   113\t    pub high_temp_repro_penalty_full_c: f64,\n   114\t    pub provenance: Option<Provenance>,\n   115\t}\n   116\t\n   117\timpl ShrimpPreset {\n   118\t    /// Validates that all shrimp species parameters are finite, non-negative,\n   119\t    /// and logically consistent.\n   120\t    pub fn validate(&self) -> Result<(), String> {\n   121\t        let fields: &[(&str, f64)] = &[\n   122\t            (\"optimal_temp_min_c\", self.optimal_temp_min_c),\n   123\t            (\"optimal_temp_max_c\", self.optimal_temp_max_c),\n   124\t            (\"gh_min_d\", self.gh_min_d),\n   125\t            (\"gh_max_d\", self.gh_max_d),\n   126\t            (\"base_spawn_rate\", self.base_spawn_rate),\n   127\t            (\"hatch_success_base\", self.hatch_success_base),\n   128\t            (\"juvenile_sensitivity\", self.juvenile_sensitivity),\n   129\t            (\n   130\t                \"high_temp_repro_penalty_start_c\",\n   131\t                self.high_temp_repro_penalty_start_c,\n   132\t            ),\n   133\t            (\n   134\t                \"high_temp_repro_penalty_full_c\",\n   135\t                self.high_temp_repro_penalty_full_c,\n   136\t            ),\n   137\t        ];\n   138\t        for (name, value) in fields {\n   139\t            if !value.is_finite() {\n   140\t                return Err(format!(\"field `{name}` must be finite, got {value}\"));\n   141\t            }\n   142\t            if *value < 0.0 {\n   143\t                return Err(format!(\"field `{name}` must be non-negative, got {value}\"));\n   144\t            }\n   145\t        }\n   146\t        if self.egg_duration_days == 0 {\n   147\t            return Err(\"egg_duration_days must be > 0\".to_string());\n   148\t        }\n   149\t        if self.optimal_temp_min_c >= self.optimal_temp_max_c {\n   150\t            return Err(format!(\n   151\t                \"optimal_temp_min_c ({}) must be < optimal_temp_max_c ({})\",\n   152\t                self.optimal_temp_min_c, self.optimal_temp_max_c\n   153\t            ));\n   154\t        }\n   155\t        if self.gh_min_d >= self.gh_max_d {\n   156\t            return Err(format!(\n   157\t                \"gh_min_d ({}) must be < gh_max_d ({})\",\n   158\t                self.gh_min_d, self.gh_max_d\n   159\t            ));\n   160\t        }\n   161\t        if self.high_temp_repro_penalty_start_c >= self.high_temp_repro_penalty_full_c {\n   162\t            return Err(format!(\n   163\t                \"high_temp_repro_penalty_start_c ({}) must be < high_temp_repro_penalty_full_c ({})\",\n   164\t                self.high_temp_repro_penalty_start_c, self.high_temp_repro_penalty_full_c\n   165\t            ));\n   166\t        }\n   167\t        if self.base_spawn_rate > 1.0 {\n   168\t            return Err(format!(\n   169\t                \"base_spawn_rate must be <= 1.0, got {}\",\n   170\t                self.base_spawn_rate\n   171\t            ));\n   172\t        }\n   173\t        if self.hatch_success_base > 1.0 {\n   174\t            return Err(format!(\n   175\t                \"hatch_success_base must be <= 1.0, got {}\",\n   176\t                self.hatch_success_base\n   177\t            ));\n   178\t        }\n   179\t        Ok(())\n   180\t    }\n   181\t}\n   182\t\n   183\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n   184\tpub struct ProcessParamsPreset {\n   185\t    pub id: String,\n   186\t    pub name: String,\n   187\t    pub mineralization_rate_per_day: f64,\n   188\t    pub nitrification_vmax: f64,\n   189\t    pub reaeration_kla_base: f64,\n   190\t    pub aeration_kla_boost: f64,\n   191\t    pub background_bod_mg_o2_per_g_biomass_per_hour: f64,\n   192\t    pub plant_photosynthesis_o2_mg_per_g_per_hour: f64,\n   193\t    pub respiration_dic_rate_mg_c_per_g_per_hour: f64,\n   194\t    pub photosynthesis_dic_rate_mg_c_per_g_per_hour: f64,\n   195\t    pub k_surface_w_per_m2_k: f64,\n   196\t    pub k_wall_w_per_m2_k: f64,\n   197\t\n   198\t    // Nitrogen cycle: feed leaching\n   199\t    #[serde(default = \"default_feed_leach_rate\")]\n   200\t    pub feed_leach_rate_per_hour: f64,\n   201\t    #[serde(default = \"default_fine_detritus_dissolution_rate\")]\n   202\t    pub fine_detritus_dissolution_rate_per_hour: f64,\n   203\t    #[serde(default = \"default_feed_n_to_c_ratio\")]\n   204\t    pub feed_n_to_c_ratio: f64,\n   205\t\n   206\t    // Decomposer mineralization\n   207\t    #[serde(default = \"default_decomposer_vmax\")]\n   208\t    pub decomposer_vmax_per_hour: f64,\n   209\t    #[serde(default = \"default_decomposer_k_doc\")]\n   210\t    pub decomposer_k_doc_mg: f64,\n   211\t    #[serde(default = \"default_decomposer_grow