{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/src/types/state.rs | sed -n '1,320p'\"","aggregated_output":"     1\tuse std::collections::BTreeMap;\n     2\t\n     3\tuse serde::{Deserialize, Serialize};\n     4\t\n     5\tuse crate::rng::{SimRng, SimSeed};\n     6\t\n     7\tuse super::{\n     8\t    AlgaeState, AnimalState, DetritusState, EnvironmentState, FilterState, HardwareState,\n     9\t    MicrobeState, MicrofaunaState, PlantGuild, PlantGuildState, ProcessParams, ShrimpRuntimeParams,\n    10\t    SimEvent, SourceWaterProfile, StabilityTracker, SubstrateKind, SubstrateLayerState,\n    11\t    TankGeometry, WaterState,\n    12\t};\n    13\t\n    14\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]\n    15\tpub struct SimMeta {\n    16\t    pub scenario_id: Option<String>,\n    17\t    pub notes: Option<String>,\n    18\t}\n    19\t\n    20\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    21\tpub struct TankState {\n    22\t    pub meta: SimMeta,\n    23\t    pub geometry: TankGeometry,\n    24\t    pub environment: EnvironmentState,\n    25\t    pub hardware: HardwareState,\n    26\t    pub water: WaterState,\n    27\t    pub substrate_layers: Vec<SubstrateLayerState>,\n    28\t    pub filter_state: FilterState,\n    29\t    pub plant_guilds: Vec<PlantGuildState>,\n    30\t    pub algae: AlgaeState,\n    31\t    pub microbe: MicrobeState,\n    32\t    pub microfauna: MicrofaunaState,\n    33\t    pub animal: AnimalState,\n    34\t    pub detritus: DetritusState,\n    35\t    pub event_log: Vec<SimEvent>,\n    36\t    #[serde(default)]\n    37\t    pub last_event_day: BTreeMap<String, u32>,\n    38\t    pub rng: SimRng,\n    39\t    /// Runtime-resolved source-water catalog keyed by preset id.\n    40\t    pub source_water_catalog: BTreeMap<String, SourceWaterProfile>,\n    41\t    /// Runtime-resolved process parameters for heat transfer and chemistry systems.\n    42\t    pub process_params: ProcessParams,\n    43\t    /// Materialized shrimp species parameters for deterministic save/load.\n    44\t    #[serde(default)]\n    45\t    pub shrimp_params: ShrimpRuntimeParams,\n    46\t    /// Tracks recent chemistry swings for shrimp stress.\n    47\t    #[serde(default)]\n    48\t    pub stability_tracker: StabilityTracker,\n    49\t}\n    50\t\n    51\timpl TankState {\n    52\t    pub fn new(seed: SimSeed) -> Self {\n    53\t        let geometry = TankGeometry::default();\n    54\t        Self {\n    55\t            meta: SimMeta::default(),\n    56\t            geometry: geometry.clone(),\n    57\t            environment: EnvironmentState::default(),\n    58\t            hardware: HardwareState::default(),\n    59\t            water: WaterState::default_for_geometry(&geometry),\n    60\t            substrate_layers: vec![SubstrateLayerState::default()],\n    61\t            filter_state: FilterState::default(),\n    62\t            plant_guilds: vec![\n    63\t                PlantGuildState::default(),\n    64\t                PlantGuildState {\n    65\t                    guild: PlantGuild::RootFeedingRosette,\n    66\t                    biomass_g: 3.0,\n    67\t                    health_index: 0.8,\n    68\t                    crowding_index: 0.1,\n    69\t                    habitat_index: 0.7,\n    70\t                },\n    71\t            ],\n    72\t            algae: AlgaeState::default(),\n    73\t            microbe: MicrobeState::default(),\n    74\t            microfauna: MicrofaunaState::default(),\n    75\t            animal: AnimalState::default(),\n    76\t            detritus: DetritusState::default(),\n    77\t            event_log: Vec::new(),\n    78\t            last_event_day: BTreeMap::new(),\n    79\t            rng: SimRng::new(seed),\n    80\t            source_water_catalog: BTreeMap::new(),\n    81\t            process_params: ProcessParams::default(),\n    82\t            shrimp_params: ShrimpRuntimeParams::default(),\n    83\t            stability_tracker: StabilityTracker::default(),\n    84\t        }\n    85\t    }\n    86\t\n    87\t    pub fn seeded_example(seed: SimSeed) -> Self {\n    88\t        let mut state = Self::new(seed);\n    89\t        state.meta.scenario_id = Some(\"seeded_example\".to_string());\n    90\t        state.substrate_layers = vec![\n    91\t            SubstrateLayerState {\n    92\t                kind: SubstrateKind::ActivePlanted,\n    93\t                depth_cm: 2.0,\n    94\t                nutrient_store_mg_n_total: 40.0,\n    95\t                nutrient_store_mg_p_total: 10.0,\n    96\t                cation_exchange_capacity_index: 0.8,\n    97\t                detritus_trapping_index: 0.4,\n    98\t                colonizable_area_cm2: 400.0,\n    99\t                low_oxygen_tendency_index: 0.5,\n   100\t                grazing_surface_index: 0.5,\n   101\t            },\n   102\t            SubstrateLayerState {\n   103\t                kind: SubstrateKind::CoarsePorous,\n   104\t                depth_cm: 1.0,\n   105\t                nutrient_store_mg_n_total: 5.0,\n   106\t                nutrient_store_mg_p_total: 1.0,\n   107\t                cation_exchange_capacity_index: 0.2,\n   108\t                detritus_trapping_index: 0.6,\n   109\t                colonizable_area_cm2: 250.0,\n   110\t                low_oxygen_tendency_index: 0.6,\n   111\t                grazing_surface_index: 0.7,\n   112\t            },\n   113\t        ];\n   114\t        state\n   115\t    }\n   116\t}\n   117\t\n   118\timpl Default for SimMeta {\n   119\t    fn default() -> Self {\n   120\t        Self {\n   121\t            scenario_id: None,\n   122\t            notes: None,\n   123\t        }\n   124\t    }\n   125\t}\n   126\t\n   127\timpl Default for TankState {\n   128\t    fn default() -> Self {\n   129\t        Self::new(SimSeed(0))\n   130\t    }\n   131\t}\n","exit_code":0,