{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/src/systems/microfauna.rs | sed -n '1,260p'\"","aggregated_output":"     1\tuse crate::types::TankState;\n     2\t\n     3\t/// Daily microfauna turnover: updates population_index and grazing_pressure_index\n     4\t/// from detritus/periphyton resource availability and shrimp grazing pressure.\n     5\t///\n     6\t/// Microfauna effects:\n     7\t/// - Modestly improves mineralization efficiency (applied in nitrogen_cycle)\n     8\t/// - Consumes some periphyton/bacterial resource\n     9\t/// - Declines under heavy shrimp grazing\n    10\tpub fn step_daily_microfauna(state: &mut TankState) {\n    11\t    let volume_l = state.geometry.water_volume_l();\n    12\t    if volume_l <= f64::EPSILON {\n    13\t        return;\n    14\t    }\n    15\t\n    16\t    let pp = &state.process_params;\n    17\t\n    18\t    // Resource availability (detritus + periphyton as food for microfauna)\n    19\t    // Reference densities are generous so microfauna don't over-respond to\n    20\t    // short-term feeding pulses.\n    21\t    let detritus_density = state.detritus.fine_detritus_g_total / volume_l;\n    22\t    let detritus_resource = (detritus_density / 2.0).clamp(0.0, 1.0);\n    23\t    let periphyton_density = state.algae.periphyton_biomass_g / volume_l;\n    24\t    let periphyton_resource = (periphyton_density / 1.0).clamp(0.0, 1.0);\n    25\t    let resource_availability =\n    26\t        (0.5 * detritus_resource + 0.5 * periphyton_resource).clamp(0.0, 1.0);\n    27\t\n    28\t    // Shrimp grazing pressure on microfauna\n    29\t    let total_shrimp = (state.animal.adults_count + state.animal.juveniles_count) as f64;\n    30\t    let shrimp_density = total_shrimp / volume_l;\n    31\t    let shrimp_pressure =\n    32\t        (shrimp_density / pp.microfauna_shrimp_pressure_threshold.max(0.01)).clamp(0.0, 1.0);\n    33\t\n    34\t    // Population target: grows with resources, declines with shrimp pressure\n    35\t    let growth_target = resource_availability * (1.0 - 0.6 * shrimp_pressure);\n    36\t    let smoothing = pp.microfauna_population_smoothing;\n    37\t    state.microfauna.population_index = (state.microfauna.population_index\n    38\t        + smoothing * (growth_target - state.microfauna.population_index))\n    39\t        .clamp(0.0, 1.0);\n    40\t\n    41\t    // Grazing pressure reflects population and available food\n    42\t    state.microfauna.grazing_pressure_index = (state.microfauna.population_index\n    43\t        * resource_availability.sqrt())\n    44\t    .clamp(0.0, 1.0);\n    45\t\n    46\t    // Microfauna consume some periphyton (without driving it negative)\n    47\t    let consumption_fraction =\n    48\t        pp.microfauna_periphyton_consumption * state.microfauna.population_index;\n    49\t    let consumed = state.algae.periphyton_biomass_g * consumption_fraction;\n    50\t    state.algae.periphyton_biomass_g = (state.algae.periphyton_biomass_g - consumed).max(0.0);\n    51\t\n    52\t    // Microfauna also process some fine detritus (modest)\n    53\t    let detritus_consumed =\n    54\t        state.detritus.fine_detritus_g_total * 0.01 * state.microfauna.population_index;\n    55\t    state.detritus.fine_detritus_g_total =\n    56\t        (state.detritus.fine_detritus_g_total - detritus_consumed).max(0.0);\n    57\t}\n","exit_code":0,"status":"completed"}}
