{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/src/systems/nitrogen_cycle.rs | sed -n '1,320p'\"","aggregated_output":"     1\tuse crate::types::TankState;\n     2\t\n     3\t/// Result of one hourly nitrogen cycle step, carrying coupling values\n     4\t/// that downstream systems (DO, chemistry) need.\n     5\t#[derive(Debug, Clone, Copy, Default)]\n     6\tpub struct NitrogenCycleOutput {\n     7\t    /// Total mg N oxidized to nitrate this tick (AOB + NOB + comammox pathway).\n     8\t    pub total_mg_n_nitrified: f64,\n     9\t}\n    10\t\n    11\t/// Monod-style environmental factors shared across guilds.\n    12\tstruct EnvFactors {\n    13\t    f_temp: f64,\n    14\t    f_ph: f64,\n    15\t    maturity_factor: f64,\n    16\t    /// Dirty-filter penalty: 1.0 = clean, lower = clogged/dirty.\n    17\t    dirty_filter_factor: f64,\n    18\t}\n    19\t\n    20\tfn safe_rate(v: f64) -> f64 {\n    21\t    if v.is_finite() { v.max(0.0) } else { 0.0 }\n    22\t}\n    23\t\n    24\t/// Runs the full nitrogen-cycle phase for one hourly tick.\n    25\t///\n    26\t/// Order: feed leaching -> detritus breakdown/mineralization -> nitrification + guild growth/decay.\n    27\t///\n    28\t/// Returns coupling values for downstream DO and alkalinity systems.\n    29\tpub fn step_nitrogen_cycle(state: &mut TankState) -> NitrogenCycleOutput {\n    30\t    let volume_l = state.geometry.water_volume_l();\n    31\t    if volume_l <= f64::EPSILON {\n    32\t        return NitrogenCycleOutput::default();\n    33\t    }\n    34\t\n    35\t    let pp = &state.process_params;\n    36\t\n    37\t    // ---- 1. Feed leaching: particulate -> fine detritus ----\n    38\t    let leach_rate = safe_rate(pp.feed_leach_rate_per_hour);\n    39\t    let leached = (state.detritus.particulate_organics_g_total * leach_rate)\n    40\t        .min(state.detritus.particulate_organics_g_total);\n    41\t    state.detritus.particulate_organics_g_total -= leached;\n    42\t    state.detritus.fine_detritus_g_total += leached;\n    43\t\n    44\t    // ---- 2. Fine detritus dissolution: fine detritus -> dissolved organic pools ----\n    45\t    let diss_rate = safe_rate(pp.fine_detritus_dissolution_rate_per_hour);\n    46\t    let dissolved = (state.detritus.fine_detritus_g_total * diss_rate)\n    47\t        .min(state.detritus.fine_detritus_g_total);\n    48\t    state.detritus.fine_detritus_g_total -= dissolved;\n    49\t    // dissolved mass (g) -> mg for dissolved pools: 1 g = 1000 mg\n    50\t    // Split into DOC and DON using N:C ratio\n    51\t    let n_to_c = safe_rate(pp.feed_n_to_c_ratio);\n    52\t    let doc_mg = dissolved * 1000.0 / (1.0 + n_to_c); // carbon fraction\n    53\t    let don_mg = doc_mg * n_to_c; // nitrogen fraction\n    54\t    state.water.dissolved_organic_carbon_mg_c_total += doc_mg;\n    55\t    state.water.dissolved_organic_nitrogen_mg_n_total += don_mg;\n    56\t    // Track flow through dissolved_feed_residue (bookkeeping, decremented by mineralization)\n    57\t    state.detritus.dissolved_feed_residue_g_total += dissolved;\n    58\t\n    59\t    // ---- 3. Decomposer mineralization: DOC/DON -> TAN ----\n    60\t    let decomposer_biomass = state.microbe.decomposer_biomass_g;\n    61\t    let doc_total = state.water.dissolved_organic_carbon_mg_c_total;\n    62\t    let don_total = state.water.dissolved_organic_nitrogen_mg_n_total;\n    63\t    let do_total = state.water.dissolved_oxygen_mg_total;\n    64\t\n    65\t    // Environmental factors for decomposers\n    66\t    let temp = state.water.temperature_c;\n    67\t    let f_temp_decomp = temperature_factor(temp);\n    68\t    let f_do_decomp = do_total / (do_total + 2.0); // half-sat ~2 mg total\n    69\t\n    70\t    // Microfauna modestly improve mineralization efficiency\n    71\t    let microfauna_boost =\n    72\t        1.0 + pp.microfauna_mineralization_boost * state.microfauna.population_index;\n    73\t    let decomp_vmax = safe_rate(pp.decomposer_vmax_per_hour) * microfauna_boost;\n    74\t    let k_doc = pp.decomposer_k_doc_mg.max(0.01);\n    75\t    let monod_doc = doc_total / (doc_total + k_doc);\n    76\t\n    77\t    let potential_doc_consumed_mg = decomp_vmax * decomposer_biomass * 1000.0 // g->mg conversion for biomass effect\n    78\t        * f_temp_decomp * f_do_decomp * monod_doc;\n    79\t    let potential_doc_consumed_mg = safe_rate(potential_doc_consumed_mg);\n    80\t\n    81\t    // Clamp: cannot consume more DOC than exists\n    82\t    let doc_consumed_mg = potential_doc_consumed_mg.min(doc_total);\n    83\t    // Proportional DON consumed\n    84\t    let don_consumed_mg = if doc_total > f64::EPSILON {\n    85\t        doc_consumed_mg * (don_total / doc_total)\n    86\t    } else {\n    87\t        0.0\n    88\t    };\n    89\t    let don_consumed_mg = don_consumed_mg.min(don_total);\n    90\t\n    91\t    state.water.dissolved_organic_carbon_mg_c_total -= doc_consumed_mg;\n    92\t    state.water.dissolved_organic_nitrogen_mg_n_total -= don_consumed_mg;\n    93\t    // Mineralized DON becomes TAN\n    94\t    state.water.ammonia_total_mg_n_total += don_consumed_mg;\n    95\t    // Track residue pool depletion\n    96\t    let residue_consumed_g = doc_consumed_mg / 1000.0 * (1.0 + n_to_c);\n    97\t    state.detritus.dissolved_feed_residue_g_total =\n    98\t        (state.detritus.dissolved_feed_residue_g_total - residue_consumed_g).max(0.0);\n    99\t\n   100\t    // Decomposer growth/decay\n   101\t    let decomp_growth = safe_rate(pp.decomposer_growth_yield) * doc_consumed_mg / 1000.0; // mg->g\n   102\t    let decomp_decay = safe_rate(pp.decomposer_decay_rate_per_hour) * decomposer_biomass;\n   103\t    state.microbe.decomposer_biomass_g =\n   104\t        (state.microbe.decomposer_biomass_g + decomp_growth - decomp_decay).max(0.0);\n   105\t\n   106\t    // ---- 4. Nitrification: TAN -> nitrite -> nitrate (+ comammox TAN -> nitrate) ----\n   107\t    //\n   108\t    // Shared DO and alkalinity budgets enforce that combined nitrification\n   109\t    // can never consume more O2 or alkalinity than available this tick.\n   110\t    let env = compute_env_factors(state);\n   111\t    let combined_env = env.maturity_factor * env.dirty_filter_factor;\n   112\t\n   113\t    let mut do_budget = state.water.dissolved_oxygen_mg_total;\n   114\t    let alk_per_mg_n = safe_rate(pp.alkalinity_meq_per_mg_n_nitrified);\n   115\t    let mut alk_budget = state.water.alkalinity_meq_total;\n   116\t\n   117\t    // Stoichiometric O2 costs per mg N for each guild step\n   118\t    let o2_for_aob = 3.43_f64; // TAN -> nitrite\n   119\t    let o2_for_comammox = pp.o2_per_mg_n_nitrified; // TAN -> nitrate (4.57)\n   120\t    let o2_for_nob = 1.14_f64; // nitrite -> nitrate\n   121\t\n   122\t    // 4a. AOB: TAN -> nitrite\n   123\t    let aob_potential = monod_rate(\n   124\t        safe_rate(pp.aob_vmax_mg_n_per_g_per_hour),\n   125\t        state.microbe.ammonia_oxidizer_biomass_g,\n   126\t        combined_env,\n   127\t        env.f_temp,\n   128\t        env.f_ph,\n   129\t        do_budget / (do_budget + pp.aob_k_do_mg.max(0.01)),\n   130\t        state.water.ammonia_total_mg_n_total,\n   131\t        pp.aob_k_tan_mg.max(0.01),\n   132\t    );\n   133\t    let aob_rate = safe_rate(aob_potential)\n   134\t        .min(state.water.ammonia_total_mg_n_total)\n   135\t        .min(if o2_for_aob > 0.0 { do_budget / o2_for_aob } else { f64::MAX })\n   136\t        .min(if alk_per_mg_n > 0.0 { alk_budget / alk_per_mg_n } else { f64::MAX });\n   137\t\n   138\t    // Debit shared budgets for AOB\n   139\t    let aob_o2_cost = aob_rate * o2_for_aob;\n   140\t    let aob_alk_cost = aob_rate * alk_per_mg_n;\n   141\t    do_budget = (do_budget - aob_o2_cost).max(0.0);\n   142\t    alk_budget = (alk_budget - aob_alk_cost).max(0.0);\n   143\t\n   144\t    // 4b. Comammox: TAN -> nitrate directly (lower vmax)\n   145\t    let comammox_vmax = safe_rate(pp.aob_vmax_mg_n_per_g_per_hour * pp.comammox_vmax_fraction);\n   146\t    let tan_after_aob = (state.water.ammonia_total_mg_n_total - aob_rate).max(0.0);\n   147\t    let comammox_potential = monod_rate(\n   148\t        comammox_vmax,\n   149\t        state.microbe.comammox_biomass_g,\n   150\t        combined_env,\n   151\t        env.f_temp,\n   152\t        env.f_ph,\n   153\t        do_budget / (do_budget + pp.comammox_k_do_mg.max(0.01)),\n   154\t        tan_after_aob,\n   155\t        pp.comammox_k_tan_mg.max(0.01),\n   156\t    );\n   157\t    let comammox_rate = safe_rate(comammox_potential)\n   158\t        .min(tan_after_aob)\n   159\t        .min(if o2_for_comammox > 0.0 { do_budget / o2_for_comammox } else { f64::MAX })\n   160\t        .min(if alk_per_mg_n > 0.0 { alk_budget / alk_per_mg_n } else { f64::MAX });\n   161\t\n   162\t    // Debit shared budgets for comammox\n   163\t    let comammox_o2_cost = comammox_rate * o2_for_comammox;\n   164\t    let comammox_alk_cost = comammox_rate * alk_per_mg_n;\n   165\t    do_budget = (do_budget - comammox_o2_cost).max(0.0);\n   166\t    alk_budget = (alk_budget - comammox_alk_cost).max(0.0);\n   167\t\n   168\t    // Apply AOB + comammox TAN consumption\n   169\t    let total_tan_consumed = aob_rate + comammox_rate;\n   170\t    state.water.ammonia_total_mg_n_total =\n   171\t        (state.water.ammonia_total_mg_n_total - total_tan_consumed).max(0.0);\n   172\t    // AOB produces nitrite\n   173\t    state.water.nitrite_mg_n_total += aob_rate;\n   174\t    // Comammox produces nitrate directly\n   175\t    state.water.nitrate_mg_n_total += comammox_rate;\n   176\t\n   177\t    // Apply O2 costs so far (AOB + comammox) to state\n   178\t    state.water.dissolved_oxygen_mg_total =\n   179\t        (state.water.dissolved_oxygen_mg_total - aob_o2_cost - comammox_o2_cost).max(0.0);\n   180\t\n   181\t    // 4c. NOB: nitrite -> nitrate (uses remaining DO/alk budget)\n   182\t    let nob_potential = monod_rate(\n   183\t        safe_rate(pp.nob_vmax_mg_n_per_g_per_hour),\n   184\t        state.microbe.nitrite_oxidizer_biomass_g,\n   185\t        combined_env,\n   186\t        env.f_temp,\n   187\t        env.f_ph,\n   188\t        do_budget / (do_budget + pp.nob_k_do_mg.max(0.01)),\n   189\t        state.water.nitrite_mg_n_total,\n   190\t        pp.nob_k_nitrite_mg.max(0.01),\n   191\t    );\n   192\t    let nob_rate = safe_rate(nob_potential)\n   193\t        .min(state.water.nitrite_mg_n_total)\n   194\t        .min(if o2_for_nob > 0.0 { do_budget / o2_for_nob } else { f64::MAX })\n   195\t        .min(if alk_per_mg_n > 0.0 { alk_budget / alk_per_mg_n } else { f64::MAX });\n   196\t\n   197\t    let nob_o2_cost = nob_rate * o2_for_nob;\n   198\t\n   199\t    state.water.nitrite_mg_n_total = (state.water.nitrite_mg_n_total - nob_rate).max(0.0);\n   200\t    state.water.nitrate_mg_n_total += nob_rate;\n   201\t    state.water.dissolved_oxygen_mg_total =\n   202\t        (state.water.dissolved_oxygen_mg_total - nob_o2_cost).max(0.0);\n   203\t\n   204\t    // Total N fully nitrified to nitrate (for alkalinity coupling)\n   205\t    // AOB only takes TAN -> nitrite, NOB takes nitrite -> nitrate, comammox takes TAN -> nitrate\n   206\t    // Full pathway N: nob_rate (came from AOB path) + comammox_rate\n   207\t    let total_mg_n_nitrified = nob_rate + comammox_rate;\n   208\t\n   209\t    // ---- 5. Guild growth and decay ----\n   210\t    // AOB growth from TAN oxidized\n   211\t    let aob_growth = safe_rate(pp.aob_growth_yield) * aob_rate;\n   212\t    let aob_decay = safe_rate(pp.aob_decay_rate_per_hour) * state.microbe.ammonia_oxidizer_biomass_g;\n   213\t    state.microbe.ammonia_oxidizer_biomass_g =\n   214\t        (state.microbe.ammonia_oxidizer_biomass_g + aob_growth - aob_decay).max(0.0);\n   215\t\n   216\t    // NOB growth from nitrite oxidized\n   217\t    let nob_growth = safe_rate(pp.nob_growth_yield) * nob_rate;\n   218\t    let nob_decay = safe_rate(pp.nob_decay_rate_per_hour) * state.microbe.nitrite_oxidizer_biomass_g;\n   219\t    state.microbe.nitrite_oxidizer_biomass_g =\n   220\t        (state.microbe.nitrite_oxidizer_biomass_g + nob_growth - nob_decay).max(0.0);\n   221\t\n   222\t    // Comammox growth from TAN fully oxidized\n   223\t    let comammox_growth = safe_rate(pp.comammox_growth_yield) * comammox_rate;\n   224\t    let comammox_decay = safe_rate(pp.comammox_decay_rate_per_hour) * state.microbe.comammox_biomass_g;\n   225\t    state.microbe.comammox_biomass_g =\n   226\t        (state.microbe.comammox_biomass_g + comammox_growth - comammox_decay).max(0.0);\n   227\t\n   228\t    // ---- 6. Alkalinity consumption from nitrification ----\n   229\t    // AOB and comammox alkalinity was already tracked in the budget; apply the\n   230\t    // total consumption (AOB + comammox + NOB path) to state.\n   231\t    let total_alk_consumed = (aob_rate + comammox_rate + nob_rate) * alk_per_mg_n;\n   232\t    state.water.alkalinity_meq_total =\n   233\t        (state.water.alkalinity_meq_total - total_alk_consumed).max(0.0);\n   234\t\n   235\t    // Nitrification is a chemoautotrophic process that produces some DIC fixation\n   236\t    // but for simplicity we model it as a net DIC producer via mineralization pathway above.\n   237\t\n   238\t    NitrogenCycleOutput {\n   239\t        total_mg_n_nitrified,\n   240\t    }\n   241\t}\n   242\t\n   243\t/// Temperature factor: peaks around 25-30°C, drops off at extremes.\n   244\tfn temperature_factor(temp_c: f64) -> f64 {\n   245\t    // Bell-shaped factor peaking at 28°C with a half-width of ~10°C\n   246\t    let opt = 28.0;\n   247\t    let sigma = 10.0;\n   248\t    let diff = temp_c - opt;\n   249\t    (-(diff * diff) / (2.0 * sigma * sigma)).exp()\n   250\t}\n   251\t\n   252\t/// pH factor: nitrifiers prefer 7-8, reduced at extremes.\n   253\tfn ph_factor(ph: f64) -> f64 {\n   254\t    let opt = 7.5;\n   255\t    let sigma = 1.5;\n   256\t    let diff = ph - opt;\n   257\t    (-(diff * diff) / (2.0 * sigma * sigma)).exp()\n   258\t}\n   259\t\n   260\tfn compute_env_factors(state: &TankState) -> EnvFactors {\n   261\t    let f_temp = temperature_factor(state.water.temperature_c);\n   262\t    let f_ph = ph_factor(state.water.ph);\n   263\t\n   264\t    // Maturity factor: immature filters slow nitrification\n   265\t    let maturity_factor = state.filter_state.biofilter_maturity_index.clamp(0.05, 1.0);\n   266\t\n   267\t    // Dirty-filter factor: clogged filters reduce nitrification efficiency.\n   268\t    // clogging_index of 0 = clean (factor=1), clogging_index of 1 = fully clogged (factor=0.2)\n   269\t    let dirty_filter_factor = (1.0 - 0.8 * state.filter_state.clogging_index).clamp(0.2, 1.0);\n   270\t\n   271\t    EnvFactors {\n   272\t        f_temp,\n   273\t        f_ph,\n   274\t        maturity_factor,\n   275\t        dirty_filter_factor,\n   276\t    }\n   277\t}\n   278\t\n   279\t/// Monod-style rate: vmax * biomass * maturity * f_temp * f_ph * f_do_monod * S/(K+S)\n   280\tfn monod_rate(\n   281\t    vmax: f64,\n   282\t    biomass_g: f64,\n   283\t    maturity_factor: f64,\n   284\t    f_temp: f64,\n   285\t    f_ph: f64,\n   286\t    f_do_monod: f64,\n   287\t    substrate: f64,\n   288\t    k_substrate: f64,\n   289\t) -> f64 {\n   290\t    let monod = substrate / (substrate + k_substrate);\n   291\t    safe_rate(vmax * biomass_g * maturity_factor * f_temp * f_ph * f_do_monod * monod)\n   292\t}\n   293\t\n   294\t/// Daily biofilter maturity update. Called every 24 ticks.\n   295\t/// Recomputes `filter_state.biofilter_maturity_index` from guild biomass.\n   296\tpub fn update_daily_biofilter_maturity(state: &mut TankState) -> f64 {\n   297\t    let prev = state.filter_state.biofilter_maturity_index;\n   298\t\n   299\t    // Capacity reference: a \"mature\" biofilter might have ~0.5g total nitrifier biomass\n   300\t    let capacity_g = 0.5;\n   301\t    let total_nitrifier_g = state.microbe.ammonia_oxidizer_biomass_g\n   302\t        + state.microbe.nitrite_oxidizer_biomass_g\n   303\t        + state.microbe.comammox_biomass_g;\n   304\t    let raw_maturity = (total_nitrifier_g / capacity_g).clamp(0.0, 1.0);\n   305\t\n   306\t    // Smooth towards raw_maturity\n   307\t    let alpha = 0.1;\n   308\t    let new_maturity = (prev + alpha * (raw_maturity - prev)).clamp(0.0, 1.0);\n   309\t    state.filter_state.biofilter_maturity_index = new_maturity;\n   310\t\n   311\t    new_maturity - prev\n   312\t}\n","exit_code":0,"status":"completed"}}
