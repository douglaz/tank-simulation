{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/src/types/biology.rs | sed -n '1,360p'\"","aggregated_output":"     1\tuse serde::{Deserialize, Serialize};\n     2\t\n     3\tuse crate::types::substrate::SubstrateLayerState;\n     4\t\n     5\t/// A cohort of berried females that became berried on the same day.\n     6\t/// Separate cohorts ensure that only completed clutches resolve,\n     7\t/// preserving the clutch-resolution invariant.\n     8\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n     9\tpub struct EggCohort {\n    10\t    pub count: u32,\n    11\t    pub progress_days: f64,\n    12\t}\n    13\t\n    14\t#[derive(Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq)]\n    15\tpub enum PlantGuild {\n    16\t    FastStem,\n    17\t    RootFeedingRosette,\n    18\t}\n    19\t\n    20\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    21\tpub struct PlantGuildState {\n    22\t    pub guild: PlantGuild,\n    23\t    pub biomass_g: f64,\n    24\t    pub health_index: f64,\n    25\t    pub crowding_index: f64,\n    26\t    pub habitat_index: f64,\n    27\t}\n    28\t\n    29\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    30\tpub struct AlgaeState {\n    31\t    pub suspended_biomass_g: f64,\n    32\t    pub periphyton_biomass_g: f64,\n    33\t    pub nuisance_index: f64,\n    34\t}\n    35\t\n    36\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    37\tpub struct MicrobeState {\n    38\t    pub decomposer_biomass_g: f64,\n    39\t    pub ammonia_oxidizer_biomass_g: f64,\n    40\t    pub nitrite_oxidizer_biomass_g: f64,\n    41\t    pub comammox_biomass_g: f64,\n    42\t    pub maturity_index: f64,\n    43\t}\n    44\t\n    45\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    46\tpub struct MicrofaunaState {\n    47\t    pub population_index: f64,\n    48\t    pub grazing_pressure_index: f64,\n    49\t}\n    50\t\n    51\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    52\tpub struct AnimalState {\n    53\t    pub adults_count: u32,\n    54\t    pub juveniles_count: u32,\n    55\t    pub berried_females_count: u32,\n    56\t    pub condition_index: f64,\n    57\t    pub molt_stress_index: f64,\n    58\t    pub reproductive_readiness_index: f64,\n    59\t    pub egg_progress_days: f64,\n    60\t    /// Per-cohort egg tracking for clutch-resolution invariant.\n    61\t    #[serde(default)]\n    62\t    pub egg_cohorts: Vec<EggCohort>,\n    63\t    /// Hidden hourly stress accumulators, reset after daily processing.\n    64\t    #[serde(default)]\n    65\t    pub hourly_nh3_stress_accum: f64,\n    66\t    #[serde(default)]\n    67\t    pub hourly_nitrite_stress_accum: f64,\n    68\t    #[serde(default)]\n    69\t    pub hourly_low_do_stress_accum: f64,\n    70\t    #[serde(default)]\n    71\t    pub hourly_heat_stress_accum: f64,\n    72\t    #[serde(default)]\n    73\t    pub hourly_instability_stress_accum: f64,\n    74\t}\n    75\t\n    76\t/// Species-specific shrimp parameters materialized from ShrimpPreset.\n    77\t/// Stored in TankState for deterministic save/load.\n    78\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    79\tpub struct ShrimpRuntimeParams {\n    80\t    pub optimal_temp_min_c: f64,\n    81\t    pub optimal_temp_max_c: f64,\n    82\t    pub gh_min_d: f64,\n    83\t    pub gh_max_d: f64,\n    84\t    pub base_spawn_rate: f64,\n    85\t    pub egg_duration_days: u32,\n    86\t    pub hatch_success_base: f64,\n    87\t    pub juvenile_sensitivity: f64,\n    88\t    pub high_temp_repro_penalty_start_c: f64,\n    89\t    pub high_temp_repro_penalty_full_c: f64,\n    90\t}\n    91\t\n    92\t/// Tracks recent chemistry swings for shrimp stress calculations.\n    93\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    94\tpub struct StabilityTracker {\n    95\t    pub prev_temp_c: f64,\n    96\t    pub prev_ph: f64,\n    97\t    pub prev_gh_d: f64,\n    98\t    pub prev_do_mg_l: f64,\n    99\t    pub instability_index: f64,\n   100\t}\n   101\t\n   102\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n   103\tpub struct DetritusState {\n   104\t    pub particulate_organics_g_total: f64,\n   105\t    pub fine_detritus_g_total: f64,\n   106\t    pub dissolved_feed_residue_g_total: f64,\n   107\t}\n   108\t\n   109\timpl Default for PlantGuildState {\n   110\t    fn default() -> Self {\n   111\t        Self {\n   112\t            guild: PlantGuild::FastStem,\n   113\t            biomass_g: 5.0,\n   114\t            health_index: 0.8,\n   115\t            crowding_index: 0.1,\n   116\t            habitat_index: 0.8,\n   117\t        }\n   118\t    }\n   119\t}\n   120\t\n   121\timpl Default for AlgaeState {\n   122\t    fn default() -> Self {\n   123\t        Self {\n   124\t            suspended_biomass_g: 0.0,\n   125\t            periphyton_biomass_g: 0.2,\n   126\t            nuisance_index: 0.1,\n   127\t        }\n   128\t    }\n   129\t}\n   130\t\n   131\timpl Default for MicrobeState {\n   132\t    fn default() -> Self {\n   133\t        Self {\n   134\t            decomposer_biomass_g: 0.1,\n   135\t            ammonia_oxidizer_biomass_g: 0.05,\n   136\t            nitrite_oxidizer_biomass_g: 0.05,\n   137\t            comammox_biomass_g: 0.01,\n   138\t            maturity_index: 0.1,\n   139\t        }\n   140\t    }\n   141\t}\n   142\t\n   143\timpl Default for MicrofaunaState {\n   144\t    fn default() -> Self {\n   145\t        Self {\n   146\t            population_index: 0.2,\n   147\t            grazing_pressure_index: 0.2,\n   148\t        }\n   149\t    }\n   150\t}\n   151\t\n   152\timpl Default for AnimalState {\n   153\t    fn default() -> Self {\n   154\t        Self {\n   155\t            adults_count: 0,\n   156\t            juveniles_count: 0,\n   157\t            berried_females_count: 0,\n   158\t            condition_index: 0.8,\n   159\t            molt_stress_index: 0.1,\n   160\t            reproductive_readiness_index: 0.4,\n   161\t            egg_progress_days: 0.0,\n   162\t            egg_cohorts: Vec::new(),\n   163\t            hourly_nh3_stress_accum: 0.0,\n   164\t            hourly_nitrite_stress_accum: 0.0,\n   165\t            hourly_low_do_stress_accum: 0.0,\n   166\t            hourly_heat_stress_accum: 0.0,\n   167\t            hourly_instability_stress_accum: 0.0,\n   168\t        }\n   169\t    }\n   170\t}\n   171\t\n   172\timpl Default for ShrimpRuntimeParams {\n   173\t    fn default() -> Self {\n   174\t        Self {\n   175\t            optimal_temp_min_c: 22.0,\n   176\t            optimal_temp_max_c: 26.0,\n   177\t            gh_min_d: 5.0,\n   178\t            gh_max_d: 10.0,\n   179\t            base_spawn_rate: 0.15,\n   180\t            egg_duration_days: 21,\n   181\t            hatch_success_base: 0.7,\n   182\t            juvenile_sensitivity: 1.5,\n   183\t            high_temp_repro_penalty_start_c: 28.0,\n   184\t            high_temp_repro_penalty_full_c: 33.0,\n   185\t        }\n   186\t    }\n   187\t}\n   188\t\n   189\timpl Default for StabilityTracker {\n   190\t    fn default() -> Self {\n   191\t        Self {\n   192\t            prev_temp_c: 25.0,\n   193\t            prev_ph: 7.0,\n   194\t            prev_gh_d: 7.0,\n   195\t            prev_do_mg_l: 8.0,\n   196\t            instability_index: 0.0,\n   197\t        }\n   198\t    }\n   199\t}\n   200\t\n   201\timpl Default for DetritusState {\n   202\t    fn default() -> Self {\n   203\t        Self {\n   204\t            particulate_organics_g_total: 0.0,\n   205\t            fine_detritus_g_total: 0.0,\n   206\t            dissolved_feed_residue_g_total: 0.0,\n   207\t        }\n   208\t    }\n   209\t}\n   210\t\n   211\timpl PlantGuildState {\n   212\t    pub fn water_column_uptake_bias(&self) -> f64 {\n   213\t        match self.guild {\n   214\t            PlantGuild::FastStem => 0.9,\n   215\t            PlantGuild::RootFeedingRosette => 0.1,\n   216\t        }\n   217\t    }\n   218\t\n   219\t    pub fn substrate_uptake_bias(&self) -> f64 {\n   220\t        match self.guild {\n   221\t            PlantGuild::FastStem => 0.1,\n   222\t            PlantGuild::RootFeedingRosette => 0.9,\n   223\t        }\n   224\t    }\n   225\t}\n   226\t\n   227\timpl AnimalState {\n   228\t    /// Ensures `berried_females_count <= adults_count` by trimming\n   229\t    /// excess from the newest egg cohorts first.\n   230\t    pub fn clamp_berried_to_adults(&mut self) {\n   231\t        if self.berried_females_count > self.adults_count {\n   232\t            let excess = self.berried_females_count - self.adults_count;\n   233\t            self.berried_females_count = self.adults_count;\n   234\t            trim_egg_cohorts(&mut self.egg_cohorts, excess);\n   235\t        }\n   236\t    }\n   237\t\n   238\t    /// Derives `egg_progress_days` from the most-advanced cohort for display.\n   239\t    pub fn sync_egg_progress_from_cohorts(&mut self) {\n   240\t        self.egg_progress_days = self\n   241\t            .egg_cohorts\n   242\t            .iter()\n   243\t            .map(|c| c.progress_days)\n   244\t            .fold(0.0_f64, f64::max);\n   245\t    }\n   246\t}\n   247\t\n   248\t/// Trims `to_remove` berried females from cohorts, starting from the newest (last).\n   249\tfn trim_egg_cohorts(cohorts: &mut Vec<EggCohort>, mut to_remove: u32) {\n   250\t    while to_remove > 0 && !cohorts.is_empty() {\n   251\t        let last = cohorts.last_mut().unwrap();\n   252\t        if last.count <= to_remove {\n   253\t            to_remove -= last.count;\n   254\t            cohorts.pop();\n   255\t        } else {\n   256\t            last.count -= to_remove;\n   257\t            to_remove = 0;\n   258\t        }\n   259\t    }\n   260\t}\n   261\t\n   262\tpub fn total_colonizable_area_cm2(\n   263\t    substrate_layers: &[SubstrateLayerState],\n   264\t    wall_area_cm2: f64,\n   265\t) -> f64 {\n   266\t    wall_area_cm2\n   267\t        + substrate_layers\n   268\t            .iter()\n   269\t            .map(|layer| layer.colonizable_area_cm2)\n   270\t            .sum::<f64>()\n   271\t}\n","exit_code":0,"status":"completed"}}
