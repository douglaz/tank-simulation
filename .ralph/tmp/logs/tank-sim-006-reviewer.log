elf.algae_temp_sigma_c),\n   659\t            (\n   660\t                \"periphyton_capacity_g_per_m2\",\n   661\t                self.periphyton_capacity_g_per_m2,\n   662\t            ),\n   663\t            (\n   664\t                \"algae_bloom_threshold_g_per_l\",\n   665\t                self.algae_bloom_threshold_g_per_l,\n   666\t            ),\n   667\t            (\n   668\t                \"algae_nuisance_biomass_g_per_m2\",\n   669\t                self.algae_nuisance_biomass_g_per_m2,\n   670\t            ),\n   671\t        ];\n   672\t        for (name, value) in fields {\n   673\t            if !value.is_finite() {\n   674\t                return Err(format!(\"field `{name}` must be finite, got {value}\"));\n   675\t            }\n   676\t            if *value < 0.0 {\n   677\t                return Err(format!(\"field `{name}` must be non-negative, got {value}\"));\n   678\t            }\n   679\t        }\n   680\t        // comammox_vmax_fraction must be <= 1.0 (spec requires lower vmax than AOB)\n   681\t        if self.comammox_vmax_fraction > 1.0 {\n   682\t            return Err(format!(\n   683\t                \"comammox_vmax_fraction must be <= 1.0, got {}\",\n   684\t                self.comammox_vmax_fraction\n   685\t            ));\n   686\t        }\n   687\t        // Validate shrimp dynamics fields\n   688\t        let shrimp_fields: &[(&str, f64)] = &[\n   689\t            (\n   690\t                \"shrimp_base_mortality_per_day\",\n   691\t                self.shrimp_base_mortality_per_day,\n   692\t            ),\n   693\t            (\n   694\t                \"shrimp_stress_mortality_scale\",\n   695\t                self.shrimp_stress_mortality_scale,\n   696\t            ),\n   697\t            (\n   698\t                \"shrimp_juvenile_maturation_days\",\n   699\t                self.shrimp_juvenile_maturation_days,\n   700\t            ),\n   701\t            (\n   702\t                \"shrimp_periphyton_grazing_g_per_shrimp_per_day\",\n   703\t                self.shrimp_periphyton_grazing_g_per_shrimp_per_day,\n   704\t            ),\n   705\t            (\n   706\t                \"shrimp_condition_smoothing\",\n   707\t                self.shrimp_condition_smoothing,\n   708\t            ),\n   709\t        ];\n   710\t        for (name, value) in shrimp_fields {\n   711\t            if !value.is_finite() {\n   712\t                return Err(format!(\"field `{name}` must be finite, got {value}\"));\n   713\t            }\n   714\t            if *value < 0.0 {\n   715\t                return Err(format!(\"field `{name}` must be non-negative, got {value}\"));\n   716\t            }\n   717\t        }\n   718\t        // Validate microfauna turnover fields\n   719\t        let microfauna_fields: &[(&str, f64)] = &[\n   720\t            (\n   721\t                \"microfauna_mineralization_boost\",\n   722\t                self.microfauna_mineralization_boost,\n   723\t            ),\n   724\t            (\n   725\t                \"microfauna_periphyton_consumption\",\n   726\t                self.microfauna_periphyton_consumption,\n   727\t            ),\n   728\t            (\n   729\t                \"microfauna_population_smoothing\",\n   730\t                self.microfauna_population_smoothing,\n   731\t            ),\n   732\t            (\n   733\t                \"microfauna_shrimp_pressure_threshold\",\n   734\t                self.microfauna_shrimp_pressure_threshold,\n   735\t            ),\n   736\t        ];\n   737\t        for (name, value) in microfauna_fields {\n   738\t            if !value.is_finite() {\n   739\t                return Err(format!(\"field `{name}` must be finite, got {value}\"));\n   740\t            }\n   741\t            if *value < 0.0 {\n   742\t                return Err(format!(\"field `{name}` must be non-negative, got {value}\"));\n   743\t            }\n   744\t        }\n   745\t        Ok(())\n   746\t    }\n   747\t}\n   748\t\n   749\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n   750\tpub struct ScenarioPreset {\n   751\t    pub id: String,\n   752\t    pub name: String,\n   753\t    pub source_water_id: String,\n   754\t    pub substrate_ids: Vec<String>,\n   755\t    pub plant_ids: Vec<String>,\n   756\t    pub shrimp_profile_id: String,\n   757\t    pub process_params_id: String,\n   758\t    pub tank_length_cm: f64,\n   759\t    pub tank_width_cm: f64,\n   760\t    pub tank_height_cm: f64,\n   761\t    pub fill_height_cm: f64,\n   762\t    pub ambient_temp_c: f64,\n   763\t    pub provenance: Option<Provenance>,\n   764\t}\n","exit_code":0,"status":"completed"}}
