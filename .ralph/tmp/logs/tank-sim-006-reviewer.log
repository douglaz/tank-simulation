ub fn new(\n    61\t        day: u32,\n    62\t        hour: u8,\n    63\t        severity: EventSeverity,\n    64\t        kind: EventKind,\n    65\t        cause_codes: Vec<EventCause>,\n    66\t        summary: impl Into<String>,\n    67\t    ) -> Self {\n    68\t        Self {\n    69\t            day,\n    70\t            hour,\n    71\t            severity,\n    72\t            kind,\n    73\t            cause_codes,\n    74\t            summary: summary.into(),\n    75\t        }\n    76\t    }\n    77\t}\n","exit_code":0,"status":"completed"}}
