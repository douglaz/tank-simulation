{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_data/src/lib.rs | sed -n '1,220p'\"","aggregated_output":"     1\tmod presets;\n     2\t\n     3\tuse serde::de::DeserializeOwned;\n     4\tuse thiserror::Error;\n     5\t\n     6\tpub use presets::{\n     7\t    PlantPreset, ProcessParamsPreset, Provenance, ScenarioPreset, ShrimpPreset, SourceWaterPreset,\n     8\t    SubstratePreset,\n     9\t};\n    10\t\n    11\t#[derive(Debug, Error)]\n    12\tpub enum PresetError {\n    13\t    #[error(\"unknown preset `{id}` in category `{category}`\")]\n    14\t    UnknownPreset { category: &'static str, id: String },\n    15\t    #[error(\"failed to parse preset `{id}` in category `{category}`: {message}\")]\n    16\t    Parse {\n    17\t        category: &'static str,\n    18\t        id: String,\n    19\t        message: String,\n    20\t    },\n    21\t    #[error(\"validation failed for preset `{id}` in category `{category}`: {message}\")]\n    22\t    Validation {\n    23\t        category: &'static str,\n    24\t        id: String,\n    25\t        message: String,\n    26\t    },\n    27\t}\n    28\t\n    29\tpub fn load_source_water(id: &str) -> Result<SourceWaterPreset, PresetError> {\n    30\t    let preset: SourceWaterPreset = load_from_registry(\"source_water\", id, SOURCE_WATER_PRESETS)?;\n    31\t    preset\n    32\t        .validate()\n    33\t        .map_err(|message| PresetError::Validation {\n    34\t            category: \"source_water\",\n    35\t            id: id.to_string(),\n    36\t            message,\n    37\t        })?;\n    38\t    Ok(preset)\n    39\t}\n    40\t\n    41\tpub fn load_substrate(id: &str) -> Result<SubstratePreset, PresetError> {\n    42\t    load_from_registry(\"substrate\", id, SUBSTRATE_PRESETS)\n    43\t}\n    44\t\n    45\tpub fn load_plant(id: &str) -> Result<PlantPreset, PresetError> {\n    46\t    load_from_registry(\"plants\", id, PLANT_PRESETS)\n    47\t}\n    48\t\n    49\tpub fn load_shrimp(id: &str) -> Result<ShrimpPreset, PresetError> {\n    50\t    let preset: ShrimpPreset = load_from_registry(\"shrimp\", id, SHRIMP_PRESETS)?;\n    51\t    preset\n    52\t        .validate()\n    53\t        .map_err(|message| PresetError::Validation {\n    54\t            category: \"shrimp\",\n    55\t            id: id.to_string(),\n    56\t            message,\n    57\t        })?;\n    58\t    Ok(preset)\n    59\t}\n    60\t\n    61\tpub fn load_process_params(id: &str) -> Result<ProcessParamsPreset, PresetError> {\n    62\t    let preset: ProcessParamsPreset = load_from_registry(\"process\", id, PROCESS_PRESETS)?;\n    63\t    preset\n    64\t        .validate()\n    65\t        .map_err(|message| PresetError::Validation {\n    66\t            category: \"process\",\n    67\t            id: id.to_string(),\n    68\t            message,\n    69\t        })?;\n    70\t    Ok(preset)\n    71\t}\n    72\t\n    73\tpub fn load_scenario(id: &str) -> Result<ScenarioPreset, PresetError> {\n    74\t    load_from_registry(\"scenarios\", id, SCENARIO_PRESETS)\n    75\t}\n    76\t\n    77\tpub fn source_water_ids() -> &'static [&'static str] {\n    78\t    &[\"soft_acidic\", \"moderate\", \"hard_shrimp\", \"ro_like\"]\n    79\t}\n    80\t\n    81\tpub fn substrate_ids() -> &'static [&'static str] {\n    82\t    &[\n    83\t        \"inert_sand\",\n    84\t        \"inert_gravel\",\n    85\t        \"active_planted\",\n    86\t        \"coarse_porous\",\n    87\t    ]\n    88\t}\n    89\t\n    90\tpub fn plant_ids() -> &'static [&'static str] {\n    91\t    &[\"fast_stem\", \"root_rosette\"]\n    92\t}\n    93\t\n    94\tpub fn shrimp_ids() -> &'static [&'static str] {\n    95\t    &[\"neocaridina_davidi\"]\n    96\t}\n    97\t\n    98\tpub fn process_ids() -> &'static [&'static str] {\n    99\t    &[\"default\"]\n   100\t}\n   101\t\n   102\tpub fn scenario_ids() -> &'static [&'static str] {\n   103\t    &[\"nano_cycle\", \"medium_planted\", \"warm_room\"]\n   104\t}\n   105\t\n   106\tfn load_from_registry<T>(\n   107\t    category: &'static str,\n   108\t    id: &str,\n   109\t    registry: &[(&str, &str)],\n   110\t) -> Result<T, PresetError>\n   111\twhere\n   112\t    T: DeserializeOwned,\n   113\t{\n   114\t    let Some((_, raw)) = registry.iter().find(|(entry_id, _)| *entry_id == id) else {\n   115\t        return Err(PresetError::UnknownPreset {\n   116\t            category,\n   117\t            id: id.to_string(),\n   118\t        });\n   119\t    };\n   120\t\n   121\t    toml::from_str(raw).map_err(|error| PresetError::Parse {\n   122\t        category,\n   123\t        id: id.to_string(),\n   124\t        message: error.to_string(),\n   125\t    })\n   126\t}\n   127\t\n   128\tconst SOURCE_WATER_PRESETS: &[(&str, &str)] = &[\n   129\t    (\n   130\t        \"soft_acidic\",\n   131\t        include_str!(\"../data/source_water/soft_acidic.toml\"),\n   132\t    ),\n   133\t    (\n   134\t        \"moderate\",\n   135\t        include_str!(\"../data/source_water/moderate.toml\"),\n   136\t    ),\n   137\t    (\n   138\t        \"hard_shrimp\",\n   139\t        include_str!(\"../data/source_water/hard_shrimp.toml\"),\n   140\t    ),\n   141\t    (\"ro_like\", include_str!(\"../data/source_water/ro_like.toml\")),\n   142\t];\n   143\t\n   144\tconst SUBSTRATE_PRESETS: &[(&str, &str)] = &[\n   145\t    (\n   146\t        \"inert_sand\",\n   147\t        include_str!(\"../data/substrate/inert_sand.toml\"),\n   148\t    ),\n   149\t    (\n   150\t        \"inert_gravel\",\n   151\t        include_str!(\"../data/substrate/inert_gravel.toml\"),\n   152\t    ),\n   153\t    (\n   154\t        \"active_planted\",\n   155\t        include_str!(\"../data/substrate/active_planted.toml\"),\n   156\t    ),\n   157\t    (\n   158\t        \"coarse_porous\",\n   159\t        include_str!(\"../data/substrate/coarse_porous.toml\"),\n   160\t    ),\n   161\t];\n   162\t\n   163\tconst PLANT_PRESETS: &[(&str, &str)] = &[\n   164\t    (\"fast_stem\", include_str!(\"../data/plants/fast_stem.toml\")),\n   165\t    (\n   166\t        \"root_rosette\",\n   167\t        include_str!(\"../data/plants/root_rosette.toml\"),\n   168\t    ),\n   169\t];\n   170\t\n   171\tconst SHRIMP_PRESETS: &[(&str, &str)] = &[(\n   172\t    \"neocaridina_davidi\",\n   173\t    include_str!(\"../data/shrimp/neocaridina_davidi.toml\"),\n   174\t)];\n   175\t\n   176\tconst PROCESS_PRESETS: &[(&str, &str)] =\n   177\t    &[(\"default\", include_str!(\"../data/process/default.toml\"))];\n   178\t\n   179\tconst SCENARIO_PRESETS: &[(&str, &str)] = &[\n   180\t    (\n   181\t        \"nano_cycle\",\n   182\t        include_str!(\"../data/scenarios/nano_cycle.toml\"),\n   183\t    ),\n   184\t    (\n   185\t        \"medium_planted\",\n   186\t        include_str!(\"../data/scenarios/medium_planted.toml\"),\n   187\t    ),\n   188\t    (\n   189\t        \"warm_room\",\n   190\t        include_str!(\"../data/scenarios/warm_room.toml\"),\n   191\t    ),\n   192\t];\n","exit_code":0,"status":"completed"}}
