{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/src/engine.rs | sed -n '1,340p'\"","aggregated_output":"     1\tuse std::collections::VecDeque;\n     2\t\n     3\tuse crate::{\n     4\t    invariants::enforce_invariants,\n     5\t    rng::SimSeed,\n     6\t    systems,\n     7\t    types::{\n     8\t        EventCause, EventKind, EventSeverity, PlayerAction, SimError, SimEvent, TankSnapshot,\n     9\t        TankState,\n    10\t    },\n    11\t};\n    12\t\n    13\tpub trait SimulationEngine {\n    14\t    fn apply_action(&mut self, action: PlayerAction) -> Result<(), SimError>;\n    15\t    fn step_hours(&mut self, hours: u32) -> Result<(), SimError>;\n    16\t    fn snapshot(&self) -> TankSnapshot;\n    17\t    fn full_state(&self) -> &TankState;\n    18\t}\n    19\t\n    20\t#[derive(Debug, Clone, PartialEq)]\n    21\tpub struct Engine {\n    22\t    state: TankState,\n    23\t    queued_actions: VecDeque<PlayerAction>,\n    24\t}\n    25\t\n    26\timpl Engine {\n    27\t    pub fn new(seed: SimSeed) -> Self {\n    28\t        Self {\n    29\t            state: TankState::new(seed),\n    30\t            queued_actions: VecDeque::new(),\n    31\t        }\n    32\t    }\n    33\t\n    34\t    pub fn from_parts(state: TankState, queued_actions: Vec<PlayerAction>) -> Self {\n    35\t        Self {\n    36\t            state,\n    37\t            queued_actions: queued_actions.into(),\n    38\t        }\n    39\t    }\n    40\t\n    41\t    pub fn queued_actions(&self) -> Vec<PlayerAction> {\n    42\t        self.queued_actions.iter().cloned().collect()\n    43\t    }\n    44\t\n    45\t    fn step_one_hour(&mut self) -> Result<(), SimError> {\n    46\t        let actions_slice: Vec<_> = self.queued_actions.iter().cloned().collect();\n    47\t        systems::water_change::validate_water_changes(&self.state, &actions_slice)?;\n    48\t\n    49\t        while let Some(action) = self.queued_actions.pop_front() {\n    50\t            self.process_action(action);\n    51\t        }\n    52\t\n    53\t        // Step 4: update water temperature from ambient and heater\n    54\t        systems::temperature::step_temperature(&mut self.state);\n    55\t\n    56\t        // Step 5: compute light state for the current hour.\n    57\t        let light_on = self.state.hardware.light.enabled\n    58\t            && systems::light::is_light_on(\n    59\t                self.state.environment.hour_of_day,\n    60\t                self.state.hardware.light.photoperiod_hours,\n    61\t            );\n    62\t\n    63\t        // Step 6-8: nitrogen cycle phase (feed leaching, detritus breakdown,\n    64\t        // mineralization, nitrification, guild growth/decay).\n    65\t        // This runs between light-state resolution and chemistry/DO/event phases.\n    66\t        // Nitrification O2 consumption and alkalinity depletion are handled\n    67\t        // internally by the nitrogen cycle system.\n    68\t        let _nc_output = systems::nitrogen_cycle::step_nitrogen_cycle(&mut self.state);\n    69\t\n    70\t        // Step 9: update DIC, alkalinity, and pH.\n    71\t        systems::chemistry::step_hourly_chemistry(&mut self.state, light_on);\n    72\t\n    73\t        // Step 10 / 11-partial: update dissolved oxygen with background respiration and\n    74\t        // light-driven photosynthetic support from existing biomass.\n    75\t        systems::dissolved_oxygen::step_dissolved_oxygen(&mut self.state, light_on);\n    76\t\n    77\t        // Step 12: hourly shrimp stress accumulation.\n    78\t        systems::shrimp::step_hourly_shrimp_stress(&mut self.state);\n    79\t\n    80\t        // Step 13: emit threshold-based chemistry warnings.\n    81\t        systems::events::emit_hourly_threshold_events(&mut self.state);\n    82\t\n    83\t        self.state.environment.hour_of_day = (self.state.environment.hour_of_day + 1) % 24;\n    84\t        if self.state.environment.hour_of_day == 0 {\n    85\t            self.state.environment.day += 1;\n    86\t            // Daily pipeline\n    87\t            self.run_daily_update();\n    88\t        }\n    89\t\n    90\t        enforce_invariants(&mut self.state)\n    91\t    }\n    92\t\n    93\t    fn run_daily_update(&mut self) {\n    94\t        // Daily pipeline: plants → algae → microfauna → shrimp → biofilter → stability\n    95\t        systems::plant_growth::step_daily_plants(&mut self.state);\n    96\t        systems::algae_growth::step_daily_algae(&mut self.state);\n    97\t        systems::microfauna::step_daily_microfauna(&mut self.state);\n    98\t        systems::shrimp::step_daily_shrimp(&mut self.state);\n    99\t\n   100\t        // Biofilter maturity summary update\n   101\t        let maturity_delta =\n   102\t            systems::nitrogen_cycle::update_daily_biofilter_maturity(&mut self.state);\n   103\t        if maturity_delta > 0.005 {\n   104\t            self.push_event(\n   105\t                EventSeverity::Info,\n   106\t                EventKind::BiofilmMaturityIncrease,\n   107\t                vec![EventCause::BiofilterImmature],\n   108\t                format!(\n   109\t                    \"Biofilter maturity increased to {:.3}\",\n   110\t                    self.state.filter_state.biofilter_maturity_index\n   111\t                ),\n   112\t            );\n   113\t        }\n   114\t        // Emit CycleProgressing when maturity is actively growing\n   115\t        let current_maturity = self.state.filter_state.biofilter_maturity_index;\n   116\t        if maturity_delta > 0.001 && current_maturity < 0.9 {\n   117\t            systems::events::emit_once_per_day_pub(\n   118\t                &mut self.state,\n   119\t                EventSeverity::Info,\n   120\t                EventKind::CycleProgressing,\n   121\t                vec![EventCause::BiofilterImmature],\n   122\t                format!(\"Nitrogen cycle progressing, maturity {current_maturity:.3}\"),\n   123\t            );\n   124\t        }\n   125\t\n   126\t        // Long-term stability metrics\n   127\t        systems::shrimp::update_stability_tracker(&mut self.state);\n   128\t    }\n   129\t\n   130\t    fn process_action(&mut self, action: PlayerAction) {\n   131\t        match action {\n   132\t            PlayerAction::Feed { grams } => {\n   133\t                self.state.detritus.particulate_organics_g_total += grams;\n   134\t                self.push_event(\n   135\t                    EventSeverity::Info,\n   136\t                    EventKind::CycleProgressing,\n   137\t                    vec![EventCause::Overfeeding],\n   138\t                    format!(\"Queued feed processed: {grams:.2} g\"),\n   139\t                );\n   140\t            }\n   141\t            PlayerAction::WaterChangePercent {\n   142\t                percent,\n   143\t                source_profile_id,\n   144\t            } => {\n   145\t                if percent <= 0.0 {\n   146\t                    return;\n   147\t                }\n   148\t                // Profile was pre-validated; look it up (guaranteed to exist).\n   149\t                let profile = self\n   150\t                    .state\n   151\t                    .source_water_catalog\n   152\t                    .get(&source_profile_id)\n   153\t                    .cloned();\n   154\t                if let Some(profile) = profile {\n   155\t                    systems::water_change::apply_water_change(&mut self.state, percent, &profile);\n   156\t                    self.push_event(\n   157\t                        EventSeverity::Info,\n   158\t                        EventKind::StabilityImproving,\n   159\t                        vec![EventCause::WaterChange],\n   160\t                        format!(\"Water change processed: {percent:.1}% with {source_profile_id}\"),\n   161\t                    );\n   162\t                }\n   163\t            }\n   164\t            PlayerAction::TrimPlants { fraction } => {\n   165\t                let mut trimmed_biomass_g = 0.0;\n   166\t                for plant in &mut self.state.plant_guilds {\n   167\t                    let trimmed = plant.biomass_g * fraction;\n   168\t                    plant.biomass_g -= trimmed;\n   169\t                    trimmed_biomass_g += trimmed;\n   170\t                }\n   171\t                self.state.detritus.fine_detritus_g_total += trimmed_biomass_g;\n   172\t            }\n   173\t            PlayerAction::SiphonDetritus { fraction } => {\n   174\t                self.state.detritus.particulate_organics_g_total *= 1.0 - fraction;\n   175\t                self.state.detritus.fine_detritus_g_total *= 1.0 - fraction;\n   176\t            }\n   177\t            PlayerAction::CleanFilter { intensity } => {\n   178\t                self.state.hardware.filter.cleanliness_index = 1.0;\n   179\t                self.state.filter_state.biofilter_maturity_index *= 1.0 - (intensity * 0.5);\n   180\t                self.state.filter_state.clogging_index *= 1.0 - intensity;\n   181\t                // Proportional setback in active nitrifier and decomposer biomass\n   182\t                let setback = intensity * 0.5;\n   183\t                self.state.microbe.decomposer_biomass_g *= 1.0 - setback;\n   184\t                self.state.microbe.ammonia_oxidizer_biomass_g *= 1.0 - setback;\n   185\t                self.state.microbe.nitrite_oxidizer_biomass_g *= 1.0 - setback;\n   186\t                self.state.microbe.comammox_biomass_g *= 1.0 - setback;\n   187\t                self.push_event(\n   188\t                    EventSeverity::Warning,\n   189\t                    EventKind::FilterCleaningSetback,\n   190\t                    vec![EventCause::FilterMaintenance],\n   191\t                    format!(\"Filter cleaned at intensity {intensity:.2}\"),\n   192\t                );\n   193\t            }\n   194\t            PlayerAction::AddShrimp { count } => {\n   195\t                self.state.animal.adults_count =\n   196\t                    self.state.animal.adults_count.saturating_add(count);\n   197\t            }\n   198\t            PlayerAction::RemoveShrimp { count } => {\n   199\t                self.state.animal.adults_count =\n   200\t                    self.state.animal.adults_count.saturating_sub(count);\n   201\t                // Preserve berried_females_count <= adults_count (also trims egg cohorts)\n   202\t                self.state.animal.clamp_berried_to_adults();\n   203\t            }\n   204\t            PlayerAction::ChangePhotoperiod { hours } => {\n   205\t                self.state.hardware.light.photoperiod_hours = hours;\n   206\t            }\n   207\t            PlayerAction::ChangeLightIntensity { intensity_index } => {\n   208\t                self.state.hardware.light.intensity_index = intensity_index;\n   209\t            }\n   210\t            PlayerAction::ChangeHeaterSetpoint { setpoint_c } => {\n   211\t                self.state.hardware.heater.setpoint_c = setpoint_c;\n   212\t            }\n   213\t            PlayerAction::ChangeAmbientTemperature { target_c } => {\n   214\t                self.state.environment.ambient_temp_c = target_c;\n   215\t            }\n   216\t            PlayerAction::ChangeAeration { enabled, intensity } => {\n   217\t                self.state.hardware.aeration.enabled = enabled;\n   218\t                self.state.hardware.aeration.intensity = intensity;\n   219\t            }\n   220\t        }\n   221\t    }\n   222\t\n   223\t    fn push_event(\n   224\t        &mut self,\n   225\t        severity: EventSeverity,\n   226\t        kind: EventKind,\n   227\t        cause_codes: Vec<EventCause>,\n   228\t        summary: String,\n   229\t    ) {\n   230\t        self.state.event_log.push(SimEvent::new(\n   231\t            self.state.environment.day,\n   232\t            self.state.environment.hour_of_day,\n   233\t            severity,\n   234\t            kind,\n   235\t            cause_codes,\n   236\t            summary,\n   237\t        ));\n   238\t    }\n   239\t}\n   240\t\n   241\timpl SimulationEngine for Engine {\n   242\t    fn apply_action(&mut self, action: PlayerAction) -> Result<(), SimError> {\n   243\t        action.validate()?;\n   244\t\n   245\t        // State-aware validation for RemoveShrimp\n   246\t        if let PlayerAction::RemoveShrimp { count } = &action {\n   247\t            let mut available = self.state.animal.adults_count as i64;\n   248\t            for queued in &self.queued_actions {\n   249\t                match queued {\n   250\t                    PlayerAction::RemoveShrimp { count: c } => available -= *c as i64,\n   251\t                    PlayerAction::AddShrimp { count: c } => available += *c as i64,\n   252\t                    _ => {}\n   253\t                }\n   254\t            }\n   255\t            if (*count as i64) > available {\n   256\t                return Err(SimError::ShrimpRemovalExceedsAvailable {\n   257\t                    requested: *count,\n   258\t                    available: available.max(0) as u32,\n   259\t                });\n   260\t            }\n   261\t        }\n   262\t\n   263\t        self.queued_actions.push_back(action);\n   264\t        Ok(())\n   265\t    }\n   266\t\n   267\t    fn step_hours(&mut self, hours: u32) -> Result<(), SimError> {\n   268\t        for _ in 0..hours {\n   269\t            self.step_one_hour()?;\n   270\t        }\n   271\t        enforce_invariants(&mut self.state)\n   272\t    }\n   273\t\n   274\t    fn snapshot(&self) -> TankSnapshot {\n   275\t        TankSnapshot::from_state(&self.state)\n   276\t    }\n   277\t\n   278\t    fn full_state(&self) -> &TankState {\n   279\t        &self.state\n   280\t    }\n   281\t}\n","exit_code":0,"status":"completed"}}
