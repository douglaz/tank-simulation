{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/tests/thermal_reproduction_penalty.rs | sed -n '1,180p'\"","aggregated_output":"     1\tuse tank_core::{Engine, PlayerAction, ProcessParams, SimSeed, SimulationEngine, TankState};\n     2\t\n     3\t/// Creates a stocked shrimp scenario at the given ambient temperature.\n     4\tfn stocked_scenario(seed: SimSeed, ambient_temp_c: f64) -> TankState {\n     5\t    let geometry = tank_core::TankGeometry {\n     6\t        length_cm: 40.0,\n     7\t        width_cm: 30.0,\n     8\t        height_cm: 35.0,\n     9\t        fill_height_cm: 30.0,\n    10\t        glass_thickness_mm: 5.0,\n    11\t        open_top: true,\n    12\t        lid_exchange_factor: 0.25,\n    13\t    };\n    14\t    let water = tank_core::WaterState::default_for_geometry(&geometry);\n    15\t\n    16\t    let mut state = TankState::new(seed);\n    17\t    state.geometry = geometry;\n    18\t    state.water = water;\n    19\t    state.water.temperature_c = ambient_temp_c;\n    20\t    state.environment.ambient_temp_c = ambient_temp_c;\n    21\t\n    22\t    // Good water quality for shrimp\n    23\t    let vol = state.geometry.water_volume_l();\n    24\t    state.water.calcium_mg_total = 40.0 * vol;\n    25\t    state.water.magnesium_mg_total = 10.0 * vol;\n    26\t    state.water.alkalinity_meq_total = 8.0 * vol;\n    27\t    state.water.dissolved_inorganic_carbon_mg_c_total = 5.0 * vol;\n    28\t    state.water.dissolved_oxygen_mg_total = 8.0 * vol;\n    29\t    state.water.bicarbonate_mg_total = 300.0 * vol;\n    30\t\n    31\t    // Good periphyton for food\n    32\t    state.algae.periphyton_biomass_g = 5.0;\n    33\t\n    34\t    // Strong nitrification (mature filter)\n    35\t    state.microbe.decomposer_biomass_g = 0.1;\n    36\t    state.microbe.ammonia_oxidizer_biomass_g = 0.8;\n    37\t    state.microbe.nitrite_oxidizer_biomass_g = 0.5;\n    38\t    state.microbe.comammox_biomass_g = 0.15;\n    39\t    state.filter_state.biofilter_maturity_index = 1.0;\n    40\t\n    41\t    // Enable aeration\n    42\t    state.hardware.aeration.enabled = true;\n    43\t    state.hardware.aeration.intensity = 0.3;\n    44\t\n    45\t    // Good light for periphyton growth\n    46\t    state.hardware.light.enabled = true;\n    47\t    state.hardware.light.intensity_index = 0.6;\n    48\t    state.hardware.light.photoperiod_hours = 8.0;\n    49\t\n    50\t    // Stock with 10 adult shrimp\n    51\t    state.animal.adults_count = 10;\n    52\t    state.animal.condition_index = 0.8;\n    53\t    state.animal.molt_stress_index = 0.1;\n    54\t    state.animal.reproductive_readiness_index = 0.5;\n    55\t\n    56\t    state.process_params = ProcessParams::default();\n    57\t    state.process_params.aob_vmax_mg_n_per_g_per_hour = 5.0;\n    58\t    state.process_params.nob_vmax_mg_n_per_g_per_hour = 5.0;\n    59\t    state.process_params.periphyton_capacity_g_per_m2 = 30.0;\n    60\t\n    61\t    // Initialize stability tracker from actual state\n    62\t    let ca_mg_l = state.water.calcium_mg_total / vol;\n    63\t    let mg_mg_l = state.water.magnesium_mg_total / vol;\n    64\t    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n    65\t    state.stability_tracker.prev_temp_c = state.water.temperature_c;\n    66\t    state.stability_tracker.prev_gh_d = gh_d;\n    67\t    state.stability_tracker.prev_do_mg_l = state.water.dissolved_oxygen_mg_total / vol;\n    68\t    state.stability_tracker.prev_ph = 7.5;\n    69\t\n    70\t    state\n    71\t}\n    72\t\n    73\t#[test]\n    74\tfn thermal_reproduction_penalty() -> Result<(), tank_core::SimError> {\n    75\t    let cool_state = stocked_scenario(SimSeed(9000), 25.0);\n    76\t    let warm_state = stocked_scenario(SimSeed(9000), 30.0);\n    77\t\n    78\t    let mut cool_engine = Engine::from_parts(cool_state, vec![]);\n    79\t    let mut warm_engine = Engine::from_parts(warm_state, vec![]);\n    80\t\n    81\t    // Run for 20 days — long enough for readiness to stabilize but before\n    82\t    // hatching (21-day egg cycle) disrupts the comparison via population dynamics.\n    83\t    for _ in 0..20 {\n    84\t        cool_engine.apply_action(PlayerAction::Feed { grams: 0.1 })?;\n    85\t        warm_engine.apply_action(PlayerAction::Feed { grams: 0.1 })?;\n    86\t        cool_engine.step_hours(24)?;\n    87\t        warm_engine.step_hours(24)?;\n    88\t    }\n    89\t\n    90\t    let cool_snap = cool_engine.snapshot();\n    91\t    let warm_snap = warm_engine.snapshot();\n    92\t\n    93\t    // The 30°C tank must have at least 20% lower reproductive readiness\n    94\t    let readiness_reduction = 1.0 - (warm_snap.shrimp_reproductive_readiness\n    95\t        / cool_snap.shrimp_reproductive_readiness.max(f64::EPSILON));\n    96\t    assert!(\n    97\t        readiness_reduction >= 0.20,\n    98\t        \"30°C tank should have at least 20% lower reproductive readiness than 25°C tank. \\\n    99\t         Cool: {:.4}, Warm: {:.4}, Reduction: {:.2}%\",\n   100\t        cool_snap.shrimp_reproductive_readiness,\n   101\t        warm_snap.shrimp_reproductive_readiness,\n   102\t        readiness_reduction * 100.0\n   103\t    );\n   104\t\n   105\t    // Continue to 60 days for juvenile comparison\n   106\t    for _ in 0..40 {\n   107\t        cool_engine.apply_action(PlayerAction::Feed { grams: 0.1 })?;\n   108\t        warm_engine.apply_action(PlayerAction::Feed { grams: 0.1 })?;\n   109\t        cool_engine.step_hours(24)?;\n   110\t        warm_engine.step_hours(24)?;\n   111\t    }\n   112\t\n   113\t    let cool_snap_60 = cool_engine.snapshot();\n   114\t    let warm_snap_60 = warm_engine.snapshot();\n   115\t\n   116\t    // Higher-temperature tank should produce fewer juveniles (or equal)\n   117\t    // due to reduced spawning from thermal reproduction penalty\n   118\t    let cool_total = cool_snap_60.adult_shrimp_count + cool_snap_60.juveniles_count;\n   119\t    let warm_total = warm_snap_60.adult_shrimp_count + warm_snap_60.juveniles_count;\n   120\t    assert!(\n   121\t        warm_total <= cool_total || warm_snap_60.juveniles_count <= cool_snap_60.juveniles_count,\n   122\t        \"30°C tank should have fewer or equal total population. Cool: {}, Warm: {}\",\n   123\t        cool_total,\n   124\t        warm_total\n   125\t    );\n   126\t\n   127\t    Ok(())\n   128\t}\n","exit_code":0,"status":"completed"}}
