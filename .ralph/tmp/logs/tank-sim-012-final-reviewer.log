{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"awk 'FNR==1{print \\\"FILE \\\" FILENAME} {printf \\\"%5d %s\\\\n\\\", FNR, \"'$0}'\"' crates/tank_core/src/systems/shrimp.rs | sed -n '261,560p'\"","aggregated_output":"  260 \n  261 fn spawning(state: &mut TankState) {\n  262     if state.animal.adults_count == 0 {\n  263         return;\n  264     }\n  265 \n  266     let eligible = ((0.5 * state.animal.adults_count as f64)\n  267         - state.animal.berried_females_count as f64)\n  268         .max(0.0) as u32;\n  269 \n  270     if eligible == 0 {\n  271         return;\n  272     }\n  273 \n  274     let temp = state.water.temperature_c;\n  275     let params = &state.shrimp_params;\n  276 \n  277     let f_temp = temp_repro_factor(temp, params);\n  278     let f_condition = state.animal.condition_index;\n  279     let f_stability = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n  280 \n  281     let volume_l = state.geometry.water_volume_l().max(f64::EPSILON);\n  282     let ca_mg_l = state.water.calcium_mg_total / volume_l;\n  283     let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n  284     let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n  285     let f_mineral = gh_mineral_factor(gh_d, params);\n  286 \n  287     let p_spawn = params.base_spawn_rate * f_temp * f_condition * f_stability * f_mineral;\n  288 \n  289     let mut new_berried = 0u32;\n  290     for _ in 0..eligible {\n  291         if state.rng.next_f64() < p_spawn {\n  292             new_berried += 1;\n  293         }\n  294     }\n  295 \n  296     if new_berried > 0 {\n  297         state.animal.berried_females_count += new_berried;\n  298         // Create a new cohort for this batch of berried females\n  299         state.animal.egg_cohorts.push(EggCohort {\n  300             count: new_berried,\n  301             progress_days: 0.0,\n  302         });\n  303 \n  304         crate::systems::events::emit_once_per_day_pub(\n  305             state,\n  306             EventSeverity::Info,\n  307             EventKind::ShrimpBerried,\n  308             vec![EventCause::RoutineAction],\n  309             format!(\"{new_berried} female(s) became berried\"),\n  310         );\n  311     }\n  312 }\n  313 \n  314 fn egg_development(state: &mut TankState) {\n  315     if state.animal.egg_cohorts.is_empty() {\n  316         // Legacy path: if berried females exist without cohorts (e.g. from old save),\n  317         // migrate them into a single cohort using the current egg_progress_days.\n  318         if state.animal.berried_females_count > 0 {\n  319             state.animal.egg_cohorts.push(EggCohort {\n  320                 count: state.animal.berried_females_count,\n  321                 progress_days: state.animal.egg_progress_days,\n  322             });\n  323         } else {\n  324             return;\n  325         }\n  326     }\n  327 \n  328     let volume_l = state.geometry.water_volume_l().max(f64::EPSILON);\n  329     let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n  330     let temp = state.water.temperature_c;\n  331     let params = &state.shrimp_params;\n  332 \n  333     let f_condition = state.animal.condition_index;\n  334     let f_oxygen = (do_mg_l / 6.0).clamp(0.0, 1.0);\n  335     let f_temp = temp_repro_factor(temp, params);\n  336     let f_stability = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n  337 \n  338     let ca_mg_l = state.water.calcium_mg_total / volume_l;\n  339     let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n  340     let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n  341     let f_mineral = gh_mineral_factor(gh_d, params);\n  342 \n  343     let p_hatch =\n  344         params.hatch_success_base * f_condition * f_oxygen * f_temp * f_stability * f_mineral;\n  345 \n  346     let egg_duration = params.egg_duration_days as f64;\n  347     let mut total_successful = 0u32;\n  348     let mut total_failed = 0u32;\n  349     let mut resolved_berried = 0u32;\n  350 \n  351     // Advance each cohort; resolve only those that have reached duration\n  352     let mut i = 0;\n  353     while i < state.animal.egg_cohorts.len() {\n  354         state.animal.egg_cohorts[i].progress_days += 1.0;\n  355 \n  356         if state.animal.egg_cohorts[i].progress_days >= egg_duration {\n  357             let cohort = state.animal.egg_cohorts.remove(i);\n  358             resolved_berried += cohort.count;\n  359 \n  360             for _ in 0..cohort.count {\n  361                 if state.rng.next_f64() < p_hatch {\n  362                     total_successful += 1;\n  363                 } else {\n  364                     total_failed += 1;\n  365                 }\n  366             }\n  367             // Don't increment i; the next cohort shifted into position\n  368         } else {\n  369             i += 1;\n  370         }\n  371     }\n  372 \n  373     // Successful hatches produce juveniles (~25 per clutch for Neocaridina)\n  374     let juveniles_per_clutch = 25u32;\n  375     if total_successful > 0 {\n  376         state.animal.juveniles_count += total_successful * juveniles_per_clutch;\n  377     }\n  378 \n  379     // Only resolved clutches leave berried_females_count\n  380     state.animal.berried_females_count = state\n  381         .animal\n  382         .berried_females_count\n  383         .saturating_sub(resolved_berried);\n  384 \n  385     if total_failed > 0 {\n  386         // Failure-mode invariant: on hatch failure, juveniles_count does NOT increase\n  387         let mut causes = Vec::new();\n  388         if f_oxygen < 0.6 {\n  389             causes.push(EventCause::LowOxygen);\n  390         }\n  391         if f_temp < 0.5 {\n  392             causes.push(EventCause::HighTemperature);\n  393         }\n  394         if f_mineral < 0.6 {\n  395             causes.push(EventCause::LowMinerals);\n  396         }\n  397         if f_stability < 0.6 {\n  398             causes.push(EventCause::ChemistryInstability);\n  399         }\n  400         if causes.is_empty() {\n  401             causes.push(EventCause::PoorCondition);\n  402         }\n  403 \n  404         crate::systems::events::emit_once_per_day_pub(\n  405             state,\n  406             EventSeverity::Warning,\n  407             EventKind::EggFailure,\n  408             causes,\n  409             format!(\"{total_failed} clutch(es) failed to hatch\"),\n  410         );\n  411     }\n  412 \n  413     // Update egg_progress_days from remaining cohorts for display/snapshot\n  414     state.animal.sync_egg_progress_from_cohorts();\n  415 }\n  416 \n  417 fn juvenile_recruitment(state: &mut TankState) {\n  418     if state.animal.juveniles_count == 0 {\n  419         return;\n  420     }\n  421 \n  422     let maturation_rate = 1.0\n  423         / state\n  424             .process_params\n  425             .shrimp_juvenile_maturation_days\n  426             .max(1.0);\n  427     let maturing = (state.animal.juveniles_count as f64 * maturation_rate).floor() as u32;\n  428     let maturing = maturing.min(state.animal.juveniles_count);\n  429 \n  430     state.animal.juveniles_count -= maturing;\n  431     state.animal.adults_count += maturing;\n  432 }\n  433 \n  434 fn mortality(state: &mut TankState) {\n  435     let base_rate = state.process_params.shrimp_base_mortality_per_day;\n  436     let stress_scale = state.process_params.shrimp_stress_mortality_scale;\n  437 \n  438     let stress_total = state.animal.hourly_nh3_stress_accum\n  439         + state.animal.hourly_nitrite_stress_accum\n  440         + state.animal.hourly_low_do_stress_accum\n  441         + state.animal.hourly_heat_stress_accum\n  442         + (state.animal.molt_stress_index - 0.5).max(0.0)\n  443         + (0.5 - state.animal.condition_index).max(0.0);\n  444 \n  445     let p_adult_death = (base_rate + stress_total * stress_scale).clamp(0.0, 0.5);\n  446 \n  447     let juv_sensitivity = state.shrimp_params.juvenile_sensitivity;\n  448     let p_juv_death = (base_rate + stress_total * stress_scale * juv_sensitivity).clamp(0.0, 0.5);\n  449 \n  450     let mut adult_deaths = 0u32;\n  451     for _ in 0..state.animal.adults_count {\n  452         if state.rng.next_f64() < p_adult_death {\n  453             adult_deaths += 1;\n  454         }\n  455     }\n  456 \n  457     let mut juv_deaths = 0u32;\n  458     for _ in 0..state.animal.juveniles_count {\n  459         if state.rng.next_f64() < p_juv_death {\n  460             juv_deaths += 1;\n  461         }\n  462     }\n  463 \n  464     state.animal.adults_count = state.animal.adults_count.saturating_sub(adult_deaths);\n  465     state.animal.juveniles_count = state.animal.juveniles_count.saturating_sub(juv_deaths);\n  466 \n  467     // Preserve berried_females <= adults invariant (also trims egg cohorts)\n  468     state.animal.clamp_berried_to_adults();\n  469 }\n  470 \n  471 fn emit_molt_stress_warning(state: &mut TankState, volume_l: f64) {\n  472     if state.animal.molt_stress_index <= 0.6 {\n  473         return;\n  474     }\n  475 \n  476     let mut causes = Vec::new();\n  477     let ca_mg_l = state.water.calcium_mg_total / volume_l;\n  478     let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n  479     let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n  480 \n  481     if gh_d < state.shrimp_params.gh_min_d {\n  482         causes.push(EventCause::LowMinerals);\n  483     }\n  484     if state.stability_tracker.instability_index > 0.3 {\n  485         causes.push(EventCause::ChemistryInstability);\n  486     }\n  487     if state.water.temperature_c > state.shrimp_params.optimal_temp_max_c {\n  488         causes.push(EventCause::HighTemperature);\n  489     }\n  490     if causes.is_empty() {\n  491         causes.push(EventCause::PoorCondition);\n  492     }\n  493 \n  494     crate::systems::events::emit_once_per_day_pub(\n  495         state,\n  496         EventSeverity::Warning,\n  497         EventKind::MoltStressWarning,\n  498         causes,\n  499         format!(\n  500             \"Molt stress elevated: {:.2}\",\n  501             state.animal.molt_stress_index\n  502         ),\n  503     );\n  504 }\n  505 \n  506 fn reset_hourly_accumulators(state: &mut TankState) {\n  507     state.animal.hourly_nh3_stress_accum = 0.0;\n  508     state.animal.hourly_nitrite_stress_accum = 0.0;\n  509     state.animal.hourly_low_do_stress_accum = 0.0;\n  510     state.animal.hourly_heat_stress_accum = 0.0;\n  511     state.animal.hourly_instability_stress_accum = 0.0;\n  512     state.animal.daily_food_consumed_g = 0.0;\n  513 }\n  514 \n  515 // ── Factor functions ────────────────────────────────────────────────────────\n  516 \n  517 /// Temperature factor for reproduction.\n  518 /// Best 22–26 °C, clearly worse by 30 °C, near-zero by 33 °C.\n  519 fn temp_repro_factor(temp: f64, params: &ShrimpRuntimeParams) -> f64 {\n  520     let opt_min = params.optimal_temp_min_c;\n  521     let opt_max = params.optimal_temp_max_c;\n  522     let penalty_start = params.high_temp_repro_penalty_start_c;\n  523     let penalty_full = params.high_temp_repro_penalty_full_c;\n  524 \n  525     if temp < opt_min - 4.0 {\n  526         0.1\n  527     } else if temp < opt_min {\n  528         0.1 + 0.9 * (temp - (opt_min - 4.0)) / 4.0\n  529     } else if temp <= opt_max {\n  530         1.0\n  531     } else if temp <= penalty_start {\n  532         let range = (penalty_start - opt_max).max(0.01);\n  533         1.0 - 0.5 * (temp - opt_max) / range\n  534     } else if temp <= penalty_full {\n  535         let range = (penalty_full - penalty_start).max(0.01);\n  536         0.5 - 0.45 * (temp - penalty_start) / range\n  537     } else {\n  538         0.05\n  539     }\n  540 }\n  541 \n  542 /// Temperature factor for general condition (broader bell than reproduction).\n  543 fn temp_condition_factor(temp: f64, params: &ShrimpRuntimeParams) -> f64 {\n  544     if temp >= params.optimal_temp_min_c && temp <= params.optimal_temp_max_c {\n  545         1.0\n  546     } else if temp < params.optimal_temp_min_c {\n  547         (1.0 - (params.optimal_temp_min_c - temp) / 10.0).clamp(0.2, 1.0)\n  548     } else {\n  549         (1.0 - (temp - params.optimal_temp_max_c) / 8.0).clamp(0.2, 1.0)\n  550     }\n  551 }\n  552 \n  553 /// GH/mineral factor for spawning and condition.\n  554 fn gh_mineral_factor(gh_d: f64, params: &ShrimpRuntimeParams) -> f64 {\n  555     if gh_d >= params.gh_min_d && gh_d <= params.gh_max_d {\n  556         1.0\n  557     } else if gh_d < params.gh_min_d {\n  558         (gh_d / params.gh_min_d.max(0.01)).clamp(0.3, 1.0)\n  559     } else {\n","exit_code":0,"status":"completed"}}
