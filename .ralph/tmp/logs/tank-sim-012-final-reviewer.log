{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"awk 'FNR==1{print \\\"FILE \\\" FILENAME} {printf \\\"%5d %s\\\\n\\\", FNR, \"'$0}'\"' crates/tank_core/tests/ambient_temperature_action.rs crates/tank_core/tests/chemistry.rs crates/tank_core/tests/cycling.rs crates/tank_core/tests/determinism.rs crates/tank_core/tests/dissolved_oxygen.rs crates/tank_core/tests/events.rs crates/tank_core/tests/overfeeding_effects.rs\"","aggregated_output":"FILE crates/tank_core/tests/ambient_temperature_action.rs\n    1 use tank_core::{Engine, PlayerAction, ProcessParams, SimSeed, SimulationEngine, TankState};\n    2 \n    3 /// Helper: build a state with heater enabled at setpoint 24°C, ambient 24°C.\n    4 fn stable_24c_state(seed: SimSeed) -> TankState {\n    5     let mut state = TankState::new(seed);\n    6     state.water.temperature_c = 24.0;\n    7     state.environment.ambient_temp_c = 24.0;\n    8     state.hardware.heater.enabled = true;\n    9     state.hardware.heater.setpoint_c = 24.0;\n   10     state.hardware.heater.max_watts = 50.0;\n   11     state.process_params = ProcessParams::default();\n   12     state\n   13 }\n   14 \n   15 #[test]\n   16 fn ambient_change_causes_gradual_warming() -> Result<(), tank_core::SimError> {\n   17     let state = stable_24c_state(SimSeed(1000));\n   18     let mut engine = Engine::from_parts(state, vec![]);\n   19 \n   20     // Change ambient from 24°C to 31°C\n   21     engine.apply_action(PlayerAction::ChangeAmbientTemperature { target_c: 31.0 })?;\n   22     engine.step_hours(1)?;\n   23 \n   24     let snap_1h = engine.snapshot();\n   25     // After 1 hour, water should have warmed but NOT jumped to 31°C\n   26     assert!(\n   27         snap_1h.water_temp_c > 24.0,\n   28         \"Water should warm: got {:.3}\",\n   29         snap_1h.water_temp_c\n   30     );\n   31     assert!(\n   32         snap_1h.water_temp_c < 31.0,\n   33         \"Water should NOT jump to ambient: got {:.3}\",\n   34         snap_1h.water_temp_c\n   35     );\n   36 \n   37     // After many hours, it should approach 31°C\n   38     engine.step_hours(200)?;\n   39     let snap_200h = engine.snapshot();\n   40     assert!(\n   41         snap_200h.water_temp_c > 30.0,\n   42         \"After 200h, water should be near ambient 31°C: got {:.3}\",\n   43         snap_200h.water_temp_c\n   44     );\n   45 \n   46     Ok(())\n   47 }\n   48 \n   49 #[test]\n   50 fn do_saturation_decreases_with_warming() -> Result<(), tank_core::SimError> {\n   51     let state = stable_24c_state(SimSeed(1100));\n   52     let mut engine = Engine::from_parts(state, vec![]);\n   53 \n   54     let do_sat_before = engine.snapshot().do_sat_mg_l;\n   55 \n   56     // Warm to 31°C and run\n   57     engine.apply_action(PlayerAction::ChangeAmbientTemperature { target_c: 31.0 })?;\n   58     engine.step_hours(200)?;\n   59 \n   60     let do_sat_after = engine.snapshot().do_sat_mg_l;\n   61     assert!(\n   62         do_sat_after < do_sat_before,\n   63         \"DO saturation should decrease with warming: before={do_sat_before:.2}, after={do_sat_after:.2}\"\n   64     );\n   65 \n   66     Ok(())\n   67 }\n   68 \n   69 #[test]\n   70 fn heater_output_zero_when_above_setpoint() -> Result<(), tank_core::SimError> {\n   71     let state = stable_24c_state(SimSeed(1200));\n   72     let mut engine = Engine::from_parts(state, vec![]);\n   73 \n   74     // Change ambient above heater setpoint\n   75     engine.apply_action(PlayerAction::ChangeAmbientTemperature { target_c: 31.0 })?;\n   76     engine.step_hours(200)?;\n   77 \n   78     let snap = engine.snapshot();\n   79     // Water should be well above setpoint by now\n   80     assert!(snap.water_temp_c > 24.0, \"Water should be above setpoint\");\n   81     assert!(\n   82         snap.last_heater_output_w == 0.0,\n   83         \"Heater should be off when water > setpoint: got {:.2}\",\n   84         snap.last_heater_output_w\n   85     );\n   86 \n   87     Ok(())\n   88 }\n   89 \n   90 #[test]\n   91 fn heater_never_cools_tank() -> Result<(), tank_core::SimError> {\n   92     let mut state = stable_24c_state(SimSeed(1300));\n   93     // Set water above setpoint\n   94     state.water.temperature_c = 28.0;\n   95     state.environment.ambient_temp_c = 28.0;\n   96     state.hardware.heater.setpoint_c = 24.0;\n   97 \n   98     let mut engine = Engine::from_parts(state, vec![]);\n   99     engine.step_hours(1)?;\n  100 \n  101     let snap = engine.snapshot();\n  102     assert!(\n  103         snap.last_heater_output_w == 0.0,\n  104         \"Heater should not fire when water is above setpoint\"\n  105     );\n  106     // Temperature should not decrease due to heater (ambient = water temp)\n  107     assert!(\n  108         snap.water_temp_c >= 27.9,\n  109         \"Heater should never cool: got {:.3}\",\n  110         snap.water_temp_c\n  111     );\n  112 \n  113     Ok(())\n  114 }\n  115 \n  116 #[test]\n  117 fn heater_fires_when_below_setpoint() -> Result<(), tank_core::SimError> {\n  118     let mut state = stable_24c_state(SimSeed(1400));\n  119     state.water.temperature_c = 20.0;\n  120     state.environment.ambient_temp_c = 20.0;\n  121     state.hardware.heater.setpoint_c = 24.0;\n  122 \n  123     let mut engine = Engine::from_parts(state, vec![]);\n  124     engine.step_hours(1)?;\n  125 \n  126     let snap = engine.snapshot();\n  127     assert!(\n  128         snap.last_heater_output_w > 0.0,\n  129         \"Heater should fire when water is below setpoint - deadband/2\"\n  130     );\n  131     assert!(\n  132         snap.water_temp_c > 20.0,\n  133         \"Water should warm from heater: got {:.3}\",\n  134         snap.water_temp_c\n  135     );\n  136 \n  137     Ok(())\n  138 }\nFILE crates/tank_core/tests/chemistry.rs\n    1 use tank_core::{\n    2     systems::chemistry::{compute_nh3_mg_l, compute_ph_from_totals},\n    3     Engine, ProcessParams, SimSeed, SimulationEngine, TankState,\n    4 };\n    5 \n    6 fn chemistry_state(seed: SimSeed, hour_of_day: u8) -> TankState {\n    7     let mut state = TankState::new(seed);\n    8     state.environment.hour_of_day = hour_of_day;\n    9     state.hardware.light.photoperiod_hours = 8.0;\n   10     state.hardware.light.intensity_index = 1.0;\n   11     state.algae.periphyton_biomass_g = 2.5;\n   12     state.plant_guilds[0].biomass_g = 14.0;\n   13     state.plant_guilds[1].biomass_g = 8.0;\n   14     state.animal.adults_count = 20;\n   15     state.process_params = ProcessParams {\n   16         respiration_dic_rate_mg_c_per_g_per_hour: 0.20,\n   17         photosynthesis_dic_rate_mg_c_per_g_per_hour: 0.35,\n   18         ..ProcessParams::default()\n   19     };\n   20     state\n   21 }\n   22 \n   23 #[test]\n   24 fn ph_drifts_with_light_driven_dic_changes() -> Result<(), tank_core::SimError> {\n   25     let mut night_engine = Engine::from_parts(chemistry_state(SimSeed(4000), 0), vec![]);\n   26     let mut day_engine = Engine::from_parts(chemistry_state(SimSeed(4000), 12), vec![]);\n   27 \n   28     let night_ph_before = night_engine.full_state().water.ph;\n   29     let day_ph_before = day_engine.full_state().water.ph;\n   30 \n   31     night_engine.step_hours(1)?;\n   32     day_engine.step_hours(1)?;\n   33 \n   34     let night_ph_after = night_engine.full_state().water.ph;\n   35     let day_ph_after = day_engine.full_state().water.ph;\n   36     let night_dic_after = night_engine\n   37         .full_state()\n   38         .water\n   39         .dissolved_inorganic_carbon_mg_c_total;\n   40     let day_dic_after = day_engine\n   41         .full_state()\n   42         .water\n   43         .dissolved_inorganic_carbon_mg_c_total;\n   44 \n   45     assert!(\n   46         night_ph_after < night_ph_before,\n   47         \"night respiration should lower pH: before={night_ph_before:.3}, after={night_ph_after:.3}\"\n   48     );\n   49     assert!(\n   50         day_ph_after > day_ph_before,\n   51         \"day photosynthesis should raise pH: before={day_ph_before:.3}, after={day_ph_after:.3}\"\n   52     );\n   53     assert!(\n   54         day_dic_after < night_dic_after,\n   55         \"lit hours should consume more DIC than night hours\"\n   56     );\n   57 \n   58     Ok(())\n   59 }\n   60 \n   61 #[test]\n   62 fn nh3_speciation_matches_reference_formula() {\n   63     let tan_mg_l = 1.2;\n   64     let ph = 7.8;\n   65     let temp_c = 25.0;\n   66 \n   67     let expected = {\n   68         let pka = 0.09018 + 2729.92 / (273.2 + temp_c);\n   69         let fraction_nh3 = 1.0 / (1.0 + 10.0_f64.powf(pka - ph));\n   70         tan_mg_l * fraction_nh3\n   71     };\n   72 \n   73     let computed = compute_nh3_mg_l(tan_mg_l, ph, temp_c);\n   74     assert!((computed - expected).abs() < 1e-12);\n   75     assert!(compute_nh3_mg_l(tan_mg_l, 8.4, temp_c) > computed);\n   76 }\n   77 \n   78 #[test]\n   79 fn ph_formula_uses_state_storage_bounds() {\n   80     let low = compute_ph_from_totals(0.01, 500.0, 20.0);\n   81     let high = compute_ph_from_totals(12.0, 0.01, 20.0);\n   82 \n   83     assert!((5.5..=8.5).contains(&low));\n   84     assert!((5.5..=8.5).contains(&high));\n   85 }\n   86 \n   87 #[test]\n   88 fn nitrification_lowers_alkalinity_and_ph() -> Result<(), tank_core::SimError> {\n   89     // Tank with active nitrification\n   90     let mut nitrifying_state = TankState::new(SimSeed(4100));\n   91     let vol = nitrifying_state.geometry.water_volume_l();\n   92     nitrifying_state.water.ammonia_total_mg_n_total = 2.0 * vol; // 2 mg/L TAN\n   93     nitrifying_state.microbe.ammonia_oxidizer_biomass_g = 0.2;\n   94     nitrifying_state.microbe.nitrite_oxidizer_biomass_g = 0.15;\n   95     nitrifying_state.microbe.comammox_biomass_g = 0.03;\n   96     nitrifying_state.filter_state.biofilter_maturity_index = 0.6;\n   97     nitrifying_state.process_params = ProcessParams::default();\n   98 \n   99     // Control: identical but with zero nitrifier biomass\n  100     let mut control_state = nitrifying_state.clone();\n  101     control_state.microbe.ammonia_oxidizer_biomass_g = 0.0;\n  102     control_state.microbe.nitrite_oxidizer_biomass_g = 0.0;\n  103     control_state.microbe.comammox_biomass_g = 0.0;\n  104 \n  105     let mut nitrifying = Engine::from_parts(nitrifying_state, vec![]);\n  106     let mut control = Engine::from_parts(control_state, vec![]);\n  107 \n  108     let alk_before = nitrifying.full_state().water.alkalinity_meq_total;\n  109 \n  110     nitrifying.step_hours(48)?;\n  111     control.step_hours(48)?;\n  112 \n  113     let alk_nitrifying = nitrifying.full_state().water.alkalinity_meq_total;\n  114     let alk_control = control.full_state().water.alkalinity_meq_total;\n  115     let ph_nitrifying = nitrifying.full_state().water.ph;\n  116     let ph_control = control.full_state().water.ph;\n  117 \n  118     // Active nitrification should lower alkalinity relative to control\n  119     assert!(\n  120         alk_nitrifying < alk_control,\n  121         \"Nitrifying tank ({alk_nitrifying:.4}) should have lower alkalinity than control ({alk_control:.4})\"\n  122     );\n  123     assert!(\n  124         alk_nitrifying < alk_before,\n  125         \"Alkalinity should decrease from nitrification\"\n  126     );\n  127 \n  128     // Active nitrification should lower pH relative to control\n  129     assert!(\n  130         ph_nitrifying < ph_control,\n  131         \"Nitrifying tank pH ({ph_nitrifying:.3}) should be lower than control ({ph_control:.3})\"\n  132     );\n  133 \n  134     // pH must still be within invariant bounds\n  135     assert!((5.5..=8.5).contains(&ph_nitrifying));\n  136 \n  137     Ok(())\n  138 }\nFILE crates/tank_core/tests/cycling.rs\n    1 use tank_core::{Engine, EventKind, PlayerAction, SimSeed, SimulationEngine, TankState};\n    2 \n    3 /// Feed the engine a small pellet each day for the given number of days.\n    4 fn feed_daily(engine: &mut Engine, days: u32, grams: f64) -> Result<(), tank_core::SimError> {\n    5     for _ in 0..days {\n    6         engine.apply_action(PlayerAction::Feed { grams })?;\n    7         engine.step_hours(24)?;\n    8     }\n    9     Ok(())\n   10 }\n   11 \n   12 #[test]\n   13 fn cycling_seeded_vs_unseeded() -> Result<(), tank_core::SimError> {\n   14     let (seeded_state, unseeded_state) = tank_scenarios::cycling_fixture_pair(SimSeed(9000));\n   15 \n   16     let mut seeded = Engine::from_parts(seeded_state, vec![]);\n   17     let mut unseeded = Engine::from_parts(unseeded_state, vec![]);\n   18 \n   19     // Feed both tanks identically: 0.3g/day for 30 days\n   20     let days = 30;\n   21     let feed_g = 0.3;\n   22 \n   23     // Track peak TAN and nitrite for each\n   24     let mut unseeded_peak_tan = 0.0_f64;\n   25     let mut unseeded_peak_nitrite = 0.0_f64;\n   26 \n   27     // Find first hour where TAN < 0.1 and nitrite < 0.1 for each\n   28     let mut seeded_stable_hour: Option<u32> = None;\n   29     let mut unseeded_stable_hour: Option<u32> = None;\n   30 \n   31     for day in 0..days {\n   32         seeded.apply_action(PlayerAction::Feed { grams: feed_g })?;\n   33         unseeded.apply_action(PlayerAction::Feed { grams: feed_g })?;\n   34 \n   35         for _h in 0..24 {\n   36             seeded.step_hours(1)?;\n   37             unseeded.step_hours(1)?;\n   38 \n   39             let hour = day * 24 + _h + 1;\n   40             let vol_s = seeded.full_state().geometry.water_volume_l();\n   41             let vol_u = unseeded.full_state().geometry.water_volume_l();\n   42 \n   43             let s_tan = seeded.full_state().water.ammonia_total_mg_n_total / vol_s;\n   44             let s_no2 = seeded.full_state().water.nitrite_mg_n_total / vol_s;\n   45             let u_tan = unseeded.full_state().water.ammonia_total_mg_n_total / vol_u;\n   46             let u_no2 = unseeded.full_state().water.nitrite_mg_n_total / vol_u;\n   47 \n   48             unseeded_peak_tan = unseeded_peak_tan.max(u_tan);\n   49             unseeded_peak_nitrite = unseeded_peak_nitrite.max(u_no2);\n   50 \n   51             if seeded_stable_hour.is_none() && s_tan < 0.1 && s_no2 < 0.1 && hour > 48 {\n   52                 seeded_stable_hour = Some(hour);\n   53             }\n   54             if unseeded_stable_hour.is_none() && u_tan < 0.1 && u_no2 < 0.1 && hour > 48 {\n   55                 unseeded_stable_hour = Some(hour);\n   56             }\n   57         }\n   58     }\n   59 \n   60     // The unseeded tank must show non-zero TAN and nitrite peaks\n   61     assert!(\n   62         unseeded_peak_tan > 0.01,\n   63         \"Unseeded tank should have non-zero TAN peaks, got {unseeded_peak_tan:.4}\"\n   64     );\n   65     assert!(\n   66         unseeded_peak_nitrite > 0.001,\n   67         \"Unseeded tank should have non-zero nitrite peaks, got {unseeded_peak_nitrite:.4}\"\n   68     );\n   69 \n   70     // The seeded tank must reach stable state earlier than the unseeded tank.\n   71     // If unseeded never stabilized, that's fine — seeded just needs to have stabilized.\n   72     match (seeded_stable_hour, unseeded_stable_hour) {\n   73         (Some(s), Some(u)) => {\n   74             assert!(\n   75                 s < u,\n   76                 \"Seeded tank should stabilize earlier: seeded={s}h, unseeded={u}h\"\n   77             );\n   78         }\n   79         (Some(_s), None) => {\n   80             // Seeded stabilized, unseeded never did — that's a pass\n   81         }\n   82         (None, _) => {\n   83             // Both had ongoing feed, so let's just check the seeded tank has lower final TAN\n   84             let vol_s = seeded.full_state().geometry.water_volume_l();\n   85             let vol_u = unseeded.full_state().geometry.water_volume_l();\n   86             let final_s_tan = seeded.full_state().water.ammonia_total_mg_n_total / vol_s;\n   87             let final_u_tan = unseeded.full_state().water.ammonia_total_mg_n_total / vol_u;\n   88             assert!(\n   89                 final_s_tan < final_u_tan,\n   90                 \"Seeded should have lower final TAN: seeded={final_s_tan:.4}, unseeded={final_u_tan:.4}\"\n   91             );\n   92         }\n   93     }\n   94 \n   95     Ok(())\n   96 }\n   97 \n   98 #[test]\n   99 fn filter_cleaning_setback() -> Result<(), tank_core::SimError> {\n  100     let (seeded_state, _) = tank_scenarios::cycling_fixture_pair(SimSeed(9100));\n  101     let mut engine = Engine::from_parts(seeded_state, vec![]);\n  102 \n  103     // Feed and run 10 days to build up cycle activity\n  104     feed_daily(&mut engine, 10, 0.3)?;\n  105 \n  106     let aob_before = engine.full_state().microbe.ammonia_oxidizer_biomass_g;\n  107     let nob_before = engine.full_state().microbe.nitrite_oxidizer_biomass_g;\n  108 \n  109     // Clean filter at high intensity\n  110     engine.apply_action(PlayerAction::CleanFilter { intensity: 0.8 })?;\n  111     engine.step_hours(1)?;\n  112 \n  113     let aob_after = engine.full_state().microbe.ammonia_oxidizer_biomass_g;\n  114     let nob_after = engine.full_state().microbe.nitrite_oxidizer_biomass_g;\n  115 \n  116     assert!(\n  117         aob_after < aob_before,\n  118         \"AOB should decrease after filter cleaning: before={aob_before:.6}, after={aob_after:.6}\"\n  119     );\n  120     assert!(\n  121         nob_after < nob_before,\n  122         \"NOB should decrease after filter cleaning: before={nob_before:.6}, after={nob_after:.6}\"\n  123     );\n  124 \n  125     // Check that FilterCleaningSetback event was emitted\n  126     let has_setback_event = engine\n  127         .full_state()\n  128         .event_log\n  129         .iter()\n  130         .any(|e| e.kind == EventKind::FilterCleaningSetback);\n  131     assert!(\n  132         has_setback_event,\n  133         \"FilterCleaningSetback event should be emitted\"\n  134     );\n  135 \n  136     // After cleaning, TAN should rise temporarily when feeding resumes\n  137     let tan_before_feed = engine.full_state().water.ammonia_total_mg_n_total;\n  138     feed_daily(&mut engine, 3, 0.3)?;\n  139     let tan_after_feed = engine.full_state().water.ammonia_total_mg_n_total;\n  140     assert!(\n  141         tan_after_feed > tan_before_feed,\n  142         \"TAN should rise after filter cleaning + feeding\"\n  143     );\n  144 \n  145     Ok(())\n  146 }\n  147 \n  148 #[test]\n  149 fn limiter_correctness_no_negative_pools() -> Result<(), tank_core::SimError> {\n  150     // Extreme scenario: huge feed into tiny tank with zero DO and zero microbes\n  151     let mut state = TankState::new(SimSeed(9200));\n  152 \n  153     // Zero out microbes\n  154     state.microbe.decomposer_biomass_g = 0.0;\n  155     state.microbe.ammonia_oxidizer_biomass_g = 0.0;\n  156     state.microbe.nitrite_oxidizer_biomass_g = 0.0;\n  157     state.microbe.comammox_biomass_g = 0.0;\n  158 \n  159     // Zero DO\n  160     state.water.dissolved_oxygen_mg_total = 0.0;\n  161     // Disable aeration and reaeration\n  162     state.process_params.reaeration_kla_base = 0.0;\n  163     state.process_params.aeration_kla_boost = 0.0;\n  164 \n  165     let mut engine = Engine::from_parts(state, vec![]);\n  166 \n  167     // Massive feed\n  168     engine.apply_action(PlayerAction::Feed { grams: 50.0 })?;\n  169     engine.step_hours(100)?;\n  170 \n  171     let s = engine.full_state();\n  172     assert!(s.water.ammonia_total_mg_n_total >= 0.0);\n  173     assert!(s.water.nitrite_mg_n_total >= 0.0);\n  174     assert!(s.water.nitrate_mg_n_total >= 0.0);\n  175     assert!(s.water.dissolved_oxygen_mg_total >= 0.0);\n  176     assert!(s.water.alkalinity_meq_total >= 0.0);\n  177     assert!(s.detritus.particulate_organics_g_total >= 0.0);\n  178     assert!(s.detritus.fine_detritus_g_total >= 0.0);\n  179     assert!(s.detritus.dissolved_feed_residue_g_total >= 0.0);\n  180     assert!(s.water.dissolved_organic_carbon_mg_c_total >= 0.0);\n  181     assert!(s.water.dissolved_organic_nitrogen_mg_n_total >= 0.0);\n  182 \n  183     // All values must be finite\n  184     assert!(s.water.ammonia_total_mg_n_total.is_finite());\n  185     assert!(s.water.nitrite_mg_n_total.is_finite());\n  186     assert!(s.water.nitrate_mg_n_total.is_finite());\n  187 \n  188     Ok(())\n  189 }\n  190 \n  191 #[test]\n  192 fn siphon_detritus_reduces_cycling_pressure() -> Result<(), tank_core::SimError> {\n  193     let (seeded_state, _) = tank_scenarios::cycling_fixture_pair(SimSeed(9300));\n  194 \n  195     // Control: no siphoning\n  196     let mut control = Engine::from_parts(seeded_state.clone(), vec![]);\n  197     // Siphoned: siphon daily\n  198     let mut siphoned = Engine::from_parts(seeded_state, vec![]);\n  199 \n  200     for day in 0..14 {\n  201         control.apply_action(PlayerAction::Feed { grams: 0.5 })?;\n  202         siphoned.apply_action(PlayerAction::Feed { grams: 0.5 })?;\n  203 \n  204         if day % 2 == 0 {\n  205             siphoned.apply_action(PlayerAction::SiphonDetritus { fraction: 0.3 })?;\n  206         }\n  207 \n  208         control.step_hours(24)?;\n  209         siphoned.step_hours(24)?;\n  210     }\n  211 \n  212     // Siphoned tank should have lower detritus\n  213     assert!(\n  214         siphoned.full_state().detritus.particulate_organics_g_total\n  215             < control.full_state().detritus.particulate_organics_g_total,\n  216         \"Siphoning should reduce particulate detritus\"\n  217     );\n  218 \n  219     // Siphoning must NOT directly remove dissolved TAN/nitrite/nitrate — that's handled\n  220     // only through the mineralization pathway. We verify the siphon doesn't zero them out\n  221     // by checking the control tank has more dissolved N (which was never siphoned away).\n  222     // The siphoned tank should have less TAN over time because less detritus = less mineralization.\n  223     let vol = control.full_state().geometry.water_volume_l();\n  224     let control_tan = control.full_state().water.ammonia_total_mg_n_total / vol;\n  225     let siphoned_tan = siphoned.full_state().water.ammonia_total_mg_n_total / vol;\n  226     // Note: this might not always hold if nitrification is very active, but with heavy feeding\n  227     // the control should accumulate more TAN due to higher detritus.\n  228     // We just verify pools are non-negative.\n  229     assert!(siphoned_tan >= 0.0);\n  230     assert!(control_tan >= 0.0);\n  231 \n  232     Ok(())\n  233 }\n  234 \n  235 /// Verify that when DO is very scarce, combined AOB + comammox oxidation is\n  236 /// capped by the shared O2 budget and never exceeds available DO.\n  237 #[test]\n  238 fn limiter_shared_do_budget() -> Result<(), tank_core::SimError> {\n  239     let mut state = TankState::new(SimSeed(9400));\n  240     let vol = state.geometry.water_volume_l();\n  241 \n  242     // Plenty of TAN substrate\n  243     state.water.ammonia_total_mg_n_total = 10.0 * vol;\n  244     // Very small DO pool — only enough for ~0.5 mg N total nitrification\n  245     // 0.5 mg N via AOB path costs 0.5 * 3.43 = 1.715 mg O2\n  246     // 0.5 mg N via comammox costs 0.5 * 4.57 = 2.285 mg O2\n  247     state.water.dissolved_oxygen_mg_total = 2.0; // tiny budget\n  248 \n  249     // Large biomass to ensure kinetic potential exceeds DO budget\n  250     state.microbe.ammonia_oxidizer_biomass_g = 1.0;\n  251     state.microbe.comammox_biomass_g = 1.0;\n  252     state.microbe.nitrite_oxidizer_biomass_g = 0.5;\n  253     state.filter_state.biofilter_maturity_index = 0.8;\n  254 \n  255     // Disable reaeration so DO is not replenished\n  256     state.process_params.reaeration_kla_base = 0.0;\n  257     state.process_params.aeration_kla_boost = 0.0;\n  258 \n  259     let do_before = state.water.dissolved_oxygen_mg_total;\n  260 \n  261     let mut engine = Engine::from_parts(state, vec![]);\n  262     engine.step_hours(1)?;\n  263 \n  264     let s = engine.full_state();\n  265     assert!(\n  266         s.water.dissolved_oxygen_mg_total >= 0.0,\n  267         \"DO must remain non-negative, got {}\",\n  268         s.water.dissolved_oxygen_mg_total\n  269     );\n  270 \n  271     // Total N consumed from TAN should be limited by the small DO pool\n  272     let tan_consumed = 10.0 * vol - s.water.ammonia_total_mg_n_total;\n  273     // Maximum possible from 2 mg O2: 2.0/3.43 ≈ 0.58 mg N (if all went to AOB)\n  274     // or 2.0/4.57 ≈ 0.44 mg N (if all went to comammox)\n  275     // Either way, total O2 consumed must not exceed the starting budget\n  276     let o2_consumed = do_before - s.water.dissolved_oxygen_mg_total;\n  277     assert!(\n  278         o2_consumed <= do_before + 1e-9,\n  279         \"O2 consumed ({o2_consumed:.6}) must not exceed initial budget ({do_before:.6})\"\n  280     );\n  281     // Sanity: some nitrification did happen\n  282     assert!(\n  283         tan_consumed > 0.0,\n  284         \"Some TAN should be consumed even with limited DO\"\n  285     );\n  286 \n  287     Ok(())\n  288 }\n  289 \n  290 /// Verify that when alkalinity is nearly exhausted, nitrification is limited\n  291 /// to the supported fraction and alkalinity cannot go negative.\n  292 #[test]\n  293 fn limiter_low_alkalinity_caps_nitrification() -> Result<(), tank_core::SimError> {\n  294     let mut state = TankState::new(SimSeed(9500));\n  295     let vol = state.geometry.water_volume_l();\n  296 \n  297     // Plenty of TAN and DO\n  298     state.water.ammonia_total_mg_n_total = 10.0 * vol;\n  299     state.water.dissolved_oxygen_mg_total = 50.0 * vol;\n  300     // Very low alkalinity: only enough for ~1 mg N at 0.1428 meq/mg N\n  301     state.water.alkalinity_meq_total = 0.15; // supports ~1.05 mg N total\n  302 \n  303     state.microbe.ammonia_oxidizer_biomass_g = 0.5;\n  304     state.microbe.comammox_biomass_g = 0.3;\n  305     state.microbe.nitrite_oxidizer_biomass_g = 0.3;\n  306     state.filter_state.biofilter_maturity_index = 0.8;\n  307 \n  308     let alk_before = state.water.alkalinity_meq_total;\n  309 \n  310     let mut engine = Engine::from_parts(state, vec![]);\n  311     engine.step_hours(1)?;\n  312 \n  313     let s = engine.full_state();\n  314     assert!(\n  315         s.water.alkalinity_meq_total >= 0.0,\n  316         \"Alkalinity must remain non-negative, got {}\",\n  317         s.water.alkalinity_meq_total\n  318     );\n  319 \n  320     // Total alkalinity consumed should not exceed the starting budget\n  321     let alk_consumed = alk_before - s.water.alkalinity_meq_total;\n  322     assert!(\n  323         alk_consumed <= alk_before + 1e-9,\n  324         \"Alkalinity consumed ({alk_consumed:.6}) must not exceed initial budget ({alk_before:.6})\"\n  325     );\n  326 \n  327     // Some nitrification should still have occurred\n  328     let tan_consumed = 10.0 * vol - s.water.ammonia_total_mg_n_total;\n  329     assert!(\n  330         tan_consumed > 0.0,\n  331         \"Some TAN should be consumed even with limited alkalinity\"\n  332     );\n  333 \n  334     Ok(())\n  335 }\n  336 \n  337 /// Verify that a dirty (clogged) filter reduces nitrification rate compared\n  338 /// to a clean filter.\n  339 #[test]\n  340 fn dirty_filter_slows_nitrification() -> Result<(), tank_core::SimError> {\n  341     let base = {\n  342         let mut state = TankState::new(SimSeed(9600));\n  343         let vol = state.geometry.water_volume_l();\n  344         state.water.ammonia_total_mg_n_total = 5.0 * vol;\n  345         state.microbe.ammonia_oxidizer_biomass_g = 0.2;\n  346         state.microbe.nitrite_oxidizer_biomass_g = 0.15;\n  347         state.microbe.comammox_biomass_g = 0.03;\n  348         state.filter_state.biofilter_maturity_index = 0.6;\n  349         state\n  350     };\n  351 \n  352     let mut clean_state = base.clone();\n  353     clean_state.filter_state.clogging_index = 0.0; // clean\n  354 \n  355     let mut dirty_state = base;\n  356     dirty_state.filter_state.clogging_index = 0.9; // heavily clogged\n  357 \n  358     let vol = clean_state.geometry.water_volume_l();\n  359 \n  360     let mut clean_engine = Engine::from_parts(clean_state, vec![]);\n  361     let mut dirty_engine = Engine::from_parts(dirty_state, vec![]);\n  362 \n  363     clean_engine.step_hours(24)?;\n  364     dirty_engine.step_hours(24)?;\n  365 \n  366     let clean_tan = clean_engine.full_state().water.ammonia_total_mg_n_total / vol;\n  367     let dirty_tan = dirty_engine.full_state().water.ammonia_total_mg_n_total / vol;\n  368 \n  369     // Clean filter should oxidize more TAN -> lower remaining TAN\n  370     assert!(\n  371         clean_tan < dirty_tan,\n  372         \"Clean filter TAN ({clean_tan:.4}) should be lower than dirty filter ({dirty_tan:.4})\"\n  373     );\n  374 \n  375     Ok(())\n  376 }\nFILE crates/tank_core/tests/determinism.rs\n    1 use tank_core::{Engine, PlayerAction, SimSeed, SimulationEngine};\n    2 \n    3 #[test]\n    4 fn determinism_same_seed() -> Result<(), tank_core::SimError> {\n    5     let left_state = tank_scenarios::seeded_state(SimSeed(7), \"medium_planted\")\n    6         .expect(\"scenario should materialize\");\n    7     let right_state = tank_scenarios::seeded_state(SimSeed(7), \"medium_planted\")\n    8         .expect(\"scenario should materialize\");\n    9 \n   10     let mut left = Engine::from_parts(left_state, vec![]);\n   11     let mut right = Engine::from_parts(right_state, vec![]);\n   12 \n   13     run_schedule(&mut left)?;\n   14     run_schedule(&mut right)?;\n   15 \n   16     let left_json =\n   17         serde_json::to_string(&left.snapshot()).expect(\"snapshot serialization should succeed\");\n   18     let right_json =\n   19         serde_json::to_string(&right.snapshot()).expect(\"snapshot serialization should succeed\");\n   20 \n   21     assert_eq!(left_json, right_json);\n   22     assert_eq!(left.full_state(), right.full_state());\n   23 \n   24     Ok(())\n   25 }\n   26 \n   27 fn run_schedule(engine: &mut Engine) -> Result<(), tank_core::SimError> {\n   28     for hour in 0..720_u32 {\n   29         if hour % 12 == 0 {\n   30             engine.apply_action(PlayerAction::Feed {\n   31                 grams: if hour % 48 == 0 { 0.28 } else { 0.18 },\n   32             })?;\n   33         }\n   34 \n   35         if hour > 0 && hour % (24 * 5) == 0 {\n   36             engine.apply_action(PlayerAction::WaterChangePercent {\n   37                 percent: if hour % (24 * 10) == 0 { 30.0 } else { 18.0 },\n   38                 source_profile_id: if hour % (24 * 15) == 0 {\n   39                     \"hard_shrimp\".to_string()\n   40                 } else {\n   41                     \"moderate\".to_string()\n   42                 },\n   43             })?;\n   44         }\n   45 \n   46         match hour {\n   47             96 => engine.apply_action(PlayerAction::ChangeAmbientTemperature { target_c: 28.0 })?,\n   48             240 => {\n   49                 engine.apply_action(PlayerAction::ChangeAmbientTemperature { target_c: 25.0 })?\n   50             }\n   51             420 => {\n   52                 engine.apply_action(PlayerAction::ChangeAmbientTemperature { target_c: 27.5 })?\n   53             }\n   54             600 => {\n   55                 engine.apply_action(PlayerAction::ChangeAmbientTemperature { target_c: 24.5 })?\n   56             }\n   57             _ => {}\n   58         }\n   59 \n   60         engine.step_hours(1)?;\n   61     }\n   62 \n   63     Ok(())\n   64 }\nFILE crates/tank_core/tests/dissolved_oxygen.rs\n    1 use tank_core::{\n    2     systems::{light::is_light_on, temperature::do_sat_mg_l},\n    3     Engine, ProcessParams, SimSeed, SimulationEngine, TankState,\n    4 };\n    5 \n    6 fn oxygen_test_state(seed: SimSeed) -> TankState {\n    7     let mut state = TankState::new(seed);\n    8     state.hardware.light.photoperiod_hours = 8.0;\n    9     state.hardware.light.intensity_index = 1.0;\n   10     state.hardware.aeration.enabled = false;\n   11     state.hardware.aeration.intensity = 0.0;\n   12     state.animal.adults_count = 30;\n   13     state.algae.periphyton_biomass_g = 3.0;\n   14     state.plant_guilds[0].biomass_g = 18.0;\n   15     state.plant_guilds[1].biomass_g = 10.0;\n   16     state.process_params = ProcessParams {\n   17         reaeration_kla_base: 0.08,\n   18         aeration_kla_boost: 1.2,\n   19         background_bod_mg_o2_per_g_biomass_per_hour: 0.24,\n   20         plant_photosynthesis_o2_mg_per_g_per_hour: 0.65,\n   21         respiration_dic_rate_mg_c_per_g_per_hour: 0.10,\n   22         photosynthesis_dic_rate_mg_c_per_g_per_hour: 0.18,\n   23         ..ProcessParams::default()\n   24     };\n   25     state\n   26 }\n   27 \n   28 #[test]\n   29 fn dissolved_oxygen_dips_at_night_relative_to_lit_hours() -> Result<(), tank_core::SimError> {\n   30     let mut engine = Engine::from_parts(oxygen_test_state(SimSeed(3000)), vec![]);\n   31     let photoperiod = engine.full_state().hardware.light.photoperiod_hours;\n   32 \n   33     let mut night_values = Vec::new();\n   34     let mut lit_values = Vec::new();\n   35 \n   36     for _ in 0..48 {\n   37         let hour = engine.full_state().environment.hour_of_day;\n   38         engine.step_hours(1)?;\n   39         let do_mg_l = engine.snapshot().do_mg_l;\n   40         if is_light_on(hour, photoperiod) {\n   41             lit_values.push(do_mg_l);\n   42         } else {\n   43             night_values.push(do_mg_l);\n   44         }\n   45     }\n   46 \n   47     let lit_mean = lit_values.iter().sum::<f64>() / lit_values.len() as f64;\n   48     let night_mean = night_values.iter().sum::<f64>() / night_values.len() as f64;\n   49 \n   50     assert!(\n   51         night_mean < lit_mean,\n   52         \"night DO should be lower than lit DO: night={night_mean:.2}, lit={lit_mean:.2}\"\n   53     );\n   54 \n   55     Ok(())\n   56 }\n   57 \n   58 #[test]\n   59 fn aeration_recovers_do_faster_than_passive_exchange() -> Result<(), tank_core::SimError> {\n   60     let mut base_state = oxygen_test_state(SimSeed(3100));\n   61     base_state.water.dissolved_oxygen_mg_total = 2.0 * base_state.geometry.water_volume_l();\n   62     base_state\n   63         .process_params\n   64         .background_bod_mg_o2_per_g_biomass_per_hour = 0.0;\n   65     base_state\n   66         .process_params\n   67         .plant_photosynthesis_o2_mg_per_g_per_hour = 0.0;\n   68     base_state.algae.periphyton_biomass_g = 0.0;\n   69     for plant in &mut base_state.plant_guilds {\n   70         plant.biomass_g = 0.0;\n   71     }\n   72     base_state.animal.adults_count = 0;\n   73 \n   74     let mut no_aeration = base_state.clone();\n   75     no_aeration.hardware.aeration.enabled = false;\n   76 \n   77     let mut high_aeration = base_state;\n   78     high_aeration.hardware.aeration.enabled = true;\n   79     high_aeration.hardware.aeration.intensity = 1.0;\n   80 \n   81     let mut passive_engine = Engine::from_parts(no_aeration, vec![]);\n   82     let mut aerated_engine = Engine::from_parts(high_aeration, vec![]);\n   83 \n   84     passive_engine.step_hours(6)?;\n   85     aerated_engine.step_hours(6)?;\n   86 \n   87     assert!(\n   88         aerated_engine.snapshot().do_mg_l > passive_engine.snapshot().do_mg_l,\n   89         \"aeration should accelerate recovery: passive={:.2}, aerated={:.2}\",\n   90         passive_engine.snapshot().do_mg_l,\n   91         aerated_engine.snapshot().do_mg_l\n   92     );\n   93 \n   94     Ok(())\n   95 }\n   96 \n   97 #[test]\n   98 fn reaeration_converges_toward_saturation() -> Result<(), tank_core::SimError> {\n   99     let mut state = oxygen_test_state(SimSeed(3200));\n  100     state.water.dissolved_oxygen_mg_total = 0.0;\n  101     state\n  102         .process_params\n  103         .background_bod_mg_o2_per_g_biomass_per_hour = 0.0;\n  104     state\n  105         .process_params\n  106         .plant_photosynthesis_o2_mg_per_g_per_hour = 0.0;\n  107     state.process_params.reaeration_kla_base = 0.5;\n  108     state.algae.periphyton_biomass_g = 0.0;\n  109     for plant in &mut state.plant_guilds {\n  110         plant.biomass_g = 0.0;\n  111     }\n  112     state.animal.adults_count = 0;\n  113 \n  114     let mut engine = Engine::from_parts(state, vec![]);\n  115     engine.step_hours(24)?;\n  116 \n  117     let do_sat = do_sat_mg_l(engine.full_state().water.temperature_c);\n  118     let do_now = engine.snapshot().do_mg_l;\n  119     assert!(do_now > 0.0, \"reaeration should raise DO above zero\");\n  120     assert!(\n  121         (do_sat - do_now).abs() < 0.25,\n  122         \"DO should converge toward saturation: do={do_now:.2}, sat={do_sat:.2}\"\n  123     );\n  124 \n  125     Ok(())\n  126 }\nFILE crates/tank_core/tests/events.rs\n    1 use tank_core::{\n    2     EggCohort, Engine, EventKind, PlayerAction, ProcessParams, SimSeed, SimulationEngine, TankState,\n    3 };\n    4 \n    5 fn threshold_state(seed: SimSeed) -> TankState {\n    6     let mut state = TankState::new(seed);\n    7     let volume_l = state.geometry.water_volume_l();\n    8     state.water.alkalinity_meq_total = 8.0 * volume_l;\n    9     state.water.dissolved_inorganic_carbon_mg_c_total = 0.5 * volume_l;\n   10     state.water.ammonia_total_mg_n_total = 0.5 * volume_l;\n   11     state.water.nitrite_mg_n_total = 0.7 * volume_l;\n   12     state.water.dissolved_oxygen_mg_total = 3.0 * volume_l;\n   13     state.process_params = ProcessParams {\n   14         reaeration_kla_base: 0.0,\n   15         aeration_kla_boost: 0.0,\n   16         background_bod_mg_o2_per_g_biomass_per_hour: 0.0,\n   17         plant_photosynthesis_o2_mg_per_g_per_hour: 0.0,\n   18         respiration_dic_rate_mg_c_per_g_per_hour: 0.0,\n   19         photosynthesis_dic_rate_mg_c_per_g_per_hour: 0.0,\n   20         ..ProcessParams::default()\n   21     };\n   22     state\n   23 }\n   24 \n   25 #[test]\n   26 fn threshold_events_emit_with_cause_codes() -> Result<(), tank_core::SimError> {\n   27     let mut engine = Engine::from_parts(threshold_state(SimSeed(5000)), vec![]);\n   28     engine.step_hours(1)?;\n   29 \n   30     let events = &engine.full_state().event_log;\n   31     assert!(events\n   32         .iter()\n   33         .any(|event| event.kind == EventKind::AmmoniaWarning));\n   34     assert!(events\n   35         .iter()\n   36         .any(|event| event.kind == EventKind::NitriteWarning));\n   37     assert!(events\n   38         .iter()\n   39         .any(|event| event.kind == EventKind::OxygenDip));\n   40     assert!(events.iter().all(|event| !event.cause_codes.is_empty()));\n   41 \n   42     Ok(())\n   43 }\n   44 \n   45 #[test]\n   46 fn threshold_events_are_deduplicated_per_day() -> Result<(), tank_core::SimError> {\n   47     let mut engine = Engine::from_parts(threshold_state(SimSeed(5100)), vec![]);\n   48 \n   49     engine.step_hours(6)?;\n   50     let same_day_count = engine\n   51         .full_state()\n   52         .event_log\n   53         .iter()\n   54         .filter(|event| event.kind == EventKind::AmmoniaWarning)\n   55         .count();\n   56     assert_eq!(\n   57         same_day_count, 1,\n   58         \"ammonia warning should dedupe within a day\"\n   59     );\n   60 \n   61     engine.step_hours(24)?;\n   62     let next_day_count = engine\n   63         .full_state()\n   64         .event_log\n   65         .iter()\n   66         .filter(|event| event.kind == EventKind::AmmoniaWarning)\n   67         .count();\n   68     assert_eq!(next_day_count, 2, \"warning should emit again on a new day\");\n   69 \n   70     Ok(())\n   71 }\n   72 \n   73 #[test]\n   74 fn event_generation_warm_overfed_weak_aeration() -> Result<(), tank_core::SimError> {\n   75     // Warm, overfed, weak-aeration setup — designed to trigger AmmoniaWarning or OxygenDip\n   76     let mut state = TankState::new(SimSeed(5200));\n   77     let vol = state.geometry.water_volume_l();\n   78     state.water.temperature_c = 30.0;\n   79     state.environment.ambient_temp_c = 30.0;\n   80     // Higher pH pushes NH3 fraction up at 30°C\n   81     state.water.alkalinity_meq_total = 4.0 * vol;\n   82     state.water.dissolved_inorganic_carbon_mg_c_total = 5.0 * vol;\n   83     // Weak aeration\n   84     state.hardware.aeration.enabled = true;\n   85     state.hardware.aeration.intensity = 0.05;\n   86     // Low reaeration to allow DO to drop\n   87     state.process_params = ProcessParams {\n   88         reaeration_kla_base: 0.05,\n   89         aeration_kla_boost: 0.1,\n   90         ..ProcessParams::default()\n   91     };\n   92     // Strong decomposer biomass to mineralize feed quickly into TAN\n   93     state.microbe.decomposer_biomass_g = 0.5;\n   94     // Minimal nitrification so TAN accumulates\n   95     state.microbe.ammonia_oxidizer_biomass_g = 0.005;\n   96     state.microbe.nitrite_oxidizer_biomass_g = 0.005;\n   97     state.microbe.comammox_biomass_g = 0.001;\n   98     state.filter_state.biofilter_maturity_index = 0.05;\n   99 \n  100     let mut engine = Engine::from_parts(state, vec![]);\n  101 \n  102     // Heavy overfeeding for 14 days\n  103     for _ in 0..14 {\n  104         engine.apply_action(PlayerAction::Feed { grams: 3.0 })?;\n  105         engine.step_hours(24)?;\n  106     }\n  107 \n  108     let events = &engine.full_state().event_log;\n  109 \n  110     // Must emit at least one of AmmoniaWarning or OxygenDip\n  111     let has_ammonia = events.iter().any(|e| e.kind == EventKind::AmmoniaWarning);\n  112     let has_oxygen = events.iter().any(|e| e.kind == EventKind::OxygenDip);\n  113     assert!(\n  114         has_ammonia || has_oxygen,\n  115         \"Warm overfed tank should emit AmmoniaWarning or OxygenDip. Events: {:?}\",\n  116         events.iter().map(|e| &e.kind).collect::<Vec<_>>()\n  117     );\n  118 \n  119     // All emitted events must have non-empty cause_codes\n  120     let relevant: Vec<_> = events\n  121         .iter()\n  122         .filter(|e| {\n  123             matches!(\n  124                 e.kind,\n  125                 EventKind::AmmoniaWarning | EventKind::OxygenDip | EventKind::NitriteWarning\n  126             )\n  127         })\n  128         .collect();\n  129     assert!(\n  130         relevant.iter().all(|e| !e.cause_codes.is_empty()),\n  131         \"Warning events must have non-empty cause_codes\"\n  132     );\n  133 \n  134     Ok(())\n  135 }\n  136 \n  137 #[test]\n  138 fn shrimp_berried_event_has_cause_codes() -> Result<(), tank_core::SimError> {\n  139     let mut state = TankState::new(SimSeed(5300));\n  140     state.water.temperature_c = 24.0;\n  141     state.environment.ambient_temp_c = 24.0;\n  142     let vol = state.geometry.water_volume_l();\n  143     state.water.calcium_mg_total = 40.0 * vol;\n  144     state.water.magnesium_mg_total = 10.0 * vol;\n  145     state.water.alkalinity_meq_total = 3.0 * vol;\n  146     state.water.dissolved_inorganic_carbon_mg_c_total = 5.0 * vol;\n  147     state.water.dissolved_oxygen_mg_total = 8.0 * vol;\n  148     state.algae.periphyton_biomass_g = 3.0;\n  149     state.hardware.aeration.enabled = true;\n  150     state.hardware.aeration.intensity = 0.3;\n  151     state.hardware.light.enabled = true;\n  152     state.hardware.light.intensity_index = 0.6;\n  153     state.hardware.light.photoperiod_hours = 8.0;\n  154 \n  155     state.animal.adults_count = 10;\n  156     state.animal.condition_index = 0.8;\n  157     state.animal.reproductive_readiness_index = 0.8;\n  158     state.microbe.decomposer_biomass_g = 0.2;\n  159     state.microbe.ammonia_oxidizer_biomass_g = 0.15;\n  160     state.microbe.nitrite_oxidizer_biomass_g = 0.1;\n  161     state.filter_state.biofilter_maturity_index = 0.5;\n  162 \n  163     let mut engine = Engine::from_parts(state, vec![]);\n  164 \n  165     for _ in 0..30 {\n  166         engine.apply_action(PlayerAction::Feed { grams: 0.1 })?;\n  167         engine.step_hours(24)?;\n  168     }\n  169 \n  170     let berried_events: Vec<_> = engine\n  171         .full_state()\n  172         .event_log\n  173         .iter()\n  174         .filter(|e| e.kind == EventKind::ShrimpBerried)\n  175         .collect();\n  176 \n  177     assert!(\n  178         !berried_events.is_empty(),\n  179         \"Should emit ShrimpBerried events in good conditions\"\n  180     );\n  181     for e in &berried_events {\n  182         assert!(\n  183             !e.cause_codes.is_empty(),\n  184             \"ShrimpBerried events must have non-empty cause_codes\"\n  185         );\n  186     }\n  187 \n  188     Ok(())\n  189 }\n  190 \n  191 #[test]\n  192 fn egg_failure_event_has_cause_codes() -> Result<(), tank_core::SimError> {\n  193     let mut state = TankState::new(SimSeed(5400));\n  194     state.water.temperature_c = 32.0;\n  195     state.environment.ambient_temp_c = 32.0;\n  196     let vol = state.geometry.water_volume_l();\n  197     state.water.dissolved_oxygen_mg_total = 2.0 * vol;\n  198     state.water.calcium_mg_total = 5.0 * vol;\n  199     state.water.magnesium_mg_total = 1.0 * vol;\n  200     state.water.alkalinity_meq_total = 2.0 * vol;\n  201     state.water.dissolved_inorganic_carbon_mg_c_total = 5.0 * vol;\n  202 \n  203     state.animal.adults_count = 5;\n  204     state.animal.berried_females_count = 3;\n  205     state.animal.egg_progress_days = 20.0;\n  206     state.animal.egg_cohorts = vec![EggCohort {\n  207         count: 3,\n  208         progress_days: 20.0,\n  209     }];\n  210     state.animal.condition_index = 0.3;\n  211     state.hardware.aeration.enabled = false;\n  212 \n  213     let mut engine = Engine::from_parts(state, vec![]);\n  214     engine.step_hours(24)?;\n  215 \n  216     let egg_failures: Vec<_> = engine\n  217         .full_state()\n  218         .event_log\n  219         .iter()\n  220         .filter(|e| e.kind == EventKind::EggFailure)\n  221         .collect();\n  222 \n  223     assert!(\n  224         !egg_failures.is_empty(),\n  225         \"Should emit EggFailure under stressful conditions\"\n  226     );\n  227     for e in &egg_failures {\n  228         assert!(\n  229             !e.cause_codes.is_empty(),\n  230             \"EggFailure events must have non-empty cause_codes\"\n  231         );\n  232     }\n  233 \n  234     Ok(())\n  235 }\n  236 \n  237 #[test]\n  238 fn molt_stress_warning_has_cause_codes() -> Result<(), tank_core::SimError> {\n  239     let mut state = TankState::new(SimSeed(5500));\n  240     state.water.temperature_c = 30.0;\n  241     state.environment.ambient_temp_c = 30.0;\n  242     let vol = state.geometry.water_volume_l();\n  243     state.water.calcium_mg_total = 2.0 * vol;\n  244     state.water.magnesium_mg_total = 0.5 * vol;\n  245     state.water.alkalinity_meq_total = 2.0 * vol;\n  246     state.water.dissolved_inorganic_carbon_mg_c_total = 5.0 * vol;\n  247     state.water.dissolved_oxygen_mg_total = 6.0 * vol;\n  248 \n  249     state.animal.adults_count = 10;\n  250     state.animal.condition_index = 0.3;\n  251     state.animal.molt_stress_index = 0.5;\n  252     state.hardware.aeration.enabled = true;\n  253     state.hardware.aeration.intensity = 0.2;\n  254     state.algae.periphyton_biomass_g = 0.1;\n  255 \n  256     let mut engine = Engine::from_parts(state, vec![]);\n  257 \n  258     for _ in 0..14 {\n  259         engine.step_hours(24)?;\n  260     }\n  261 \n  262     let molt_warnings: Vec<_> = engine\n  263         .full_state()\n  264         .event_log\n  265         .iter()\n  266         .filter(|e| e.kind == EventKind::MoltStressWarning)\n  267         .collect();\n  268 \n  269     assert!(\n  270         !molt_warnings.is_empty(),\n  271         \"Should emit MoltStressWarning under low-mineral, high-temp conditions\"\n  272     );\n  273     for e in &molt_warnings {\n  274         assert!(\n  275             !e.cause_codes.is_empty(),\n  276             \"MoltStressWarning events must have non-empty cause_codes\"\n  277         );\n  278     }\n  279 \n  280     Ok(())\n  281 }\nFILE crates/tank_core/tests/overfeeding_effects.rs\n    1 use tank_core::{systems::light::is_light_on, Engine, PlayerAction, SimSeed, SimulationEngine};\n    2 \n    3 #[test]\n    4 fn overfeeding_effects() -> Result<(), tank_core::SimError> {\n    5     let control_state = configured_state(SimSeed(8800));\n    6     let overfed_state = configured_state(SimSeed(8800));\n    7 \n    8     let mut control = Engine::from_parts(control_state, vec![]);\n    9     let mut overfed = Engine::from_parts(overfed_state, vec![]);\n   10 \n   11     let mut control_nightly_min_do = f64::INFINITY;\n   12     let mut overfed_nightly_min_do = f64::INFINITY;\n   13 \n   14     for _day in 0..14 {\n   15         control.apply_action(PlayerAction::Feed { grams: 0.18 })?;\n   16         overfed.apply_action(PlayerAction::Feed { grams: 0.85 })?;\n   17 \n   18         for _hour in 0..24 {\n   19             control.step_hours(1)?;\n   20             overfed.step_hours(1)?;\n   21 \n   22             let control_snapshot = control.snapshot();\n   23             let overfed_snapshot = overfed.snapshot();\n   24 \n   25             if !is_light_on(control_snapshot.hour, control_snapshot.photoperiod_hours) {\n   26                 control_nightly_min_do = control_nightly_min_do.min(control_snapshot.do_mg_l);\n   27             }\n   28             if !is_light_on(overfed_snapshot.hour, overfed_snapshot.photoperiod_hours) {\n   29                 overfed_nightly_min_do = overfed_nightly_min_do.min(overfed_snapshot.do_mg_l);\n   30             }\n   31         }\n   32     }\n   33 \n   34     let control_detritus = total_detritus_g(control.full_state());\n   35     let overfed_detritus = total_detritus_g(overfed.full_state());\n   36 \n   37     assert!(\n   38         overfed_detritus > control_detritus,\n   39         \"overfed tank should finish with more detritus: overfed={overfed_detritus:.3}, control={control_detritus:.3}\"\n   40     );\n   41     assert!(\n   42         overfed_nightly_min_do < control_nightly_min_do,\n   43         \"overfed tank should have a lower nightly DO minimum: overfed={overfed_nightly_min_do:.3}, control={control_nightly_min_do:.3}\"\n   44     );\n   45     assert!(\n   46         overfed.snapshot().algae_nuisance_index > control.snapshot().algae_nuisance_index,\n   47         \"overfed tank should have higher algae nuisance: overfed={:.3}, control={:.3}\",\n   48         overfed.snapshot().algae_nuisance_index,\n   49         control.snapshot().algae_nuisance_index\n   50     );\n   51 \n   52     Ok(())\n   53 }\n   54 \n   55 fn configured_state(seed: SimSeed) -> tank_core::TankState {\n   56     let mut state =\n   57         tank_scenarios::seeded_state(seed, \"warm_room\").expect(\"scenario should materialize\");\n   58     state.hardware.aeration.enabled = true;\n   59     state.hardware.aeration.intensity = 0.05;\n   60     state.hardware.light.photoperiod_hours = 12.0;\n   61     state.hardware.light.intensity_index = 1.0;\n   62     state.process_params.reaeration_kla_base *= 0.4;\n   63     state.process_params.aeration_kla_boost *= 0.25;\n   64     state.environment.ambient_temp_c = 29.5;\n   65     state.algae.suspended_biomass_g = 0.08;\n   66     state.algae.periphyton_biomass_g = 0.6;\n   67     for plant in &mut state.plant_guilds {\n   68         plant.biomass_g *= 0.5;\n   69     }\n   70     state\n   71 }\n   72 \n   73 fn total_detritus_g(state: &tank_core::TankState) -> f64 {\n   74     state.detritus.particulate_organics_g_total + state.detritus.fine_detritus_g_total\n   75 }\n","exit_code":0,"status":"completed"}}
