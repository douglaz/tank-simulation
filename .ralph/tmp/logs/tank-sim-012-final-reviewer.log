        ))\n  457             .borders(Borders::ALL),\n  458     );\n  459     frame.render_widget(fields, right[0]);\n  460 \n  461     let help = Paragraph::new(vec![\n  462         Line::from(\"Up/Down change action  Left/Right change field\"),\n  463         Line::from(\"Type digits or '.' to edit numeric fields  Backspace deletes\"),\n  464         Line::from(\"[ and ] cycle source water  t toggles booleans  Enter queues action\"),\n  465     ])\n  466     .block(Block::default().title(\"Controls\").borders(Borders::ALL))\n  467     .wrap(ratatui::widgets::Wrap { trim: true });\n  468     frame.render_widget(help, right[1]);\n  469 }\n  470 \n  471 fn parse_f64(field: &'static str, raw: &str) -> Result<f64, String> {\n  472     raw.parse::<f64>()\n  473         .map_err(|_| format!(\"{field} must be a number\"))\n  474 }\n  475 \n  476 fn parse_u32(field: &'static str, raw: &str) -> Result<u32, String> {\n  477     raw.parse::<u32>()\n  478         .map_err(|_| format!(\"{field} must be a whole number\"))\n  479 }\n  480 \n  481 #[cfg(test)]\n  482 mod tests {\n  483     use super::*;\n  484 \n  485     #[test]\n  486     fn builds_water_change_action_with_profile_selection() {\n  487         let mut form = ActionFormState::default();\n  488         form.select_next_action();\n  489         form.select_next_field();\n  490         form.cycle_choice(true);\n  491 \n  492         let action = form.submit().expect(\"water change action should parse\");\n  493         assert_eq!(\n  494             action,\n  495             PlayerAction::WaterChangePercent {\n  496                 percent: 25.0,\n  497                 source_profile_id: \"hard_shrimp\".to_string(),\n  498             }\n  499         );\n  500     }\n  501 \n  502     #[test]\n  503     fn rejects_invalid_integer_counts() {\n  504         let mut form = ActionFormState::default();\n  505         for _ in 0..5 {\n  506             form.select_next_action();\n  507         }\n  508         form.add_