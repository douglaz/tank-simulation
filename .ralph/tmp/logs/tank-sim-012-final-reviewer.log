{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"awk 'FNR==1{print \\\"FILE \\\" FILENAME} {printf \\\"%5d %s\\\\n\\\", FNR, \"'$0}'\"' crates/tank_core/src/systems/events.rs crates/tank_core/src/systems/microfauna.rs crates/tank_core/src/systems/algae_growth.rs\"","aggregated_output":"FILE crates/tank_core/src/systems/events.rs\n    1 use crate::{\n    2     systems::chemistry::compute_nh3_mg_l,\n    3     types::{EventCause, EventKind, EventSeverity, SimEvent, TankState},\n    4 };\n    5 \n    6 pub fn emit_hourly_threshold_events(state: &mut TankState) {\n    7     let volume_l = state.geometry.water_volume_l();\n    8     if volume_l <= f64::EPSILON {\n    9         return;\n   10     }\n   11 \n   12     let tan_mg_l = state.water.ammonia_total_mg_n_total / volume_l;\n   13     let nh3_mg_l = compute_nh3_mg_l(tan_mg_l, state.water.ph, state.water.temperature_c);\n   14     let nitrite_mg_l = state.water.nitrite_mg_n_total / volume_l;\n   15     let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n   16 \n   17     if nh3_mg_l >= 0.02 {\n   18         emit_once_per_day(\n   19             state,\n   20             EventSeverity::Warning,\n   21             EventKind::AmmoniaWarning,\n   22             vec![EventCause::HighAmmonia],\n   23             format!(\"Free ammonia reached {nh3_mg_l:.3} mg/L\"),\n   24         );\n   25     }\n   26     if nitrite_mg_l >= 0.5 {\n   27         emit_once_per_day(\n   28             state,\n   29             EventSeverity::Warning,\n   30             EventKind::NitriteWarning,\n   31             vec![EventCause::HighNitrite],\n   32             format!(\"Nitrite reached {nitrite_mg_l:.2} mg/L\"),\n   33         );\n   34     }\n   35     if do_mg_l < 4.0 {\n   36         emit_once_per_day(\n   37             state,\n   38             EventSeverity::Warning,\n   39             EventKind::OxygenDip,\n   40             vec![EventCause::LowOxygen],\n   41             format!(\"Dissolved oxygen dropped to {do_mg_l:.2} mg/L\"),\n   42         );\n   43     }\n   44 }\n   45 \n   46 pub fn emit_once_per_day_pub(\n   47     state: &mut TankState,\n   48     severity: EventSeverity,\n   49     kind: EventKind,\n   50     cause_codes: Vec<EventCause>,\n   51     summary: String,\n   52 ) {\n   53     emit_once_per_day(state, severity, kind, cause_codes, summary);\n   54 }\n   55 \n   56 pub fn emit_daily_algae_events(\n   57     state: &mut TankState,\n   58     previous_nuisance_index: f64,\n   59     periphyton_capacity_g: f64,\n   60 ) {\n   61     let volume_l = state.geometry.water_volume_l();\n   62     if previous_nuisance_index < 0.5 && state.algae.nuisance_index >= 0.5 {\n   63         emit_once_per_day(\n   64             state,\n   65             EventSeverity::Warning,\n   66             EventKind::AlgaeRiskRising,\n   67             vec![EventCause::HighNutrients, EventCause::PlantCrowding],\n   68             format!(\n   69                 \"Algae nuisance pressure rose to {:.2}\",\n   70                 state.algae.nuisance_index\n   71             ),\n   72         );\n   73     }\n   74 \n   75     if volume_l > f64::EPSILON {\n   76         let suspended_g_l = state.algae.suspended_biomass_g / volume_l;\n   77         if suspended_g_l >= state.process_params.algae_bloom_threshold_g_per_l {\n   78             emit_once_per_day(\n   79                 state,\n   80                 EventSeverity::Warning,\n   81                 EventKind::AlgaeBloom,\n   82                 vec![EventCause::HighNutrients],\n   83                 format!(\"Suspended algae reached {suspended_g_l:.3} g/L\"),\n   84             );\n   85         }\n   86     }\n   87 \n   88     if periphyton_capacity_g > f64::EPSILON {\n   89         let occupancy = state.algae.periphyton_biomass_g / periphyton_capacity_g;\n   90         let mean_low_oxygen_tendency = if state.substrate_layers.is_empty() {\n   91             0.0\n   92         } else {\n   93             state\n   94                 .substrate_layers\n   95                 .iter()\n   96                 .map(|layer| layer.low_oxygen_tendency_index)\n   97                 .sum::<f64>()\n   98                 / state.substrate_layers.len() as f64\n   99         };\n  100         if occupancy >= 0.8 && mean_low_oxygen_tendency >= 0.55 {\n  101             emit_once_per_day(\n  102                 state,\n  103                 EventSeverity::Warning,\n  104                 EventKind::SubstrateFoulingWarning,\n  105                 vec![EventCause::SurfaceSaturation, EventCause::LowOxygen],\n  106                 format!(\n  107                     \"Periphyton occupancy reached {:.0}% of surface capacity\",\n  108                     occupancy * 100.0\n  109                 ),\n  110             );\n  111         }\n  112     }\n  113 }\n  114 \n  115 fn emit_once_per_day(\n  116     state: &mut TankState,\n  117     severity: EventSeverity,\n  118     kind: EventKind,\n  119     cause_codes: Vec<EventCause>,\n  120     summary: String,\n  121 ) {\n  122     let key = format!(\"{kind:?}\");\n  123     if state.last_event_day.get(&key) == Some(&state.environment.day) {\n  124         return;\n  125     }\n  126 \n  127     state.event_log.push(SimEvent::new(\n  128         state.environment.day,\n  129         state.environment.hour_of_day,\n  130         severity,\n  131         kind,\n  132         cause_codes,\n  133         summary,\n  134     ));\n  135     state.last_event_day.insert(key, state.environment.day);\n  136 }\nFILE crates/tank_core/src/systems/microfauna.rs\n    1 use crate::types::TankState;\n    2 \n    3 /// Daily microfauna turnover: updates population_index and grazing_pressure_index\n    4 /// from detritus/periphyton resource availability and shrimp grazing pressure.\n    5 ///\n    6 /// Microfauna effects:\n    7 /// - Modestly improves mineralization efficiency (applied in nitrogen_cycle)\n    8 /// - Consumes some periphyton/bacterial resource\n    9 /// - Declines under heavy shrimp grazing\n   10 pub fn step_daily_microfauna(state: &mut TankState) {\n   11     let volume_l = state.geometry.water_volume_l();\n   12     if volume_l <= f64::EPSILON {\n   13         return;\n   14     }\n   15 \n   16     let pp = &state.process_params;\n   17 \n   18     // Resource availability (detritus + periphyton as food for microfauna)\n   19     // Reference densities are generous so microfauna don't over-respond to\n   20     // short-term feeding pulses.\n   21     let detritus_density = state.detritus.fine_detritus_g_total / volume_l;\n   22     let detritus_resource = (detritus_density / 2.0).clamp(0.0, 1.0);\n   23     let periphyton_density = state.algae.periphyton_biomass_g / volume_l;\n   24     let periphyton_resource = (periphyton_density / 1.0).clamp(0.0, 1.0);\n   25     let resource_availability =\n   26         (0.5 * detritus_resource + 0.5 * periphyton_resource).clamp(0.0, 1.0);\n   27 \n   28     // Shrimp grazing pressure on microfauna\n   29     let total_shrimp = (state.animal.adults_count + state.animal.juveniles_count) as f64;\n   30     let shrimp_density = total_shrimp / volume_l;\n   31     let shrimp_pressure =\n   32         (shrimp_density / pp.microfauna_shrimp_pressure_threshold.max(0.01)).clamp(0.0, 1.0);\n   33 \n   34     // Population target: grows with resources, declines with shrimp pressure\n   35     let growth_target = resource_availability * (1.0 - 0.6 * shrimp_pressure);\n   36     let smoothing = pp.microfauna_population_smoothing;\n   37     state.microfauna.population_index = (state.microfauna.population_index\n   38         + smoothing * (growth_target - state.microfauna.population_index))\n   39         .clamp(0.0, 1.0);\n   40 \n   41     // Grazing pressure reflects population and available food\n   42     state.microfauna.grazing_pressure_index =\n   43         (state.microfauna.population_index * resource_availability.sqrt()).clamp(0.0, 1.0);\n   44 \n   45     // Microfauna consume some periphyton (without driving it negative)\n   46     let consumption_fraction =\n   47         pp.microfauna_periphyton_consumption * state.microfauna.population_index;\n   48     let consumed = state.algae.periphyton_biomass_g * consumption_fraction;\n   49     state.algae.periphyton_biomass_g = (state.algae.periphyton_biomass_g - consumed).max(0.0);\n   50 \n   51     // Microfauna also process some fine detritus (modest)\n   52     let detritus_consumed =\n   53         state.detritus.fine_detritus_g_total * 0.01 * state.microfauna.population_index;\n   54     state.detritus.fine_detritus_g_total =\n   55         (state.detritus.fine_detritus_g_total - detritus_consumed).max(0.0);\n   56 }\nFILE crates/tank_core/src/systems/algae_growth.rs\n    1 use crate::{\n    2     systems::events,\n    3     types::{total_colonizable_area_cm2, TankState},\n    4 };\n    5 \n    6 const ALGAE_N_MG_PER_G_GROWTH: f64 = 35.0;\n    7 const ALGAE_P_MG_PER_G_GROWTH: f64 = 5.0;\n    8 \n    9 pub fn step_daily_algae(state: &mut TankState) {\n   10     let volume_l = state.geometry.water_volume_l();\n   11     if volume_l <= f64::EPSILON {\n   12         return;\n   13     }\n   14 \n   15     let previous_nuisance_index = state.algae.nuisance_index;\n   16     let light_factor = algae_light_factor(state);\n   17     let temp_factor = gaussian_response(\n   18         state.water.temperature_c,\n   19         state.process_params.algae_temp_optimum_c,\n   20         state.process_params.algae_temp_sigma_c,\n   21     );\n   22     let plant_shading = (1.0\n   23         - state\n   24             .plant_guilds\n   25             .iter()\n   26             .map(|plant| plant.crowding_index)\n   27             .sum::<f64>()\n   28             / state.plant_guilds.len().max(1) as f64\n   29             * 0.7)\n   30         .clamp(0.2, 1.0);\n   31     let nutrient_factor = half_saturation(\n   32         state.water.ammonia_total_mg_n_total + state.water.nitrate_mg_n_total,\n   33         state.process_params.algae_half_saturation_n_mg_total,\n   34     )\n   35     .min(half_saturation(\n   36         state.water.phosphate_mg_p_total,\n   37         state.process_params.algae_half_saturation_p_mg_total,\n   38     ));\n   39     let microfauna_grazing = (state.microfauna.population_index\n   40         * (0.3 + 0.7 * state.microfauna.grazing_pressure_index))\n   41         .clamp(0.0, 1.0);\n   42 \n   43     let suspended_seed_g = state.algae.suspended_biomass_g.max(0.02 * volume_l / 10.0);\n   44     let suspended_gross_growth_g = suspended_seed_g\n   45         * state.process_params.algae_max_growth_rate_per_day\n   46         * light_factor\n   47         * plant_shading\n   48         * temp_factor\n   49         * nutrient_factor;\n   50     let suspended_respiration_g =\n   51         state.algae.suspended_biomass_g * state.process_params.algae_respiration_fraction_per_day;\n   52     let suspended_grazing_g = state.algae.suspended_biomass_g * 0.03 * microfauna_grazing;\n   53     let suspended_new_g = (state.algae.suspended_biomass_g + suspended_gross_growth_g\n   54         - suspended_respiration_g\n   55         - suspended_grazing_g)\n   56         .max(0.0);\n   57     consume_algae_nutrients(\n   58         state,\n   59         suspended_gross_growth_g * ALGAE_N_MG_PER_G_GROWTH,\n   60         suspended_gross_growth_g * ALGAE_P_MG_PER_G_GROWTH,\n   61     );\n   62     state.algae.suspended_biomass_g = suspended_new_g;\n   63 \n   64     let colonizable_area_m2 =\n   65         total_colonizable_area_cm2(&state.substrate_layers, state.geometry.wall_area_cm2())\n   66             / 10_000.0;\n   67     let grazing_surface_factor =\n   68         0.7 + (0.3 * state.avg_substrate_index(|layer| layer.grazing_surface_index));\n   69     let periphyton_capacity_g = colonizable_area_m2.max(0.0)\n   70         * state.process_params.periphyton_capacity_g_per_m2\n   71         * grazing_surface_factor;\n   72     let surface_cap_factor = if periphyton_capacity_g <= f64::EPSILON {\n   73         0.0\n   74     } else {\n   75         (1.0 - (state.algae.periphyton_biomass_g / periphyton_capacity_g)).clamp(0.0, 1.0)\n   76     };\n   77     let periphyton_seed_g = state.algae.periphyton_biomass_g.max(0.05);\n   78     let periphyton_gross_growth_g = periphyton_seed_g\n   79         * state.process_params.periphyton_max_growth_rate_per_day\n   80         * light_factor\n   81         * plant_shading\n   82         * temp_factor\n   83         * nutrient_factor\n   84         * surface_cap_factor;\n   85     let periphyton_respiration_g =\n   86         state.algae.periphyton_biomass_g * state.process_params.algae_respiration_fraction_per_day;\n   87     let periphyton_grazing_g = state.algae.periphyton_biomass_g * 0.06 * microfauna_grazing;\n   88     let periphyton_new_g = (state.algae.periphyton_biomass_g + periphyton_gross_growth_g\n   89         - periphyton_respiration_g\n   90         - periphyton_grazing_g)\n   91         .max(0.0)\n   92         .min(periphyton_capacity_g.max(0.0));\n   93     consume_algae_nutrients(\n   94         state,\n   95         periphyton_gross_growth_g * ALGAE_N_MG_PER_G_GROWTH,\n   96         periphyton_gross_growth_g * ALGAE_P_MG_PER_G_GROWTH,\n   97     );\n   98     state.algae.periphyton_biomass_g = periphyton_new_g;\n   99 \n  100     let suspended_pressure = (state.algae.suspended_biomass_g / volume_l)\n  101         / state\n  102             .process_params\n  103             .algae_bloom_threshold_g_per_l\n  104             .max(f64::MIN_POSITIVE);\n  105     let periphyton_pressure = if periphyton_capacity_g <= f64::EPSILON {\n  106         0.0\n  107     } else {\n  108         state.algae.periphyton_biomass_g / periphyton_capacity_g\n  109     };\n  110     state.algae.nuisance_index =\n  111         (0.55 * suspended_pressure + 0.45 * periphyton_pressure).clamp(0.0, 1.0);\n  112 \n  113     events::emit_daily_algae_events(state, previous_nuisance_index, periphyton_capacity_g);\n  114 }\n  115 \n  116 fn algae_light_factor(state: &TankState) -> f64 {\n  117     if !state.hardware.light.enabled {\n  118         return 0.0;\n  119     }\n  120 \n  121     let photoperiod_factor = (state.hardware.light.photoperiod_hours / 9.0).clamp(0.0, 1.0);\n  122     half_saturation(\n  123         state.hardware.light.intensity_index * photoperiod_factor,\n  124         state.process_params.algae_light_half_saturation,\n  125     )\n  126 }\n  127 \n  128 fn consume_algae_nutrients(state: &mut TankState, n_demand_mg: f64, p_demand_mg: f64) {\n  129     let ammonia_removed = state.water.ammonia_total_mg_n_total.min(n_demand_mg * 0.6);\n  130     state.water.ammonia_total_mg_n_total -= ammonia_removed;\n  131 \n  132     let remaining_n = (n_demand_mg - ammonia_removed).max(0.0);\n  133     let nitrate_removed = state.water.nitrate_mg_n_total.min(remaining_n);\n  134     state.water.nitrate_mg_n_total -= nitrate_removed;\n  135 \n  136     let phosphate_removed = state.water.phosphate_mg_p_total.min(p_demand_mg);\n  137     state.water.phosphate_mg_p_total -= phosphate_removed;\n  138 }\n  139 \n  140 fn half_saturation(value: f64, half_sat: f64) -> f64 {\n  141     let half_sat = half_sat.max(f64::MIN_POSITIVE);\n  142     (value / (value + half_sat)).clamp(0.0, 1.0)\n  143 }\n  144 \n  145 fn gaussian_response(value: f64, optimum: f64, sigma: f64) -> f64 {\n  146     let sigma = sigma.max(0.1);\n  147     let diff = value - optimum;\n  148     (-(diff * diff) / (2.0 * sigma * sigma))\n  149         .exp()\n  150         .clamp(0.0, 1.0)\n  151 }\n","exit_code":0,"status":"completed"}}
