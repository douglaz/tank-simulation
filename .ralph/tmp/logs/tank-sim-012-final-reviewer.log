{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Nqdm41X31n6tbqa2UjqQms","type":"tool_result","content":"     1→use serde::{Deserialize, Serialize};\n     2→\n     3→use crate::{\n     4→    engine::{Engine, SimulationEngine},\n     5→    types::{PlayerAction, SimError, TankState},\n     6→};\n     7→\n     8→pub const SCHEMA_VERSION: u32 = 2;\n     9→pub const APP_VERSION: &str = env!(\"CARGO_PKG_VERSION\");\n    10→\n    11→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    12→pub struct SaveFile {\n    13→    pub schema_version: u32,\n    14→    pub app_version: String,\n    15→    pub state: TankState,\n    16→    pub queued_actions: Vec<PlayerAction>,\n    17→}\n    18→\n    19→impl SaveFile {\n    20→    pub fn new(state: TankState, queued_actions: Vec<PlayerAction>) -> Self {\n    21→        Self {\n    22→            schema_version: SCHEMA_VERSION,\n    23→            app_version: APP_VERSION.to_string(),\n    24→            state,\n    25→            queued_actions,\n    26→        }\n    27→    }\n    28→\n    29→    pub fn from_engine(engine: &Engine) -> Self {\n    30→        Self::new(engine.full_state().clone(), engine.queued_actions())\n    31→    }\n    32→\n    33→    pub fn to_json_pretty(&self) -> Result<String, SimError> {\n    34→        serde_json::to_string_pretty(self)\n    35→            .map_err(|error| SimError::Serialization(error.to_string()))\n    36→    }\n    37→\n    38→    pub fn from_json(json: &str) -> Result<Self, SimError> {\n    39→        let save: Self = serde_json::from_str(json)\n    40→            .map_err(|error| SimError::Deserialization(error.to_string()))?;\n    41→        if save.schema_version != SCHEMA_VERSION {\n    42→            return Err(SimError::SchemaVersionMismatch {\n    43→                expected: SCHEMA_VERSION,\n    44→                actual: save.schema_version,\n    45→            });\n    46→        }\n    47→        Ok(save)\n    48→    }\n    49→\n    50→    pub fn into_engine(self) -> Engine {\n    51→        Engine::from_parts(self.state, self.queued_actions)\n    52→    }\n    53→}\n    54→"}]},"parent_tool_use_id":"toolu_012EDB2wEDrNTKc9RkMxVE8g","session_id":"d9e19a3d-7c7f-4e59-85c1-196d8c055a3e","uuid":"25e63dfe-5434-48d0-919d-c953cfb7f935"}
