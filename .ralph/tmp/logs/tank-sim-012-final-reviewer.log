 {\n    53→    pub adults_count: u32,\n    54→    pub juveniles_count: u32,\n    55→    pub berried_females_count: u32,\n    56→    pub condition_index: f64,\n    57→    pub molt_stress_index: f64,\n    58→    pub reproductive_readiness_index: f64,\n    59→    pub egg_progress_days: f64,\n    60→    /// Per-cohort egg tracking for clutch-resolution invariant.\n    61→    #[serde(default)]\n    62→    pub egg_cohorts: Vec<EggCohort>,\n    63→    /// Hidden hourly stress accumulators, reset after daily processing.\n    64→    #[serde(default)]\n    65→    pub hourly_nh3_stress_accum: f64,\n    66→    #[serde(default)]\n    67→    pub hourly_nitrite_stress_accum: f64,\n    68→    #[serde(default)]\n    69→    pub hourly_low_do_stress_accum: f64,\n    70→    #[serde(default)]\n    71→    pub hourly_heat_stress_accum: f64,\n    72→    #[serde(default)]\n    73→    pub hourly_instability_stress_accum: f64,\n    74→    #[serde(default)]\n    75→    pub daily_food_consumed_g: f64,\n    76→}\n    77→\n    78→/// Species-specific shrimp parameters materialized from ShrimpPreset.\n    79→/// Stored in TankState for deterministic save/load.\n    80→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    81→pub struct ShrimpRuntimeParams {\n    82→    pub optimal_temp_min_c: f64,\n    83→    pub optimal_temp_max_c: f64,\n    84→    pub gh_min_d: f64,\n    85→    pub gh_max_d: f64,\n    86→    pub base_spawn_rate: f64,\n    87→    pub egg_duration_days: u32,\n    88→    pub hatch_success_base: f64,\n    89→    pub juvenile_sensitivity: f64,\n    90→    pub high_temp_repro_penalty_start_c: f64,\n    91→    pub high_temp_repro_penalty_full_c: f64,\n    92→}\n    93→\n    94→/// Tracks recent chemistry swings for shrimp stress calculations.\n    95→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    96→pub struct StabilityTracker {\n    97→    pub prev_temp_c: f64,\n    98→    pub prev_ph: f64,\n    99→    pub prev_gh_d: f64,\n   100→    pub prev_do_mg_l: f64,\n   101→    pub instability_index: f64,\n   102→}\n   103→\n   104→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n   105→pub struct DetritusState {\n   106→    pub particulate_organics_g_total: f64,\n   107→    pub fine_detritus_g_total: f64,\n   108→    pub dissolved_feed_residue_g_total: f64,\n   109→}\n   110→\n   111→impl Default for PlantGuildState {\n   112→    fn default() -> Self {\n   113→        Self {\n   114→            guild: PlantGuild::FastStem,\n   115→            biomass_g: 5.0,\n   116→            health_index: 0.8,\n   117→            crowding_index: 0.1,\n   118→            habitat_index: 0.8,\n   119→        }\n   120→    }\n   121→}\n   122→\n   123→impl Default for AlgaeState {\n   124→    fn default() -> Self {\n   125→        Self {\n   126→            suspended_biomass_g: 0.0,\n   127→            periphyton_biomass_g: 0.2,\n   128→            nuisance_index: 0.1,\n   129→        }\n   130→    }\n   131→}\n   132→\n   133→impl Default for MicrobeState {\n   134→    fn default() -> Self {\n   135→        Self {\n   136→            decomposer_biomass_g: 0.1,\n   137→            ammonia_oxidizer_biomass_g: 0.05,\n   138→            nitrite_oxidizer_biomass_g: 0.05,\n   139→            comammox_biomass_g: 0.01,\n   140→            maturity_index: 0.1,\n   141→        }\n   142→    }\n   143→}\n   144→\n   145→impl Default for MicrofaunaState {\n   146→    fn default() -> Self {\n   147→        Self {\n   148→            population_index: 0.2,\n   149→            grazing_pressure_index: 0.2,\n   150→        }\n   151→    }\n   152→}\n   153→\n   154→impl Default for AnimalState {\n   155→    fn default() -> Self {\n   156→        Self {\n   157→            adults_count: 0,\n   158→            juveniles_count: 0,\n   159→            berried_females_count: 0,\n   160→            condition_index: 0.8,\n   161→            molt_stress_index: 0.1,\n   162→            reproductive_readiness_index: 0.4,\n   163→            egg_progress_days: 0