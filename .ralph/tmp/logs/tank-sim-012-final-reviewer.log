{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"awk 'FNR==1{print \\\"FILE \\\" FILENAME} {printf \\\"%5d %s\\\\n\\\", FNR, \"'$0}'\"' crates/tank_core/tests/substrate_filter_integration.rs\"","aggregated_output":"FILE crates/tank_core/tests/substrate_filter_integration.rs\n    1 use tank_core::{\n    2     Engine, ProcessParams, SimSeed, SimulationEngine, SubstrateKind, SubstrateLayerState,\n    3     TankGeometry, TankState, WaterState,\n    4 };\n    5 \n    6 fn medium_geometry() -> TankGeometry {\n    7     TankGeometry {\n    8         length_cm: 40.0,\n    9         width_cm: 30.0,\n   10         height_cm: 35.0,\n   11         fill_height_cm: 30.0,\n   12         glass_thickness_mm: 5.0,\n   13         open_top: true,\n   14         lid_exchange_factor: 0.25,\n   15     }\n   16 }\n   17 \n   18 fn large_geometry() -> TankGeometry {\n   19     TankGeometry {\n   20         length_cm: 100.0,\n   21         width_cm: 40.0,\n   22         height_cm: 30.0,\n   23         fill_height_cm: 25.0,\n   24         glass_thickness_mm: 6.0,\n   25         open_top: true,\n   26         lid_exchange_factor: 0.25,\n   27     }\n   28 }\n   29 \n   30 fn base_state(seed: SimSeed, geometry: TankGeometry) -> TankState {\n   31     let water = WaterState::default_for_geometry(&geometry);\n   32     let mut state = TankState::new(seed);\n   33     state.geometry = geometry;\n   34     state.water = water;\n   35     state.environment.ambient_temp_c = 24.0;\n   36     state.water.temperature_c = 24.0;\n   37     state.process_params = ProcessParams::default();\n   38     state.process_params.shrimp_base_mortality_per_day = 0.0;\n   39     state.process_params.periphyton_capacity_g_per_m2 = 16.0;\n   40     state.hardware.light.enabled = false;\n   41     state.plant_guilds.clear();\n   42     state.algae.suspended_biomass_g = 0.0;\n   43     state.algae.periphyton_biomass_g = 0.0;\n   44     state.algae.nuisance_index = 0.0;\n   45     state.microfauna.population_index = 0.0;\n   46     state.microfauna.grazing_pressure_index = 0.0;\n   47 \n   48     let volume_l = state.geometry.water_volume_l();\n   49     state.water.alkalinity_meq_total = 8.0 * volume_l;\n   50     state.water.dissolved_inorganic_carbon_mg_c_total = 5.0 * volume_l;\n   51     state.water.dissolved_oxygen_mg_total = 8.0 * volume_l;\n   52     state.water.calcium_mg_total = 35.0 * volume_l;\n   53     state.water.magnesium_mg_total = 10.0 * volume_l;\n   54     state.water.bicarbonate_mg_total = 260.0 * volume_l;\n   55 \n   56     state.microbe.decomposer_biomass_g = 0.12;\n   57     state.microbe.ammonia_oxidizer_biomass_g = 0.05;\n   58     state.microbe.nitrite_oxidizer_biomass_g = 0.04;\n   59     state.microbe.comammox_biomass_g = 0.01;\n   60     state.filter_state.biofilter_maturity_index = 0.3;\n   61     state.hardware.filter.enabled = true;\n   62     state.hardware.filter.flow_lph = 200.0;\n   63     state.hardware.filter.cleanliness_index = 0.4;\n   64 \n   65     state.substrate_layers = vec![SubstrateLayerState {\n   66         kind: SubstrateKind::InertGravel,\n   67         depth_cm: 4.0,\n   68         nutrient_store_mg_n_total: 0.0,\n   69         nutrient_store_mg_p_total: 0.0,\n   70         cation_exchange_capacity_index: 0.1,\n   71         detritus_trapping_index: 0.2,\n   72         colonizable_area_cm2: 500.0,\n   73         low_oxygen_tendency_index: 0.2,\n   74         grazing_surface_index: 0.4,\n   75     }];\n   76 \n   77     state\n   78 }\n   79 \n   80 fn run_daily_feed(\n   81     engine: &mut Engine,\n   82     days: u32,\n   83     grams: f64,\n   84 ) -> Result<(f64, f64), tank_core::SimError> {\n   85     let mut peak_tan_mg_l = 0.0_f64;\n   86     let mut tan_exposure = 0.0_f64;\n   87 \n   88     for _ in 0..days {\n   89         engine.apply_action(tank_core::PlayerAction::Feed { grams })?;\n   90         for _ in 0..24 {\n   91             engine.step_hours(1)?;\n   92             let volume_l = engine.full_state().geometry.water_volume_l();\n   93             let tan_mg_l = engine.full_state().water.ammonia_total_mg_n_total / volume_l;\n   94             peak_tan_mg_l = peak_tan_mg_l.max(tan_mg_l);\n   95             tan_exposure += tan_mg_l;\n   96         }\n   97     }\n   98 \n   99     Ok((peak_tan_mg_l, tan_exposure))\n  100 }\n  101 \n  102 #[test]\n  103 fn substrate_trapping_divergence() -> Result<(), tank_core::SimError> {\n  104     let mut gravel_state = base_state(SimSeed(11_001), medium_geometry());\n  105     gravel_state.substrate_layers[0].kind = SubstrateKind::InertGravel;\n  106     gravel_state.substrate_layers[0].detritus_trapping_index = 0.2;\n  107 \n  108     let mut porous_state = gravel_state.clone();\n  109     porous_state.substrate_layers[0].kind = SubstrateKind::CoarsePorous;\n  110     porous_state.substrate_layers[0].detritus_trapping_index = 0.7;\n  111 \n  112     let mut gravel = Engine::from_parts(gravel_state, vec![]);\n  113     let mut porous = Engine::from_parts(porous_state, vec![]);\n  114 \n  115     let (gravel_peak_tan, _) = run_daily_feed(&mut gravel, 14, 0.35)?;\n  116     let (porous_peak_tan, _) = run_daily_feed(&mut porous, 14, 0.35)?;\n  117 \n  118     let gravel_particulate = gravel.full_state().detritus.particulate_organics_g_total;\n  119     let porous_particulate = porous.full_state().detritus.particulate_organics_g_total;\n  120 \n  121     assert!(\n  122         porous_particulate >= gravel_particulate * 1.10,\n  123         \"coarse porous substrate should retain at least 10% more particulate detritus: porous={porous_particulate:.3}, gravel={gravel_particulate:.3}\"\n  124     );\n  125     assert!(\n  126         porous_peak_tan < gravel_peak_tan,\n  127         \"coarse porous substrate should reduce peak TAN via slower release: porous={porous_peak_tan:.3} mg/L, gravel={gravel_peak_tan:.3} mg/L\"\n  128     );\n  129 \n  130     Ok(())\n  131 }\n  132 \n  133 #[test]\n  134 fn substrate_grazing_divergence() -> Result<(), tank_core::SimError> {\n  135     let mut low_grazing = base_state(SimSeed(11_002), medium_geometry());\n  136     low_grazing.hardware.light.enabled = true;\n  137     low_grazing.hardware.light.intensity_index = 0.8;\n  138     low_grazing.hardware.light.photoperiod_hours = 10.0;\n  139     low_grazing.hardware.aeration.enabled = true;\n  140     low_grazing.hardware.aeration.intensity = 0.8;\n  141     low_grazing.filter_state.biofilter_maturity_index = 1.0;\n  142     low_grazing.process_params.shrimp_stress_mortality_scale = 0.0;\n  143     low_grazing.microbe.ammonia_oxidizer_biomass_g = 0.25;\n  144     low_grazing.microbe.nitrite_oxidizer_biomass_g = 0.2;\n  145     low_grazing.microbe.comammox_biomass_g = 0.06;\n  146     low_grazing.water.ammonia_total_mg_n_total = 0.0;\n  147     low_grazing.water.nitrate_mg_n_total = 3.0 * low_grazing.geometry.water_volume_l();\n  148     low_grazing.water.phosphate_mg_p_total = 0.6 * low_grazing.geometry.water_volume_l();\n  149     low_grazing.algae.periphyton_biomass_g = 25.0;\n  150     low_grazing.detritus.fine_detritus_g_total = 18.0;\n  151     low_grazing.animal.adults_count = 8;\n  152     low_grazing.animal.condition_index = 0.55;\n  153     low_grazing.animal.molt_stress_index = 0.1;\n  154     low_grazing.animal.reproductive_readiness_index = 0.4;\n  155     low_grazing.shrimp_params.base_spawn_rate = 0.0;\n  156     low_grazing.substrate_layers[0].grazing_surface_index = 0.2;\n  157 \n  158     let mut high_grazing = low_grazing.clone();\n  159     high_grazing.substrate_layers[0].kind = SubstrateKind::CoarsePorous;\n  160     high_grazing.substrate_layers[0].grazing_surface_index = 0.9;\n  161 \n  162     let mut low = Engine::from_parts(low_grazing, vec![]);\n  163     let mut high = Engine::from_parts(high_grazing, vec![]);\n  164 \n  165     for _ in 0..30 {\n  166         low.step_hours(24)?;\n  167         high.step_hours(24)?;\n  168     }\n  169 \n  170     let low_condition = low.full_state().animal.condition_index;\n  171     let high_condition = high.full_state().animal.condition_index;\n  172 \n  173     assert!(\n  174         high_condition >= low_condition * 1.02,\n  175         \"high-grazing substrate should improve shrimp condition by at least 2%: high={high_condition:.3}, low={low_condition:.3}\"\n  176     );\n  177 \n  178     Ok(())\n  179 }\n  180 \n  181 #[test]\n  182 fn filter_enabled_vs_disabled() -> Result<(), tank_core::SimError> {\n  183     let mut filtered_state = base_state(SimSeed(11_003), medium_geometry());\n  184     filtered_state.hardware.filter.enabled = true;\n  185     filtered_state.hardware.filter.flow_lph = 200.0;\n  186     filtered_state.filter_state.biofilter_maturity_index = 0.2;\n  187     filtered_state.process_params.aob_vmax_mg_n_per_g_per_hour = 1.2;\n  188     filtered_state.process_params.nob_vmax_mg_n_per_g_per_hour = 4.0;\n  189     filtered_state.microbe.ammonia_oxidizer_biomass_g = 0.02;\n  190     filtered_state.microbe.nitrite_oxidizer_biomass_g = 0.12;\n  191     filtered_state.microbe.comammox_biomass_g = 0.002;\n  192     filtered_state.water.ammonia_total_mg_n_total = 1.5 * filtered_state.geometry.water_volume_l();\n  193     filtered_state.water.nitrite_mg_n_total = 1.0 * filtered_state.geometry.water_volume_l();\n  194 \n  195     let mut unfiltered_state = filtered_state.clone();\n  196     unfiltered_state.hardware.filter.enabled = false;\n  197 \n  198     let mut filtered = Engine::from_parts(filtered_state, vec![]);\n  199     let mut unfiltered = Engine::from_parts(unfiltered_state, vec![]);\n  200 \n  201     filtered.step_hours(24 * 30)?;\n  202     unfiltered.step_hours(24 * 30)?;\n  203 \n  204     let volume_l = filtered.full_state().geometry.water_volume_l();\n  205     let filtered_tan = filtered.full_state().water.ammonia_total_mg_n_total / volume_l;\n  206     let filtered_nitrite = filtered.full_state().water.nitrite_mg_n_total / volume_l;\n  207     let unfiltered_tan = unfiltered.full_state().water.ammonia_total_mg_n_total / volume_l;\n  208     let unfiltered_nitrite = unfiltered.full_state().water.nitrite_mg_n_total / volume_l;\n  209 \n  210     assert!(\n  211         filtered_tan < unfiltered_tan,\n  212         \"enabled filter should reach lower TAN after 30 days: filtered={filtered_tan:.3} mg/L, disabled={unfiltered_tan:.3} mg/L\"\n  213     );\n  214     assert!(\n  215         filtered_nitrite < unfiltered_nitrite,\n  216         \"enabled filter should reach lower nitrite after 30 days: filtered={filtered_nitrite:.3} mg/L, disabled={unfiltered_nitrite:.3} mg/L\"\n  217     );\n  218     assert!(\n  219         filtered.full_state().filter_state.biofilter_maturity_index\n  220             > unfiltered\n  221                 .full_state()\n  222                 .filter_state\n  223                 .biofilter_maturity_index,\n  224         \"enabled filter should build more biofilter maturity\"\n  225     );\n  226 \n  227     Ok(())\n  228 }\n  229 \n  230 #[test]\n  231 fn filter_flow_affects_cycling() -> Result<(), tank_core::SimError> {\n  232     let mut low_flow_state = base_state(SimSeed(11_004), large_geometry());\n  233     low_flow_state.hardware.filter.flow_lph = 50.0;\n  234     low_flow_state.filter_state.biofilter_maturity_index = 0.25;\n  235     low_flow_state.microbe.ammonia_oxidizer_biomass_g = 0.04;\n  236     low_flow_state.microbe.nitrite_oxidizer_biomass_g = 0.03;\n  237     low_flow_state.microbe.comammox_biomass_g = 0.008;\n  238 \n  239     let mut high_flow_state = low_flow_state.clone();\n  240     high_flow_state.hardware.filter.flow_lph = 400.0;\n  241 \n  242     let mut low_flow = Engine::from_parts(low_flow_state, vec![]);\n  243     let mut high_flow = Engine::from_parts(high_flow_state, vec![]);\n  244 \n  245     let (_, low_exposure) = run_daily_feed(&mut low_flow, 30, 0.60)?;\n  246     let (_, high_exposure) = run_daily_feed(&mut high_flow, 30, 0.60)?;\n  247 \n  248     let volume_l = low_flow.full_state().geometry.water_volume_l();\n  249     let low_final_tan = low_flow.full_state().water.ammonia_total_mg_n_total / volume_l;\n  250     let high_final_tan = high_flow.full_state().water.ammonia_total_mg_n_total / volume_l;\n  251 \n  252     assert!(\n  253         high_exposure < low_exposure,\n  254         \"higher filter flow should reduce cumulative TAN exposure: high={high_exposure:.3}, low={low_exposure:.3}\"\n  255     );\n  256     assert!(\n  257         high_final_tan < low_final_tan,\n  258         \"higher filter flow should clear TAN faster: high={high_final_tan:.3} mg/L, low={low_final_tan:.3} mg/L\"\n  259     );\n  260 \n  261     Ok(())\n  262 }\n","exit_code":0,"status":"completed"}}
