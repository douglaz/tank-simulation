\", state.algae.suspended_biomass_g)?;\n    76\t    check_non_negative(\n    77\t        \"algae.periphyton_biomass_g\",\n    78\t        state.algae.periphyton_biomass_g,\n    79\t    )?;\n    80\t    for layer in &state.substrate_layers {\n    81\t        check_non_negative(\"substrate.depth_cm\", layer.depth_cm)?;\n    82\t        check_non_negative(\n    83\t            \"substrate.nutrient_store_mg_n_total\",\n    84\t            layer.nutrient_store_mg_n_total,\n    85\t        )?;\n    86\t        check_non_negative(\n    87\t            \"substrate.nutrient_store_mg_p_total\",\n    88\t            layer.nutrient_store_mg_p_total,\n    89\t        )?;\n    90\t        check_non_negative(\"substrate.colonizable_area_cm2\", layer.colonizable_area_cm2)?;\n    91\t    }\n    92\t    check_non_negative(\"water.temperature_c\", state.water.temperature_c)?;\n    93\t    if state.water.temperature_c <= 0.0 {\n    94\t        return Err(SimError::TemperatureTooLow {\n    95\t            field: \"water.temperature_c\",\n    96\t            value: state.water.temperature_c,\n    97\t        });\n    98\t    }\n    99\t    if !state.water.ph.is_finite() {\n   100\t        return Err(SimError::InvariantViolation {\n   101\t            field: \"water.ph\",\n   102\t            value: state.water.ph,\n   103\t        });\n   104\t    }\n   105\t    state.water.ph = state.water.ph.clamp(5.5, 8.5);\n   106\t\n   107\t    state.geometry.lid_exchange_factor = state.geometry.lid_exchange_factor.clamp(0.0, 1.0);\n   108\t    state.hardware.light.intensity_index = state.hardware.light.intensity_index.clamp(0.0, 1.0);\n   109\t    state.hardware.filter.cleanliness_index =\n   110\t        state.hardware.filter.cleanliness_index.clamp(0.0, 1.0);\n   111\t    state.hardware.aeration.intensity = state.hardware.aeration.intensity.clamp(0.0, 1.0);\n   112\t    state.filter_state.biofilter_maturity_index =\n   113\t        state.filter_state.biofilter_maturity_index.clamp(0.0, 1.0);\n   114\t    state.filter_state.clogging_index = state.filter_state.clogging_index.clamp(0.0, 1.0);\n   115\t    state.filter_state.seeded_biomass_index =\n   116\t        state.filter_state.seeded_biomass_index.clamp(0.0, 1.0);\n   117\t    state.algae.nuisance_index = state.algae.nuisance_index.clamp(0.0, 1.0);\n   118\t    state.microbe.maturity_index = state.microbe.maturity_index.clamp(0.0, 1.0);\n   119\t    state.microfauna.population_index = state.microfauna.population_index.clamp(0.0, 1.0);\n   120\t    state.microfauna.grazing_pressure_index =\n   121\t        state.microfauna.grazing_pressure_index.clamp(0.0, 1.0);\n   122\t    state.animal.condition_index = state.animal.condition_index.clamp(0.0, 1.0);\n   123\t    state.animal.molt_stress_index = state.animal.molt_stress_index.clamp(0.0, 1.0);\n   124\t    state.animal.reproductive_readiness_index =\n   125\t        state.animal.reproductive_readiness_index.clamp(0.0, 1.0);\n   126\t    state.animal.daily_food_consumed_g = state.animal.daily_food_consumed_g.max(0.0);\n   127\t    // Shrimp population invariants: berried <= adults, no negative egg progress\n   128\t    state.animal.clamp_berried_to_adults();\n   129\t    state.animal.egg_progress_days = state.animal.egg_progress_days.max(0.0);\n   130\t    // Remove any empty cohorts\n   131\t    state.animal.egg_cohorts.retain(|c| c.count > 0);\n   132\t    state.stability_tracker.instability_index =\n   133\t        state.stability_tracker.instability_index.clamp(0.0, 1.0);\n   134\t\n   135\t    for plant in &mut state.plant_guilds {\n   136\t        plant.health_index = plant.health_index.clamp(0.0, 1.0);\n   137\t        plant.crowding_index = plant.crowding_index.clamp(0.0, 1.0);\n   138\t        plant.habitat_index = plant.habitat_index.clamp(0.0, 1.0);\n   139\t    }\n   140\t    for layer in &mut state.substrate_layers {\n   141\t        layer.cation_exchange_capacity_index = layer.cation_exchange_capacity_index.clamp(0.0, 1.0);\n   142\t        layer.detritus_trapping_index = layer.detritus_trapping_index.clamp(0.0, 1.0);\n   143\t        layer.low_oxygen_tendency_index = layer.low_oxygen_tendency_index.clamp(0.0, 1.0);\n   144\t        layer.grazing_surface_index = layer.grazing_surface_index.clamp(0.0, 1.0);\n   145\t    }\n   146\t\n   147\t    if state.event_log.len() > 200 {\n   148\t        let keep_from = state.event_log.len() - 200;\n   149\t        state.event_log.drain(0..keep_from);\n   150\t    }\n   151\t\n   152\t    Ok(())\n   153\t}\n   154\t\n   155\tfn check_non_negative(field: &'static str, value: f64) -> Result<(), SimError> {\n   156\t    if !value.is_finite() || value < 0.0 {\n   157\t        Err(SimError::InvariantViolation { field, value })\n   158\t    } else {\n   159\t        Ok(())\n   160\t    }\n   161\t}\n   162\tuse rand::{RngCore, SeedableRng};\n   163\tuse rand_chacha::ChaCha8Rng;\n   164\tuse serde::{de::Error as DeError, Deserialize, Deserializer, Serialize, Serializer};\n   165\t\n   166\t#[derive(Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq)]\n   167\tpub struct SimSeed(pub u64);\n   168\t\n   169\t#[derive(Debug, Clone)]\n   170\tpub struct SimRng {\n   171\t    seed: SimSeed,\n   172\t    draws: u64,\n   173\t    rng: ChaCha8Rng,\n   174\t}\n   175\t\n   176\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]\n   177\tstruct SimRngRepr {\n   178\t    seed: SimSeed,\n   179\t    draws: u64,\n   180\t}\n   181\t\n   182\timpl SimRng {\n   183\t    pub fn new(seed: SimSeed) -> Self {\n   184\t        let rng = ChaCha8Rng::from_seed(seed_to_bytes(seed));\n   185\t        Self {\n   186\t            seed,\n   187\t            draws: 0,\n   188\t            rng,\n   189\t        }\n   190\t    }\n   191\t\n   192\t    pub fn seed(&self) -> SimSeed {\n   193\t        self.seed\n   194\t    }\n   195\t\n   196\t    pub fn draws(&self) -> u64 {\n   197\t        self.draws\n   198\t    }\n   199\t\n   200\t    pub fn next_u64(&mut self) -> u64 {\n   201\t        let value = self.rng.next_u64();\n   202\t        self.draws += 1;\n   203\t        value\n   204\t    }\n   205\t\n   206\t    pub fn next_f64(&mut self) -> f64 {\n   207\t        let value = self.next_u64();\n   208\t        (value as f64) / (u64::MAX as f64)\n   209\t    }\n   210\t\n   211\t    fn from_repr(repr: SimRngRepr) -> Self {\n   212\t        let mut rng = ChaCha8Rng::from_seed(seed_to_bytes(repr.seed));\n   213\t        for _ in 0..repr.draws {\n   214\t            let _ = rng.next_u64();\n   215\t        }\n   216\t        Self {\n   217\t            seed: repr.seed,\n   218\t            draws: repr.draws,\n   219\t            rng,\n   220\t        }\n   221\t    }\n   222\t}\n   223\t\n   224\timpl PartialEq for SimRng {\n   225\t    fn eq(&self, other: &Self) -> bool {\n   226\t        self.seed == other.seed && self.draws == other.draws\n   227\t    }\n   228\t}\n   229\t\n   230\timpl Eq for SimRng {}\n   231\t\n   232\timpl Serialize for SimRng {\n   233\t    fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>\n   234\t    where\n   235\t        S: Serializer,\n   236\t    {\n   237\t        SimRngRepr {\n   238\t            seed: self.seed,\n   239\t            draws: self.draws,\n   240\t        }\n   241\t        .serialize(serializer)\n   242\t    }\n   243\t}\n   244\t\n   245\timpl<'de> Deserialize<'de> for SimRng {\n   246\t    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>\n   247\t    where\n   248\t        D: Deserializer<'de>,\n   249\t    {\n   250\t        let repr = SimRngRepr::deserialize(deserializer)?;\n   251\t        if repr.draws > u32::MAX as u64 && cfg!(debug_assertions) {\n   252\t            return Err(D::Error::custom(\"draw count is unexpectedly large\"));\n   253\t        }\n   254\t        Ok(Self::from_repr(repr))\n   255\t    }\n   256\t}\n   257\t\n   258\tfn seed_to_bytes(seed: SimSeed) -> [u8; 32] {\n   259\t    let mut bytes = [0_u8; 32];\n   260\t    for (index, chunk) in bytes.chunks_mut(8).enumerate() {\n   261\t        let word = seed\n   262\t            .0\n   263\t            .wrapping_add((index as u64).wrapping_mul(0x9E37_79B9_7F4A_7C15));\n   264\t        chunk.copy_from_slice(&word.to_le_bytes());\n   265\t    }\n   266\t    bytes\n   267\t}\n   268\tuse serde::{Deserialize, Serialize};\n   269\t\n   270\tuse crate::{\n   271\t    engine::{Engine, SimulationEngine},\n   272\t    types::{PlayerAction, SimError, TankState},\n   273\t};\n   274\t\n   275\tpub const SCHEMA_VERSION: u32 = 2;\n   276\tpub const APP_VERSION: &str = env!(\"CARGO_PKG_VERSION\");\n   277\t\n   278\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n   279\tpub struct SaveFile {\n   280\t    pub schema_version: u32,\n   281\t    pub app_version: String,\n   282\t    pub state: TankState,\n   283\t    pub queued_actions: Vec<PlayerAction>,\n   284\t}\n   285\t\n   286\timpl SaveFile {\n   287\t    pub fn new(state: TankState, queued_actions: Vec<PlayerAction>) -> Self {\n   288\t        Self {\n   289\t            schema_version: SCHEMA_VERSION,\n   290\t            app_version: APP_VERSION.to_string(),\n   291\t            state,\n   292\t            queued_actions,\n   293\t        }\n   294\t    }\n   295\t\n   296\t    pub fn from_engine(engine: &Engine) -> Self {\n   297\t        Self::new(engine.full_state().clone(), engine.queued_actions())\n   298\t    }\n   299\t\n   300\t    pub fn to_json_pretty(&self) -> Result<String, SimError> {\n   301\t        serde_json::to_string_pretty(self)\n   302\t            .map_err(|error| SimError::Serialization(error.to_string()))\n   303\t    }\n   304\t\n   305\t    pub fn from_json(json: &str) -> Result<Self, SimError> {\n   306\t        let save: Self = serde_json::from_str(json)\n   307\t            .map_err(|error| SimError::Deserialization(error.to_string()))?;\n   308\t        if save.schema_version != SCHEMA_VERSION {\n   309\t            return Err(SimError::SchemaVersionMismatch {\n   310\t                expected: SCHEMA_VERSION,\n   311\t                actual: save.schema_version,\n   312\t            });\n   313\t        }\n   314\t        Ok(save)\n   315\t    }\n   316\t\n   317\t    pub fn into_engine(self) -> Engine {\n   318\t        Engine::from_parts(self.state, self.queued_actions)\n   319\t    }\n   320\t}\n","exit_code":0,"status":"completed"}}
