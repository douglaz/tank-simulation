{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XzPhwLFn3MnPE2Uc5Dnxze","type":"tool_result","content":"     1→use tank_core::{\n     2→    EggCohort, Engine, EventKind, PlayerAction, ProcessParams, SimError, SimSeed, SimulationEngine,\n     3→    TankState,\n     4→};\n     5→\n     6→/// Creates a well-conditioned tank with shrimp for population tests.\n     7→fn shrimp_test_state(seed: SimSeed) -> TankState {\n     8→    let geometry = tank_core::TankGeometry {\n     9→        length_cm: 40.0,\n    10→        width_cm: 30.0,\n    11→        height_cm: 35.0,\n    12→        fill_height_cm: 30.0,\n    13→        glass_thickness_mm: 5.0,\n    14→        open_top: true,\n    15→        lid_exchange_factor: 0.25,\n    16→    };\n    17→    let water = tank_core::WaterState::default_for_geometry(&geometry);\n    18→\n    19→    let mut state = TankState::new(seed);\n    20→    state.geometry = geometry;\n    21→    state.water = water;\n    22→    state.water.temperature_c = 24.0;\n    23→    state.environment.ambient_temp_c = 24.0;\n    24→\n    25→    let vol = state.geometry.water_volume_l();\n    26→    state.water.calcium_mg_total = 40.0 * vol;\n    27→    state.water.magnesium_mg_total = 10.0 * vol;\n    28→    state.water.alkalinity_meq_total = 8.0 * vol; // high buffer to avoid pH crash from nitrification\n    29→    state.water.dissolved_inorganic_carbon_mg_c_total = 5.0 * vol;\n    30→    state.water.dissolved_oxygen_mg_total = 8.0 * vol;\n    31→    state.water.bicarbonate_mg_total = 300.0 * vol;\n    32→    state.algae.periphyton_biomass_g = 5.0;\n    33→\n    34→    state.microbe.decomposer_biomass_g = 0.1;\n    35→    state.microbe.ammonia_oxidizer_biomass_g = 0.8;\n    36→    state.microbe.nitrite_oxidizer_biomass_g = 0.5;\n    37→    state.microbe.comammox_biomass_g = 0.15;\n    38→    state.filter_state.biofilter_maturity_index = 1.0;\n    39→\n    40→    state.hardware.aeration.enabled = true;\n    41→    state.hardware.aeration.intensity = 0.3;\n    42→    state.hardware.light.enabled = true;\n    43→    state.hardware.light.intensity_index = 0.6;\n    44→    state.hardware.light.photoperiod_hours = 8.0;\n    45→\n    46→    state.animal.adults_count = 10;\n    47→    state.animal.condition_index = 0.8;\n    48→    state.animal.molt_stress_index = 0.1;\n    49→    state.animal.reproductive_readiness_index = 0.5;\n    50→\n    51→    state.process_params = ProcessParams::default();\n    52→    // Mature biofilter: faster nitrification to keep TAN near zero\n    53→    state.process_params.aob_vmax_mg_n_per_g_per_hour = 5.0;\n    54→    state.process_params.nob_vmax_mg_n_per_g_per_hour = 5.0;\n    55→    // Well-established tank with good colonizable surfaces for periphyton\n    56→    state.process_params.periphyton_capacity_g_per_m2 = 30.0;\n    57→\n    58→    // Initialize stability tracker from actual state to avoid day-1 instability spike\n    59→    let ca_mg_l = state.water.calcium_mg_total / vol;\n    60→    let mg_mg_l = state.water.magnesium_mg_total / vol;\n    61→    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n    62→    state.stability_tracker.prev_temp_c = state.water.temperature_c;\n    63→    state.stability_tracker.prev_gh_d = gh_d;\n    64→    state.stability_tracker.prev_do_mg_l = state.water.dissolved_oxygen_mg_total / vol;\n    65→    // pH will be computed on first tick; use a reasonable estimate\n    66→    state.stability_tracker.prev_ph = 7.5;\n    67→\n    68→    state\n    69→}\n    70→\n    71→#[test]\n    72→fn spawning_creates_berried_females() -> Result<(), SimError> {\n    73→    let mut engine = Engine::from_parts(shrimp_test_state(SimSeed(7000)), vec![]);\n    74→\n    75→    // Run for 30 days with light feeding\n    76→    for _ in 0..30 {\n    77→        engine.apply_action(PlayerAction::Feed { grams: 0.1 })?;\n    78→        engine.step_hours(24)?;\n    79→    }\n    80→\n    81→    let state = engine.full_state();\n    82→    let events = &state.event_log;\n    83→\n    84→    // Over 30 days at good conditions, we should see ShrimpBerried events\n    85→    let berried_events = events\n    86→        .iter()\n    87→        .filter(|e| e.kind == EventKind::ShrimpBerried)\n    88→        .count();\n    89→    assert!(\n    90→        berried_events > 0,\n    91→        \"Should have at least one ShrimpBerried event in 30 days of good conditions\"\n    92→    );\n    93→\n    94→    // All ShrimpBerried events must have non-empty cause codes\n    95→    for e in events.iter().filter(|e| e.kind == EventKind::ShrimpBerried) {\n    96→        assert!(\n    97→            !e.cause_codes.is_empty(),\n    98→            \"ShrimpBerried must have cause codes\"\n    99→        );\n   100→    }\n   101→\n   102→    Ok(())\n   103→}\n   104→\n   105→#[test]\n   106→fn hatch_produces_juveniles() -> Result<(), SimError> {\n   107→    let mut engine = Engine::from_parts(shrimp_test_state(SimSeed(7100)), vec![]);\n   108→\n   109→    // Run for 60 days - enough for spawning + egg development (21 days) + hatching\n   110→    for _ in 0..60 {\n   111→        engine.apply_action(PlayerAction::Feed { grams: 0.1 })?;\n   112→        engine.step_hours(24)?;\n   113→    }\n   114→\n   115→    let snap = engine.snapshot();\n   116→    // In good conditions over 60 days, at least some juveniles should appear\n   117→    // (10 adults, 21-day egg cycle, good conditions)\n   118→    assert!(\n   119→        snap.juveniles_count > 0 || snap.adult_shrimp_count > 10,\n   120→        \"After 60 days in good conditions, population should have grown. \\\n   121→         Adults: {}, Juveniles: {}\",\n   122→        snap.adult_shrimp_count,\n   123→        snap.juveniles_count\n   124→    );\n   125→\n   126→    Ok(())\n   127→}\n   128→\n   129→#[test]\n   130→fn egg_failure_under_stress() -> Result<(), SimError> {\n   131→    let mut state = shrimp_test_state(SimSeed(7200));\n   132→    // Force berried state with cohort tracking\n   133→    state.animal.berried_females_count = 3;\n   134→    state.animal.egg_progress_days = 20.0; // About to hatch\n   135→    state.animal.egg_cohorts = vec![EggCohort {\n   136→        count: 3,\n   137→        progress_days: 20.0,\n   138→    }];\n   139→\n   140→    // Create stressful conditions: low DO, high temp\n   141→    let vol = state.geometry.water_volume_l();\n   142→    state.water.dissolved_oxygen_mg_total = 2.0 * vol; // Low DO\n   143→    state.water.temperature_c = 32.0;\n   144→    state.environment.ambient_temp_c = 32.0;\n   145→    state.water.calcium_mg_total = 5.0 * vol; // Low minerals\n   146→    state.water.magnesium_mg_total = 1.0 * vol;\n   147→\n   148→    let mut engine = Engine::from_parts(state, vec![]);\n   149→    // Run one day to trigger clutch resolution\n   150→    engine.step_hours(24)?;\n   151→\n   152→    let events = &engine.full_state().event_log;\n   153→    let egg_failures = events\n   154→        .iter()\n   155→        .filter(|e| e.kind == EventKind::EggFailure)\n   156→        .collect::<Vec<_>>();\n   157→\n   158→    // Under these stressful conditions, egg failures should occur\n   159→    assert!(\n   160→        !egg_failures.is_empty(),\n   161→        \"Should have EggFailure events under stress\"\n   162→    );\n   163→\n   164→    // EggFailure must have cause codes tied to oxygen, temperature, minerals, or instability\n   165→    for e in &egg_failures {\n   166→        assert!(\n   167→            !e.cause_codes.is_empty(),\n   168→            \"EggFailure must have non-empty cause_codes\"\n   169→        );\n   170→    }\n   171→\n   172→    // Failure invariant: berried_females_count resolved (back to 0)\n   173→    let state = engine.full_state();\n   174→    assert_eq!(state.animal.berried_females_count, 0);\n   175→    assert_eq!(state.animal.egg_progress_days, 0.0);\n   176→\n   177→    Ok(())\n   178→}\n   179→\n   180→#[test]\n   181→fn mortality_under_combined_stress() -> Result<(), SimError> {\n   182→    let mut state = shrimp_test_state(SimSeed(7300));\n   183→    state.animal.adults_count = 20;\n   184→    state.animal.juveniles_count = 10;\n   185→\n   186→    // Create combined low-DO + high-NH3 stress\n   187→    let vol = state.geometry.water_volume_l();\n   188→    state.water.dissolved_oxygen_mg_total = 1.5 * vol; // Very low DO\n   189→    state.water.ammonia_total_mg_n_total = 2.0 * vol; // Very high ammonia\n   190→    state.water.alkalinity_meq_total = 8.0 * vol; // High pH -> more NH3\n   191→    state.process_params.reaeration_kla_base = 0.05; // Slow recovery\n   192→\n   193→    let mut engine = Engine::from_parts(state, vec![]);\n   194→\n   195→    // Run 14 days under stress\n   196→    for _ in 0..14 {\n   197→        engine.step_hours(24)?;\n   198→    }\n   199→\n   200→    let snap = engine.snapshot();\n   201→    let total_survivors = snap.adult_shrimp_count + snap.juveniles_count;\n   202→    assert!(\n   203→        total_survivors < 30,\n   204→        \"Population should decline under combined stress. Survivors: {}\",\n   205→        total_survivors\n   206→    );\n   207→\n   208→    Ok(())\n   209→}\n   210→\n   211→#[test]\n   212→fn microfauna_suppression_under_heavy_grazing() -> Result<(), SimError> {\n   213→    // Tank with many shrimp should suppress microfauna\n   214→    let mut state = shrimp_test_state(SimSeed(7400));\n   215→    state.animal.adults_count = 50; // Heavy stocking\n   216→    state.microfauna.population_index = 0.8; // Start with healthy microfauna\n   217→\n   218→    let initial_pop = state.microfauna.population_index;\n   219→\n   220→    let mut engine = Engine::from_parts(state, vec![]);\n   221→    for _ in 0..30 {\n   222→        engine.apply_action(PlayerAction::Feed { grams: 0.3 })?;\n   223→        engine.step_hours(24)?;\n   224→    }\n   225→\n   226→    let snap = engine.snapshot();\n   227→    assert!(\n   228→        snap.microfauna_population_index < initial_pop,\n   229→        \"Heavy shrimp grazing should suppress microfauna. Start: {}, End: {}\",\n   230→        initial_pop,\n   231→        snap.microfauna_population_index\n   232→    );\n   233→\n   234→    Ok(())\n   235→}\n   236→\n   237→#[test]\n   238→fn shrimp_removal_validation() -> Result<(), SimError> {\n   239→    let mut state = shrimp_test_state(SimSeed(7500));\n   240→    state.animal.adults_count = 5;\n   241→    state.animal.berried_females_count = 2;\n   242→\n   243→    let mut engine = Engine::from_parts(state, vec![]);\n   244→\n   245→    // Try to remove more than available\n   246→    let result = engine.apply_action(PlayerAction::RemoveShrimp { count: 10 });\n   247→    assert!(\n   248→        matches!(result, Err(SimError::ShrimpRemovalExceedsAvailable { .. })),\n   249→        \"Should fail when removing more shrimp than available\"\n   250→    );\n   251→\n   252→    // Verify state is unchanged after failed removal\n   253→    assert_eq!(engine.full_state().animal.adults_count, 5);\n   254→    assert_eq!(engine.full_state().animal.berried_females_count, 2);\n   255→\n   256→    // Remove valid amount\n   257→    engine.apply_action(PlayerAction::RemoveShrimp { count: 3 })?;\n   258→    engine.step_hours(1)?;\n   259→\n   260→    let state = engine.full_state();\n   261→    assert_eq!(state.animal.adults_count, 2);\n   262→    // berried_females_count must be <= adults_count\n   263→    assert!(\n   264→        state.animal.berried_females_count <= state.animal.adults_count,\n   265→        \"berried_females ({}) must be <= adults ({})\",\n   266→        state.animal.berried_females_count,\n   267→        state.animal.adults_count\n   268→    );\n   269→\n   270→    Ok(())\n   271→}\n   272→\n   273→#[test]\n   274→fn shrimp_removal_accounts_for_queued_actions() -> Result<(), SimError> {\n   275→    let mut state = shrimp_test_state(SimSeed(7600));\n   276→    state.animal.adults_count = 5;\n   277→\n   278→    let mut engine = Engine::from_parts(state, vec![]);\n   279→\n   280→    // Queue removal of 3\n   281→    engine.apply_action(PlayerAction::RemoveShrimp { count: 3 })?;\n   282→\n   283→    // Try to remove 3 more (only 2 should be available)\n   284→    let result = engine.apply_action(PlayerAction::RemoveShrimp { count: 3 });\n   285→    assert!(\n   286→        matches!(result, Err(SimError::ShrimpRemovalExceedsAvailable { .. })),\n   287→        \"Should fail because only 2 adults remain after pending removal\"\n   288→    );\n   289→\n   290→    // But removing 2 should succeed\n   291→    engine.apply_action(PlayerAction::RemoveShrimp { count: 2 })?;\n   292→\n   293→    Ok(())\n   294→}\n   295→\n   296→#[test]\n   297→fn population_fields_never_negative() -> Result<(), SimError> {\n   298→    let mut state = shrimp_test_state(SimSeed(7700));\n   299→    state.animal.adults_count = 3;\n   300→    state.animal.juveniles_count = 2;\n   301→\n   302→    // Very hostile environment\n   303→    let vol = state.geometry.water_volume_l();\n   304→    state.water.dissolved_oxygen_mg_total = 0.5 * vol;\n   305→    state.water.ammonia_total_mg_n_total = 5.0 * vol;\n   306→\n   307→    let mut engine = Engine::from_parts(state, vec![]);\n   308→\n   309→    // Run many days under extreme stress\n   310→    for _ in 0..60 {\n   311→        engine.step_hours(24)?;\n   312→    }\n   313→\n   314→    let state = engine.full_state();\n   315→    // All population counts must be non-negative (u32 can't be negative, but check invariants)\n   316→    assert!(state.animal.condition_index >= 0.0);\n   317→    assert!(state.animal.condition_index <= 1.0);\n   318→    assert!(state.animal.molt_stress_index >= 0.0);\n   319→    assert!(state.animal.molt_stress_index <= 1.0);\n   320→    assert!(state.animal.reproductive_readiness_index >= 0.0);\n   321→    assert!(state.animal.reproductive_readiness_index <= 1.0);\n   322→    assert!(state.animal.berried_females_count <= state.animal.adults_count);\n   323→\n   324→    Ok(())\n   325→}\n   326→"}]},"parent_tool_use_id":"toolu_018wJBWtH7pLKB2tEx9VS9ZM","session_id":"d9e19a3d-7c7f-4e59-85c1-196d8c055a3e","uuid":"a459716c-9145-4707-baa5-64ab17b487b9"}
