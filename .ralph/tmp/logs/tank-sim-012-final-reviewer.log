{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/src/engine.rs | sed -n '1,220p'\"","aggregated_output":"     1\tuse std::collections::VecDeque;\n     2\t\n     3\tuse crate::{\n     4\t    invariants::enforce_invariants,\n     5\t    rng::SimSeed,\n     6\t    systems,\n     7\t    types::{\n     8\t        EventCause, EventKind, EventSeverity, PlayerAction, SimError, SimEvent, TankSnapshot,\n     9\t        TankState,\n    10\t    },\n    11\t};\n    12\t\n    13\tpub trait SimulationEngine {\n    14\t    fn apply_action(&mut self, action: PlayerAction) -> Result<(), SimError>;\n    15\t    fn step_hours(&mut self, hours: u32) -> Result<(), SimError>;\n    16\t    fn snapshot(&self) -> TankSnapshot;\n    17\t    fn full_state(&self) -> &TankState;\n    18\t}\n    19\t\n    20\t#[derive(Debug, Clone, PartialEq)]\n    21\tpub struct Engine {\n    22\t    state: TankState,\n    23\t    queued_actions: VecDeque<PlayerAction>,\n    24\t}\n    25\t\n    26\timpl Engine {\n    27\t    pub fn new(seed: SimSeed) -> Self {\n    28\t        Self {\n    29\t            state: TankState::new(seed),\n    30\t            queued_actions: VecDeque::new(),\n    31\t        }\n    32\t    }\n    33\t\n    34\t    pub fn from_parts(state: TankState, queued_actions: Vec<PlayerAction>) -> Self {\n    35\t        Self {\n    36\t            state,\n    37\t            queued_actions: queued_actions.into(),\n    38\t        }\n    39\t    }\n    40\t\n    41\t    pub fn queued_actions(&self) -> Vec<PlayerAction> {\n    42\t        self.queued_actions.iter().cloned().collect()\n    43\t    }\n    44\t\n    45\t    fn step_one_hour(&mut self) -> Result<(), SimError> {\n    46\t        let actions_slice: Vec<_> = self.queued_actions.iter().cloned().collect();\n    47\t        systems::water_change::validate_water_changes(&self.state, &actions_slice)?;\n    48\t\n    49\t        while let Some(action) = self.queued_actions.pop_front() {\n    50\t            self.process_action(action);\n    51\t        }\n    52\t\n    53\t        // Step 4: update water temperature from ambient and heater\n    54\t        systems::temperature::step_temperature(&mut self.state);\n    55\t\n    56\t        // Step 5: compute light state for the current hour.\n    57\t        let light_on = self.state.hardware.light.enabled\n    58\t            && systems::light::is_light_on(\n    59\t                self.state.environment.hour_of_day,\n    60\t                self.state.hardware.light.photoperiod_hours,\n    61\t            );\n    62\t\n    63\t        // Step 6-8: nitrogen cycle phase (feed leaching, detritus breakdown,\n    64\t        // mineralization, nitrification, guild growth/decay).\n    65\t        // This runs between light-state resolution and chemistry/DO/event phases.\n    66\t        // Nitrification O2 consumption and alkalinity depletion are handled\n    67\t        // internally by the nitrogen cycle system.\n    68\t        let _nc_output = systems::nitrogen_cycle::step_nitrogen_cycle(&mut self.state);\n    69\t\n    70\t        // Step 9: update DIC, alkalinity, and pH.\n    71\t        systems::chemistry::step_hourly_chemistry(&mut self.state, light_on);\n    72\t\n    73\t        // Step 10 / 11-partial: update dissolved oxygen with background respiration and\n    74\t        // light-driven photosynthetic support from existing biomass.\n    75\t        systems::dissolved_oxygen::step_dissolved_oxygen(&mut self.state, light_on);\n    76\t\n    77\t        // Step 12: hourly shrimp stress accumulation.\n    78\t        systems::shrimp::step_hourly_shrimp_stress(&mut self.state);\n    79\t\n    80\t        // Step 13: emit threshold-based chemistry warnings.\n    81\t        systems::events::emit_hourly_threshold_events(&mut self.state);\n    82\t\n    83\t        self.state.environment.hour_of_day = (self.state.environment.hour_of_day + 1) % 24;\n    84\t        if self.state.environment.hour_of_day == 0 {\n    85\t            self.state.environment.day += 1;\n    86\t            // Daily pipeline\n    87\t            self.run_daily_update();\n    88\t        }\n    89\t\n    90\t        enforce_invariants(&mut self.state)\n    91\t    }\n    92\t\n    93\t    fn run_daily_update(&mut self) {\n    94\t        // Daily pipeline: plants → algae → microfauna → shrimp → biofilter → stability\n    95\t        systems::plant_growth::step_daily_plants(&mut self.state);\n    96\t        systems::algae_growth::step_daily_algae(&mut self.state);\n    97\t        systems::microfauna::step_daily_microfauna(&mut self.state);\n    98\t        systems::shrimp::step_daily_shrimp(&mut self.state);\n    99\t        systems::nitrogen_cycle::update_daily_filter_clogging(&mut self.state);\n   100\t\n   101\t        // Biofilter maturity summary update\n   102\t        let maturity_delta =\n   103\t            systems::nitrogen_cycle::update_daily_biofilter_maturity(&mut self.state);\n   104\t        if maturity_delta > 0.005 {\n   105\t            self.push_event(\n   106\t                EventSeverity::Info,\n   107\t                EventKind::BiofilmMaturityIncrease,\n   108\t                vec![EventCause::BiofilterImmature],\n   109\t                format!(\n   110\t                    \"Biofilter maturity increased to {:.3}\",\n   111\t                    self.state.filter_state.biofilter_maturity_index\n   112\t                ),\n   113\t            );\n   114\t        }\n   115\t        // Emit CycleProgressing when maturity is actively growing\n   116\t        let current_maturity = self.state.filter_state.biofilter_maturity_index;\n   117\t        if maturity_delta > 0.001 && current_maturity < 0.9 {\n   118\t            systems::events::emit_once_per_day_pub(\n   119\t                &mut self.state,\n   120\t                EventSeverity::Info,\n   121\t                EventKind::CycleProgressing,\n   122\t                vec![EventCause::BiofilterImmature],\n   123\t                format!(\"Nitrogen cycle progressing, maturity {current_maturity:.3}\"),\n   124\t            );\n   125\t        }\n   126\t\n   127\t        // Long-term stability metrics\n   128\t        systems::shrimp::update_stability_tracker(&mut self.state);\n   129\t    }\n   130\t\n   131\t    fn process_action(&mut self, action: PlayerAction) {\n   132\t        match action {\n   133\t            PlayerAction::Feed { grams } => {\n   134\t                self.state.detritus.particulate_organics_g_total += grams;\n   135\t                self.push_event(\n   136\t                    EventSeverity::Info,\n   137\t                    EventKind::CycleProgressing,\n   138\t                    vec![EventCause::Overfeeding],\n   139\t                    format!(\"Queued feed processed: {grams:.2} g\"),\n   140\t                );\n   141\t            }\n   142\t            PlayerAction::WaterChangePercent {\n   143\t                percent,\n   144\t                source_profile_id,\n   145\t            } => {\n   146\t                if percent <= 0.0 {\n   147\t                    return;\n   148\t                }\n   149\t                // Profile was pre-validated; look it up (guaranteed to exist).\n   150\t                let profile = self\n   151\t                    .state\n   152\t                    .source_water_catalog\n   153\t                    .get(&source_profile_id)\n   154\t                    .cloned();\n   155\t                if let Some(profile) = profile {\n   156\t                    systems::water_change::apply_water_change(&mut self.state, percent, &profile);\n   157\t                    self.push_event(\n   158\t                        EventSeverity::Info,\n   159\t                        EventKind::StabilityImproving,\n   160\t                        vec![EventCause::WaterChange],\n   161\t                        format!(\"Water change processed: {percent:.1}% with {source_profile_id}\"),\n   162\t                    );\n   163\t                }\n   164\t            }\n   165\t            PlayerAction::TrimPlants { fraction } => {\n   166\t                let mut trimmed_biomass_g = 0.0;\n   167\t                for plant in &mut self.state.plant_guilds {\n   168\t                    let trimmed = plant.biomass_g * fraction;\n   169\t                    plant.biomass_g -= trimmed;\n   170\t                    trimmed_biomass_g += trimmed;\n   171\t                }\n   172\t                self.state.detritus.fine_detritus_g_total += trimmed_biomass_g;\n   173\t            }\n   174\t            PlayerAction::SiphonDetritus { fraction } => {\n   175\t                self.state.detritus.particulate_organics_g_total *= 1.0 - fraction;\n   176\t                self.state.detritus.fine_detritus_g_total *= 1.0 - fraction;\n   177\t            }\n   178\t            PlayerAction::CleanFilter { intensity } => {\n   179\t                self.state.hardware.filter.cleanliness_index = 1.0;\n   180\t                self.state.filter_state.biofilter_maturity_index *= 1.0 - (intensity * 0.5);\n   181\t                self.state.filter_state.clogging_index *= 1.0 - intensity;\n   182\t                // Proportional setback in active nitrifier and decomposer biomass\n   183\t                let setback = intensity * 0.5;\n   184\t                self.state.microbe.decomposer_biomass_g *= 1.0 - setback;\n   185\t                self.state.microbe.ammonia_oxidizer_biomass_g *= 1.0 - setback;\n   186\t                self.state.microbe.nitrite_oxidizer_biomass_g *= 1.0 - setback;\n   187\t                self.state.microbe.comammox_biomass_g *= 1.0 - setback;\n   188\t                self.push_event(\n   189\t                    EventSeverity::Warning,\n   190\t                    EventKind::FilterCleaningSetback,\n   191\t                    vec![EventCause::FilterMaintenance],\n   192\t                    format!(\"Filter cleaned at intensity {intensity:.2}\"),\n   193\t                );\n   194\t            }\n   195\t            PlayerAction::AddShrimp { count } => {\n   196\t                self.state.animal.adults_count =\n   197\t                    self.state.animal.adults_count.saturating_add(count);\n   198\t            }\n   199\t            PlayerAction::RemoveShrimp { count } => {\n   200\t                self.state.animal.adults_count =\n   201\t                    self.state.animal.adults_count.saturating_sub(count);\n   202\t                // Preserve berried_females_count <= adults_count (also trims egg cohorts)\n   203\t                self.state.animal.clamp_berried_to_adults();\n   204\t            }\n   205\t            PlayerAction::ChangePhotoperiod { hours } => {\n   206\t                self.state.hardware.light.photoperiod_hours = hours;\n   207\t            }\n   208\t            PlayerAction::ChangeLightIntensity { intensity_index } => {\n   209\t                self.state.hardware.light.intensity_index = intensity_index;\n   210\t            }\n   211\t            PlayerAction::ChangeHeaterSetpoint { setpoint_c } => {\n   212\t                self.state.hardware.heater.setpoint_c = setpoint_c;\n   213\t            }\n   214\t            PlayerAction::ChangeAmbientTemperature { target_c } => {\n   215\t                self.state.environment.ambient_temp_c = target_c;\n   216\t            }\n   217\t            PlayerAction::ChangeAeration { enabled, intensity } => {\n   218\t                self.state.hardware.aeration.enabled = enabled;\n   219\t                self.state.hardware.aeration.intensity = intensity;\n   220\t            }\n","exit_code":0,"status":"completed"}}
