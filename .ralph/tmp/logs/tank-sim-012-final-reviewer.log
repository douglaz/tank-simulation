{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01H2tvM7vonEg7eK35EhG3Ko","type":"tool_result","content":"     1→use std::collections::VecDeque;\n     2→\n     3→use crate::{\n     4→    invariants::enforce_invariants,\n     5→    rng::SimSeed,\n     6→    systems,\n     7→    types::{\n     8→        EventCause, EventKind, EventSeverity, PlayerAction, SimError, SimEvent, TankSnapshot,\n     9→        TankState,\n    10→    },\n    11→};\n    12→\n    13→pub trait SimulationEngine {\n    14→    fn apply_action(&mut self, action: PlayerAction) -> Result<(), SimError>;\n    15→    fn step_hours(&mut self, hours: u32) -> Result<(), SimError>;\n    16→    fn snapshot(&self) -> TankSnapshot;\n    17→    fn full_state(&self) -> &TankState;\n    18→}\n    19→\n    20→#[derive(Debug, Clone, PartialEq)]\n    21→pub struct Engine {\n    22→    state: TankState,\n    23→    queued_actions: VecDeque<PlayerAction>,\n    24→}\n    25→\n    26→impl Engine {\n    27→    pub fn new(seed: SimSeed) -> Self {\n    28→        Self {\n    29→            state: TankState::new(seed),\n    30→            queued_actions: VecDeque::new(),\n    31→        }\n    32→    }\n    33→\n    34→    pub fn from_parts(state: TankState, queued_actions: Vec<PlayerAction>) -> Self {\n    35→        Self {\n    36→            state,\n    37→            queued_actions: queued_actions.into(),\n    38→        }\n    39→    }\n    40→\n    41→    pub fn queued_actions(&self) -> Vec<PlayerAction> {\n    42→        self.queued_actions.iter().cloned().collect()\n    43→    }\n    44→\n    45→    fn step_one_hour(&mut self) -> Result<(), SimError> {\n    46→        let actions_slice: Vec<_> = self.queued_actions.iter().cloned().collect();\n    47→        systems::water_change::validate_water_changes(&self.state, &actions_slice)?;\n    48→\n    49→        while let Some(action) = self.queued_actions.pop_front() {\n    50→            self.process_action(action);\n    51→        }\n    52→\n    53→        // Step 4: update water temperature from ambient and heater\n    54→        systems::temperature::step_temperature(&mut self.state);\n    55→\n    56→        // Step 5: compute light state for the current hour.\n    57→        let light_on = self.state.hardware.light.enabled\n    58→            && systems::light::is_light_on(\n    59→                self.state.environment.hour_of_day,\n    60→                self.state.hardware.light.photoperiod_hours,\n    61→            );\n    62→\n    63→        // Step 6-8: nitrogen cycle phase (feed leaching, detritus breakdown,\n    64→        // mineralization, nitrification, guild growth/decay).\n    65→        // This runs between light-state resolution and chemistry/DO/event phases.\n    66→        // Nitrification O2 consumption and alkalinity depletion are handled\n    67→        // internally by the nitrogen cycle system.\n    68→        let _nc_output = systems::nitrogen_cycle::step_nitrogen_cycle(&mut self.state);\n    69→\n    70→        // Step 9: update DIC, alkalinity, and pH.\n    71→        systems::chemistry::step_hourly_chemistry(&mut self.state, light_on);\n    72→\n    73→        // Step 10 / 11-partial: update dissolved oxygen with background respiration and\n    74→        // light-driven photosynthetic support from existing biomass.\n    75→        systems::dissolved_oxygen::step_dissolved_oxygen(&mut self.state, light_on);\n    76→\n    77→        // Step 12: hourly shrimp stress accumulation.\n    78→        systems::shrimp::step_hourly_shrimp_stress(&mut self.state);\n    79→\n    80→        // Step 13: emit threshold-based chemistry warnings.\n    81→        systems::events::emit_hourly_threshold_events(&mut self.state);\n    82→\n    83→        self.state.environment.hour_of_day = (self.state.environment.hour_of_day + 1) % 24;\n    84→        if self.state.environment.hour_of_day == 0 {\n    85→            self.state.environment.day += 1;\n    86→            // Daily pipeline\n    87→            self.run_daily_update();\n    88→        }\n    89→\n    90→        enforce_invariants(&mut self.state)\n    91→    }\n    92→\n    93→    fn run_daily_update(&mut self) {\n    94→        // Daily pipeline: plants → algae → microfauna → shrimp → biofilter → stability\n    95→        systems::plant_growth::step_daily_plants(&mut self.state);\n    96→        systems::algae_growth::step_daily_algae(&mut self.state);\n    97→        systems::microfauna::step_daily_microfauna(&mut self.state);\n    98→        systems::shrimp::step_daily_shrimp(&mut self.state);\n    99→        systems::nitrogen_cycle::update_daily_filter_clogging(&mut self.state);\n   100→\n   101→        // Biofilter maturity summary update\n   102→        let maturity_delta =\n   103→            systems::nitrogen_cycle::update_daily_biofilter_maturity(&mut self.state);\n   104→        if maturity_delta > 0.005 {\n   105→            self.push_event(\n   106→                EventSeverity::Info,\n   107→                EventKind::BiofilmMaturityIncrease,\n   108→                vec![EventCause::BiofilterImmature],\n   109→                format!(\n   110→                    \"Biofilter maturity increased to {:.3}\",\n   111→                    self.state.filter_state.biofilter_maturity_index\n   112→                ),\n   113→            );\n   114→        }\n   115→        // Emit CycleProgressing when maturity is actively growing\n   116→        let current_maturity = self.state.filter_state.biofilter_maturity_index;\n   117→        if maturity_delta > 0.001 && current_maturity < 0.9 {\n   118→            systems::events::emit_once_per_day_pub(\n   119→                &mut self.state,\n   120→                EventSeverity::Info,\n   121→                EventKind::CycleProgressing,\n   122→                vec![EventCause::BiofilterImmature],\n   123→                format!(\"Nitrogen cycle progressing, maturity {current_maturity:.3}\"),\n   124→            );\n   125→        }\n   126→\n   127→        // Long-term stability metrics\n   128→        systems::shrimp::update_stability_tracker(&mut self.state);\n   129→    }\n   130→\n   131→    fn process_action(&mut self, action: PlayerAction) {\n   132→        match action {\n   133→            PlayerAction::Feed { grams } => {\n   134→                self.state.detritus.particulate_organics_g_total += grams;\n   135→                self.push_event(\n   136→                    EventSeverity::Info,\n   137→                    EventKind::CycleProgressing,\n   138→                    vec![EventCause::Overfeeding],\n   139→                    format!(\"Queued feed processed: {grams:.2} g\"),\n   140→                );\n   141→            }\n   142→            PlayerAction::WaterChangePercent {\n   143→                percent,\n   144→                source_profile_id,\n   145→            } => {\n   146→                if percent <= 0.0 {\n   147→                    return;\n   148→                }\n   149→                // Profile was pre-validated; look it up (guaranteed to exist).\n   150→                let profile = self\n   151→                    .state\n   152→                    .source_water_catalog\n   153→                    .get(&source_profile_id)\n   154→                    .cloned();\n   155→                if let Some(profile) = profile {\n   156→                    systems::water_change::apply_water_change(&mut self.state, percent, &profile);\n   157→                    self.push_event(\n   158→                        EventSeverity::Info,\n   159→                        EventKind::StabilityImproving,\n   160→                        vec![EventCause::WaterChange],\n   161→                        format!(\"Water change processed: {percent:.1}% with {source_profile_id}\"),\n   162→                    );\n   163→                }\n   164→            }\n   165→            PlayerAction::TrimPlants { fraction } => {\n   166→                let mut trimmed_biomass_g = 0.0;\n   167→                for plant in &mut self.state.plant_guilds {\n   168→                    let trimmed = plant.biomass_g * fraction;\n   169→                    plant.biomass_g -= trimmed;\n   170→                    trimmed_biomass_g += trimmed;\n   171→                }\n   172→                self.state.detritus.fine_detritus_g_total += trimmed_biomass_g;\n   173→            }\n   174→            PlayerAction::SiphonDetritus { fraction } => {\n   175→                self.state.detritus.particulate_organics_g_total *= 1.0 - fraction;\n   176→                self.state.detritus.fine_detritus_g_total *= 1.0 - fraction;\n   177→            }\n   178→            PlayerAction::CleanFilter { intensity } => {\n   179→                self.state.hardware.filter.cleanliness_index = 1.0;\n   180→                self.state.filter_state.biofilter_maturity_index *= 1.0 - (intensity * 0.5);\n   181→                self.state.filter_state.clogging_index *= 1.0 - intensity;\n   182→                // Proportional setback in active nitrifier and decomposer biomass\n   183→                let setback = intensity * 0.5;\n   184→                self.state.microbe.decomposer_biomass_g *= 1.0 - setback;\n   185→                self.state.microbe.ammonia_oxidizer_biomass_g *= 1.0 - setback;\n   186→                self.state.microbe.nitrite_oxidizer_biomass_g *= 1.0 - setback;\n   187→                self.state.microbe.comammox_biomass_g *= 1.0 - setback;\n   188→                self.push_event(\n   189→                    EventSeverity::Warning,\n   190→                    EventKind::FilterCleaningSetback,\n   191→                    vec![EventCause::FilterMaintenance],\n   192→                    format!(\"Filter cleaned at intensity {intensity:.2}\"),\n   193→                );\n   194→            }\n   195→            PlayerAction::AddShrimp { count } => {\n   196→                self.state.animal.adults_count =\n   197→                    self.state.animal.adults_count.saturating_add(count);\n   198→            }\n   199→            PlayerAction::RemoveShrimp { count } => {\n   200→                self.state.animal.adults_count =\n   201→                    self.state.animal.adults_count.saturating_sub(count);\n   202→                // Preserve berried_females_count <= adults_count (also trims egg cohorts)\n   203→                self.state.animal.clamp_berried_to_adults();\n   204→            }\n   205→            PlayerAction::ChangePhotoperiod { hours } => {\n   206→                self.state.hardware.light.photoperiod_hours = hours;\n   207→            }\n   208→            PlayerAction::ChangeLightIntensity { intensity_index } => {\n   209→                self.state.hardware.light.intensity_index = intensity_index;\n   210→            }\n   211→            PlayerAction::ChangeHeaterSetpoint { setpoint_c } => {\n   212→                self.state.hardware.heater.setpoint_c = setpoint_c;\n   213→            }\n   214→            PlayerAction::ChangeAmbientTemperature { target_c } => {\n   215→                self.state.environment.ambient_temp_c = target_c;\n   216→            }\n   217→            PlayerAction::ChangeAeration { enabled, intensity } => {\n   218→                self.state.hardware.aeration.enabled = enabled;\n   219→                self.state.hardware.aeration.intensity = intensity;\n   220→            }\n   221→        }\n   222→    }\n   223→\n   224→    fn push_event(\n   225→        &mut self,\n   226→        severity: EventSeverity,\n   227→        kind: EventKind,\n   228→        cause_codes: Vec<EventCause>,\n   229→        summary: String,\n   230→    ) {\n   231→        self.state.event_log.push(SimEvent::new(\n   232→            self.state.environment.day,\n   233→            self.state.environment.hour_of_day,\n   234→            severity,\n   235→            kind,\n   236→            cause_codes,\n   237→            summary,\n   238→        ));\n   239→    }\n   240→}\n   241→\n   242→impl SimulationEngine for Engine {\n   243→    fn apply_action(&mut self, action: PlayerAction) -> Result<(), SimError> {\n   244→        action.validate()?;\n   245→\n   246→        // State-aware validation for RemoveShrimp\n   247→        if let PlayerAction::RemoveShrimp { count } = &action {\n   248→            let mut available = self.state.animal.adults_count as i64;\n   249→            for queued in &self.queued_actions {\n   250→                match queued {\n   251→                    PlayerAction::RemoveShrimp { count: c } => available -= *c as i64,\n   252→                    PlayerAction::AddShrimp { count: c } => available += *c as i64,\n   253→                    _ => {}\n   254→                }\n   255→            }\n   256→            if (*count as i64) > available {\n   257→                return Err(SimError::ShrimpRemovalExceedsAvailable {\n   258→                    requested: *count,\n   259→                    available: available.max(0) as u32,\n   260→                });\n   261→            }\n   262→        }\n   263→\n   264→        self.queued_actions.push_back(action);\n   265→        Ok(())\n   266→    }\n   267→\n   268→    fn step_hours(&mut self, hours: u32) -> Result<(), SimError> {\n   269→        for _ in 0..hours {\n   270→            self.step_one_hour()?;\n   271→        }\n   272→        enforce_invariants(&mut self.state)\n   273→    }\n   274→\n   275→    fn snapshot(&self) -> TankSnapshot {\n   276→        TankSnapshot::from_state(&self.state)\n   277→    }\n   278→\n   279→    fn full_state(&self) -> &TankState {\n   280→        &self.state\n   281→    }\n   282→}\n   283→"}]},"parent_tool_use_id":null,"session_id":"8da98dd9-a9b4-4190-b982-7e3bdac34696","uuid":"cd6fec18-6d05-491d-a16e-fb23beedaead","tool_use_result":{"type":"text","file":{"filePath":"/root/tank-simulation/crates/tank_core/src/engine.rs","content":"use std::collections::VecDeque;\n\nuse crate::{\n    invariants::enforce_invariants,\n    rng::SimSeed,\n    systems,\n    types::{\n        EventCause, EventKind, EventSeverity, PlayerAction, SimError, SimEvent, TankSnapshot,\n        TankState,\n    },\n};\n\npub trait SimulationEngine {\n    fn apply_action(&mut self, action: PlayerAction) -> Result<(), SimError>;\n    fn step_hours(&mut self, hours: u32) -> Result<(), SimError>;\n    fn snapshot(&self) -> TankSnapshot;\n    fn full_state(&self) -> &TankState;\n}\n\n#[derive(Debug, Clone, PartialEq)]\npub struct Engine {\n    state: TankState,\n    queued_actions: VecDeque<PlayerAction>,\n}\n\nimpl Engine {\n    pub fn new(seed: SimSeed) -> Self {\n        Self {\n            state: TankState::new(seed),\n            queued_actions: VecDeque::new(),\n        }\n    }\n\n    pub fn from_parts(state: TankState, queued_actions: Vec<PlayerAction>) -> Self {\n        Self {\n            state,\n            queued_actions: queued_actions.into(),\n        }\n    }\n\n    pub fn queued_actions(&self) -> Vec<PlayerAction> {\n        self.queued_actions.iter().cloned().collect()\n    }\n\n    fn step_one_hour(&mut self) -> Result<(), SimError> {\n        let actions_slice: Vec<_> = self.queued_actions.iter().cloned().collect();\n        systems::water_change::validate_water_changes(&self.state, &actions_slice)?;\n\n        while let Some(action) = self.queued_actions.pop_front() {\n            self.process_action(action);\n        }\n\n        // Step 4: update water temperature from ambient and heater\n        systems::temperature::step_temperature(&mut self.state);\n\n        // Step 5: compute light state for the current hour.\n        let light_on = self.state.hardware.light.enabled\n            && systems::light::is_light_on(\n                self.state.environment.hour_of_day,\n                self.state.hardware.light.photoperiod_hours,\n            );\n\n        // Step 6-8: nitrogen cycle phase (feed leaching, detritus breakdown,\n        // mineralization, nitrification, guild growth/decay).\n        // This runs between light-state resolution and chemistry/DO/event phases.\n        // Nitrification O2 consumption and alkalinity depletion are handled\n        // internally by the nitrogen cycle system.\n        let _nc_output = systems::nitrogen_cycle::step_nitrogen_cycle(&mut self.state);\n\n        // Step 9: update DIC, alkalinity, and pH.\n        systems::chemistry::step_hourly_chemistry(&mut self.state, light_on);\n\n        // Step 10 / 11-partial: update dissolved oxygen with background respiration and\n        // light-driven photosynthetic support from existing biomass.\n        systems::dissolved_oxygen::step_dissolved_oxygen(&mut self.state, light_on);\n\n        // Step 12: hourly shrimp stress accumulation.\n        systems::shrimp::step_hourly_shrimp_stress(&mut self.state);\n\n        // Step 13: emit threshold-based chemistry warnings.\n        systems::events::emit_hourly_threshold_events(&mut self.state);\n\n        self.state.environment.hour_of_day = (self.state.environment.hour_of_day + 1) % 24;\n        if self.state.environment.hour_of_day == 0 {\n            self.state.environment.day += 1;\n            // Daily pipeline\n            self.run_daily_update();\n        }\n\n        enforce_invariants(&mut self.state)\n    }\n\n    fn run_daily_update(&mut self) {\n        // Daily pipeline: plants → algae → microfauna → shrimp → biofilter → stability\n        systems::plant_growth::step_daily_plants(&mut self.state);\n        systems::algae_growth::step_daily_algae(&mut self.state);\n        systems::microfauna::step_daily_microfauna(&mut self.state);\n        systems::shrimp::step_daily_shrimp(&mut self.state);\n        systems::nitrogen_cycle::update_daily_filter_clogging(&mut self.state);\n\n        // Biofilter maturity summary update\n        let maturity_delta =\n            systems::nitrogen_cycle::update_daily_biofilter_maturity(&mut self.state);\n        if maturity_delta > 0.005 {\n            self.push_event(\n                EventSeverity::Info,\n                EventKind::BiofilmMaturityIncrease,\n                vec![EventCause::BiofilterImmature],\n                format!(\n                    \"Biofilter maturity increased to {:.3}\",\n                    self.state.filter_state.biofilter_maturity_index\n                ),\n            );\n        }\n        // Emit CycleProgressing when maturity is actively growing\n        let current_maturity = self.state.filter_state.biofilter_maturity_index;\n        if maturity_delta > 0.001 && current_maturity < 0.9 {\n            systems::events::emit_once_per_day_pub(\n                &mut self.state,\n                EventSeverity::Info,\n                EventKind::CycleProgressing,\n                vec![EventCause::BiofilterImmature],\n                format!(\"Nitrogen cycle progressing, maturity {current_maturity:.3}\"),\n            );\n        }\n\n        // Long-term stability metrics\n        systems::shrimp::update_stability_tracker(&mut self.state);\n    }\n\n    fn process_action(&mut self, action: PlayerAction) {\n        match action {\n            PlayerAction::Feed { grams } => {\n                self.state.detritus.particulate_organics_g_total += grams;\n                self.push_event(\n                    EventSeverity::Info,\n                    EventKind::CycleProgressing,\n                    vec![EventCause::Overfeeding],\n                    format!(\"Queued feed processed: {grams:.2} g\"),\n                );\n            }\n            PlayerAction::WaterChangePercent {\n                percent,\n                source_profile_id,\n            } => {\n                if percent <= 0.0 {\n                    return;\n                }\n                // Profile was pre-validated; look it up (guaranteed to exist).\n                let profile = self\n                    .state\n                    .source_water_catalog\n                    .get(&source_profile_id)\n                    .cloned();\n                if let Some(profile) = profile {\n                    systems::water_change::apply_water_change(&mut self.state, percent, &profile);\n                    self.push_event(\n                        EventSeverity::Info,\n                        EventKind::StabilityImproving,\n                        vec![EventCause::WaterChange],\n                        format!(\"Water change processed: {percent:.1}% with {source_profile_id}\"),\n                    );\n                }\n            }\n            PlayerAction::TrimPlants { fraction } => {\n                let mut trimmed_biomass_g = 0.0;\n                for plant in &mut self.state.plant_guilds {\n                    let trimmed = plant.biomass_g * fraction;\n                    plant.biomass_g -= trimmed;\n                    trimmed_biomass_g += trimmed;\n                }\n                self.state.detritus.fine_detritus_g_total += trimmed_biomass_g;\n            }\n            PlayerAction::SiphonDetritus { fraction } => {\n                self.state.detritus.particulate_organics_g_total *= 1.0 - fraction;\n                self.state.detritus.fine_detritus_g_total *= 1.0 - fraction;\n            }\n            PlayerAction::CleanFilter { intensity } => {\n                self.state.hardware.filter.cleanliness_index = 1.0;\n                self.state.filter_state.biofilter_maturity_index *= 1.0 - (intensity * 0.5);\n                self.state.filter_state.clogging_index *= 1.0 - intensity;\n                // Proportional setback in active nitrifier and decomposer biomass\n                let setback = intensity * 0.5;\n                self.state.microbe.decomposer_biomass_g *= 1.0 - setback;\n                self.state.microbe.ammonia_oxidizer_biomass_g *= 1.0 - setback;\n                self.state.microbe.nitrite_oxidizer_biomass_g *= 1.0 - setback;\n                self.state.microbe.comammox_biomass_g *= 1.0 - setback;\n                self.push_event(\n                    EventSeverity::Warning,\n                    EventKind::FilterCleaningSetback,\n                    vec![EventCause::FilterMaintenance],\n                    format!(\"Filter cleaned at intensity {intensity:.2}\"),\n                );\n            }\n            PlayerAction::AddShrimp { count } => {\n                self.state.animal.adults_count =\n                    self.state.animal.adults_count.saturating_add(count);\n            }\n            PlayerAction::RemoveShrimp { count } => {\n                self.state.animal.adults_count =\n                    self.state.animal.adults_count.saturating_sub(count);\n                // Preserve berried_females_count <= adults_count (also trims egg cohorts)\n                self.state.animal.clamp_berried_to_adults();\n            }\n            PlayerAction::ChangePhotoperiod { hours } => {\n                self.state.hardware.light.photoperiod_hours = hours;\n            }\n            PlayerAction::ChangeLightIntensity { intensity_index } => {\n                self.state.hardware.light.intensity_index = intensity_index;\n            }\n            PlayerAction::ChangeHeaterSetpoint { setpoint_c } => {\n                self.state.hardware.heater.setpoint_c = setpoint_c;\n            }\n            PlayerAction::ChangeAmbientTemperature { target_c } => {\n                self.state.environment.ambient_temp_c = target_c;\n            }\n            PlayerAction::ChangeAeration { enabled, intensity } => {\n                self.state.hardware.aeration.enabled = enabled;\n                self.state.hardware.aeration.intensity = intensity;\n            }\n        }\n    }\n\n    fn push_event(\n        &mut self,\n        severity: EventSeverity,\n        kind: EventKind,\n        cause_codes: Vec<EventCause>,\n        summary: String,\n    ) {\n        self.state.event_log.push(SimEvent::new(\n            self.state.environment.day,\n            self.state.environment.hour_of_day,\n            severity,\n            kind,\n            cause_codes,\n            summary,\n        ));\n    }\n}\n\nimpl SimulationEngine for Engine {\n    fn apply_action(&mut self, action: PlayerAction) -> Result<(), SimError> {\n        action.validate()?;\n\n        // State-aware validation for RemoveShrimp\n        if let PlayerAction::RemoveShrimp { count } = &action {\n            let mut available = self.state.animal.adults_count as i64;\n            for queued in &self.queued_actions {\n                match queued {\n                    PlayerAction::RemoveShrimp { count: c } => available -= *c as i64,\n                    PlayerAction::AddShrimp { count: c } => available += *c as i64,\n                    _ => {}\n                }\n            }\n            if (*count as i64) > available {\n                return Err(SimError::ShrimpRemovalExceedsAvailable {\n                    requested: *count,\n                    available: available.max(0) as u32,\n                });\n            }\n        }\n\n        self.queued_actions.push_back(action);\n        Ok(())\n    }\n\n    fn step_hours(&mut self, hours: u32) -> Result<(), SimError> {\n        for _ in 0..hours {\n            self.step_one_hour()?;\n        }\n        enforce_invariants(&mut self.state)\n    }\n\n    fn snapshot(&self) -> TankSnapshot {\n        TankSnapshot::from_state(&self.state)\n    }\n\n    fn full_state(&self) -> &TankState {\n        &self.state\n    }\n}\n","numLines":283,"startLine":1,"totalLines":283}}}
