{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XJppUXaoDWGjULcTjsqqa4","type":"tool_result","content":"     1→use crate::types::{PlantGuild, TankState};\n     2→\n     3→const PLANT_N_MG_PER_G_GROWTH: f64 = 28.0;\n     4→const PLANT_P_MG_PER_G_GROWTH: f64 = 4.0;\n     5→\n     6→pub fn step_daily_plants(state: &mut TankState) {\n     7→    let surface_area_m2 = (state.geometry.surface_area_cm2() / 10_000.0).max(f64::MIN_POSITIVE);\n     8→    let total_plant_biomass_g: f64 = state.plant_guilds.iter().map(|plant| plant.biomass_g).sum();\n     9→    let crowding_index = (total_plant_biomass_g\n    10→        / (surface_area_m2\n    11→            * state\n    12→                .process_params\n    13→                .plant_crowding_biomass_g_per_m2\n    14→                .max(1.0)))\n    15→    .clamp(0.0, 1.0);\n    16→    let f_light = plant_light_factor(state);\n    17→    let f_temp = gaussian_response(\n    18→        state.water.temperature_c,\n    19→        state.process_params.plant_temp_optimum_c,\n    20→        state.process_params.plant_temp_sigma_c,\n    21→    );\n    22→    let f_c = half_saturation(\n    23→        state.water.dissolved_inorganic_carbon_mg_c_total,\n    24→        state.process_params.plant_half_saturation_c_mg_total,\n    25→    );\n    26→\n    27→    for index in 0..state.plant_guilds.len() {\n    28→        let guild = state.plant_guilds[index].guild;\n    29→        let biomass_g = state.plant_guilds[index].biomass_g;\n    30→        let health_index = state.plant_guilds[index].health_index;\n    31→        let habitat_index = habitat_factor(state, guild);\n    32→\n    33→        state.plant_guilds[index].crowding_index = crowding_index;\n    34→        state.plant_guilds[index].habitat_index = habitat_index;\n    35→\n    36→        let water_n = state.water.ammonia_total_mg_n_total + state.water.nitrate_mg_n_total;\n    37→        let water_p = state.water.phosphate_mg_p_total;\n    38→        let substrate_n = total_substrate_n(state);\n    39→        let substrate_p = total_substrate_p(state);\n    40→        let water_bias = state.plant_guilds[index].water_column_uptake_bias();\n    41→        let substrate_bias = state.plant_guilds[index].substrate_uptake_bias();\n    42→        let accessible_n = (water_n * water_bias) + (substrate_n * substrate_bias);\n    43→        let accessible_p = (water_p * water_bias) + (substrate_p * substrate_bias);\n    44→        let f_n = half_saturation(\n    45→            accessible_n,\n    46→            state.process_params.plant_half_saturation_n_mg_total,\n    47→        );\n    48→        let f_p = half_saturation(\n    49→            accessible_p,\n    50→            state.process_params.plant_half_saturation_p_mg_total,\n    51→        );\n    52→        let nutrient_limitation = f_n.min(f_p).min(f_c);\n    53→        let max_rate = match guild {\n    54→            PlantGuild::FastStem => state.process_params.plant_max_growth_rate_fast_stem_per_day,\n    55→            PlantGuild::RootFeedingRosette => {\n    56→                state\n    57→                    .process_params\n    58→                    .plant_max_growth_rate_root_rosette_per_day\n    59→            }\n    60→        };\n    61→        let gross_growth_g = biomass_g\n    62→            * max_rate\n    63→            * f_light\n    64→            * f_temp\n    65→            * nutrient_limitation\n    66→            * habitat_index\n    67→            * (1.0 - crowding_index);\n    68→        let respiration_g = biomass_g * state.process_params.plant_respiration_fraction_per_day;\n    69→        let senescence_g = biomass_g\n    70→            * state.process_params.plant_senescence_fraction_per_day\n    71→            * (1.0 + 0.5 * (1.0 - health_index));\n    72→        let net_growth_g = gross_growth_g - respiration_g - senescence_g;\n    73→        let realized_growth_g = gross_growth_g.max(0.0);\n    74→\n    75→        remove_plant_nutrients(\n    76→            state,\n    77→            realized_growth_g * PLANT_N_MG_PER_G_GROWTH,\n    78→            realized_growth_g * PLANT_P_MG_PER_G_GROWTH,\n    79→            water_bias,\n    80→            substrate_bias,\n    81→        );\n    82→\n    83→        let new_biomass_g = (biomass_g + net_growth_g).max(0.0);\n    84→        state.plant_guilds[index].biomass_g = new_biomass_g;\n    85→        state.detritus.fine_detritus_g_total += senescence_g.max(0.0);\n    86→\n    87→        let stress_driver = nutrient_limitation.min(f_light).min(habitat_index);\n    88→        let poor_conditions = stress_driver < 0.55;\n    89→        let new_health = if poor_conditions {\n    90→            health_index - state.process_params.plant_health_decline_per_day * (1.0 - stress_driver)\n    91→        } else {\n    92→            health_index + state.process_params.plant_health_recovery_per_day * (1.0 - health_index)\n    93→        };\n    94→        state.plant_guilds[index].health_index = new_health.clamp(0.0, 1.0);\n    95→    }\n    96→}\n    97→\n    98→fn plant_light_factor(state: &TankState) -> f64 {\n    99→    if !state.hardware.light.enabled {\n   100→        return 0.0;\n   101→    }\n   102→\n   103→    let photoperiod_factor = (state.hardware.light.photoperiod_hours / 10.0).clamp(0.0, 1.0);\n   104→    half_saturation(\n   105→        state.hardware.light.intensity_index * photoperiod_factor,\n   106→        state.process_params.plant_light_half_saturation,\n   107→    )\n   108→}\n   109→\n   110→fn habitat_factor(state: &TankState, guild: PlantGuild) -> f64 {\n   111→    match guild {\n   112→        PlantGuild::FastStem => 0.95,\n   113→        PlantGuild::RootFeedingRosette => {\n   114→            if state.substrate_layers.is_empty() {\n   115→                return 0.2;\n   116→            }\n   117→\n   118→            let total_depth_cm: f64 = state\n   119→                .substrate_layers\n   120→                .iter()\n   121→                .map(|layer| layer.depth_cm)\n   122→                .sum();\n   123→            let depth_factor = (total_depth_cm / 5.0).clamp(0.0, 1.0);\n   124→            let weighted_cec = state\n   125→                .substrate_layers\n   126→                .iter()\n   127→                .map(|layer| layer.cation_exchange_capacity_index * layer.depth_cm.max(0.1))\n   128→                .sum::<f64>()\n   129→                / total_depth_cm.max(0.1);\n   130→            let active_bonus = if state\n   131→                .substrate_layers\n   132→                .iter()\n   133→                .any(|layer| matches!(layer.kind, crate::types::SubstrateKind::ActivePlanted))\n   134→            {\n   135→                0.15\n   136→            } else {\n   137→                0.0\n   138→            };\n   139→\n   140→            (0.2 + (0.35 * depth_factor) + (0.3 * weighted_cec) + active_bonus).clamp(0.0, 1.0)\n   141→        }\n   142→    }\n   143→}\n   144→\n   145→fn remove_plant_nutrients(\n   146→    state: &mut TankState,\n   147→    n_demand_mg: f64,\n   148→    p_demand_mg: f64,\n   149→    water_bias: f64,\n   150→    substrate_bias: f64,\n   151→) {\n   152→    let water_n_target = n_demand_mg * water_bias;\n   153→    let substrate_n_target = n_demand_mg * substrate_bias;\n   154→    let water_p_target = p_demand_mg * water_bias;\n   155→    let substrate_p_target = p_demand_mg * substrate_bias;\n   156→\n   157→    let water_n_removed = remove_water_n(state, water_n_target);\n   158→    remove_substrate_n(\n   159→        state,\n   160→        substrate_n_target + (water_n_target - water_n_removed).max(0.0),\n   161→    );\n   162→\n   163→    let water_p_removed = remove_water_p(state, water_p_target);\n   164→    remove_substrate_p(\n   165→        state,\n   166→        substrate_p_target + (water_p_target - water_p_removed).max(0.0),\n   167→    );\n   168→}\n   169→\n   170→fn remove_water_n(state: &mut TankState, target_mg: f64) -> f64 {\n   171→    let ammonia_removed = state.water.ammonia_total_mg_n_total.min(target_mg);\n   172→    state.water.ammonia_total_mg_n_total -= ammonia_removed;\n   173→\n   174→    let remaining = (target_mg - ammonia_removed).max(0.0);\n   175→    let nitrate_removed = state.water.nitrate_mg_n_total.min(remaining);\n   176→    state.water.nitrate_mg_n_total -= nitrate_removed;\n   177→\n   178→    ammonia_removed + nitrate_removed\n   179→}\n   180→\n   181→fn remove_water_p(state: &mut TankState, target_mg: f64) -> f64 {\n   182→    let removed = state.water.phosphate_mg_p_total.min(target_mg);\n   183→    state.water.phosphate_mg_p_total -= removed;\n   184→    removed\n   185→}\n   186→\n   187→fn remove_substrate_n(state: &mut TankState, target_mg: f64) -> f64 {\n   188→    remove_substrate_pool(state, target_mg, true)\n   189→}\n   190→\n   191→fn remove_substrate_p(state: &mut TankState, target_mg: f64) -> f64 {\n   192→    remove_substrate_pool(state, target_mg, false)\n   193→}\n   194→\n   195→fn remove_substrate_pool(state: &mut TankState, target_mg: f64, is_nitrogen: bool) -> f64 {\n   196→    if target_mg <= f64::EPSILON || state.substrate_layers.is_empty() {\n   197→        return 0.0;\n   198→    }\n   199→\n   200→    let weights: Vec<f64> = state\n   201→        .substrate_layers\n   202→        .iter()\n   203→        .map(|layer| {\n   204→            let store = if is_nitrogen {\n   205→                layer.nutrient_store_mg_n_total\n   206→            } else {\n   207→                layer.nutrient_store_mg_p_total\n   208→            };\n   209→            store * (0.4 + (0.6 * layer.cation_exchange_capacity_index))\n   210→        })\n   211→        .collect();\n   212→    let total_weight: f64 = weights.iter().sum();\n   213→    if total_weight <= f64::EPSILON {\n   214→        return 0.0;\n   215→    }\n   216→\n   217→    let mut removed_total = 0.0;\n   218→    for (layer, weight) in state.substrate_layers.iter_mut().zip(weights.iter()) {\n   219→        let share = target_mg * (*weight / total_weight);\n   220→        let pool = if is_nitrogen {\n   221→            &mut layer.nutrient_store_mg_n_total\n   222→        } else {\n   223→            &mut layer.nutrient_store_mg_p_total\n   224→        };\n   225→        let removed = (*pool).min(share);\n   226→        *pool -= removed;\n   227→        removed_total += removed;\n   228→    }\n   229→\n   230→    let mut remainder = (target_mg - removed_total).max(0.0);\n   231→    if remainder > f64::EPSILON {\n   232→        for layer in &mut state.substrate_layers {\n   233→            if remainder <= f64::EPSILON {\n   234→                break;\n   235→            }\n   236→            let pool = if is_nitrogen {\n   237→                &mut layer.nutrient_store_mg_n_total\n   238→            } else {\n   239→                &mut layer.nutrient_store_mg_p_total\n   240→            };\n   241→            let removed = (*pool).min(remainder);\n   242→            *pool -= removed;\n   243→            remainder -= removed;\n   244→            removed_total += removed;\n   245→        }\n   246→    }\n   247→\n   248→    removed_total\n   249→}\n   250→\n   251→fn total_substrate_n(state: &TankState) -> f64 {\n   252→    state\n   253→        .substrate_layers\n   254→        .iter()\n   255→        .map(|layer| layer.nutrient_store_mg_n_total)\n   256→        .sum()\n   257→}\n   258→\n   259→fn total_substrate_p(state: &TankState) -> f64 {\n   260→    state\n   261→        .substrate_layers\n   262→        .iter()\n   263→        .map(|layer| layer.nutrient_store_mg_p_total)\n   264→        .sum()\n   265→}\n   266→\n   267→fn half_saturation(value: f64, half_sat: f64) -> f64 {\n   268→    let half_sat = half_sat.max(f64::MIN_POSITIVE);\n   269→    (value / (value + half_sat)).clamp(0.0, 1.0)\n   270→}\n   271→\n   272→fn gaussian_response(value: f64, optimum: f64, sigma: f64) -> f64 {\n   273→    let sigma = sigma.max(0.1);\n   274→    let diff = value - optimum;\n   275→    (-(diff * diff) / (2.0 * sigma * sigma))\n   276→        .exp()\n   277→        .clamp(0.0, 1.0)\n   278→}\n   279→"}]},"parent_tool_use_id":null,"session_id":"d9e19a3d-7c7f-4e59-85c1-196d8c055a3e","uuid":"256a8843-bc45-4f99-9f15-c372aed18677","tool_use_result":{"type":"text","file":{"filePath":"/root/tank-simulation/crates/tank_core/src/systems/plant_growth.rs","content":"use crate::types::{PlantGuild, TankState};\n\nconst PLANT_N_MG_PER_G_GROWTH: f64 = 28.0;\nconst PLANT_P_MG_PER_G_GROWTH: f64 = 4.0;\n\npub fn step_daily_plants(state: &mut TankState) {\n    let surface_area_m2 = (state.geometry.surface_area_cm2() / 10_000.0).max(f64::MIN_POSITIVE);\n    let total_plant_biomass_g: f64 = state.plant_guilds.iter().map(|plant| plant.biomass_g).sum();\n    let crowding_index = (total_plant_biomass_g\n        / (surface_area_m2\n            * state\n                .process_params\n                .plant_crowding_biomass_g_per_m2\n                .max(1.0)))\n    .clamp(0.0, 1.0);\n    let f_light = plant_light_factor(state);\n    let f_temp = gaussian_response(\n        state.water.temperature_c,\n        state.process_params.plant_temp_optimum_c,\n        state.process_params.plant_temp_sigma_c,\n    );\n    let f_c = half_saturation(\n        state.water.dissolved_inorganic_carbon_mg_c_total,\n        state.process_params.plant_half_saturation_c_mg_total,\n    );\n\n    for index in 0..state.plant_guilds.len() {\n        let guild = state.plant_guilds[index].guild;\n        let biomass_g = state.plant_guilds[index].biomass_g;\n        let health_index = state.plant_guilds[index].health_index;\n        let habitat_index = habitat_factor(state, guild);\n\n        state.plant_guilds[index].crowding_index = crowding_index;\n        state.plant_guilds[index].habitat_index = habitat_index;\n\n        let water_n = state.water.ammonia_total_mg_n_total + state.water.nitrate_mg_n_total;\n        let water_p = state.water.phosphate_mg_p_total;\n        let substrate_n = total_substrate_n(state);\n        let substrate_p = total_substrate_p(state);\n        let water_bias = state.plant_guilds[index].water_column_uptake_bias();\n        let substrate_bias = state.plant_guilds[index].substrate_uptake_bias();\n        let accessible_n = (water_n * water_bias) + (substrate_n * substrate_bias);\n        let accessible_p = (water_p * water_bias) + (substrate_p * substrate_bias);\n        let f_n = half_saturation(\n            accessible_n,\n            state.process_params.plant_half_saturation_n_mg_total,\n        );\n        let f_p = half_saturation(\n            accessible_p,\n            state.process_params.plant_half_saturation_p_mg_total,\n        );\n        let nutrient_limitation = f_n.min(f_p).min(f_c);\n        let max_rate = match guild {\n            PlantGuild::FastStem => state.process_params.plant_max_growth_rate_fast_stem_per_day,\n            PlantGuild::RootFeedingRosette => {\n                state\n                    .process_params\n                    .plant_max_growth_rate_root_rosette_per_day\n            }\n        };\n        let gross_growth_g = biomass_g\n            * max_rate\n            * f_light\n            * f_temp\n            * nutrient_limitation\n            * habitat_index\n            * (1.0 - crowding_index);\n        let respiration_g = biomass_g * state.process_params.plant_respiration_fraction_per_day;\n        let senescence_g = biomass_g\n            * state.process_params.plant_senescence_fraction_per_day\n            * (1.0 + 0.5 * (1.0 - health_index));\n        let net_growth_g = gross_growth_g - respiration_g - senescence_g;\n        let realized_growth_g = gross_growth_g.max(0.0);\n\n        remove_plant_nutrients(\n            state,\n            realized_growth_g * PLANT_N_MG_PER_G_GROWTH,\n            realized_growth_g * PLANT_P_MG_PER_G_GROWTH,\n            water_bias,\n            substrate_bias,\n        );\n\n        let new_biomass_g = (biomass_g + net_growth_g).max(0.0);\n        state.plant_guilds[index].biomass_g = new_biomass_g;\n        state.detritus.fine_detritus_g_total += senescence_g.max(0.0);\n\n        let stress_driver = nutrient_limitation.min(f_light).min(habitat_index);\n        let poor_conditions = stress_driver < 0.55;\n        let new_health = if poor_conditions {\n            health_index - state.process_params.plant_health_decline_per_day * (1.0 - stress_driver)\n        } else {\n            health_index + state.process_params.plant_health_recovery_per_day * (1.0 - health_index)\n        };\n        state.plant_guilds[index].health_index = new_health.clamp(0.0, 1.0);\n    }\n}\n\nfn plant_light_factor(state: &TankState) -> f64 {\n    if !state.hardware.light.enabled {\n        return 0.0;\n    }\n\n    let photoperiod_factor = (state.hardware.light.photoperiod_hours / 10.0).clamp(0.0, 1.0);\n    half_saturation(\n        state.hardware.light.intensity_index * photoperiod_factor,\n        state.process_params.plant_light_half_saturation,\n    )\n}\n\nfn habitat_factor(state: &TankState, guild: PlantGuild) -> f64 {\n    match guild {\n        PlantGuild::FastStem => 0.95,\n        PlantGuild::RootFeedingRosette => {\n            if state.substrate_layers.is_empty() {\n                return 0.2;\n            }\n\n            let total_depth_cm: f64 = state\n                .substrate_layers\n                .iter()\n                .map(|layer| layer.depth_cm)\n                .sum();\n            let depth_factor = (total_depth_cm / 5.0).clamp(0.0, 1.0);\n            let weighted_cec = state\n                .substrate_layers\n                .iter()\n                .map(|layer| layer.cation_exchange_capacity_index * layer.depth_cm.max(0.1))\n                .sum::<f64>()\n                / total_depth_cm.max(0.1);\n            let active_bonus = if state\n                .substrate_layers\n                .iter()\n                .any(|layer| matches!(layer.kind, crate::types::SubstrateKind::ActivePlanted))\n            {\n                0.15\n            } else {\n                0.0\n            };\n\n            (0.2 + (0.35 * depth_factor) + (0.3 * weighted_cec) + active_bonus).clamp(0.0, 1.0)\n        }\n    }\n}\n\nfn remove_plant_nutrients(\n    state: &mut TankState,\n    n_demand_mg: f64,\n    p_demand_mg: f64,\n    water_bias: f64,\n    substrate_bias: f64,\n) {\n    let water_n_target = n_demand_mg * water_bias;\n    let substrate_n_target = n_demand_mg * substrate_bias;\n    let water_p_target = p_demand_mg * water_bias;\n    let substrate_p_target = p_demand_mg * substrate_bias;\n\n    let water_n_removed = remove_water_n(state, water_n_target);\n    remove_substrate_n(\n        state,\n        substrate_n_target + (water_n_target - water_n_removed).max(0.0),\n    );\n\n    let water_p_removed = remove_water_p(state, water_p_target);\n    remove_substrate_p(\n        state,\n        substrate_p_target + (water_p_target - water_p_removed).max(0.0),\n    );\n}\n\nfn remove_water_n(state: &mut TankState, target_mg: f64) -> f64 {\n    let ammonia_removed = state.water.ammonia_total_mg_n_total.min(target_mg);\n    state.water.ammonia_total_mg_n_total -= ammonia_removed;\n\n    let remaining = (target_mg - ammonia_removed).max(0.0);\n    let nitrate_removed = state.water.nitrate_mg_n_total.min(remaining);\n    state.water.nitrate_mg_n_total -= nitrate_removed;\n\n    ammonia_removed + nitrate_removed\n}\n\nfn remove_water_p(state: &mut TankState, target_mg: f64) -> f64 {\n    let removed = state.water.phosphate_mg_p_total.min(target_mg);\n    state.water.phosphate_mg_p_total -= removed;\n    removed\n}\n\nfn remove_substrate_n(state: &mut TankState, target_mg: f64) -> f64 {\n    remove_substrate_pool(state, target_mg, true)\n}\n\nfn remove_substrate_p(state: &mut TankState, target_mg: f64) -> f64 {\n    remove_substrate_pool(state, target_mg, false)\n}\n\nfn remove_substrate_pool(state: &mut TankState, target_mg: f64, is_nitrogen: bool) -> f64 {\n    if target_mg <= f64::EPSILON || state.substrate_layers.is_empty() {\n        return 0.0;\n    }\n\n    let weights: Vec<f64> = state\n        .substrate_layers\n        .iter()\n        .map(|layer| {\n            let store = if is_nitrogen {\n                layer.nutrient_store_mg_n_total\n            } else {\n                layer.nutrient_store_mg_p_total\n            };\n            store * (0.4 + (0.6 * layer.cation_exchange_capacity_index))\n        })\n        .collect();\n    let total_weight: f64 = weights.iter().sum();\n    if total_weight <= f64::EPSILON {\n        return 0.0;\n    }\n\n    let mut removed_total = 0.0;\n    for (layer, weight) in state.substrate_layers.iter_mut().zip(weights.iter()) {\n        let share = target_mg * (*weight / total_weight);\n        let pool = if is_nitrogen {\n            &mut layer.nutrient_store_mg_n_total\n        } else {\n            &mut layer.nutrient_store_mg_p_total\n        };\n        let removed = (*pool).min(share);\n        *pool -= removed;\n        removed_total += removed;\n    }\n\n    let mut remainder = (target_mg - removed_total).max(0.0);\n    if remainder > f64::EPSILON {\n        for layer in &mut state.substrate_layers {\n            if remainder <= f64::EPSILON {\n                break;\n            }\n            let pool = if is_nitrogen {\n                &mut layer.nutrient_store_mg_n_total\n            } else {\n                &mut layer.nutrient_store_mg_p_total\n            };\n            let removed = (*pool).min(remainder);\n            *pool -= removed;\n            remainder -= removed;\n            removed_total += removed;\n        }\n    }\n\n    removed_total\n}\n\nfn total_substrate_n(state: &TankState) -> f64 {\n    state\n        .substrate_layers\n        .iter()\n        .map(|layer| layer.nutrient_store_mg_n_total)\n        .sum()\n}\n\nfn total_substrate_p(state: &TankState) -> f64 {\n    state\n        .substrate_layers\n        .iter()\n        .map(|layer| layer.nutrient_store_mg_p_total)\n        .sum()\n}\n\nfn half_saturation(value: f64, half_sat: f64) -> f64 {\n    let half_sat = half_sat.max(f64::MIN_POSITIVE);\n    (value / (value + half_sat)).clamp(0.0, 1.0)\n}\n\nfn gaussian_response(value: f64, optimum: f64, sigma: f64) -> f64 {\n    let sigma = sigma.max(0.1);\n    let diff = value - optimum;\n    (-(diff * diff) / (2.0 * sigma * sigma))\n        .exp()\n        .clamp(0.0, 1.0)\n}\n","numLines":279,"startLine":1,"totalLines":279}}}
