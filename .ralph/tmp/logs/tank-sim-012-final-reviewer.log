{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RbvAdAUKczU5QRFohYPG95","type":"tool_result","content":"     1→use std::collections::BTreeMap;\n     2→\n     3→use serde::{Deserialize, Serialize};\n     4→\n     5→use crate::rng::{SimRng, SimSeed};\n     6→\n     7→use super::{\n     8→    AlgaeState, AnimalState, DetritusState, EnvironmentState, FilterState, HardwareState,\n     9→    MicrobeState, MicrofaunaState, PlantGuild, PlantGuildState, ProcessParams, ShrimpRuntimeParams,\n    10→    SimEvent, SourceWaterProfile, StabilityTracker, SubstrateKind, SubstrateLayerState,\n    11→    TankGeometry, WaterState,\n    12→};\n    13→\n    14→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq, Default)]\n    15→pub struct SimMeta {\n    16→    pub scenario_id: Option<String>,\n    17→    pub notes: Option<String>,\n    18→}\n    19→\n    20→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    21→pub struct TankState {\n    22→    pub meta: SimMeta,\n    23→    pub geometry: TankGeometry,\n    24→    pub environment: EnvironmentState,\n    25→    pub hardware: HardwareState,\n    26→    pub water: WaterState,\n    27→    pub substrate_layers: Vec<SubstrateLayerState>,\n    28→    pub filter_state: FilterState,\n    29→    pub plant_guilds: Vec<PlantGuildState>,\n    30→    pub algae: AlgaeState,\n    31→    pub microbe: MicrobeState,\n    32→    pub microfauna: MicrofaunaState,\n    33→    pub animal: AnimalState,\n    34→    pub detritus: DetritusState,\n    35→    pub event_log: Vec<SimEvent>,\n    36→    #[serde(default)]\n    37→    pub last_event_day: BTreeMap<String, u32>,\n    38→    pub rng: SimRng,\n    39→    /// Runtime-resolved source-water catalog keyed by preset id.\n    40→    pub source_water_catalog: BTreeMap<String, SourceWaterProfile>,\n    41→    /// Runtime-resolved process parameters for heat transfer and chemistry systems.\n    42→    pub process_params: ProcessParams,\n    43→    /// Materialized shrimp species parameters for deterministic save/load.\n    44→    #[serde(default)]\n    45→    pub shrimp_params: ShrimpRuntimeParams,\n    46→    /// Tracks recent chemistry swings for shrimp stress.\n    47→    #[serde(default)]\n    48→    pub stability_tracker: StabilityTracker,\n    49→}\n    50→\n    51→impl TankState {\n    52→    pub fn new(seed: SimSeed) -> Self {\n    53→        let geometry = TankGeometry::default();\n    54→        Self {\n    55→            meta: SimMeta::default(),\n    56→            geometry: geometry.clone(),\n    57→            environment: EnvironmentState::default(),\n    58→            hardware: HardwareState::default(),\n    59→            water: WaterState::default_for_geometry(&geometry),\n    60→            substrate_layers: vec![SubstrateLayerState::default()],\n    61→            filter_state: FilterState::default(),\n    62→            plant_guilds: vec![\n    63→                PlantGuildState::default(),\n    64→                PlantGuildState {\n    65→                    guild: PlantGuild::RootFeedingRosette,\n    66→                    biomass_g: 3.0,\n    67→                    health_index: 0.8,\n    68→                    crowding_index: 0.1,\n    69→                    habitat_index: 0.7,\n    70→                },\n    71→            ],\n    72→            algae: AlgaeState::default(),\n    73→            microbe: MicrobeState::default(),\n    74→            microfauna: MicrofaunaState::default(),\n    75→            animal: AnimalState::default(),\n    76→            detritus: DetritusState::default(),\n    77→            event_log: Vec::new(),\n    78→            last_event_day: BTreeMap::new(),\n    79→            rng: SimRng::new(seed),\n    80→            source_water_catalog: BTreeMap::new(),\n    81→            process_params: ProcessParams::default(),\n    82→            shrimp_params: ShrimpRuntimeParams::default(),\n    83→            stability_tracker: StabilityTracker::default(),\n    84→        }\n    85→    }\n    86→\n    87→    pub fn seeded_example(seed: SimSeed) -> Self {\n    88→        let mut state = Self::new(seed);\n    89→        state.meta.scenario_id = Some(\"seeded_example\".to_string());\n    90→        state.substrate_layers = vec![\n    91→            SubstrateLayerState {\n    92→                kind: SubstrateKind::ActivePlanted,\n    93→                depth_cm: 2.0,\n    94→                nutrient_store_mg_n_total: 40.0,\n    95→                nutrient_store_mg_p_total: 10.0,\n    96→                cation_exchange_capacity_index: 0.8,\n    97→                detritus_trapping_index: 0.4,\n    98→                colonizable_area_cm2: 400.0,\n    99→                low_oxygen_tendency_index: 0.5,\n   100→                grazing_surface_index: 0.5,\n   101→            },\n   102→            SubstrateLayerState {\n   103→                kind: SubstrateKind::CoarsePorous,\n   104→                depth_cm: 1.0,\n   105→                nutrient_store_mg_n_total: 5.0,\n   106→                nutrient_store_mg_p_total: 1.0,\n   107→                cation_exchange_capacity_index: 0.2,\n   108→                detritus_trapping_index: 0.6,\n   109→                colonizable_area_cm2: 250.0,\n   110→                low_oxygen_tendency_index: 0.6,\n   111→                grazing_surface_index: 0.7,\n   112→            },\n   113→        ];\n   114→        state\n   115→    }\n   116→\n   117→    pub fn avg_substrate_index<F>(&self, select: F) -> f64\n   118→    where\n   119→        F: Fn(&SubstrateLayerState) -> f64,\n   120→    {\n   121→        if self.substrate_layers.is_empty() {\n   122→            return 0.0;\n   123→        }\n   124→\n   125→        let total_depth: f64 = self\n   126→            .substrate_layers\n   127→            .iter()\n   128→            .map(|layer| layer.depth_cm.max(0.0))\n   129→            .sum();\n   130→        if total_depth <= f64::EPSILON {\n   131→            return 0.0;\n   132→        }\n   133→\n   134→        let weighted_sum = self\n   135→            .substrate_layers\n   136→            .iter()\n   137→            .map(|layer| layer.depth_cm.max(0.0) * select(layer).clamp(0.0, 1.0))\n   138→            .sum::<f64>();\n   139→\n   140→        (weighted_sum / total_depth).clamp(0.0, 1.0)\n   141→    }\n   142→}\n   143→\n   144→impl Default for TankState {\n   145→    fn default() -> Self {\n   146→        Self::new(SimSeed(0))\n   147→    }\n   148→}\n   149→"}]},"parent_tool_use_id":"toolu_012EDB2wEDrNTKc9RkMxVE8g","session_id":"d9e19a3d-7c7f-4e59-85c1-196d8c055a3e","uuid":"3a5d916b-83ad-4b47-be7c-a85c4dd10e40"}
