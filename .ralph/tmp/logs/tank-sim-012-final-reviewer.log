{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"awk 'FNR==1{print \\\"FILE \\\" FILENAME} {printf \\\"%5d %s\\\\n\\\", FNR, \"'$0}'\"' crates/tank_core/src/systems/mod.rs crates/tank_core/src/systems/light.rs crates/tank_core/src/systems/temperature.rs crates/tank_core/src/systems/water_change.rs crates/tank_core/src/systems/chemistry.rs crates/tank_core/src/systems/dissolved_oxygen.rs\"","aggregated_output":"FILE crates/tank_core/src/systems/mod.rs\n    1 pub mod algae_growth;\n    2 pub mod chemistry;\n    3 pub mod dissolved_oxygen;\n    4 pub mod events;\n    5 pub mod light;\n    6 pub mod microfauna;\n    7 pub mod nitrogen_cycle;\n    8 pub mod plant_growth;\n    9 pub mod shrimp;\n   10 pub mod temperature;\n   11 pub mod water_change;\nFILE crates/tank_core/src/systems/light.rs\n    1 pub fn is_light_on(hour_of_day: u8, photoperiod_hours: f64) -> bool {\n    2     if photoperiod_hours <= 0.0 {\n    3         return false;\n    4     }\n    5     if photoperiod_hours >= 24.0 {\n    6         return true;\n    7     }\n    8 \n    9     let midpoint_hour = f64::from(hour_of_day % 24) + 0.5;\n   10     let start_hour = 12.0 - photoperiod_hours / 2.0;\n   11     let end_hour = 12.0 + photoperiod_hours / 2.0;\n   12 \n   13     midpoint_hour >= start_hour && midpoint_hour < end_hour\n   14 }\n   15 \n   16 #[cfg(test)]\n   17 mod tests {\n   18     use super::is_light_on;\n   19 \n   20     #[test]\n   21     fn centered_on_noon_for_even_photoperiod() {\n   22         let lit_hours: Vec<u8> = (0..24).filter(|hour| is_light_on(*hour, 8.0)).collect();\n   23         assert_eq!(lit_hours, vec![8, 9, 10, 11, 12, 13, 14, 15]);\n   24     }\n   25 \n   26     #[test]\n   27     fn zero_and_full_day_photoperiods() {\n   28         assert!(!(0..24).any(|hour| is_light_on(hour, 0.0)));\n   29         assert!((0..24).all(|hour| is_light_on(hour, 24.0)));\n   30     }\n   31 }\nFILE crates/tank_core/src/systems/temperature.rs\n    1 use crate::types::TankState;\n    2 \n    3 /// DO saturation in mg/L from linear interpolation over the reference table:\n    4 /// 0°C → 14.6, 10°C → 11.3, 20°C → 9.1, 30°C → 7.6\n    5 pub fn do_sat_mg_l(temp_c: f64) -> f64 {\n    6     const TABLE: [(f64, f64); 4] = [(0.0, 14.6), (10.0, 11.3), (20.0, 9.1), (30.0, 7.6)];\n    7 \n    8     if temp_c <= TABLE[0].0 {\n    9         return TABLE[0].1;\n   10     }\n   11     if temp_c >= TABLE[TABLE.len() - 1].0 {\n   12         return TABLE[TABLE.len() - 1].1;\n   13     }\n   14 \n   15     for i in 0..TABLE.len() - 1 {\n   16         let (t0, do0) = TABLE[i];\n   17         let (t1, do1) = TABLE[i + 1];\n   18         if temp_c >= t0 && temp_c <= t1 {\n   19             let frac = (temp_c - t0) / (t1 - t0);\n   20             return do0 + frac * (do1 - do0);\n   21         }\n   22     }\n   23 \n   24     // Fallback (shouldn't reach here)\n   25     TABLE[TABLE.len() - 1].1\n   26 }\n   27 \n   28 /// Hourly discrete heat-transfer model.\n   29 ///\n   30 /// Updates `state.water.temperature_c` based on ambient temperature, heater,\n   31 /// and tank geometry. Records heater output on `state.hardware.heater.last_output_w`.\n   32 pub fn step_temperature(state: &mut TankState) {\n   33     let dt_s = 3600.0_f64;\n   34     let volume_l = state.geometry.water_volume_l();\n   35     if volume_l <= f64::EPSILON {\n   36         return;\n   37     }\n   38 \n   39     let heat_capacity_j_per_k = volume_l * 4186.0;\n   40 \n   41     let surface_area_m2 = state.geometry.surface_area_cm2() / 10_000.0;\n   42     let wall_area_m2 = state.geometry.wall_area_cm2() / 10_000.0;\n   43     let top_factor = state.geometry.top_exchange_factor();\n   44 \n   45     let k_surface = state.process_params.k_surface_w_per_m2_k;\n   46     let k_wall = state.process_params.k_wall_w_per_m2_k;\n   47 \n   48     let ua_total_w_per_k = (k_surface * surface_area_m2 * top_factor) + (k_wall * wall_area_m2);\n   49 \n   50     let ambient_temp_c = state.environment.ambient_temp_c;\n   51     let water_temp_c = state.water.temperature_c;\n   52 \n   53     let q_ambient_w = ua_total_w_per_k * (ambient_temp_c - water_temp_c);\n   54 \n   55     // Heater: only fires when enabled and water is below setpoint - deadband/2\n   56     let q_heater_w = if state.hardware.heater.enabled\n   57         && water_temp_c\n   58             < (state.hardware.heater.setpoint_c - state.hardware.heater.deadband_c / 2.0)\n   59     {\n   60         (state.hardware.heater.max_watts * state.hardware.heater.efficiency).max(0.0)\n   61     } else {\n   62         0.0\n   63     };\n   64 \n   65     state.hardware.heater.last_output_w = q_heater_w;\n   66 \n   67     let delta_temp_c = (q_ambient_w + q_heater_w) * dt_s / heat_capacity_j_per_k;\n   68     state.water.temperature_c += delta_temp_c;\n   69 }\n   70 \n   71 #[cfg(test)]\n   72 mod tests {\n   73     use super::*;\n   74 \n   75     #[test]\n   76     fn do_sat_boundaries() {\n   77         assert!((do_sat_mg_l(0.0) - 14.6).abs() < 0.01);\n   78         assert!((do_sat_mg_l(10.0) - 11.3).abs() < 0.01);\n   79         assert!((do_sat_mg_l(20.0) - 9.1).abs() < 0.01);\n   80         assert!((do_sat_mg_l(30.0) - 7.6).abs() < 0.01);\n   81     }\n   82 \n   83     #[test]\n   84     fn do_sat_interpolation() {\n   85         let mid = do_sat_mg_l(15.0);\n   86         // Midpoint between 11.3 and 9.1 = 10.2\n   87         assert!((mid - 10.2).abs() < 0.01);\n   88     }\n   89 \n   90     #[test]\n   91     fn do_sat_clamp() {\n   92         assert!((do_sat_mg_l(-5.0) - 14.6).abs() < 0.01);\n   93         assert!((do_sat_mg_l(40.0) - 7.6).abs() < 0.01);\n   94     }\n   95 }\nFILE crates/tank_core/src/systems/water_change.rs\n    1 use crate::types::{SimError, SourceWaterProfile, TankState};\n    2 \n    3 /// Validates that all water change actions in the queue reference known and valid source profiles.\n    4 /// Returns the first error found, or Ok(()) if all are valid.\n    5 /// Checks both catalog membership and runtime validity (finite, non-negative chemistry).\n    6 pub fn validate_water_changes(\n    7     state: &TankState,\n    8     actions: &[crate::types::PlayerAction],\n    9 ) -> Result<(), SimError> {\n   10     for action in actions {\n   11         if let crate::types::PlayerAction::WaterChangePercent {\n   12             source_profile_id, ..\n   13         } = action\n   14         {\n   15             match state.source_water_catalog.get(source_profile_id) {\n   16                 None => {\n   17                     return Err(SimError::UnknownSourceProfile {\n   18                         id: source_profile_id.clone(),\n   19                     });\n   20                 }\n   21                 Some(profile) => {\n   22                     profile.validate(source_profile_id)?;\n   23                 }\n   24             }\n   25         }\n   26     }\n   27     Ok(())\n   28 }\n   29 \n   30 /// Applies a water change: removes `percent/100` of each dissolved total,\n   31 /// then adds replacement mass from the source-water profile using exchanged liters.\n   32 /// Also mixes water temperature proportionally by exchanged volume.\n   33 ///\n   34 /// A 0% water change is a no-op.\n   35 pub fn apply_water_change(state: &mut TankState, percent: f64, source: &SourceWaterProfile) {\n   36     if percent <= 0.0 {\n   37         return;\n   38     }\n   39 \n   40     let volume_l = state.geometry.water_volume_l();\n   41     let fraction = percent / 100.0;\n   42     let retention = 1.0 - fraction;\n   43     let exchanged_l = volume_l * fraction;\n   44 \n   45     // Remove fraction of each dissolved total\n   46     state.water.ammonia_total_mg_n_total *= retention;\n   47     state.water.nitrite_mg_n_total *= retention;\n   48     state.water.nitrate_mg_n_total *= retention;\n   49     state.water.phosphate_mg_p_total *= retention;\n   50     state.water.dissolved_inorganic_carbon_mg_c_total *= retention;\n   51     state.water.dissolved_organic_carbon_mg_c_total *= retention;\n   52     state.water.dissolved_organic_nitrogen_mg_n_total *= retention;\n   53     state.water.alkalinity_meq_total *= retention;\n   54     state.water.calcium_mg_total *= retention;\n   55     state.water.magnesium_mg_total *= retention;\n   56     state.water.sodium_mg_total *= retention;\n   57     state.water.potassium_mg_total *= retention;\n   58     state.water.bicarbonate_mg_total *= retention;\n   59     state.water.chloride_mg_total *= retention;\n   60     state.water.sulfate_mg_total *= retention;\n   61 \n   62     // Add replacement mass from source water\n   63     state.water.ammonia_total_mg_n_total += source.ammonia_mg_n_per_l * exchanged_l;\n   64     state.water.nitrite_mg_n_total += source.nitrite_mg_n_per_l * exchanged_l;\n   65     state.water.nitrate_mg_n_total += source.nitrate_mg_n_per_l * exchanged_l;\n   66     state.water.phosphate_mg_p_total += source.phosphate_mg_p_per_l * exchanged_l;\n   67     state.water.dissolved_inorganic_carbon_mg_c_total += source.dic_mg_c_per_l * exchanged_l;\n   68     state.water.dissolved_organic_carbon_mg_c_total += source.doc_mg_c_per_l * exchanged_l;\n   69     state.water.dissolved_organic_nitrogen_mg_n_total += source.don_mg_n_per_l * exchanged_l;\n   70     state.water.alkalinity_meq_total += source.alkalinity_meq_per_l * exchanged_l;\n   71     state.water.calcium_mg_total += source.calcium_mg_per_l * exchanged_l;\n   72     state.water.magnesium_mg_total += source.magnesium_mg_per_l * exchanged_l;\n   73     state.water.sodium_mg_total += source.sodium_mg_per_l * exchanged_l;\n   74     state.water.potassium_mg_total += source.potassium_mg_per_l * exchanged_l;\n   75     state.water.bicarbonate_mg_total += source.bicarbonate_mg_per_l * exchanged_l;\n   76     state.water.chloride_mg_total += source.chloride_mg_per_l * exchanged_l;\n   77     state.water.sulfate_mg_total += source.sulfate_mg_per_l * exchanged_l;\n   78 \n   79     // Mix temperature proportionally by exchanged volume\n   80     state.water.temperature_c =\n   81         state.water.temperature_c * retention + source.temperature_c * fraction;\n   82 }\nFILE crates/tank_core/src/systems/chemistry.rs\n    1 use crate::types::TankState;\n    2 \n    3 const ADULT_SHRIMP_BIOMASS_G: f64 = 0.12;\n    4 const JUVENILE_SHRIMP_BIOMASS_G: f64 = 0.05;\n    5 const ALKALINITY_FEEDBACK_MEQ_PER_MG_C: f64 = 0.0002;\n    6 \n    7 pub fn compute_ph_from_totals(\n    8     alkalinity_meq_total: f64,\n    9     dissolved_inorganic_carbon_mg_c_total: f64,\n   10     volume_l: f64,\n   11 ) -> f64 {\n   12     if volume_l <= f64::EPSILON {\n   13         return 7.0;\n   14     }\n   15 \n   16     let alkalinity_meq_l = alkalinity_meq_total / volume_l;\n   17     let dic_mmol_l = (dissolved_inorganic_carbon_mg_c_total / 12.0) / volume_l;\n   18 \n   19     (6.3 + safe_log10(alkalinity_meq_l.max(0.05)) - safe_log10(dic_mmol_l.max(0.02)))\n   20         .clamp(5.5, 8.5)\n   21 }\n   22 \n   23 pub fn compute_nh3_mg_l(tan_mg_l: f64, ph: f64, temp_c: f64) -> f64 {\n   24     let pka = 0.09018 + 2729.92 / (273.2 + temp_c);\n   25     let fraction_nh3 = 1.0 / (1.0 + 10.0_f64.powf(pka - ph));\n   26     tan_mg_l * fraction_nh3\n   27 }\n   28 \n   29 pub fn step_hourly_chemistry(state: &mut TankState, light_on: bool) {\n   30     let volume_l = state.geometry.water_volume_l();\n   31     if volume_l <= f64::EPSILON {\n   32         return;\n   33     }\n   34 \n   35     let respiration_dic_mg = state\n   36         .process_params\n   37         .respiration_dic_rate_mg_c_per_g_per_hour\n   38         * respiring_biomass_g(state);\n   39     let photosynthesis_dic_mg = if light_on {\n   40         state\n   41             .process_params\n   42             .photosynthesis_dic_rate_mg_c_per_g_per_hour\n   43             * photosynthetic_biomass_g(state)\n   44             * state.hardware.light.intensity_index\n   45     } else {\n   46         0.0\n   47     };\n   48     let net_dic_delta_mg = respiration_dic_mg - photosynthesis_dic_mg;\n   49 \n   50     state.water.dissolved_inorganic_carbon_mg_c_total =\n   51         (state.water.dissolved_inorganic_carbon_mg_c_total + net_dic_delta_mg).max(0.0);\n   52     state.water.alkalinity_meq_total = (state.water.alkalinity_meq_total\n   53         - (net_dic_delta_mg * ALKALINITY_FEEDBACK_MEQ_PER_MG_C))\n   54         .max(0.0);\n   55     state.water.ph = compute_ph_from_totals(\n   56         state.water.alkalinity_meq_total,\n   57         state.water.dissolved_inorganic_carbon_mg_c_total,\n   58         volume_l,\n   59     );\n   60 }\n   61 \n   62 pub(crate) fn respiring_biomass_g(state: &TankState) -> f64 {\n   63     let plant_biomass_g: f64 = state.plant_guilds.iter().map(|plant| plant.biomass_g).sum();\n   64     let algae_biomass_g = state.algae.suspended_biomass_g + state.algae.periphyton_biomass_g;\n   65     let microbe_biomass_g = state.microbe.decomposer_biomass_g\n   66         + state.microbe.ammonia_oxidizer_biomass_g\n   67         + state.microbe.nitrite_oxidizer_biomass_g\n   68         + state.microbe.comammox_biomass_g;\n   69     let shrimp_biomass_g = (f64::from(state.animal.adults_count) * ADULT_SHRIMP_BIOMASS_G)\n   70         + (f64::from(state.animal.juveniles_count) * JUVENILE_SHRIMP_BIOMASS_G);\n   71 \n   72     plant_biomass_g + algae_biomass_g + microbe_biomass_g + shrimp_biomass_g\n   73 }\n   74 \n   75 pub(crate) fn photosynthetic_biomass_g(state: &TankState) -> f64 {\n   76     let plant_biomass_g: f64 = state.plant_guilds.iter().map(|plant| plant.biomass_g).sum();\n   77     plant_biomass_g + state.algae.periphyton_biomass_g + state.algae.suspended_biomass_g\n   78 }\n   79 \n   80 fn safe_log10(value: f64) -> f64 {\n   81     value.max(f64::MIN_POSITIVE).log10()\n   82 }\nFILE crates/tank_core/src/systems/dissolved_oxygen.rs\n    1 use crate::{\n    2     systems::{\n    3         chemistry::{photosynthetic_biomass_g, respiring_biomass_g},\n    4         temperature::do_sat_mg_l,\n    5     },\n    6     types::TankState,\n    7 };\n    8 \n    9 pub fn step_dissolved_oxygen(state: &mut TankState, light_on: bool) {\n   10     let volume_l = state.geometry.water_volume_l();\n   11     if volume_l <= f64::EPSILON {\n   12         return;\n   13     }\n   14 \n   15     let do_sat_mg_l = do_sat_mg_l(state.water.temperature_c);\n   16     let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n   17     let aeration_intensity = if state.hardware.aeration.enabled {\n   18         state.hardware.aeration.intensity\n   19     } else {\n   20         0.0\n   21     };\n   22     let filter_kla_boost = if state.hardware.filter.enabled {\n   23         0.02 * (state.hardware.filter.flow_lph / 200.0).min(2.0)\n   24     } else {\n   25         0.0\n   26     };\n   27     let k_la = (state.process_params.reaeration_kla_base * state.geometry.top_exchange_factor())\n   28         + (state.process_params.aeration_kla_boost * aeration_intensity)\n   29         + filter_kla_boost;\n   30     let delta_do_reaeration_mg = k_la * (do_sat_mg_l - do_mg_l) * volume_l;\n   31 \n   32     let background_bod_mg = state\n   33         .process_params\n   34         .background_bod_mg_o2_per_g_biomass_per_hour\n   35         * respiring_biomass_g(state);\n   36     let photosynthetic_o2_mg = if light_on {\n   37         state\n   38             .process_params\n   39             .plant_photosynthesis_o2_mg_per_g_per_hour\n   40             * photosynthetic_biomass_g(state)\n   41             * state.hardware.light.intensity_index\n   42     } else {\n   43         0.0\n   44     };\n   45 \n   46     state.water.dissolved_oxygen_mg_total +=\n   47         delta_do_reaeration_mg + photosynthetic_o2_mg - background_bod_mg;\n   48 }\n","exit_code":0,"status":"completed"}}
