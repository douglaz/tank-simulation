{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"awk 'FNR==1{print \\\"FILE \\\" FILENAME} {printf \\\"%5d %s\\\\n\\\", FNR, \"'$0}'\"' crates/tank_data/src/presets.rs | sed -n '1,220p'\"","aggregated_output":"FILE crates/tank_data/src/presets.rs\n    1 use serde::{Deserialize, Serialize};\n    2 \n    3 #[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    4 pub struct Provenance {\n    5     pub source_title: Option<String>,\n    6     pub source_year: Option<u16>,\n    7     pub confidence: Option<String>,\n    8     pub notes: Option<String>,\n    9 }\n   10 \n   11 #[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n   12 pub struct SourceWaterPreset {\n   13     pub id: String,\n   14     pub name: String,\n   15     pub temperature_c: f64,\n   16     pub ammonia_mg_n_per_l: f64,\n   17     pub nitrite_mg_n_per_l: f64,\n   18     pub nitrate_mg_n_per_l: f64,\n   19     pub phosphate_mg_p_per_l: f64,\n   20     pub dic_mg_c_per_l: f64,\n   21     pub doc_mg_c_per_l: f64,\n   22     pub don_mg_n_per_l: f64,\n   23     pub alkalinity_meq_per_l: f64,\n   24     pub calcium_mg_per_l: f64,\n   25     pub magnesium_mg_per_l: f64,\n   26     pub sodium_mg_per_l: f64,\n   27     pub potassium_mg_per_l: f64,\n   28     pub bicarbonate_mg_per_l: f64,\n   29     pub chloride_mg_per_l: f64,\n   30     pub sulfate_mg_per_l: f64,\n   31     pub provenance: Option<Provenance>,\n   32 }\n   33 \n   34 impl SourceWaterPreset {\n   35     /// Validates that all chemistry fields are finite and non-negative.\n   36     pub fn validate(&self) -> Result<(), String> {\n   37         let fields: &[(&str, f64)] = &[\n   38             (\"temperature_c\", self.temperature_c),\n   39             (\"ammonia_mg_n_per_l\", self.ammonia_mg_n_per_l),\n   40             (\"nitrite_mg_n_per_l\", self.nitrite_mg_n_per_l),\n   41             (\"nitrate_mg_n_per_l\", self.nitrate_mg_n_per_l),\n   42             (\"phosphate_mg_p_per_l\", self.phosphate_mg_p_per_l),\n   43             (\"dic_mg_c_per_l\", self.dic_mg_c_per_l),\n   44             (\"doc_mg_c_per_l\", self.doc_mg_c_per_l),\n   45             (\"don_mg_n_per_l\", self.don_mg_n_per_l),\n   46             (\"alkalinity_meq_per_l\", self.alkalinity_meq_per_l),\n   47             (\"calcium_mg_per_l\", self.calcium_mg_per_l),\n   48             (\"magnesium_mg_per_l\", self.magnesium_mg_per_l),\n   49             (\"sodium_mg_per_l\", self.sodium_mg_per_l),\n   50             (\"potassium_mg_per_l\", self.potassium_mg_per_l),\n   51             (\"bicarbonate_mg_per_l\", self.bicarbonate_mg_per_l),\n   52             (\"chloride_mg_per_l\", self.chloride_mg_per_l),\n   53             (\"sulfate_mg_per_l\", self.sulfate_mg_per_l),\n   54         ];\n   55         for (name, value) in fields {\n   56             if !value.is_finite() {\n   57                 return Err(format!(\"field `{name}` must be finite, got {value}\"));\n   58             }\n   59             if *value < 0.0 {\n   60                 return Err(format!(\"field `{name}` must be non-negative, got {value}\"));\n   61             }\n   62         }\n   63         Ok(())\n   64     }\n   65 }\n   66 \n   67 #[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n   68 pub struct SubstratePreset {\n   69     pub id: String,\n   70     pub name: String,\n   71     pub depth_cm: f64,\n   72     pub cation_exchange_capacity_index: f64,\n   73     pub detritus_trapping_index: f64,\n   74     pub colonizable_area_factor: f64,\n   75     pub low_oxygen_tendency_index: f64,\n   76     pub grazing_surface_index: f64,\n   77     pub nutrient_charge_mg_n_total: f64,\n   78     pub nutrient_charge_mg_p_total: f64,\n   79     pub provenance: Option<Provenance>,\n   80 }\n   81 \n   82 #[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n   83 pub struct PlantPreset {\n   84     pub id: String,\n   85     pub name: String,\n   86     pub guild: String,\n   87     pub growth_rate_index: f64,\n   88     pub water_column_uptake_bias: f64,\n   89     pub substrate_uptake_bias: f64,\n   90     pub provenance: Option<Provenance>,\n   91 }\n   92 \n   93 #[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n   94 pub struct ShrimpPreset {\n   95     pub id: String,\n   96     pub name: String,\n   97     pub species: String,\n   98     pub optimal_temp_min_c: f64,\n   99     pub optimal_temp_max_c: f64,\n  100     pub gh_min_d: f64,\n  101     pub gh_max_d: f64,\n  102     #[serde(default = \"default_shrimp_base_spawn_rate\")]\n  103     pub base_spawn_rate: f64,\n  104     #[serde(default = \"default_shrimp_egg_duration_days\")]\n  105     pub egg_duration_days: u32,\n  106     #[serde(default = \"default_shrimp_hatch_success_base\")]\n  107     pub hatch_success_base: f64,\n  108     #[serde(default = \"default_shrimp_juvenile_sensitivity\")]\n  109     pub juvenile_sensitivity: f64,\n  110     #[serde(default = \"default_shrimp_high_temp_repro_penalty_start\")]\n  111     pub high_temp_repro_penalty_start_c: f64,\n  112     #[serde(default = \"default_shrimp_high_temp_repro_penalty_full\")]\n  113     pub high_temp_repro_penalty_full_c: f64,\n  114     pub provenance: Option<Provenance>,\n  115 }\n  116 \n  117 impl ShrimpPreset {\n  118     /// Validates that all shrimp species parameters are finite, non-negative,\n  119     /// and logically consistent.\n  120     pub fn validate(&self) -> Result<(), String> {\n  121         let fields: &[(&str, f64)] = &[\n  122             (\"optimal_temp_min_c\", self.optimal_temp_min_c),\n  123             (\"optimal_temp_max_c\", self.optimal_temp_max_c),\n  124             (\"gh_min_d\", self.gh_min_d),\n  125             (\"gh_max_d\", self.gh_max_d),\n  126             (\"base_spawn_rate\", self.base_spawn_rate),\n  127             (\"hatch_success_base\", self.hatch_success_base),\n  128             (\"juvenile_sensitivity\", self.juvenile_sensitivity),\n  129             (\n  130                 \"high_temp_repro_penalty_start_c\",\n  131                 self.high_temp_repro_penalty_start_c,\n  132             ),\n  133             (\n  134                 \"high_temp_repro_penalty_full_c\",\n  135                 self.high_temp_repro_penalty_full_c,\n  136             ),\n  137         ];\n  138         for (name, value) in fields {\n  139             if !value.is_finite() {\n  140                 return Err(format!(\"field `{name}` must be finite, got {value}\"));\n  141             }\n  142             if *value < 0.0 {\n  143                 return Err(format!(\"field `{name}` must be non-negative, got {value}\"));\n  144             }\n  145         }\n  146         if self.egg_duration_days == 0 {\n  147             return Err(\"egg_duration_days must be > 0\".to_string());\n  148         }\n  149         if self.optimal_temp_min_c >= self.optimal_temp_max_c {\n  150             return Err(format!(\n  151                 \"optimal_temp_min_c ({}) must be < optimal_temp_max_c ({})\",\n  152                 self.optimal_temp_min_c, self.optimal_temp_max_c\n  153             ));\n  154         }\n  155         if self.gh_min_d >= self.gh_max_d {\n  156             return Err(format!(\n  157                 \"gh_min_d ({}) must be < gh_max_d ({})\",\n  158                 self.gh_min_d, self.gh_max_d\n  159             ));\n  160         }\n  161         if self.high_temp_repro_penalty_start_c >= self.high_temp_repro_penalty_full_c {\n  162             return Err(format!(\n  163                 \"high_temp_repro_penalty_start_c ({}) must be < high_temp_repro_penalty_full_c ({})\",\n  164                 self.high_temp_repro_penalty_start_c, self.high_temp_repro_penalty_full_c\n  165             ));\n  166         }\n  167         if self.base_spawn_rate > 1.0 {\n  168             return Err(format!(\n  169                 \"base_spawn_rate must be <= 1.0, got {}\",\n  170                 self.base_spawn_rate\n  171    