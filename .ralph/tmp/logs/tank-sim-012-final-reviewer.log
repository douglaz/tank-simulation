   53→        // Step 4: update water temperature from ambient and heater\n    54→        systems::temperature::step_temperature(&mut self.state);\n    55→\n    56→        // Step 5: compute light state for the current hour.\n    57→        let light_on = self.state.hardware.light.enabled\n    58→            && systems::light::is_light_on(\n    59→                self.state.environment.hour_of_day,\n    60→                self.state.hardware.light.photoperiod_hours,\n    61→            );\n    62→\n    63→        // Step 6-8: nitrogen cycle phase (feed leaching, detritus breakdown,\n    64→        // mineralization, nitrification, guild growth/decay).\n    65→        // This runs between light-state resolution and chemistry/DO/event phases.\n    66→        // Nitrification O2 consumption and alkalinity depletion are handled\n    67→        // internally by the nitrogen cycle system.\n    68→        let _nc_output = systems::nitrogen_cycle::step_nitrogen_cycle(&mut self.state);\n    69→\n    70→        // Step 9: update DIC, alkalinity, and pH.\n    71→        systems::chemistry::step_hourly_chemistry(&mut self.state, light_on);\n    72→\n    73→        // Step 10 / 11-partial: update dissolved oxygen with background respiration and\n    74→        // light-driven photosynthetic support from existing biomass.\n    75→        systems::dissolved_oxygen::step_dissolved_oxygen(&mut self.state, light_on);\n    76→\n    77→        // Step 12: hourly shrimp stress accumulation.\n    78→        systems::shrimp::step_hourly_shrimp_stress(&mut self.state);\n    79→\n    80→        // Step 13: emit threshold-based chemistry warnings.\n    81→        systems::events::emit_hourly_threshold_events(&mut self.state);\n    82→\n    83→        self.state.environment.hour_of_day = (self.state.environment.hour_of_day + 1) % 24;\n    84→        if self.state.environment.hour_of_day == 0 {\n    85→            self.state.environment.day += 1;\n    86→            // Daily pipeline\n    87→            self.run_daily_update();\n    88→        }\n    89→\n    90→        enforce_invariants(&mut self.state)\n    91→    }\n    92→\n    93→    fn run_daily_update(&mut self) {\n    94→        // Daily pipeline: plants → algae → microfauna → shrimp → biofilter → stability\n    95→        systems::plant_growth::step_daily_plants(&mut self.state);\n    96→        systems::algae_growth::step_daily_algae(&mut self.state);\n    97→        systems::microfauna::step_daily_microfauna(&mut self.state);\n    98→        systems::shrimp::step_daily_shrimp(&mut self.state);\n    99→        systems::nitrogen_cycle::update_daily_filter_clogging(&mut self.state);\n   100→\n   101→        // Biofilter maturity summary update\n   102→        let maturity_delta =\n   103→            systems::nitrogen_cycle::update_daily_biofilter_maturity(&mut self.state);\n   104→        if maturity_delta > 0.005 {\n   105→            self.push_event(\n   106→                EventSeverity::Info,\n   107→                EventKind::BiofilmMaturityIncrease,\n   108→                vec![EventCause::BiofilterImmature],\n   109→                format!(\n   110→                    \"Biofilter maturity increased to {:.3}\",\n   111→                    self.state.filter_state.biofilter_maturity_index\n   112→                ),\n   113→            );\n   114→        }\n   115→        // Emit CycleProgressing when maturity is actively growing\n   116→        let current_maturity = self.state.filter_state.biofilter_maturity_index;\n   117→        if maturity_delta > 0.001 && current_maturity < 0.9 {\n   118→            systems::events::emit_once_per_day_pub(\n   119→                &mut self.state,\n   120→                EventSeverity::Info,\n   121→                EventKind::CycleProgressing,\n   122→                vec![EventCause::BiofilterImmature],\n   123→                format!(\"Nitrogen cycle progressing, maturity {current_maturity:.3}\"),\n   124→            );\n   125→        }\n   126→\n   127→        // Long-term stability metrics\n   128→        systems::shrimp::update_stability_tracker(&mut self.state);\n   129→    }\n   130→\n   131→    fn process_action(&mut self, action: PlayerAction) {\n   132→        match action {\n   133→            PlayerAction::Feed { grams } => {\n   134→                self.state.detritus.particulate_organics_g_total += grams;\n   135→                self.push_event(\n   136→                    EventSeverity::Info,\n   137→                    EventKind::CycleProgressing,\n   138→                    vec![EventCause::Overfeeding],\n   139→                    format!(\"Queued feed processed: {grams:.2} g\"),\n   140→                );\n   141→            }\n   142→            PlayerAction::WaterChangePercent {\n   143→                percent,\n   144→                source_profile_id,\n   145→            } => {\n   146→                if percent <= 0.0 {\n   147→                    return;\n   148→                }\n   149→                // Profile was pre-validated; look it up (guaranteed to exist).\n   150→                let profile = self\n   151→                    .state\n   152→                    .source_water_catalog\n   153→                    .get(&source_profile_id)\n   154→                    .cloned();\n   155→                if let Some(profile) = profile {\n   156→                    systems::water_change::apply_water_change(&mut self.state, percent, &profile);\n   157→                    self.push_event(\n   158→                        EventSeverity::Info,\n   159→                        EventKind::StabilityImproving,\n   160→                        vec![EventCause::WaterChange],\n   161→                        format!(\"Water change processed: {percent:.1}% with {source_profile_id}\"),\n   162→                    );\n   163→                }\n   164→            }\n   165→            PlayerAction::TrimPlants { fraction } => {\n   166→                let mut trimmed_biomass_g = 0.0;\n   167→                for