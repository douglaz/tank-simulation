{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"awk 'FNR==1{print \\\"FILE \\\" FILENAME} {printf \\\"%5d %s\\\\n\\\", FNR, \"'$0}'\"' crates/tank_core/src/systems/shrimp.rs | sed -n '1,260p'\"","aggregated_output":"FILE crates/tank_core/src/systems/shrimp.rs\n    1 use crate::systems::chemistry::compute_nh3_mg_l;\n    2 use crate::types::{\n    3     EggCohort, EventCause, EventKind, EventSeverity, ShrimpRuntimeParams, TankState,\n    4 };\n    5 \n    6 // ── Hourly ──────────────────────────────────────────────────────────────────\n    7 \n    8 /// Accumulates NH3, nitrite, low-DO, heat, and instability stress each hour.\n    9 /// Runs after chemistry/DO updates, before hourly event emission.\n   10 pub fn step_hourly_shrimp_stress(state: &mut TankState) {\n   11     let total = state.animal.adults_count + state.animal.juveniles_count;\n   12     if total == 0 {\n   13         return;\n   14     }\n   15 \n   16     let volume_l = state.geometry.water_volume_l();\n   17     if volume_l <= f64::EPSILON {\n   18         return;\n   19     }\n   20 \n   21     let tan_mg_l = state.water.ammonia_total_mg_n_total / volume_l;\n   22     let nh3_mg_l = compute_nh3_mg_l(tan_mg_l, state.water.ph, state.water.temperature_c);\n   23     let nitrite_mg_l = state.water.nitrite_mg_n_total / volume_l;\n   24     let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n   25     let temp = state.water.temperature_c;\n   26 \n   27     // NH3 stress (threshold 0.02 mg/L, stronger than TAN alone)\n   28     if nh3_mg_l > 0.02 {\n   29         state.animal.hourly_nh3_stress_accum += (nh3_mg_l - 0.02) * 2.0 / 24.0;\n   30     }\n   31 \n   32     // Nitrite stress (threshold 0.5 mg/L)\n   33     if nitrite_mg_l > 0.5 {\n   34         state.animal.hourly_nitrite_stress_accum += (nitrite_mg_l - 0.5) * 0.5 / 24.0;\n   35     }\n   36 \n   37     // Low DO stress (threshold 5.0 mg/L)\n   38     if do_mg_l < 5.0 {\n   39         state.animal.hourly_low_do_stress_accum += (5.0 - do_mg_l) * 0.3 / 24.0;\n   40     }\n   41 \n   42     // Heat stress (above species optimal max)\n   43     let opt_max = state.shrimp_params.optimal_temp_max_c;\n   44     if temp > opt_max {\n   45         state.animal.hourly_heat_stress_accum += (temp - opt_max) * 0.1 / 24.0;\n   46     }\n   47 \n   48     // Instability stress from stability tracker\n   49     state.animal.hourly_instability_stress_accum +=\n   50         state.stability_tracker.instability_index * 0.05 / 24.0;\n   51 }\n   52 \n   53 // ── Daily ───────────────────────────────────────────────────────────────────\n   54 \n   55 /// Full daily shrimp lifecycle: feeding → condition → molt stress →\n   56 /// reproductive readiness → spawning → egg development/hatching →\n   57 /// juvenile recruitment → mortality → events.\n   58 pub fn step_daily_shrimp(state: &mut TankState) {\n   59     let total = state.animal.adults_count + state.animal.juveniles_count;\n   60     if total == 0 && state.animal.berried_females_count == 0 {\n   61         reset_hourly_accumulators(state);\n   62         return;\n   63     }\n   64 \n   65     let volume_l = state.geometry.water_volume_l();\n   66     if volume_l <= f64::EPSILON {\n   67         reset_hourly_accumulators(state);\n   68         return;\n   69     }\n   70 \n   71     shrimp_feeding(state, volume_l);\n   72     update_condition(state, volume_l);\n   73     update_molt_stress(state, volume_l);\n   74     update_reproductive_readiness(state);\n   75     spawning(state);\n   76     egg_development(state);\n   77     juvenile_recruitment(state);\n   78     mortality(state);\n   79     emit_molt_stress_warning(state, volume_l);\n   80 \n   81     reset_hourly_accumulators(state);\n   82 }\n   83 \n   84 /// Updates the stability tracker at the end of each daily cycle.\n   85 pub fn update_stability_tracker(state: &mut TankState) {\n   86     let volume_l = state.geometry.water_volume_l().max(f64::EPSILON);\n   87     let ca_mg_l = state.water.calcium_mg_total / volume_l;\n   88     let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n   89     let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n   90     let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n   91 \n   92     let tracker = &mut state.stability_tracker;\n   93 \n   94     let temp_swing = (state.water.temperature_c - tracker.prev_temp_c).abs();\n   95     let ph_swing = (state.water.ph - tracker.prev_ph).abs();\n   96     let gh_swing = (gh_d - tracker.prev_gh_d).abs();\n   97     let do_swing = (do_mg_l - tracker.prev_do_mg_l).abs();\n   98 \n   99     // Weighted instability normalised to 0..1\n  100     let raw_instability =\n  101         (temp_swing / 3.0 + ph_swing / 0.5 + gh_swing / 3.0 + do_swing / 3.0).clamp(0.0, 1.0);\n  102 \n  103     // Rises quickly, decays slowly\n  104     if raw_instability > tracker.instability_index {\n  105         tracker.instability_index += 0.3 * (raw_instability - tracker.instability_index);\n  106     } else {\n  107         tracker.instability_index += 0.1 * (raw_instability - tracker.instability_index);\n  108     }\n  109     tracker.instability_index = tracker.instability_index.clamp(0.0, 1.0);\n  110 \n  111     tracker.prev_temp_c = state.water.temperature_c;\n  112     tracker.prev_ph = state.water.ph;\n  113     tracker.prev_gh_d = gh_d;\n  114     tracker.prev_do_mg_l = do_mg_l;\n  115 }\n  116 \n  117 // ── Private helpers ─────────────────────────────────────────────────────────\n  118 \n  119 fn shrimp_feeding(state: &mut TankState, _volume_l: f64) {\n  120     let adults = state.animal.adults_count as f64;\n  121     let juveniles = state.animal.juveniles_count as f64;\n  122     let total_feeding_units = adults + juveniles * 0.3;\n  123     if total_feeding_units <= f64::EPSILON {\n  124         state.animal.daily_food_consumed_g = 0.0;\n  125         return;\n  126     }\n  127 \n  128     let rate = state\n  129         .process_params\n  130         .shrimp_periphyton_grazing_g_per_shrimp_per_day;\n  131     let grazing_access_factor =\n  132         0.5 + (0.5 * state.avg_substrate_index(|layer| layer.grazing_surface_index));\n  133     let food_demand = total_feeding_units * rate * grazing_access_factor;\n  134 \n  135     // Shrimp graze periphyton (at most 50% of available per day)\n  136     let max_periph = state.algae.periphyton_biomass_g * 0.5;\n  137     let periph_consumed = food_demand.min(max_periph).max(0.0);\n  138     state.algae.periphyton_biomass_g =\n  139         (state.algae.periphyton_biomass_g - periph_consumed).max(0.0);\n  140 \n  141     // Shrimp also eat fine detritus (biofilm, decomposing organic matter)\n  142     let detritus_demand = total_feeding_units * rate * grazing_access_factor;\n  143     let max_detritus = state.detritus.fine_detritus_g_total * 0.2;\n  144     let detritus_consumed = detritus_demand.min(max_detritus).max(0.0);\n  145     state.detritus.fine_detritus_g_total =\n  146         (state.detritus.fine_detritus_g_total - detritus_consumed).max(0.0);\n  147     state.animal.daily_food_consumed_g = periph_consumed + detritus_consumed;\n  148 }\n  149 \n  150 fn update_condition(state: &mut TankState, volume_l: f64) {\n  151     let tan_mg_l = state.water.ammonia_total_mg_n_total / volume_l;\n  152     let nh3_mg_l = compute_nh3_mg_l(tan_mg_l, state.water.ph, state.water.temperature_c);\n  153     let nitrite_mg_l = state.water.nitrite_mg_n_total / volume_l;\n  154     let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n  155     let temp = state.water.temperature_c;\n  156 \n  157     let ca_mg_l = state.water.calcium_mg_total / volume_l;\n  158     let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n  159     let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n  160 \n  161     let total_feeding_units =\n  162         state.animal.adults_count as f64 + state.animal.juveniles_count as f64 * 0.3;\n  163     let target_food_g = total_feeding_units\n  164         * state\n  165             .process_params\n  166             .shrimp_periphyton_grazing_g_per_shrimp_per_day\n  167         * 2.0;\n  168     let food_factor = if target_food_g > f64::EPSILON {\n  169         let satiation = (state.animal.daily_food_consumed_g / target_food_g).clamp(0.0, 1.0);\n  170         0.4 + (0.6 * satiation)\n  171     } else {\n  172         1.0\n  173     };\n  174     let do_factor = (do_mg_l / 6.0).clamp(0.0, 1.0);\n  175     // NH3 risk: condition degrades steadily, reaching zero at ~0.33 mg/L NH3\n  176     let nh3_factor = (1.0 - nh3_mg_l * 3.0).clamp(0.0, 1.0);\n  177     let nitrite_factor = (1.0 - nitrite_mg_l * 0.5).clamp(0.0, 1.0);\n  178 \n  179     let params = &state.shrimp_params;\n  180     let temp_factor = temp_condition_factor(temp, params);\n  181     let gh_factor = gh_mineral_factor(gh_d, params);\n  182     let instability_factor = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n  183 \n  184     let stress_penalty = state.animal.hourly_nh3_stress_accum\n  185         + state.animal.hourly_nitrite_stress_accum\n  186         + state.animal.hourly_low_do_stress_accum\n  187         + state.animal.hourly_heat_stress_accum\n  188         + state.animal.hourly_instability_stress_accum;\n  189 \n  190     let target = (food_factor\n  191         * do_factor\n  192         * nh3_factor\n  193         * nitrite_factor\n  194         * temp_factor\n  195         * gh_factor\n  196         * instability_factor\n  197         - stress_penalty * 0.5)\n  198         .clamp(0.0, 1.0);\n  199 \n  200     let smoothing = state.process_params.shrimp_condition_smoothing;\n  201     state.animal.condition_index += smoothing * (target - state.animal.condition_index);\n  202     state.animal.condition_index = state.animal.condition_index.clamp(0.0, 1.0);\n  203 }\n  204 \n  205 fn update_molt_stress(state: &mut TankState, volume_l: f64) {\n  206     let ca_mg_l = state.water.calcium_mg_total / volume_l;\n  207     let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n  208     let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n  209     let params = &state.shrimp_params;\n  210 \n  211     let gh_stress = if gh_d < params.gh_min_d {\n  212         (params.gh_min_d - gh_d) / params.gh_min_d\n  213     } else {\n  214         0.0\n  215     };\n  216 \n  217     let instability_stress = state.stability_tracker.instability_index;\n  218     let condition_stress = (0.5 - state.animal.condition_index).max(0.0);\n  219     let thermal_stress = if state.water.temperature_c > params.optimal_temp_max_c {\n  220         ((state.water.temperature_c - params.optimal_temp_max_c) / 8.0).clamp(0.0, 0.5)\n  221     } else {\n  222         0.0\n  223     };\n  224 \n  225     let hourly_pressure =\n  226         state.animal.hourly_heat_stress_accum + state.animal.hourly_instability_stress_accum;\n  227 \n  228     let stress_pressure = (gh_stress * 0.3\n  229         + instability_stress * 0.3\n  230         + condition_stress * 0.2\n  231         + thermal_stress * 0.2\n  232         + hourly_pressure * 0.3)\n  233         .clamp(0.0, 1.0);\n  234 \n  235     // Rises quickly, decays slowly\n  236     if stress_pressure > state.animal.molt_stress_index {\n  237         state.animal.molt_stress_index += 0.2 * (stress_pressure - state.animal.molt_stress_index);\n  238     } else {\n  239         state.animal.molt_stress_index += 0.05 * (stress_pressure - state.animal.molt_stress_index);\n  240     }\n  241     state.animal.molt_stress_index = state.animal.molt_stress_index.clamp(0.0, 1.0);\n  242 }\n  243 \n  244 fn update_reproductive_readiness(state: &mut TankState) {\n  245     let temp = state.water.temperature_c;\n  246     let params = &state.shrimp_params;\n  247 \n  248     let f_temp = temp_repro_factor(temp, params);\n  249     let f_condition = state.animal.condition_index;\n  250     let f_stability = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n  251     let f_molt = (1.0 - state.animal.molt_stress_index).clamp(0.0, 1.0);\n  252 \n  253     let target = (f_temp * f_condition * f_stability * f_molt).clamp(0.0, 1.0);\n  254 \n  255     state.animal.reproductive_readiness_index +=\n  256         0.1 * (target - state.animal.reproductive_readiness_index);\n  257     state.animal.reproductive_readiness_index =\n  258         state.animal.reproductive_readiness_index.clamp(0.0, 1.0);\n  259 }\n","exit_code":0,"status":"completed"}}
