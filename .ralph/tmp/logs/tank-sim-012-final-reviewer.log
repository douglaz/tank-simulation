{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C1m9RvtJPUqXtYNg9xWPgy","type":"tool_result","content":"     1→use crate::systems::chemistry::compute_nh3_mg_l;\n     2→use crate::types::{\n     3→    EggCohort, EventCause, EventKind, EventSeverity, ShrimpRuntimeParams, TankState,\n     4→};\n     5→\n     6→// ── Hourly ──────────────────────────────────────────────────────────────────\n     7→\n     8→/// Accumulates NH3, nitrite, low-DO, heat, and instability stress each hour.\n     9→/// Runs after chemistry/DO updates, before hourly event emission.\n    10→pub fn step_hourly_shrimp_stress(state: &mut TankState) {\n    11→    let total = state.animal.adults_count + state.animal.juveniles_count;\n    12→    if total == 0 {\n    13→        return;\n    14→    }\n    15→\n    16→    let volume_l = state.geometry.water_volume_l();\n    17→    if volume_l <= f64::EPSILON {\n    18→        return;\n    19→    }\n    20→\n    21→    let tan_mg_l = state.water.ammonia_total_mg_n_total / volume_l;\n    22→    let nh3_mg_l = compute_nh3_mg_l(tan_mg_l, state.water.ph, state.water.temperature_c);\n    23→    let nitrite_mg_l = state.water.nitrite_mg_n_total / volume_l;\n    24→    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n    25→    let temp = state.water.temperature_c;\n    26→\n    27→    // NH3 stress (threshold 0.02 mg/L, stronger than TAN alone)\n    28→    if nh3_mg_l > 0.02 {\n    29→        state.animal.hourly_nh3_stress_accum += (nh3_mg_l - 0.02) * 2.0 / 24.0;\n    30→    }\n    31→\n    32→    // Nitrite stress (threshold 0.5 mg/L)\n    33→    if nitrite_mg_l > 0.5 {\n    34→        state.animal.hourly_nitrite_stress_accum += (nitrite_mg_l - 0.5) * 0.5 / 24.0;\n    35→    }\n    36→\n    37→    // Low DO stress (threshold 5.0 mg/L)\n    38→    if do_mg_l < 5.0 {\n    39→        state.animal.hourly_low_do_stress_accum += (5.0 - do_mg_l) * 0.3 / 24.0;\n    40→    }\n    41→\n    42→    // Heat stress (above species optimal max)\n    43→    let opt_max = state.shrimp_params.optimal_temp_max_c;\n    44→    if temp > opt_max {\n    45→        state.animal.hourly_heat_stress_accum += (temp - opt_max) * 0.1 / 24.0;\n    46→    }\n    47→\n    48→    // Instability stress from stability tracker\n    49→    state.animal.hourly_instability_stress_accum +=\n    50→        state.stability_tracker.instability_index * 0.05 / 24.0;\n    51→}\n    52→\n    53→// ── Daily ───────────────────────────────────────────────────────────────────\n    54→\n    55→/// Full daily shrimp lifecycle: feeding → condition → molt stress →\n    56→/// reproductive readiness → spawning → egg development/hatching →\n    57→/// juvenile recruitment → mortality → events.\n    58→pub fn step_daily_shrimp(state: &mut TankState) {\n    59→    let total = state.animal.adults_count + state.animal.juveniles_count;\n    60→    if total == 0 && state.animal.berried_females_count == 0 {\n    61→        reset_hourly_accumulators(state);\n    62→        return;\n    63→    }\n    64→\n    65→    let volume_l = state.geometry.water_volume_l();\n    66→    if volume_l <= f64::EPSILON {\n    67→        reset_hourly_accumulators(state);\n    68→        return;\n    69→    }\n    70→\n    71→    shrimp_feeding(state, volume_l);\n    72→    update_condition(state, volume_l);\n    73→    update_molt_stress(state, volume_l);\n    74→    update_reproductive_readiness(state);\n    75→    spawning(state);\n    76→    egg_development(state);\n    77→    juvenile_recruitment(state);\n    78→    mortality(state);\n    79→    emit_molt_stress_warning(state, volume_l);\n    80→\n    81→    reset_hourly_accumulators(state);\n    82→}\n    83→\n    84→/// Updates the stability tracker at the end of each daily cycle.\n    85→pub fn update_stability_tracker(state: &mut TankState) {\n    86→    let volume_l = state.geometry.water_volume_l().max(f64::EPSILON);\n    87→    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n    88→    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n    89→    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n    90→    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n    91→\n    92→    let tracker = &mut state.stability_tracker;\n    93→\n    94→    let temp_swing = (state.water.temperature_c - tracker.prev_temp_c).abs();\n    95→    let ph_swing = (state.water.ph - tracker.prev_ph).abs();\n    96→    let gh_swing = (gh_d - tracker.prev_gh_d).abs();\n    97→    let do_swing = (do_mg_l - tracker.prev_do_mg_l).abs();\n    98→\n    99→    // Weighted instability normalised to 0..1\n   100→    let raw_instability =\n   101→        (temp_swing / 3.0 + ph_swing / 0.5 + gh_swing / 3.0 + do_swing / 3.0).clamp(0.0, 1.0);\n   102→\n   103→    // Rises quickly, decays slowly\n   104→    if raw_instability > tracker.instability_index {\n   105→        tracker.instability_index += 0.3 * (raw_instability - tracker.instability_index);\n   106→    } else {\n   107→        tracker.instability_index += 0.1 * (raw_instability - tracker.instability_index);\n   108→    }\n   109→    tracker.instability_index = tracker.instability_index.clamp(0.0, 1.0);\n   110→\n   111→    tracker.prev_temp_c = state.water.temperature_c;\n   112→    tracker.prev_ph = state.water.ph;\n   113→    tracker.prev_gh_d = gh_d;\n   114→    tracker.prev_do_mg_l = do_mg_l;\n   115→}\n   116→\n   117→// ── Private helpers ─────────────────────────────────────────────────────────\n   118→\n   119→fn shrimp_feeding(state: &mut TankState, _volume_l: f64) {\n   120→    let adults = state.animal.adults_count as f64;\n   121→    let juveniles = state.animal.juveniles_count as f64;\n   122→    let total_feeding_units = adults + juveniles * 0.3;\n   123→    if total_feeding_units <= f64::EPSILON {\n   124→        state.animal.daily_food_consumed_g = 0.0;\n   125→        return;\n   126→    }\n   127→\n   128→    let rate = state\n   129→        .process_params\n   130→        .shrimp_periphyton_grazing_g_per_shrimp_per_day;\n   131→    let grazing_access_factor =\n   132→        0.5 + (0.5 * state.avg_substrate_index(|layer| layer.grazing_surface_index));\n   133→    let food_demand = total_feeding_units * rate * grazing_access_factor;\n   134→\n   135→    // Shrimp graze periphyton (at most 50% of available per day)\n   136→    let max_periph = state.algae.periphyton_biomass_g * 0.5;\n   137→    let periph_consumed = food_demand.min(max_periph).max(0.0);\n   138→    state.algae.periphyton_biomass_g =\n   139→        (state.algae.periphyton_biomass_g - periph_consumed).max(0.0);\n   140→\n   141→    // Shrimp also eat fine detritus (biofilm, decomposing organic matter)\n   142→    let detritus_demand = total_feeding_units * rate * grazing_access_factor;\n   143→    let max_detritus = state.detritus.fine_detritus_g_total * 0.2;\n   144→    let detritus_consumed = detritus_demand.min(max_detritus).max(0.0);\n   145→    state.detritus.fine_detritus_g_total =\n   146→        (state.detritus.fine_detritus_g_total - detritus_consumed).max(0.0);\n   147→    state.animal.daily_food_consumed_g = periph_consumed + detritus_consumed;\n   148→}\n   149→\n   150→fn update_condition(state: &mut TankState, volume_l: f64) {\n   151→    let tan_mg_l = state.water.ammonia_total_mg_n_total / volume_l;\n   152→    let nh3_mg_l = compute_nh3_mg_l(tan_mg_l, state.water.ph, state.water.temperature_c);\n   153→    let nitrite_mg_l = state.water.nitrite_mg_n_total / volume_l;\n   154→    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n   155→    let temp = state.water.temperature_c;\n   156→\n   157→    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n   158→    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n   159→    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n   160→\n   161→    let total_feeding_units =\n   162→        state.animal.adults_count as f64 + state.animal.juveniles_count as f64 * 0.3;\n   163→    let target_food_g = total_feeding_units\n   164→        * state\n   165→            .process_params\n   166→            .shrimp_periphyton_grazing_g_per_shrimp_per_day\n   167→        * 2.0;\n   168→    let food_factor = if target_food_g > f64::EPSILON {\n   169→        let satiation = (state.animal.daily_food_consumed_g / target_food_g).clamp(0.0, 1.0);\n   170→        0.4 + (0.6 * satiation)\n   171→    } else {\n   172→        1.0\n   173→    };\n   174→    let do_factor = (do_mg_l / 6.0).clamp(0.0, 1.0);\n   175→    // NH3 risk: condition degrades steadily, reaching zero at ~0.33 mg/L NH3\n   176→    let nh3_factor = (1.0 - nh3_mg_l * 3.0).clamp(0.0, 1.0);\n   177→    let nitrite_factor = (1.0 - nitrite_mg_l * 0.5).clamp(0.0, 1.0);\n   178→\n   179→    let params = &state.shrimp_params;\n   180→    let temp_factor = temp_condition_factor(temp, params);\n   181→    let gh_factor = gh_mineral_factor(gh_d, params);\n   182→    let instability_factor = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n   183→\n   184→    let stress_penalty = state.animal.hourly_nh3_stress_accum\n   185→        + state.animal.hourly_nitrite_stress_accum\n   186→        + state.animal.hourly_low_do_stress_accum\n   187→        + state.animal.hourly_heat_stress_accum\n   188→        + state.animal.hourly_instability_stress_accum;\n   189→\n   190→    let target = (food_factor\n   191→        * do_factor\n   192→        * nh3_factor\n   193→        * nitrite_factor\n   194→        * temp_factor\n   195→        * gh_factor\n   196→        * instability_factor\n   197→        - stress_penalty * 0.5)\n   198→        .clamp(0.0, 1.0);\n   199→\n   200→    let smoothing = state.process_params.shrimp_condition_smoothing;\n   201→    state.animal.condition_index += smoothing * (target - state.animal.condition_index);\n   202→    state.animal.condition_index = state.animal.condition_index.clamp(0.0, 1.0);\n   203→}\n   204→\n   205→fn update_molt_stress(state: &mut TankState, volume_l: f64) {\n   206→    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n   207→    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n   208→    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n   209→    let params = &state.shrimp_params;\n   210→\n   211→    let gh_stress = if gh_d < params.gh_min_d {\n   212→        (params.gh_min_d - gh_d) / params.gh_min_d\n   213→    } else {\n   214→        0.0\n   215→    };\n   216→\n   217→    let instability_stress = state.stability_tracker.instability_index;\n   218→    let condition_stress = (0.5 - state.animal.condition_index).max(0.0);\n   219→    let thermal_stress = if state.water.temperature_c > params.optimal_temp_max_c {\n   220→        ((state.water.temperature_c - params.optimal_temp_max_c) / 8.0).clamp(0.0, 0.5)\n   221→    } else {\n   222→        0.0\n   223→    };\n   224→\n   225→    let hourly_pressure =\n   226→        state.animal.hourly_heat_stress_accum + state.animal.hourly_instability_stress_accum;\n   227→\n   228→    let stress_pressure = (gh_stress * 0.3\n   229→        + instability_stress * 0.3\n   230→        + condition_stress * 0.2\n   231→        + thermal_stress * 0.2\n   232→        + hourly_pressure * 0.3)\n   233→        .clamp(0.0, 1.0);\n   234→\n   235→    // Rises quickly, decays slowly\n   236→    if stress_pressure > state.animal.molt_stress_index {\n   237→        state.animal.molt_stress_index += 0.2 * (stress_pressure - state.animal.molt_stress_index);\n   238→    } else {\n   239→        state.animal.molt_stress_index += 0.05 * (stress_pressure - state.animal.molt_stress_index);\n   240→    }\n   241→    state.animal.molt_stress_index = state.animal.molt_stress_index.clamp(0.0, 1.0);\n   242→}\n   243→\n   244→fn update_reproductive_readiness(state: &mut TankState) {\n   245→    let temp = state.water.temperature_c;\n   246→    let params = &state.shrimp_params;\n   247→\n   248→    let f_temp = temp_repro_factor(temp, params);\n   249→    let f_condition = state.animal.condition_index;\n   250→    let f_stability = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n   251→    let f_molt = (1.0 - state.animal.molt_stress_index).clamp(0.0, 1.0);\n   252→\n   253→    let target = (f_temp * f_condition * f_stability * f_molt).clamp(0.0, 1.0);\n   254→\n   255→    state.animal.reproductive_readiness_index +=\n   256→        0.1 * (target - state.animal.reproductive_readiness_index);\n   257→    state.animal.reproductive_readiness_index =\n   258→        state.animal.reproductive_readiness_index.clamp(0.0, 1.0);\n   259→}\n   260→\n   261→fn spawning(state: &mut TankState) {\n   262→    if state.animal.adults_count == 0 {\n   263→        return;\n   264→    }\n   265→\n   266→    let eligible = ((0.5 * state.animal.adults_count as f64)\n   267→        - state.animal.berried_females_count as f64)\n   268→        .max(0.0) as u32;\n   269→\n   270→    if eligible == 0 {\n   271→        return;\n   272→    }\n   273→\n   274→    let temp = state.water.temperature_c;\n   275→    let params = &state.shrimp_params;\n   276→\n   277→    let f_temp = temp_repro_factor(temp, params);\n   278→    let f_condition = state.animal.condition_index;\n   279→    let f_stability = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n   280→\n   281→    let volume_l = state.geometry.water_volume_l().max(f64::EPSILON);\n   282→    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n   283→    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n   284→    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n   285→    let f_mineral = gh_mineral_factor(gh_d, params);\n   286→\n   287→    let p_spawn = params.base_spawn_rate * f_temp * f_condition * f_stability * f_mineral;\n   288→\n   289→    let mut new_berried = 0u32;\n   290→    for _ in 0..eligible {\n   291→        if state.rng.next_f64() < p_spawn {\n   292→            new_berried += 1;\n   293→        }\n   294→    }\n   295→\n   296→    if new_berried > 0 {\n   297→        state.animal.berried_females_count += new_berried;\n   298→        // Create a new cohort for this batch of berried females\n   299→        state.animal.egg_cohorts.push(EggCohort {\n   300→            count: new_berried,\n   301→            progress_days: 0.0,\n   302→        });\n   303→\n   304→        crate::systems::events::emit_once_per_day_pub(\n   305→            state,\n   306→            EventSeverity::Info,\n   307→            EventKind::ShrimpBerried,\n   308→            vec![EventCause::RoutineAction],\n   309→            format!(\"{new_berried} female(s) became berried\"),\n   310→        );\n   311→    }\n   312→}\n   313→\n   314→fn egg_development(state: &mut TankState) {\n   315→    if state.animal.egg_cohorts.is_empty() {\n   316→        // Legacy path: if berried females exist without cohorts (e.g. from old save),\n   317→        // migrate them into a single cohort using the current egg_progress_days.\n   318→        if state.animal.berried_females_count > 0 {\n   319→            state.animal.egg_cohorts.push(EggCohort {\n   320→                count: state.animal.berried_females_count,\n   321→                progress_days: state.animal.egg_progress_days,\n   322→            });\n   323→        } else {\n   324→            return;\n   325→        }\n   326→    }\n   327→\n   328→    let volume_l = state.geometry.water_volume_l().max(f64::EPSILON);\n   329→    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n   330→    let temp = state.water.temperature_c;\n   331→    let params = &state.shrimp_params;\n   332→\n   333→    let f_condition = state.animal.condition_index;\n   334→    let f_oxygen = (do_mg_l / 6.0).clamp(0.0, 1.0);\n   335→    let f_temp = temp_repro_factor(temp, params);\n   336→    let f_stability = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n   337→\n   338→    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n   339→    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n   340→    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n   341→    let f_mineral = gh_mineral_factor(gh_d, params);\n   342→\n   343→    let p_hatch =\n   344→        params.hatch_success_base * f_condition * f_oxygen * f_temp * f_stability * f_mineral;\n   345→\n   346→    let egg_duration = params.egg_duration_days as f64;\n   347→    let mut total_successful = 0u32;\n   348→    let mut total_failed = 0u32;\n   349→    let mut resolved_berried = 0u32;\n   350→\n   351→    // Advance each cohort; resolve only those that have reached duration\n   352→    let mut i = 0;\n   353→    while i < state.animal.egg_cohorts.len() {\n   354→        state.animal.egg_cohorts[i].progress_days += 1.0;\n   355→\n   356→        if state.animal.egg_cohorts[i].progress_days >= egg_duration {\n   357→            let cohort = state.animal.egg_cohorts.remove(i);\n   358→            resolved_berried += cohort.count;\n   359→\n   360→            for _ in 0..cohort.count {\n   361→                if state.rng.next_f64() < p_hatch {\n   362→                    total_successful += 1;\n   363→                } else {\n   364→                    total_failed += 1;\n   365→                }\n   366→            }\n   367→            // Don't increment i; the next cohort shifted into position\n   368→        } else {\n   369→            i += 1;\n   370→        }\n   371→    }\n   372→\n   373→    // Successful hatches produce juveniles (~25 per clutch for Neocaridina)\n   374→    let juveniles_per_clutch = 25u32;\n   375→    if total_successful > 0 {\n   376→        state.animal.juveniles_count += total_successful * juveniles_per_clutch;\n   377→    }\n   378→\n   379→    // Only resolved clutches leave berried_females_count\n   380→    state.animal.berried_females_count = state\n   381→        .animal\n   382→        .berried_females_count\n   383→        .saturating_sub(resolved_berried);\n   384→\n   385→    if total_failed > 0 {\n   386→        // Failure-mode invariant: on hatch failure, juveniles_count does NOT increase\n   387→        let mut causes = Vec::new();\n   388→        if f_oxygen < 0.6 {\n   389→            causes.push(EventCause::LowOxygen);\n   390→        }\n   391→        if f_temp < 0.5 {\n   392→            causes.push(EventCause::HighTemperature);\n   393→        }\n   394→        if f_mineral < 0.6 {\n   395→            causes.push(EventCause::LowMinerals);\n   396→        }\n   397→        if f_stability < 0.6 {\n   398→            causes.push(EventCause::ChemistryInstability);\n   399→        }\n   400→        if causes.is_empty() {\n   401→            causes.push(EventCause::PoorCondition);\n   402→        }\n   403→\n   404→        crate::systems::events::emit_once_per_day_pub(\n   405→            state,\n   406→            EventSeverity::Warning,\n   407→            EventKind::EggFailure,\n   408→            causes,\n   409→            format!(\"{total_failed} clutch(es) failed to hatch\"),\n   410→        );\n   411→    }\n   412→\n   413→    // Update egg_progress_days from remaining cohorts for display/snapshot\n   414→    state.animal.sync_egg_progress_from_cohorts();\n   415→}\n   416→\n   417→fn juvenile_recruitment(state: &mut TankState) {\n   418→    if state.animal.juveniles_count == 0 {\n   419→        return;\n   420→    }\n   421→\n   422→    let maturation_rate = 1.0\n   423→        / state\n   424→            .process_params\n   425→            .shrimp_juvenile_maturation_days\n   426→            .max(1.0);\n   427→    let maturing = (state.animal.juveniles_count as f64 * maturation_rate).floor() as u32;\n   428→    let maturing = maturing.min(state.animal.juveniles_count);\n   429→\n   430→    state.animal.juveniles_count -= maturing;\n   431→    state.animal.adults_count += maturing;\n   432→}\n   433→\n   434→fn mortality(state: &mut TankState) {\n   435→    let base_rate = state.process_params.shrimp_base_mortality_per_day;\n   436→    let stress_scale = state.process_params.shrimp_stress_mortality_scale;\n   437→\n   438→    let stress_total = state.animal.hourly_nh3_stress_accum\n   439→        + state.animal.hourly_nitrite_stress_accum\n   440→        + state.animal.hourly_low_do_stress_accum\n   441→        + state.animal.hourly_heat_stress_accum\n   442→        + (state.animal.molt_stress_index - 0.5).max(0.0)\n   443→        + (0.5 - state.animal.condition_index).max(0.0);\n   444→\n   445→    let p_adult_death = (base_rate + stress_total * stress_scale).clamp(0.0, 0.5);\n   446→\n   447→    let juv_sensitivity = state.shrimp_params.juvenile_sensitivity;\n   448→    let p_juv_death = (base_rate + stress_total * stress_scale * juv_sensitivity).clamp(0.0, 0.5);\n   449→\n   450→    let mut adult_deaths = 0u32;\n   451→    for _ in 0..state.animal.adults_count {\n   452→        if state.rng.next_f64() < p_adult_death {\n   453→            adult_deaths += 1;\n   454→        }\n   455→    }\n   456→\n   457→    let mut juv_deaths = 0u32;\n   458→    for _ in 0..state.animal.juveniles_count {\n   459→        if state.rng.next_f64() < p_juv_death {\n   460→            juv_deaths += 1;\n   461→        }\n   462→    }\n   463→\n   464→    state.animal.adults_count = state.animal.adults_count.saturating_sub(adult_deaths);\n   465→    state.animal.juveniles_count = state.animal.juveniles_count.saturating_sub(juv_deaths);\n   466→\n   467→    // Preserve berried_females <= adults invariant (also trims egg cohorts)\n   468→    state.animal.clamp_berried_to_adults();\n   469→}\n   470→\n   471→fn emit_molt_stress_warning(state: &mut TankState, volume_l: f64) {\n   472→    if state.animal.molt_stress_index <= 0.6 {\n   473→        return;\n   474→    }\n   475→\n   476→    let mut causes = Vec::new();\n   477→    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n   478→    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n   479→    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n   480→\n   481→    if gh_d < state.shrimp_params.gh_min_d {\n   482→        causes.push(EventCause::LowMinerals);\n   483→    }\n   484→    if state.stability_tracker.instability_index > 0.3 {\n   485→        causes.push(EventCause::ChemistryInstability);\n   486→    }\n   487→    if state.water.temperature_c > state.shrimp_params.optimal_temp_max_c {\n   488→        causes.push(EventCause::HighTemperature);\n   489→    }\n   490→    if causes.is_empty() {\n   491→        causes.push(EventCause::PoorCondition);\n   492→    }\n   493→\n   494→    crate::systems::events::emit_once_per_day_pub(\n   495→        state,\n   496→        EventSeverity::Warning,\n   497→        EventKind::MoltStressWarning,\n   498→        causes,\n   499→        format!(\n   500→            \"Molt stress elevated: {:.2}\",\n   501→            state.animal.molt_stress_index\n   502→        ),\n   503→    );\n   504→}\n   505→\n   506→fn reset_hourly_accumulators(state: &mut TankState) {\n   507→    state.animal.hourly_nh3_stress_accum = 0.0;\n   508→    state.animal.hourly_nitrite_stress_accum = 0.0;\n   509→    state.animal.hourly_low_do_stress_accum = 0.0;\n   510→    state.animal.hourly_heat_stress_accum = 0.0;\n   511→    state.animal.hourly_instability_stress_accum = 0.0;\n   512→    state.animal.daily_food_consumed_g = 0.0;\n   513→}\n   514→\n   515→// ── Factor functions ────────────────────────────────────────────────────────\n   516→\n   517→/// Temperature factor for reproduction.\n   518→/// Best 22–26 °C, clearly worse by 30 °C, near-zero by 33 °C.\n   519→fn temp_repro_factor(temp: f64, params: &ShrimpRuntimeParams) -> f64 {\n   520→    let opt_min = params.optimal_temp_min_c;\n   521→    let opt_max = params.optimal_temp_max_c;\n   522→    let penalty_start = params.high_temp_repro_penalty_start_c;\n   523→    let penalty_full = params.high_temp_repro_penalty_full_c;\n   524→\n   525→    if temp < opt_min - 4.0 {\n   526→        0.1\n   527→    } else if temp < opt_min {\n   528→        0.1 + 0.9 * (temp - (opt_min - 4.0)) / 4.0\n   529→    } else if temp <= opt_max {\n   530→        1.0\n   531→    } else if temp <= penalty_start {\n   532→        let range = (penalty_start - opt_max).max(0.01);\n   533→        1.0 - 0.5 * (temp - opt_max) / range\n   534→    } else if temp <= penalty_full {\n   535→        let range = (penalty_full - penalty_start).max(0.01);\n   536→        0.5 - 0.45 * (temp - penalty_start) / range\n   537→    } else {\n   538→        0.05\n   539→    }\n   540→}\n   541→\n   542→/// Temperature factor for general condition (broader bell than reproduction).\n   543→fn temp_condition_factor(temp: f64, params: &ShrimpRuntimeParams) -> f64 {\n   544→    if temp >= params.optimal_temp_min_c && temp <= params.optimal_temp_max_c {\n   545→        1.0\n   546→    } else if temp < params.optimal_temp_min_c {\n   547→        (1.0 - (params.optimal_temp_min_c - temp) / 10.0).clamp(0.2, 1.0)\n   548→    } else {\n   549→        (1.0 - (temp - params.optimal_temp_max_c) / 8.0).clamp(0.2, 1.0)\n   550→    }\n   551→}\n   552→\n   553→/// GH/mineral factor for spawning and condition.\n   554→fn gh_mineral_factor(gh_d: f64, params: &ShrimpRuntimeParams) -> f64 {\n   555→    if gh_d >= params.gh_min_d && gh_d <= params.gh_max_d {\n   556→        1.0\n   557→    } else if gh_d < params.gh_min_d {\n   558→        (gh_d / params.gh_min_d.max(0.01)).clamp(0.3, 1.0)\n   559→    } else {\n   560→        (1.0 - (gh_d - params.gh_max_d) / 10.0).clamp(0.3, 1.0)\n   561→    }\n   562→}\n   563→"}]},"parent_tool_use_id":null,"session_id":"d9e19a3d-7c7f-4e59-85c1-196d8c055a3e","uuid":"c87b4ced-4c08-4b49-8476-431a35892057","tool_use_result":{"type":"text","file":{"filePath":"/root/tank-simulation/crates/tank_core/src/systems/shrimp.rs","content":"use crate::systems::chemistry::compute_nh3_mg_l;\nuse crate::types::{\n    EggCohort, EventCause, EventKind, EventSeverity, ShrimpRuntimeParams, TankState,\n};\n\n// ── Hourly ──────────────────────────────────────────────────────────────────\n\n/// Accumulates NH3, nitrite, low-DO, heat, and instability stress each hour.\n/// Runs after chemistry/DO updates, before hourly event emission.\npub fn step_hourly_shrimp_stress(state: &mut TankState) {\n    let total = state.animal.adults_count + state.animal.juveniles_count;\n    if total == 0 {\n        return;\n    }\n\n    let volume_l = state.geometry.water_volume_l();\n    if volume_l <= f64::EPSILON {\n        return;\n    }\n\n    let tan_mg_l = state.water.ammonia_total_mg_n_total / volume_l;\n    let nh3_mg_l = compute_nh3_mg_l(tan_mg_l, state.water.ph, state.water.temperature_c);\n    let nitrite_mg_l = state.water.nitrite_mg_n_total / volume_l;\n    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n    let temp = state.water.temperature_c;\n\n    // NH3 stress (threshold 0.02 mg/L, stronger than TAN alone)\n    if nh3_mg_l > 0.02 {\n        state.animal.hourly_nh3_stress_accum += (nh3_mg_l - 0.02) * 2.0 / 24.0;\n    }\n\n    // Nitrite stress (threshold 0.5 mg/L)\n    if nitrite_mg_l > 0.5 {\n        state.animal.hourly_nitrite_stress_accum += (nitrite_mg_l - 0.5) * 0.5 / 24.0;\n    }\n\n    // Low DO stress (threshold 5.0 mg/L)\n    if do_mg_l < 5.0 {\n        state.animal.hourly_low_do_stress_accum += (5.0 - do_mg_l) * 0.3 / 24.0;\n    }\n\n    // Heat stress (above species optimal max)\n    let opt_max = state.shrimp_params.optimal_temp_max_c;\n    if temp > opt_max {\n        state.animal.hourly_heat_stress_accum += (temp - opt_max) * 0.1 / 24.0;\n    }\n\n    // Instability stress from stability tracker\n    state.animal.hourly_instability_stress_accum +=\n        state.stability_tracker.instability_index * 0.05 / 24.0;\n}\n\n// ── Daily ───────────────────────────────────────────────────────────────────\n\n/// Full daily shrimp lifecycle: feeding → condition → molt stress →\n/// reproductive readiness → spawning → egg development/hatching →\n/// juvenile recruitment → mortality → events.\npub fn step_daily_shrimp(state: &mut TankState) {\n    let total = state.animal.adults_count + state.animal.juveniles_count;\n    if total == 0 && state.animal.berried_females_count == 0 {\n        reset_hourly_accumulators(state);\n        return;\n    }\n\n    let volume_l = state.geometry.water_volume_l();\n    if volume_l <= f64::EPSILON {\n        reset_hourly_accumulators(state);\n        return;\n    }\n\n    shrimp_feeding(state, volume_l);\n    update_condition(state, volume_l);\n    update_molt_stress(state, volume_l);\n    update_reproductive_readiness(state);\n    spawning(state);\n    egg_development(state);\n    juvenile_recruitment(state);\n    mortality(state);\n    emit_molt_stress_warning(state, volume_l);\n\n    reset_hourly_accumulators(state);\n}\n\n/// Updates the stability tracker at the end of each daily cycle.\npub fn update_stability_tracker(state: &mut TankState) {\n    let volume_l = state.geometry.water_volume_l().max(f64::EPSILON);\n    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n\n    let tracker = &mut state.stability_tracker;\n\n    let temp_swing = (state.water.temperature_c - tracker.prev_temp_c).abs();\n    let ph_swing = (state.water.ph - tracker.prev_ph).abs();\n    let gh_swing = (gh_d - tracker.prev_gh_d).abs();\n    let do_swing = (do_mg_l - tracker.prev_do_mg_l).abs();\n\n    // Weighted instability normalised to 0..1\n    let raw_instability =\n        (temp_swing / 3.0 + ph_swing / 0.5 + gh_swing / 3.0 + do_swing / 3.0).clamp(0.0, 1.0);\n\n    // Rises quickly, decays slowly\n    if raw_instability > tracker.instability_index {\n        tracker.instability_index += 0.3 * (raw_instability - tracker.instability_index);\n    } else {\n        tracker.instability_index += 0.1 * (raw_instability - tracker.instability_index);\n    }\n    tracker.instability_index = tracker.instability_index.clamp(0.0, 1.0);\n\n    tracker.prev_temp_c = state.water.temperature_c;\n    tracker.prev_ph = state.water.ph;\n    tracker.prev_gh_d = gh_d;\n    tracker.prev_do_mg_l = do_mg_l;\n}\n\n// ── Private helpers ─────────────────────────────────────────────────────────\n\nfn shrimp_feeding(state: &mut TankState, _volume_l: f64) {\n    let adults = state.animal.adults_count as f64;\n    let juveniles = state.animal.juveniles_count as f64;\n    let total_feeding_units = adults + juveniles * 0.3;\n    if total_feeding_units <= f64::EPSILON {\n        state.animal.daily_food_consumed_g = 0.0;\n        return;\n    }\n\n    let rate = state\n        .process_params\n        .shrimp_periphyton_grazing_g_per_shrimp_per_day;\n    let grazing_access_factor =\n        0.5 + (0.5 * state.avg_substrate_index(|layer| layer.grazing_surface_index));\n    let food_demand = total_feeding_units * rate * grazing_access_factor;\n\n    // Shrimp graze periphyton (at most 50% of available per day)\n    let max_periph = state.algae.periphyton_biomass_g * 0.5;\n    let periph_consumed = food_demand.min(max_periph).max(0.0);\n    state.algae.periphyton_biomass_g =\n        (state.algae.periphyton_biomass_g - periph_consumed).max(0.0);\n\n    // Shrimp also eat fine detritus (biofilm, decomposing organic matter)\n    let detritus_demand = total_feeding_units * rate * grazing_access_factor;\n    let max_detritus = state.detritus.fine_detritus_g_total * 0.2;\n    let detritus_consumed = detritus_demand.min(max_detritus).max(0.0);\n    state.detritus.fine_detritus_g_total =\n        (state.detritus.fine_detritus_g_total - detritus_consumed).max(0.0);\n    state.animal.daily_food_consumed_g = periph_consumed + detritus_consumed;\n}\n\nfn update_condition(state: &mut TankState, volume_l: f64) {\n    let tan_mg_l = state.water.ammonia_total_mg_n_total / volume_l;\n    let nh3_mg_l = compute_nh3_mg_l(tan_mg_l, state.water.ph, state.water.temperature_c);\n    let nitrite_mg_l = state.water.nitrite_mg_n_total / volume_l;\n    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n    let temp = state.water.temperature_c;\n\n    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n\n    let total_feeding_units =\n        state.animal.adults_count as f64 + state.animal.juveniles_count as f64 * 0.3;\n    let target_food_g = total_feeding_units\n        * state\n            .process_params\n            .shrimp_periphyton_grazing_g_per_shrimp_per_day\n        * 2.0;\n    let food_factor = if target_food_g > f64::EPSILON {\n        let satiation = (state.animal.daily_food_consumed_g / target_food_g).clamp(0.0, 1.0);\n        0.4 + (0.6 * satiation)\n    } else {\n        1.0\n    };\n    let do_factor = (do_mg_l / 6.0).clamp(0.0, 1.0);\n    // NH3 risk: condition degrades steadily, reaching zero at ~0.33 mg/L NH3\n    let nh3_factor = (1.0 - nh3_mg_l * 3.0).clamp(0.0, 1.0);\n    let nitrite_factor = (1.0 - nitrite_mg_l * 0.5).clamp(0.0, 1.0);\n\n    let params = &state.shrimp_params;\n    let temp_factor = temp_condition_factor(temp, params);\n    let gh_factor = gh_mineral_factor(gh_d, params);\n    let instability_factor = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n\n    let stress_penalty = state.animal.hourly_nh3_stress_accum\n        + state.animal.hourly_nitrite_stress_accum\n        + state.animal.hourly_low_do_stress_accum\n        + state.animal.hourly_heat_stress_accum\n        + state.animal.hourly_instability_stress_accum;\n\n    let target = (food_factor\n        * do_factor\n        * nh3_factor\n        * nitrite_factor\n        * temp_factor\n        * gh_factor\n        * instability_factor\n        - stress_penalty * 0.5)\n        .clamp(0.0, 1.0);\n\n    let smoothing = state.process_params.shrimp_condition_smoothing;\n    state.animal.condition_index += smoothing * (target - state.animal.condition_index);\n    state.animal.condition_index = state.animal.condition_index.clamp(0.0, 1.0);\n}\n\nfn update_molt_stress(state: &mut TankState, volume_l: f64) {\n    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n    let params = &state.shrimp_params;\n\n    let gh_stress = if gh_d < params.gh_min_d {\n        (params.gh_min_d - gh_d) / params.gh_min_d\n    } else {\n        0.0\n    };\n\n    let instability_stress = state.stability_tracker.instability_index;\n    let condition_stress = (0.5 - state.animal.condition_index).max(0.0);\n    let thermal_stress = if state.water.temperature_c > params.optimal_temp_max_c {\n        ((state.water.temperature_c - params.optimal_temp_max_c) / 8.0).clamp(0.0, 0.5)\n    } else {\n        0.0\n    };\n\n    let hourly_pressure =\n        state.animal.hourly_heat_stress_accum + state.animal.hourly_instability_stress_accum;\n\n    let stress_pressure = (gh_stress * 0.3\n        + instability_stress * 0.3\n        + condition_stress * 0.2\n        + thermal_stress * 0.2\n        + hourly_pressure * 0.3)\n        .clamp(0.0, 1.0);\n\n    // Rises quickly, decays slowly\n    if stress_pressure > state.animal.molt_stress_index {\n        state.animal.molt_stress_index += 0.2 * (stress_pressure - state.animal.molt_stress_index);\n    } else {\n        state.animal.molt_stress_index += 0.05 * (stress_pressure - state.animal.molt_stress_index);\n    }\n    state.animal.molt_stress_index = state.animal.molt_stress_index.clamp(0.0, 1.0);\n}\n\nfn update_reproductive_readiness(state: &mut TankState) {\n    let temp = state.water.temperature_c;\n    let params = &state.shrimp_params;\n\n    let f_temp = temp_repro_factor(temp, params);\n    let f_condition = state.animal.condition_index;\n    let f_stability = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n    let f_molt = (1.0 - state.animal.molt_stress_index).clamp(0.0, 1.0);\n\n    let target = (f_temp * f_condition * f_stability * f_molt).clamp(0.0, 1.0);\n\n    state.animal.reproductive_readiness_index +=\n        0.1 * (target - state.animal.reproductive_readiness_index);\n    state.animal.reproductive_readiness_index =\n        state.animal.reproductive_readiness_index.clamp(0.0, 1.0);\n}\n\nfn spawning(state: &mut TankState) {\n    if state.animal.adults_count == 0 {\n        return;\n    }\n\n    let eligible = ((0.5 * state.animal.adults_count as f64)\n        - state.animal.berried_females_count as f64)\n        .max(0.0) as u32;\n\n    if eligible == 0 {\n        return;\n    }\n\n    let temp = state.water.temperature_c;\n    let params = &state.shrimp_params;\n\n    let f_temp = temp_repro_factor(temp, params);\n    let f_condition = state.animal.condition_index;\n    let f_stability = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n\n    let volume_l = state.geometry.water_volume_l().max(f64::EPSILON);\n    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n    let f_mineral = gh_mineral_factor(gh_d, params);\n\n    let p_spawn = params.base_spawn_rate * f_temp * f_condition * f_stability * f_mineral;\n\n    let mut new_berried = 0u32;\n    for _ in 0..eligible {\n        if state.rng.next_f64() < p_spawn {\n            new_berried += 1;\n        }\n    }\n\n    if new_berried > 0 {\n        state.animal.berried_females_count += new_berried;\n        // Create a new cohort for this batch of berried females\n        state.animal.egg_cohorts.push(EggCohort {\n            count: new_berried,\n            progress_days: 0.0,\n        });\n\n        crate::systems::events::emit_once_per_day_pub(\n            state,\n            EventSeverity::Info,\n            EventKind::ShrimpBerried,\n            vec![EventCause::RoutineAction],\n            format!(\"{new_berried} female(s) became berried\"),\n        );\n    }\n}\n\nfn egg_development(state: &mut TankState) {\n    if state.animal.egg_cohorts.is_empty() {\n        // Legacy path: if berried females exist without cohorts (e.g. from old save),\n        // migrate them into a single cohort using the current egg_progress_days.\n        if state.animal.berried_females_count > 0 {\n            state.animal.egg_cohorts.push(EggCohort {\n                count: state.animal.berried_females_count,\n                progress_days: state.animal.egg_progress_days,\n            });\n        } else {\n            return;\n        }\n    }\n\n    let volume_l = state.geometry.water_volume_l().max(f64::EPSILON);\n    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n    let temp = state.water.temperature_c;\n    let params = &state.shrimp_params;\n\n    let f_condition = state.animal.condition_index;\n    let f_oxygen = (do_mg_l / 6.0).clamp(0.0, 1.0);\n    let f_temp = temp_repro_factor(temp, params);\n    let f_stability = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n\n    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n    let f_mineral = gh_mineral_factor(gh_d, params);\n\n    let p_hatch =\n        params.hatch_success_base * f_condition * f_oxygen * f_temp * f_stability * f_mineral;\n\n    let egg_duration = params.egg_duration_days as f64;\n    let mut total_successful = 0u32;\n    let mut total_failed = 0u32;\n    let mut resolved_berried = 0u32;\n\n    // Advance each cohort; resolve only those that have reached duration\n    let mut i = 0;\n    while i < state.animal.egg_cohorts.len() {\n        state.animal.egg_cohorts[i].progress_days += 1.0;\n\n        if state.animal.egg_cohorts[i].progress_days >= egg_duration {\n            let cohort = state.animal.egg_cohorts.remove(i);\n            resolved_berried += cohort.count;\n\n            for _ in 0..cohort.count {\n                if state.rng.next_f64() < p_hatch {\n                    total_successful += 1;\n                } else {\n                    total_failed += 1;\n                }\n            }\n            // Don't increment i; the next cohort shifted into position\n        } else {\n            i += 1;\n        }\n    }\n\n    // Successful hatches produce juveniles (~25 per clutch for Neocaridina)\n    let juveniles_per_clutch = 25u32;\n    if total_successful > 0 {\n        state.animal.juveniles_count += total_successful * juveniles_per_clutch;\n    }\n\n    // Only resolved clutches leave berried_females_count\n    state.animal.berried_females_count = state\n        .animal\n        .berried_females_count\n        .saturating_sub(resolved_berried);\n\n    if total_failed > 0 {\n        // Failure-mode invariant: on hatch failure, juveniles_count does NOT increase\n        let mut causes = Vec::new();\n        if f_oxygen < 0.6 {\n            causes.push(EventCause::LowOxygen);\n        }\n        if f_temp < 0.5 {\n            causes.push(EventCause::HighTemperature);\n        }\n        if f_mineral < 0.6 {\n            causes.push(EventCause::LowMinerals);\n        }\n        if f_stability < 0.6 {\n            causes.push(EventCause::ChemistryInstability);\n        }\n        if causes.is_empty() {\n            causes.push(EventCause::PoorCondition);\n        }\n\n        crate::systems::events::emit_once_per_day_pub(\n            state,\n            EventSeverity::Warning,\n            EventKind::EggFailure,\n            causes,\n            format!(\"{total_failed} clutch(es) failed to hatch\"),\n        );\n    }\n\n    // Update egg_progress_days from remaining cohorts for display/snapshot\n    state.animal.sync_egg_progress_from_cohorts();\n}\n\nfn juvenile_recruitment(state: &mut TankState) {\n    if state.animal.juveniles_count == 0 {\n        return;\n    }\n\n    let maturation_rate = 1.0\n        / state\n            .process_params\n            .shrimp_juvenile_maturation_days\n            .max(1.0);\n    let maturing = (state.animal.juveniles_count as f64 * maturation_rate).floor() as u32;\n    let maturing = maturing.min(state.animal.juveniles_count);\n\n    state.animal.juveniles_count -= maturing;\n    state.animal.adults_count += maturing;\n}\n\nfn mortality(state: &mut TankState) {\n    let base_rate = state.process_params.shrimp_base_mortality_per_day;\n    let stress_scale = state.process_params.shrimp_stress_mortality_scale;\n\n    let stress_total = state.animal.hourly_nh3_stress_accum\n        + state.animal.hourly_nitrite_stress_accum\n        + state.animal.hourly_low_do_stress_accum\n        + state.animal.hourly_heat_stress_accum\n        + (state.animal.molt_stress_index - 0.5).max(0.0)\n        + (0.5 - state.animal.condition_index).max(0.0);\n\n    let p_adult_death = (base_rate + stress_total * stress_scale).clamp(0.0, 0.5);\n\n    let juv_sensitivity = state.shrimp_params.juvenile_sensitivity;\n    let p_juv_death = (base_rate + stress_total * stress_scale * juv_sensitivity).clamp(0.0, 0.5);\n\n    let mut adult_deaths = 0u32;\n    for _ in 0..state.animal.adults_count {\n        if state.rng.next_f64() < p_adult_death {\n            adult_deaths += 1;\n        }\n    }\n\n    let mut juv_deaths = 0u32;\n    for _ in 0..state.animal.juveniles_count {\n        if state.rng.next_f64() < p_juv_death {\n            juv_deaths += 1;\n        }\n    }\n\n    state.animal.adults_count = state.animal.adults_count.saturating_sub(adult_deaths);\n    state.animal.juveniles_count = state.animal.juveniles_count.saturating_sub(juv_deaths);\n\n    // Preserve berried_females <= adults invariant (also trims egg cohorts)\n    state.animal.clamp_berried_to_adults();\n}\n\nfn emit_molt_stress_warning(state: &mut TankState, volume_l: f64) {\n    if state.animal.molt_stress_index <= 0.6 {\n        return;\n    }\n\n    let mut causes = Vec::new();\n    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n\n    if gh_d < state.shrimp_params.gh_min_d {\n        causes.push(EventCause::LowMinerals);\n    }\n    if state.stability_tracker.instability_index > 0.3 {\n        causes.push(EventCause::ChemistryInstability);\n    }\n    if state.water.temperature_c > state.shrimp_params.optimal_temp_max_c {\n        causes.push(EventCause::HighTemperature);\n    }\n    if causes.is_empty() {\n        causes.push(EventCause::PoorCondition);\n    }\n\n    crate::systems::events::emit_once_per_day_pub(\n        state,\n        EventSeverity::Warning,\n        EventKind::MoltStressWarning,\n        causes,\n        format!(\n            \"Molt stress elevated: {:.2}\",\n            state.animal.molt_stress_index\n        ),\n    );\n}\n\nfn reset_hourly_accumulators(state: &mut TankState) {\n    state.animal.hourly_nh3_stress_accum = 0.0;\n    state.animal.hourly_nitrite_stress_accum = 0.0;\n    state.animal.hourly_low_do_stress_accum = 0.0;\n    state.animal.hourly_heat_stress_accum = 0.0;\n    state.animal.hourly_instability_stress_accum = 0.0;\n    state.animal.daily_food_consumed_g = 0.0;\n}\n\n// ── Factor functions ────────────────────────────────────────────────────────\n\n/// Temperature factor for reproduction.\n/// Best 22–26 °C, clearly worse by 30 °C, near-zero by 33 °C.\nfn temp_repro_factor(temp: f64, params: &ShrimpRuntimeParams) -> f64 {\n    let opt_min = params.optimal_temp_min_c;\n    let opt_max = params.optimal_temp_max_c;\n    let penalty_start = params.high_temp_repro_penalty_start_c;\n    let penalty_full = params.high_temp_repro_penalty_full_c;\n\n    if temp < opt_min - 4.0 {\n        0.1\n    } else if temp < opt_min {\n        0.1 + 0.9 * (temp - (opt_min - 4.0)) / 4.0\n    } else if temp <= opt_max {\n        1.0\n    } else if temp <= penalty_start {\n        let range = (penalty_start - opt_max).max(0.01);\n        1.0 - 0.5 * (temp - opt_max) / range\n    } else if temp <= penalty_full {\n        let range = (penalty_full - penalty_start).max(0.01);\n        0.5 - 0.45 * (temp - penalty_start) / range\n    } else {\n        0.05\n    }\n}\n\n/// Temperature factor for general condition (broader bell than reproduction).\nfn temp_condition_factor(temp: f64, params: &ShrimpRuntimeParams) -> f64 {\n    if temp >= params.optimal_temp_min_c && temp <= params.optimal_temp_max_c {\n        1.0\n    } else if temp < params.optimal_temp_min_c {\n        (1.0 - (params.optimal_temp_min_c - temp) / 10.0).clamp(0.2, 1.0)\n    } else {\n        (1.0 - (temp - params.optimal_temp_max_c) / 8.0).clamp(0.2, 1.0)\n    }\n}\n\n/// GH/mineral factor for spawning and condition.\nfn gh_mineral_factor(gh_d: f64, params: &ShrimpRuntimeParams) -> f64 {\n    if gh_d >= params.gh_min_d && gh_d <= params.gh_max_d {\n        1.0\n    } else if gh_d < params.gh_min_d {\n        (gh_d / params.gh_min_d.max(0.01)).clamp(0.3, 1.0)\n    } else {\n        (1.0 - (gh_d - params.gh_max_d) / 10.0).clamp(0.3, 1.0)\n    }\n}\n","numLines":563,"startLine":1,"totalLines":563}}}
