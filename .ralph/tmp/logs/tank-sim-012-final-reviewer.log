6\t    }\n   267\t\n   268\t    fn step_hours(&mut self, hours: u32) -> Result<(), SimError> {\n   269\t        for _ in 0..hours {\n   270\t            self.step_one_hour()?;\n   271\t        }\n   272\t        enforce_invariants(&mut self.state)\n   273\t    }\n   274\t\n   275\t    fn snapshot(&self) -> TankSnapshot {\n   276\t        TankSnapshot::from_state(&self.state)\n   277\t    }\n   278\t\n   279\t    fn full_state(&self) -> &TankState {\n   280\t        &self.state\n   281\t    }\n   282\t}\n","exit_code":0,"status":"completed"}}
