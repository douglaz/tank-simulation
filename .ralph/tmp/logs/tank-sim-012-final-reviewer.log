t(digit: char) -> Option<Self> {\n   57         match digit {\n   58             '1' => Some(Self::Overview),\n   59             '2' => Some(Self::Chemistry),\n   60             '3' => Some(Self::Biology),\n   61             '4' => Some(Self::Actions),\n   62             '5' => Some(Self::Log),\n   63             _ => None,\n   64         }\n   65     }\n   66 \n   67     fn index(self) -> usize {\n   68         match self {\n   69             Self::Overview => 0,\n   70             Self::Chemistry => 1,\n   71             Self::Biology => 2,\n   72             Self::Actions => 3,\n   73             Self::Log => 4,\n   74         }\n   75     }\n   76 }\n   77 \n   78 #[derive(Debug, Clone, Copy, PartialEq)]\n   79 pub struct TankSizePreset {\n   80     pub label: &'static str,\n   81     pub size_scale: f64,\n   82 }\n   83 \n   84 #[derive(Debug, Clone, Copy, PartialEq)]\n   85 pub struct FillPreset {\n   86     pub label: &'static str,\n   87     pub fill_ratio: f64,\n   88 }\n   89 \n   90 pub const TANK_SIZE_PRESETS: [TankSizePreset; 3] = [\n   91     TankSizePreset {\n   92         label: \"Compact\",\n   93         size_scale: 0.8,\n   94     },\n   95     TankSizePreset {\n   96         label: \"Baseline\",\n   97         size_scale: 1.0,\n   98     },\n   99     TankSizePreset {\n  100         label: \"Large\",\n  101         size_scale: 1.25,\n  102     },\n  103 ];\n  104 \n  105 pub const FILL_PRESETS: [FillPreset; 3] = [\n  106     FillPreset {\n  107         label: \"75%\",\n  108         fill_ratio: 0.75,\n  109     },\n  110     FillPreset {\n  111         label: \"90%\",\n  112         fill_ratio: 0.9,\n  113     },\n  114     FillPreset {\n  115         label: \"100%\",\n  116         fill_ratio: 1.0,\n  117     },\n  118 ];\n  119 \n  120 #[derive(Debug, Clone, Copy, PartialEq, Eq)]\n  121 pub enum StatusLevel {\n  122     Info,\n  123     Warning,\n  124     Error,\n  125 }\n  126 \n  127 #[derive(Debug, Clone)]\n  128 pub struct StatusMessage {\n  129     pub text: String,\n  130     pub level: StatusLevel,\n  131     expires_at: Instant,\n  132 }\n  133 \n  134 #[derive(Debug, Clone)]\n  135 pub struct TuiApp {\n  136     pub active_screen: Screen,\n  137     pub engine: Engine,\n  138     pub snapshot: TankSnapshot,\n  139     pub auto_advance: bool,\n  140     pub status_message: Option<StatusMessage>,\n  141     pub action_form: ActionFormState,\n  142     pub save_file_path: PathBuf,\n  143     pub scenario_label: String,\n  144     snapshot_history: VecDeque<TankSnapshot>,\n  145 }\n  146 \n  147 impl TuiApp {\n  148     pub fn new(engine: Engine, save_file_path: PathBuf, scenario_label: impl Into<String>) -> Self {\n  149         let snapshot = engine.snapshot();\n  150         let mut snapshot_history = VecDeque::with_capacity(HISTORY_CAPACITY);\n  151         snapshot_history.push_back(snapshot.clone());\n  152 \n  153         Self {\n  154             active_screen: Screen::Overview,\n  155             engine,\n  156             snapshot,\n  157             auto_advance: false,\n  158             status_message: None,\n  159             action_form: ActionFormState::default(),\n  160             save_file_path,\n  161             scenario_label: scenario_label.into(),\n  162             snapshot_history,\n  163         }\n  164     }\n  165 \n  166     pub fn set_screen(&mut self, screen: Screen) {\n  167         self.active_screen = screen;\n  168     }\n  169 \n  170     pub fn next_screen(&mut self) {\n  171         self.active_screen = self.active_screen.next();\n  172     }\n  173 \n  174     pub fn toggle_auto_advance(&mut self) {\n  175         self.auto_advance = !self.auto_advance;\n  176         let state = if self.auto_advance {\n  177             \"enabled\"\n  178         } else {\n  179             \"paused\"\n  180         };\n  181         self.set_status(StatusLevel::Info, format!(\"Auto-advance {state}\"));\n  182     }\n  183 \n  184     pub fn apply_action(&mut self, action: PlayerAction) {\n  185         match self.engine.apply_action(action.clone()) {\n  186             Ok(()) => {\n  187                 self.refresh_snapshot();\n  188                 self.set_status(StatusLevel::Info, format!(\"Queued action: {action:?}\"));\n  189             }\n  190             Err(error) => {\n  191                 self.set_status(StatusLevel::Error, format!(\"Action rejected: {error}\"));\n  192             }\n  193         }\n  194     }\n  195 \n  196     pub fn step_hours(&mut self, hours: u32) {\n  197         match self.engine.step_hours(hours) {\n  198             Ok(()) => {\n  199                 self.refresh_snapshot();\n  200                 let label = match hours {\n  201                     1 => \"Stepped 1 hour\".to_string(),\n  202                     24 => \"Stepped 1 day\".to_string(),\n  203                     168 => \"Stepped 1 week\".to_string(),\n  204                     _ => format!(\"Stepped {hours} hours\"),\n  205                 };\n  206                 self.set_status(StatusLevel::Info, label);\n  207             }\n  208             Err(error) => {\n  209                 self.set_status(StatusLevel::Error, format!(\"Step failed: {error}\"));\n  210             }\n  211         }\n  212     }\n  213 \n  214     pub fn save_to_disk(&mut self) -> anyhow::Result<()> {\n  215         let save = SaveFile::from_engine(&self.engine);\n  216         let json = save\n  217             .to_json_pretty()\n  218             .context(\"failed to serialize save file\")?;\n  219         fs::write(&self.save_file_path, json)\n  220             .with_context(|| format!(\"failed to write {}\", self.save_file_path.display()))?;\n  221         self.set_status(\n  222             StatusLevel::Info,\n  223             format!(\"Saved to {}\", self.save_file_path.display()),\n  224         );\n  225         Ok(())\n  226     }\n  227 \n  228     pub fn load_from_disk(&mut self) -> anyhow::Result<()> {\n  229         let raw = fs::read_to_string(&self.save_file_path)\n  230             .with_context(|| format!(\"failed to read {}\", self.save_file_path.display()))?;\n  231         let save = SaveFile::from_json(&raw).context(\"failed to parse save file\")?;\n  232         self.engine = save.into_engine();\n  233         self.snapshot_history.clear();\n  234         self.refresh_snapshot();\n  235         self.set_status(\n  236             StatusLevel::Info,\n  237             format!(\"Loaded {}\", self.save_file_path.display()),\n  238         );\n  239         Ok(())\n  240     }\n  241 \n  242     pub fn clear_expired_status(&mut self) {\n  243         if self\n  244             .status_message\n  245             .as_ref()\n  246             .is_some_and(|message| Instant::now() >= message.expires_at)\n  247         {\n  248             self.status_message = None;\n  249         }\n  250     }\n  251 \n  252     pub fn history_values<F>(&self, metric: F) -> Vec<f64>\n  253     where\n  254         F: Fn(&TankSnapshot) -> f64,\n  255     {\n  256         self.snapshot_history.iter().map(metric).collect()\n  257     }\n  258 \n  259     pub fn active_warning_lines(&self) -> Vec<String> {\n  260         self.snapshot\n  261             .recent_events\n  262             .iter()\n  263             .rev()\n  264             .filter(|event| !matches!(event.severity, tank_core::EventSeverity::Info))\n  265             .take(4)\n  266             .map(|event| {\n  267                 format!(\n  268                     \"Day {} {:02}:00 {:?}: {}\",\n  269                     event.day, event.hour, event.kind, event.summary\n  270                 )\n  271             })\n  272             .collect()\n  273     }\n  274 \n  275     pub fn show_status(&mut self, level: StatusLevel, text: impl Into<String>) {\n  276         self.set_status(level, text);\n  277     }\n  278 \n  279     pub fn render(&self, frame: &mut Frame<'_>) {\n  280         let chunks = Layout::vertical([\n  281             Constraint::Length(3),\n  282             Constraint::Min(8),\n  283             Constraint::Length(2),\n  284         ])\n  285         .split(frame.size());\n  286 \n  287         let titles = Screen::ALL\n  288             .iter()\n  289             .map(|screen| Line::from(screen.title()))\n  290             .collect::<Vec<_>>();\n  291         let tabs = Tabs::new(titles)\n  292             .select(self.active_screen.index())\n  293             .block(\n  294                 Block::default()\n  295                     .title(format!(\" Tank Sim · {} \", self.scenario_label))\n  296                     .borders(Borders::ALL),\n  297             )\n  298             .highlight_style(\n  299                 Style::default()\n  300                     .fg(Color::Cyan)\n  301                     .add_modifier(Modifier::BOLD),\n  302             );\n  303         frame.render_widget(tabs, chunks[0]);\n  304 \n  305         screens::render_screen(self.active_screen, frame, chunks[1], self);\n  306 \n  307         let footer = Paragraph::new(self.status_line())\n  308             .block(Block::default().borders(Borders::ALL))\n  309             .wrap(ratatui::widgets::Wrap { trim: true });\n  310         frame.render_widget(footer, chunks[2]);\n  311     }\n  312 \n  313     fn refresh_snapshot(&mut self) {\n  314         self.snapshot = self.engine.snapshot();\n  315         if self.snapshot_history.len() == HISTORY_CAPACITY {\n  316             self.snapshot_history.pop_front();\n  317         }\n  318         self.snapshot_history.push_back(self.snapshot.clone());\n  319     }\n  320 \n  321     fn set_status(&mut self, level: StatusLevel, text: impl Into<String>) {\n  322         self.status_message = Some(StatusMessage {\n  323             text: text.into(),\n  324             level,\n  325             expires_at: Instant::now() + STATUS_TTL,\n  326         });\n  327     }\n  328 \n  329     fn status_line(&self) -> Line<'static> {\n  330         let mut spans = vec![\n  331             Span::styled(\"Tab/1-5 switch\", Style::default().fg(Color::DarkGray)),\n  332             Span::raw(\"  \"),\n  333             Span::styled(\"h\", Style::default().fg(Color::Cyan)),\n  334             Span::raw(\" hour  \"),\n  335             Span::styled(\"d\", Style::default().fg(Color::Cyan)),\n  336             Span::raw(\" day  \"),\n  337             Span::styled(\"w\", Style::default().fg(Color::Cyan)),\n  338             Span::raw(\" week  \"),\n  339             Span::styled(\"space\", Style::default().fg(Color::Cyan)),\n  340             Span::raw(\" auto  \"),\n  341             Span::styled(\"s/l\", Style::default().fg(Color::Cyan)),\n  342             Span::raw(\" save/load  \"),\n  343             Span::styled(\"q\", Style::default().fg(Color::Cyan)),\n  344             Span::raw(\" quit\"),\n  345         ];\n  346 \n  347         if let Some(message) = &self.status_message {\n  348             spans.push(Span::raw(\"  |  \"));\n  349             let color = match message.level {\n  350                 StatusLevel::Info => Color::Green,\n  351                 StatusLevel::Warning => Color::Yellow,\n  352                 StatusLevel::Error => Color::Red,\n  353             };\n  354             spans.push(Span::styled(\n  355                 message.text.clone(),\n  356                 Style::default().fg(color),\n  357             ));\n  358         }\n  359 \n  360         Line::from(spans)\n  361     }\n  362 }\nFILE crates/tank_tui/src/input.rs\n    1 use crossterm::event::{KeyCode, KeyEvent, KeyEventKind};\n    2 \n    3 use crate::{screens::actions::ActionKind, Screen, StatusLevel, TuiApp};\n    4 \n    5 #[derive(Debug, Clone, Copy, PartialEq, Eq)]\n    6 pub enum InputOutcome {\n    7     Continue,\n    8     Quit,\n    9 }\n   10 \n   11 pub fn handle_key_event(app: &mut TuiApp, key: KeyEvent) -> InputOutcome {\n   12     if key.kind != KeyEventKind::Press {\n   13         return InputOutcome::Continue;\n   14     }\n   15 \n   16     match key.code {\n   17         KeyCode::Char('q') => return InputOutcome::Quit,\n   18         KeyCode::Tab => app.next_screen(),\n   19         KeyCode::Char(' ') => app.toggle_auto_advance(),\n   20         KeyCode::Char('h') => app.step_hours(1),\n   21         KeyCode::Char('d') => app.step_hours(24),\n   22         KeyCode::Char('w') => app.step_hours(24 * 7),\n   23         KeyCode::Char('s') => {\n   24             if let Err(error) = app.save_to_disk() {\n   25                 app.show_status(StatusLevel::Error, format!(\"Save failed: {error:#}\"));\n   26             }\n   27         }\n   28         KeyCode::Char('l') => {\n   29             if let Err(error) = app.load_from_disk() {\n   30                 app.show_status(StatusLevel::Error, format!(\"Load failed: {error:#}\"));\n   31             }\n   32         }\n   33         KeyCode::Char(digit) if Screen::from_digit(digit).is_some() => {\n   34             if let Some(screen) = Screen::from_digit(digit) {\n   35                 app.set_screen(screen);\n   36             }\n   37         }\n   38         _ => {\n   39             if app.active_screen == Screen::Actions {\n   40                 handle_actions_input(app, key.code);\n   41             }\n   42         }\n   43     }\n   44 \n   45     InputOutcome::Continue\n   46 }\n   47 \n   48 fn handle_actions_input(app: &mut TuiApp, code: KeyCode) {\n   49     match code {\n   50         KeyCode::Up => app.action_form.select_previous_action(),\n   51         KeyCode::Down => app.action_form.select_next_action(),\n   52         KeyCode::Left => app.action_form.select_previous_field(),\n   53         KeyCode::Right => app.action_form.select_next_field(),\n   54         KeyCode::Char('[') => {\n   55             if !app.action_form.cycle_choice(false) {\n   56                 app.show_status(StatusLevel::Warning, \"Selected field is not a choice field\");\n   57             }\n   58         }\n   59         KeyCode::Char(']') => {\n   60             if !app.action_form.cycle_choice(true) {\n   61                 app.show_status(StatusLevel::Warning, \"Selected field is not a choice field\");\n   62             }\n   63         }\n   64         KeyCode::Char('t') => {\n   65             if !app.action_form.toggle_boolean() {\n   66                 app.show_status(StatusLevel::Warning, \"Selected field is not a toggle\");\n   67             }\n   68         }\n   69         KeyCode::Backspace => {\n   70             if !app.action_form.backspace() {\n   71                 app.show_status(StatusLevel::Warning, \"Selected field is not numeric\");\n   72             }\n   73         }\n   74         KeyCode::Enter => match app.action_form.submit() {\n   75             Ok(action) => app.apply_action(action),\n   76             Err(error) => app.show_status(StatusLevel::Error, error),\n   77         },\n   78         KeyCode::Char(ch) if ch.is_ascii_digit() || ch == '.' => {\n   79             if !app.action_form.edit_char(ch) {\n   80                 let target = app.action_form.selected_action();\n   81                 let message = if matches!(\n   82                     target,\n   83                     ActionKind::WaterChangePercent | ActionKind::ChangeAeration\n   84                 ) {\n   85                     \"Use [ ] or t for non-numeric fields\"\n   86                 } else {\n   87                     \"Selected field only accepts numeric input\"\n   88                 };\n   89                 app.show_status(StatusLevel::Warning, message);\n   90             }\n   91         }\n   92         _ => {}\n   93     }\n   94 }\nFILE crates/tank_tui/src/main.rs\n    1 use std::{\n    2     io::{self, Stdout},\n    3     path::PathBuf,\n    4     time::{Duration, SystemTime, UNIX_EPOCH},\n    5 };\n    6 \n    7 use anyhow::Context;\n    8 use crossterm::{\n    9     event::{self, Event, KeyCode, KeyEventKind},\n   10     execute,\n   11     terminal::{disable_raw_mode, enable_raw_mode, EnterAlternateScreen, LeaveAlternateScreen},\n   12 };\n   13 use ratatui::{\n   14     backend::CrosstermBackend,\n   15     prelude::*,\n   16     widgets::{Block, Borders, List, ListItem, Paragraph},\n   17     Terminal,\n   18 };\n   19 use tank_core::{Engine, SimSeed, TankGeometry};\n   20 use tank_scenarios::{\n   21     load_named_scenario, seeded_state_with_full_overrides, startup_defaults_for_scenario,\n   22     startup_source_water_ids, StartupHeaterPreset, StartupLightPreset, StartupOverrides,\n   23     StartupPlantSelection, StartupSubstratePreset,\n   24 };\n   25 use tank_tui::{\n   26     input::{handle_key_event, InputOutcome},\n   27     TuiApp, AUTO_ADVANCE_INTERVAL, FILL_PRESETS, TANK_SIZE_PRESETS,\n   28 };\n   29 \n   30 const STARTUP_SHRIMP_COUNTS: [u32; 5] = [0, 5, 10, 15, 20];\n   31 \n   32 fn main() -> anyhow::Result<()> {\n   33     enable_raw_mode().context(\"failed to enable raw mode\")?;\n   34     let mut stdout = io::stdout();\n   35     execute!(stdout, EnterAlternateScreen).context(\"failed to enter alternate screen\")?;\n   36     let backend = CrosstermBackend::new(stdout);\n   37     let mut terminal = Terminal::new(backend).context(\"failed to initialize terminal\")?;\n   38 \n   39     let result = run(&mut terminal);\n   40     restore_terminal(&mut terminal)?;\n   41     result\n   42 }\n   43 \n   44 fn run(terminal: &mut Terminal<CrosstermBackend<Stdout>>) -> anyhow::Result<()> {\n   45     let Some(selection) = select_startup_config(terminal)? else {\n   46         return Ok(());\n   47     };\n   48 \n   49     let scenario =\n   50         load_named_scenario(selection.scenario_id()).context(\"failed to load scenario\")?;\n   51     let seed = SimSeed(seed_from_clock());\n   52     let state = seeded_state_with_full_overrides(\n   53         seed,\n   54         selection.scenario_id(),\n   55         selection.startup_overrides(),\n   56     )\n   57     .context(\"failed to materialize selected scenario\")?;\n   58     let scenario_label = format!(\n   59         \"{} · {} · fill {} · {} shrimp\",\n   60         scenario.name,\n   61         selection.size_preset().label,\n   62         selection.fill_preset().label,\n   63         selection.initial_shrimp_count\n   64     );\n   65     let save_file_path = default_save_path(selection.scenario_id());\n   66     let engine = Engine::from_parts(state, vec![]);\n   67     let mut app = TuiApp::new(engine, save_file_path, scenario_label);\n   68 \n   69     loop {\n   70         app.clear_expired_status();\n   71         terminal\n   72             .draw(|frame| app.render(frame))\n   73             .context(\"failed to render TUI frame\")?;\n   74 \n   75         if event::poll(AUTO_ADVANCE_INTERVAL).context(\"failed to poll for events\")? {\n   76             if let Event::Key(key) = event::read().context(\"failed to read terminal event\")? {\n   77                 if key.kind == KeyEventKind::Press\n   78                     && handle_key_event(&mut app, key) == InputOutcome::Quit\n   79                 {\n   80                     break;\n   81                 }\n   82             }\n   83         } else if app.auto_advance {\n   84             app.step_hours(1);\n   85         }\n   86     }\n   87 \n   88     Ok(())\n   89 }\n   90 \n   91 fn restore_terminal(terminal: &mut Terminal<CrosstermBackend<Stdout>>) -> anyhow::Result<()> {\n   92     disable_raw_mode().context(\"failed to disable raw mode\")?;\n   93     execute!(terminal.backend_mut(), LeaveAlternateScreen)\n   94         .context(\"failed to leave alternate screen\")?;\n   95     terminal.show_cursor().context(\"failed to show cursor\")?;\n   96     Ok(())\n   97 }\n   98 \n   99 fn default_save_path(scenario_id: &str) -> PathBuf {\n  100     std::env::current_dir()\n  101         .unwrap_or_else(|_| PathBuf::from(\".\"))\n  102         .join(format!(\"{scenario_id}-save.json\"))\n  103 }\n  104 \n  105 fn seed_from_clock() -> u64 {\n  106     SystemTime::now()\n  107         .duration_since(UNIX_EPOCH)\n  108         .unwrap_or(Duration::from_secs(0))\n  109         .as_secs()\n  110 }\n  111 \n  112 #[derive(Debug, Clone, Copy, PartialEq, Eq)]\n  113 enum SelectionField {\n  114     Scenario,\n  115     Size,\n  116     Fill,\n  117     SourceWater,\n  118     Substrate,\n  119     Plants,\n  120     Filter,\n  121     Light,\n  122     Heater,\n  123     Aeration,\n  124     ShrimpCount,\n  125     Launch,\n  126 }\n  127 \n  128 impl SelectionField {\n  129     const ALL: [Self; 12] = [\n  130         Self::Scenario,\n  131         Self::Size,\n  132         Self::Fill,\n  133         Self::SourceWater,\n  134         Self::Substrate,\n  135         Self::Plants,\n  136         Self::Filter,\n  137         Self::Light,\n  138         Self::Heater,\n  139         Self::Aeration,\n  140         Self::ShrimpCount,\n  141         Self::Launch,\n  142     ];\n  143 \n  144     fn next(self) -> Self {\n  145         let index = Self::ALL\n  146             .iter()\n  147             .position(|field| *field == self)\n  148             .unwrap_or(0);\n  149         Self::ALL[(index + 1) % Self::ALL.len()]\n  150     }\n  151 \n  152     fn previous(self) -> Self {\n  153         let index = Self::ALL\n  154             .iter()\n  155             .position(|field| *field == self)\n  156             .unwrap_or(0);\n  157         Self::ALL[(index + Self::ALL.len() - 1) % Self::ALL.len()]\n  158     }\n  159 }\n  160 \n  161 #[derive(Debug, Clone, PartialEq)]\n  162 struct StartupSelection {\n  163     scenario_index: usize,\n  164     size_index: usize,\n  165     fill_index: usize,\n  166     source_water_id: String,\n  167     substrate_preset: StartupSubstratePreset,\n  168     plant_selection: StartupPlantSelection,\n  169     filter_enabled: bool,\n  170     light_preset: StartupLightPreset,\n  171     heater_preset: StartupHeaterPreset,\n  172     aeration_enabled: bool,\n  173     initial_shrimp_count: u32,\n  174     field: SelectionField,\n  175 }\n  176 \n  177 impl Default for StartupSelection {\n  178     fn default() -> Self {\n  179         let mut selection = Self {\n  180             scenario_index: 0,\n  181             size_index: 1,\n  182             fill_index: 1,\n  183             source_water_id: String::new(),\n  184             substrate_preset: StartupSubstratePreset::InertSand,\n  185             plant_selection: StartupPlantSelection::FastStemOnly,\n  186             filter_enabled: true,\n  187             light_preset: StartupLightPreset::Hours8,\n  188             heater_preset: StartupHeaterPreset::Off,\n  189             aeration_enabled: false,\n  190             initial_shrimp_count: 0,\n  191             field: SelectionField::Scenario,\n  192         };\n  193         selection\n  194             .reset_template_fields()\n  195             .expect(\"default startup scenario should load\");\n  196         selection\n  197     }\n  198 }\n  199 \n  200 fn cycle_choice<T: Copy + PartialEq>(current: &mut T, options: &[T], forward: bool) {\n  201     let index = options\n  202         .iter()\n  203         .position(|option| *option == *current)\n  204         .unwrap_or(0);\n  205     let next_index = if forward {\n  206         (index + 1) % options.len()\n  207     } else {\n  208         (index + options.len() - 1) % options.len()\n  209     };\n  210     *current = options[next_index];\n  211 }\n  212 \n  213 fn on_off(enabled: bool) -> &'static str {\n  214     if enabled {\n  215         \"On\"\n  216     } else {\n  217         \"Off\"\n  218     }\n  219 }\n  220 \n  221 fn source_water_label(id: &str) -> String {\n  222     id.replace('_', \" \")\n  223 }\n  224 \n  225 impl StartupSelection {\n  226     fn reset_template_fields(&mut self) -> anyhow::Result<()> {\n  227         let defaults = startup_defaults_for_scenario(self.scenario_id()).with_context(|| {\n  228             format!(\"failed to load startup defaults for {}\", self.scenario_id())\n  229         })?;\n  230 \n  231         self.source_water_id = defaults\n  232             .source_water_profile_id\n  233             .unwrap_or_else(|| \"moderate\".to_string());\n  234         self.substrate_preset = defaults\n  235             .substrate_preset\n  236             .unwrap_or(StartupSubstratePreset::InertSand);\n  237         self.plant_selection = defaults\n  238             .plant_selection\n  239             .unwrap_or(StartupPlantSelection::FastStemOnly);\n  240         self.filter_enabled = defaults.filter_enabled.unwrap_or(true);\n  241         self.light_preset = defaults.light_preset.unwrap_or(StartupLightPreset::Hours8);\n  242         self.heater_preset = defaults.heater_preset.unwrap_or(StartupHeaterPreset::Off);\n  243         self.aeration_enabled = defaults.aeration_enabled.unwrap_or(false);\n  244         self.initial_shrimp_count = defaults.initial_adult_shrimp_count.unwrap_or(0);\n  245         Ok(())\n  246     }\n  247 \n  248     fn set_scenario_index(&mut self, scenario_index: usize) -> anyhow::Result<()> {\n  249         self.scenario_index = scenario_index;\n  250         self.reset_template_fields()\n  251     }\n  252 \n  253     fn startup_overrides(&self) -> StartupOverrides {\n  254         StartupOverrides {\n  255             geometry: tank_scenarios::ScenarioGeometryOverrides {\n  256                 size_scale: self.size_preset().size_scale,\n  257                 fill_ratio: self.fill_preset().fill_ratio,\n  258             },\n  259             source_water_profile_id: Some(self.source_water_id.clone()),\n  260             substrate_preset: Some(self.substrate_preset),\n  261             plant_selection: Some(self.plant_selection),\n  262             filter_enabled: Some(self.filter_enabled),\n  263             light_preset: Some(self.light_preset),\n  264             heater_preset: Some(self.heater_preset),\n  265             aeration_enabled: Some(self.aeration_enabled),\n  266             initial_adult_shrimp_count: Some(self.initial_shrimp_count),\n  267         }\n  268     }\n  269 \n  270     fn effective_geometry(\n  271         &self,\n  272         tank_length_cm: f64,\n  273         tank_width_cm: f64,\n  274         tank_height_cm: f64,\n  275         fill_height_cm: f64,\n  276     ) -> TankGeometry {\n  277         let size_scale = self.size_preset().size_scale;\n  278         let length_cm = tank_length_cm * size_scale;\n  279         let width_cm = tank_width_cm * size_scale;\n  280         let height_cm = tank_height_cm * size_scale;\n  281         let fill_height_cm =\n  282             (fill_height_cm * size_scale * self.fill_preset().fill_ratio).min(height_cm);\n  283         TankGeometry {\n  284             length_cm,\n  285             width_cm,\n  286             height_cm,\n  287             fill_height_cm,\n  288             glass_thickness_mm: 5.0,\n  289             open_top: true,\n  290             lid_exchange_factor: 0.25,\n  291         }\n  292     }\n  293 \n  294     fn scenario_id(&self) -> &'static str {\n  295         tank_scenarios::default_scenario_ids()[self.scenario_index]\n  296     }\n  297 \n  298     fn size_preset(&self) -> tank_tui::TankSizePreset {\n  299         TANK_SIZE_PRESETS[self.size_index]\n  300     }\n  301 \n  302     fn fill_preset(&self) -> tank_tui::FillPreset {\n  303         FILL_PRESETS[self.fill_index]\n  304     }\n  305 \n  306     fn next_field(&mut self) {\n  307         self.field = self.field.next();\n  308     }\n  309 \n  310     fn previous_field(&mut self) {\n  311         self.field = self.field.previous();\n  312     }\n  313 \n  314     fn adjust_left(&mut self) -> anyhow::Result<()> {\n  315         match self.field {\n  316             SelectionField::Scenario => {\n  317                 let options = tank_scenarios::default_scenario_ids();\n  318                 let next_index = (self.scenario_index + options.len() - 1) % options.len();\n  319                 self.set_scenario_index(next_index)?;\n  320             }\n  321             SelectionField::Size => {\n  322                 self.size_index =\n  323                     (self.size_index + TANK_SIZE_PRESETS.len() - 1) % TANK_SIZE_PRESETS.len();\n  324             }\n  325             SelectionField::Fill => {\n  326                 self.fill_index = (self.fill_index + FILL_PRESETS.len() - 1) % FILL_PRESETS.len();\n  327             }\n  328             SelectionField::SourceWater => {\n  329                 let options = startup_source_water_ids();\n  330                 let current_index = options\n  331                     .iter()\n  332                     .position(|id| *id == self.source_water_id)\n  333                     .unwrap_or(0);\n  334                 let next_index = (current_index + options.len() - 1) % options.len();\n  335                 self.source_water_id = options[next_index].to_string();\n  336             }\n  337             SelectionField::Substrate => {\n  338                 cycle_choice(\n  339                     &mut self.substrate_preset,\n  340                     &StartupSubstratePreset::ALL,\n  341                     false,\n  342                 );\n  343             }\n  344             SelectionField::Plants => {\n  345                 cycle_choice(\n  346                     &mut self.plant_selection,\n  347                     &StartupPlantSelection::ALL,\n  348                     false,\n  349                 );\n  350             }\n  351             SelectionField::Filter => self.filter_enabled = !self.filter_enabled,\n  352             SelectionField::Light => {\n  353                 cycle_choice(&mut self.light_preset, &StartupLightPreset::ALL, false);\n  354             }\n  355             SelectionField::Heater => {\n  356                 cycle_choice(&mut self.heater_preset, &StartupHeaterPreset::ALL, false);\n  357             }\n  358             SelectionField::Aeration => self.aeration_enabled = !self.aeration_enabled,\n  359             SelectionField::ShrimpCount => {\n  360                 cycle_choice(\n  361                     &mut self.initial_shrimp_count,\n  362                     &STARTUP_SHRIMP_COUNTS,\n  363                     false,\n  364                 );\n  365             }\n  366             SelectionField::Launch => {}\n  367         }\n  368         Ok(())\n  369     }\n  370 \n  371     fn adjust_right(&mut self) -> anyhow::Result<()> {\n  372         match self.field {\n  373             SelectionField::Scenario => {\n  374                 let next_index =\n  375                     (self.scenario_index + 1) % tank_scenarios::default_scenario_ids().len();\n  376                 self.set_scenario_index(next_index)?;\n  377             }\n  378             SelectionField::Size => {\n  379                 self.size_index = (self.size_index + 1) % TANK_SIZE_PRESETS.len();\n  380             }\n  381             SelectionField::Fill => {\n  382                 self.fill_index = (self.fill_index + 1) % FILL_PRESETS.len();\n  383             }\n  384             SelectionField::SourceWater => {\n  385                 let options = startup_source_water_ids();\n  386                 let current_index = options\n  387                     .iter()\n  388                     .position(|id| *id == self.source_water_id)\n  389                     .unwrap_or(0);\n  390                 let next_index = (current_index + 1) % options.len();\n  391                 self.source_water_id = options[next_index].to_string();\n  392             }\n  393             SelectionField::Substrate => {\n  394                 cycle_choice(\n  395                     &mut self.substrate_preset,\n  396                     &StartupSubstratePreset::ALL,\n  397                     true,\n  398                 );\n  399             }\n  400             SelectionField::Plants => {\n  401                 cycle_choice(&mut self.plant_selection, &StartupPlantSelection::ALL, true);\n  402             }\n  403             SelectionField::Filter => self.filter_enabled = !self.filter_enabled,\n  404             SelectionField::Light => {\n  405                 cycle_choice(&mut self.light_preset, &StartupLightPreset::ALL, true);\n  406             }\n  407             SelectionField::Heater => {\n  408                 cycle_choice(&mut self.heater_preset, &StartupHeaterPreset::ALL, true);\n  409             }\n  410             SelectionField::Aeration => self.aeration_enabled = !self.aeration_enabled,\n  411             SelectionField::ShrimpCount => {\n  412                 cycle_choice(&mut self.initial_shrimp_count, &STARTUP_SHRIMP_COUNTS, true);\n  413             }\n  414             SelectionField::Launch => {}\n  415         }\n  416         Ok(())\n  417     }\n  418 }\n  419 \n  420 fn select_startup_config(\n  421     terminal: &mut Terminal<CrosstermBackend<Stdout>>,\n  422 ) -> anyhow::Result<Option<StartupSelection>> {\n  423     let mut selection = StartupSelection::default();\n  424 \n  425     loop {\n  426         terminal.draw(|frame| render_startup(frame, &selection))?;\n  427 \n  428         if let Event::Key(key) = event::read().context(\"failed to read selection input\")? {\n  429             if key.kind != KeyEventKind::Press {\n  430                 continue;\n  431             }\n  432 \n  433             match key.code {\n  434                 KeyCode::Char('q') => return Ok(None),\n  435                 KeyCode::Up => selection.previous_field(),\n  436                 KeyCode::Down => selection.next_field(),\n  437                 KeyCode::Left => selection.adjust_left()?,\n  438                 KeyCode::Right => selection.adjust_right()?,\n  439                 KeyCode::Enter if selection.field == SelectionField::Launch => {\n  440                     return Ok(Some(selection));\n  441                 }\n  442                 KeyCode::Enter => selection.next_field(),\n  443                 _ => {}\n  444             }\n  445         }\n  446     }\n  447 }\n  448 \n  449 fn render_startup(frame: &mut Frame<'_>, selection: &StartupSelection) {\n  450     let area = centered_rect(frame.size(), 92, 88);\n  451     let layout = Layout::vertical([\n  452         Constraint::Length(4),\n  453         Constraint::Min(16),\n  454         Constraint::Length(3),\n  455     ])\n  456     .split(area);\n  457     let body = Layout::horizontal([Constraint::Percentage(45), Constraint::Percentage(55)])\n  458         .split(layout[1]);\n  459 \n  460     let header = Paragraph::new(vec![\n  461         Line::from(Span::styled(\n  462             \"Tank Sim terminal UI\",\n  463             Style::default()\n  464                 .fg(Color::Cyan)\n  465                 .add_modifier(Modifier::BOLD),\n  466         )),\n  467         Line::from(\n  468             \"Choose a scenario template, then override water, planting, hardware, and starting stock.\",\n  469         ),\n  470     ])\n  471     .block(Block::default().title(\"Startup\").borders(Borders::ALL));\n  472     frame.render_widget(header, layout[0]);\n  473 \n  474     let scenario = load_named_scenario(selection.scenario_id()).ok();\n  475     let fields = vec![\n  476         startup_item(\n  477             selection.field == SelectionField::Scenario,\n  478             \"Scenario\",\n  479             scenario\n  480                 .as_ref()\n  481                 .map(|item| format!(\"{} ({})\", item.name, item.id))\n  482                 .unwrap_or_else(|| selection.scenario_id().to_string()),\n  483         ),\n  484         startup_item(\n  485             selection.field == SelectionField::Size,\n  486             \"Tank size\",\n  487             selection.size_preset().label.to_string(),\n  488         ),\n  489         startup_item(\n  490             selection.field == SelectionField::Fill,\n  491             \"Fill height\",\n  492             selection.fill_preset().label.to_string(),\n  493         ),\n  494         startup_item(\n  495             selection.field == SelectionField::SourceWater,\n  496             \"Source water\",\n  497             selection.source_water_id.clone(),\n  498         ),\n  499         startup_item(\n  500             selection.field == SelectionField::Substrate,\n  501             \"Substrate\",\n  502             selection.substrate_preset.label().to_string(),\n  503         ),\n  504         startup_item(\n  505             selection.field == SelectionField::Plants,\n  506             \"Plants\",\n  507             selection.plant_selection.label().to_string(),\n  508         ),\n  509         startup_item(\n  510             selection.field == SelectionField::Filter,\n  511             \"Filter\",\n  512             on_off(selection.filter_enabled).to_string(),\n  513         ),\n  514         startup_item(\n  515             selection.field == SelectionField::Light,\n  516             \"Light\",\n  517             selection.light_preset.label().to_string(),\n  518         ),\n  519         startup_item(\n  520             selection.field == SelectionField::Heater,\n  521             \"Heater\",\n  522             selection.heater_preset.label().to_string(),\n  523         ),\n  524         startup_item(\n  525             selection.field == SelectionField::Aeration,\n  526             \"Aeration\",\n  527             on_off(selection.aeration_enabled).to_string(),\n  528         ),\n  529         startup_item(\n  530             selection.field == SelectionField::ShrimpCount,\n  531             \"Initial shrimp\",\n  532             selection.initial_shrimp_count.to_string(),\n  533         ),\n  534         startup_item(\n  535             selection.field == SelectionField::Launch,\n  536             \"Launch\",\n  537             \"Press Enter to start\".to_string(),\n  538         ),\n  539     ];\n  540     let options = List::new(fields).block(\n  541         Block::default()\n  542             .title(\"Configuration\")\n  543             .borders(Borders::ALL),\n  544     );\n  545     frame.render_widget(options, body[0]);\n  546 \n  547     let summary = scenario\n  548         .map(|item| {\n  549             let geometry = selection.effective_geometry(\n  550                 item.tank_length_cm,\n  551                 item.tank_width_cm,\n  552                 item.tank_height_cm,\n  553                 item.fill_height_cm,\n  554             );\n  555             vec![\n  556                 Line::from(format!(\"Scenario template {} ({})\", item.name, item.id)),\n  557                 Line::from(format!(\"Ambient {:.1} C\", item.ambient_temp_c)),\n  558                 Line::from(format!(\n  559                     \"Geometry {:.1} x {:.1} x {:.1} cm · fill {:.1} cm\",\n  560                     geometry.length_cm,\n  561                     geometry.width_cm,\n  562                     geometry.height_cm,\n  563                     geometry.fill_height_cm\n  564                 )),\n  565                 Line::from(format!(\"Water volume {:.1} L\", geometry.water_volume_l())),\n  566                 Line::from(format!(\n  567                     \"Source water {} ({})\",\n  568                     source_water_label(&selection.source_water_id),\n  569                     selection.source_water_id\n  570                 )),\n  571                 Line::from(format!(\"Substrate {}\", selection.substrate_preset.label())),\n  572                 Line::from(format!(\"Plants {}\", selection.plant_selection.label())),\n  573                 Line::from(format!(\"Filter {}\", on_off(selection.filter_enabled))),\n  574                 Line::from(format!(\n  575                     \"Light photoperiod {}\",\n  576                     selection.light_preset.label()\n  577                 )),\n  578                 Line::from(format!(\"Heater {}\", selection.heater_preset.label())),\n  579                 Line::from(format!(\"Aeration {}\", on_off(selection.aeration_enabled))),\n  580                 Line::from(format!(\n  581                     \"Initial shrimp {} adults\",\n  582                     selection.initial_shrimp_count\n  583                 )),\n  584                 Line::from(\"Changing Scenario resets all override fields to that template.\"),\n  585             ]\n  586         })\n  587         .unwrap_or_else(|| vec![Line::from(\"Scenario details unavailable\")]);\n  588     let summary_widget = Paragraph::new(summary)\n  589         .block(\n  590             Block::default()\n  591                 .title(\"Launch summary\")\n  592                 .borders(Borders::ALL),\n  593         )\n  594         .wrap(ratatui::widgets::Wrap { trim: true });\n  595     frame.render_widget(summary_widget, body[1]);\n  596 \n  597     let help = Paragraph::new(\n  598         \"Up/Down move between fields, Left/Right change values, Enter advances, q quits.\",\n  599     )\n  600     .block(Block::default().borders(Borders::ALL));\n  601     frame.render_widget(help, layout[2]);\n  602 }\n  603 \n  604 fn startup_item(selected: bool, label: &str, value: String) -> ListItem<'static> {\n  605     let style = if selected {\n  606         Style::default()\n  607             .fg(Color::Yellow)\n  608             .add_modifier(Modifier::BOLD)\n  609     } else {\n  610         Style::default()\n  611     };\n  612     ListItem::new(Line::from(vec![\n  613         Span::styled(format!(\"{label}: \"), style),\n  614         Span::raw(value),\n  615     ]))\n  616 }\n  617 \n  618 fn centered_rect(area: Rect, width_percent: u16, height_percent: u16) -> Rect {\n  619     let vertical = Layout::vertical([\n  620         Constraint::Percentage((100 - height_percent) / 2),\n  621         Constraint::Percentage(height_percent),\n  622         Constraint::Percentage((100 - height_percent) / 2),\n  623     ])\n  624     .split(area);\n  625     let horizontal = Layout::horizontal([\n  626         Constraint::Percentage((100 - width_percent) / 2),\n  627         Constraint::Percentage(width_percent),\n  628         Constraint::Percentage((100 - width_percent) / 2),\n  629     ])\n  630     .split(vertical[1]);\n  631     horizontal[1]\n  632 }\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"awk 'FNR==1{print \\\"FILE \\\" FILENAME} {printf \\\"%5d %s\\\\n\\\", FNR, \"'$0}'\"' crates/tank_data/src/lib.rs crates/tank_scenarios/src/lib.rs\"","aggregated_output":"FILE crates/tank_data/src/lib.rs\n    1 mod presets;\n    2 \n    3 use serde::de::DeserializeOwned;\n    4 use thiserror::Error;\n    5 \n    6 pub use presets::{\n    7     PlantPreset, ProcessParamsPreset, Provenance, ScenarioPreset, ShrimpPreset, SourceWaterPreset,\n    8     SubstratePreset,\n    9 };\n   10 \n   11 #[derive(Debug, Error)]\n   12 pub enum PresetError {\n   13     #[error(\"unknown preset `{id}` in category `{category}`\")]\n   14     UnknownPreset { category: &'static str, id: String },\n   15     #[error(\"failed to parse preset `{id}` in category `{category}`: {message}\")]\n   16     Parse {\n   17         category: &'static str,\n   18         id: String,\n   19         message: String,\n   20     },\n   21     #[error(\"validation failed for preset `{id}` in category `{category}`: {message}\")]\n   22     Validation {\n   23         category: &'static str,\n   24         id: String,\n   25         message: String,\n   26     },\n   27 }\n   28 \n   29 pub fn load_source_water(id: &str) -> Result<SourceWaterPreset, PresetError> {\n   30     let preset: SourceWaterPreset = load_from_registry(\"source_water\", id, SOURCE_WATER_PRESETS)?;\n   31     preset\n   32         .validate()\n   33         .map_err(|message| PresetError::Validation {\n   34             category: \"source_water\",\n   35             id: id.to_string(),\n   36             message,\n   37         })?;\n   38     Ok(preset)\n   39 }\n   40 \n   41 pub fn load_substrate(id: &str) -> Result<SubstratePreset, PresetError> {\n   42     load_from_registry(\"substrate\", id, SUBSTRATE_PRESETS)\n   43 }\n   44 \n   45 pub fn load_plant(id: &str) -> Result<PlantPreset, PresetError> {\n   46     load_from_registry(\"plants\", id, PLANT_PRESETS)\n   47 }\n   48 \n   49 pub fn load_shrimp(id: &str) -> Result<ShrimpPreset, PresetError> {\n   50     let preset: ShrimpPreset = load_from_registry(\"shrimp\", id, SHRIMP_PRESETS)?;\n   51     preset\n   52         .validate()\n   53         .map_err(|message| PresetError::Validation {\n   54             category: \"shrimp\",\n   55             id: id.to_string(),\n   56             message,\n   57         })?;\n   58     Ok(preset)\n   59 }\n   60 \n   61 pub fn load_process_params(id: &str) -> Result<ProcessParamsPreset, PresetError> {\n   62     let preset: ProcessParamsPreset = load_from_registry(\"process\", id, PROCESS_PRESETS)?;\n   63     preset\n   64         .validate()\n   65         .map_err(|message| PresetError::Validation {\n   66             category: \"process\",\n   67             id: id.to_string(),\n   68             message,\n   69         })?;\n   70     Ok(preset)\n   71 }\n   72 \n   73 pub fn load_scenario(id: &str) -> Result<ScenarioPreset, PresetError> {\n   74     load_from_registry(\"scenarios\", id, SCENARIO_PRESETS)\n   75 }\n   76 \n   77 pub fn source_water_ids() -> &'static [&'static str] {\n   78     &[\"soft_acidic\", \"moderate\", \"hard_shrimp\", \"ro_like\"]\n   79 }\n   80 \n   81 pub fn substrate_ids() -> &'static [&'static str] {\n   82     &[\n   83         \"inert_sand\",\n   84         \"inert_gravel\",\n   85         \"active_planted\",\n   86         \"coarse_porous\",\n   87     ]\n   88 }\n   89 \n   90 pub fn plant_ids() -> &'static [&'static str] {\n   91     &[\"fast_stem\", \"root_rosette\"]\n   92 }\n   93 \n   94 pub fn shrimp_ids() -> &'static [&'static str] {\n   95     &[\"neocaridina_davidi\"]\n   96 }\n   97 \n   98 pub fn process_ids() -> &'static [&'static str] {\n   99     &[\"default\"]\n  100 }\n  101 \n  102 pub fn scenario_ids() -> &'static [&'static str] {\n  103     &[\"nano_cycle\", \"medium_planted\", \"warm_room\"]\n  104 }\n  105 \n  106 fn load_from_registry<T>(\n  107     category: &'static str,\n  108     id: &str,\n  109     registry: &[(&str, &str)],\n  110 ) -> Result<T, PresetError>\n  111 where\n  112     T: DeserializeOwned,\n  113 {\n  114     let Some((_, raw)) = registry.iter().find(|(entry_id, _)| *entry_id == id) else {\n  115         return Err(PresetError::UnknownPreset {\n  116             category,\n  117             id: id.to_string(),\n  118         });\n  119     };\n  120 \n  121     toml::from_str(raw).map_err(|error| PresetError::Parse {\n  122         category,\n  123         id: id.to_string(),\n  124         message: error.to_string(),\n  125     })\n  126 }\n  127 \n  128 const SOURCE_WATER_PRESETS: &[(&str, &str)] = &[\n  129     (\n  130         \"soft_acidic\",\n  131         include_str!(\"../data/source_water/soft_acidic.toml\"),\n  132     ),\n  133     (\n  134         \"moderate\",\n  135         include_str!(\"../data/source_water/moderate.toml\"),\n  136     ),\n  137     (\n  138         \"hard_shrimp\",\n  139         include_str!(\"../data/source_water/hard_shrimp.toml\"),\n  140     ),\n  141     (\"ro_like\", include_str!(\"../data/source_water/ro_like.toml\")),\n  142 ];\n  143 \n  144 const SUBSTRATE_PRESETS: &[(&str, &str)] = &[\n  145     (\n  146         \"inert_sand\",\n  147         include_str!(\"../data/substrate/inert_sand.toml\"),\n  148     ),\n  149     (\n  150         \"inert_gravel\",\n  151         include_str!(\"../data/substrate/inert_gravel.toml\"),\n  152     ),\n  153     (\n  154         \"active_planted\",\n  155         include_str!(\"../data/substrate/active_planted.toml\"),\n  156     ),\n  157     (\n  158         \"coarse_porous\",\n  159         include_str!(\"../data/substrate/coarse_porous.toml\"),\n  160     ),\n  161 ];\n  162 \n  163 const PLANT_PRESETS: &[(&str, &str)] = &[\n  164     (\"fast_stem\", include_str!(\"../data/plants/fast_stem.toml\")),\n  165     (\n  166         \"root_rosette\",\n  167         include_str!(\"../data/plants/root_rosette.toml\"),\n  168     ),\n  169 ];\n  170 \n  171 const SHRIMP_PRESETS: &[(&str, &str)] = &[(\n  172     \"neocaridina_davidi\",\n  173     include_str!(\"../data/shrimp/neocaridina_davidi.toml\"),\n  174 )];\n  175 \n  176 const PROCESS_PRESETS: &[(&str, &str)] =\n  177     &[(\"default\", include_str!(\"../data/process/default.toml\"))];\n  178 \n  179 const SCENARIO_PRESETS: &[(&str, &str)] = &[\n  180     (\n  181         \"nano_cycle\",\n  182         include_str!(\"../data/scenarios/nano_cycle.toml\"),\n  183     ),\n  184     (\n  185         \"medium_planted\",\n  186         include_str!(\"../data/scenarios/medium_planted.toml\"),\n  187     ),\n  188     (\n  189         \"warm_room\",\n  190         include_str!(\"../data/scenarios/warm_room.toml\"),\n  191     ),\n  192 ];\nFILE crates/tank_scenarios/src/lib.rs\n    1 use std::collections::BTreeMap;\n    2 \n    3 use tank_core::{\n    4     AnimalState, FilterState, MicrobeState, PlantGuild, PlantGuildState, ProcessParams,\n    5     ShrimpRuntimeParams, SimMeta, SimSeed, SourceWaterProfile, SubstrateLayerState, TankGeometry,\n    6     TankState, WaterState,\n    7 };\n    8 use tank_data::{load_scenario, ScenarioPreset};\n    9 \n   10 #[derive(Debug, Clone, Copy, PartialEq)]\n   11 pub struct ScenarioGeometryOverrides {\n   12     pub size_scale: f64,\n   13     pub fill_ratio: f64,\n   14 }\n   15 \n   16 impl Default for ScenarioGeometryOverrides {\n   17     fn default() -> Self {\n   18         Self {\n   19             size_scale: 1.0,\n   20             fill_ratio: 1.0,\n   21         }\n   22     }\n   23 }\n   24 \n   25 #[derive(Debug, Clone, Copy, PartialEq, Eq)]\n   26 pub enum StartupSubstratePreset {\n   27     InertSand,\n   28     InertGravel,\n   29     ActivePlanted,\n   30     ActivePlantedWithCoarsePorous,\n   31 }\n   32 \n   33 impl StartupSubstratePreset {\n   34     pub const ALL: [Self; 4] = [\n   35         Self::InertSand,\n   36         Self::InertGravel,\n   37         Self::ActivePlanted,\n   38         Self::ActivePlantedWithCoarsePorous,\n   39     ];\n   40 \n   41     pub fn label(self) -> &'static str {\n   42         match self {\n   43             Self::InertSand => \"inert_sand\",\n   44             Self::InertGravel => \"inert_gravel\",\n   45             Self::ActivePlanted => \"active_planted\",\n   46             Self::ActivePlantedWithCoarsePorous => \"active_planted + coarse_porous\",\n   47         }\n   48     }\n   49 \n   50     fn preset_ids(self) -> &'static [&'static str] {\n   51         match self {\n   52             Self::InertSand => &[\"inert_sand\"],\n   53             Self::InertGravel => &[\"inert_gravel\"],\n   54             Self::ActivePlanted => &[\"active_planted\"],\n   55             Self::ActivePlantedWithCoarsePorous => &[\"active_planted\", \"coarse_porous\"],\n   56         }\n   57     }\n   58 \n   59     fn from_ids(ids: &[String]) -> Option<Self> {\n   60         let ids = ids.iter().map(String::as_str).collect::<Vec<_>>();\n   61         match ids.as_slice() {\n   62             [\"inert_sand\"] => Some(Self::InertSand),\n   63             [\"inert_gravel\"] => Some(Self::InertGravel),\n   64             [\"active_planted\"] => Some(Self::ActivePlanted),\n   65             [\"active_planted\", \"coarse_porous\"] => Some(Self::ActivePlantedWithCoarsePorous),\n   66             _ => None,\n   67         }\n   68     }\n   69 }\n   70 \n   71 #[derive(Debug, Clone, Copy, PartialEq, Eq)]\n   72 pub enum StartupPlantSelection {\n   73     FastStemOnly,\n   74     RootFeedingRosetteOnly,\n   75     BothGuilds,\n   76     None,\n   77 }\n   78 \n   79 impl StartupPlantSelection {\n   80     pub const ALL: [Self; 4] = [\n   81         Self::FastStemOnly,\n   82         Self::RootFeedingRosetteOnly,\n   83         Self::BothGuilds,\n   84         Self::None,\n   85     ];\n   86 \n   87     pub fn label(self) -> &'static str {\n   88         match self {\n   89             Self::FastStemOnly => \"FastStem only\",\n   90             Self::RootFeedingRosetteOnly => \"RootFeedingRosette only\",\n   91             Self::BothGuilds => \"Both guilds\",\n   92             Self::None => \"None\",\n   93         }\n   94     }\n   95 \n   96     fn preset_ids(self) -> &'static [&'static str] {\n   97         match self {\n   98             Self::FastStemOnly => &[\"fast_stem\"],\n   99             Self::RootFeedingRosetteOnly => &[\"root_rosette\"],\n  100             Self::BothGuilds => &[\"fast_stem\", \"root_rosette\"],\n  101             Self::None => &[],\n  102         }\n  103     }\n  104 \n  105     fn from_ids(ids: &[String]) -> Option<Self> {\n  106         let mut normalized = ids.iter().map(String::as_str).collect::<Vec<_>>();\n  107         normalized.sort_unstable();\n  108         match normalized.as_slice() {\n  109             [] => Some(Self::None),\n  110             [\"fast_stem\"] => Some(Self::FastStemOnly),\n  111             [\"root_rosette\"] => Some(Self::RootFeedingRosetteOnly),\n  112             [\"fast_stem\", \"root_rosette\"] => Some(Self::BothGuilds),\n  113             _ => None,\n  114         }\n  115     }\n  116 }\n  117 \n  118 #[derive(Debug, Clone, Copy, PartialEq, Eq)]\n  119 pub enum StartupLightPreset {\n  120     Hours6,\n  121     Hours8,\n  122     Hours10,\n  123     Hours12,\n  124 }\n  125 \n  126 impl StartupLightPreset {\n  127     pub const ALL: [Self; 4] = [Self::Hours6, Self::Hours8, Self::Hours10, Self::Hours12];\n  128 \n  129     pub fn label(self) -> &'static str {\n  130         match self {\n  131             Self::Hours6 => \"6h\",\n  132             Self::Hours8 => \"8h\",\n  133             Self::Hours10 => \"10h\",\n  134             Self::Hours12 => \"12h\",\n  135         }\n  136     }\n  137 \n  138     pub fn hours(self) -> f64 {\n  139         match self {\n  140             Self::Hours6 => 6.0,\n  141             Self::Hours8 => 8.0,\n  142             Self::Hours10 => 10.0,\n  143             Self::Hours12 => 12.0,\n  144         }\n  145     }\n  146 }\n  147 \n  148 #[derive(Debug, Clone, Copy, PartialEq, Eq)]\n  149 pub enum StartupHeaterPreset {\n  150     Off,\n  151     Celsius24,\n  152     Celsius25,\n  153     Celsius26,\n  154 }\n  155 \n  156 impl StartupHeaterPreset {\n  157     pub const ALL: [Self; 4] = [Self::Off, Self::Celsius24, Self::Celsius25, Self::Celsius26];\n  158 \n  159     pub fn label(self) -> &'static str {\n  160         match self {\n  161             Self::Off => \"Off\",\n  162             Self::Celsius24 => \"24 C\",\n  163             Self::Celsius25 => \"25 C\",\n  164             Self::Celsius26 => \"26 C\",\n  165         }\n  166     }\n  167 \n  168     pub fn setpoint_c(self) -> Option<f64> {\n  169         match self {\n  170             Self::Off => None,\n  171             Self::Celsius24 => Some(24.0),\n  172             Self::Celsius25 => Some(25.0),\n  173             Self::Celsius26 => Some(26.0),\n  174         }\n  175     }\n  176 }\n  177 \n  178 #[derive(Debug, Clone, PartialEq)]\n  179 pub struct StartupOverrides {\n  180     pub geometry: ScenarioGeometryOverrides,\n  181     pub source_water_profile_id: Option<String>,\n  182     pub substrate_preset: Option<StartupSubstratePreset>,\n  183     pub plant_selection: Option<StartupPlantSelection>,\n  184     pub filter_enabled: Option<bool>,\n  185     pub light_preset: Option<StartupLightPreset>,\n  186     pub heater_preset: Option<StartupHeaterPreset>,\n  187     pub aeration_enabled: Option<bool>,\n  188     pub initial_adult_shrimp_count: Option<u32>,\n  189 }\n  190 \n  191 impl Default for StartupOverrides {\n  192     fn default() -> Self {\n  193         Self {\n  194             geometry: ScenarioGeometryOverrides::default(),\n  195             source_water_profile_id: None,\n  196             substrate_preset: None,\n  197             plant_selection: None,\n  198             filter_enabled: None,\n  199             light_preset: None,\n  200             heater_preset: None,\n  201             aeration_enabled: None,\n  202             initial_adult_shrimp_count: None,\n  203         }\n  204     }\n  205 }\n  206 \n  207 pub fn default_scenario_ids() -> &'static [&'static str] {\n  208     tank_data::scenario_ids()\n  209 }\n  210 \n  211 pub fn startup_source_water_ids() -> &'static [&'static str] {\n  212     tank_data::source_water_ids()\n  213 }\n  214 \n  215 pub fn load_named_scenario(id: &str) -> Result<ScenarioPreset, tank_data::PresetError> {\n  216     load_scenario(id)\n  217 }\n  218 \n  219 pub fn seeded_state_with_overrides(\n  220     seed: SimSeed,\n  221     scenario_id: &str,\n  222     overrides: ScenarioGeometryOverrides,\n  223 ) -> Result<TankState, tank_data::PresetError> {\n  224     seeded_state_with_full_overrides(\n  225         seed,\n  226         scenario_id,\n  227         StartupOverrides {\n  228             geometry: overrides,\n  229             ..StartupOverrides::default()\n  230         },\n  231     )\n  232 }\n  233 \n  234 pub fn seeded_state_with_full_overrides(\n  235     seed: SimSeed,\n  236     scenario_id: &str,\n  237     overrides: StartupOverrides,\n  238 ) -> Result<TankState, tank_data::PresetError> {\n  239     validate_geometry_overrides(scenario_id, overrides.geometry)?;\n  240     let mut scenario = load_named_scenario(scenario_id)?;\n  241     scenario.tank_length_cm *= overrides.geometry.size_scale;\n  242     scenario.tank_width_cm *= overrides.geometry.size_scale;\n  243     scenario.tank_height_cm *= overrides.geometry.size_scale;\n  244     scenario.fill_height_cm =\n  245         (scenario.fill_height_cm * overrides.geometry.size_scale * overrides.geometry.fill_ratio)\n  246             .min(scenario.tank_height_cm);\n  247 \n  248     let mut state = materialize_scenario(seed, scenario)?;\n  249     apply_startup_overrides(&mut state, overrides)?;\n  250     Ok(state)\n  251 }\n  252 \n  253 pub fn startup_defaults_for_scenario(\n  254     scenario_id: &str,\n  255 ) -> Result<StartupOverrides, tank_data::PresetError> {\n  256     let scenario = load_named_scenario(scenario_id)?;\n  257     let substrate_preset =\n  258         StartupSubstratePreset::from_ids(&scenario.substrate_ids).ok_or_else(|| {\n  259             tank_data::PresetError::Validation {\n  260                 category: \"scenarios\",\n  261                 id: scenario_id.to_string(),\n  262                 message: format!(\n  263                     \"startup template does not support substrate combination {:?}\",\n  264                     scenario.substrate_ids\n  265                 ),\n  266             }\n  267         })?;\n  268     let plant_selection =\n  269         StartupPlantSelection::from_ids(&scenario.plant_ids).ok_or_else(|| {\n  270             tank_data::PresetError::Validation {\n  271                 category: \"scenarios\",\n  272                 id: scenario_id.to_string(),\n  273                 message: format!(\n  274                     \"startup template does not support plant combination {:?}\",\n  275                     scenario.plant_ids\n  276                 ),\n  277             }\n  278         })?;\n  279 \n  280     let (light_preset, heater_preset, aeration_enabled, initial_adult_shrimp_count) =\n  281         match scenario_id {\n  282             \"medium_planted\" => (\n  283                 StartupLightPreset::Hours10,\n  284                 StartupHeaterPreset::Celsius25,\n  285                 false,\n  286                 10,\n  287             ),\n  288             \"warm_room\" => (\n  289                 StartupLightPreset::Hours8,\n  290                 StartupHeaterPreset::Off,\n  291                 true,\n  292                 5,\n  293             ),\n  294             _ => (\n  295                 StartupLightPreset::Hours6,\n  296                 StartupHeaterPreset::Off,\n  297                 false,\n  298                 0,\n  299             ),\n  300         };\n  301 \n  302     Ok(StartupOverrides {\n  303         geometry: ScenarioGeometryOverrides::default(),\n  304         source_water_profile_id: Some(scenario.source_water_id),\n  305         substrate_preset: Some(substrate_preset),\n  306         plant_selection: Some(plant_selection),\n  307         filter_enabled: Some(true),\n  308         light_preset: Some(light_preset),\n  309         heater_preset: Some(heater_preset),\n  310         aeration_enabled: Some(aeration_enabled),\n  311         initial_adult_shrimp_count: Some(initial_adult_shrimp_count),\n  312     })\n  313 }\n  314 \n  315 /// Converts a `tank_data::SourceWaterPreset` into a `tank_core::SourceWaterProfile`.\n  316 fn source_water_to_profile(preset: &tank_data::SourceWaterPreset) -> SourceWaterProfile {\n  317     SourceWaterProfile {\n  318         temperature_c: preset.temperature_c,\n  319         ammonia_mg_n_per_l: preset.ammonia_mg_n_per_l,\n  320         nitrite_mg_n_per_l: preset.nitrite_mg_n_per_l,\n  321         nitrate_mg_n_per_l: preset.nitrate_mg_n_per_l,\n  322         phosphate_mg_p_per_l: preset.phosphate_mg_p_per_l,\n  323         dic_mg_c_per_l: preset.dic_mg_c_per_l,\n  324         doc_mg_c_per_l: preset.doc_mg_c_per_l,\n  325         don_mg_n_per_l: preset.don_mg_n_per_l,\n  326         alkalinity_meq_per_l: preset.alkalinity_meq_per_l,\n  327         calcium_mg_per_l: preset.calcium_mg_per_l,\n  328         magnesium_mg_per_l: preset.magnesium_mg_per_l,\n  329         sodium_mg_per_l: preset.sodium_mg_per_l,\n  330         potassium_mg_per_l: preset.potassium_mg_per_l,\n  331         bicarbonate_mg_per_l: preset.bicarbonate_mg_per_l,\n  332         chloride_mg_per_l: preset.chloride_mg_per_l,\n  333         sulfate_mg_per_l: preset.sulfate_mg_per_l,\n  334     }\n  335 }\n  336 \n  337 /// Converts a `tank_data::ProcessParamsPreset` into `tank_core::ProcessParams`.\n  338 fn process_preset_to_params(preset: &tank_data::ProcessParamsPreset) -> ProcessParams {\n  339     ProcessParams {\n  340         mineralization_rate_per_day: preset.mineralization_rate_per_day,\n  341         nitrification_vmax: preset.nitrification_vmax,\n  342         reaeration_kla_base: preset.reaeration_kla_base,\n  343         aeration_kla_boost: preset.aeration_kla_boost,\n  344         background_bod_mg_o2_per_g_biomass_per_hour: preset\n  345             .background_bod_mg_o2_per_g_biomass_per_hour,\n  346         plant_photosynthesis_o2_mg_per_g_per_hour: preset.plant_photosynthesis_o2_mg_per_g_per_hour,\n  347         respiration_dic_rate_mg_c_per_g_per_hour: preset.respiration_dic_rate_mg_c_per_g_per_hour,\n  348         photosynthesis_dic_rate_mg_c_per_g_per_hour: preset\n  349             .photosynthesis_dic_rate_mg_c_per_g_per_hour,\n  350         k_surface_w_per_m2_k: preset.k_surface_w_per_m2_k,\n  351         k_wall_w_per_m2_k: preset.k_wall_w_per_m2_k,\n  352 \n  353         feed_leach_rate_per_hour: preset.feed_leach_rate_per_hour,\n  354         fine_detritus_dissolution_rate_per_hour: preset.fine_detritus_dissolution_rate_per_hour,\n  355         feed_n_to_c_ratio: preset.feed_n_to_c_ratio,\n  356 \n  357         decomposer_vmax_per_hour: preset.decomposer_vmax_per_hour,\n  358         decomposer_k_doc_mg: preset.decomposer_k_doc_mg,\n  359         decomposer_growth_yield: preset.decomposer_growth_yield,\n  360         decomposer_decay_rate_per_hour: preset.decomposer_decay_rate_per_hour,\n  361 \n  362         aob_vmax_mg_n_per_g_per_hour: preset.aob_vmax_mg_n_per_g_per_hour,\n  363         aob_k_tan_mg: preset.aob_k_tan_mg,\n  364         aob_k_do_mg: preset.aob_k_do_mg,\n  365         aob_growth_yield: preset.aob_growth_yield,\n  366         aob_decay_rate_per_hour: preset.aob_decay_rate_per_hour,\n  367 \n  368         nob_vmax_mg_n_per_g_per_hour: preset.nob_vmax_mg_n_per_g_per_hour,\n  369         nob_k_nitrite_mg: preset.nob_k_nitrite_mg,\n  370         nob_k_do_mg: preset.nob_k_do_mg,\n  371         nob_growth_yield: preset.nob_growth_yield,\n  372         nob_decay_rate_per_hour: preset.nob_decay_rate_per_hour,\n  373 \n  374         comammox_vmax_fraction: preset.comammox_vmax_fraction,\n  375         comammox_k_tan_mg: preset.comammox_k_tan_mg,\n  376         comammox_k_do_mg: preset.comammox_k_do_mg,\n  377         comammox_growth_yield: preset.comammox_growth_yield,\n  378         comammox_decay_rate_per_hour: preset.comammox_decay_rate_per_hour,\n  379 \n  380         o2_per_mg_n_nitrified: preset.o2_per_mg_n_nitrified,\n  381         alkalinity_meq_per_mg_n_nitrified: preset.alkalinity_meq_per_mg_n_nitrified,\n  382 \n  383         plant_max_growth_rate_fast_stem_per_day: preset.plant_max_growth_rate_fast_stem_per_day,\n  384         plant_max_growth_rate_root_rosette_per_day: preset\n  385             .plant_max_growth_rate_root_rosette_per_day,\n  386         plant_respiration_fraction_per_day: preset.plant_respiration_fraction_per_day,\n  387         plant_senescence_fraction_per_day: preset.plant_senescence_fraction_per_day,\n  388         plant_health_recovery_per_day: preset.plant_health_recovery_per_day,\n  389         plant_health_decline_per_day: preset.plant_health_decline_per_day,\n  390         plant_half_saturation_n_mg_total: preset.plant_half_saturation_n_mg_total,\n  391         plant_half_saturation_p_mg_total: preset.plant_half_saturation_p_mg_total,\n  392         plant_half_saturation_c_mg_total: preset.plant_half_saturation_c_mg_total,\n  393         plant_light_half_saturation: preset.plant_light_half_saturation,\n  394         plant_temp_optimum_c: preset.plant_temp_optimum_c,\n  395         plant_temp_sigma_c: preset.plant_temp_sigma_c,\n  396         plant_crowding_biomass_g_per_m2: preset.plant_crowding_biomass_g_per_m2,\n  397 \n  398         algae_max_growth_rate_per_day: preset.algae_max_growth_rate_per_day,\n  399         periphyton_max_growth_rate_per_day: preset.periphyton_max_growth_rate_per_day,\n  400         algae_respiration_fraction_per_day: preset.algae_respiration_fraction_per_day,\n  401         algae_half_saturation_n_mg_total: preset.algae_half_saturation_n_mg_total,\n  402         algae_half_saturation_p_mg_total: preset.algae_half_saturation_p_mg_total,\n  403         algae_light_half_saturation: preset.algae_light_half_saturation,\n  404         algae_temp_optimum_c: preset.algae_temp_optimum_c,\n  405         algae_temp_sigma_c: preset.algae_temp_sigma_c,\n  406         periphyton_capacity_g_per_m2: preset.periphyton_capacity_g_per_m2,\n  407         algae_bloom_threshold_g_per_l: preset.algae_bloom_threshold_g_per_l,\n  408         algae_nuisance_biomass_g_per_m2: preset.algae_nuisance_biomass_g_per_m2,\n  409 \n  410         shrimp_base_mortality_per_day: preset.shrimp_base_mortality_per_day,\n  411         shrimp_stress_mortality_scale: preset.shrimp_stress_mortality_scale,\n  412         shrimp_juvenile_maturation_days: preset.shrimp_juvenile_maturation_days,\n  413         shrimp_periphyton_grazing_g_per_shrimp_per_day: preset\n  414             .shrimp_periphyton_grazing_g_per_shrimp_per_day,\n  415         shrimp_condition_smoothing: preset.shrimp_condition_smoothing,\n  416 \n  417         microfauna_mineralization_boost: preset.microfauna_mineralization_boost,\n  418         microfauna_periphyton_consumption: preset.microfauna_periphyton_consumption,\n  419         microfauna_population_smoothing: preset.microfauna_population_smoothing,\n  420         microfauna_shrimp_pressure_threshold: preset.microfauna_shrimp_pressure_threshold,\n  421     }\n  422 }\n  423 \n  424 /// Materializes a scenario preset into a fully resolved `TankState`.\n  425 ///\n  426 /// - Geometry comes from the scenario.\n  427 /// - `environment.ambient_temp_c` comes from the scenario.\n  428 /// - Initial `WaterState` totals come from the source-water profile × fill volume.\n  429 /// - Substrate layers come from the scenario's substrate preset IDs.\n  430 /// - Plant guilds come from the scenario's plant preset IDs.\n  431 /// - Source-water catalog is populated with all known source-water presets.\n  432 /// - Process parameters come from the scenario's process params preset.\n  433 pub fn seeded_state(seed: SimSeed, scenario_id: &str) -> Result<TankState, tank_data::PresetError> {\n  434     let scenario = load_named_scenario(scenario_id)?;\n  435     materialize_scenario(seed, scenario)\n  436 }\n  437 \n  438 fn materialize_scenario(\n  439     seed: SimSeed,\n  440     scenario: ScenarioPreset,\n  441 ) -> Result<TankState, tank_data::PresetError> {\n  442     // Geometry\n  443     let geometry = TankGeometry {\n  444         length_cm: scenario.tank_length_cm,\n  445         width_cm: scenario.tank_width_cm,\n  446         height_cm: scenario.tank_height_cm,\n  447         fill_height_cm: scenario.fill_height_cm,\n  448         glass_thickness_mm: 5.0,\n  449         open_top: true,\n  450         lid_exchange_factor: 0.25,\n  451     };\n  452 \n  453     // Source water profile for initial fill\n  454     let source_water_preset = tank_data::load_source_water(&scenario.source_water_id)?;\n  455     let source_profile = source_water_to_profile(&source_water_preset);\n  456 \n  457     // Initial water state from source-water profile\n  458     let water = WaterState::from_source_profile(&source_profile, &geometry);\n  459 \n  460     // Build source-water catalog with all known presets\n  461     let mut source_water_catalog = BTreeMap::new();\n  462     for sw_id in tank_data::source_water_ids() {\n  463         let sw_preset = tank_data::load_source_water(sw_id)?;\n  464         source_water_catalog.insert(sw_id.to_string(), source_water_to_profile(&sw_preset));\n  465     }\n  466 \n  467     // Process parameters\n  468     let process_preset = tank_data::load_process_params(&scenario.process_params_id)?;\n  469     let process_params = process_preset_to_params(&process_preset);\n  470 \n  471     // Substrate layers\n  472     let substrate_layers = build_substrate_layers(&geometry, &scenario.substrate_ids)?;\n  473 \n  474     // Plant guilds\n  475     let plant_guilds = build_plant_guilds(&scenario.plant_ids, &substrate_layers, true)?;\n  476 \n  477     // Shrimp species parameters\n  478     let shrimp_preset = tank_data::load_shrimp(&scenario.shrimp_profile_id)?;\n  479     let shrimp_params = ShrimpRuntimeParams {\n  480         optimal_temp_min_c: shrimp_preset.optimal_temp_min_c,\n  481         optimal_temp_max_c: shrimp_preset.optimal_temp_max_c,\n  482         gh_min_d: shrimp_preset.gh_min_d,\n  483         gh_max_d: shrimp_preset.gh_max_d,\n  484         base_spawn_rate: shrimp_preset.base_spawn_rate,\n  485         egg_duration_days: shrimp_preset.egg_duration_days,\n  486         hatch_success_base: shrimp_preset.hatch_success_base,\n  487         juvenile_sensitivity: shrimp_preset.juvenile_sensitivity,\n  488         high_temp_repro_penalty_start_c: shrimp_preset.high_temp_repro_penalty_start_c,\n  489         high_temp_repro_penalty_full_c: shrimp_preset.high_temp_repro_penalty_full_c,\n  490     };\n  491 \n  492     // Environment\n  493     let environment = tank_core::EnvironmentState {\n  494         ambient_temp_c: scenario.ambient_temp_c,\n  495         ..Default::default()\n  496     };\n  497 \n  498     let mut state = TankState::new(seed);\n  499     state.meta = SimMeta {\n  500         scenario_id: Some(scenario.id),\n  501         notes: Some(scenario.name),\n  502     };\n  503     state.geometry = geometry;\n  504     state.environment = environment;\n  505     state.water = water;\n  506     state.substrate_layers = substrate_layers;\n  507     state.plant_guilds = plant_guilds;\n  508     state.source_water_catalog = source_water_catalog;\n  509     state.process_params = process_params;\n  510     state.shrimp_params = shrimp_params;\n  511 \n  512     Ok(state)\n  513 }\n  514 \n  515 fn apply_startup_overrides(\n  516     state: &mut TankState,\n  517     overrides: StartupOverrides,\n  518 ) -> Result<(), tank_data::PresetError> {\n  519     if let Some(source_water_id) = overrides.source_water_profile_id.as_deref() {\n  520         let profile = if let Some(existing) = state.source_water_catalog.get(source_water_id) {\n  521             existing.clone()\n  522         } else {\n  523             let preset = tank_data::load_source_water(source_water_id)?;\n  524             let profile = source_water_to_profile(&preset);\n  525             state\n  526                 .source_water_catalog\n  527                 .insert(source_water_id.to_string(), profile.clone());\n  528             profile\n  529         };\n  530         state.water = WaterState::from_source_profile(&profile, &state.geometry);\n  531     }\n  532 \n  533     if let Some(substrate_preset) = overrides.substrate_preset {\n  534         let substrate_ids = substrate_preset\n  535             .preset_ids()\n  536             .iter()\n  537             .map(|id| (*id).to_string())\n  538             .collect::<Vec<_>>();\n  539         state.substrate_layers = build_substrate_layers(&state.geometry, &substrate_ids)?;\n  540     }\n  541 \n  542     if overrides.substrate_preset.is_some() || overrides.plant_selection.is_some() {\n  543         let plant_ids = if let Some(plant_selection) = overrides.plant_selection {\n  544             plant_selection\n  545                 .preset_ids()\n  546                 .iter()\n  547                 .map(|id| (*id).to_string())\n  548                 .collect::<Vec<_>>()\n  549         } else {\n  550             state\n  551                 .plant_guilds\n  552                 .iter()\n  553                 .map(|plant| match plant.guild {\n  554                     PlantGuild::FastStem => \"fast_stem\".to_string(),\n  555                     PlantGuild::RootFeedingRosette => \"root_rosette\".to_string(),\n  556                 })\n  557                 .collect::<Vec<_>>()\n  558         };\n  559         state.plant_guilds = build_plant_guilds(&plant_ids, &state.substrate_layers, false)?;\n  560     }\n  561 \n  562     if let Some(filter_enabled) = overrides.filter_enabled {\n  563         state.hardware.filter.enabled = filter_enabled;\n  564         if filter_enabled {\n  565             if state.hardware.filter.flow_lph <= 0.0 {\n  566                 state.hardware.filter.flow_lph = 200.0;\n  567             }\n  568         } else {\n  569             state.hardware.filter.flow_lph = 0.0;\n  570         }\n  571     }\n  572 \n  573     if let Some(light_preset) = overrides.light_preset {\n  574         state.hardware.light.enabled = true;\n  575         state.hardware.light.photoperiod_hours = light_preset.hours();\n  576     }\n  577 \n  578     if let Some(heater_preset) = overrides.heater_preset {\n  579         match heater_preset.setpoint_c() {\n  580             Some(setpoint_c) => {\n  581                 state.hardware.heater.enabled = true;\n  582                 state.hardware.heater.setpoint_c = setpoint_c;\n  583             }\n  584             None => {\n  585                 state.hardware.heater.enabled = false;\n  586                 state.hardware.heater.setpoint_c = 24.0;\n  587             }\n  588         }\n  589         state.hardware.heater.last_output_w = 0.0;\n  590     }\n  591 \n  592     if let Some(aeration_enabled) = overrides.aeration_enabled {\n  593         state.hardware.aeration.enabled = aeration_enabled;\n  594         state.hardware.aeration.intensity = if aeration_enabled { 0.35 } else { 0.0 };\n  595     }\n  596 \n  597     if let Some(initial_adult_shrimp_count) = overrides.initial_adult_shrimp_count {\n  598         state.animal = AnimalState::with_adults(initial_adult_shrimp_count);\n  599     }\n  600 \n  601     Ok(())\n  602 }\n  603 \n  604 fn build_substrate_layers(\n  605     geometry: &TankGeometry,\n  606     substrate_ids: &[String],\n  607 ) -> Result<Vec<SubstrateLayerState>, tank_data::PresetError> {\n  608     let mut substrate_layers = Vec::new();\n  609     for sub_id in substrate_ids {\n  610         let sub_preset = tank_data::load_substrate(sub_id)?;\n  611         let footprint = geometry.footprint_area_cm2();\n  612         substrate_layers.push(SubstrateLayerState {\n  613             kind: match sub_preset.id.as_str() {\n  614                 \"inert_sand\" => tank_core::SubstrateKind::InertSand,\n  615                 \"inert_gravel\" => tank_core::SubstrateKind::InertGravel,\n  616                 \"active_planted\" => tank_core::SubstrateKind::ActivePlanted,\n  617                 \"coarse_porous\" => tank_core::SubstrateKind::CoarsePorous,\n  618                 other => {\n  619                     return Err(tank_data::PresetError::Validation {\n  620                         category: \"substrate\",\n  621                         id: other.to_string(),\n  622                         message: format!(\"unsupported substrate kind: `{other}`\"),\n  623                     });\n  624                 }\n  625             },\n  626             depth_cm: sub_preset.depth_cm,\n  627             nutrient_store_mg_n_total: sub_preset.nutrient_charge_mg_n_total,\n  628             nutrient_store_mg_p_total: sub_preset.nutrient_charge_mg_p_total,\n  629             cation_exchange_capacity_index: sub_preset.cation_exchange_capacity_index,\n  630             detritus_trapping_index: sub_preset.detritus_trapping_index,\n  631             colonizable_area_cm2: footprint * sub_preset.colonizable_area_factor,\n  632             low_oxygen_tendency_index: sub_preset.low_oxygen_tendency_index,\n  633             grazing_surface_index: sub_preset.grazing_surface_index,\n  634         });\n  635     }\n  636     if substrate_layers.is_empty() {\n  637         substrate_layers.push(SubstrateLayerState::default());\n  638     }\n  639     Ok(substrate_layers)\n  640 }\n  641 \n  642 fn build_plant_guilds(\n  643     plant_ids: &[String],\n  644     substrate_layers: &[SubstrateLayerState],\n  645     include_default_when_empty: bool,\n  646 ) -> Result<Vec<PlantGuildState>, tank_data::PresetError> {\n  647     let mut plant_guilds = Vec::new();\n  648     for plant_id in plant_ids {\n  649         let plant_preset = tank_data::load_plant(plant_id)?;\n  650         let guild = match plant_preset.guild.as_str() {\n  651             \"FastStem\" => PlantGuild::FastStem,\n  652             \"RootFeedingRosette\" => PlantGuild::RootFeedingRosette,\n  653             other => {\n  654                 return Err(tank_data::PresetError::Validation {\n  655                     category: \"plants\",\n  656                     id: plant_id.clone(),\n  657                     message: format!(\"unsupported plant guild: `{other}`\"),\n  658                 });\n  659             }\n  660         };\n  661         plant_guilds.push(PlantGuildState {\n  662             guild,\n  663             biomass_g: 5.0,\n  664             health_index: 0.8,\n  665             crowding_index: 0.1,\n  666             habitat_index: if guild == PlantGuild::RootFeedingRosette {\n  667                 root_rosette_habitat_index(substrate_layers)\n  668             } else {\n  669                 0.8\n  670             },\n  671         });\n  672     }\n  673     if plant_guilds.is_empty() && include_default_when_empty {\n  674         plant_guilds.push(PlantGuildState::default());\n  675     }\n  676     Ok(plant_guilds)\n  677 }\n  678 \n  679 fn root_rosette_habitat_index(substrate_layers: &[SubstrateLayerState]) -> f64 {\n  680     substrate_layers\n  681         .iter()\n  682         .map(|layer| layer.cation_exchange_capacity_index)\n  683         .fold(0.0_f64, f64::max)\n  684         .max(0.3)\n  685 }\n  686 \n  687 fn validate_geometry_overrides(\n  688     scenario_id: &str,\n  689     overrides: ScenarioGeometryOverrides,\n  690 ) -> Result<(), tank_data::PresetError> {\n  691     if !overrides.size_scale.is_finite() || overrides.size_scale <= 0.0 {\n  692         return Err(tank_data::PresetError::Validation {\n  693             category: \"scenarios\",\n  694             id: scenario_id.to_string(),\n  695             message: format!(\n  696                 \"size_scale must be finite and > 0.0, got {}\",\n  697                 overrides.size_scale\n  698             ),\n  699         });\n  700     }\n  701 \n  702     if !overrides.fill_ratio.is_finite() || !(0.1..=1.0).contains(&overrides.fill_ratio) {\n  703         return Err(tank_data::PresetError::Validation {\n  704             category: \"scenarios\",\n  705             id: scenario_id.to_string(),\n  706             message: format!(\n  707                 \"fill_ratio must be finite and in 0.1..=1.0, got {}\",\n  708                 overrides.fill_ratio\n  709             ),\n  710         });\n  711     }\n  712 \n  713     Ok(())\n  714 }\n  715 \n  716 /// Creates a deterministic cycling fixture pair: one seeded, one unseeded.\n  717 /// Both tanks are otherwise identical (~20L nano tank with moderate source water,\n  718 /// fed daily, with aeration enabled).\n  719 /// The seeded tank starts with elevated nitrifier biomass and higher maturity;\n  720 /// the unseeded tank starts with minimal microbes and low maturity.\n  721 pub fn cycling_fixture_pair(seed: SimSeed) -> (TankState, TankState) {\n  722     let base = cycling_base_state(seed);\n  723 \n  724     let mut seeded = base.clone();\n  725     seeded.meta.scenario_id = Some(\"cycling_seeded\".to_string());\n  726     // Seeded: same decomposer biomass but much higher nitrifier biomass + maturity\n  727     seeded.microbe = MicrobeState {\n  728         decomposer_biomass_g: 0.1,\n  729         ammonia_oxidizer_biomass_g: 0.20,\n  730         nitrite_oxidizer_biomass_g: 0.15,\n  731         comammox_biomass_g: 0.05,\n  732         maturity_index: 0.6,\n  733     };\n  734     seeded.filter_state = FilterState {\n  735         biofilter_maturity_index: 0.6,\n  736         clogging_index: 0.0,\n  737         seeded_biomass_index: 0.8,\n  738     };\n  739 \n  740     let mut unseeded = base;\n  741     unseeded.meta.scenario_id = Some(\"cycling_unseeded\".to_string());\n  742     // Unseeded: same decomposer biomass but minimal nitrifier biomass + maturity\n  743     unseeded.microbe = MicrobeState {\n  744         decomposer_biomass_g: 0.1,\n  745         ammonia_oxidizer_biomass_g: 0.005,\n  746         nitrite_oxidizer_biomass_g: 0.005,\n  747         comammox_biomass_g: 0.001,\n  748         maturity_index: 0.05,\n  749     };\n  750     unseeded.filter_state = FilterState {\n  751         biofilter_maturity_index: 0.05,\n  752         clogging_index: 0.0,\n  753         seeded_biomass_index: 0.0,\n  754     };\n  755 \n  756     (seeded, unseeded)\n  757 }\n  758 \n  759 /// Base state shared by both cycling fixtures.\n  760 fn cycling_base_state(seed: SimSeed) -> TankState {\n  761     let geometry = TankGeometry {\n  762         length_cm: 30.0,\n  763         width_cm: 25.0,\n  764         height_cm: 30.0,\n  765         fill_height_cm: 26.0,\n  766         glass_thickness_mm: 5.0,\n  767         open_top: true,\n  768         lid_exchange_factor: 0.25,\n  769     };\n  770 \n  771     let water = WaterState::default_for_geometry(&geometry);\n  772 \n  773     let mut state = TankState::new(seed);\n  774     state.geometry = geometry;\n  775     state.water = water;\n  776     state.water.temperature_c = 25.0;\n  777     state.environment.ambient_temp_c = 25.0;\n  778 \n  779     // Enable moderate aeration\n  780     state.hardware.aeration.enabled = true;\n  781     state.hardware.aeration.intensity = 0.3;\n  782 \n  783     // Single fast-stem plant\n  784     state.plant_guilds = vec![PlantGuildState {\n  785         guild: PlantGuild::FastStem,\n  786         biomass_g: 3.0,\n  787         health_index: 0.8,\n  788         crowding_index: 0.1,\n  789         habitat_index: 0.8,\n  790     }];\n  791 \n  792     state.process_params = ProcessParams::default();\n  793 \n  794     state\n  795 }\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"awk 'FNR==1{print \\\"FILE \\\" FILENAME} {printf \\\"%5d %s\\\\n\\\", FNR, \"'$0}'\"' crates/tank_tui/src/screens/actions.rs crates/tank_tui/src/screens/overview.rs crates/tank_tui/src/screens/chemistry.rs crates/tank_tui/src/screens/biology.rs crates/tank_tui/src/screens/log.rs crates/tank_tui/src/screens/mod.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"awk 'FNR==1{print \\\"FILE \\\" FILENAME} {printf \\\"%5d %s\\\\n\\\", FNR, \"'$0}'\"' crates/tank_tui/src/screens/actions.rs crates/tank_tui/src/screens/overview.rs crates/tank_tui/src/screens/chemistry.rs crates/tank_tui/src/screens/biology.rs crates/tank_tui/src/screens/log.rs crates/tank_tui/src/screens/mod.rs\"","aggregated_output":"FILE crates/tank_tui/src/screens/actions.rs\n    1 use ratatui::{\n    2     prelude::*,\n    3     widgets::{Block, Borders, List, ListItem, Paragraph},\n    4 };\n    5 use tank_core::PlayerAction;\n    6 \n    7 use crate::TuiApp;\n    8 \n    9 #[derive(Debug, Clone, Copy, PartialEq, Eq)]\n   10 pub enum ActionKind {\n   11     Feed,\n   12     WaterChangePercent,\n   13     TrimPlants,\n   14     SiphonDetritus,\n   15     CleanFilter,\n   16     AddShrimp,\n   17     RemoveShrimp,\n   18     ChangePhotoperiod,\n   19     ChangeLightIntensity,\n   20     ChangeHeaterSetpoint,\n   21     ChangeAmbientTemperature,\n   22     ChangeAeration,\n   23 }\n   24 \n   25 impl ActionKind {\n   26     pub const ALL: [Self; 12] = [\n   27         Self::Feed,\n   28         Self::WaterChangePercent,\n   29         Self::TrimPlants,\n   30         Self::SiphonDetritus,\n   31         Self::CleanFilter,\n   32         Self::AddShrimp,\n   33         Self::RemoveShrimp,\n   34         Self::ChangePhotoperiod,\n   35         Self::ChangeLightIntensity,\n   36         Self::ChangeHeaterSetpoint,\n   37         Self::ChangeAmbientTemperature,\n   38         Self::ChangeAeration,\n   39     ];\n   40 \n   41     pub fn label(self) -> &'static str {\n   42         match self {\n   43             Self::Feed => \"Feed\",\n   44             Self::WaterChangePercent => \"Water change\",\n   45             Self::TrimPlants => \"Trim plants\",\n   46             Self::SiphonDetritus => \"Siphon detritus\",\n   47             Self::CleanFilter => \"Clean filter\",\n   48             Self::AddShrimp => \"Add shrimp\",\n   49             Self::RemoveShrimp => \"Remove shrimp\",\n   50             Self::ChangePhotoperiod => \"Photoperiod\",\n   51             Self::ChangeLightIntensity => \"Light intensity\",\n   52             Self::ChangeHeaterSetpoint => \"Heater setpoint\",\n   53             Self::ChangeAmbientTemperature => \"Ambient temp\",\n   54             Self::ChangeAeration => \"Aeration\",\n   55         }\n   56     }\n   57 \n   58     fn field_count(self) -> usize {\n   59         match self {\n   60             Self::WaterChangePercent | Self::ChangeAeration => 2,\n   61             _ => 1,\n   62         }\n   63     }\n   64 }\n   65 \n   66 #[derive(Debug, Clone, PartialEq)]\n   67 pub struct ActionFormState {\n   68     selected_action: usize,\n   69     selected_field: usize,\n   70     replace_next_numeric: bool,\n   71     feed_grams: String,\n   72     water_change_percent: String,\n   73     water_change_source_index: usize,\n   74     trim_fraction: String,\n   75     siphon_fraction: String,\n   76     clean_filter_intensity: String,\n   77     add_shrimp_count: String,\n   78     remove_shrimp_count: String,\n   79     photoperiod_hours: String,\n   80     light_intensity: String,\n   81     heater_setpoint_c: String,\n   82     ambient_temp_c: String,\n   83     aeration_enabled: bool,\n   84     aeration_intensity: String,\n   85 }\n   86 \n   87 #[derive(Debug, Clone, Copy, PartialEq, Eq)]\n   88 enum FieldKind {\n   89     Numeric { integer_only: bool },\n   90     Choice,\n   91     Toggle,\n   92 }\n   93 \n   94 #[derive(Debug, Clone, PartialEq, Eq)]\n   95 pub struct ActionFieldView {\n   96     pub label: String,\n   97     pub value: String,\n   98     pub hint: &'static str,\n   99 }\n  100 \n  101 impl Default for ActionFormState {\n  102     fn default() -> Self {\n  103         Self {\n  104             selected_action: 0,\n  105             selected_field: 0,\n  106             replace_next_numeric: true,\n  107             feed_grams: \"0.20\".to_string(),\n  108             water_change_percent: \"25.0\".to_string(),\n  109             water_change_source_index: 1,\n  110             trim_fraction: \"0.25\".to_string(),\n  111             siphon_fraction: \"0.30\".to_string(),\n  112             clean_filter_intensity: \"0.50\".to_string(),\n  113             add_shrimp_count: \"5\".to_string(),\n  114             remove_shrimp_count: \"2\".to_string(),\n  115             photoperiod_hours: \"8.0\".to_string(),\n  116             light_intensity: \"0.70\".to_string(),\n  117             heater_setpoint_c: \"24.0\".to_string(),\n  118             ambient_temp_c: \"24.0\".to_string(),\n  119             aeration_enabled: true,\n  120             aeration_intensity: \"0.40\".to_string(),\n  121         }\n  122     }\n  123 }\n  124 \n  125 impl ActionFormState {\n  126     pub fn selected_action(&self) -> ActionKind {\n  127         ActionKind::ALL[self.selected_action]\n  128     }\n  129 \n  130     pub fn selected_action_index(&self) -> usize {\n  131         self.selected_action\n  132     }\n  133 \n  134     pub fn selected_field_index(&self) -> usize {\n  135         self.selected_field\n  136     }\n  137 \n  138     pub fn fields(&self) -> Vec<ActionFieldView> {\n  139         match self.selected_action() {\n  140             ActionKind::Feed => vec![ActionFieldView {\n  141                 label: \"grams\".to_string(),\n  142                 value: self.feed_grams.clone(),\n  143                 hint: \"Type a non-negative amount\",\n  144             }],\n  145             ActionKind::WaterChangePercent => vec![\n  146                 ActionFieldView {\n  147                     label: \"percent\".to_string(),\n  148                     value: self.water_change_percent.clone(),\n  149                     hint: \"0.0 to 100.0\",\n  150                 },\n  151                 ActionFieldView {\n  152                     label: \"source\".to_string(),\n  153                     value: tank_data::source_water_ids()[self.water_change_source_index]\n  154                         .to_string(),\n  155                     hint: \"[ / ] cycle source profile\",\n  156                 },\n  157             ],\n  158             ActionKind::TrimPlants => vec![ActionFieldView {\n  159                 label: \"fraction\".to_string(),\n  160                 value: self.trim_fraction.clone(),\n  161                 hint: \"0.0 to 1.0\",\n  162             }],\n  163             ActionKind::SiphonDetritus => vec![ActionFieldView {\n  164                 label: \"fraction\".to_string(),\n  165                 value: self.siphon_fraction.clone(),\n  166                 hint: \"0.0 to 1.0\",\n  167             }],\n  168             ActionKind::CleanFilter => vec![ActionFieldView {\n  169                 label: \"intensity\".to_string(),\n  170                 value: self.clean_filter_intensity.clone(),\n  171                 hint: \"0.0 to 1.0\",\n  172             }],\n  173             ActionKind::AddShrimp => vec![ActionFieldView {\n  174                 label: \"count\".to_string(),\n  175                 value: self.add_shrimp_count.clone(),\n  176                 hint: \"Whole shrimp count\",\n  177             }],\n  178             ActionKind::RemoveShrimp => vec![ActionFieldView {\n  179                 label: \"count\".to_string(),\n  180                 value: self.remove_shrimp_count.clone(),\n  181                 hint: \"Whole shrimp count\",\n  182             }],\n  183             ActionKind::ChangePhotoperiod => vec![ActionFieldView {\n  184                 label: \"hours\".to_string(),\n  185                 value: self.photoperiod_hours.clone(),\n  186                 hint: \"0.0 to 24.0\",\n  187             }],\n  188             ActionKind::ChangeLightIntensity => vec![ActionFieldView {\n  189                 label: \"intensity\".to_string(),\n  190                 value: self.light_intensity.clone(),\n  191                 hint: \"0.0 to 1.0\",\n  192             }],\n  193             ActionKind::ChangeHeaterSetpoint => vec![ActionFieldView {\n  194                 label: \"setpoint C\".to_string(),\n  195                 value: self.heater_setpoint_c.clone(),\n  196                 hint: \"> 0.0 C\",\n  197             }],\n  198             ActionKind::ChangeAmbientTemperature => vec![ActionFieldView {\n  199                 label: \"target C\".to_string(),\n  200                 value: self.ambient_temp_c.clone(),\n  201                 hint: \"> 0.0 C\",\n  202             }],\n  203             ActionKind::ChangeAeration => vec![\n  204                 ActionFieldView {\n  205                     label: \"enabled\".to_string(),\n  206                     value: if self.aeration_enabled {\n  207                         \"true\".to_string()\n  208                     } else {\n  209                         \"false\".to_string()\n  210                     },\n  211                     hint: \"Press t to toggle\",\n  212                 },\n  213                 ActionFieldView {\n  214                     label: \"intensity\".to_string(),\n  215                     value: self.aeration_intensity.clone(),\n  216                     hint: \"0.0 to 1.0\",\n  217                 },\n  218             ],\n  219         }\n  220     }\n  221 \n  222     pub fn select_next_action(&mut self) {\n  223         self.selected_action = (self.selected_action + 1) % ActionKind::ALL.len();\n  224         self.reset_selection();\n  225     }\n  226 \n  227     pub fn select_previous_action(&mut self) {\n  228         self.selected_action =\n  229             (self.selected_action + ActionKind::ALL.len() - 1) % ActionKind::ALL.len();\n  230         self.reset_selection();\n  231     }\n  232 \n  233     pub fn select_next_field(&mut self) {\n  234         let max_fields = self.selected_action().field_count();\n  235         self.selected_field = (self.selected_field + 1) % max_fields;\n  236         self.replace_next_numeric = true;\n  237     }\n  238 \n  239     pub fn select_previous_field(&mut self) {\n  240         let max_fields = self.selected_action().field_count();\n  241         self.selected_field = (self.selected_field + max_fields - 1) % max_fields;\n  242         self.replace_next_numeric = true;\n  243     }\n  244 \n  245     pub fn cycle_choice(&mut self, forward: bool) -> bool {\n  246         if self.current_field_kind() != FieldKind::Choice {\n  247             return false;\n  248         }\n  249 \n  250         let options = tank_data::source_water_ids();\n  251         if forward {\n  252             self.water_change_source_index = (self.water_change_source_index + 1) % options.len();\n  253         } else {\n  254             self.water_change_source_index =\n  255                 (self.water_change_source_index + options.len() - 1) % options.len();\n  256         }\n  257         true\n  258     }\n  259 \n  260     pub fn toggle_boolean(&mut self) -> bool {\n  261         if self.current_field_kind() != FieldKind::Toggle {\n  262             return false;\n  263         }\n  264 \n  265         self.aeration_enabled = !self.aeration_enabled;\n  266         true\n  267     }\n  268 \n  269     pub fn edit_char(&mut self, ch: char) -> bool {\n  270         let replace_next = self.replace_next_numeric;\n  271         self.replace_next_numeric = false;\n  272         let Some((buffer, integer_only)) = self.current_numeric_buffer_mut() else {\n  273             self.replace_next_numeric = replace_next;\n  274             return false;\n  275         };\n  276 \n  277         if integer_only && !ch.is_ascii_digit() {\n  278             return false;\n  279         }\n  280         if !(integer_only || ch.is_ascii_digit() || ch == '.') {\n  281             return false;\n  282         }\n  283         if ch == '.' && buffer.contains('.') {\n  284             return false;\n  285         }\n  286 \n  287         if replace_next {\n  288             buffer.clear();\n  289         }\n  290         buffer.push(ch);\n  291         true\n  292     }\n  293 \n  294     pub fn backspace(&mut self) -> bool {\n  295         let Some((buffer, _)) = self.current_numeric_buffer_mut() else {\n  296             return false;\n  297         };\n  298 \n  299         buffer.pop();\n  300         let became_empty = buffer.is_empty();\n  301         if became_empty {\n  302             buffer.push('0');\n  303         }\n  304         self.replace_next_numeric = became_empty;\n  305         true\n  306     }\n  307 \n  308     pub fn submit(&mut self) -> Result<PlayerAction, String> {\n  309         let action = match self.selected_action() {\n  310             ActionKind::Feed => PlayerAction::Feed {\n  311                 grams: parse_f64(\"grams\", &self.feed_grams)?,\n  312             },\n  313             ActionKind::WaterChangePercent => PlayerAction::WaterChangePercent {\n  314                 percent: parse_f64(\"percent\", &self.water_change_percent)?,\n  315                 source_profile_id: tank_data::source_water_ids()[self.water_change_source_index]\n  316                     .to_string(),\n  317             },\n  318             ActionKind::TrimPlants => PlayerAction::TrimPlants {\n  319                 fraction: parse_f64(\"fraction\", &self.trim_fraction)?,\n  320             },\n  321             ActionKind::SiphonDetritus => PlayerAction::SiphonDetritus {\n  322                 fraction: parse_f64(\"fraction\", &self.siphon_fraction)?,\n  323             },\n  324             ActionKind::CleanFilter => PlayerAction::CleanFilter {\n  325                 intensity: parse_f64(\"intensity\", &self.clean_filter_intensity)?,\n  326             },\n  327             ActionKind::AddShrimp => PlayerAction::AddShrimp {\n  328                 count: parse_u32(\"count\", &self.add_shrimp_count)?,\n  329             },\n  330             ActionKind::RemoveShrimp => PlayerAction::RemoveShrimp {\n  331                 count: parse_u32(\"count\", &self.remove_shrimp_count)?,\n  332             },\n  333             ActionKind::ChangePhotoperiod => PlayerAction::ChangePhotoperiod {\n  334                 hours: parse_f64(\"hours\", &self.photoperiod_hours)?,\n  335             },\n  336             ActionKind::ChangeLightIntensity => PlayerAction::ChangeLightIntensity {\n  337                 intensity_index: parse_f64(\"intensity_index\", &self.light_intensity)?,\n  338             },\n  339             ActionKind::ChangeHeaterSetpoint => PlayerAction::ChangeHeaterSetpoint {\n  340                 setpoint_c: parse_f64(\"setpoint_c\", &self.heater_setpoint_c)?,\n  341             },\n  342             ActionKind::ChangeAmbientTemperature => PlayerAction::ChangeAmbientTemperature {\n  343                 target_c: parse_f64(\"target_c\", &self.ambient_temp_c)?,\n  344             },\n  345             ActionKind::ChangeAeration => PlayerAction::ChangeAeration {\n  346                 enabled: self.aeration_enabled,\n  347                 intensity: parse_f64(\"intensity\", &self.aeration_intensity)?,\n  348             },\n  349         };\n  350 \n  351         action.validate().map_err(|error| error.to_string())?;\n  352         self.replace_next_numeric = true;\n  353         Ok(action)\n  354     }\n  355 \n  356     fn current_field_kind(&self) -> FieldKind {\n  357         match (self.selected_action(), self.selected_field) {\n  358             (ActionKind::WaterChangePercent, 1) => FieldKind::Choice,\n  359             (ActionKind::ChangeAeration, 0) => FieldKind::Toggle,\n  360             (ActionKind::AddShrimp, 0) | (ActionKind::RemoveShrimp, 0) => {\n  361                 FieldKind::Numeric { integer_only: true }\n  362             }\n  363             _ => FieldKind::Numeric {\n  364                 integer_only: false,\n  365             },\n  366         }\n  367     }\n  368 \n  369     fn current_numeric_buffer_mut(&mut self) -> Option<(&mut String, bool)> {\n  370         let integer_only = matches!(\n  371             self.current_field_kind(),\n  372             FieldKind::Numeric { integer_only: true }\n  373         );\n  374 \n  375         let buffer = match (self.selected_action(), self.selected_field) {\n  376             (ActionKind::Feed, 0) => &mut self.feed_grams,\n  377             (ActionKind::WaterChangePercent, 0) => &mut self.water_change_percent,\n  378             (ActionKind::TrimPlants, 0) => &mut self.trim_fraction,\n  379             (ActionKind::SiphonDetritus, 0) => &mut self.siphon_fraction,\n  380             (ActionKind::CleanFilter, 0) => &mut self.clean_filter_intensity,\n  381             (ActionKind::AddShrimp, 0) => &mut self.add_shrimp_count,\n  382             (ActionKind::RemoveShrimp, 0) => &mut self.remove_shrimp_count,\n  383             (ActionKind::ChangePhotoperiod, 0) => &mut self.photoperiod_hours,\n  384             (ActionKind::ChangeLightIntensity, 0) => &mut self.light_intensity,\n  385             (ActionKind::ChangeHeaterSetpoint, 0) => &mut self.heater_setpoint_c,\n  386             (ActionKind::ChangeAmbientTemperature, 0) => &mut self.ambient_temp_c,\n  387             (ActionKind::ChangeAeration, 1) => &mut self.aeration_intensity,\n  388             _ => return None,\n  389         };\n  390 \n  391         Some((buffer, integer_only))\n  392     }\n  393 \n  394     fn reset_selection(&mut self) {\n  395         self.selected_field = 0;\n  396         self.replace_next_numeric = true;\n  397     }\n  398 }\n  399 \n  400 pub fn render(frame: &mut Frame<'_>, area: Rect, app: &TuiApp) {\n  401     let layout = Layout::horizontal([Constraint::Length(28), Constraint::Min(30)]).split(area);\n  402     let actions = ActionKind::ALL\n  403         .iter()\n  404         .enumerate()\n  405         .map(|(index, action)| {\n  406             let style = if index == app.action_form.selected_action_index() {\n