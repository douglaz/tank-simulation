{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LAH6iUSWYm7nAd1isKUYyE","type":"tool_result","content":"     1→use std::collections::BTreeMap;\n     2→\n     3→use tank_core::{\n     4→    AnimalState, FilterState, MicrobeState, PlantGuild, PlantGuildState, ProcessParams,\n     5→    ShrimpRuntimeParams, SimMeta, SimSeed, SourceWaterProfile, SubstrateLayerState, TankGeometry,\n     6→    TankState, WaterState,\n     7→};\n     8→use tank_data::{load_scenario, ScenarioPreset};\n     9→\n    10→#[derive(Debug, Clone, Copy, PartialEq)]\n    11→pub struct ScenarioGeometryOverrides {\n    12→    pub size_scale: f64,\n    13→    pub fill_ratio: f64,\n    14→}\n    15→\n    16→impl Default for ScenarioGeometryOverrides {\n    17→    fn default() -> Self {\n    18→        Self {\n    19→            size_scale: 1.0,\n    20→            fill_ratio: 1.0,\n    21→        }\n    22→    }\n    23→}\n    24→\n    25→#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n    26→pub enum StartupSubstratePreset {\n    27→    InertSand,\n    28→    InertGravel,\n    29→    ActivePlanted,\n    30→    ActivePlantedWithCoarsePorous,\n    31→}\n    32→\n    33→impl StartupSubstratePreset {\n    34→    pub const ALL: [Self; 4] = [\n    35→        Self::InertSand,\n    36→        Self::InertGravel,\n    37→        Self::ActivePlanted,\n    38→        Self::ActivePlantedWithCoarsePorous,\n    39→    ];\n    40→\n    41→    pub fn label(self) -> &'static str {\n    42→        match self {\n    43→            Self::InertSand => \"inert_sand\",\n    44→            Self::InertGravel => \"inert_gravel\",\n    45→            Self::ActivePlanted => \"active_planted\",\n    46→            Self::ActivePlantedWithCoarsePorous => \"active_planted + coarse_porous\",\n    47→        }\n    48→    }\n    49→\n    50→    fn preset_ids(self) -> &'static [&'static str] {\n    51→        match self {\n    52→            Self::InertSand => &[\"inert_sand\"],\n    53→            Self::InertGravel => &[\"inert_gravel\"],\n    54→            Self::ActivePlanted => &[\"active_planted\"],\n    55→            Self::ActivePlantedWithCoarsePorous => &[\"active_planted\", \"coarse_porous\"],\n    56→        }\n    57→    }\n    58→\n    59→    fn from_ids(ids: &[String]) -> Option<Self> {\n    60→        let ids = ids.iter().map(String::as_str).collect::<Vec<_>>();\n    61→        match ids.as_slice() {\n    62→            [\"inert_sand\"] => Some(Self::InertSand),\n    63→            [\"inert_gravel\"] => Some(Self::InertGravel),\n    64→            [\"active_planted\"] => Some(Self::ActivePlanted),\n    65→            [\"active_planted\", \"coarse_porous\"] => Some(Self::ActivePlantedWithCoarsePorous),\n    66→            _ => None,\n    67→        }\n    68→    }\n    69→}\n    70→\n    71→#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n    72→pub enum StartupPlantSelection {\n    73→    FastStemOnly,\n    74→    RootFeedingRosetteOnly,\n    75→    BothGuilds,\n    76→    None,\n    77→}\n    78→\n    79→impl StartupPlantSelection {\n    80→    pub const ALL: [Self; 4] = [\n    81→        Self::FastStemOnly,\n    82→        Self::RootFeedingRosetteOnly,\n    83→        Self::BothGuilds,\n    84→        Self::None,\n    85→    ];\n    86→\n    87→    pub fn label(self) -> &'static str {\n    88→        match self {\n    89→            Self::FastStemOnly => \"FastStem only\",\n    90→            Self::RootFeedingRosetteOnly => \"RootFeedingRosette only\",\n    91→            Self::BothGuilds => \"Both guilds\",\n    92→            Self::None => \"None\",\n    93→        }\n    94→    }\n    95→\n    96→    fn preset_ids(self) -> &'static [&'static str] {\n    97→        match self {\n    98→            Self::FastStemOnly => &[\"fast_stem\"],\n    99→            Self::RootFeedingRosetteOnly => &[\"root_rosette\"],\n   100→            Self::BothGuilds => &[\"fast_stem\", \"root_rosette\"],\n   101→            Self::None => &[],\n   102→        }\n   103→    }\n   104→\n   105→    fn from_ids(ids: &[String]) -> Option<Self> {\n   106→        let mut normalized = ids.iter().map(String::as_str).collect::<Vec<_>>();\n   107→        normalized.sort_unstable();\n   108→        match normalized.as_slice() {\n   109→            [] => Some(Self::None),\n   110→            [\"fast_stem\"] => Some(Self::FastStemOnly),\n   111→            [\"root_rosette\"] => Some(Self::RootFeedingRosetteOnly),\n   112→            [\"fast_stem\", \"root_rosette\"] => Some(Self::BothGuilds),\n   113→            _ => None,\n   114→        }\n   115→    }\n   116→}\n   117→\n   118→#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n   119→pub enum StartupLightPreset {\n   120→    Hours6,\n   121→    Hours8,\n   122→    Hours10,\n   123→    Hours12,\n   124→}\n   125→\n   126→impl StartupLightPreset {\n   127→    pub const ALL: [Self; 4] = [Self::Hours6, Self::Hours8, Self::Hours10, Self::Hours12];\n   128→\n   129→    pub fn label(self) -> &'static str {\n   130→        match self {\n   131→            Self::Hours6 => \"6h\",\n   132→            Self::Hours8 => \"8h\",\n   133→            Self::Hours10 => \"10h\",\n   134→            Self::Hours12 => \"12h\",\n   135→        }\n   136→    }\n   137→\n   138→    pub fn hours(self) -> f64 {\n   139→        match self {\n   140→            Self::Hours6 => 6.0,\n   141→            Self::Hours8 => 8.0,\n   142→            Self::Hours10 => 10.0,\n   143→            Self::Hours12 => 12.0,\n   144→        }\n   145→    }\n   146→}\n   147→\n   148→#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n   149→pub enum StartupHeaterPreset {\n   150→    Off,\n   151→    Celsius24,\n   152→    Celsius25,\n   153→    Celsius26,\n   154→}\n   155→\n   156→impl StartupHeaterPreset {\n   157→    pub const ALL: [Self; 4] = [Self::Off, Self::Celsius24, Self::Celsius25, Self::Celsius26];\n   158→\n   159→    pub fn label(self) -> &'static str {\n   160→        match self {\n   161→            Self::Off => \"Off\",\n   162→            Self::Celsius24 => \"24 C\",\n   163→            Self::Celsius25 => \"25 C\",\n   164→            Self::Celsius26 => \"26 C\",\n   165→        }\n   166→    }\n   167→\n   168→    pub fn setpoint_c(self) -> Option<f64> {\n   169→        match self {\n   170→            Self::Off => None,\n   171→            Self::Celsius24 => Some(24.0),\n   172→            Self::Celsius25 => Some(25.0),\n   173→            Self::Celsius26 => Some(26.0),\n   174→        }\n   175→    }\n   176→}\n   177→\n   178→#[derive(Debug, Clone, PartialEq)]\n   179→pub struct StartupOverrides {\n   180→    pub geometry: ScenarioGeometryOverrides,\n   181→    pub source_water_profile_id: Option<String>,\n   182→    pub substrate_preset: Option<StartupSubstratePreset>,\n   183→    pub plant_selection: Option<StartupPlantSelection>,\n   184→    pub filter_enabled: Option<bool>,\n   185→    pub light_preset: Option<StartupLightPreset>,\n   186→    pub heater_preset: Option<StartupHeaterPreset>,\n   187→    pub aeration_enabled: Option<bool>,\n   188→    pub initial_adult_shrimp_count: Option<u32>,\n   189→}\n   190→\n   191→impl Default for StartupOverrides {\n   192→    fn default() -> Self {\n   193→        Self {\n   194→            geometry: ScenarioGeometryOverrides::default(),\n   195→            source_water_profile_id: None,\n   196→            substrate_preset: None,\n   197→            plant_selection: None,\n   198→            filter_enabled: None,\n   199→            light_preset: None,\n   200→            heater_preset: None,"}]},"parent_tool_use_id":"toolu_01Y9ahSmCe1Vce9gb4yRGRh2","session_id":"49fc8440-ef1d-426c-844e-0d9d2eefdcf5","uuid":"dbd202c0-bcf7-48b0-8db6-425e98e6c6a9"}
