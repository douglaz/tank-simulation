{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016v6BsjaKjAxNRaDTKPsSLW","type":"tool_result","content":"     1→use std::collections::VecDeque;\n     2→\n     3→use crate::{\n     4→    invariants::enforce_invariants,\n     5→    rng::SimSeed,\n     6→    systems,\n     7→    types::{\n     8→        EventCause, EventKind, EventSeverity, PlayerAction, SimError, SimEvent, TankSnapshot,\n     9→        TankState,\n    10→    },\n    11→};\n    12→\n    13→pub trait SimulationEngine {\n    14→    fn apply_action(&mut self, action: PlayerAction) -> Result<(), SimError>;\n    15→    fn step_hours(&mut self, hours: u32) -> Result<(), SimError>;\n    16→    fn snapshot(&self) -> TankSnapshot;\n    17→    fn full_state(&self) -> &TankState;\n    18→}\n    19→\n    20→#[derive(Debug, Clone, PartialEq)]\n    21→pub struct Engine {\n    22→    state: TankState,\n    23→    queued_actions: VecDeque<PlayerAction>,\n    24→}\n    25→\n    26→impl Engine {\n    27→    pub fn new(seed: SimSeed) -> Self {\n    28→        Self {\n    29→            state: TankState::new(seed),\n    30→            queued_actions: VecDeque::new(),\n    31→        }\n    32→    }\n    33→\n    34→    pub fn from_parts(state: TankState, queued_actions: Vec<PlayerAction>) -> Self {\n    35→        Self {\n    36→            state,\n    37→            queued_actions: queued_actions.into(),\n    38→        }\n    39→    }\n    40→\n    41→    pub fn queued_actions(&self) -> Vec<PlayerAction> {\n    42→        self.queued_actions.iter().cloned().collect()\n    43→    }\n    44→\n    45→    fn step_one_hour(&mut self) -> Result<(), SimError> {\n    46→        let actions_slice: Vec<_> = self.queued_actions.iter().cloned().collect();\n    47→        systems::water_change::validate_water_changes(&self.state, &actions_slice)?;\n    48→\n    49→        while let Some(action) = self.queued_actions.pop_front() {\n    50→            self.process_action(action);\n    51→        }\n    52→\n    53→        // Step 4: update water temperature from ambient and heater\n    54→        systems::temperature::step_temperature(&mut self.state);\n    55→\n    56→        // Step 5: compute light state for the current hour.\n    57→        let light_on = self.state.hardware.light.enabled\n    58→            && systems::light::is_light_on(\n    59→                self.state.environment.hour_of_day,\n    60→                self.state.hardware.light.photoperiod_hours,\n    61→            );\n    62→\n    63→        // Step 6-8: nitrogen cycle phase (feed leaching, detritus breakdown,\n    64→        // mineralization, nitrification, guild growth/decay).\n    65→        // This runs between light-state resolution and chemistry/DO/event phases.\n    66→        // Nitrification O2 consumption and alkalinity depletion are handled\n    67→        // internally by the nitrogen cycle system.\n    68→        let _nc_output = systems::nitrogen_cycle::step_nitrogen_cycle(&mut self.state);\n    69→\n    70→        // Step 9: update DIC, alkalinity, and pH.\n    71→        systems::chemistry::step_hourly_chemistry(&mut self.state, light_on);\n    72→\n    73→        // Step 10 / 11-partial: update dissolved oxygen with background respiration and\n    74→        // light-driven photosynthetic support from existing biomass.\n    75→        systems::dissolved_oxygen::step_dissolved_oxygen(&mut self.state, light_on);\n    76→\n    77→        // Step 12: hourly shrimp stress accumulation.\n    78→        systems::shrimp::step_hourly_shrimp_stress(&mut self.state);\n    79→\n    80→        // Step 13: emit threshold-based chemistry warnings.\n    81→        systems::events::emit_hourly_threshold_events(&mut self.state);\n    82→\n    83→        self.state.environment.hour_of_day = (self.state.environment.hour_of_day + 1) % 24;\n    84→        if self.state.environment.hour_of_day == 0 {\n    85→            self.state.environment.day += 1;\n    86→            // Daily pipeline\n    87→            self.run_daily_update();\n    88→        }\n    89→\n    90→        enforce_invariants(&mut self.state)\n    91→    }\n    92→\n    93→    fn run_daily_update(&mut self) {\n    94→        // Daily pipeline: plants → algae → microfauna → shrimp → biofilter → stability\n    95→        systems::plant_growth::step_daily_plants(&mut self.state);\n    96→        systems::algae_growth::step_daily_algae(&mut self.state);\n    97→        systems::microfauna::step_daily_microfauna(&mut self.state);\n    98→        systems::shrimp::step_daily_shrimp(&mut self.state);\n    99→        systems::nitrogen_cycle::update_daily_filter_clogging(&mut self.state);\n   100→\n   101→        // Biofilter maturity summary update\n   102→        let maturity_delta =\n   103→            systems::nitrogen_cycle::update_daily_biofilter_maturity(&mut self.state);\n   104→        if maturity_delta > 0.005 {\n   105→            self.push_event(\n   106→                EventSeverity::Info,\n   107→                EventKind::BiofilmMaturityIncrease,\n   108→                vec![EventCause::BiofilterImmature],\n   109→                format!(\n   110→                    \"Biofilter maturity increased to {:.3}\",\n   111→                    self.state.filter_state.biofilter_maturity_index\n   112→                ),\n   113→            );\n   114→        }\n   115→        // Emit CycleProgressing when maturity is actively growing\n   116→        let current_maturity = self.state.filter_state.biofilter_maturity_index;\n   117→        if maturity_delta > 0.001 && current_maturity < 0.9 {\n   118→            systems::events::emit_once_per_day_pub(\n   119→                &mut self.state,\n   120→                EventSeverity::Info,\n   121→                EventKind::CycleProgressing,\n   122→                vec![EventCause::BiofilterImmature],\n   123→                format!(\"Nitrogen cycle progressing, maturity {current_maturity:.3}\"),\n   124→            );\n   125→        }\n   126→\n   127→        // Long-term stability metrics\n   128→        systems::shrimp::update_stability_tracker(&mut self.state);\n   129→    }\n   130→\n   131→    fn process_action(&mut self, action: PlayerAction) {\n   132→        match action {\n   133→            PlayerAction::Feed { grams } => {\n   134→                self.state.detritus.particulate_organics_g_total += grams;\n   135→                self.push_event(\n   136→                    EventSeverity::Info,\n   137→                    EventKind::CycleProgressing,\n   138→                    vec![EventCause::Overfeeding],\n   139→                    format!(\"Queued feed processed: {grams:.2} g\"),\n   140→                );\n   141→            }\n   142→            PlayerAction::WaterChangePercent {\n   143→                percent,\n   144→                source_profile_id,\n   145→            } => {\n   146→                if percent <= 0.0 {\n   147→                    return;\n   148→                }\n   149→                // Profile was pre-validated; look it up (guaranteed to exist).\n   150→                let profile = self\n   151→                    .state\n   152→                    .source_water_catalog\n   153→                    .get(&source_profile_id)\n   154→                    .cloned();\n   155→                if let Some(profile) = profile {\n   156→                    systems::water_change::apply_water_change(&mut self.state, percent, &profile);\n   157→                    self.push_event(\n   158→                        EventSeverity::Info,\n   159→                        EventKind::StabilityImproving,\n   160→                        vec![EventCause::WaterChange],\n   161→                        format!(\"Water change processed: {percent:.1}% with {source_profile_id}\"),\n   162→                    );\n   163→                }\n   164→            }\n   165→            PlayerAction::TrimPlants { fraction } => {\n   166→                let mut trimmed_biomass_g = 0.0;\n   167→                for plant in &mut self.state.plant_guilds {\n   168→                    let trimmed = plant.biomass_g * fraction;\n   169→                    plant.biomass_g -= trimmed;\n   170→                    trimmed_biomass_g += trimmed;\n   171→                }\n   172→                self.state.detritus.fine_detritus_g_total += trimmed_biomass_g;\n   173→            }\n   174→            PlayerAction::SiphonDetritus { fraction } => {\n   175→                self.state.detritus.particulate_organics_g_total *= 1.0 - fraction;\n   176→                self.state.detritus.fine_detritus_g_total *= 1.0 - fraction;\n   177→            }\n   178→            PlayerAction::CleanFilter { intensity } => {\n   179→                let current_cleanliness =\n   180→                    self.state.hardware.filter.cleanliness_index.clamp(0.0, 1.0);\n   181→                self.state.hardware.filter.cleanliness_index = (current_cleanliness\n   182→                    + ((1.0 - current_cleanliness) * intensity))\n   183→                    .clamp(0.0, 1.0);\n   184→                self.state.filter_state.biofilter_maturity_index *= 1.0 - (intensity * 0.5);\n   185→                self.state.filter_state.clogging_index *= 1.0 - intensity;\n   186→                // Proportional setback in active nitrifier and decomposer biomass\n   187→                let setback = intensity * 0.5;\n   188→                self.state.microbe.decomposer_biomass_g *= 1.0 - setback;\n   189→                self.state.microbe.ammonia_oxidizer_biomass_g *= 1.0 - setback;\n   190→                self.state.microbe.nitrite_oxidizer_biomass_g *= 1.0 - setback;\n   191→                self.state.microbe.comammox_biomass_g *= 1.0 - setback;\n   192→                self.push_event(\n   193→                    EventSeverity::Warning,\n   194→                    EventKind::FilterCleaningSetback,\n   195→                    vec![EventCause::FilterMaintenance],\n   196→                    format!(\"Filter cleaned at intensity {intensity:.2}\"),\n   197→                );\n   198→            }\n   199→            PlayerAction::AddShrimp { count } => {\n   200→                self.state.animal.adults_count =\n   201→                    self.state.animal.adults_count.saturating_add(count);\n   202→            }\n   203→            PlayerAction::RemoveShrimp { count } => {\n   204→                self.state.animal.adults_count =\n   205→                    self.state.animal.adults_count.saturating_sub(count);\n   206→                // Preserve berried_females_count <= adults_count (also trims egg cohorts)\n   207→                self.state.animal.clamp_berried_to_adults();\n   208→            }\n   209→            PlayerAction::ChangePhotoperiod { hours } => {\n   210→                self.state.hardware.light.photoperiod_hours = hours;\n   211→            }\n   212→            PlayerAction::ChangeLightIntensity { intensity_index } => {\n   213→                self.state.hardware.light.intensity_index = intensity_index;\n   214→            }\n   215→            PlayerAction::ChangeHeaterSetpoint { setpoint_c } => {\n   216→                self.state.hardware.heater.setpoint_c = setpoint_c;\n   217→            }\n   218→            PlayerAction::ChangeAmbientTemperature { target_c } => {\n   219→                self.state.environment.ambient_temp_c = target_c;\n   220→            }\n   221→            PlayerAction::ChangeAeration { enabled, intensity } => {\n   222→                self.state.hardware.aeration.enabled = enabled;\n   223→                self.state.hardware.aeration.intensity = intensity;\n   224→            }\n   225→        }\n   226→    }\n   227→\n   228→    fn push_event(\n   229→        &mut self,\n   230→        severity: EventSeverity,\n   231→        kind: EventKind,\n   232→        cause_codes: Vec<EventCause>,\n   233→        summary: String,\n   234→    ) {\n   235→        self.state.event_log.push(SimEvent::new(\n   236→            self.state.environment.day,\n   237→            self.state.environment.hour_of_day,\n   238→            severity,\n   239→            kind,\n   240→            cause_codes,\n   241→            summary,\n   242→        ));\n   243→    }\n   244→}\n   245→\n   246→impl SimulationEngine for Engine {\n   247→    fn apply_action(&mut self, action: PlayerAction) -> Result<(), SimError> {\n   248→        action.validate()?;\n   249→\n   250→        // State-aware validation for RemoveShrimp\n   251→        if let PlayerAction::RemoveShrimp { count } = &action {\n   252→            let mut available = self.state.animal.adults_count as i64;\n   253→            for queued in &self.queued_actions {\n   254→                match queued {\n   255→                    PlayerAction::RemoveShrimp { count: c } => available -= *c as i64,\n   256→                    PlayerAction::AddShrimp { count: c } => available += *c as i64,\n   257→                    _ => {}\n   258→                }\n   259→            }\n   260→            if (*count as i64) > available {\n   261→                return Err(SimError::ShrimpRemovalExceedsAvailable {\n   262→                    requested: *count,\n   263→                    available: available.max(0) as u32,\n   264→                });\n   265→            }\n   266→        }\n   267→\n   268→        if let PlayerAction::WaterChangePercent {\n   269→            source_profile_id, ..\n   270→        } = &action\n   271→        {\n   272→            systems::water_change::validate_source_profile(&self.state, source_profile_id)?;\n   273→        }\n   274→\n   275→        self.queued_actions.push_back(action);\n   276→        Ok(())\n   277→    }\n   278→\n   279→    fn step_hours(&mut self, hours: u32) -> Result<(), SimError> {\n   280→        for _ in 0..hours {\n   281→            self.step_one_hour()?;\n   282→        }\n   283→        enforce_invariants(&mut self.state)\n   284→    }\n   285→\n   286→    fn snapshot(&self) -> TankSnapshot {\n   287→        TankSnapshot::from_state(&self.state)\n   288→    }\n   289→\n   290→    fn full_state(&self) -> &TankState {\n   291→        &self.state\n   292→    }\n   293→}\n   294→"}]},"parent_tool_use_id":"toolu_01QF2vsntjDVHcTNrk9CgJR6","session_id":"49fc8440-ef1d-426c-844e-0d9d2eefdcf5","uuid":"71b17f56-f474-42fe-8b62-5aa75c0a7ac0"}
