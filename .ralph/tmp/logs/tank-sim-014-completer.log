n   426→/// - Geometry comes from the scenario.\n   427→/// - `environment.ambient_temp_c` comes from the scenario.\n   428→/// - Initial `WaterState` totals come from the source-water profile × fill volume.\n   429→/// - Substrate layers come from the scenario's substrate preset IDs.\n   430→/// - Plant guilds come from the scenario's plant preset IDs.\n   431→/// - Source-water catalog is populated with all known source-water presets.\n   432→/// - Process parameters come from the scenario's process params preset.\n   433→pub fn seeded_state(seed: SimSeed, scenario_id: &str) -> Result<TankState, tank_data::PresetError> {\n   434→    let scenario = load_named_scenario(scenario_id)?;\n   435→    materialize_scenario(seed, scenario)\n   436→}\n   437→\n   438→fn materialize_scenario(\n   439→    seed: SimSeed,\n   440→    scenario: ScenarioPreset,\n   441→) -> Result<TankState, tank_data::PresetError> {\n   442→    // Geometry\n   443→    let geometry = TankGeometry {\n   444→        length_cm: scenario.tank_length_cm,\n   445→        width_cm: scenario.tank_width_cm,\n   446→        height_cm: scenario.tank_height_cm,\n   447→        fill_height_cm: scenario.fill_height_cm,\n   448→        glass_thickness_mm: 5.0,\n   449→        open_top: true,\n   450→        lid_exchange_factor: 0.25,\n   451→    };\n   452→\n   453→    // Source water profile for initial fill\n   454→    let source_water_preset = tank_data::load_source_water(&scenario.source_water_id)?;\n   455→    let source_profile = source_water_to_profile(&source_water_preset);\n   456→\n   457→    // Initial water state from source-water profile\n   458→    let water = WaterState::from_source_profile(&source_profile, &geometry);\n   459→\n   460→    // Build source-water catalog with all known presets\n   461→    let mut source_water_catalog = BTreeMap::new();\n   462→    for sw_id in tank_data::source_water_ids() {\n   463→        let sw_preset = tank_data::load_source_water(sw_id)?;\n   464→        source_water_catalog.insert(sw_id.to_string(), source_water_to_profile(&sw_preset));\n   465→    }\n   466→\n   467→    // Process parameters\n   468→    let process_preset = tank_data::load_process_params(&scenario.process_params_id)?;\n   469→    let process_params = process_preset_to_params(&process_preset);\n   470→\n   471→    // Substrate layers\n   472→    let substrate_layers = build_substrate_layers(&geometry, &scenario.substrate_ids)?;\n   473→\n   474→    // Plant guilds\n   475→    let plant_guilds = build_plant_guilds(&scenario.plant_ids, &substrate_layers, true)?;\n   476→\n   477→    // Shrimp species parameters\n   478→    let shrimp_preset = tank_data::load_shrimp(&scenario.shrimp_profile_id)?;\n   479→    let shrimp_params = ShrimpRuntimeParams {\n   480→        optimal_temp_min_c: shrimp_preset.optimal_temp_min_c,\n   481→        optimal_temp_max_c: shrimp_preset.optimal_temp_max_c,\n   482→        gh_min_d: shrimp_preset.gh_min_d,\n   483→        gh_max_d: shrimp_preset.gh_max_d,\n   484→        base_spawn_rate: shrimp_preset.base_spawn_rate,\n   485→        egg_duration_days: shrimp_preset.egg_duration_days,\n   486→        hatch_success_base: shrimp_preset.hatch_success_base,\n   487→        juvenile_sensitivity: shrimp_preset.juvenile_sensitivity,\n   488→        high_temp_repro_penalty_start_c: shrimp_preset.high_temp_repro_penalty_start_c,\n   489→        high_temp_repro_penalty_full_c: shrimp_preset.high_temp_repro_penalty_full_c,\n   490→    };\n   491→\n   492→    // Environment\n   493→    let environment = tank_core::EnvironmentState {\n   494→        ambient_temp_c: scenario.ambient_temp_c,\n   495→        ..Default::default()\n   496→    };\n   497→\n   498→    let mut state = TankState::new(seed);\n   499→    state.meta = SimMeta {"}]},"parent_tool_use_id":"toolu_01Y9ahSmCe1Vce9gb4yRGRh2","session_id":"49fc8440-ef1d-426c-844e-0d9d2eefdcf5","uuid":"8cc3367c-3377-4261-940b-9a589b6ec16f"}
