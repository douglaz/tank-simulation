{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01S2qVtxa2HFpwhgLNJazLbe","type":"tool_result","content":"     1→use tank_core::{\n     2→    Engine, PlayerAction, SimError, SimSeed, SimulationEngine, SourceWaterProfile, TankState,\n     3→};\n     4→\n     5→/// Helper: build a state with a known source-water catalog containing `ro_like`.\n     6→fn state_with_ro_like(seed: SimSeed) -> TankState {\n     7→    let mut state = TankState::new(seed);\n     8→    state\n     9→        .source_water_catalog\n    10→        .insert(\"ro_like\".to_string(), SourceWaterProfile::zero());\n    11→    state\n    12→}\n    13→\n    14→#[test]\n    15→fn water_change_50_percent_ro_like_halves_dissolved_totals() -> Result<(), tank_core::SimError> {\n    16→    let state = state_with_ro_like(SimSeed(100));\n    17→    let mut engine = Engine::from_parts(state, vec![]);\n    18→\n    19→    // Record pre-change totals\n    20→    let before = engine.full_state().water.clone();\n    21→\n    22→    // Apply 50% water change with zero-nutrient source\n    23→    engine.apply_action(PlayerAction::WaterChangePercent {\n    24→        percent: 50.0,\n    25→        source_profile_id: \"ro_like\".to_string(),\n    26→    })?;\n    27→    engine.step_hours(1)?;\n    28→\n    29→    let after = &engine.full_state().water;\n    30→\n    31→    // Each dissolved total should be reduced by 50% ± 0.5%\n    32→    let tolerance = 0.005; // 0.5%\n    33→    let expected_ratio = 0.5;\n    34→\n    35→    let checks: Vec<(&str, f64, f64)> = vec![\n    36→        (\n    37→            \"ammonia_total_mg_n_total\",\n    38→            before.ammonia_total_mg_n_total,\n    39→            after.ammonia_total_mg_n_total,\n    40→        ),\n    41→        (\n    42→            \"nitrite_mg_n_total\",\n    43→            before.nitrite_mg_n_total,\n    44→            after.nitrite_mg_n_total,\n    45→        ),\n    46→        (\n    47→            \"nitrate_mg_n_total\",\n    48→            before.nitrate_mg_n_total,\n    49→            after.nitrate_mg_n_total,\n    50→        ),\n    51→        (\n    52→            \"phosphate_mg_p_total\",\n    53→            before.phosphate_mg_p_total,\n    54→            after.phosphate_mg_p_total,\n    55→        ),\n    56→        (\n    57→            \"dissolved_inorganic_carbon_mg_c_total\",\n    58→            before.dissolved_inorganic_carbon_mg_c_total,\n    59→            after.dissolved_inorganic_carbon_mg_c_total,\n    60→        ),\n    61→        (\n    62→            \"calcium_mg_total\",\n    63→            before.calcium_mg_total,\n    64→            after.calcium_mg_total,\n    65→        ),\n    66→        (\n    67→            \"magnesium_mg_total\",\n    68→            before.magnesium_mg_total,\n    69→            after.magnesium_mg_total,\n    70→        ),\n    71→        (\n    72→            \"sodium_mg_total\",\n    73→            before.sodium_mg_total,\n    74→            after.sodium_mg_total,\n    75→        ),\n    76→        (\n    77→            \"potassium_mg_total\",\n    78→            before.potassium_mg_total,\n    79→            after.potassium_mg_total,\n    80→        ),\n    81→        (\n    82→            \"bicarbonate_mg_total\",\n    83→            before.bicarbonate_mg_total,\n    84→            after.bicarbonate_mg_total,\n    85→        ),\n    86→        (\n    87→            \"chloride_mg_total\",\n    88→            before.chloride_mg_total,\n    89→            after.chloride_mg_total,\n    90→        ),\n    91→        (\n    92→            \"sulfate_mg_total\",\n    93→            before.sulfate_mg_total,\n    94→            after.sulfate_mg_total,\n    95→        ),\n    96→    ];\n    97→\n    98→    for (name, before_val, after_val) in &checks {\n    99→        if *before_val > 0.0 {\n   100→            let actual_ratio = after_val / before_val;\n   101→            assert!(\n   102→                (actual_ratio - expected_ratio).abs() < tolerance,\n   103→                \"{name}: expected ratio {expected_ratio} ± {tolerance}, got {actual_ratio} (before={before_val}, after={after_val})\"\n   104→            );\n   105→        } else {\n   106→            // If before was 0.0, after should also be 0.0 (ro_like adds nothing)\n   107→            assert!(\n   108→                after_val.abs() < f64::EPSILON,\n   109→                \"{name}: expected 0.0 after zero water change, got {after_val}\"\n   110→            );\n   111→        }\n   112→    }\n   113→\n   114→    Ok(())\n   115→}\n   116→\n   117→#[test]\n   118→fn water_change_0_percent_is_noop() -> Result<(), tank_core::SimError> {\n   119→    let state = state_with_ro_like(SimSeed(200));\n   120→    let mut engine = Engine::from_parts(state, vec![]);\n   121→\n   122→    let before = engine.full_state().water.clone();\n   123→\n   124→    engine.apply_action(PlayerAction::WaterChangePercent {\n   125→        percent: 0.0,\n   126→        source_profile_id: \"ro_like\".to_string(),\n   127→    })?;\n   128→    engine.step_hours(1)?;\n   129→\n   130→    let after = &engine.full_state().water;\n   131→\n   132→    // Chemistry should be unchanged (temperature may shift from ambient model)\n   133→    assert!(\n   134→        (after.calcium_mg_total - before.calcium_mg_total).abs() < f64::EPSILON,\n   135→        \"0% water change should not change calcium\"\n   136→    );\n   137→    assert!(\n   138→        (after.alkalinity_meq_total - before.alkalinity_meq_total).abs() < f64::EPSILON,\n   139→        \"0% water change should not change alkalinity\"\n   140→    );\n   141→\n   142→    Ok(())\n   143→}\n   144→\n   145→#[test]\n   146→fn water_change_100_percent_yields_source_temperature() -> Result<(), tank_core::SimError> {\n   147→    let mut state = state_with_ro_like(SimSeed(300));\n   148→    // Add a source with different temperature\n   149→    let mut warm_source = SourceWaterProfile::zero();\n   150→    warm_source.temperature_c = 30.0;\n   151→    state\n   152→        .source_water_catalog\n   153→        .insert(\"warm\".to_string(), warm_source);\n   154→\n   155→    let mut engine = Engine::from_parts(state, vec![]);\n   156→\n   157→    engine.apply_action(PlayerAction::WaterChangePercent {\n   158→        percent: 100.0,\n   159→        source_profile_id: \"warm\".to_string(),\n   160→    })?;\n   161→    engine.step_hours(1)?;\n   162→\n   163→    // After 100% water change, temperature should be very close to source temp\n   164→    // (may shift slightly from the temperature system running after the change)\n   165→    let temp = engine.full_state().water.temperature_c;\n   166→    assert!(\n   167→        (temp - 30.0).abs() < 1.0,\n   168→        \"100% water change should bring temp near source: got {temp}\"\n   169→    );\n   170→\n   171→    Ok(())\n   172→}\n   173→\n   174→#[test]\n   175→fn water_change_50_percent_mixes_temperature() -> Result<(), tank_core::SimError> {\n   176→    let mut state = state_with_ro_like(SimSeed(400));\n   177→    let mut cold_source = SourceWaterProfile::zero();\n   178→    cold_source.temperature_c = 10.0;\n   179→    state\n   180→        .source_water_catalog\n   181→        .insert(\"cold\".to_string(), cold_source);\n   182→    // Tank starts at 24°C, ambient is 24°C\n   183→    state.water.temperature_c = 24.0;\n   184→\n   185→    let mut engine = Engine::from_parts(state, vec![]);\n   186→\n   187→    engine.apply_action(PlayerAction::WaterChangePercent {\n   188→        percent: 50.0,\n   189→        source_profile_id: \"cold\".to_string(),\n   190→    })?;\n   191→    engine.step_hours(1)?;\n   192→\n   193→    // Expected mixed temp: 24*0.5 + 10*0.5 = 17°C, plus thermal system may shift slightly\n   194→    let temp = engine.full_state().water.temperature_c;\n   195→    assert!(\n   196→        temp > 14.0 && temp < 20.0,\n   197→        \"50% cold water change should mix temperature proportionally: got {temp}\"\n   198→    );\n   199→\n   200→    Ok(())\n   201→}\n   202→\n   203→#[test]\n   204→fn unknown_source_profile_returns_error() -> Result<(), tank_core::SimError> {\n   205→    let state = TankState::new(SimSeed(500)); // empty catalog\n   206→    let mut engine = Engine::from_parts(state, vec![]);\n   207→\n   208→    assert!(\n   209→        matches!(\n   210→            engine.apply_action(PlayerAction::WaterChangePercent {\n   211→                percent: 50.0,\n   212→                source_profile_id: \"nonexistent\".to_string(),\n   213→            }),\n   214→            Err(tank_core::SimError::UnknownSourceProfile { .. })\n   215→        ),\n   216→        \"Expected UnknownSourceProfile error during apply_action\"\n   217→    );\n   218→    assert!(engine.queued_actions().is_empty());\n   219→\n   220→    Ok(())\n   221→}\n   222→\n   223→#[test]\n   224→fn queued_unknown_profile_leaves_state_unchanged() -> Result<(), tank_core::SimError> {\n   225→    let mut state = TankState::new(SimSeed(600));\n   226→    state.detritus.particulate_organics_g_total = 5.0;\n   227→    let before = state.clone();\n   228→\n   229→    let mut engine = Engine::from_parts(\n   230→        state,\n   231→        vec![\n   232→            PlayerAction::Feed { grams: 1.0 },\n   233→            PlayerAction::WaterChangePercent {\n   234→                percent: 50.0,\n   235→                source_profile_id: \"bad_id\".to_string(),\n   236→            },\n   237→        ],\n   238→    );\n   239→\n   240→    let result = engine.step_hours(1);\n   241→    assert!(result.is_err());\n   242→\n   243→    // State should be exactly unchanged: day, hour, event_log, water, rng all pristine\n   244→    let after = engine.full_state();\n   245→    assert_eq!(before.environment.day, after.environment.day);\n   246→    assert_eq!(\n   247→        before.environment.hour_of_day,\n   248→        after.environment.hour_of_day\n   249→    );\n   250→    assert_eq!(before.event_log.len(), after.event_log.len());\n   251→    assert!((before.water.calcium_mg_total - after.water.calcium_mg_total).abs() < f64::EPSILON,);\n   252→\n   253→    Ok(())\n   254→}\n   255→\n   256→#[test]\n   257→fn invalid_resolved_profile_returns_error_and_leaves_state_unchanged() -> Result<(), SimError> {\n   258→    let mut state = TankState::new(SimSeed(700));\n   259→    // Insert a profile with NaN in a chemistry field — simulating corrupted saved state\n   260→    let mut bad_profile = SourceWaterProfile::zero();\n   261→    bad_profile.calcium_mg_per_l = f64::NAN;\n   262→    state\n   263→        .source_water_catalog\n   264→        .insert(\"corrupted\".to_string(), bad_profile);\n   265→\n   266→    let before = state.clone();\n   267→    let mut engine = Engine::from_parts(\n   268→        state,\n   269→        vec![\n   270→            PlayerAction::Feed { grams: 1.0 },\n   271→            PlayerAction::WaterChangePercent {\n   272→                percent: 50.0,\n   273→                source_profile_id: \"corrupted\".to_string(),\n   274→            },\n   275→        ],\n   276→    );\n   277→\n   278→    let result = engine.step_hours(1);\n   279→    assert!(\n   280→        matches!(result, Err(SimError::InvalidSourceProfile { .. })),\n   281→        \"Expected InvalidSourceProfile error, got: {result:?}\"\n   282→    );\n   283→\n   284→    // State should be exactly unchanged\n   285→    let after = engine.full_state();\n   286→    assert_eq!(before.environment.day, after.environment.day);\n   287→    assert_eq!(\n   288→        before.environment.hour_of_day,\n   289→        after.environment.hour_of_day\n   290→    );\n   291→    assert_eq!(before.event_log.len(), after.event_log.len());\n   292→    assert!((before.water.calcium_mg_total - after.water.calcium_mg_total).abs() < f64::EPSILON,);\n   293→    assert!(\n   294→        (before.water.ammonia_total_mg_n_total - after.water.ammonia_total_mg_n_total).abs()\n   295→            < f64::EPSILON,\n   296→    );\n   297→    // Detritus should not have been modified (feed not applied)\n   298→    assert!(\n   299→        (before.detritus.particulate_organics_g_total\n   300→            - after.detritus.particulate_organics_g_total)\n   301→            .abs()\n   302→            < f64::EPSILON,\n   303→    );\n   304→\n   305→    Ok(())\n   306→}\n   307→\n   308→#[test]\n   309→fn invalid_resolved_profile_negative_chemistry_returns_error() -> Result<(), SimError> {\n   310→    let mut state = TankState::new(SimSeed(800));\n   311→    let mut bad_profile = SourceWaterProfile::zero();\n   312→    bad_profile.nitrate_mg_n_per_l = -5.0;\n   313→    state\n   314→        .source_water_catalog\n   315→        .insert(\"negative\".to_string(), bad_profile);\n   316→\n   317→    let mut engine = Engine::from_parts(state, vec![]);\n   318→\n   319→    assert!(\n   320→        matches!(\n   321→            engine.apply_action(PlayerAction::WaterChangePercent {\n   322→                percent: 25.0,\n   323→                source_profile_id: \"negative\".to_string(),\n   324→            }),\n   325→            Err(SimError::InvalidSourceProfile { .. })\n   326→        ),\n   327→        \"Expected InvalidSourceProfile error for negative chemistry during apply_action\"\n   328→    );\n   329→    assert!(engine.queued_actions().is_empty());\n   330→\n   331→    Ok(())\n   332→}\n   333→"}]},"parent_tool_use_id":"toolu_01TbL11acpaon5yFeM4XCZ1j","session_id":"49fc8440-ef1d-426c-844e-0d9d2eefdcf5","uuid":"b25f7766-d03c-4c1f-81ee-2a4d961c8871"}
