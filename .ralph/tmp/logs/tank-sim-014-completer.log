{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ska5hcqRiGikFUGS792Pr6","type":"tool_result","content":"     1→use ratatui::{\n     2→    prelude::*,\n     3→    widgets::{Block, Borders, Paragraph},\n     4→};\n     5→\n     6→use crate::TuiApp;\n     7→\n     8→pub fn render(frame: &mut Frame<'_>, area: Rect, app: &TuiApp) {\n     9→    let snapshot = &app.snapshot;\n    10→    let layout = Layout::vertical([\n    11→        Constraint::Length(8),\n    12→        Constraint::Length(8),\n    13→        Constraint::Min(8),\n    14→    ])\n    15→    .split(area);\n    16→    let top = Layout::horizontal([Constraint::Percentage(50), Constraint::Percentage(50)])\n    17→        .split(layout[0]);\n    18→    let middle = Layout::horizontal([Constraint::Percentage(50), Constraint::Percentage(50)])\n    19→        .split(layout[1]);\n    20→\n    21→    let plants = Paragraph::new(vec![\n    22→        Line::from(format!(\n    23→            \"Fast stem {:.2} g  health {:.2}\",\n    24→            snapshot.fast_stem_biomass_g, snapshot.fast_stem_health_index\n    25→        )),\n    26→        Line::from(format!(\n    27→            \"Root rosette {:.2} g  health {:.2}\",\n    28→            snapshot.root_feeding_rosette_biomass_g, snapshot.root_feeding_rosette_health_index\n    29→        )),\n    30→        Line::from(format!(\n    31→            \"Substrate N {:.1} mg  P {:.1} mg\",\n    32→            snapshot.substrate_nutrient_remaining_mg_n_total,\n    33→            snapshot.substrate_nutrient_remaining_mg_p_total\n    34→        )),\n    35→    ])\n    36→    .block(Block::default().title(\"Plant guilds\").borders(Borders::ALL));\n    37→    frame.render_widget(plants, top[0]);\n    38→\n    39→    let algae = Paragraph::new(vec![\n    40→        Line::from(format!(\n    41→            \"Suspended algae {:.2} g\",\n    42→            snapshot.suspended_algae_biomass_g\n    43→        )),\n    44→        Line::from(format!(\"Periphyton