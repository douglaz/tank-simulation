pub substrate_uptake_bias: f64,\n    90→    pub provenance: Option<Provenance>,\n    91→}\n    92→\n    93→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    94→pub struct ShrimpPreset {\n    95→    pub id: String,\n    96→    pub name: String,\n    97→    pub species: String,\n    98→    pub optimal_temp_min_c: f64,\n    99→    pub optimal_temp_max_c: f64,\n   100→    pub gh_min_d: f64,\n   101→    pub gh_max_d: f64,\n   102→    #[serde(default = \"default_shrimp_base_spawn_rate\")]\n   103→    pub base_spawn_rate: f64,\n   104→    #[serde(default = \"default_shrimp_egg_duration_days\")]\n   105→    pub egg_duration_days: u32,\n   106→    #[serde(default = \"default_shrimp_hatch_success_base\")]\n   107→    pub hatch_success_base: f64,\n   108→    #[serde(default = \"default_shrimp_juvenile_sensitivity\")]\n   109→    pub juvenile_sensitivity: f64,\n   110→    #[serde(default = \"default_shrimp_high_temp_repro_penalty_start\")]\n   111→    pub high_temp_repro_penalty_start_c: f64,\n   112→    #[serde(default = \"default_shrimp_high_temp_repro_penalty_full\")]\n   113→    pub high_temp_repro_penalty_full_c: f64,\n   114→    pub provenance: Option<Provenance>,\n   115→}\n   116→\n   117→impl ShrimpPreset {\n   118→    /// Validates that all shrimp species parameters are finite, non-negative,\n   119→    /// and logically consistent.\n   120→    pub fn validate(&self) -> Result<(), String> {\n   121→        let fields: &[(&str, f64)] = &[\n   122→            (\"optimal_temp_min_c\", self.optimal_temp_min_c),\n   123→            (\"optimal_temp_max_c\", self.optimal_temp_max_c),\n   124→            (\"gh_min_d\", self.gh_min_d),\n   125→            (\"gh_max_d\", self.gh_max_d),\n   126→            (\"base_spawn_rate\", self.base_spawn_rate),\n   127→            (\"hatch_success_base\", self.hatch_success_base),\n   128→            (\"juvenile_sensitivity\", self.juvenile_sensitivity),\n   129→            (\n   130→                \"high_temp_repro_penalty_start_c\",\n   131→                self.high_temp_repro_penalty_start_c,\n   132→            ),\n   133→            (\n   134→                \"high_temp_repro_penalty_full_c\",\n   135→                self.high_temp_repro_penalty_full_c,\n   136→            ),\n   137→        ];\n   138→        for (name, value) in fields {\n   139→            if !value.is_finite() {\n   140→                return Err(format!(\"field `{name}` must be finite, got {value}\"));\n   141→            }\n   142→            if *value < 0.0 {\n   143→                return Err(format!(\"field `{name}` must be non-negative, got {value}\"));\n   144→            }\n   145→        }\n   146→        if self.egg_duration_days == 0 {\n   147→            return Err(\"egg_duration_days must be > 0\".to_string());\n   148→        }\n   149→        if self.optimal_temp_min_c >= self.optimal_temp_max_c {\n   150→            return Err(format!(\n   151→                \"optimal_temp_min_c ({}) must be < optimal_temp_max_c ({})\",\n   152→                self.optimal_temp_min_c, self.optimal_temp_max_c\n   153→            ));\n   154→        }\n   155→        if self.gh_min_d >= self.gh_max_d {\n   156→            return Err(format!(\n   157→                \"gh_min_d ({}) must be < gh_max_d ({})\",\n   158→                self.gh_min_d, self.gh_max_d\n   159→            ));\n   160→        }\n   161→        if self.high_temp_repro_penalty_start_c >= self.high_temp_repro_penalty_full_c {\n   162→            return Err(format!(\n   163→                \"high_temp_repro_penalty_start_c ({}) must be < high_temp_repro_penalty_full_c ({})\",\n   164→                self.high_temp_repro_penalty_start_c, self.high_temp_repro_penalty_full_c\n   165→            ));\n   166→        }\n   167→        if self.base_spawn_rate > 1.0 {\n   168→            return Err(format!(\n   169→                \"base_spawn_rate must be <= 1.0, got {}\",\n   170→                self.base_spawn_rate\n   171→            ));\n   172→        }\n   173→        if self.hatch_success_base > 1.0 {\n   174→            return Err(format!(\n   175→                \"hatch_success_base must be <= 1.0, got {}\",\n   176→                self.hatch_success_base\n   177→            ));\n   178→        }\n   179→        Ok(())\n   180→    }\n   181→}\n   182→\n   183→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n   184→pub struct ProcessParamsPreset {\n   185→    pub id: String,\n   186→    pub name: String,\n   187→    pub mineralization_rate_per_day: f64,\n   188→    pub nitrification_vmax: f64,\n   189→    pub reaeration_kla_base: f64,\n   190→    pub aeration_kla_boost: f64,\n   191→    pub background_bod_mg_o2_per_g_biomass_per_hour: f64,\n   192→    pub plant_photosynthesis_o2_mg_per_g_per_hour: f64,\n   193→    pub respiration_dic_rate_mg_c_per_g_per_hour: f64,\n   194→    pub photosynthesis_dic_rate_mg_c_per_g_per_hour: f64,\n   195→    pub k_surface_w_per_m2_k: f64,\n   196→    pub k_wall_w_per_m2_k: f64,\n   197→\n   198→    // Nitrogen cycle: feed leaching\n   199→    #[serde(default = \"default_feed_leach_rate\")]\n   200→    pub feed_leach_rate_per_hour: f64,\n   201→    #[serde(default = \"default_fine_detritus_dissolution_rate\")]\n   202→    pub fine_detritus_dissolution_rate_per_hour: f64,\n   203→    #[serde(default = \"default_feed_n_to_c_ratio\")]\n   204→    pub feed_n_to_c_ratio: f64,\n   205→\n   206→    // Decomposer mineralization\n   207→    #[serde(default = \"default_decomposer_vmax\")]\n   208→    pub decomposer_vmax_per_hour: f64,\n   209→    #[serde(default = \"default_decomposer_k_doc\")]\n   210→    pub decomposer_k_doc_mg: f64,\n   211→    #[serde(default = \"default_decomposer_growth_yield\")]\n   212→    pub decomposer_growth_yield: f64,\n   213→    #[serde(default = \"default_decomposer_decay_rate\")]\n   214→    pub decomposer_decay_rate_per_hour: f64,\n   215→\n   216→    // AOB kinetics\n   217→    #[serde(default = \"default_aob_vmax\")]\n   218→    pub a