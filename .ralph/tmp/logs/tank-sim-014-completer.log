{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017CresJE7sHFuowjCWvEoW7","type":"tool_result","content":"     1→use crate::{\n     2→    systems::temperature::do_sat_mg_l,\n     3→    types::{SimError, SourceWaterProfile, TankState},\n     4→};\n     5→\n     6→pub fn validate_source_profile(state: &TankState, source_profile_id: &str) -> Result<(), SimError> {\n     7→    match state.source_water_catalog.get(source_profile_id) {\n     8→        None => Err(SimError::UnknownSourceProfile {\n     9→            id: source_profile_id.to_string(),\n    10→        }),\n    11→        Some(profile) => profile.validate(source_profile_id),\n    12→    }\n    13→}\n    14→\n    15→/// Validates that all water change actions in the queue reference known and valid source profiles.\n    16→/// Returns the first error found, or Ok(()) if all are valid.\n    17→/// Checks both catalog membership and runtime validity (finite, non-negative chemistry).\n    18→pub fn validate_water_changes(\n    19→    state: &TankState,\n    20→    actions: &[crate::types::PlayerAction],\n    21→) -> Result<(), SimError> {\n    22→    for action in actions {\n    23→        if let crate::types::PlayerAction::WaterChangePercent {\n    24→            source_profile_id, ..\n    25→        } = action\n    26→        {\n    27→            validate_source_profile(state, source_profile_id)?;\n    28→        }\n    29→    }\n    30→    Ok(())\n    31→}\n    32→\n    33→/// Applies a water change: removes `percent/100` of each dissolved total,\n    34→/// then adds replacement mass from the source-water profile using exchanged liters.\n    35→/// Also mixes water temperature proportionally by exchanged volume.\n    36→///\n    37→/// A 0% water change is a no-op.\n    38→pub fn apply_water_change(state: &mut TankState, percent: f64, source: &SourceWaterProfile) {\n    39→    if percent <= 0.0 {\n    40→        return;\n    41→    }\n    42→\n    43→    let volume_l = state.geometry.water_volume_l();\n    44→    let fraction = percent / 100.0;\n    45→    let retention = 1.0 - fraction;\n    46→    let exchanged_l = volume_l * fraction;\n    47→\n    48→    // Remove fraction of each dissolved total\n    49→    state.water.ammonia_total_mg_n_total *= retention;\n    50→    state.water.nitrite_mg_n_total *= retention;\n    51→    state.water.nitrate_mg_n_total *= retention;\n    52→    state.water.phosphate_mg_p_total *= retention;\n    53→    state.water.dissolved_inorganic_carbon_mg_c_total *= retention;\n    54→    state.water.dissolved_organic_carbon_mg_c_total *= retention;\n    55→    state.water.dissolved_organic_nitrogen_mg_n_total *= retention;\n    56→    state.water.dissolved_oxygen_mg_total *= retention;\n    57→    state.water.alkalinity_meq_total *= retention;\n    58→    state.water.calcium_mg_total *= retention;\n    59→    state.water.magnesium_mg_total *= retention;\n    60→    state.water.sodium_mg_total *= retention;\n    61→    state.water.potassium_mg_total *= retention;\n    62→    state.water.bicarbonate_mg_total *= retention;\n    63→    state.water.chloride_mg_total *= retention;\n    64→    state.water.sulfate_mg_total *= retention;\n    65→\n    66→    // Add replacement mass from source water\n    67→    state.water.ammonia_total_mg_n_total += source.ammonia_mg_n_per_l * exchanged_l;\n    68→    state.water.nitrite_mg_n_total += source.nitrite_mg_n_per_l * exchanged_l;\n    69→    state.water.nitrate_mg_n_total += source.nitrate_mg_n_per_l * exchanged_l;\n    70→    state.water.phosphate_mg_p_total += source.phosphate_mg_p_per_l * exchanged_l;\n    71→    state.water.dissolved_inorganic_carbon_mg_c_total += source.dic_mg_c_per_l * exchanged_l;\n    72→    state.water.dissolved_organic_carbon_mg_c_total += source.doc_mg_c_per_l * exchanged_l;\n    73→    state.water.dissolved_organic_nitrogen_mg_n_total += source.don_mg_n_per_l * exchanged_l;\n    74→    state.water.dissolved_oxygen_mg_total += do_sat_mg_l(source.temperature_c) * exchanged_l;\n    75→    state.water.alkalinity_meq_total += source.alkalinity_meq_per_l * exchanged_l;\n    76→    state.water.calcium_mg_total += source.calcium_mg_per_l * exchanged_l;\n    77→    state.water.magnesium_mg_total += source.magnesium_mg_per_l * exchanged_l;\n    78→    state.water.sodium_mg_total += source.sodium_mg_per_l * exchanged_l;\n    79→    state.water.potassium_mg_total += source.potassium_mg_per_l * exchanged_l;\n    80→    state.water.bicarbonate_mg_total += source.bicarbonate_mg_per_l * exchanged_l;\n    81→    state.water.chloride_mg_total += source.chloride_mg_per_l * exchanged_l;\n    82→    state.water.sulfate_mg_total += source.sulfate_mg_per_l * exchanged_l;\n    83→\n    84→    // Mix temperature proportionally by exchanged volume\n    85→    state.water.temperature_c =\n    86→        state.water.temperature_c * retention + source.temperature_c * fraction;\n    87→}\n    88→"}]},"parent_tool_use_id":"toolu_01QF2vsntjDVHcTNrk9CgJR6","session_id":"49fc8440-ef1d-426c-844e-0d9d2eefdcf5","uuid":"e06fbad5-1c61-4270-ae53-340a52c2ef33"}
