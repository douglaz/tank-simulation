napshot.decomposer_biomass_g\n    91→        )),\n    92→    ])\n    93→    .block(Block::default().title(\"Biofilter\").borders(Borders::ALL));\n    94→    frame.render_widget(biofilter, middle[1]);\n    95→\n    96→    let microfauna = Paragraph::new(vec![\n    97→        Line::from(format!(\n    98→            \"Population index {:.2}\",\n    99→            snapshot.microfauna_population_index\n   100→        )),\n   101→        Line::from(format!(\n   102→            \"Grazing pressure {:.2}\",\n   103→            snapshot.microfauna_grazing_pressure_index\n   104→        )),\n   105→        Line::from(format!(\n   106→            \"Filter cleanliness {:.2}\",\n   107→            snapshot.filter_cleanliness_index\n   108→        )),\n   109→        Line::from(format!(\n   110→            \"Aeration {} @ {:.2}\",\n   111→            if snapshot.aeration_enabled {\n   112→                \"on\"\n   113→            } else {\n   114→                \"off\"\n   115→            },\n   116→            snapshot.aeration_intensity\n   117→        )),\n   118→    ])\n   119→    .block(\n   120→        Block::default()\n   121→            .title(\"Microfauna summary\")\n   122→            .borders(Borders::ALL),\n   123→    );\n   124→    frame.render_widget(microfauna, layout[2]);\n   125→}\n   126→"}]},"parent_tool_use_id":"toolu_01Y9ahSmCe1Vce9gb4yRGRh2","session_id":"49fc8440-ef1d-426c-844e-0d9d2eefdcf5","uuid":"29267682-8eb8-42f8-ac77-04c67b2ab3b7"}
