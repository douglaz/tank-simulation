{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BhwoHrMoZyj1YjyaLAzVnZ","type":"tool_result","content":"     1→use crate::types::TankState;\n     2→\n     3→/// DO saturation in mg/L from linear interpolation over the reference table:\n     4→/// 0°C → 14.6, 10°C → 11.3, 20°C → 9.1, 30°C → 7.6\n     5→pub fn do_sat_mg_l(temp_c: f64) -> f64 {\n     6→    const TABLE: [(f64, f64); 4] = [(0.0, 14.6), (10.0, 11.3), (20.0, 9.1), (30.0, 7.6)];\n     7→\n     8→    if temp_c <= TABLE[0].0 {\n     9→        return TABLE[0].1;\n    10→    }\n    11→    if temp_c >= TABLE[TABLE.len() - 1].0 {\n    12→        return TABLE[TABLE.len() - 1].1;\n    13→    }\n    14→\n    15→    for i in 0..TABLE.len() - 1 {\n    16→        let (t0, do0) = TABLE[i];\n    17→        let (t1, do1) = TABLE[i + 1];\n    18→        if temp_c >= t0 && temp_c <= t1 {\n    19→            let frac = (temp_c - t0) / (t1 - t0);\n    20→            return do0 + frac * (do1 - do0);\n    21→        }\n    22→    }\n    23→\n    24→    // Fallback (shouldn't reach here)\n    25→    TABLE[TABLE.len() - 1].1\n    26→}\n    27→\n    28→/// Hourly discrete heat-transfer model.\n    29→///\n    30→/// Updates `state.water.temperature_c` based on ambient temperature, heater,\n    31→/// and tank geometry. Records heater output on `state.hardware.heater.last_output_w`.\n    32→pub fn step_temperature(state: &mut TankState) {\n    33→    let dt_s = 3600.0_f64;\n    34→    let volume_l = state.geometry.water_volume_l();\n    35→    if volume_l <= f64::EPSILON {\n    36→        return;\n    37→    }\n    38→\n    39→    let heat_capacity_j_per_k = volume_l * 4186.0;\n    40→\n    41→    let surface_area_m2 = state.geometry.surface_area_cm2() / 10_000.0;\n    42→    let wall_area_m2 = state.geometry.wall_area_cm2() / 10_000.0;\n    43→    let top_factor = state.geometry.top_exchange_factor();\n    44→\n    45→    let k_surface = state.process_params.k_surface_w_per_m2_k;\n    46→    let k_wall = state.process_params.k_wall_w_per_m2_k;\n    47→\n    48→    let ua_total_w_per_k = (k_surface * surface_area_m2 * top_factor) + (k_wall * wall_area_m2);\n    49→\n    50→    let ambient_temp_c = state.environment.ambient_temp_c;\n    51→    let water_temp_c = state.water.temperature_c;\n    52→\n    53→    let q_ambient_w = ua_total_w_per_k * (ambient_temp_c - water_temp_c);\n    54→\n    55→    // Heater: only fires when enabled and water is below setpoint - deadband/2\n    56→    let q_heater_w = if state.hardware.heater.enabled\n    57→        && water_temp_c\n    58→            < (state.hardware.heater.setpoint_c - state.hardware.heater.deadband_c / 2.0)\n    59→    {\n    60→        (state.hardware.heater.max_watts * state.hardware.heater.efficiency).max(0.0)\n    61→    } else {\n    62→        0.0\n    63→    };\n    64→\n    65→    state.hardware.heater.last_output_w = q_heater_w;\n    66→\n    67→    let delta_temp_c = (q_ambient_w + q_heater_w) * dt_s / heat_capacity_j_per_k;\n    68→    state.water.temperature_c += delta_temp_c;\n    69→}\n    70→\n    71→#[cfg(test)]\n    72→mod tests {\n    73→    use super::*;\n    74→\n    75→    #[test]\n    76→    fn do_sat_boundaries() {\n    77→        assert!((do_sat_mg_l(0.0) - 14.6).abs() < 0.01);\n    78→        assert!((do_sat_mg_l(10.0) - 11.3).abs() < 0.01);\n    79→        assert!((do_sat_mg_l(20.0) - 9.1).abs() < 0.01);\n    80→        assert!((do_sat_mg_l(30.0) - 7.6).abs() < 0.01);\n    81→    }\n    82→\n    83→    #[test]\n    84→    fn do_sat_interpolation() {\n    85→        let mid = do_sat_mg_l(15.0);\n    86→        // Midpoint between 11.3 and 9.1 = 10.2\n    87→        assert!((mid - 10.2).abs() < 0.01);\n    88→    }\n    89→\n    90→    #[test]\n    91→    fn do_sat_clamp() {\n    92→        assert!((do_sat_mg_l(-5.0) - 14.6).abs() < 0.01);\n    93→        assert!((do_sat_mg_l(40.0) - 7.6).abs() < 0.01);\n    94→    }\n    95→}\n    96→"}]},"parent_tool_use_id":"toolu_01QF2vsntjDVHcTNrk9CgJR6","session_id":"49fc8440-ef1d-426c-844e-0d9d2eefdcf5","uuid":"ef8bbdbb-85c2-43d6-9f5b-342ac2b82c45"}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01Fjz3L7R4GmVb8QRckWggv6","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01A1jp86rXntAPCHsz7j9v9q","name":"Read","input":{"file_path":"/root/tank-simulation/crates/tank_core/src/systems/nitrogen_cycle.rs"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":973,"cache_read_input_tokens":14205,"cache_creation":{"ephemeral_5m_input_tokens":973,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":"toolu_01QF2vsntjDVHcTNrk9CgJR6","session_id":"49fc8440-ef1d-426c-844e-0d9d2eefdcf5","uuid":"263773fe-6431-4d21-8566-fbb4e833ce78"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01A1jp86rXntAPCHsz7j9v9q","type":"tool_result","content":"     1→use crate::types::TankState;\n     2→\n     3→const FEED_P_TO_N_MASS_RATIO: f64 = 0.10;\n     4→const ADULT_SHRIMP_BIOMASS_G: f64 = 0.12;\n     5→const JUVENILE_SHRIMP_BIOMASS_G: f64 = 0.05;\n     6→\n     7→/// Result of one hourly nitrogen cycle step, carrying coupling values\n     8→/// that downstream systems (DO, chemistry) need.\n     9→#[derive(Debug, Clone, Copy, Default)]\n    10→pub struct NitrogenCycleOutput {\n    11→    /// Total mg N oxidized to nitrate this tick (AOB + NOB + comammox pathway).\n    12→    pub total_mg_n_nitrified: f64,\n    13→}\n    14→\n    15→/// Monod-style environmental factors shared across guilds.\n    16→struct EnvFactors {\n    17→    f_temp: f64,\n    18→    f_ph: f64,\n    19→    maturity_factor: f64,\n    20→    /// Dirty-filter penalty: 1.0 = clean, lower = clogged/dirty.\n    21→    dirty_filter_factor: f64,\n    22→    filter_enabled_factor: f64,\n    23→    flow_factor: f64,\n    24→}\n    25→\n    26→fn safe_rate(v: f64) -> f64 {\n    27→    if v.is_finite() {\n    28→        v.max(0.0)\n    29→    } else {\n    30→        0.0\n    31→    }\n    32→}\n    33→\n    34→/// Runs the full nitrogen-cycle phase for one hourly tick.\n    35→///\n    36→/// Order: feed leaching -> detritus breakdown/mineralization -> nitrification + guild growth/decay.\n    37→///\n    38→/// Returns coupling values for downstream DO and alkalinity systems.\n    39→pub fn step_nitrogen_cycle(state: &mut TankState) -> NitrogenCycleOutput {\n    40→    let volume_l = state.geometry.water_volume_l();\n    41→    if volume_l <= f64::EPSILON {\n    42→        return NitrogenCycleOutput::default();\n    43→    }\n    44→\n    45→    let pp = &state.process_params;\n    46→\n    47→    // ---- 1. Feed leaching: particulate -> fine detritus ----\n    48→    let trapping_factor =\n    49→        1.0 - (0.5 * state.avg_substrate_index(|layer| layer.detritus_trapping_index));\n    50→    let leach_rate = safe_rate(pp.feed_leach_rate_per_hour * trapping_factor);\n    51→    let leached = (state.detritus.particulate_organics_g_total * leach_rate)\n    52→        .min(state.detritus.particulate_organics_g_total);\n    53→    state.detritus.particulate_organics_g_total -= leached;\n    54→    state.detritus.fine_detritus_g_total += leached;\n    55→\n    56→    // ---- 2. Fine detritus dissolution: fine detritus -> dissolved organic pools ----\n    57→    let diss_rate = safe_rate(pp.fine_detritus_dissolution_rate_per_hour);\n    58→    let dissolved = (state.detritus.fine_detritus_g_total * diss_rate)\n    59→        .min(state.detritus.fine_detritus_g_total);\n    60→    state.detritus.fine_detritus_g_total -= dissolved;\n    61→    // dissolved mass (g) -> mg for dissolved pools: 1 g = 1000 mg\n    62→    // Split into DOC and DON using N:C ratio\n    63→    let n_to_c = safe_rate(pp.feed_n_to_c_ratio);\n    64→    let doc_mg = dissolved * 1000.0 / (1.0 + n_to_c); // carbon fraction\n    65→    let don_mg = doc_mg * n_to_c; // nitrogen fraction\n    66→    let phosphate_mg = don_mg * FEED_P_TO_N_MASS_RATIO;\n    67→    state.water.dissolved_organic_carbon_mg_c_total += doc_mg;\n    68→    state.water.dissolved_organic_nitrogen_mg_n_total += don_mg;\n    69→    // Feed introduces dissolved phosphorus alongside organic C/N, supporting algae pressure.\n    70→    state.water.phosphate_mg_p_total += phosphate_mg;\n    71→    // Track flow through dissolved_feed_residue (bookkeeping, decremented by mineralization)\n    72→    state.detritus.dissolved_feed_residue_g_total += dissolved;\n    73→\n    74→    // ---- 3. Decomposer mineralization: DOC/DON -> TAN ----\n    75→    let decomposer_biomass = state.microbe.decomposer_biomass_g;\n    76→    let doc_total = state.water.dissolved_organic_carbon_mg_c_total;\n    77→    let don_total = state.water.dissolved_organic_nitrogen_mg_n_total;\n    78→    let do_total = state.water.dissolved_oxygen_mg_total;\n    79→\n    80→    // Environmental factors for decomposers\n    81→    let temp = state.water.temperature_c;\n    82→    let f_temp_decomp = temperature_factor(temp);\n    83→    let f_do_decomp = do_total / (do_total + 2.0); // half-sat ~2 mg total\n    84→\n    85→    // Microfauna modestly improve mineralization efficiency\n    86→    let microfauna_boost =\n    87→        1.0 + pp.microfauna_mineralization_boost * state.microfauna.population_index;\n    88→    let decomp_vmax = safe_rate(pp.decomposer_vmax_per_hour) * microfauna_boost;\n    89→    let k_doc = pp.decomposer_k_doc_mg.max(0.01);\n    90→    let monod_doc = doc_total / (doc_total + k_doc);\n    91→\n    92→    let potential_doc_consumed_mg = decomp_vmax * decomposer_biomass * 1000.0 // g->mg conversion for biomass effect\n    93→        * f_temp_decomp * f_do_decomp * monod_doc;\n    94→    let potential_doc_consumed_mg = safe_rate(potential_doc_consumed_mg);\n    95→\n    96→    // Clamp: cannot consume more DOC than exists\n    97→    let doc_consumed_mg = potential_doc_consumed_mg.min(doc_total);\n    98→    // Proportional DON consumed\n    99→    let don_consumed_mg = if doc_total > f64::EPSILON {\n   100→        doc_consumed_mg * (don_total / doc_total)\n   101→    } else {\n   102→        0.0\n   103→    };\n   104→    let don_consumed_mg = don_consumed_mg.min(don_total);\n   105→\n   106→    state.water.dissolved_organic_carbon_mg_c_total -= doc_consumed_mg;\n   107→    state.water.dissolved_organic_nitrogen_mg_n_total -= don_consumed_mg;\n   108→    // Mineralized DON becomes TAN\n   109→    state.water.ammonia_total_mg_n_total += don_consumed_mg;\n   110→    // Track residue pool depletion\n   111→    let residue_consumed_g = doc_consumed_mg / 1000.0 * (1.0 + n_to_c);\n   112→    state.detritus.dissolved_feed_residue_g_total =\n   113→        (state.detritus.dissolved_feed_residue_g_total - residue_consumed_g).max(0.0);\n   114→\n   115→    // Decomposer growth/decay\n   116→    let decomp_growth = safe_rate(pp.decomposer_growth_yield) * doc_consumed_mg / 1000.0; // mg->g\n   117→    let decomp_decay = safe_rate(pp.decomposer_decay_rate_per_hour) * decomposer_biomass;\n   118→    state.microbe.decomposer_biomass_g =\n   119→        (state.microbe.decomposer_biomass_g + decomp_growth - decomp_decay).max(0.0);\n   120→\n   121→    // ---- 4. Nitrification: TAN -> nitrite -> nitrate (+ comammox TAN -> nitrate) ----\n   122→    //\n   123→    // Shared DO and alkalinity budgets enforce that combined nitrification\n   124→    // can never consume more O2 or alkalinity than available this tick.\n   125→    let env = compute_env_factors(state);\n   126→    let combined_env = env.maturity_factor * env.dirty_filter_factor * env.filter_enabled_factor;\n   127→\n   128→    let mut do_budget = state.water.dissolved_oxygen_mg_total;\n   129→    let alk_per_mg_n = safe_rate(pp.alkalinity_meq_per_mg_n_nitrified);\n   130→    let mut alk_budget = state.water.alkalinity_meq_total;\n   131→\n   132→    // Stoichiometric O2 costs per mg N for each guild step\n   133→    let o2_for_aob = 3.43_f64; // TAN -> nitrite\n   134→    let o2_for_comammox = pp.o2_per_mg_n_nitrified; // TAN -> nitrate (4.57)\n   135→    let o2_for_nob = 1.14_f64; // nitrite -> nitrate\n   136→\n   137→    // 4a. AOB: TAN -> nitrite\n   138→    let aob_env_factor =\n   139→        combined_env * env.f_temp * env.f_ph * (do_budget / (do_budget + pp.aob_k_do_mg.max(0.01)));\n   140→    let aob_potential = monod_rate(\n   141→        safe_rate(pp.aob_vmax_mg_n_per_g_per_hour) * env.flow_factor,\n   142→        state.microbe.ammonia_oxidizer_biomass_g,\n   143→        aob_env_factor,\n   144→        state.water.ammonia_total_mg_n_total,\n   145→        pp.aob_k_tan_mg.max(0.01),\n   146→    );\n   147→    let aob_rate = safe_rate(aob_potential)\n   148→        .min(state.water.ammonia_total_mg_n_total)\n   149→        .min(if o2_for_aob > 0.0 {\n   150→            do_budget / o2_for_aob\n   151→        } else {\n   152→            f64::MAX\n   153→        })\n   154→        .min(if alk_per_mg_n > 0.0 {\n   155→            alk_budget / alk_per_mg_n\n   156→        } else {\n   157→            f64::MAX\n   158→        });\n   159→\n   160→    // Debit shared budgets for AOB\n   161→    let aob_o2_cost = aob_rate * o2_for_aob;\n   162→    let aob_alk_cost = aob_rate * alk_per_mg_n;\n   163→    do_budget = (do_budget - aob_o2_cost).max(0.0);\n   164→    alk_budget = (alk_budget - aob_alk_cost).max(0.0);\n   165→\n   166→    // 4b. Comammox: TAN -> nitrate directly (lower vmax)\n   167→    let comammox_vmax =\n   168→        safe_rate(pp.aob_vmax_mg_n_per_g_per_hour * pp.comammox_vmax_fraction) * env.flow_factor;\n   169→    let tan_after_aob = (state.water.ammonia_total_mg_n_total - aob_rate).max(0.0);\n   170→    let comammox_env_factor = combined_env\n   171→        * env.f_temp\n   172→        * env.f_ph\n   173→        * (do_budget / (do_budget + pp.comammox_k_do_mg.max(0.01)));\n   174→    let comammox_potential = monod_rate(\n   175→        comammox_vmax,\n   176→        state.microbe.comammox_biomass_g,\n   177→        comammox_env_factor,\n   178→        tan_after_aob,\n   179→        pp.comammox_k_tan_mg.max(0.01),\n   180→    );\n   181→    let comammox_rate = safe_rate(comammox_potential)\n   182→        .min(tan_after_aob)\n   183→        .min(if o2_for_comammox > 0.0 {\n   184→            do_budget / o2_for_comammox\n   185→        } else {\n   186→            f64::MAX\n   187→        })\n   188→        .min(if alk_per_mg_n > 0.0 {\n   189→            alk_budget / alk_per_mg_n\n   190→        } else {\n   191→            f64::MAX\n   192→        });\n   193→\n   194→    // Debit shared budgets for comammox\n   195→    let comammox_o2_cost = comammox_rate * o2_for_comammox;\n   196→    let comammox_alk_cost = comammox_rate * alk_per_mg_n;\n   197→    do_budget = (do_budget - comammox_o2_cost).max(0.0);\n   198→    alk_budget = (alk_budget - comammox_alk_cost).max(0.0);\n   199→\n   200→    // Apply AOB + comammox TAN consumption\n   201→    let total_tan_consumed = aob_rate + comammox_rate;\n   202→    state.water.ammonia_total_mg_n_total =\n   203→        (state.water.ammonia_total_mg_n_total - total_tan_consumed).max(0.0);\n   204→    // AOB produces nitrite\n   205→    state.water.nitrite_mg_n_total += aob_rate;\n   206→    // Comammox produces nitrate directly\n   207→    state.water.nitrate_mg_n_total += comammox_rate;\n   208→\n   209→    // Apply O2 costs so far (AOB + comammox) to state\n   210→    state.water.dissolved_oxygen_mg_total =\n   211→        (state.water.dissolved_oxygen_mg_total - aob_o2_cost - comammox_o2_cost).max(0.0);\n   212→\n   213→    // 4c. NOB: nitrite -> nitrate (uses remaining DO/alk budget)\n   214→    let nob_env_factor =\n   215→        combined_env * env.f_temp * env.f_ph * (do_budget / (do_budget + pp.nob_k_do_mg.max(0.01)));\n   216→    let nob_potential = monod_rate(\n   217→        safe_rate(pp.nob_vmax_mg_n_per_g_per_hour) * env.flow_factor,\n   218→        state.microbe.nitrite_oxidizer_biomass_g,\n   219→        nob_env_factor,\n   220→        state.water.nitrite_mg_n_total,\n   221→        pp.nob_k_nitrite_mg.max(0.01),\n   222→    );\n   223→    let nob_rate = safe_rate(nob_potential)\n   224→        .min(state.water.nitrite_mg_n_total)\n   225→        .min(if o2_for_nob > 0.0 {\n   226→            do_budget / o2_for_nob\n   227→        } else {\n   228→            f64::MAX\n   229→        })\n   230→        .min(if alk_per_mg_n > 0.0 {\n   231→            alk_budget / alk_per_mg_n\n   232→        } else {\n   233→            f64::MAX\n   234→        });\n   235→\n   236→    let nob_o2_cost = nob_rate * o2_for_nob;\n   237→\n   238→    state.water.nitrite_mg_n_total = (state.water.nitrite_mg_n_total - nob_rate).max(0.0);\n   239→    state.water.nitrate_mg_n_total += nob_rate;\n   240→    state.water.dissolved_oxygen_mg_total =\n   241→        (state.water.dissolved_oxygen_mg_total - nob_o2_cost).max(0.0);\n   242→\n   243→    // Total N fully nitrified to nitrate (for alkalinity coupling)\n   244→    // AOB only takes TAN -> nitrite, NOB takes nitrite -> nitrate, comammox takes TAN -> nitrate\n   245→    // Full pathway N: nob_rate (came from AOB path) + comammox_rate\n   246→    let total_mg_n_nitrified = nob_rate + comammox_rate;\n   247→\n   248→    // ---- 5. Guild growth and decay ----\n   249→    // AOB growth from TAN oxidized\n   250→    let aob_growth = safe_rate(pp.aob_growth_yield) * aob_rate;\n   251→    let aob_decay =\n   252→        safe_rate(pp.aob_decay_rate_per_hour) * state.microbe.ammonia_oxidizer_biomass_g;\n   253→    state.microbe.ammonia_oxidizer_biomass_g =\n   254→        (state.microbe.ammonia_oxidizer_biomass_g + aob_growth - aob_decay).max(0.0);\n   255→\n   256→    // NOB growth from nitrite oxidized\n   257→    let nob_growth = safe_rate(pp.nob_growth_yield) * nob_rate;\n   258→    let nob_decay =\n   259→        safe_rate(pp.nob_decay_rate_per_hour) * state.microbe.nitrite_oxidizer_biomass_g;\n   260→    state.microbe.nitrite_oxidizer_biomass_g =\n   261→        (state.microbe.nitrite_oxidizer_biomass_g + nob_growth - nob_decay).max(0.0);\n   262→\n   263→    // Comammox growth from TAN fully oxidized\n   264→    let comammox_growth = safe_rate(pp.comammox_growth_yield) * comammox_rate;\n   265→    let comammox_decay =\n   266→        safe_rate(pp.comammox_decay_rate_per_hour) * state.microbe.comammox_biomass_g;\n   267→    state.microbe.comammox_biomass_g =\n   268→        (state.microbe.comammox_biomass_g + comammox_growth - comammox_decay).max(0.0);\n   269→\n   270→    // ---- 6. Alkalinity consumption from nitrification ----\n   271→    // AOB and comammox alkalinity was already tracked in the budget; apply the\n   272→    // total consumption (AOB + comammox + NOB path) to state.\n   273→    let total_alk_consumed = (aob_rate + comammox_rate + nob_rate) * alk_per_mg_n;\n   274→    state.water.alkalinity_meq_total =\n   275→        (state.water.alkalinity_meq_total - total_alk_consumed).max(0.0);\n   276→\n   277→    // Nitrification is a chemoautotrophic process that produces some DIC fixation\n   278→    // but for simplicity we model it as a net DIC producer via mineralization pathway above.\n   279→\n   280→    NitrogenCycleOutput {\n   281→        total_mg_n_nitrified,\n   282→    }\n   283→}\n   284→\n   285→/// Temperature factor: peaks around 25-30°C, drops off at extremes.\n   286→fn temperature_factor(temp_c: f64) -> f64 {\n   287→    // Bell-shaped factor peaking at 28°C with a half-width of ~10°C\n   288→    let opt = 28.0;\n   289→    let sigma = 10.0;\n   290→    let diff = temp_c - opt;\n   291→    (-(diff * diff) / (2.0 * sigma * sigma)).exp()\n   292→}\n   293→\n   294→/// pH factor: nitrifiers prefer 7-8, reduced at extremes.\n   295→fn ph_factor(ph: f64) -> f64 {\n   296→    let opt = 7.5;\n   297→    let sigma = 1.5;\n   298→    let diff = ph - opt;\n   299→    (-(diff * diff) / (2.0 * sigma * sigma)).exp()\n   300→}\n   301→\n   302→fn compute_env_factors(state: &TankState) -> EnvFactors {\n   303→    let f_temp = temperature_factor(state.water.temperature_c);\n   304→    let f_ph = ph_factor(state.water.ph);\n   305→\n   306→    // Maturity factor: immature filters slow nitrification\n   307→    let maturity_factor = state.filter_state.biofilter_maturity_index.clamp(0.05, 1.0);\n   308→\n   309→    // Dirty-filter factor: clogged filters reduce nitrification efficiency.\n   310→    // clogging_index of 0 = clean (factor=1), clogging_index of 1 = fully clogged (factor=0.2)\n   311→    let dirty_filter_factor = (1.0 - 0.8 * state.filter_state.clogging_index).clamp(0.2, 1.0);\n   312→    let filter_enabled_factor = if state.hardware.filter.enabled {\n   313→        1.0\n   314→    } else {\n   315→        0.1\n   316→    };\n   317→    let volume_l = state.geometry.water_volume_l().max(f64::EPSILON);\n   318→    let flow_factor = if state.hardware.filter.enabled {\n   319→        (state.hardware.filter.flow_lph / volume_l).clamp(0.1, 1.0)\n   320→    } else {\n   321→        1.0\n   322→    };\n   323→\n   324→    EnvFactors {\n   325→        f_temp,\n   326→        f_ph,\n   327→        maturity_factor,\n   328→        dirty_filter_factor,\n   329→        filter_enabled_factor,\n   330→        flow_factor,\n   331→    }\n   332→}\n   333→\n   334→/// Monod-style rate: vmax * biomass * environmental_factor * S/(K+S)\n   335→fn monod_rate(\n   336→    vmax: f64,\n   337→    biomass_g: f64,\n   338→    environmental_factor: f64,\n   339→    substrate: f64,\n   340→    k_substrate: f64,\n   341→) -> f64 {\n   342→    let monod = substrate / (substrate + k_substrate);\n   343→    safe_rate(vmax * biomass_g * environmental_factor * monod)\n   344→}\n   345→\n   346→/// Daily biofilter maturity update. Called every 24 ticks.\n   347→/// Recomputes `filter_state.biofilter_maturity_index` from guild biomass.\n   348→pub fn update_daily_biofilter_maturity(state: &mut TankState) -> f64 {\n   349→    let prev = state.filter_state.biofilter_maturity_index;\n   350→\n   351→    // Capacity reference: a \"mature\" biofilter might have ~0.5g total nitrifier biomass\n   352→    let capacity_g = 0.5;\n   353→    let total_nitrifier_g = state.microbe.ammonia_oxidizer_biomass_g\n   354→        + state.microbe.nitrite_oxidizer_biomass_g\n   355→        + state.microbe.comammox_biomass_g;\n   356→    let raw_maturity = (total_nitrifier_g / capacity_g).clamp(0.0, 1.0);\n   357→\n   358→    // Smooth towards raw_maturity\n   359→    let alpha = 0.1;\n   360→    let new_maturity = (prev + alpha * (raw_maturity - prev)).clamp(0.0, 1.0);\n   361→    state.filter_state.biofilter_maturity_index = new_maturity;\n   362→\n   363→    new_maturity - prev\n   364→}\n   365→\n   366→pub fn update_daily_filter_clogging(state: &mut TankState) -> f64 {\n   367→    if !state.hardware.filter.enabled {\n   368→        return 0.0;\n   369→    }\n   370→\n   371→    let volume_l = state.geometry.water_volume_l();\n   372→    if volume_l <= f64::EPSILON {\n   373→        return 0.0;\n   374→    }\n   375→\n   376→    let fine_detritus_g_l = state.detritus.fine_detritus_g_total / volume_l;\n   377→    let particulate_detritus_g_l = state.detritus.particulate_organics_g_total / volume_l;\n   378→    let dissolved_residue_g_l = state.detritus.dissolved_feed_residue_g_total / volume_l;\n   379→    let detritus_pressure =\n   380→        (fine_detritus_g_l + (0.35 * particulate_detritus_g_l) + (0.25 * dissolved_residue_g_l))\n   381→            .clamp(0.0, 2.0);\n   382→    let shrimp_biomass_g = (f64::from(state.animal.adults_count) * ADULT_SHRIMP_BIOMASS_G)\n   383→        + (f64::from(state.animal.juveniles_count) * JUVENILE_SHRIMP_BIOMASS_G);\n   384→    let bioload_pressure = (shrimp_biomass_g / volume_l).clamp(0.0, 1.0);\n   385→\n   386→    let cleanliness_before = state.hardware.filter.cleanliness_index.clamp(0.0, 1.0);\n   387→    let cleanliness_decay =\n   388→        ((0.03 * detritus_pressure) + (0.004 * bioload_pressure)).clamp(0.0, 0.08);\n   389→    state.hardware.filter.cleanliness_index =\n   390→        (cleanliness_before - cleanliness_decay).clamp(0.0, 1.0);\n   391→\n   392→    let clogging_delta = (cleanliness_decay * (0.4 + (0.6 * cleanliness_before))).clamp(0.0, 1.0);\n   393→\n   394→    state.filter_state.clogging_index =\n   395→        (state.filter_state.clogging_index + clogging_delta).clamp(0.0, 1.0);\n   396→\n   397→    clogging_delta\n   398→}\n   399→"}]},"parent_tool_use_id":"toolu_01QF2vsntjDVHcTNrk9CgJR6","session_id":"49fc8440-ef1d-426c-844e-0d9d2eefdcf5","uuid":"03e32d13-4ee2-48db-835e-8721f4213d8b"}
