{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0153pvpdqSJDUBNr14taZ9iF","type":"tool_result","content":"     1→use serde::{Deserialize, Serialize};\n     2→\n     3→use crate::types::substrate::SubstrateLayerState;\n     4→\n     5→/// A cohort of berried females that became berried on the same day.\n     6→/// Separate cohorts ensure that only completed clutches resolve,\n     7→/// preserving the clutch-resolution invariant.\n     8→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n     9→pub struct EggCohort {\n    10→    pub count: u32,\n    11→    pub progress_days: f64,\n    12→}\n    13→\n    14→#[derive(Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq)]\n    15→pub enum PlantGuild {\n    16→    FastStem,\n    17→    RootFeedingRosette,\n    18→}\n    19→\n    20→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    21→pub struct PlantGuildState {\n    22→    pub guild: PlantGuild,\n    23→    pub biomass_g: f64,\n    24→    pub health_index: f64,\n    25→    pub crowding_index: f64,\n    26→    pub habitat_index: f64,\n    27→}\n    28→\n    29→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    30→pub struct AlgaeState {\n    31→    pub suspended_biomass_g: f64,\n    32→    pub periphyton_biomass_g: f64,\n    33→    pub nuisance_index: f64,\n    34→}\n    35→\n    36→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    37→pub struct MicrobeState {\n    38→    pub decomposer_biomass_g: f64,\n    39→    pub ammonia_oxidizer_biomass_g: f64,\n    40→    pub nitrite_oxidizer_biomass_g: f64,\n    41→    pub comammox_biomass_g: f64,\n    42→    pub maturity_index: f64,\n    43→}\n    44→\n    45→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    46→pub struct MicrofaunaState {\n    47→    pub population_index: f64,\n    48→    pub grazing_pressure_index: f64,\n    49→}\n    50→\n    51→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    52→pub struct AnimalState {\n    53→    pub adults_count: u32,\n    54→    pub juveniles_count: u32,\n    55→    pub berried_females_count: u32,\n    56→    pub condition_index: f64,\n    57→    pub molt_stress_index: f64,\n    58→    pub reproductive_readiness_index: f64,\n    59→    pub egg_progress_days: f64,\n    60→    /// Per-cohort egg tracking for clutch-resolution invariant.\n    61→    #[serde(default)]\n    62→    pub egg_cohorts: Vec<EggCohort>,\n    63→    /// Hidden hourly stress accumulators, reset after daily processing.\n    64→    #[serde(default)]\n    65→    pub hourly_nh3_stress_accum: f64,\n    66→    #[serde(default)]\n    67→    pub hourly_nitrite_stress_accum: f64,\n    68→    #[serde(default)]\n    69→    pub hourly_low_do_stress_accum: f64,\n    70→    #[serde(default)]\n    71→    pub hourly_heat_stress_accum: f64,\n    72→    #[serde(default)]\n    73→    pub hourly_instability_stress_accum: f64,\n    74→    #[serde(default)]\n    75→    pub daily_food_consumed_g: f64,\n    76→}\n    77→\n    78→/// Species-specific shrimp parameters materialized from ShrimpPreset.\n    79→/// Stored in TankState for deterministic save/load.\n    80→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    81→pub struct ShrimpRuntimeParams {\n    82→    pub optimal_temp_min_c: f64,\n    83→    pub optimal_temp_max_c: f64,\n    84→    pub gh_min_d: f64,\n    85→    pub gh_max_d: f64,\n    86→    pub base_spawn_rate: f64,\n    87→    pub egg_duration_days: u32,\n    88→    pub hatch_success_base: f64,\n    89→    pub juvenile_sensitivity: f64,\n    90→    pub high_temp_repro_penalty_start_c: f64,\n    91→    pub high_temp_repro_penalty_full_c: f64,\n    92→}\n    93→\n    94→/// Tracks recent chemistry swings for shrimp stress calculations.\n    95→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    96→pub struct StabilityTracker {\n    97→    pub prev_temp_c: f64,\n    98→    pub prev_ph: f64,\n    99→    pub prev_gh_d: f64,\n   100→    pub prev_do_mg_l: f64,\n   101→    pub instability_index: f64,\n   102→}\n   103→\n   104→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n   105→pub struct DetritusState {\n   106→    pub particulate_organics_g_total: f64,\n   107→    pub fine_detritus_g_total: f64,\n   108→    pub dissolved_feed_residue_g_total: f64,\n   109→}\n   110→\n   111→impl Default for PlantGuildState {\n   112→    fn default() -> Self {\n   113→        Self {\n   114→            guild: PlantGuild::FastStem,\n   115→            biomass_g: 5.0,\n   116→            health_index: 0.8,\n   117→            crowding_index: 0.1,\n   118→            habitat_index: 0.8,\n   119→        }\n   120→    }\n   121→}\n   122→\n   123→impl Default for AlgaeState {\n   124→    fn default() -> Self {\n   125→        Self {\n   126→            suspended_biomass_g: 0.0,\n   127→            periphyton_biomass_g: 0.2,\n   128→            nuisance_index: 0.1,\n   129→        }\n   130→    }\n   131→}\n   132→\n   133→impl Default for MicrobeState {\n   134→    fn default() -> Self {\n   135→        Self {\n   136→            decomposer_biomass_g: 0.1,\n   137→            ammonia_oxidizer_biomass_g: 0.05,\n   138→            nitrite_oxidizer_biomass_g: 0.05,\n   139→            comammox_biomass_g: 0.01,\n   140→            maturity_index: 0.1,\n   141→        }\n   142→    }\n   143→}\n   144→\n   145→impl Default for MicrofaunaState {\n   146→    fn default() -> Self {\n   147→        Self {\n   148→            population_index: 0.2,\n   149→            grazing_pressure_index: 0.2,\n   150→        }\n   151→    }\n   152→}\n   153→\n   154→impl Default for AnimalState {\n   155→    fn default() -> Self {\n   156→        Self {\n   157→            adults_count: 0,\n   158→            juveniles_count: 0,\n   159→            berried_females_count: 0,\n   160→            condition_index: 0.8,\n   161→            molt_stress_index: 0.1,\n   162→            reproductive_readiness_index: 0.4,\n   163→            egg_progress_days: 0.0,\n   164→            egg_cohorts: Vec::new(),\n   165→            hourly_nh3_stress_accum: 0.0,\n   166→            hourly_nitrite_stress_accum: 0.0,\n   167→            hourly_low_do_stress_accum: 0.0,\n   168→            hourly_heat_stress_accum: 0.0,\n   169→            hourly_instability_stress_accum: 0.0,\n   170→            daily_food_consumed_g: 0.0,\n   171→        }\n   172→    }\n   173→}\n   174→\n   175→impl Default for ShrimpRuntimeParams {\n   176→    fn default() -> Self {\n   177→        Self {\n   178→            optimal_temp_min_c: 22.0,\n   179→            optimal_temp_max_c: 26.0,\n   180→            gh_min_d: 5.0,\n   181→            gh_max_d: 10.0,\n   182→            base_spawn_rate: 0.15,\n   183→            egg_duration_days: 21,\n   184→            hatch_success_base: 0.7,\n   185→            juvenile_sensitivity: 1.5,\n   186→            high_temp_repro_penalty_start_c: 28.0,\n   187→            high_temp_repro_penalty_full_c: 33.0,\n   188→        }\n   189→    }\n   190→}\n   191→\n   192→impl Default for StabilityTracker {\n   193→    fn default() -> Self {\n   194→        Self {\n   195→            prev_temp_c: 25.0,\n   196→            prev_ph: 7.0,\n   197→            prev_gh_d: 7.0,\n   198→            prev_do_mg_l: 8.0,\n   199→            instability_index: 0.0,\n   200→        }\n   201→    }\n   202→}\n   203→\n   204→impl Default for DetritusState {\n   205→    fn default() -> Self {\n   206→        Self {\n   207→            particulate_organics_g_total: 0.0,\n   208→            fine_detritus_g_total: 0.0,\n   209→            dissolved_feed_residue_g_total: 0.0,\n   210→        }\n   211→    }\n   212→}\n   213→\n   214→impl PlantGuildState {\n   215→    pub fn water_column_uptake_bias(&self) -> f64 {\n   216→        match self.guild {\n   217→            PlantGuild::FastStem => 0.9,\n   218→            PlantGuild::RootFeedingRosette => 0.1,\n   219→        }\n   220→    }\n   221→\n   222→    pub fn substrate_uptake_bias(&self) -> f64 {\n   223→        match self.guild {\n   224→            PlantGuild::FastStem => 0.1,\n   225→            PlantGuild::RootFeedingRosette => 0.9,\n   226→        }\n   227→    }\n   228→}\n   229→\n   230→impl AnimalState {\n   231→    pub fn with_adults(adults_count: u32) -> Self {\n   232→        Self {\n   233→            adults_count,\n   234→            ..Self::default()\n   235→        }\n   236→    }\n   237→\n   238→    /// Ensures `berried_females_count <= adults_count` by trimming\n   239→    /// excess from the newest egg cohorts first.\n   240→    pub fn clamp_berried_to_adults(&mut self) {\n   241→        if self.berried_females_count > self.adults_count {\n   242→            let excess = self.berried_females_count - self.adults_count;\n   243→            self.berried_females_count = self.adults_count;\n   244→            trim_egg_cohorts(&mut self.egg_cohorts, excess);\n   245→        }\n   246→    }\n   247→\n   248→    /// Derives `egg_progress_days` from the most-advanced cohort for display.\n   249→    pub fn sync_egg_progress_from_cohorts(&mut self) {\n   250→        self.egg_progress_days = self\n   251→            .egg_cohorts\n   252→            .iter()\n   253→            .map(|c| c.progress_days)\n   254→            .fold(0.0_f64, f64::max);\n   255→    }\n   256→}\n   257→\n   258→/// Trims `to_remove` berried females from cohorts, starting from the newest (last).\n   259→fn trim_egg_cohorts(cohorts: &mut Vec<EggCohort>, mut to_remove: u32) {\n   260→    while to_remove > 0 && !cohorts.is_empty() {\n   261→        let last = cohorts.last_mut().unwrap();\n   262→        if last.count <= to_remove {\n   263→            to_remove -= last.count;\n   264→            cohorts.pop();\n   265→        } else {\n   266→            last.count -= to_remove;\n   267→            to_remove = 0;\n   268→        }\n   269→    }\n   270→}\n   271→\n   272→pub fn total_colonizable_area_cm2(\n   273→    substrate_layers: &[SubstrateLayerState],\n   274→    wall_area_cm2: f64,\n   275→) -> f64 {\n   276→    wall_area_cm2\n   277→        + substrate_layers\n   278→            .iter()\n   279→            .map(|layer| layer.colonizable_area_cm2)\n   280→            .sum::<f64>()\n   281→}\n   282→"}]},"parent_tool_use_id":"toolu_01Qdcfv7DaocTkCDkaaotRov","session_id":"49fc8440-ef1d-426c-844e-0d9d2eefdcf5","uuid":"bfec78da-5e98-4b55-b000-871a8dee56b5"}
