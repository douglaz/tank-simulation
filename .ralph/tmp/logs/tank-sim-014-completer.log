p_config(terminal)? else {\n    46→        return Ok(());\n    47→    };\n    48→\n    49→    let scenario =\n    50→        load_named_scenario(selection.scenario_id()).context(\"failed to load scenario\")?;\n    51→    let seed = SimSeed(seed_from_clock());\n    52→    let state = seeded_state_with_full_overrides(\n    53→        seed,\n    54→        selection.scenario_id(),\n    55→        selection.startup_overrides(),\n    56→    )\n    57→    .context(\"failed to materialize selected scenario\")?;\n    58→    let scenario_label = format!(\n    59→        \"{} · {} · fill {} · {} shrimp\",\n    60→        scenario.name,\n    61→        selection.size_preset().label,\n    62→        selection.fill_preset().label,\n    63→        selection.initial_shrimp_count\n    64→    );\n    65→    let save_file_path = default_save_path(selection.scenario_id());\n    66→    let engine = Engine::from_parts(state, vec![]);\n    67→    let mut app = TuiApp::new(engine, save_file_path, scenario_label);\n    68→\n    69→    loop {\n    70→        app.clear_expired_status();\n    71→        terminal\n    72→            .draw(|frame| app.render(frame))\n    73→            .context(\"failed to render TUI frame\")?;\n    74→\n    75→        if event::poll(AUTO_ADVANCE_INTERVAL).context(\"failed to poll for events\")? {\n    76→            if let Event::Key(key) = event::read().context(\"failed to read terminal event\")? {\n    77→                if key.kind == KeyEventKind::Press\n    78→                    && handle_key_event(&mut app, key) == InputOutcome::Quit\n    79→                {\n    80→                    break;\n    81→                }\n    82→            }\n    83→        } else if app.auto_advance {\n    84→            app.step_hours(1);\n    85→        }\n    86→    }\n    87→\n    88→    Ok(())\n    89→}\n    90→\n    91→fn restore_terminal(terminal: &mut Terminal<CrosstermBackend<Stdout>>) -> anyhow::Result<()> {\n    92→    disable_raw_mode().context(\"failed to disable raw mode\")?;\n    93→    execute!(terminal.backend_mut(), LeaveAlternateScreen)\n    94→        .context(\"failed to leave alternate screen\")?;\n    95→    terminal.show_cursor().context(\"failed to show cursor\")?;\n    96→    Ok(())\n    97→}\n    98→\n    99→fn default_save_path(scenario_id: &str) -> PathBuf {\n   100→    std::env::current_dir()\n   101→        .unwrap_or_else(|_| PathBuf::from(\".\"))\n   102→        .join(format!(\"{scenario_id}-save.json\"))\n   103→}\n   104→\n   105→fn seed_from_clock() -> u64 {\n   106→    SystemTime::now()\n   107→        .duration_since(UNIX_EPOCH)\n   108→        .unwrap_or(Duration::from_secs(0))\n   109→        .as_secs()\n   110→}\n   111→\n   112→#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n   113→enum SelectionField {\n   114→    Scenario,\n   115→    Size,\n   116→    Fill,\n   117→    SourceWater,\n   118→    Substrate,\n   119→    Plants,\n   120→    Filter,\n   121→    Light,\n   122→    Heater,\n   123→    Aeration,\n   124→    ShrimpCount,\n   125→    Launch,\n   126→}\n   127→\n   128→impl SelectionField {\n   129→    const ALL: [Self; 12] = [\n   130→        Self::Scenario,\n   131→        Self::Size,\n   132→        Self::Fill,\n   133→        Self::SourceWater,\n   134→        Self::Substrate,\n   135→        Self::Plants,\n   136→        Self::Filter,\n   137→        Self::Light,\n   138→        Self::Heater,\n   139→        Self::Aeration,\n   140→        Self::ShrimpCount,\n   141→        Self::Launch,\n   142→    ];\n   143→\n   144→    fn next(self) -> Self {\n   145→        let index = Self::ALL\n   146→            .iter()\n   147→            .position(|field| *field == self)\n   148→            .unwrap_or(0);\n   149→        Self::ALL[(index + 1) % Self::ALL.len()]\n   150→    }\n   151→\n   152→    fn previous(self) -> Self {\n   153→        let index = Self::ALL\n   154→            .iter()\n   155→            .position(|field| *field == self)\n   156→            .unwrap_or(0);\n   157→        Self::ALL[(index + Self::ALL.len() - 1) % Self::ALL.len()]\n   158→    }\n   159→}\n   160→\n   161→#[derive(Debug, Clone, PartialEq)]\n   162→struct StartupSelection {\n   163→    scenario_index: usize,\n   164→    size_index: usize,\n   165→    fill_index: usize,\n   166→    source_water_id: String,\n   167→    substrate_preset: StartupSubstratePreset,\n   168→    plant_selection: StartupPlantSelection,\n   169→    filter_enabled: bool,\n   170→    light_preset: StartupLightPreset,\n   171→    heater_preset: StartupHeaterPreset,\n   172→    aeration_enabled: bool,\n   173→    initial_shrimp_count: u32,\n   174→    field: SelectionField,\n   175→}\n   176→\n   177→impl Default for StartupSelection {\n   178→    fn default() -> Self {\n   179→        let mut selection = Self {\n   180→            scenario_index: 0,\n   181→            size_index: 1,\n   182→            fill_index: 1,\n   183→            source_water_id: String::new(),\n   184→            substrate_preset: StartupSubstratePreset::InertSand,\n   185→            plant_selection: StartupPlantSelection::FastStemOnly,\n   186→            filter_enabled: true,\n   187→            light_preset: StartupLightPreset::Hours8,\n   188→            heater_preset: StartupHeaterPreset::Off,\n   189→            aeration_enabled: false,\n   190→            initial_shrimp_count: 0,\n   191→            field: SelectionField::Scenario,\n   192→        };\n   193→        selection\n   194→            .reset_template_fields()\n   195→            .expect(\"default startup scenario should load\");\n   196→        selection\n   197→    }\n   198→}\n   199→\n   200→fn cycle_choice<T: Copy + PartialEq>(current: &mut T, options: &[T], forward: bool) {\n   201→    let index = options\n   202→        .iter()\n   203→        .position(|option| *option == *current)\n   204→        .unwrap_or(0);\n   205→    let next_index = if forward {\n   206→        (index + 1) % options.len()\n   207→    } else {\n   208→        (index + options.len() - 1) % options.len()\n   209→    };\n   210→    *current = options[next_index];\n   211→}\n   212→\n   213→fn on_off(enabled: bool) -> &'static str {\n   214→    if enabled {\n   215→        \"On\"\n   216→    } else {\n   217→        \"Off\"\n   218→    }\n   219→}\n   220→\n   221→fn source_water_label(id: &str) -> String {\n   222→    id.replace('_', \" \")\n   223→}\n   224→\n   225→impl StartupSelection {\n   226→    fn reset_template_fields(&mut self) -> anyhow::Result<()> {\n   227→        let defaults = startup_defaults_for_scenario(self.scenario_id()).with_context(|| {\n   228→            format!(\"failed to load startup defaults for {}\", self.scenario_id())\n   229→        })?;\n   230→\n   231→        self.source_water_id = defaults\n   232→            .source_water_profile_id\n   233→            .unwrap_or_else(|| \"moderate\".to_string());\n   234→        self.substrate_preset = defaults\n   235→            .substrate_preset\n   236→            .unwrap_or(StartupSubstratePreset::InertSand);\n   237→        self.plant_selection = defaults\n   238→            .plant_selection\n   239→            .unwrap_or(StartupPlantSelection::FastStemOnly);\n   240→        self.filter_enabled = defaults.filter_enabled.unwrap_or(true);\n   241→        self.light_preset = defaults.light_preset.unwrap_or(StartupLightPreset::Hours8);\n   242→        self.heater_preset = defaults.heater_preset.unwrap_or(StartupHeaterPreset::Off);\n   243→        self.aeration_enabled = defaults.aeration_enabled.unwrap_or(false);\n   244→        self.initial_shrimp_count = defaults.initial_adult_shrimp_count.unwrap_or(0);\n   245→        Ok(())\n   246→    }\n   247→\n   248→    fn set_scenario_index(&mut self, scenario_index: usize) -> anyhow::Result<()> {\n   249→        self.scenario_index = scenario_index;\n   250→        self.reset_template_fields()\n   251→    }\n   252→\n   253→    fn startup_overrides(&self) -> StartupOverrides {\n   254→        StartupOverrides {\n   255→            geometry: tank_scenarios::ScenarioGeometryOverrides {\n   256→                size_scale: self.size_preset().size_scale,\n   257→                fill_ratio: self.fill_preset().fill_ratio,\n   258→            },\n   259→            source_water_profile_id: Some(self.source_water_id.clone()),\n   260→            substrate_preset: Some(self.substrate_preset),\n   261→            plant_selection: Some(self.plant_selection),\n   262→            filter_enabled: Some(self.filter_enabled),\n   263→            light_preset: Some(self.light_preset),\n   264→            heater_preset: Some(self.heater_preset),\n   265→            aeration_enabled: Some(self.aeration_enabled),\n   266→            initial_adult_shrimp_count: Some(self.initial_shrimp_count),\n   267→        }\n   268→    }\n   269→\n   270→    fn effective_geometry(\n   271→        &self,\n   272→        tank_length_cm: f64,\n   273→        tank_width_cm: f64,\n   274→        tank_height_cm: f64,\n   275→        fill_height_cm: f64,\n   276→    ) -> TankGeometry {\n   277→        let size_scale = self.size_preset().size_scale;\n   278→        let length_cm = tank_length_cm * size_scale;\n   279→        let width_cm = tank_width_cm * size_scale;\n   280→        let height_cm = tank_height_cm * size_scale;\n   281→        let fill_height_cm =\n   282→            (fill_height_cm * size_scale * self.fill_preset().fill_ratio).min(height_cm);\n   283→        TankGeometry {\n   284→            length_cm,\n   285→            width_cm,\n   286→            height_cm,\n   287→            fill_height_cm,\n   288→            glass_thickness_mm: 5.0,\n   289→            open_top: true,\n   290→            lid_exchange_factor: 0.25,\n   291→        }\n   292→    }\n   293→\n   294→    fn scenario_id(&self) -> &'static str {\n   295→        tank_scenarios::default_scenario_ids()[self.scenario_index]\n   296→    }\n   297→\n   298→    fn size_preset(&self) -> tank_tui::TankSizePreset {\n   299→        TANK_SIZE_PRESETS[self.size_index]\n   300→    }\n   301→\n   302→    fn fill_preset(&self) -> tank_tui::FillPreset {\n   303→        FILL_PRESETS[self.fill_index]\n   304→    }\n   305→\n   306→    fn next_field(&mut self) {\n   307→        self.field = self.field.next();\n   308→    }\n   309→\n   310→    fn previous_field(&mut self) {\n   311→        self.field = self.field.previous();\n   312→    }\n   313→\n   314→    fn adjust_left(&mut self) -> anyhow::Result<()> {\n   315→        match self.field {\n   316→            SelectionField::Scenario => {\n   317→                let options = tank_scenarios::default_scenario_ids();\n   318→                let next_index = (self.scenario_index + options.len() - 1) % options.len();\n   319→                self.set_scenario_index(next_index)?;\n   320→            }\n   321→            SelectionField::Size => {\n   322→                self.size_index =\n   323→                    (self.size_index + TANK_SIZE_PRESETS.len() - 1) % TANK_SIZE_PRESETS.len();\n   324→            }\n   325→            SelectionField::Fill => {\n   326→                self.fill_index = (self.fill_index + FILL_PRESETS.len() - 1) % FILL_PRESETS.len();\n   327→            }\n   328→            SelectionField::SourceWater => {\n   329→                let options = startup_source_water_ids();\n   330→                let current_index = options\n   331→                    .iter()\n   332→                    .position(|id| *id == self.source_water_id)\n   333→                    .unwrap_or(0);\n   334→                let next_index = (current_index + options.len() - 1) % options.len();\n   335→                self.source_water_id = options[next_index].to_string();\n   336→            }\n   337→            SelectionField::Substrate => {\n   338→                cycle_choice(\n   339→                    &mut self.substrate_preset,\n   340→                    &StartupSubstratePreset::ALL,\n   341→                    false,\n   342→                );\n   343→            }\n   344→            SelectionField::Plants => {\n   345→                cycle_choice(\n   346→                    &mut self.plant_selection,\n   347→                    &StartupPlantSelection::ALL,\n   348→                    false,\n   349→                );\n   350→            }\n   351→            SelectionField::Filter => self.filter_enabled = !self.filter_enabled,\n   352→            SelectionField::Light => {\n   353→                cycle_choice(&mut self.light_preset, &StartupLightPreset::ALL, false);\n   354→            }\n   355→            SelectionField::Heater => {\n   356→                cycle_choice(&mut self.heater_preset, &StartupHeaterPreset::ALL, false);\n   357→            }\n   358→            SelectionField::Aeration => self.aeration_enabled = !self.aeration_enabled,\n   359→            SelectionField::ShrimpCount => {\n   360→                cycle_choice(\n   361→                    &mut self.initial_shrimp_count,\n   362→                    &STARTUP_SHRIMP_COUNTS,\n   363→                    false,\n   364→                );\n   365→            }\n   366→            SelectionField::Launch => {}\n   367→        }\n   368→        Ok(())\n   369→    }\n   370→\n   371→    fn adjust_right(&mut self) -> anyhow::Result<()> {\n   372→        match self.field {\n   373→            SelectionField::Scenario => {\n   374→                let next_index =\n   375→                    (self.scenario_index + 1) % tank_scenarios::default_scenario_ids().len();\n   376→                self.set_scenario_index(next_index)?;\n   377→            }\n   378→            SelectionField::Size => {\n   379→                self.size_index = (self.size_index + 1) % TANK_SIZE_PRESETS.len();\n   380→            }\n   381→            SelectionField::Fill => {\n   382→                self.fill_index = (self.fill_index + 1) % FILL_PRESETS.len();\n   383→            }\n   384→            SelectionField::SourceWater => {\n   385→                let options = startup_source_water_ids();\n   386→                let current_index = options\n   387→                    .iter()\n   388→                    .position(|id| *id == self.source_water_id)\n   389→                    .unwrap_or(0);\n   390→                let next_index = (current_index + 1) % options.len();\n   391→                self.source_water_id = options[next_index].to_string();\n   392→            }\n   393→            SelectionField::Substrate => {\n   394→                cycle_choice(\n   395→                    &mut self.substrate_preset,\n   396→                    &StartupSubstratePreset::ALL,\n   397→                    true,\n   398→                );\n   399→            }\n   400→            SelectionField::Plants => {\n   401→                cycle_choice(&mut self.plant_selection, &StartupPlantSelection::ALL, true);\n   402→            }\n   403→            SelectionField::Filter => self.filter_enabled = !self.filter_enabled,\n   404→            SelectionField::Light => {\n   405→                cycle_choice(&mut self.light_preset, &StartupLightPreset::ALL, true);\n   406→            }\n   407→            SelectionField::Heater => {\n   408→                cycle_choice(&mut self.heater_preset, &StartupHeaterPreset::ALL, true);\n   409→            }\n   410→            SelectionField::Aeration => self.aeration_enabled = !self.aeration_enabled,\n   411→            SelectionField::ShrimpCount => {\n   412→                cycle_choice(&mut self.initial_shrimp_count, &STARTUP_SHRIMP_COUNTS, true);\n   413→            }\n   414→            SelectionField::Launch => {}\n   415→        }\n   416→        Ok(())\n   417→    }\n   418→}\n   419→\n   420→fn select_startup_config(\n   421→    terminal: &mut Terminal<CrosstermBackend<Stdout>>,\n   422→) -> anyhow::Result<Option<StartupSelection>> {\n   423→    let mut selection = StartupSelection::default();\n   424→\n   425→    loop {\n   426→        terminal.draw(|frame| render_startup(frame, &selection))?;\n   427→\n   428→        if let Event::Key(key) = event::read().context(\"failed to read selection input\")? {\n   429→            if key.kind != KeyEventKind::Press {\n   430→                continue;\n   431→            }\n   432→\n   433→            match key.code {\n   434→                KeyCode::Char('q') => return Ok(None),\n   435→                KeyCode::Up => selection.previous_field(),\n   436→                KeyCode::Down => selection.next_field(),\n   437→                KeyCode::Left => selection.adjust_left()?,\n   438→                KeyCode::Right => selection.adjust_right()?,\n   439→                KeyCode::Enter if selection.field == SelectionField::Launch => {\n   440→                    return Ok(Some(selection));\n   441→                }\n   442→                KeyCode::Enter => selection.next_field(),\n   443→                _ => {}\n   444→            }\n   445→        }\n   446→    }\n   447→}\n   448→\n   449→fn render_startup(frame: &mut Frame<'_>, selection: &StartupSelection) {\n   450→    let area = centered_rect(frame.size(), 92, 88);\n   451→    let layout = Layout::vertical([\n   452→        Constraint::Length(4),\n   453→        Constraint::Min(16),\n   454→        Constraint::Length(3),\n   455→    ])\n   456→    .split(area);\n   457→    let body = Layout::horizontal([Constraint::Percentage(45), Constraint::Percentage(55)])\n   458→        .split(layout[1]);\n   459→\n   460→    let header = Paragraph::new(vec![\n   461→        Line::from(Span::styled(\n   462→            \"Tank Sim terminal UI\",\n   463→            Style::default()\n   464→                .fg(Color::Cyan)\n   465→                .add_modifier(Modifier::BOLD),\n   466→        )),\n   467→        Line::from(\n   468→            \"Choose a scenario template, then override water, planting, hardware, and starting stock.\",\n   469→        ),\n   470→    ])\n   471→    .block(Block::default().title(\"Startup\").borders(Borders::ALL));\n   472→    frame.render_widget(header, layout[0]);\n   473→\n   474→    let scenario = load_named_scenario(selection.scenario_id()).ok();\n   475→    let fields = vec![\n   476→        startup_item(\n   477→            selection.field == SelectionField::Scenario,\n   478→            \"Scenario\",\n   479→            scenario\n   480→                .as_ref()\n   481→                .map(|item| format!(\"{} ({})\", item.name, item.id))\n   482→                .unwrap_or_else(|| selection.scenario_id().to_string()),\n   483→        ),\n   484→        startup_item(\n   485→            selection.field == SelectionField::Size,\n   486→            \"Tank size\",\n   487→            selection.size_preset().label.to_string(),\n   488→        ),\n   489→        startup_item(\n   490→            selection.field == SelectionField::Fill,\n   491→            \"Fill height\",\n   492→            selection.fill_preset().label.to_string(),\n   493→        ),\n   494→        startup_item(\n   495→            selection.field == SelectionField::SourceWater,\n   496→            \"Source water\",\n   497→            selection.source_water_id.clone(),\n   498→        ),\n   499→        startup_item(\n   500→            selection.field == SelectionField::Substrate,\n   501→            \"Substrate\",\n   502→            selection.substrate_preset.label().to_string(),\n   503→        ),\n   504→        startup_item(\n   505→            selection.field == SelectionField::Plants,\n   506→            \"Plants\",\n   507→            selection.plant_selection.label().to_string(),\n   508→        ),\n   509→        startup_item(\n   510→            selection.field == SelectionField::Filter,\n   511→            \"Filter\",\n   512→            on_off(selection.filter_enabled).to_string(),\n   513→        ),\n   514→        startup_item(\n   515→            selection.field == SelectionField::Light,\n   516→            \"Light\",\n   517→            selection.light_preset.label().to_string(),\n   518→        ),\n   519→        startup_item(\n   520→            selection.field == SelectionField::Heater,\n   521→            \"Heater\",\n   522→            selection.heater_preset.label().to_string(),\n   523→        ),\n   524→        startup_item(\n   525→            selection.field == SelectionField::Aeration,\n   526→            \"Aeration\",\n   527→            on_off(selection.aeration_enabled).to_string(),\n   528→        ),\n   529→        startup_item(\n   530→            selection.field == SelectionField::ShrimpCount,\n   531→            \"Initial shrimp\",\n   532→            selection.initial_shrimp_count.to_string(),\n   533→        ),\n   534→        startup_item(\n   535→            selection.field == SelectionField::Launch,\n   536→            \"Launch\",\n   537→            \"Press Enter to start\".to_string(),\n   538→        ),\n   539→    ];\n   540→    let options = List::new(fields).block(\n   541→        Block::default()\n   542→            .title(\"Configuration\")\n   543→            .borders(Borders::ALL),\n   544→    );\n   545→    frame.render_widget(options, body[0]);\n   546→\n   547→    let summary = scenario\n   548→        .map(|item| {\n   549→            let geometry = selection.effective_geometry(\n   550→                item.tank_length_cm,\n   551→                item.tank_width_cm,\n   552→                item.tank_height_cm,\n   553→                item.fill_height_cm,\n   554→            );\n   555→            vec![\n   556→                Line::from(format!(\"Scenario template {} ({})\", item.name, item.id)),\n   557→                Line::from(format!(\"Ambient {:.1} C\", item.ambient_temp_c)),\n   558→                Line::from(format!(\n   559→                    \"Geometry {:.1} x {:.1} x {:.1} cm · fill {:.1} cm\",\n   560→                    geometry.length_cm,\n   561→                    geometry.width_cm,\n   562→                    geometry.height_cm,\n   563→                    geometry.fill_height_cm\n   564→                )),\n   565→                Line::from(format!(\"Water volume {:.1} L\", geometry.water_volume_l())),\n   566→                Line::from(format!(\n   567→                    \"Source water {} ({})\",\n   568→                    source_water_label(&selection.source_water_id),\n   569→                    selection.source_water_id\n   570→                )),\n   571→                Line::from(format!(\"Substrate {}\", selection.substrate_preset.label())),\n   572→                Line::from(format!(\"Plants {}\", selection.plant_selection.label())),\n   573→                Line::from(format!(\"Filter {}\", on_off(selection.filter_enabled))),\n   574→                Line::from(format!(\n   575→                    \"Light photoperiod {}\",\n   576→                    selection.light_preset.label()\n   577→                )),\n   578→                Line::from(format!(\"Heater {}\", selection.heater_preset.label())),\n   579→                Line::from(format!(\"Aeration {}\", on_off(selection.aeration_enabled))),\n   580→                Line::from(format!(\n   581→                    \"Initial shrimp {} adults\",\n   582→                    selection.initial_shrimp_count\n   583→                )),\n   584→                Line::from(\"Changing Scenario resets all override fields to that template.\"),\n   585→            ]\n   586→        })\n   587→        .unwrap_or_else(|| vec![Line::from(\"Scenario details unavailable\")]);\n   588→    let summary_widget = Paragraph::new(summary)\n   589→        .block(\n   590→            Block::default()\n   591→                .title(\"Launch summary\")\n   592→                .borders(Borders::ALL),\n   593→        )\n   594→        .wrap(ratatui::widgets::Wrap { trim: true });\n   595→    frame.render_widget(summary_widget, body[1]);\n   596→\n   597→    let help = Paragraph::new(\n   598→        \"Up/Down move between fields, Left/Right change values, Enter advances, q quits.\",\n   599→    )\n   600→    .block(Block::default().borders(Borders::ALL));\n   601→    frame.render_widget(help, layout[2]);\n   602→}\n   603→\n   604→fn startup_item(selected: bool, label: &str, value: String) -> ListItem<'static> {\n   605→    let style = if selected {\n   606→        Style::default()\n   607→            .fg(Color::Yellow)\n   608→            .add_modifier(Modifier::BOLD)\n   609→    } else {\n   610→        Style::default()\n   611→    };\n   612→    ListItem::new(Line::from(vec![\n   613→        Span::styled(format!(\"{label}: \"), style),\n   614→        Span::raw(value),\n   615→    ]))\n   616→}\n   617→\n   618→fn centered_rect(area: Rect, width_percent: u16, height_percent: u16) -> Rect {\n   619→    let vertical = Layout::vertical([\n   620→        Constraint::Percentage((100 - height_percent) / 2),\n   621→        Constraint::Percentage(height_percent),\n   622→        Constraint::Percentage((100 - height_percent) / 2),\n   623→    ])\n   624→    .split(area);\n   625→    let horizontal = Layout::horizontal([\n   626→        Constraint::Percentage((100 - width_percent) / 2),\n   627→        Constraint::Percentage(width_percent),\n   628→        Constraint::Percentage((100 - width_percent) / 2),\n   629→    ])\n   630→    .split(vertical[1]);\n   631→    horizontal[1]\n   632→}\n   633→"}]},"parent_tool_use_id":"toolu_01Y9ahSmCe1Vce9gb4yRGRh2","session_id":"49fc8440-ef1d-426c-844e-0d9d2eefdcf5","uuid":"f75d469d-113c-4eb5-ade1-6cbe5313a97c"}
