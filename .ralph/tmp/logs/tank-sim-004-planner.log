 30.0\ntank_height_cm = 36.0\nfill_height_cm = 32.0\nambient_temp_c = 24.0\n\n[provenance]\nsource_title = \"Starter preset pack\"\nsource_year = 2026\nconfidence = \"medium\"\nnotes = \"Broader planted baseline for regression scenarios.\"\n\n\nFILE:crates/tank_data/data/scenarios/warm_room.toml\nid = \"warm_room\"\nname = \"Warm Room\"\nsource_water_id = \"moderate\"\nsubstrate_ids = [\"inert_gravel\"]\nplant_ids = [\"fast_stem\"]\nshrimp_profile_id = \"neocaridina_davidi\"\nprocess_params_id = \"default\"\ntank_length_cm = 45.0\ntank_width_cm = 24.0\ntank_height_cm = 28.0\nfill_height_cm = 24.0\nambient_temp_c = 29.0\n\n[provenance]\nsource_title = \"Starter preset pack\"\nsource_year = 2026\nconfidence = \"medium\"\nnotes = \"Warm-room baseline for temperature-sensitive tests.\"\n\n\n","exit_code":0,"status":"completed"}}
