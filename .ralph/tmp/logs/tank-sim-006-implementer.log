{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FXGTbexucNN8xooFNhLw4D","type":"tool_result","content":"     1→use tank_core::{\n     2→    Engine, EventKind, PlayerAction, ProcessParams, SimError, SimSeed, SimulationEngine, TankState,\n     3→};\n     4→\n     5→/// Creates a well-conditioned tank with shrimp for population tests.\n     6→fn shrimp_test_state(seed: SimSeed) -> TankState {\n     7→    let geometry = tank_core::TankGeometry {\n     8→        length_cm: 40.0,\n     9→        width_cm: 30.0,\n    10→        height_cm: 35.0,\n    11→        fill_height_cm: 30.0,\n    12→        glass_thickness_mm: 5.0,\n    13→        open_top: true,\n    14→        lid_exchange_factor: 0.25,\n    15→    };\n    16→    let water = tank_core::WaterState::default_for_geometry(&geometry);\n    17→\n    18→    let mut state = TankState::new(seed);\n    19→    state.geometry = geometry;\n    20→    state.water = water;\n    21→    state.water.temperature_c = 24.0;\n    22→    state.environment.ambient_temp_c = 24.0;\n    23→\n    24→    let vol = state.geometry.water_volume_l();\n    25→    state.water.calcium_mg_total = 40.0 * vol;\n    26→    state.water.magnesium_mg_total = 10.0 * vol;\n    27→    state.water.alkalinity_meq_total = 8.0 * vol; // high buffer to avoid pH crash from nitrification\n    28→    state.water.dissolved_inorganic_carbon_mg_c_total = 5.0 * vol;\n    29→    state.water.dissolved_oxygen_mg_total = 8.0 * vol;\n    30→    state.water.bicarbonate_mg_total = 300.0 * vol;\n    31→    state.algae.periphyton_biomass_g = 5.0;\n    32→\n    33→    state.microbe.decomposer_biomass_g = 0.1;\n    34→    state.microbe.ammonia_oxidizer_biomass_g = 0.8;\n    35→    state.microbe.nitrite_oxidizer_biomass_g = 0.5;\n    36→    state.microbe.comammox_biomass_g = 0.15;\n    37→    state.filter_state.biofilter_maturity_index = 1.0;\n    38→\n    39→    state.hardware.aeration.enabled = true;\n    40→    state.hardware.aeration.intensity = 0.3;\n    41→    state.hardware.light.enabled = true;\n    42→    state.hardware.light.intensity_index = 0.6;\n    43→    state.hardware.light.photoperiod_hours = 8.0;\n    44→\n    45→    state.animal.adults_count = 10;\n    46→    state.animal.condition_index = 0.8;\n    47→    state.animal.molt_stress_index = 0.1;\n    48→    state.animal.reproductive_readiness_index = 0.5;\n    49→\n    50→    state.process_params = ProcessParams::default();\n    51→    // Mature biofilter: faster nitrification to keep TAN near zero\n    52→    state.process_params.aob_vmax_mg_n_per_g_per_hour = 5.0;\n    53→    state.process_params.nob_vmax_mg_n_per_g_per_hour = 5.0;\n    54→    // Well-established tank with good colonizable surfaces for periphyton\n    55→    state.process_params.periphyton_capacity_g_per_m2 = 30.0;\n    56→\n    57→    // Initialize stability tracker from actual state to avoid day-1 instability spike\n    58→    let ca_mg_l = state.water.calcium_mg_total / vol;\n    59→    let mg_mg_l = state.water.magnesium_mg_total / vol;\n    60→    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n    61→    state.stability_tracker.prev_temp_c = state.water.temperature_c;\n    62→    state.stability_tracker.prev_gh_d = gh_d;\n    63→    state.stability_tracker.prev_do_mg_l = state.water.dissolved_oxygen_mg_total / vol;\n    64→    // pH will be computed on first tick; use a reasonable estimate\n    65→    state.stability_tracker.prev_ph = 7.5;\n    66→\n    67→    state\n    68→}\n    69→\n    70→#[test]\n    71→fn spawning_creates_berried_females() -> Result<(), SimError> {\n    72→    let mut engine = Engine::from_parts(shrimp_test_state(SimSeed(7000)), vec![]);\n    73→\n    74→    // Run for 30 days with light feeding\n    75→    for _ in 0..30 {\n    76→        engine.apply_action(PlayerAction::Feed { grams: 0.1 })?;\n    77→        engine.step_hours(24)?;\n    78→    }\n    79→\n    80→    let state = engine.full_state();\n    81→    let events = &state.event_log;\n    82→\n    83→    // Over 30 days at good conditions, we should see ShrimpBerried events\n    84→    let berried_events = events\n    85→        .iter()\n    86→        .filter(|e| e.kind == EventKind::ShrimpBerried)\n    87→        .count();\n    88→    assert!(\n    89→        berried_events > 0,\n    90→        \"Should have at least one ShrimpBerried event in 30 days of good conditions\"\n    91→    );\n    92→\n    93→    // All ShrimpBerried events must have non-empty cause codes\n    94→    for e in events.iter().filter(|e| e.kind == EventKind::ShrimpBerried) {\n    95→        assert!(!e.cause_codes.is_empty(), \"ShrimpBerried must have cause codes\");\n    96→    }\n    97→\n    98→    Ok(())\n    99→}\n   100→\n   101→#[test]\n   102→fn hatch_produces_juveniles() -> Result<(), SimError> {\n   103→    let mut engine = Engine::from_parts(shrimp_test_state(SimSeed(7100)), vec![]);\n   104→\n   105→    // Run for 60 days - enough for spawning + egg development (21 days) + hatching\n   106→    for _ in 0..60 {\n   107→        engine.apply_action(PlayerAction::Feed { grams: 0.1 })?;\n   108→        engine.step_hours(24)?;\n   109→    }\n   110→\n   111→    let snap = engine.snapshot();\n   112→    // In good conditions over 60 days, at least some juveniles should appear\n   113→    // (10 adults, 21-day egg cycle, good conditions)\n   114→    assert!(\n   115→        snap.juveniles_count > 0 || snap.adult_shrimp_count > 10,\n   116→        \"After 60 days in good conditions, population should have grown. \\\n   117→         Adults: {}, Juveniles: {}\",\n   118→        snap.adult_shrimp_count,\n   119→        snap.juveniles_count\n   120→    );\n   121→\n   122→    Ok(())\n   123→}\n   124→\n   125→#[test]\n   126→fn egg_failure_under_stress() -> Result<(), SimError> {\n   127→    let mut state = shrimp_test_state(SimSeed(7200));\n   128→    // Force berried state\n   129→    state.animal.berried_females_count = 3;\n   130→    state.animal.egg_progress_days = 20.0; // About to hatch\n   131→\n   132→    // Create stressful conditions: low DO, high temp\n   133→    let vol = state.geometry.water_volume_l();\n   134→    state.water.dissolved_oxygen_mg_total = 2.0 * vol; // Low DO\n   135→    state.water.temperature_c = 32.0;\n   136→    state.environment.ambient_temp_c = 32.0;\n   137→    state.water.calcium_mg_total = 5.0 * vol; // Low minerals\n   138→    state.water.magnesium_mg_total = 1.0 * vol;\n   139→\n   140→    let mut engine = Engine::from_parts(state, vec![]);\n   141→    // Run one day to trigger clutch resolution\n   142→    engine.step_hours(24)?;\n   143→\n   144→    let events = &engine.full_state().event_log;\n   145→    let egg_failures = events\n   146→        .iter()\n   147→        .filter(|e| e.kind == EventKind::EggFailure)\n   148→        .collect::<Vec<_>>();\n   149→\n   150→    // Under these stressful conditions, egg failures should occur\n   151→    assert!(\n   152→        !egg_failures.is_empty(),\n   153→        \"Should have EggFailure events under stress\"\n   154→    );\n   155→\n   156→    // EggFailure must have cause codes tied to oxygen, temperature, minerals, or instability\n   157→    for e in &egg_failures {\n   158→        assert!(!e.cause_codes.is_empty(), \"EggFailure must have non-empty cause_codes\");\n   159→    }\n   160→\n   161→    // Failure invariant: berried_females_count resolved (back to 0)\n   162→    let state = engine.full_state();\n   163→    assert_eq!(state.animal.berried_females_count, 0);\n   164→    assert_eq!(state.animal.egg_progress_days, 0.0);\n   165→\n   166→    Ok(())\n   167→}\n   168→\n   169→#[test]\n   170→fn mortality_under_combined_stress() -> Result<(), SimError> {\n   171→    let mut state = shrimp_test_state(SimSeed(7300));\n   172→    state.animal.adults_count = 20;\n   173→    state.animal.juveniles_count = 10;\n   174→\n   175→    // Create combined low-DO + high-NH3 stress\n   176→    let vol = state.geometry.water_volume_l();\n   177→    state.water.dissolved_oxygen_mg_total = 1.5 * vol; // Very low DO\n   178→    state.water.ammonia_total_mg_n_total = 2.0 * vol; // Very high ammonia\n   179→    state.water.alkalinity_meq_total = 8.0 * vol; // High pH -> more NH3\n   180→    state.process_params.reaeration_kla_base = 0.05; // Slow recovery\n   181→\n   182→    let mut engine = Engine::from_parts(state, vec![]);\n   183→\n   184→    // Run 14 days under stress\n   185→    for _ in 0..14 {\n   186→        engine.step_hours(24)?;\n   187→    }\n   188→\n   189→    let snap = engine.snapshot();\n   190→    let total_survivors = snap.adult_shrimp_count + snap.juveniles_count;\n   191→    assert!(\n   192→        total_survivors < 30,\n   193→        \"Population should decline under combined stress. Survivors: {}\",\n   194→        total_survivors\n   195→    );\n   196→\n   197→    Ok(())\n   198→}\n   199→\n   200→#[test]\n   201→fn microfauna_suppression_under_heavy_grazing() -> Result<(), SimError> {\n   202→    // Tank with many shrimp should suppress microfauna\n   203→    let mut state = shrimp_test_state(SimSeed(7400));\n   204→    state.animal.adults_count = 50; // Heavy stocking\n   205→    state.microfauna.population_index = 0.8; // Start with healthy microfauna\n   206→\n   207→    let initial_pop = state.microfauna.population_index;\n   208→\n   209→    let mut engine = Engine::from_parts(state, vec![]);\n   210→    for _ in 0..30 {\n   211→        engine.apply_action(PlayerAction::Feed { grams: 0.3 })?;\n   212→        engine.step_hours(24)?;\n   213→    }\n   214→\n   215→    let snap = engine.snapshot();\n   216→    assert!(\n   217→        snap.microfauna_population_index < initial_pop,\n   218→        \"Heavy shrimp grazing should suppress microfauna. Start: {}, End: {}\",\n   219→        initial_pop,\n   220→        snap.microfauna_population_index\n   221→    );\n   222→\n   223→    Ok(())\n   224→}\n   225→\n   226→#[test]\n   227→fn shrimp_removal_validation() -> Result<(), SimError> {\n   228→    let mut state = shrimp_test_state(SimSeed(7500));\n   229→    state.animal.adults_count = 5;\n   230→    state.animal.berried_females_count = 2;\n   231→\n   232→    let mut engine = Engine::from_parts(state, vec![]);\n   233→\n   234→    // Try to remove more than available\n   235→    let result = engine.apply_action(PlayerAction::RemoveShrimp { count: 10 });\n   236→    assert!(\n   237→        matches!(result, Err(SimError::ShrimpRemovalExceedsAvailable { .. })),\n   238→        \"Should fail when removing more shrimp than available\"\n   239→    );\n   240→\n   241→    // Verify state is unchanged after failed removal\n   242→    assert_eq!(engine.full_state().animal.adults_count, 5);\n   243→    assert_eq!(engine.full_state().animal.berried_females_count, 2);\n   244→\n   245→    // Remove valid amount\n   246→    engine.apply_action(PlayerAction::RemoveShrimp { count: 3 })?;\n   247→    engine.step_hours(1)?;\n   248→\n   249→    let state = engine.full_state();\n   250→    assert_eq!(state.animal.adults_count, 2);\n   251→    // berried_females_count must be <= adults_count\n   252→    assert!(\n   253→        state.animal.berried_females_count <= state.animal.adults_count,\n   254→        \"berried_females ({}) must be <= adults ({})\",\n   255→        state.animal.berried_females_count,\n   256→        state.animal.adults_count\n   257→    );\n   258→\n   259→    Ok(())\n   260→}\n   261→\n   262→#[test]\n   263→fn shrimp_removal_accounts_for_queued_actions() -> Result<(), SimError> {\n   264→    let mut state = shrimp_test_state(SimSeed(7600));\n   265→    state.animal.adults_count = 5;\n   266→\n   267→    let mut engine = Engine::from_parts(state, vec![]);\n   268→\n   269→    // Queue removal of 3\n   270→    engine.apply_action(PlayerAction::RemoveShrimp { count: 3 })?;\n   271→\n   272→    // Try to remove 3 more (only 2 should be available)\n   273→    let result = engine.apply_action(PlayerAction::RemoveShrimp { count: 3 });\n   274→    assert!(\n   275→        matches!(result, Err(SimError::ShrimpRemovalExceedsAvailable { .. })),\n   276→        \"Should fail because only 2 adults remain after pending removal\"\n   277→    );\n   278→\n   279→    // But removing 2 should succeed\n   280→    engine.apply_action(PlayerAction::RemoveShrimp { count: 2 })?;\n   281→\n   282→    Ok(())\n   283→}\n   284→\n   285→#[test]\n   286→fn population_fields_never_negative() -> Result<(), SimError> {\n   287→    let mut state = shrimp_test_state(SimSeed(7700));\n   288→    state.animal.adults_count = 3;\n   289→    state.animal.juveniles_count = 2;\n   290→\n   291→    // Very hostile environment\n   292→    let vol = state.geometry.water_volume_l();\n   293→    state.water.dissolved_oxygen_mg_total = 0.5 * vol;\n   294→    state.water.ammonia_total_mg_n_total = 5.0 * vol;\n   295→\n   296→    let mut engine = Engine::from_parts(state, vec![]);\n   297→\n   298→    // Run many days under extreme stress\n   299→    for _ in 0..60 {\n   300→        engine.step_hours(24)?;\n   301→    }\n   302→\n   303→    let state = engine.full_state();\n   304→    // All population counts must be non-negative (u32 can't be negative, but check invariants)\n   305→    assert!(state.animal.condition_index >= 0.0);\n   306→    assert!(state.animal.condition_index <= 1.0);\n   307→    assert!(state.animal.molt_stress_index >= 0.0);\n   308→    assert!(state.animal.molt_stress_index <= 1.0);\n   309→    assert!(state.animal.reproductive_readiness_index >= 0.0);\n   310→    assert!(state.animal.reproductive_readiness_index <= 1.0);\n   311→    assert!(state.animal.berried_females_count <= state.animal.adults_count);\n   312→\n   313→    Ok(())\n   314→}\n   315→"}]},"parent_tool_use_id":null,"session_id":"0854d63d-3c8e-45e0-9e18-d2c751830c9f","uuid":"058f815c-afcb-408b-9bb5-84f7da622fb2","tool_use_result":{"type":"text","file":{"filePath":"/root/tank-simulation/crates/tank_core/tests/shrimp_population.rs","content":"use tank_core::{\n    Engine, EventKind, PlayerAction, ProcessParams, SimError, SimSeed, SimulationEngine, TankState,\n};\n\n/// Creates a well-conditioned tank with shrimp for population tests.\nfn shrimp_test_state(seed: SimSeed) -> TankState {\n    let geometry = tank_core::TankGeometry {\n        length_cm: 40.0,\n        width_cm: 30.0,\n        height_cm: 35.0,\n        fill_height_cm: 30.0,\n        glass_thickness_mm: 5.0,\n        open_top: true,\n        lid_exchange_factor: 0.25,\n    };\n    let water = tank_core::WaterState::default_for_geometry(&geometry);\n\n    let mut state = TankState::new(seed);\n    state.geometry = geometry;\n    state.water = water;\n    state.water.temperature_c = 24.0;\n    state.environment.ambient_temp_c = 24.0;\n\n    let vol = state.geometry.water_volume_l();\n    state.water.calcium_mg_total = 40.0 * vol;\n    state.water.magnesium_mg_total = 10.0 * vol;\n    state.water.alkalinity_meq_total = 8.0 * vol; // high buffer to avoid pH crash from nitrification\n    state.water.dissolved_inorganic_carbon_mg_c_total = 5.0 * vol;\n    state.water.dissolved_oxygen_mg_total = 8.0 * vol;\n    state.water.bicarbonate_mg_total = 300.0 * vol;\n    state.algae.periphyton_biomass_g = 5.0;\n\n    state.microbe.decomposer_biomass_g = 0.1;\n    state.microbe.ammonia_oxidizer_biomass_g = 0.8;\n    state.microbe.nitrite_oxidizer_biomass_g = 0.5;\n    state.microbe.comammox_biomass_g = 0.15;\n    state.filter_state.biofilter_maturity_index = 1.0;\n\n    state.hardware.aeration.enabled = true;\n    state.hardware.aeration.intensity = 0.3;\n    state.hardware.light.enabled = true;\n    state.hardware.light.intensity_index = 0.6;\n    state.hardware.light.photoperiod_hours = 8.0;\n\n    state.animal.adults_count = 10;\n    state.animal.condition_index = 0.8;\n    state.animal.molt_stress_index = 0.1;\n    state.animal.reproductive_readiness_index = 0.5;\n\n    state.process_params = ProcessParams::default();\n    // Mature biofilter: faster nitrification to keep TAN near zero\n    state.process_params.aob_vmax_mg_n_per_g_per_hour = 5.0;\n    state.process_params.nob_vmax_mg_n_per_g_per_hour = 5.0;\n    // Well-established tank with good colonizable surfaces for periphyton\n    state.process_params.periphyton_capacity_g_per_m2 = 30.0;\n\n    // Initialize stability tracker from actual state to avoid day-1 instability spike\n    let ca_mg_l = state.water.calcium_mg_total / vol;\n    let mg_mg_l = state.water.magnesium_mg_total / vol;\n    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n    state.stability_tracker.prev_temp_c = state.water.temperature_c;\n    state.stability_tracker.prev_gh_d = gh_d;\n    state.stability_tracker.prev_do_mg_l = state.water.dissolved_oxygen_mg_total / vol;\n    // pH will be computed on first tick; use a reasonable estimate\n    state.stability_tracker.prev_ph = 7.5;\n\n    state\n}\n\n#[test]\nfn spawning_creates_berried_females() -> Result<(), SimError> {\n    let mut engine = Engine::from_parts(shrimp_test_state(SimSeed(7000)), vec![]);\n\n    // Run for 30 days with light feeding\n    for _ in 0..30 {\n        engine.apply_action(PlayerAction::Feed { grams: 0.1 })?;\n        engine.step_hours(24)?;\n    }\n\n    let state = engine.full_state();\n    let events = &state.event_log;\n\n    // Over 30 days at good conditions, we should see ShrimpBerried events\n    let berried_events = events\n        .iter()\n        .filter(|e| e.kind == EventKind::ShrimpBerried)\n        .count();\n    assert!(\n        berried_events > 0,\n        \"Should have at least one ShrimpBerried event in 30 days of good conditions\"\n    );\n\n    // All ShrimpBerried events must have non-empty cause codes\n    for e in events.iter().filter(|e| e.kind == EventKind::ShrimpBerried) {\n        assert!(!e.cause_codes.is_empty(), \"ShrimpBerried must have cause codes\");\n    }\n\n    Ok(())\n}\n\n#[test]\nfn hatch_produces_juveniles() -> Result<(), SimError> {\n    let mut engine = Engine::from_parts(shrimp_test_state(SimSeed(7100)), vec![]);\n\n    // Run for 60 days - enough for spawning + egg development (21 days) + hatching\n    for _ in 0..60 {\n        engine.apply_action(PlayerAction::Feed { grams: 0.1 })?;\n        engine.step_hours(24)?;\n    }\n\n    let snap = engine.snapshot();\n    // In good conditions over 60 days, at least some juveniles should appear\n    // (10 adults, 21-day egg cycle, good conditions)\n    assert!(\n        snap.juveniles_count > 0 || snap.adult_shrimp_count > 10,\n        \"After 60 days in good conditions, population should have grown. \\\n         Adults: {}, Juveniles: {}\",\n        snap.adult_shrimp_count,\n        snap.juveniles_count\n    );\n\n    Ok(())\n}\n\n#[test]\nfn egg_failure_under_stress() -> Result<(), SimError> {\n    let mut state = shrimp_test_state(SimSeed(7200));\n    // Force berried state\n    state.animal.berried_females_count = 3;\n    state.animal.egg_progress_days = 20.0; // About to hatch\n\n    // Create stressful conditions: low DO, high temp\n    let vol = state.geometry.water_volume_l();\n    state.water.dissolved_oxygen_mg_total = 2.0 * vol; // Low DO\n    state.water.temperature_c = 32.0;\n    state.environment.ambient_temp_c = 32.0;\n    state.water.calcium_mg_total = 5.0 * vol; // Low minerals\n    state.water.magnesium_mg_total = 1.0 * vol;\n\n    let mut engine = Engine::from_parts(state, vec![]);\n    // Run one day to trigger clutch resolution\n    engine.step_hours(24)?;\n\n    let events = &engine.full_state().event_log;\n    let egg_failures = events\n        .iter()\n        .filter(|e| e.kind == EventKind::EggFailure)\n        .collect::<Vec<_>>();\n\n    // Under these stressful conditions, egg failures should occur\n    assert!(\n        !egg_failures.is_empty(),\n        \"Should have EggFailure events under stress\"\n    );\n\n    // EggFailure must have cause codes tied to oxygen, temperature, minerals, or instability\n    for e in &egg_failures {\n        assert!(!e.cause_codes.is_empty(), \"EggFailure must have non-empty cause_codes\");\n    }\n\n    // Failure invariant: berried_females_count resolved (back to 0)\n    let state = engine.full_state();\n    assert_eq!(state.animal.berried_females_count, 0);\n    assert_eq!(state.animal.egg_progress_days, 0.0);\n\n    Ok(())\n}\n\n#[test]\nfn mortality_under_combined_stress() -> Result<(), SimError> {\n    let mut state = shrimp_test_state(SimSeed(7300));\n    state.animal.adults_count = 20;\n    state.animal.juveniles_count = 10;\n\n    // Create combined low-DO + high-NH3 stress\n    let vol = state.geometry.water_volume_l();\n    state.water.dissolved_oxygen_mg_total = 1.5 * vol; // Very low DO\n    state.water.ammonia_total_mg_n_total = 2.0 * vol; // Very high ammonia\n    state.water.alkalinity_meq_total = 8.0 * vol; // High pH -> more NH3\n    state.process_params.reaeration_kla_base = 0.05; // Slow recovery\n\n    let mut engine = Engine::from_parts(state, vec![]);\n\n    // Run 14 days under stress\n    for _ in 0..14 {\n        engine.step_hours(24)?;\n    }\n\n    let snap = engine.snapshot();\n    let total_survivors = snap.adult_shrimp_count + snap.juveniles_count;\n    assert!(\n        total_survivors < 30,\n        \"Population should decline under combined stress. Survivors: {}\",\n        total_survivors\n    );\n\n    Ok(())\n}\n\n#[test]\nfn microfauna_suppression_under_heavy_grazing() -> Result<(), SimError> {\n    // Tank with many shrimp should suppress microfauna\n    let mut state = shrimp_test_state(SimSeed(7400));\n    state.animal.adults_count = 50; // Heavy stocking\n    state.microfauna.population_index = 0.8; // Start with healthy microfauna\n\n    let initial_pop = state.microfauna.population_index;\n\n    let mut engine = Engine::from_parts(state, vec![]);\n    for _ in 0..30 {\n        engine.apply_action(PlayerAction::Feed { grams: 0.3 })?;\n        engine.step_hours(24)?;\n    }\n\n    let snap = engine.snapshot();\n    assert!(\n        snap.microfauna_population_index < initial_pop,\n        \"Heavy shrimp grazing should suppress microfauna. Start: {}, End: {}\",\n        initial_pop,\n        snap.microfauna_population_index\n    );\n\n    Ok(())\n}\n\n#[test]\nfn shrimp_removal_validation() -> Result<(), SimError> {\n    let mut state = shrimp_test_state(SimSeed(7500));\n    state.animal.adults_count = 5;\n    state.animal.berried_females_count = 2;\n\n    let mut engine = Engine::from_parts(state, vec![]);\n\n    // Try to remove more than available\n    let result = engine.apply_action(PlayerAction::RemoveShrimp { count: 10 });\n    assert!(\n        matches!(result, Err(SimError::ShrimpRemovalExceedsAvailable { .. })),\n        \"Should fail when removing more shrimp than available\"\n    );\n\n    // Verify state is unchanged after failed removal\n    assert_eq!(engine.full_state().animal.adults_count, 5);\n    assert_eq!(engine.full_state().animal.berried_females_count, 2);\n\n    // Remove valid amount\n    engine.apply_action(PlayerAction::RemoveShrimp { count: 3 })?;\n    engine.step_hours(1)?;\n\n    let state = engine.full_state();\n    assert_eq!(state.animal.adults_count, 2);\n    // berried_females_count must be <= adults_count\n    assert!(\n        state.animal.berried_females_count <= state.animal.adults_count,\n        \"berried_females ({}) must be <= adults ({})\",\n        state.animal.berried_females_count,\n        state.animal.adults_count\n    );\n\n    Ok(())\n}\n\n#[test]\nfn shrimp_removal_accounts_for_queued_actions() -> Result<(), SimError> {\n    let mut state = shrimp_test_state(SimSeed(7600));\n    state.animal.adults_count = 5;\n\n    let mut engine = Engine::from_parts(state, vec![]);\n\n    // Queue removal of 3\n    engine.apply_action(PlayerAction::RemoveShrimp { count: 3 })?;\n\n    // Try to remove 3 more (only 2 should be available)\n    let result = engine.apply_action(PlayerAction::RemoveShrimp { count: 3 });\n    assert!(\n        matches!(result, Err(SimError::ShrimpRemovalExceedsAvailable { .. })),\n        \"Should fail because only 2 adults remain after pending removal\"\n    );\n\n    // But removing 2 should succeed\n    engine.apply_action(PlayerAction::RemoveShrimp { count: 2 })?;\n\n    Ok(())\n}\n\n#[test]\nfn population_fields_never_negative() -> Result<(), SimError> {\n    let mut state = shrimp_test_state(SimSeed(7700));\n    state.animal.adults_count = 3;\n    state.animal.juveniles_count = 2;\n\n    // Very hostile environment\n    let vol = state.geometry.water_volume_l();\n    state.water.dissolved_oxygen_mg_total = 0.5 * vol;\n    state.water.ammonia_total_mg_n_total = 5.0 * vol;\n\n    let mut engine = Engine::from_parts(state, vec![]);\n\n    // Run many days under extreme stress\n    for _ in 0..60 {\n        engine.step_hours(24)?;\n    }\n\n    let state = engine.full_state();\n    // All population counts must be non-negative (u32 can't be negative, but check invariants)\n    assert!(state.animal.condition_index >= 0.0);\n    assert!(state.animal.condition_index <= 1.0);\n    assert!(state.animal.molt_stress_index >= 0.0);\n    assert!(state.animal.molt_stress_index <= 1.0);\n    assert!(state.animal.reproductive_readiness_index >= 0.0);\n    assert!(state.animal.reproductive_readiness_index <= 1.0);\n    assert!(state.animal.berried_females_count <= state.animal.adults_count);\n\n    Ok(())\n}\n","numLines":315,"startLine":1,"totalLines":315}}}
