pub substrate_uptake_bias: f64,\n    90→    pub provenance: Option<Provenance>,\n    91→}\n    92→\n    93→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n    94→pub struct ShrimpPreset {\n    95→    pub id: String,\n    96→    pub name: String,\n    97→    pub species: String,\n    98→    pub optimal_temp_min_c: f64,\n    99→    pub optimal_temp_max_c: f64,\n   100→    pub gh_min_d: f64,\n   101→    pub gh_max_d: f64,\n   102→    #[serde(default = \"default_shrimp_base_spawn_rate\")]\n   103→    pub base_spawn_rate: f64,\n   104→    #[serde(default = \"default_shrimp_egg_duration_days\")]\n   105→    pub egg_duration_days: u32,\n   106→    #[serde(default = \"default_shrimp_hatch_success_base\")]\n   107→    pub hatch_success_base: f64,\n   108→    #[serde(default = \"default_shrimp_juvenile_sensitivity\")]\n   109→    pub juvenile_sensitivity: f64,\n   110→    #[serde(default = \"default_shrimp_high_temp_repro_penalty_start\")]\n   111→    pub high_temp_repro_penalty_start_c: f64,\n   112→    #[serde(default = \"default_shrimp_high_temp_repro_penalty_full\")]\n   113→    pub high_temp_repro_penalty_full_c: f64,\n   114→    pub provenance: Option<Provenance>,\n   115→}\n   116→\n   117→#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n   118→pub struct ProcessParamsPreset {\n   119→    pub id: String,\n   120→    pub name: String,\n   121→    pub mineralization_rate_per_day: f64,\n   122→    pub nitrification_vmax: f64,\n   123→    pub reaeration_kla_base: f64,\n   124→    pub aeration_kla_boost: f64,\n   125→    pub background_bod_mg_o2_per_g_biomass_per_hour: f64,\n   126→    pub plant_photosynthesis_o2_mg_per_g_per_hour: f64,\n   127→    pub respiration_dic_rate_mg_c_per_g_per_hour: f64,\n   128→    pub photosynthesis_dic_rate_mg_c_per_g_per_hour: f64,\n   129→    pub k_surface_w_per_m2_k: f64,\n   130→    pub k_wall_w_per_m2_k: f64,\n   131→\n   132→    // Nitrogen cycle: feed leaching\n   133→    #[serde(default = \"default_feed_leach_rate\")]\n   134→    pub feed_leach_rate_per_hour: f64,\n   135→    #[serde(default = \"default_fine_detritus_dissolution_rate\")]\n   136→    pub fine_detritus_dissolution_rate_per_hour: f64,\n   137→    #[serde(default = \"default_feed_n_to_c_ratio\")]\n   138→    pub feed_n_to_c_ratio: f64,\n   139→\n   140→    // Decomposer mineralization\n   141→    #[serde(default = \"default_decomposer_vmax\")]\n   142→    pub decomposer_vmax_per_hour: f64,\n   143→    #[serde(default = \"default_decomposer_k_doc\")]\n   144→    pub decomposer_k_doc_mg: f64,\n   145→    #[serde(default = \"default_decomposer_growth_yield\")]\n   146→    pub decomposer_growth_yield: f64,\n   147→    #[serde(default = \"default_decomposer_decay_rate\")]\n   148→    pub decomposer_decay_rate_per_hour: f64,\n   149→\n   150→    // AOB kinetics\n   151→    #[serde(default = \"default_aob_vmax\")]\n   152→    pub aob_vmax_mg_n_per_g_per_hour: f64,\n   153→    #[serde(default = \"default_aob_k_tan\")]\n   154→    pub aob_k_tan_mg: f64,\n   155→    #[serde(default = \"default_aob_k_do\")]\n   156→    pub aob_k_do_mg: f64,\n   157→    #[serde(default = \"default_aob_growth_yield\")]\n   158→    pub aob_growth_yield: f64,\n   159→    #[serde(default = \"default_aob_decay_rate\")]\n   160→    pub aob_decay_rate_per_hour: f64,\n   161→\n   162→    // NOB kinetics\n   163→    #[serde(default = \"default_nob_vmax\")]\n   164→    pub nob_vmax_mg_n_per_g_per_hour: f64,\n   165→    #[serde(default = \"default_nob_k_nitrite\")]\n   166→    pub nob_k_nitrite_mg: f64,\n   167→    #[serde(default = \"default_nob_k_do\")]\n   168→    pub nob_k_do_mg: f64,\n   169→    #[serde(default = \"default_nob_growth_yield\")]\n   170→    pub nob_growth_yield: f64,\n   171→    #[serde(default = \"default_nob_decay_rate\")]\n   172→    pub nob_decay_rate_per_hour: f64,\n   173→\n   174→    // Comammox kinetics\n   175→    #[serde(default = \"default_comammox_vmax_fraction\")]\n   176→    pub comammox_vmax_fraction: f64,\n   177→ 