{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PEdrsQSQ3J1FdQK3wzkoBV","type":"tool_result","content":"     1→use crate::{\n     2→    systems::chemistry::compute_nh3_mg_l,\n     3→    types::{EventCause, EventKind, EventSeverity, SimEvent, TankState},\n     4→};\n     5→\n     6→pub fn emit_hourly_threshold_events(state: &mut TankState) {\n     7→    let volume_l = state.geometry.water_volume_l();\n     8→    if volume_l <= f64::EPSILON {\n     9→        return;\n    10→    }\n    11→\n    12→    let tan_mg_l = state.water.ammonia_total_mg_n_total / volume_l;\n    13→    let nh3_mg_l = compute_nh3_mg_l(tan_mg_l, state.water.ph, state.water.temperature_c);\n    14→    let nitrite_mg_l = state.water.nitrite_mg_n_total / volume_l;\n    15→    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n    16→\n    17→    if nh3_mg_l >= 0.02 {\n    18→        emit_once_per_day(\n    19→            state,\n    20→            EventSeverity::Warning,\n    21→            EventKind::AmmoniaWarning,\n    22→            vec![EventCause::HighAmmonia],\n    23→            format!(\"Free ammonia reached {nh3_mg_l:.3} mg/L\"),\n    24→        );\n    25→    }\n    26→    if nitrite_mg_l >= 0.5 {\n    27→        emit_once_per_day(\n    28→            state,\n    29→            EventSeverity::Warning,\n    30→            EventKind::NitriteWarning,\n    31→            vec![EventCause::HighNitrite],\n    32→            format!(\"Nitrite reached {nitrite_mg_l:.2} mg/L\"),\n    33→        );\n    34→    }\n    35→    if do_mg_l < 4.0 {\n    36→        emit_once_per_day(\n    37→            state,\n    38→            EventSeverity::Warning,\n    39→            EventKind::OxygenDip,\n    40→            vec![EventCause::LowOxygen],\n    41→            format!(\"Dissolved oxygen dropped to {do_mg_l:.2} mg/L\"),\n    42→        );\n    43→    }\n    44→}\n    45→\n    46→pub fn emit_once_per_day_pub(\n    47→    state: &mut TankState,\n    48→    severity: EventSeverity,\n    49→    kind: EventKind,\n    50→    cause_codes: Vec<EventCause>,\n    51→    summary: String,\n    52→) {\n    53→    emit_once_per_day(state, severity, kind, cause_codes, summary);\n    54→}\n    55→\n    56→pub fn emit_daily_algae_events(\n    57→    state: &mut TankState,\n    58→    previous_nuisance_index: f64,\n    59→    periphyton_capacity_g: f64,\n    60→) {\n    61→    let volume_l = state.geometry.water_volume_l();\n    62→    if previous_nuisance_index < 0.5 && state.algae.nuisance_index >= 0.5 {\n    63→        emit_once_per_day(\n    64→            state,\n    65→            EventSeverity::Warning,\n    66→            EventKind::AlgaeRiskRising,\n    67→            vec![EventCause::HighNutrients, EventCause::PlantCrowding],\n    68→            format!(\n    69→                \"Algae nuisance pressure rose to {:.2}\",\n    70→                state.algae.nuisance_index\n    71→            ),\n    72→        );\n    73→    }\n    74→\n    75→    if volume_l > f64::EPSILON {\n    76→        let suspended_g_l = state.algae.suspended_biomass_g / volume_l;\n    77→        if suspended_g_l >= state.process_params.algae_bloom_threshold_g_per_l {\n    78→            emit_once_per_day(\n    79→                state,\n    80→                EventSeverity::Warning,\n    81→                EventKind::AlgaeBloom,\n    82→                vec![EventCause::HighNutrients],\n    83→                format!(\"Suspended algae reached {suspended_g_l:.3} g/L\"),\n    84→            );\n    85→        }\n    86→    }\n    87→\n    88→    if periphyton_capacity_g > f64::EPSILON {\n    89→        let occupancy = state.algae.periphyton_biomass_g / periphyton_capacity_g;\n    90→        let mean_low_oxygen_tendency = if state.substrate_layers.is_empty() {\n    91→            0.0\n    92→        } else {\n    93→            state\n    94→                .substrate_layers\n    95→                .iter()\n    96→                .map(|layer| layer.low_oxygen_tendency_index)\n    97→                .sum::<f64>()\n    98→                / state.substrate_layers.len() as f64\n    99→        };\n   100→        if occupancy >= 0.8 && mean_low_oxygen_tendency >= 0.55 {\n   101→            emit_once_per_day(\n   102→                state,\n   103→                EventSeverity::Warning,\n   104→                EventKind::SubstrateFoulingWarning,\n   105→                vec![EventCause::SurfaceSaturation, EventCause::LowOxygen],\n   106→                format!(\n   107→                    \"Periphyton occupancy reached {:.0}% of surface capacity\",\n   108→                    occupancy * 100.0\n   109→                ),\n   110→            );\n   111→        }\n   112→    }\n   113→}\n   114→\n   115→fn emit_once_per_day(\n   116→    state: &mut TankState,\n   117→    severity: EventSeverity,\n   118→    kind: EventKind,\n   119→    cause_codes: Vec<EventCause>,\n   120→    summary: String,\n   121→) {\n   122→    let key = format!(\"{kind:?}\");\n   123→    if state.last_event_day.get(&key) == Some(&state.environment.day) {\n   124→        return;\n   125→    }\n   126→\n   127→    state.event_log.push(SimEvent::new(\n   128→        state.environment.day,\n   129→        state.environment.hour_of_day,\n   130→        severity,\n   131→        kind,\n   132→        cause_codes,\n   133→        summary,\n   134→    ));\n   135→    state.last_event_day.insert(key, state.environment.day);\n   136→}\n   137→"}]},"parent_tool_use_id":null,"session_id":"24615e58-d50c-4dac-86b6-bdc30a050fb6","uuid":"6df756a8-dfa7-4c97-9599-3e21e77c6a92","tool_use_result":{"type":"text","file":{"filePath":"/root/tank-simulation/crates/tank_core/src/systems/events.rs","content":"use crate::{\n    systems::chemistry::compute_nh3_mg_l,\n    types::{EventCause, EventKind, EventSeverity, SimEvent, TankState},\n};\n\npub fn emit_hourly_threshold_events(state: &mut TankState) {\n    let volume_l = state.geometry.water_volume_l();\n    if volume_l <= f64::EPSILON {\n        return;\n    }\n\n    let tan_mg_l = state.water.ammonia_total_mg_n_total / volume_l;\n    let nh3_mg_l = compute_nh3_mg_l(tan_mg_l, state.water.ph, state.water.temperature_c);\n    let nitrite_mg_l = state.water.nitrite_mg_n_total / volume_l;\n    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n\n    if nh3_mg_l >= 0.02 {\n        emit_once_per_day(\n            state,\n            EventSeverity::Warning,\n            EventKind::AmmoniaWarning,\n            vec![EventCause::HighAmmonia],\n            format!(\"Free ammonia reached {nh3_mg_l:.3} mg/L\"),\n        );\n    }\n    if nitrite_mg_l >= 0.5 {\n        emit_once_per_day(\n            state,\n            EventSeverity::Warning,\n            EventKind::NitriteWarning,\n            vec![EventCause::HighNitrite],\n            format!(\"Nitrite reached {nitrite_mg_l:.2} mg/L\"),\n        );\n    }\n    if do_mg_l < 4.0 {\n        emit_once_per_day(\n            state,\n            EventSeverity::Warning,\n            EventKind::OxygenDip,\n            vec![EventCause::LowOxygen],\n            format!(\"Dissolved oxygen dropped to {do_mg_l:.2} mg/L\"),\n        );\n    }\n}\n\npub fn emit_once_per_day_pub(\n    state: &mut TankState,\n    severity: EventSeverity,\n    kind: EventKind,\n    cause_codes: Vec<EventCause>,\n    summary: String,\n) {\n    emit_once_per_day(state, severity, kind, cause_codes, summary);\n}\n\npub fn emit_daily_algae_events(\n    state: &mut TankState,\n    previous_nuisance_index: f64,\n    periphyton_capacity_g: f64,\n) {\n    let volume_l = state.geometry.water_volume_l();\n    if previous_nuisance_index < 0.5 && state.algae.nuisance_index >= 0.5 {\n        emit_once_per_day(\n            state,\n            EventSeverity::Warning,\n            EventKind::AlgaeRiskRising,\n            vec![EventCause::HighNutrients, EventCause::PlantCrowding],\n            format!(\n                \"Algae nuisance pressure rose to {:.2}\",\n                state.algae.nuisance_index\n            ),\n        );\n    }\n\n    if volume_l > f64::EPSILON {\n        let suspended_g_l = state.algae.suspended_biomass_g / volume_l;\n        if suspended_g_l >= state.process_params.algae_bloom_threshold_g_per_l {\n            emit_once_per_day(\n                state,\n                EventSeverity::Warning,\n                EventKind::AlgaeBloom,\n                vec![EventCause::HighNutrients],\n                format!(\"Suspended algae reached {suspended_g_l:.3} g/L\"),\n            );\n        }\n    }\n\n    if periphyton_capacity_g > f64::EPSILON {\n        let occupancy = state.algae.periphyton_biomass_g / periphyton_capacity_g;\n        let mean_low_oxygen_tendency = if state.substrate_layers.is_empty() {\n            0.0\n        } else {\n            state\n                .substrate_layers\n                .iter()\n                .map(|layer| layer.low_oxygen_tendency_index)\n                .sum::<f64>()\n                / state.substrate_layers.len() as f64\n        };\n        if occupancy >= 0.8 && mean_low_oxygen_tendency >= 0.55 {\n            emit_once_per_day(\n                state,\n                EventSeverity::Warning,\n                EventKind::SubstrateFoulingWarning,\n                vec![EventCause::SurfaceSaturation, EventCause::LowOxygen],\n                format!(\n                    \"Periphyton occupancy reached {:.0}% of surface capacity\",\n                    occupancy * 100.0\n                ),\n            );\n        }\n    }\n}\n\nfn emit_once_per_day(\n    state: &mut TankState,\n    severity: EventSeverity,\n    kind: EventKind,\n    cause_codes: Vec<EventCause>,\n    summary: String,\n) {\n    let key = format!(\"{kind:?}\");\n    if state.last_event_day.get(&key) == Some(&state.environment.day) {\n        return;\n    }\n\n    state.event_log.push(SimEvent::new(\n        state.environment.day,\n        state.environment.hour_of_day,\n        severity,\n        kind,\n        cause_codes,\n        summary,\n    ));\n    state.last_event_day.insert(key, state.environment.day);\n}\n","numLines":137,"startLine":1,"totalLines":137}}}
