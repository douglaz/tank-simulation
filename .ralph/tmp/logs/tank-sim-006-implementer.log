{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018u1UmAuf8h1EgPp2LB8j2F","type":"tool_result","content":"     1→use std::collections::VecDeque;\n     2→\n     3→use crate::{\n     4→    invariants::enforce_invariants,\n     5→    rng::SimSeed,\n     6→    systems,\n     7→    types::{\n     8→        EventCause, EventKind, EventSeverity, PlayerAction, SimError, SimEvent, TankSnapshot,\n     9→        TankState,\n    10→    },\n    11→};\n    12→\n    13→pub trait SimulationEngine {\n    14→    fn apply_action(&mut self, action: PlayerAction) -> Result<(), SimError>;\n    15→    fn step_hours(&mut self, hours: u32) -> Result<(), SimError>;\n    16→    fn snapshot(&self) -> TankSnapshot;\n    17→    fn full_state(&self) -> &TankState;\n    18→}\n    19→\n    20→#[derive(Debug, Clone, PartialEq)]\n    21→pub struct Engine {\n    22→    state: TankState,\n    23→    queued_actions: VecDeque<PlayerAction>,\n    24→}\n    25→\n    26→impl Engine {\n    27→    pub fn new(seed: SimSeed) -> Self {\n    28→        Self {\n    29→            state: TankState::new(seed),\n    30→            queued_actions: VecDeque::new(),\n    31→        }\n    32→    }\n    33→\n    34→    pub fn from_parts(state: TankState, queued_actions: Vec<PlayerAction>) -> Self {\n    35→        Self {\n    36→            state,\n    37→            queued_actions: queued_actions.into(),\n    38→        }\n    39→    }\n    40→\n    41→    pub fn queued_actions(&self) -> Vec<PlayerAction> {\n    42→        self.queued_actions.iter().cloned().collect()\n    43→    }\n    44→\n    45→    fn step_one_hour(&mut self) -> Result<(), SimError> {\n    46→        let actions_slice: Vec<_> = self.queued_actions.iter().cloned().collect();\n    47→        systems::water_change::validate_water_changes(&self.state, &actions_slice)?;\n    48→\n    49→        while let Some(action) = self.queued_actions.pop_front() {\n    50→            self.process_action(action);\n    51→        }\n    52→\n    53→        // Step 4: update water temperature from ambient and heater\n    54→        systems::temperature::step_temperature(&mut self.state);\n    55→\n    56→        // Step 5: compute light state for the current hour.\n    57→        let light_on = self.state.hardware.light.enabled\n    58→            && systems::light::is_light_on(\n    59→                self.state.environment.hour_of_day,\n    60→                self.state.hardware.light.photoperiod_hours,\n    61→            );\n    62→\n    63→        // Step 6-8: nitrogen cycle phase (feed leaching, detritus breakdown,\n    64→        // mineralization, nitrification, guild growth/decay).\n    65→        // This runs between light-state resolution and chemistry/DO/event phases.\n    66→        // Nitrification O2 consumption and alkalinity depletion are handled\n    67→        // internally by the nitrogen cycle system.\n    68→        let _nc_output = systems::nitrogen_cycle::step_nitrogen_cycle(&mut self.state);\n    69→\n    70→        // Step 9: update DIC, alkalinity, and pH.\n    71→        systems::chemistry::step_hourly_chemistry(&mut self.state, light_on);\n    72→\n    73→        // Step 10 / 11-partial: update dissolved oxygen with background respiration and\n    74→        // light-driven photosynthetic support from existing biomass.\n    75→        systems::dissolved_oxygen::step_dissolved_oxygen(&mut self.state, light_on);\n    76→\n    77→        // Step 13: emit threshold-based chemistry warnings.\n    78→        systems::events::emit_hourly_threshold_events(&mut self.state);\n    79→\n    80→        self.state.environment.hour_of_day = (self.state.environment.hour_of_day + 1) % 24;\n    81→        if self.state.environment.hour_of_day == 0 {\n    82→            self.state.environment.day += 1;\n    83→            // Daily pipeline\n    84→            self.run_daily_update();\n    85→        }\n    86→\n    87→        enforce_invariants(&mut self.state)\n    88→    }\n    89→\n    90→    fn run_daily_update(&mut self) {\n    91→        systems::plant_growth::step_daily_plants(&mut self.state);\n    92→        systems::algae_growth::step_daily_algae(&mut self.state);\n    93→\n    94→        // Step 6 (daily): biofilter maturity summary update\n    95→        let maturity_delta =\n    96→            systems::nitrogen_cycle::update_daily_biofilter_maturity(&mut self.state);\n    97→        if maturity_delta > 0.005 {\n    98→            self.push_event(\n    99→                EventSeverity::Info,\n   100→                EventKind::BiofilmMaturityIncrease,\n   101→                vec![EventCause::BiofilterImmature],\n   102→                format!(\n   103→                    \"Biofilter maturity increased to {:.3}\",\n   104→                    self.state.filter_state.biofilter_maturity_index\n   105→                ),\n   106→            );\n   107→        }\n   108→        // Emit CycleProgressing when maturity is actively growing\n   109→        let current_maturity = self.state.filter_state.biofilter_maturity_index;\n   110→        if maturity_delta > 0.001 && current_maturity < 0.9 {\n   111→            systems::events::emit_once_per_day_pub(\n   112→                &mut self.state,\n   113→                EventSeverity::Info,\n   114→                EventKind::CycleProgressing,\n   115→                vec![EventCause::BiofilterImmature],\n   116→                format!(\"Nitrogen cycle progressing, maturity {current_maturity:.3}\"),\n   117→            );\n   118→        }\n   119→    }\n   120→\n   121→    fn process_action(&mut self, action: PlayerAction) {\n   122→        match action {\n   123→            PlayerAction::Feed { grams } => {\n   124→                self.state.detritus.particulate_organics_g_total += grams;\n   125→                self.push_event(\n   126→                    EventSeverity::Info,\n   127→                    EventKind::CycleProgressing,\n   128→                    vec![EventCause::Overfeeding],\n   129→                    format!(\"Queued feed processed: {grams:.2} g\"),\n   130→                );\n   131→            }\n   132→            PlayerAction::WaterChangePercent {\n   133→                percent,\n   134→                source_profile_id,\n   135→            } => {\n   136→                if percent <= 0.0 {\n   137→                    return;\n   138→                }\n   139→                // Profile was pre-validated; look it up (guaranteed to exist).\n   140→                let profile = self\n   141→                    .state\n   142→                    .source_water_catalog\n   143→                    .get(&source_profile_id)\n   144→                    .cloned();\n   145→                if let Some(profile) = profile {\n   146→                    systems::water_change::apply_water_change(&mut self.state, percent, &profile);\n   147→                    self.push_event(\n   148→                        EventSeverity::Info,\n   149→                        EventKind::StabilityImproving,\n   150→                        vec![EventCause::WaterChange],\n   151→                        format!(\"Water change processed: {percent:.1}% with {source_profile_id}\"),\n   152→                    );\n   153→                }\n   154→            }\n   155→            PlayerAction::TrimPlants { fraction } => {\n   156→                let mut trimmed_biomass_g = 0.0;\n   157→                for plant in &mut self.state.plant_guilds {\n   158→                    let trimmed = plant.biomass_g * fraction;\n   159→                    plant.biomass_g -= trimmed;\n   160→                    trimmed_biomass_g += trimmed;\n   161→                }\n   162→                self.state.detritus.fine_detritus_g_total += trimmed_biomass_g;\n   163→            }\n   164→            PlayerAction::SiphonDetritus { fraction } => {\n   165→                self.state.detritus.particulate_organics_g_total *= 1.0 - fraction;\n   166→                self.state.detritus.fine_detritus_g_total *= 1.0 - fraction;\n   167→            }\n   168→            PlayerAction::CleanFilter { intensity } => {\n   169→                self.state.hardware.filter.cleanliness_index = 1.0;\n   170→                self.state.filter_state.biofilter_maturity_index *= 1.0 - (intensity * 0.5);\n   171→                self.state.filter_state.clogging_index *= 1.0 - intensity;\n   172→                // Proportional setback in active nitrifier and decomposer biomass\n   173→                let setback = intensity * 0.5;\n   174→                self.state.microbe.decomposer_biomass_g *= 1.0 - setback;\n   175→                self.state.microbe.ammonia_oxidizer_biomass_g *= 1.0 - setback;\n   176→                self.state.microbe.nitrite_oxidizer_biomass_g *= 1.0 - setback;\n   177→                self.state.microbe.comammox_biomass_g *= 1.0 - setback;\n   178→                self.push_event(\n   179→                    EventSeverity::Warning,\n   180→                    EventKind::FilterCleaningSetback,\n   181→                    vec![EventCause::FilterMaintenance],\n   182→                    format!(\"Filter cleaned at intensity {intensity:.2}\"),\n   183→                );\n   184→            }\n   185→            PlayerAction::AddShrimp { count } => {\n   186→                self.state.animal.adults_count =\n   187→                    self.state.animal.adults_count.saturating_add(count);\n   188→            }\n   189→            PlayerAction::RemoveShrimp { count } => {\n   190→                self.state.animal.adults_count =\n   191→                    self.state.animal.adults_count.saturating_sub(count);\n   192→            }\n   193→            PlayerAction::ChangePhotoperiod { hours } => {\n   194→                self.state.hardware.light.photoperiod_hours = hours;\n   195→            }\n   196→            PlayerAction::ChangeLightIntensity { intensity_index } => {\n   197→                self.state.hardware.light.intensity_index = intensity_index;\n   198→            }\n   199→            PlayerAction::ChangeHeaterSetpoint { setpoint_c } => {\n   200→                self.state.hardware.heater.setpoint_c = setpoint_c;\n   201→            }\n   202→            PlayerAction::ChangeAmbientTemperature { target_c } => {\n   203→                self.state.environment.ambient_temp_c = target_c;\n   204→            }\n   205→            PlayerAction::ChangeAeration { enabled, intensity } => {\n   206→                self.state.hardware.aeration.enabled = enabled;\n   207→                self.state.hardware.aeration.intensity = intensity;\n   208→            }\n   209→        }\n   210→    }\n   211→\n   212→    fn push_event(\n   213→        &mut self,\n   214→        severity: EventSeverity,\n   215→        kind: EventKind,\n   216→        cause_codes: Vec<EventCause>,\n   217→        summary: String,\n   218→    ) {\n   219→        self.state.event_log.push(SimEvent::new(\n   220→            self.state.environment.day,\n   221→            self.state.environment.hour_of_day,\n   222→            severity,\n   223→            kind,\n   224→            cause_codes,\n   225→            summary,\n   226→        ));\n   227→    }\n   228→}\n   229→\n   230→impl SimulationEngine for Engine {\n   231→    fn apply_action(&mut self, action: PlayerAction) -> Result<(), SimError> {\n   232→        action.validate()?;\n   233→        self.queued_actions.push_back(action);\n   234→        Ok(())\n   235→    }\n   236→\n   237→    fn step_hours(&mut self, hours: u32) -> Result<(), SimError> {\n   238→        for _ in 0..hours {\n   239→            self.step_one_hour()?;\n   240→        }\n   241→        enforce_invariants(&mut self.state)\n   242→    }\n   243→\n   244→    fn snapshot(&self) -> TankSnapshot {\n   245→        TankSnapshot::from_state(&self.state)\n   246→    }\n   247→\n   248→    fn full_state(&self) -> &TankState {\n   249→        &self.state\n   250→    }\n   251→}\n   252→"}]},"parent_tool_use_id":null,"session_id":"24615e58-d50c-4dac-86b6-bdc30a050fb6","uuid":"2bc12cd3-1637-4a36-91b0-f84f196a1965","tool_use_result":{"type":"text","file":{"filePath":"/root/tank-simulation/crates/tank_core/src/engine.rs","content":"use std::collections::VecDeque;\n\nuse crate::{\n    invariants::enforce_invariants,\n    rng::SimSeed,\n    systems,\n    types::{\n        EventCause, EventKind, EventSeverity, PlayerAction, SimError, SimEvent, TankSnapshot,\n        TankState,\n    },\n};\n\npub trait SimulationEngine {\n    fn apply_action(&mut self, action: PlayerAction) -> Result<(), SimError>;\n    fn step_hours(&mut self, hours: u32) -> Result<(), SimError>;\n    fn snapshot(&self) -> TankSnapshot;\n    fn full_state(&self) -> &TankState;\n}\n\n#[derive(Debug, Clone, PartialEq)]\npub struct Engine {\n    state: TankState,\n    queued_actions: VecDeque<PlayerAction>,\n}\n\nimpl Engine {\n    pub fn new(seed: SimSeed) -> Self {\n        Self {\n            state: TankState::new(seed),\n            queued_actions: VecDeque::new(),\n        }\n    }\n\n    pub fn from_parts(state: TankState, queued_actions: Vec<PlayerAction>) -> Self {\n        Self {\n            state,\n            queued_actions: queued_actions.into(),\n        }\n    }\n\n    pub fn queued_actions(&self) -> Vec<PlayerAction> {\n        self.queued_actions.iter().cloned().collect()\n    }\n\n    fn step_one_hour(&mut self) -> Result<(), SimError> {\n        let actions_slice: Vec<_> = self.queued_actions.iter().cloned().collect();\n        systems::water_change::validate_water_changes(&self.state, &actions_slice)?;\n\n        while let Some(action) = self.queued_actions.pop_front() {\n            self.process_action(action);\n        }\n\n        // Step 4: update water temperature from ambient and heater\n        systems::temperature::step_temperature(&mut self.state);\n\n        // Step 5: compute light state for the current hour.\n        let light_on = self.state.hardware.light.enabled\n            && systems::light::is_light_on(\n                self.state.environment.hour_of_day,\n                self.state.hardware.light.photoperiod_hours,\n            );\n\n        // Step 6-8: nitrogen cycle phase (feed leaching, detritus breakdown,\n        // mineralization, nitrification, guild growth/decay).\n        // This runs between light-state resolution and chemistry/DO/event phases.\n        // Nitrification O2 consumption and alkalinity depletion are handled\n        // internally by the nitrogen cycle system.\n        let _nc_output = systems::nitrogen_cycle::step_nitrogen_cycle(&mut self.state);\n\n        // Step 9: update DIC, alkalinity, and pH.\n        systems::chemistry::step_hourly_chemistry(&mut self.state, light_on);\n\n        // Step 10 / 11-partial: update dissolved oxygen with background respiration and\n        // light-driven photosynthetic support from existing biomass.\n        systems::dissolved_oxygen::step_dissolved_oxygen(&mut self.state, light_on);\n\n        // Step 13: emit threshold-based chemistry warnings.\n        systems::events::emit_hourly_threshold_events(&mut self.state);\n\n        self.state.environment.hour_of_day = (self.state.environment.hour_of_day + 1) % 24;\n        if self.state.environment.hour_of_day == 0 {\n            self.state.environment.day += 1;\n            // Daily pipeline\n            self.run_daily_update();\n        }\n\n        enforce_invariants(&mut self.state)\n    }\n\n    fn run_daily_update(&mut self) {\n        systems::plant_growth::step_daily_plants(&mut self.state);\n        systems::algae_growth::step_daily_algae(&mut self.state);\n\n        // Step 6 (daily): biofilter maturity summary update\n        let maturity_delta =\n            systems::nitrogen_cycle::update_daily_biofilter_maturity(&mut self.state);\n        if maturity_delta > 0.005 {\n            self.push_event(\n                EventSeverity::Info,\n                EventKind::BiofilmMaturityIncrease,\n                vec![EventCause::BiofilterImmature],\n                format!(\n                    \"Biofilter maturity increased to {:.3}\",\n                    self.state.filter_state.biofilter_maturity_index\n                ),\n            );\n        }\n        // Emit CycleProgressing when maturity is actively growing\n        let current_maturity = self.state.filter_state.biofilter_maturity_index;\n        if maturity_delta > 0.001 && current_maturity < 0.9 {\n            systems::events::emit_once_per_day_pub(\n                &mut self.state,\n                EventSeverity::Info,\n                EventKind::CycleProgressing,\n                vec![EventCause::BiofilterImmature],\n                format!(\"Nitrogen cycle progressing, maturity {current_maturity:.3}\"),\n            );\n        }\n    }\n\n    fn process_action(&mut self, action: PlayerAction) {\n        match action {\n            PlayerAction::Feed { grams } => {\n                self.state.detritus.particulate_organics_g_total += grams;\n                self.push_event(\n                    EventSeverity::Info,\n                    EventKind::CycleProgressing,\n                    vec![EventCause::Overfeeding],\n                    format!(\"Queued feed processed: {grams:.2} g\"),\n                );\n            }\n            PlayerAction::WaterChangePercent {\n                percent,\n                source_profile_id,\n            } => {\n                if percent <= 0.0 {\n                    return;\n                }\n                // Profile was pre-validated; look it up (guaranteed to exist).\n                let profile = self\n                    .state\n                    .source_water_catalog\n                    .get(&source_profile_id)\n                    .cloned();\n                if let Some(profile) = profile {\n                    systems::water_change::apply_water_change(&mut self.state, percent, &profile);\n                    self.push_event(\n                        EventSeverity::Info,\n                        EventKind::StabilityImproving,\n                        vec![EventCause::WaterChange],\n                        format!(\"Water change processed: {percent:.1}% with {source_profile_id}\"),\n                    );\n                }\n            }\n            PlayerAction::TrimPlants { fraction } => {\n                let mut trimmed_biomass_g = 0.0;\n                for plant in &mut self.state.plant_guilds {\n                    let trimmed = plant.biomass_g * fraction;\n                    plant.biomass_g -= trimmed;\n                    trimmed_biomass_g += trimmed;\n                }\n                self.state.detritus.fine_detritus_g_total += trimmed_biomass_g;\n            }\n            PlayerAction::SiphonDetritus { fraction } => {\n                self.state.detritus.particulate_organics_g_total *= 1.0 - fraction;\n                self.state.detritus.fine_detritus_g_total *= 1.0 - fraction;\n            }\n            PlayerAction::CleanFilter { intensity } => {\n                self.state.hardware.filter.cleanliness_index = 1.0;\n                self.state.filter_state.biofilter_maturity_index *= 1.0 - (intensity * 0.5);\n                self.state.filter_state.clogging_index *= 1.0 - intensity;\n                // Proportional setback in active nitrifier and decomposer biomass\n                let setback = intensity * 0.5;\n                self.state.microbe.decomposer_biomass_g *= 1.0 - setback;\n                self.state.microbe.ammonia_oxidizer_biomass_g *= 1.0 - setback;\n                self.state.microbe.nitrite_oxidizer_biomass_g *= 1.0 - setback;\n                self.state.microbe.comammox_biomass_g *= 1.0 - setback;\n                self.push_event(\n                    EventSeverity::Warning,\n                    EventKind::FilterCleaningSetback,\n                    vec![EventCause::FilterMaintenance],\n                    format!(\"Filter cleaned at intensity {intensity:.2}\"),\n                );\n            }\n            PlayerAction::AddShrimp { count } => {\n                self.state.animal.adults_count =\n                    self.state.animal.adults_count.saturating_add(count);\n            }\n            PlayerAction::RemoveShrimp { count } => {\n                self.state.animal.adults_count =\n                    self.state.animal.adults_count.saturating_sub(count);\n            }\n            PlayerAction::ChangePhotoperiod { hours } => {\n                self.state.hardware.light.photoperiod_hours = hours;\n            }\n            PlayerAction::ChangeLightIntensity { intensity_index } => {\n                self.state.hardware.light.intensity_index = intensity_index;\n            }\n            PlayerAction::ChangeHeaterSetpoint { setpoint_c } => {\n                self.state.hardware.heater.setpoint_c = setpoint_c;\n            }\n            PlayerAction::ChangeAmbientTemperature { target_c } => {\n                self.state.environment.ambient_temp_c = target_c;\n            }\n            PlayerAction::ChangeAeration { enabled, intensity } => {\n                self.state.hardware.aeration.enabled = enabled;\n                self.state.hardware.aeration.intensity = intensity;\n            }\n        }\n    }\n\n    fn push_event(\n        &mut self,\n        severity: EventSeverity,\n        kind: EventKind,\n        cause_codes: Vec<EventCause>,\n        summary: String,\n    ) {\n        self.state.event_log.push(SimEvent::new(\n            self.state.environment.day,\n            self.state.environment.hour_of_day,\n            severity,\n            kind,\n            cause_codes,\n            summary,\n        ));\n    }\n}\n\nimpl SimulationEngine for Engine {\n    fn apply_action(&mut self, action: PlayerAction) -> Result<(), SimError> {\n        action.validate()?;\n        self.queued_actions.push_back(action);\n        Ok(())\n    }\n\n    fn step_hours(&mut self, hours: u32) -> Result<(), SimError> {\n        for _ in 0..hours {\n            self.step_one_hour()?;\n        }\n        enforce_invariants(&mut self.state)\n    }\n\n    fn snapshot(&self) -> TankSnapshot {\n        TankSnapshot::from_state(&self.state)\n    }\n\n    fn full_state(&self) -> &TankState {\n        &self.state\n    }\n}\n","numLines":252,"startLine":1,"totalLines":252}}}
