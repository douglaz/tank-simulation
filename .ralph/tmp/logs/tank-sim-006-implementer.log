{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XApCwACfJvKhQU88ztXHxM","type":"tool_result","content":"     1→use crate::{\n     2→    systems::events,\n     3→    types::{total_colonizable_area_cm2, TankState},\n     4→};\n     5→\n     6→const ALGAE_N_MG_PER_G_GROWTH: f64 = 35.0;\n     7→const ALGAE_P_MG_PER_G_GROWTH: f64 = 5.0;\n     8→\n     9→pub fn step_daily_algae(state: &mut TankState) {\n    10→    let volume_l = state.geometry.water_volume_l();\n    11→    if volume_l <= f64::EPSILON {\n    12→        return;\n    13→    }\n    14→\n    15→    let previous_nuisance_index = state.algae.nuisance_index;\n    16→    let light_factor = algae_light_factor(state);\n    17→    let temp_factor = gaussian_response(\n    18→        state.water.temperature_c,\n    19→        state.process_params.algae_temp_optimum_c,\n    20→        state.process_params.algae_temp_sigma_c,\n    21→    );\n    22→    let plant_shading = (1.0\n    23→        - state\n    24→            .plant_guilds\n    25→            .iter()\n    26→            .map(|plant| plant.crowding_index)\n    27→            .sum::<f64>()\n    28→            / state.plant_guilds.len().max(1) as f64\n    29→            * 0.7)\n    30→        .clamp(0.2, 1.0);\n    31→    let nutrient_factor = half_saturation(\n    32→        state.water.ammonia_total_mg_n_total + state.water.nitrate_mg_n_total,\n    33→        state.process_params.algae_half_saturation_n_mg_total,\n    34→    )\n    35→    .min(half_saturation(\n    36→        state.water.phosphate_mg_p_total,\n    37→        state.process_params.algae_half_saturation_p_mg_total,\n    38→    ));\n    39→    let microfauna_grazing = (state.microfauna.population_index\n    40→        * (0.3 + 0.7 * state.microfauna.grazing_pressure_index))\n    41→        .clamp(0.0, 1.0);\n    42→\n    43→    let suspended_seed_g = state.algae.suspended_biomass_g.max(0.02 * volume_l / 10.0);\n    44→    let suspended_gross_growth_g = suspended_seed_g\n    45→        * state.process_params.algae_max_growth_rate_per_day\n    46→        * light_factor\n    47→        * plant_shading\n    48→        * temp_factor\n    49→        * nutrient_factor;\n    50→    let suspended_respiration_g =\n    51→        state.algae.suspended_biomass_g * state.process_params.algae_respiration_fraction_per_day;\n    52→    let suspended_grazing_g = state.algae.suspended_biomass_g * 0.03 * microfauna_grazing;\n    53→    let suspended_new_g = (state.algae.suspended_biomass_g + suspended_gross_growth_g\n    54→        - suspended_respiration_g\n    55→        - suspended_grazing_g)\n    56→        .max(0.0);\n    57→    consume_algae_nutrients(\n    58→        state,\n    59→        suspended_gross_growth_g * ALGAE_N_MG_PER_G_GROWTH,\n    60→        suspended_gross_growth_g * ALGAE_P_MG_PER_G_GROWTH,\n    61→    );\n    62→    state.algae.suspended_biomass_g = suspended_new_g;\n    63→\n    64→    let colonizable_area_m2 =\n    65→        total_colonizable_area_cm2(&state.substrate_layers, state.geometry.wall_area_cm2())\n    66→            / 10_000.0;\n    67→    let periphyton_capacity_g =\n    68→        colonizable_area_m2.max(0.0) * state.process_params.periphyton_capacity_g_per_m2;\n    69→    let surface_cap_factor = if periphyton_capacity_g <= f64::EPSILON {\n    70→        0.0\n    71→    } else {\n    72→        (1.0 - (state.algae.periphyton_biomass_g / periphyton_capacity_g)).clamp(0.0, 1.0)\n    73→    };\n    74→    let periphyton_seed_g = state.algae.periphyton_biomass_g.max(0.05);\n    75→    let periphyton_gross_growth_g = periphyton_seed_g\n    76→        * state.process_params.periphyton_max_growth_rate_per_day\n    77→        * light_factor\n    78→        * plant_shading\n    79→        * temp_factor\n    80→        * nutrient_factor\n    81→        * surface_cap_factor;\n    82→    let periphyton_respiration_g =\n    83→        state.algae.periphyton_biomass_g * state.process_params.algae_respiration_fraction_per_day;\n    84→    let periphyton_grazing_g = state.algae.periphyton_biomass_g * 0.06 * microfauna_grazing;\n    85→    let periphyton_new_g = (state.algae.periphyton_biomass_g + periphyton_gross_growth_g\n    86→        - periphyton_respiration_g\n    87→        - periphyton_grazing_g)\n    88→        .max(0.0)\n    89→        .min(periphyton_capacity_g.max(0.0));\n    90→    consume_algae_nutrients(\n    91→        state,\n    92→        periphyton_gross_growth_g * ALGAE_N_MG_PER_G_GROWTH,\n    93→        periphyton_gross_growth_g * ALGAE_P_MG_PER_G_GROWTH,\n    94→    );\n    95→    state.algae.periphyton_biomass_g = periphyton_new_g;\n    96→\n    97→    let suspended_pressure = (state.algae.suspended_biomass_g / volume_l)\n    98→        / state\n    99→            .process_params\n   100→            .algae_bloom_threshold_g_per_l\n   101→            .max(f64::MIN_POSITIVE);\n   102→    let periphyton_pressure = if periphyton_capacity_g <= f64::EPSILON {\n   103→        0.0\n   104→    } else {\n   105→        state.algae.periphyton_biomass_g / periphyton_capacity_g\n   106→    };\n   107→    state.algae.nuisance_index =\n   108→        (0.55 * suspended_pressure + 0.45 * periphyton_pressure).clamp(0.0, 1.0);\n   109→\n   110→    events::emit_daily_algae_events(state, previous_nuisance_index, periphyton_capacity_g);\n   111→}\n   112→\n   113→fn algae_light_factor(state: &TankState) -> f64 {\n   114→    if !state.hardware.light.enabled {\n   115→        return 0.0;\n   116→    }\n   117→\n   118→    let photoperiod_factor = (state.hardware.light.photoperiod_hours / 9.0).clamp(0.0, 1.0);\n   119→    half_saturation(\n   120→        state.hardware.light.intensity_index * photoperiod_factor,\n   121→        state.process_params.algae_light_half_saturation,\n   122→    )\n   123→}\n   124→\n   125→fn consume_algae_nutrients(state: &mut TankState, n_demand_mg: f64, p_demand_mg: f64) {\n   126→    let ammonia_removed = state.water.ammonia_total_mg_n_total.min(n_demand_mg * 0.6);\n   127→    state.water.ammonia_total_mg_n_total -= ammonia_removed;\n   128→\n   129→    let remaining_n = (n_demand_mg - ammonia_removed).max(0.0);\n   130→    let nitrate_removed = state.water.nitrate_mg_n_total.min(remaining_n);\n   131→    state.water.nitrate_mg_n_total -= nitrate_removed;\n   132→\n   133→    let phosphate_removed = state.water.phosphate_mg_p_total.min(p_demand_mg);\n   134→    state.water.phosphate_mg_p_total -= phosphate_removed;\n   135→}\n   136→\n   137→fn half_saturation(value: f64, half_sat: f64) -> f64 {\n   138→    let half_sat = half_sat.max(f64::MIN_POSITIVE);\n   139→    (value / (value + half_sat)).clamp(0.0, 1.0)\n   140→}\n   141→\n   142→fn gaussian_response(value: f64, optimum: f64, sigma: f64) -> f64 {\n   143→    let sigma = sigma.max(0.1);\n   144→    let diff = value - optimum;\n   145→    (-(diff * diff) / (2.0 * sigma * sigma))\n   146→        .exp()\n   147→        .clamp(0.0, 1.0)\n   148→}\n   149→"}]},"parent_tool_use_id":null,"session_id":"24615e58-d50c-4dac-86b6-bdc30a050fb6","uuid":"7ee82f5e-57d8-4014-b26e-81a1f3d78285","tool_use_result":{"type":"text","file":{"filePath":"/root/tank-simulation/crates/tank_core/src/systems/algae_growth.rs","content":"use crate::{\n    systems::events,\n    types::{total_colonizable_area_cm2, TankState},\n};\n\nconst ALGAE_N_MG_PER_G_GROWTH: f64 = 35.0;\nconst ALGAE_P_MG_PER_G_GROWTH: f64 = 5.0;\n\npub fn step_daily_algae(state: &mut TankState) {\n    let volume_l = state.geometry.water_volume_l();\n    if volume_l <= f64::EPSILON {\n        return;\n    }\n\n    let previous_nuisance_index = state.algae.nuisance_index;\n    let light_factor = algae_light_factor(state);\n    let temp_factor = gaussian_response(\n        state.water.temperature_c,\n        state.process_params.algae_temp_optimum_c,\n        state.process_params.algae_temp_sigma_c,\n    );\n    let plant_shading = (1.0\n        - state\n            .plant_guilds\n            .iter()\n            .map(|plant| plant.crowding_index)\n            .sum::<f64>()\n            / state.plant_guilds.len().max(1) as f64\n            * 0.7)\n        .clamp(0.2, 1.0);\n    let nutrient_factor = half_saturation(\n        state.water.ammonia_total_mg_n_total + state.water.nitrate_mg_n_total,\n        state.process_params.algae_half_saturation_n_mg_total,\n    )\n    .min(half_saturation(\n        state.water.phosphate_mg_p_total,\n        state.process_params.algae_half_saturation_p_mg_total,\n    ));\n    let microfauna_grazing = (state.microfauna.population_index\n        * (0.3 + 0.7 * state.microfauna.grazing_pressure_index))\n        .clamp(0.0, 1.0);\n\n    let suspended_seed_g = state.algae.suspended_biomass_g.max(0.02 * volume_l / 10.0);\n    let suspended_gross_growth_g = suspended_seed_g\n        * state.process_params.algae_max_growth_rate_per_day\n        * light_factor\n        * plant_shading\n        * temp_factor\n        * nutrient_factor;\n    let suspended_respiration_g =\n        state.algae.suspended_biomass_g * state.process_params.algae_respiration_fraction_per_day;\n    let suspended_grazing_g = state.algae.suspended_biomass_g * 0.03 * microfauna_grazing;\n    let suspended_new_g = (state.algae.suspended_biomass_g + suspended_gross_growth_g\n        - suspended_respiration_g\n        - suspended_grazing_g)\n        .max(0.0);\n    consume_algae_nutrients(\n        state,\n        suspended_gross_growth_g * ALGAE_N_MG_PER_G_GROWTH,\n        suspended_gross_growth_g * ALGAE_P_MG_PER_G_GROWTH,\n    );\n    state.algae.suspended_biomass_g = suspended_new_g;\n\n    let colonizable_area_m2 =\n        total_colonizable_area_cm2(&state.substrate_layers, state.geometry.wall_area_cm2())\n            / 10_000.0;\n    let periphyton_capacity_g =\n        colonizable_area_m2.max(0.0) * state.process_params.periphyton_capacity_g_per_m2;\n    let surface_cap_factor = if periphyton_capacity_g <= f64::EPSILON {\n        0.0\n    } else {\n        (1.0 - (state.algae.periphyton_biomass_g / periphyton_capacity_g)).clamp(0.0, 1.0)\n    };\n    let periphyton_seed_g = state.algae.periphyton_biomass_g.max(0.05);\n    let periphyton_gross_growth_g = periphyton_seed_g\n        * state.process_params.periphyton_max_growth_rate_per_day\n        * light_factor\n        * plant_shading\n        * temp_factor\n        * nutrient_factor\n        * surface_cap_factor;\n    let periphyton_respiration_g =\n        state.algae.periphyton_biomass_g * state.process_params.algae_respiration_fraction_per_day;\n    let periphyton_grazing_g = state.algae.periphyton_biomass_g * 0.06 * microfauna_grazing;\n    let periphyton_new_g = (state.algae.periphyton_biomass_g + periphyton_gross_growth_g\n        - periphyton_respiration_g\n        - periphyton_grazing_g)\n        .max(0.0)\n        .min(periphyton_capacity_g.max(0.0));\n    consume_algae_nutrients(\n        state,\n        periphyton_gross_growth_g * ALGAE_N_MG_PER_G_GROWTH,\n        periphyton_gross_growth_g * ALGAE_P_MG_PER_G_GROWTH,\n    );\n    state.algae.periphyton_biomass_g = periphyton_new_g;\n\n    let suspended_pressure = (state.algae.suspended_biomass_g / volume_l)\n        / state\n            .process_params\n            .algae_bloom_threshold_g_per_l\n            .max(f64::MIN_POSITIVE);\n    let periphyton_pressure = if periphyton_capacity_g <= f64::EPSILON {\n        0.0\n    } else {\n        state.algae.periphyton_biomass_g / periphyton_capacity_g\n    };\n    state.algae.nuisance_index =\n        (0.55 * suspended_pressure + 0.45 * periphyton_pressure).clamp(0.0, 1.0);\n\n    events::emit_daily_algae_events(state, previous_nuisance_index, periphyton_capacity_g);\n}\n\nfn algae_light_factor(state: &TankState) -> f64 {\n    if !state.hardware.light.enabled {\n        return 0.0;\n    }\n\n    let photoperiod_factor = (state.hardware.light.photoperiod_hours / 9.0).clamp(0.0, 1.0);\n    half_saturation(\n        state.hardware.light.intensity_index * photoperiod_factor,\n        state.process_params.algae_light_half_saturation,\n    )\n}\n\nfn consume_algae_nutrients(state: &mut TankState, n_demand_mg: f64, p_demand_mg: f64) {\n    let ammonia_removed = state.water.ammonia_total_mg_n_total.min(n_demand_mg * 0.6);\n    state.water.ammonia_total_mg_n_total -= ammonia_removed;\n\n    let remaining_n = (n_demand_mg - ammonia_removed).max(0.0);\n    let nitrate_removed = state.water.nitrate_mg_n_total.min(remaining_n);\n    state.water.nitrate_mg_n_total -= nitrate_removed;\n\n    let phosphate_removed = state.water.phosphate_mg_p_total.min(p_demand_mg);\n    state.water.phosphate_mg_p_total -= phosphate_removed;\n}\n\nfn half_saturation(value: f64, half_sat: f64) -> f64 {\n    let half_sat = half_sat.max(f64::MIN_POSITIVE);\n    (value / (value + half_sat)).clamp(0.0, 1.0)\n}\n\nfn gaussian_response(value: f64, optimum: f64, sigma: f64) -> f64 {\n    let sigma = sigma.max(0.1);\n    let diff = value - optimum;\n    (-(diff * diff) / (2.0 * sigma * sigma))\n        .exp()\n        .clamp(0.0, 1.0)\n}\n","numLines":149,"startLine":1,"totalLines":149}}}
