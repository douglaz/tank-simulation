ialEq for SimRng {\n    64→    fn eq(&self, other: &Self) -> bool {\n    65→        self.seed == other.seed && self.draws == other.draws\n    66→    }\n    67→}\n    68→\n    69→impl Eq for SimRng {}\n    70→\n    71→impl Serialize for SimRng {\n    72→    fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>\n    73→    where\n    74→        S: Serializer,\n    75→    {\n    76→        SimRngRepr {\n    77→            seed: self.seed,\n    78→            draws: self.draws,\n    79→        }\n    80→        .serialize(serializer)\n    81→    }\n    82→}\n    83→\n    84→impl<'de> Deserialize<'de> for SimRng {\n    85→    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>\n    86→    where\n    87→        D: Deserializer<'de>,\n    88→    {\n    89→        let repr = SimRngRepr::deserialize(deserializer)?;\n    90→        if repr.draws > u32::MAX as u64 && cfg!(debug_assertions) {\n    91→            return Err(D::Error::custom(\"draw count is unexpectedly large\"));\n    92→        }\n    93→        Ok(Self::from_repr(repr))\n    94→    }\n    95→}\n    96→\n    97→fn seed_to_bytes(seed: SimSeed) -> [u8; 32] {\n    98→    let mut bytes = [0_u8; 32];\n    99→    for (index, chunk) in bytes.chunks_mut(8).enumerate() {\n   100→        let word = seed\n   101→            .0\n   102→            .wrapping_add((index as u64).wrapping_mul(0x9E37_79B9_7F4A_7C15));\n   103→        chunk.copy_from_slice(&word.to_le_bytes());\n   104→    }\n   105→    bytes\n   106→}\n   107→"}]},"parent_tool_use_id":null,"session_id":"24615e58-d50c-4dac-86b6-bdc30a050fb6","uuid":"a4c940a5-f812-4ac8-a218-d5c2ddedffd8","tool_use_result":{"type":"text","file":{"filePath":"/root/tank-simulation/crates/tank_core/src/rng.rs","content":"use rand::{RngCore, SeedableRng};\nuse rand_chacha::ChaCha8Rng;\nuse serde::{de::Error as DeError, Deserialize, Deserializer, Serialize, Serializer};\n\n#[derive(Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq)]\npub struct SimSeed(pub u64);\n\n#[derive(Debug, Clone)]\npub struct SimRng {\n    seed: SimSeed,\n    draws: u64,\n    rng: ChaCha8Rng,\n}\n\n#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]\nstruct SimRngRepr {\n    seed: SimSeed,\n    draws: u64,\n}\n\nimpl SimRng {\n    pub fn new(seed: SimSeed) -> Self {\n        let rng = ChaCha8Rng::from_seed(seed_to_bytes(seed));\n        Self {\n            seed,\n            draws: 0,\n            rng,\n        }\n    }\n\n    pub fn seed(&self) -> SimSeed {\n        self.seed\n    }\n\n    pub fn draws(&self) -> u64 {\n        self.draws\n    }\n\n    pub fn next_u64(&mut self) -> u64 {\n        let value = self.rng.next_u64();\n        self.draws += 1;\n        value\n    }\n\n    pub fn next_f64(&mut self) -> f64 {\n        let value = self.next_u64();\n        (value as f64) / (u64::MAX as f64)\n    }\n\n    fn from_repr(repr: SimRngRepr) -> Self {\n        let mut rng = ChaCha8Rng::from_seed(seed_to_bytes(repr.seed));\n        for _ in 0..repr.draws {\n            let _ = rng.next_u64();\n        }\n        Self {\n            seed: repr.seed,\n            draws: repr.draws,\n            rng,\n        }\n    }\n}\n\nimpl PartialEq for SimRng {\n    fn eq(&self, other: &Self) -> bool {\n        self.seed == other.seed && self.draws == other.draws\n    }\n}\n\nimpl Eq for SimRng {}\n\nimpl Serialize for SimRng {\n    fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>\n    where\n        S: Serializer,\n    {\n        SimRngRepr {\n            seed: self.seed,\n            draws: self.draws,\n        }\n        .serialize(serializer)\n    }\n}\n\nimpl<'de> Deserialize<'de> for SimRng {\n    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>\n    where\n        D: Deserializer<'de>,\n    {\n        let repr = SimRngRepr::deserialize(deserializer)?;\n        if repr.draws > u32::MAX as u64 && cfg!(debug_assertions) {\n            return Err(D::Error::custom(\"draw count is unexpectedly large\"));\n        }\n        Ok(Self::from_repr(repr))\n    }\n}\n\nfn seed_to_bytes(seed: SimSeed) -> [u8; 32] {\n    let mut bytes = [0_u8; 32];\n    for (index, chunk) in bytes.chunks_mut(8).enumerate() {\n        let word = seed\n            .0\n            .wrapping_add((index as u64).wrapping_mul(0x9E37_79B9_7F4A_7C15));\n        chunk.copy_from_slice(&word.to_le_bytes());\n    }\n    bytes\n}\n","numLines":107,"startLine":1,"totalLines":107}}}
