{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015CUeFqeNadEzzsEKxcwAHu","type":"tool_result","content":"     1→use tank_core::{Engine, PlayerAction, ProcessParams, SimSeed, SimulationEngine, TankState};\n     2→\n     3→/// Creates a stocked shrimp scenario at the given ambient temperature.\n     4→fn stocked_scenario(seed: SimSeed, ambient_temp_c: f64) -> TankState {\n     5→    let geometry = tank_core::TankGeometry {\n     6→        length_cm: 40.0,\n     7→        width_cm: 30.0,\n     8→        height_cm: 35.0,\n     9→        fill_height_cm: 30.0,\n    10→        glass_thickness_mm: 5.0,\n    11→        open_top: true,\n    12→        lid_exchange_factor: 0.25,\n    13→    };\n    14→    let water = tank_core::WaterState::default_for_geometry(&geometry);\n    15→\n    16→    let mut state = TankState::new(seed);\n    17→    state.geometry = geometry;\n    18→    state.water = water;\n    19→    state.water.temperature_c = ambient_temp_c;\n    20→    state.environment.ambient_temp_c = ambient_temp_c;\n    21→\n    22→    // Good water quality for shrimp\n    23→    let vol = state.geometry.water_volume_l();\n    24→    state.water.calcium_mg_total = 40.0 * vol;\n    25→    state.water.magnesium_mg_total = 10.0 * vol;\n    26→    state.water.alkalinity_meq_total = 8.0 * vol;\n    27→    state.water.dissolved_inorganic_carbon_mg_c_total = 5.0 * vol;\n    28→    state.water.dissolved_oxygen_mg_total = 8.0 * vol;\n    29→    state.water.bicarbonate_mg_total = 300.0 * vol;\n    30→\n    31→    // Good periphyton for food\n    32→    state.algae.periphyton_biomass_g = 5.0;\n    33→\n    34→    // Strong nitrification (mature filter)\n    35→    state.microbe.decomposer_biomass_g = 0.1;\n    36→    state.microbe.ammonia_oxidizer_biomass_g = 0.8;\n    37→    state.microbe.nitrite_oxidizer_biomass_g = 0.5;\n    38→    state.microbe.comammox_biomass_g = 0.15;\n    39→    state.filter_state.biofilter_maturity_index = 1.0;\n    40→\n    41→    // Enable aeration\n    42→    state.hardware.aeration.enabled = true;\n    43→    state.hardware.aeration.intensity = 0.3;\n    44→\n    45→    // Good light for periphyton growth\n    46→    state.hardware.light.enabled = true;\n    47→    state.hardware.light.intensity_index = 0.6;\n    48→    state.hardware.light.photoperiod_hours = 8.0;\n    49→\n    50→    // Stock with 10 adult shrimp\n    51→    state.animal.adults_count = 10;\n    52→    state.animal.condition_index = 0.8;\n    53→    state.animal.molt_stress_index = 0.1;\n    54→    state.animal.reproductive_readiness_index = 0.5;\n    55→\n    56→    state.process_params = ProcessParams::default();\n    57→    state.process_params.aob_vmax_mg_n_per_g_per_hour = 5.0;\n    58→    state.process_params.nob_vmax_mg_n_per_g_per_hour = 5.0;\n    59→    state.process_params.periphyton_capacity_g_per_m2 = 30.0;\n    60→\n    61→    // Initialize stability tracker from actual state\n    62→    let ca_mg_l = state.water.calcium_mg_total / vol;\n    63→    let mg_mg_l = state.water.magnesium_mg_total / vol;\n    64→    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n    65→    state.stability_tracker.prev_temp_c = state.water.temperature_c;\n    66→    state.stability_tracker.prev_gh_d = gh_d;\n    67→    state.stability_tracker.prev_do_mg_l = state.water.dissolved_oxygen_mg_total / vol;\n    68→    state.stability_tracker.prev_ph = 7.5;\n    69→\n    70→    state\n    71→}\n    72→\n    73→#[test]\n    74→fn thermal_reproduction_penalty() -> Result<(), tank_core::SimError> {\n    75→    let cool_state = stocked_scenario(SimSeed(9000), 25.0);\n    76→    let warm_state = stocked_scenario(SimSeed(9000), 30.0);\n    77→\n    78→    let mut cool_engine = Engine::from_parts(cool_state, vec![]);\n    79→    let mut warm_engine = Engine::from_parts(warm_state, vec![]);\n    80→\n    81→    // Run for 20 days — long enough for readiness to stabilize but before\n    82→    // hatching (21-day egg cycle) disrupts the comparison via population dynamics.\n    83→    for _ in 0..20 {\n    84→        cool_engine.apply_action(PlayerAction::Feed { grams: 0.1 })?;\n    85→        warm_engine.apply_action(PlayerAction::Feed { grams: 0.1 })?;\n    86→        cool_engine.step_hours(24)?;\n    87→        warm_engine.step_hours(24)?;\n    88→    }\n    89→\n    90→    let cool_snap = cool_engine.snapshot();\n    91→    let warm_snap = warm_engine.snapshot();\n    92→\n    93→    // The 30°C tank must have at least 20% lower reproductive readiness\n    94→    let readiness_reduction = 1.0 - (warm_snap.shrimp_reproductive_readiness\n    95→        / cool_snap.shrimp_reproductive_readiness.max(f64::EPSILON));\n    96→    assert!(\n    97→        readiness_reduction >= 0.20,\n    98→        \"30°C tank should have at least 20% lower reproductive readiness than 25°C tank. \\\n    99→         Cool: {:.4}, Warm: {:.4}, Reduction: {:.2}%\",\n   100→        cool_snap.shrimp_reproductive_readiness,\n   101→        warm_snap.shrimp_reproductive_readiness,\n   102→        readiness_reduction * 100.0\n   103→    );\n   104→\n   105→    // Continue to 60 days for juvenile comparison\n   106→    for _ in 0..40 {\n   107→        cool_engine.apply_action(PlayerAction::Feed { grams: 0.1 })?;\n   108→        warm_engine.apply_action(PlayerAction::Feed { grams: 0.1 })?;\n   109→        cool_engine.step_hours(24)?;\n   110→        warm_engine.step_hours(24)?;\n   111→    }\n   112→\n   113→    let cool_snap_60 = cool_engine.snapshot();\n   114→    let warm_snap_60 = warm_engine.snapshot();\n   115→\n   116→    // Higher-temperature tank should produce fewer juveniles (or equal)\n   117→    // due to reduced spawning from thermal reproduction penalty\n   118→    let cool_total = cool_snap_60.adult_shrimp_count + cool_snap_60.juveniles_count;\n   119→    let warm_total = warm_snap_60.adult_shrimp_count + warm_snap_60.juveniles_count;\n   120→    assert!(\n   121→        warm_total <= cool_total || warm_snap_60.juveniles_count <= cool_snap_60.juveniles_count,\n   122→        \"30°C tank should have fewer or equal total population. Cool: {}, Warm: {}\",\n   123→        cool_total,\n   124→        warm_total\n   125→    );\n   126→\n   127→    Ok(())\n   128→}\n   129→"}]},"parent_tool_use_id":null,"session_id":"0854d63d-3c8e-45e0-9e18-d2c751830c9f","uuid":"5396be5c-bf7a-498c-b3e4-c17e602e10c3","tool_use_result":{"type":"text","file":{"filePath":"/root/tank-simulation/crates/tank_core/tests/thermal_reproduction_penalty.rs","content":"use tank_core::{Engine, PlayerAction, ProcessParams, SimSeed, SimulationEngine, TankState};\n\n/// Creates a stocked shrimp scenario at the given ambient temperature.\nfn stocked_scenario(seed: SimSeed, ambient_temp_c: f64) -> TankState {\n    let geometry = tank_core::TankGeometry {\n        length_cm: 40.0,\n        width_cm: 30.0,\n        height_cm: 35.0,\n        fill_height_cm: 30.0,\n        glass_thickness_mm: 5.0,\n        open_top: true,\n        lid_exchange_factor: 0.25,\n    };\n    let water = tank_core::WaterState::default_for_geometry(&geometry);\n\n    let mut state = TankState::new(seed);\n    state.geometry = geometry;\n    state.water = water;\n    state.water.temperature_c = ambient_temp_c;\n    state.environment.ambient_temp_c = ambient_temp_c;\n\n    // Good water quality for shrimp\n    let vol = state.geometry.water_volume_l();\n    state.water.calcium_mg_total = 40.0 * vol;\n    state.water.magnesium_mg_total = 10.0 * vol;\n    state.water.alkalinity_meq_total = 8.0 * vol;\n    state.water.dissolved_inorganic_carbon_mg_c_total = 5.0 * vol;\n    state.water.dissolved_oxygen_mg_total = 8.0 * vol;\n    state.water.bicarbonate_mg_total = 300.0 * vol;\n\n    // Good periphyton for food\n    state.algae.periphyton_biomass_g = 5.0;\n\n    // Strong nitrification (mature filter)\n    state.microbe.decomposer_biomass_g = 0.1;\n    state.microbe.ammonia_oxidizer_biomass_g = 0.8;\n    state.microbe.nitrite_oxidizer_biomass_g = 0.5;\n    state.microbe.comammox_biomass_g = 0.15;\n    state.filter_state.biofilter_maturity_index = 1.0;\n\n    // Enable aeration\n    state.hardware.aeration.enabled = true;\n    state.hardware.aeration.intensity = 0.3;\n\n    // Good light for periphyton growth\n    state.hardware.light.enabled = true;\n    state.hardware.light.intensity_index = 0.6;\n    state.hardware.light.photoperiod_hours = 8.0;\n\n    // Stock with 10 adult shrimp\n    state.animal.adults_count = 10;\n    state.animal.condition_index = 0.8;\n    state.animal.molt_stress_index = 0.1;\n    state.animal.reproductive_readiness_index = 0.5;\n\n    state.process_params = ProcessParams::default();\n    state.process_params.aob_vmax_mg_n_per_g_per_hour = 5.0;\n    state.process_params.nob_vmax_mg_n_per_g_per_hour = 5.0;\n    state.process_params.periphyton_capacity_g_per_m2 = 30.0;\n\n    // Initialize stability tracker from actual state\n    let ca_mg_l = state.water.calcium_mg_total / vol;\n    let mg_mg_l = state.water.magnesium_mg_total / vol;\n    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n    state.stability_tracker.prev_temp_c = state.water.temperature_c;\n    state.stability_tracker.prev_gh_d = gh_d;\n    state.stability_tracker.prev_do_mg_l = state.water.dissolved_oxygen_mg_total / vol;\n    state.stability_tracker.prev_ph = 7.5;\n\n    state\n}\n\n#[test]\nfn thermal_reproduction_penalty() -> Result<(), tank_core::SimError> {\n    let cool_state = stocked_scenario(SimSeed(9000), 25.0);\n    let warm_state = stocked_scenario(SimSeed(9000), 30.0);\n\n    let mut cool_engine = Engine::from_parts(cool_state, vec![]);\n    let mut warm_engine = Engine::from_parts(warm_state, vec![]);\n\n    // Run for 20 days — long enough for readiness to stabilize but before\n    // hatching (21-day egg cycle) disrupts the comparison via population dynamics.\n    for _ in 0..20 {\n        cool_engine.apply_action(PlayerAction::Feed { grams: 0.1 })?;\n        warm_engine.apply_action(PlayerAction::Feed { grams: 0.1 })?;\n        cool_engine.step_hours(24)?;\n        warm_engine.step_hours(24)?;\n    }\n\n    let cool_snap = cool_engine.snapshot();\n    let warm_snap = warm_engine.snapshot();\n\n    // The 30°C tank must have at least 20% lower reproductive readiness\n    let readiness_reduction = 1.0 - (warm_snap.shrimp_reproductive_readiness\n        / cool_snap.shrimp_reproductive_readiness.max(f64::EPSILON));\n    assert!(\n        readiness_reduction >= 0.20,\n        \"30°C tank should have at least 20% lower reproductive readiness than 25°C tank. \\\n         Cool: {:.4}, Warm: {:.4}, Reduction: {:.2}%\",\n        cool_snap.shrimp_reproductive_readiness,\n        warm_snap.shrimp_reproductive_readiness,\n        readiness_reduction * 100.0\n    );\n\n    // Continue to 60 days for juvenile comparison\n    for _ in 0..40 {\n        cool_engine.apply_action(PlayerAction::Feed { grams: 0.1 })?;\n        warm_engine.apply_action(PlayerAction::Feed { grams: 0.1 })?;\n        cool_engine.step_hours(24)?;\n        warm_engine.step_hours(24)?;\n    }\n\n    let cool_snap_60 = cool_engine.snapshot();\n    let warm_snap_60 = warm_engine.snapshot();\n\n    // Higher-temperature tank should produce fewer juveniles (or equal)\n    // due to reduced spawning from thermal reproduction penalty\n    let cool_total = cool_snap_60.adult_shrimp_count + cool_snap_60.juveniles_count;\n    let warm_total = warm_snap_60.adult_shrimp_count + warm_snap_60.juveniles_count;\n    assert!(\n        warm_total <= cool_total || warm_snap_60.juveniles_count <= cool_snap_60.juveniles_count,\n        \"30°C tank should have fewer or equal total population. Cool: {}, Warm: {}\",\n        cool_total,\n        warm_total\n    );\n\n    Ok(())\n}\n","numLines":129,"startLine":1,"totalLines":129}}}
