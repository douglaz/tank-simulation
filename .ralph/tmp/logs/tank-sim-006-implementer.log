{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GsHMzynihjDcSEPAv7gbxi","type":"tool_result","content":"     1→use crate::systems::chemistry::compute_nh3_mg_l;\n     2→use crate::types::{\n     3→    EventCause, EventKind, EventSeverity, ShrimpRuntimeParams, TankState,\n     4→};\n     5→\n     6→// ── Hourly ──────────────────────────────────────────────────────────────────\n     7→\n     8→/// Accumulates NH3, nitrite, low-DO, heat, and instability stress each hour.\n     9→/// Runs after chemistry/DO updates, before hourly event emission.\n    10→pub fn step_hourly_shrimp_stress(state: &mut TankState) {\n    11→    let total = state.animal.adults_count + state.animal.juveniles_count;\n    12→    if total == 0 {\n    13→        return;\n    14→    }\n    15→\n    16→    let volume_l = state.geometry.water_volume_l();\n    17→    if volume_l <= f64::EPSILON {\n    18→        return;\n    19→    }\n    20→\n    21→    let tan_mg_l = state.water.ammonia_total_mg_n_total / volume_l;\n    22→    let nh3_mg_l = compute_nh3_mg_l(tan_mg_l, state.water.ph, state.water.temperature_c);\n    23→    let nitrite_mg_l = state.water.nitrite_mg_n_total / volume_l;\n    24→    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n    25→    let temp = state.water.temperature_c;\n    26→\n    27→    // NH3 stress (threshold 0.02 mg/L, stronger than TAN alone)\n    28→    if nh3_mg_l > 0.02 {\n    29→        state.animal.hourly_nh3_stress_accum += (nh3_mg_l - 0.02) * 2.0 / 24.0;\n    30→    }\n    31→\n    32→    // Nitrite stress (threshold 0.5 mg/L)\n    33→    if nitrite_mg_l > 0.5 {\n    34→        state.animal.hourly_nitrite_stress_accum += (nitrite_mg_l - 0.5) * 0.5 / 24.0;\n    35→    }\n    36→\n    37→    // Low DO stress (threshold 5.0 mg/L)\n    38→    if do_mg_l < 5.0 {\n    39→        state.animal.hourly_low_do_stress_accum += (5.0 - do_mg_l) * 0.3 / 24.0;\n    40→    }\n    41→\n    42→    // Heat stress (above species optimal max)\n    43→    let opt_max = state.shrimp_params.optimal_temp_max_c;\n    44→    if temp > opt_max {\n    45→        state.animal.hourly_heat_stress_accum += (temp - opt_max) * 0.1 / 24.0;\n    46→    }\n    47→\n    48→    // Instability stress from stability tracker\n    49→    state.animal.hourly_instability_stress_accum +=\n    50→        state.stability_tracker.instability_index * 0.05 / 24.0;\n    51→}\n    52→\n    53→// ── Daily ───────────────────────────────────────────────────────────────────\n    54→\n    55→/// Full daily shrimp lifecycle: feeding → condition → molt stress →\n    56→/// reproductive readiness → spawning → egg development/hatching →\n    57→/// juvenile recruitment → mortality → events.\n    58→pub fn step_daily_shrimp(state: &mut TankState) {\n    59→    let total = state.animal.adults_count + state.animal.juveniles_count;\n    60→    if total == 0 && state.animal.berried_females_count == 0 {\n    61→        reset_hourly_accumulators(state);\n    62→        return;\n    63→    }\n    64→\n    65→    let volume_l = state.geometry.water_volume_l();\n    66→    if volume_l <= f64::EPSILON {\n    67→        reset_hourly_accumulators(state);\n    68→        return;\n    69→    }\n    70→\n    71→    shrimp_feeding(state, volume_l);\n    72→    update_condition(state, volume_l);\n    73→    update_molt_stress(state, volume_l);\n    74→    update_reproductive_readiness(state);\n    75→    spawning(state);\n    76→    egg_development(state);\n    77→    juvenile_recruitment(state);\n    78→    mortality(state);\n    79→    emit_molt_stress_warning(state, volume_l);\n    80→\n    81→    reset_hourly_accumulators(state);\n    82→}\n    83→\n    84→/// Updates the stability tracker at the end of each daily cycle.\n    85→pub fn update_stability_tracker(state: &mut TankState) {\n    86→    let volume_l = state.geometry.water_volume_l().max(f64::EPSILON);\n    87→    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n    88→    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n    89→    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n    90→    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n    91→\n    92→    let tracker = &mut state.stability_tracker;\n    93→\n    94→    let temp_swing = (state.water.temperature_c - tracker.prev_temp_c).abs();\n    95→    let ph_swing = (state.water.ph - tracker.prev_ph).abs();\n    96→    let gh_swing = (gh_d - tracker.prev_gh_d).abs();\n    97→    let do_swing = (do_mg_l - tracker.prev_do_mg_l).abs();\n    98→\n    99→    // Weighted instability normalised to 0..1\n   100→    let raw_instability =\n   101→        (temp_swing / 3.0 + ph_swing / 0.5 + gh_swing / 3.0 + do_swing / 3.0).clamp(0.0, 1.0);\n   102→\n   103→    // Rises quickly, decays slowly\n   104→    if raw_instability > tracker.instability_index {\n   105→        tracker.instability_index += 0.3 * (raw_instability - tracker.instability_index);\n   106→    } else {\n   107→        tracker.instability_index += 0.1 * (raw_instability - tracker.instability_index);\n   108→    }\n   109→    tracker.instability_index = tracker.instability_index.clamp(0.0, 1.0);\n   110→\n   111→    tracker.prev_temp_c = state.water.temperature_c;\n   112→    tracker.prev_ph = state.water.ph;\n   113→    tracker.prev_gh_d = gh_d;\n   114→    tracker.prev_do_mg_l = do_mg_l;\n   115→}\n   116→\n   117→// ── Private helpers ─────────────────────────────────────────────────────────\n   118→\n   119→fn shrimp_feeding(state: &mut TankState, _volume_l: f64) {\n   120→    let adults = state.animal.adults_count as f64;\n   121→    let juveniles = state.animal.juveniles_count as f64;\n   122→    let total_feeding_units = adults + juveniles * 0.3;\n   123→    let rate = state.process_params.shrimp_periphyton_grazing_g_per_shrimp_per_day;\n   124→    let food_demand = total_feeding_units * rate;\n   125→\n   126→    // Shrimp graze periphyton (at most 50% of available per day)\n   127→    let max_periph = state.algae.periphyton_biomass_g * 0.5;\n   128→    let periph_consumed = food_demand.min(max_periph).max(0.0);\n   129→    state.algae.periphyton_biomass_g =\n   130→        (state.algae.periphyton_biomass_g - periph_consumed).max(0.0);\n   131→\n   132→    // Shrimp also eat fine detritus (biofilm, decomposing organic matter)\n   133→    let detritus_demand = total_feeding_units * rate;\n   134→    let max_detritus = state.detritus.fine_detritus_g_total * 0.2;\n   135→    let detritus_consumed = detritus_demand.min(max_detritus).max(0.0);\n   136→    state.detritus.fine_detritus_g_total =\n   137→        (state.detritus.fine_detritus_g_total - detritus_consumed).max(0.0);\n   138→}\n   139→\n   140→fn update_condition(state: &mut TankState, volume_l: f64) {\n   141→    let tan_mg_l = state.water.ammonia_total_mg_n_total / volume_l;\n   142→    let nh3_mg_l = compute_nh3_mg_l(tan_mg_l, state.water.ph, state.water.temperature_c);\n   143→    let nitrite_mg_l = state.water.nitrite_mg_n_total / volume_l;\n   144→    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n   145→    let temp = state.water.temperature_c;\n   146→\n   147→    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n   148→    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n   149→    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n   150→\n   151→    let total_shrimp = state.animal.adults_count as f64 + state.animal.juveniles_count as f64;\n   152→    let available_food = state.algae.periphyton_biomass_g\n   153→        + state.detritus.fine_detritus_g_total * 0.3;\n   154→    let food_per_shrimp = if total_shrimp > 0.0 {\n   155→        available_food / total_shrimp\n   156→    } else {\n   157→        1.0\n   158→    };\n   159→\n   160→    let food_factor = (food_per_shrimp / 0.05).clamp(0.0, 1.0);\n   161→    let do_factor = (do_mg_l / 6.0).clamp(0.0, 1.0);\n   162→    // NH3 risk: condition degrades steadily, reaching zero at ~0.33 mg/L NH3\n   163→    let nh3_factor = (1.0 - nh3_mg_l * 3.0).clamp(0.0, 1.0);\n   164→    let nitrite_factor = (1.0 - nitrite_mg_l * 0.5).clamp(0.0, 1.0);\n   165→\n   166→    let params = &state.shrimp_params;\n   167→    let temp_factor = temp_condition_factor(temp, params);\n   168→    let gh_factor = gh_mineral_factor(gh_d, params);\n   169→    let instability_factor = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n   170→\n   171→    let stress_penalty = state.animal.hourly_nh3_stress_accum\n   172→        + state.animal.hourly_nitrite_stress_accum\n   173→        + state.animal.hourly_low_do_stress_accum\n   174→        + state.animal.hourly_heat_stress_accum\n   175→        + state.animal.hourly_instability_stress_accum;\n   176→\n   177→    let target = (food_factor\n   178→        * do_factor\n   179→        * nh3_factor\n   180→        * nitrite_factor\n   181→        * temp_factor\n   182→        * gh_factor\n   183→        * instability_factor\n   184→        - stress_penalty * 0.5)\n   185→        .clamp(0.0, 1.0);\n   186→\n   187→    let smoothing = state.process_params.shrimp_condition_smoothing;\n   188→    state.animal.condition_index += smoothing * (target - state.animal.condition_index);\n   189→    state.animal.condition_index = state.animal.condition_index.clamp(0.0, 1.0);\n   190→}\n   191→\n   192→fn update_molt_stress(state: &mut TankState, volume_l: f64) {\n   193→    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n   194→    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n   195→    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n   196→    let params = &state.shrimp_params;\n   197→\n   198→    let gh_stress = if gh_d < params.gh_min_d {\n   199→        (params.gh_min_d - gh_d) / params.gh_min_d\n   200→    } else {\n   201→        0.0\n   202→    };\n   203→\n   204→    let instability_stress = state.stability_tracker.instability_index;\n   205→    let condition_stress = (0.5 - state.animal.condition_index).max(0.0);\n   206→    let thermal_stress = if state.water.temperature_c > params.optimal_temp_max_c {\n   207→        ((state.water.temperature_c - params.optimal_temp_max_c) / 8.0).clamp(0.0, 0.5)\n   208→    } else {\n   209→        0.0\n   210→    };\n   211→\n   212→    let hourly_pressure =\n   213→        state.animal.hourly_heat_stress_accum + state.animal.hourly_instability_stress_accum;\n   214→\n   215→    let stress_pressure = (gh_stress * 0.3\n   216→        + instability_stress * 0.3\n   217→        + condition_stress * 0.2\n   218→        + thermal_stress * 0.2\n   219→        + hourly_pressure * 0.3)\n   220→        .clamp(0.0, 1.0);\n   221→\n   222→    // Rises quickly, decays slowly\n   223→    if stress_pressure > state.animal.molt_stress_index {\n   224→        state.animal.molt_stress_index +=\n   225→            0.2 * (stress_pressure - state.animal.molt_stress_index);\n   226→    } else {\n   227→        state.animal.molt_stress_index +=\n   228→            0.05 * (stress_pressure - state.animal.molt_stress_index);\n   229→    }\n   230→    state.animal.molt_stress_index = state.animal.molt_stress_index.clamp(0.0, 1.0);\n   231→}\n   232→\n   233→fn update_reproductive_readiness(state: &mut TankState) {\n   234→    let temp = state.water.temperature_c;\n   235→    let params = &state.shrimp_params;\n   236→\n   237→    let f_temp = temp_repro_factor(temp, params);\n   238→    let f_condition = state.animal.condition_index;\n   239→    let f_stability = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n   240→    let f_molt = (1.0 - state.animal.molt_stress_index).clamp(0.0, 1.0);\n   241→\n   242→    let target = (f_temp * f_condition * f_stability * f_molt).clamp(0.0, 1.0);\n   243→\n   244→    state.animal.reproductive_readiness_index +=\n   245→        0.1 * (target - state.animal.reproductive_readiness_index);\n   246→    state.animal.reproductive_readiness_index =\n   247→        state.animal.reproductive_readiness_index.clamp(0.0, 1.0);\n   248→}\n   249→\n   250→fn spawning(state: &mut TankState) {\n   251→    if state.animal.adults_count == 0 {\n   252→        return;\n   253→    }\n   254→\n   255→    let eligible = ((0.5 * state.animal.adults_count as f64)\n   256→        - state.animal.berried_females_count as f64)\n   257→        .max(0.0) as u32;\n   258→\n   259→    if eligible == 0 {\n   260→        return;\n   261→    }\n   262→\n   263→    let temp = state.water.temperature_c;\n   264→    let params = &state.shrimp_params;\n   265→\n   266→    let f_temp = temp_repro_factor(temp, params);\n   267→    let f_condition = state.animal.condition_index;\n   268→    let f_stability = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n   269→\n   270→    let volume_l = state.geometry.water_volume_l().max(f64::EPSILON);\n   271→    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n   272→    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n   273→    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n   274→    let f_mineral = gh_mineral_factor(gh_d, params);\n   275→\n   276→    let p_spawn = params.base_spawn_rate * f_temp * f_condition * f_stability * f_mineral;\n   277→\n   278→    let mut new_berried = 0u32;\n   279→    for _ in 0..eligible {\n   280→        if state.rng.next_f64() < p_spawn {\n   281→            new_berried += 1;\n   282→        }\n   283→    }\n   284→\n   285→    if new_berried > 0 {\n   286→        state.animal.berried_females_count += new_berried;\n   287→\n   288→        crate::systems::events::emit_once_per_day_pub(\n   289→            state,\n   290→            EventSeverity::Info,\n   291→            EventKind::ShrimpBerried,\n   292→            vec![EventCause::RoutineAction],\n   293→            format!(\"{new_berried} female(s) became berried\"),\n   294→        );\n   295→    }\n   296→}\n   297→\n   298→fn egg_development(state: &mut TankState) {\n   299→    if state.animal.berried_females_count == 0 {\n   300→        return;\n   301→    }\n   302→\n   303→    state.animal.egg_progress_days += 1.0;\n   304→\n   305→    if state.animal.egg_progress_days < state.shrimp_params.egg_duration_days as f64 {\n   306→        return;\n   307→    }\n   308→\n   309→    // Resolve clutch\n   310→    let berried = state.animal.berried_females_count;\n   311→    let volume_l = state.geometry.water_volume_l().max(f64::EPSILON);\n   312→    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n   313→    let temp = state.water.temperature_c;\n   314→    let params = &state.shrimp_params;\n   315→\n   316→    let f_condition = state.animal.condition_index;\n   317→    let f_oxygen = (do_mg_l / 6.0).clamp(0.0, 1.0);\n   318→    let f_temp = temp_repro_factor(temp, params);\n   319→    let f_stability = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n   320→\n   321→    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n   322→    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n   323→    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n   324→    let f_mineral = gh_mineral_factor(gh_d, params);\n   325→\n   326→    let p_hatch =\n   327→        params.hatch_success_base * f_condition * f_oxygen * f_temp * f_stability * f_mineral;\n   328→\n   329→    let mut successful = 0u32;\n   330→    let mut failed = 0u32;\n   331→    for _ in 0..berried {\n   332→        if state.rng.next_f64() < p_hatch {\n   333→            successful += 1;\n   334→        } else {\n   335→            failed += 1;\n   336→        }\n   337→    }\n   338→\n   339→    // Successful hatches produce juveniles (~25 per clutch for Neocaridina)\n   340→    let juveniles_per_clutch = 25u32;\n   341→    if successful > 0 {\n   342→        state.animal.juveniles_count += successful * juveniles_per_clutch;\n   343→    }\n   344→\n   345→    if failed > 0 {\n   346→        // Failure-mode invariant: on hatch failure, juveniles_count does NOT increase\n   347→        let mut causes = Vec::new();\n   348→        if f_oxygen < 0.6 {\n   349→            causes.push(EventCause::LowOxygen);\n   350→        }\n   351→        if f_temp < 0.5 {\n   352→            causes.push(EventCause::HighTemperature);\n   353→        }\n   354→        if f_mineral < 0.6 {\n   355→            causes.push(EventCause::LowMinerals);\n   356→        }\n   357→        if f_stability < 0.6 {\n   358→            causes.push(EventCause::ChemistryInstability);\n   359→        }\n   360→        if causes.is_empty() {\n   361→            causes.push(EventCause::PoorCondition);\n   362→        }\n   363→\n   364→        crate::systems::events::emit_once_per_day_pub(\n   365→            state,\n   366→            EventSeverity::Warning,\n   367→            EventKind::EggFailure,\n   368→            causes,\n   369→            format!(\"{failed} clutch(es) failed to hatch\"),\n   370→        );\n   371→    }\n   372→\n   373→    // All clutches resolved\n   374→    state.animal.berried_females_count = 0;\n   375→    state.animal.egg_progress_days = 0.0;\n   376→}\n   377→\n   378→fn juvenile_recruitment(state: &mut TankState) {\n   379→    if state.animal.juveniles_count == 0 {\n   380→        return;\n   381→    }\n   382→\n   383→    let maturation_rate =\n   384→        1.0 / state.process_params.shrimp_juvenile_maturation_days.max(1.0);\n   385→    let maturing = (state.animal.juveniles_count as f64 * maturation_rate).floor() as u32;\n   386→    let maturing = maturing.min(state.animal.juveniles_count);\n   387→\n   388→    state.animal.juveniles_count -= maturing;\n   389→    state.animal.adults_count += maturing;\n   390→}\n   391→\n   392→fn mortality(state: &mut TankState) {\n   393→    let base_rate = state.process_params.shrimp_base_mortality_per_day;\n   394→    let stress_scale = state.process_params.shrimp_stress_mortality_scale;\n   395→\n   396→    let stress_total = state.animal.hourly_nh3_stress_accum\n   397→        + state.animal.hourly_nitrite_stress_accum\n   398→        + state.animal.hourly_low_do_stress_accum\n   399→        + state.animal.hourly_heat_stress_accum\n   400→        + (state.animal.molt_stress_index - 0.5).max(0.0)\n   401→        + (0.5 - state.animal.condition_index).max(0.0);\n   402→\n   403→    let p_adult_death = (base_rate + stress_total * stress_scale).clamp(0.0, 0.5);\n   404→\n   405→    let juv_sensitivity = state.shrimp_params.juvenile_sensitivity;\n   406→    let p_juv_death = (base_rate + stress_total * stress_scale * juv_sensitivity).clamp(0.0, 0.5);\n   407→\n   408→    let mut adult_deaths = 0u32;\n   409→    for _ in 0..state.animal.adults_count {\n   410→        if state.rng.next_f64() < p_adult_death {\n   411→            adult_deaths += 1;\n   412→        }\n   413→    }\n   414→\n   415→    let mut juv_deaths = 0u32;\n   416→    for _ in 0..state.animal.juveniles_count {\n   417→        if state.rng.next_f64() < p_juv_death {\n   418→            juv_deaths += 1;\n   419→        }\n   420→    }\n   421→\n   422→    state.animal.adults_count = state.animal.adults_count.saturating_sub(adult_deaths);\n   423→    state.animal.juveniles_count = state.animal.juveniles_count.saturating_sub(juv_deaths);\n   424→\n   425→    // Preserve berried_females <= adults invariant\n   426→    if state.animal.berried_females_count > state.animal.adults_count {\n   427→        state.animal.berried_females_count = state.animal.adults_count;\n   428→    }\n   429→}\n   430→\n   431→fn emit_molt_stress_warning(state: &mut TankState, volume_l: f64) {\n   432→    if state.animal.molt_stress_index <= 0.6 {\n   433→        return;\n   434→    }\n   435→\n   436→    let mut causes = Vec::new();\n   437→    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n   438→    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n   439→    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n   440→\n   441→    if gh_d < state.shrimp_params.gh_min_d {\n   442→        causes.push(EventCause::LowMinerals);\n   443→    }\n   444→    if state.stability_tracker.instability_index > 0.3 {\n   445→        causes.push(EventCause::ChemistryInstability);\n   446→    }\n   447→    if state.water.temperature_c > state.shrimp_params.optimal_temp_max_c {\n   448→        causes.push(EventCause::HighTemperature);\n   449→    }\n   450→    if causes.is_empty() {\n   451→        causes.push(EventCause::PoorCondition);\n   452→    }\n   453→\n   454→    crate::systems::events::emit_once_per_day_pub(\n   455→        state,\n   456→        EventSeverity::Warning,\n   457→        EventKind::MoltStressWarning,\n   458→        causes,\n   459→        format!(\n   460→            \"Molt stress elevated: {:.2}\",\n   461→            state.animal.molt_stress_index\n   462→        ),\n   463→    );\n   464→}\n   465→\n   466→fn reset_hourly_accumulators(state: &mut TankState) {\n   467→    state.animal.hourly_nh3_stress_accum = 0.0;\n   468→    state.animal.hourly_nitrite_stress_accum = 0.0;\n   469→    state.animal.hourly_low_do_stress_accum = 0.0;\n   470→    state.animal.hourly_heat_stress_accum = 0.0;\n   471→    state.animal.hourly_instability_stress_accum = 0.0;\n   472→}\n   473→\n   474→// ── Factor functions ────────────────────────────────────────────────────────\n   475→\n   476→/// Temperature factor for reproduction.\n   477→/// Best 22–26 °C, clearly worse by 30 °C, near-zero by 33 °C.\n   478→fn temp_repro_factor(temp: f64, params: &ShrimpRuntimeParams) -> f64 {\n   479→    let opt_min = params.optimal_temp_min_c;\n   480→    let opt_max = params.optimal_temp_max_c;\n   481→    let penalty_start = params.high_temp_repro_penalty_start_c;\n   482→    let penalty_full = params.high_temp_repro_penalty_full_c;\n   483→\n   484→    if temp < opt_min - 4.0 {\n   485→        0.1\n   486→    } else if temp < opt_min {\n   487→        0.1 + 0.9 * (temp - (opt_min - 4.0)) / 4.0\n   488→    } else if temp <= opt_max {\n   489→        1.0\n   490→    } else if temp <= penalty_start {\n   491→        let range = (penalty_start - opt_max).max(0.01);\n   492→        1.0 - 0.5 * (temp - opt_max) / range\n   493→    } else if temp <= penalty_full {\n   494→        let range = (penalty_full - penalty_start).max(0.01);\n   495→        0.5 - 0.45 * (temp - penalty_start) / range\n   496→    } else {\n   497→        0.05\n   498→    }\n   499→}\n   500→\n   501→/// Temperature factor for general condition (broader bell than reproduction).\n   502→fn temp_condition_factor(temp: f64, params: &ShrimpRuntimeParams) -> f64 {\n   503→    if temp >= params.optimal_temp_min_c && temp <= params.optimal_temp_max_c {\n   504→        1.0\n   505→    } else if temp < params.optimal_temp_min_c {\n   506→        (1.0 - (params.optimal_temp_min_c - temp) / 10.0).clamp(0.2, 1.0)\n   507→    } else {\n   508→        (1.0 - (temp - params.optimal_temp_max_c) / 8.0).clamp(0.2, 1.0)\n   509→    }\n   510→}\n   511→\n   512→/// GH/mineral factor for spawning and condition.\n   513→fn gh_mineral_factor(gh_d: f64, params: &ShrimpRuntimeParams) -> f64 {\n   514→    if gh_d >= params.gh_min_d && gh_d <= params.gh_max_d {\n   515→        1.0\n   516→    } else if gh_d < params.gh_min_d {\n   517→        (gh_d / params.gh_min_d.max(0.01)).clamp(0.3, 1.0)\n   518→    } else {\n   519→        (1.0 - (gh_d - params.gh_max_d) / 10.0).clamp(0.3, 1.0)\n   520→    }\n   521→}\n   522→"}]},"parent_tool_use_id":null,"session_id":"0854d63d-3c8e-45e0-9e18-d2c751830c9f","uuid":"e3649b45-96f4-43b5-b393-cb0ff182cd17","tool_use_result":{"type":"text","file":{"filePath":"/root/tank-simulation/crates/tank_core/src/systems/shrimp.rs","content":"use crate::systems::chemistry::compute_nh3_mg_l;\nuse crate::types::{\n    EventCause, EventKind, EventSeverity, ShrimpRuntimeParams, TankState,\n};\n\n// ── Hourly ──────────────────────────────────────────────────────────────────\n\n/// Accumulates NH3, nitrite, low-DO, heat, and instability stress each hour.\n/// Runs after chemistry/DO updates, before hourly event emission.\npub fn step_hourly_shrimp_stress(state: &mut TankState) {\n    let total = state.animal.adults_count + state.animal.juveniles_count;\n    if total == 0 {\n        return;\n    }\n\n    let volume_l = state.geometry.water_volume_l();\n    if volume_l <= f64::EPSILON {\n        return;\n    }\n\n    let tan_mg_l = state.water.ammonia_total_mg_n_total / volume_l;\n    let nh3_mg_l = compute_nh3_mg_l(tan_mg_l, state.water.ph, state.water.temperature_c);\n    let nitrite_mg_l = state.water.nitrite_mg_n_total / volume_l;\n    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n    let temp = state.water.temperature_c;\n\n    // NH3 stress (threshold 0.02 mg/L, stronger than TAN alone)\n    if nh3_mg_l > 0.02 {\n        state.animal.hourly_nh3_stress_accum += (nh3_mg_l - 0.02) * 2.0 / 24.0;\n    }\n\n    // Nitrite stress (threshold 0.5 mg/L)\n    if nitrite_mg_l > 0.5 {\n        state.animal.hourly_nitrite_stress_accum += (nitrite_mg_l - 0.5) * 0.5 / 24.0;\n    }\n\n    // Low DO stress (threshold 5.0 mg/L)\n    if do_mg_l < 5.0 {\n        state.animal.hourly_low_do_stress_accum += (5.0 - do_mg_l) * 0.3 / 24.0;\n    }\n\n    // Heat stress (above species optimal max)\n    let opt_max = state.shrimp_params.optimal_temp_max_c;\n    if temp > opt_max {\n        state.animal.hourly_heat_stress_accum += (temp - opt_max) * 0.1 / 24.0;\n    }\n\n    // Instability stress from stability tracker\n    state.animal.hourly_instability_stress_accum +=\n        state.stability_tracker.instability_index * 0.05 / 24.0;\n}\n\n// ── Daily ───────────────────────────────────────────────────────────────────\n\n/// Full daily shrimp lifecycle: feeding → condition → molt stress →\n/// reproductive readiness → spawning → egg development/hatching →\n/// juvenile recruitment → mortality → events.\npub fn step_daily_shrimp(state: &mut TankState) {\n    let total = state.animal.adults_count + state.animal.juveniles_count;\n    if total == 0 && state.animal.berried_females_count == 0 {\n        reset_hourly_accumulators(state);\n        return;\n    }\n\n    let volume_l = state.geometry.water_volume_l();\n    if volume_l <= f64::EPSILON {\n        reset_hourly_accumulators(state);\n        return;\n    }\n\n    shrimp_feeding(state, volume_l);\n    update_condition(state, volume_l);\n    update_molt_stress(state, volume_l);\n    update_reproductive_readiness(state);\n    spawning(state);\n    egg_development(state);\n    juvenile_recruitment(state);\n    mortality(state);\n    emit_molt_stress_warning(state, volume_l);\n\n    reset_hourly_accumulators(state);\n}\n\n/// Updates the stability tracker at the end of each daily cycle.\npub fn update_stability_tracker(state: &mut TankState) {\n    let volume_l = state.geometry.water_volume_l().max(f64::EPSILON);\n    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n\n    let tracker = &mut state.stability_tracker;\n\n    let temp_swing = (state.water.temperature_c - tracker.prev_temp_c).abs();\n    let ph_swing = (state.water.ph - tracker.prev_ph).abs();\n    let gh_swing = (gh_d - tracker.prev_gh_d).abs();\n    let do_swing = (do_mg_l - tracker.prev_do_mg_l).abs();\n\n    // Weighted instability normalised to 0..1\n    let raw_instability =\n        (temp_swing / 3.0 + ph_swing / 0.5 + gh_swing / 3.0 + do_swing / 3.0).clamp(0.0, 1.0);\n\n    // Rises quickly, decays slowly\n    if raw_instability > tracker.instability_index {\n        tracker.instability_index += 0.3 * (raw_instability - tracker.instability_index);\n    } else {\n        tracker.instability_index += 0.1 * (raw_instability - tracker.instability_index);\n    }\n    tracker.instability_index = tracker.instability_index.clamp(0.0, 1.0);\n\n    tracker.prev_temp_c = state.water.temperature_c;\n    tracker.prev_ph = state.water.ph;\n    tracker.prev_gh_d = gh_d;\n    tracker.prev_do_mg_l = do_mg_l;\n}\n\n// ── Private helpers ─────────────────────────────────────────────────────────\n\nfn shrimp_feeding(state: &mut TankState, _volume_l: f64) {\n    let adults = state.animal.adults_count as f64;\n    let juveniles = state.animal.juveniles_count as f64;\n    let total_feeding_units = adults + juveniles * 0.3;\n    let rate = state.process_params.shrimp_periphyton_grazing_g_per_shrimp_per_day;\n    let food_demand = total_feeding_units * rate;\n\n    // Shrimp graze periphyton (at most 50% of available per day)\n    let max_periph = state.algae.periphyton_biomass_g * 0.5;\n    let periph_consumed = food_demand.min(max_periph).max(0.0);\n    state.algae.periphyton_biomass_g =\n        (state.algae.periphyton_biomass_g - periph_consumed).max(0.0);\n\n    // Shrimp also eat fine detritus (biofilm, decomposing organic matter)\n    let detritus_demand = total_feeding_units * rate;\n    let max_detritus = state.detritus.fine_detritus_g_total * 0.2;\n    let detritus_consumed = detritus_demand.min(max_detritus).max(0.0);\n    state.detritus.fine_detritus_g_total =\n        (state.detritus.fine_detritus_g_total - detritus_consumed).max(0.0);\n}\n\nfn update_condition(state: &mut TankState, volume_l: f64) {\n    let tan_mg_l = state.water.ammonia_total_mg_n_total / volume_l;\n    let nh3_mg_l = compute_nh3_mg_l(tan_mg_l, state.water.ph, state.water.temperature_c);\n    let nitrite_mg_l = state.water.nitrite_mg_n_total / volume_l;\n    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n    let temp = state.water.temperature_c;\n\n    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n\n    let total_shrimp = state.animal.adults_count as f64 + state.animal.juveniles_count as f64;\n    let available_food = state.algae.periphyton_biomass_g\n        + state.detritus.fine_detritus_g_total * 0.3;\n    let food_per_shrimp = if total_shrimp > 0.0 {\n        available_food / total_shrimp\n    } else {\n        1.0\n    };\n\n    let food_factor = (food_per_shrimp / 0.05).clamp(0.0, 1.0);\n    let do_factor = (do_mg_l / 6.0).clamp(0.0, 1.0);\n    // NH3 risk: condition degrades steadily, reaching zero at ~0.33 mg/L NH3\n    let nh3_factor = (1.0 - nh3_mg_l * 3.0).clamp(0.0, 1.0);\n    let nitrite_factor = (1.0 - nitrite_mg_l * 0.5).clamp(0.0, 1.0);\n\n    let params = &state.shrimp_params;\n    let temp_factor = temp_condition_factor(temp, params);\n    let gh_factor = gh_mineral_factor(gh_d, params);\n    let instability_factor = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n\n    let stress_penalty = state.animal.hourly_nh3_stress_accum\n        + state.animal.hourly_nitrite_stress_accum\n        + state.animal.hourly_low_do_stress_accum\n        + state.animal.hourly_heat_stress_accum\n        + state.animal.hourly_instability_stress_accum;\n\n    let target = (food_factor\n        * do_factor\n        * nh3_factor\n        * nitrite_factor\n        * temp_factor\n        * gh_factor\n        * instability_factor\n        - stress_penalty * 0.5)\n        .clamp(0.0, 1.0);\n\n    let smoothing = state.process_params.shrimp_condition_smoothing;\n    state.animal.condition_index += smoothing * (target - state.animal.condition_index);\n    state.animal.condition_index = state.animal.condition_index.clamp(0.0, 1.0);\n}\n\nfn update_molt_stress(state: &mut TankState, volume_l: f64) {\n    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n    let params = &state.shrimp_params;\n\n    let gh_stress = if gh_d < params.gh_min_d {\n        (params.gh_min_d - gh_d) / params.gh_min_d\n    } else {\n        0.0\n    };\n\n    let instability_stress = state.stability_tracker.instability_index;\n    let condition_stress = (0.5 - state.animal.condition_index).max(0.0);\n    let thermal_stress = if state.water.temperature_c > params.optimal_temp_max_c {\n        ((state.water.temperature_c - params.optimal_temp_max_c) / 8.0).clamp(0.0, 0.5)\n    } else {\n        0.0\n    };\n\n    let hourly_pressure =\n        state.animal.hourly_heat_stress_accum + state.animal.hourly_instability_stress_accum;\n\n    let stress_pressure = (gh_stress * 0.3\n        + instability_stress * 0.3\n        + condition_stress * 0.2\n        + thermal_stress * 0.2\n        + hourly_pressure * 0.3)\n        .clamp(0.0, 1.0);\n\n    // Rises quickly, decays slowly\n    if stress_pressure > state.animal.molt_stress_index {\n        state.animal.molt_stress_index +=\n            0.2 * (stress_pressure - state.animal.molt_stress_index);\n    } else {\n        state.animal.molt_stress_index +=\n            0.05 * (stress_pressure - state.animal.molt_stress_index);\n    }\n    state.animal.molt_stress_index = state.animal.molt_stress_index.clamp(0.0, 1.0);\n}\n\nfn update_reproductive_readiness(state: &mut TankState) {\n    let temp = state.water.temperature_c;\n    let params = &state.shrimp_params;\n\n    let f_temp = temp_repro_factor(temp, params);\n    let f_condition = state.animal.condition_index;\n    let f_stability = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n    let f_molt = (1.0 - state.animal.molt_stress_index).clamp(0.0, 1.0);\n\n    let target = (f_temp * f_condition * f_stability * f_molt).clamp(0.0, 1.0);\n\n    state.animal.reproductive_readiness_index +=\n        0.1 * (target - state.animal.reproductive_readiness_index);\n    state.animal.reproductive_readiness_index =\n        state.animal.reproductive_readiness_index.clamp(0.0, 1.0);\n}\n\nfn spawning(state: &mut TankState) {\n    if state.animal.adults_count == 0 {\n        return;\n    }\n\n    let eligible = ((0.5 * state.animal.adults_count as f64)\n        - state.animal.berried_females_count as f64)\n        .max(0.0) as u32;\n\n    if eligible == 0 {\n        return;\n    }\n\n    let temp = state.water.temperature_c;\n    let params = &state.shrimp_params;\n\n    let f_temp = temp_repro_factor(temp, params);\n    let f_condition = state.animal.condition_index;\n    let f_stability = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n\n    let volume_l = state.geometry.water_volume_l().max(f64::EPSILON);\n    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n    let f_mineral = gh_mineral_factor(gh_d, params);\n\n    let p_spawn = params.base_spawn_rate * f_temp * f_condition * f_stability * f_mineral;\n\n    let mut new_berried = 0u32;\n    for _ in 0..eligible {\n        if state.rng.next_f64() < p_spawn {\n            new_berried += 1;\n        }\n    }\n\n    if new_berried > 0 {\n        state.animal.berried_females_count += new_berried;\n\n        crate::systems::events::emit_once_per_day_pub(\n            state,\n            EventSeverity::Info,\n            EventKind::ShrimpBerried,\n            vec![EventCause::RoutineAction],\n            format!(\"{new_berried} female(s) became berried\"),\n        );\n    }\n}\n\nfn egg_development(state: &mut TankState) {\n    if state.animal.berried_females_count == 0 {\n        return;\n    }\n\n    state.animal.egg_progress_days += 1.0;\n\n    if state.animal.egg_progress_days < state.shrimp_params.egg_duration_days as f64 {\n        return;\n    }\n\n    // Resolve clutch\n    let berried = state.animal.berried_females_count;\n    let volume_l = state.geometry.water_volume_l().max(f64::EPSILON);\n    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n    let temp = state.water.temperature_c;\n    let params = &state.shrimp_params;\n\n    let f_condition = state.animal.condition_index;\n    let f_oxygen = (do_mg_l / 6.0).clamp(0.0, 1.0);\n    let f_temp = temp_repro_factor(temp, params);\n    let f_stability = (1.0 - state.stability_tracker.instability_index).clamp(0.0, 1.0);\n\n    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n    let f_mineral = gh_mineral_factor(gh_d, params);\n\n    let p_hatch =\n        params.hatch_success_base * f_condition * f_oxygen * f_temp * f_stability * f_mineral;\n\n    let mut successful = 0u32;\n    let mut failed = 0u32;\n    for _ in 0..berried {\n        if state.rng.next_f64() < p_hatch {\n            successful += 1;\n        } else {\n            failed += 1;\n        }\n    }\n\n    // Successful hatches produce juveniles (~25 per clutch for Neocaridina)\n    let juveniles_per_clutch = 25u32;\n    if successful > 0 {\n        state.animal.juveniles_count += successful * juveniles_per_clutch;\n    }\n\n    if failed > 0 {\n        // Failure-mode invariant: on hatch failure, juveniles_count does NOT increase\n        let mut causes = Vec::new();\n        if f_oxygen < 0.6 {\n            causes.push(EventCause::LowOxygen);\n        }\n        if f_temp < 0.5 {\n            causes.push(EventCause::HighTemperature);\n        }\n        if f_mineral < 0.6 {\n            causes.push(EventCause::LowMinerals);\n        }\n        if f_stability < 0.6 {\n            causes.push(EventCause::ChemistryInstability);\n        }\n        if causes.is_empty() {\n            causes.push(EventCause::PoorCondition);\n        }\n\n        crate::systems::events::emit_once_per_day_pub(\n            state,\n            EventSeverity::Warning,\n            EventKind::EggFailure,\n            causes,\n            format!(\"{failed} clutch(es) failed to hatch\"),\n        );\n    }\n\n    // All clutches resolved\n    state.animal.berried_females_count = 0;\n    state.animal.egg_progress_days = 0.0;\n}\n\nfn juvenile_recruitment(state: &mut TankState) {\n    if state.animal.juveniles_count == 0 {\n        return;\n    }\n\n    let maturation_rate =\n        1.0 / state.process_params.shrimp_juvenile_maturation_days.max(1.0);\n    let maturing = (state.animal.juveniles_count as f64 * maturation_rate).floor() as u32;\n    let maturing = maturing.min(state.animal.juveniles_count);\n\n    state.animal.juveniles_count -= maturing;\n    state.animal.adults_count += maturing;\n}\n\nfn mortality(state: &mut TankState) {\n    let base_rate = state.process_params.shrimp_base_mortality_per_day;\n    let stress_scale = state.process_params.shrimp_stress_mortality_scale;\n\n    let stress_total = state.animal.hourly_nh3_stress_accum\n        + state.animal.hourly_nitrite_stress_accum\n        + state.animal.hourly_low_do_stress_accum\n        + state.animal.hourly_heat_stress_accum\n        + (state.animal.molt_stress_index - 0.5).max(0.0)\n        + (0.5 - state.animal.condition_index).max(0.0);\n\n    let p_adult_death = (base_rate + stress_total * stress_scale).clamp(0.0, 0.5);\n\n    let juv_sensitivity = state.shrimp_params.juvenile_sensitivity;\n    let p_juv_death = (base_rate + stress_total * stress_scale * juv_sensitivity).clamp(0.0, 0.5);\n\n    let mut adult_deaths = 0u32;\n    for _ in 0..state.animal.adults_count {\n        if state.rng.next_f64() < p_adult_death {\n            adult_deaths += 1;\n        }\n    }\n\n    let mut juv_deaths = 0u32;\n    for _ in 0..state.animal.juveniles_count {\n        if state.rng.next_f64() < p_juv_death {\n            juv_deaths += 1;\n        }\n    }\n\n    state.animal.adults_count = state.animal.adults_count.saturating_sub(adult_deaths);\n    state.animal.juveniles_count = state.animal.juveniles_count.saturating_sub(juv_deaths);\n\n    // Preserve berried_females <= adults invariant\n    if state.animal.berried_females_count > state.animal.adults_count {\n        state.animal.berried_females_count = state.animal.adults_count;\n    }\n}\n\nfn emit_molt_stress_warning(state: &mut TankState, volume_l: f64) {\n    if state.animal.molt_stress_index <= 0.6 {\n        return;\n    }\n\n    let mut causes = Vec::new();\n    let ca_mg_l = state.water.calcium_mg_total / volume_l;\n    let mg_mg_l = state.water.magnesium_mg_total / volume_l;\n    let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n\n    if gh_d < state.shrimp_params.gh_min_d {\n        causes.push(EventCause::LowMinerals);\n    }\n    if state.stability_tracker.instability_index > 0.3 {\n        causes.push(EventCause::ChemistryInstability);\n    }\n    if state.water.temperature_c > state.shrimp_params.optimal_temp_max_c {\n        causes.push(EventCause::HighTemperature);\n    }\n    if causes.is_empty() {\n        causes.push(EventCause::PoorCondition);\n    }\n\n    crate::systems::events::emit_once_per_day_pub(\n        state,\n        EventSeverity::Warning,\n        EventKind::MoltStressWarning,\n        causes,\n        format!(\n            \"Molt stress elevated: {:.2}\",\n            state.animal.molt_stress_index\n        ),\n    );\n}\n\nfn reset_hourly_accumulators(state: &mut TankState) {\n    state.animal.hourly_nh3_stress_accum = 0.0;\n    state.animal.hourly_nitrite_stress_accum = 0.0;\n    state.animal.hourly_low_do_stress_accum = 0.0;\n    state.animal.hourly_heat_stress_accum = 0.0;\n    state.animal.hourly_instability_stress_accum = 0.0;\n}\n\n// ── Factor functions ────────────────────────────────────────────────────────\n\n/// Temperature factor for reproduction.\n/// Best 22–26 °C, clearly worse by 30 °C, near-zero by 33 °C.\nfn temp_repro_factor(temp: f64, params: &ShrimpRuntimeParams) -> f64 {\n    let opt_min = params.optimal_temp_min_c;\n    let opt_max = params.optimal_temp_max_c;\n    let penalty_start = params.high_temp_repro_penalty_start_c;\n    let penalty_full = params.high_temp_repro_penalty_full_c;\n\n    if temp < opt_min - 4.0 {\n        0.1\n    } else if temp < opt_min {\n        0.1 + 0.9 * (temp - (opt_min - 4.0)) / 4.0\n    } else if temp <= opt_max {\n        1.0\n    } else if temp <= penalty_start {\n        let range = (penalty_start - opt_max).max(0.01);\n        1.0 - 0.5 * (temp - opt_max) / range\n    } else if temp <= penalty_full {\n        let range = (penalty_full - penalty_start).max(0.01);\n        0.5 - 0.45 * (temp - penalty_start) / range\n    } else {\n        0.05\n    }\n}\n\n/// Temperature factor for general condition (broader bell than reproduction).\nfn temp_condition_factor(temp: f64, params: &ShrimpRuntimeParams) -> f64 {\n    if temp >= params.optimal_temp_min_c && temp <= params.optimal_temp_max_c {\n        1.0\n    } else if temp < params.optimal_temp_min_c {\n        (1.0 - (params.optimal_temp_min_c - temp) / 10.0).clamp(0.2, 1.0)\n    } else {\n        (1.0 - (temp - params.optimal_temp_max_c) / 8.0).clamp(0.2, 1.0)\n    }\n}\n\n/// GH/mineral factor for spawning and condition.\nfn gh_mineral_factor(gh_d: f64, params: &ShrimpRuntimeParams) -> f64 {\n    if gh_d >= params.gh_min_d && gh_d <= params.gh_max_d {\n        1.0\n    } else if gh_d < params.gh_min_d {\n        (gh_d / params.gh_min_d.max(0.01)).clamp(0.3, 1.0)\n    } else {\n        (1.0 - (gh_d - params.gh_max_d) / 10.0).clamp(0.3, 1.0)\n    }\n}\n","numLines":522,"startLine":1,"totalLines":522}}}
