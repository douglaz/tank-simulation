{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016Yyx1Y4Y6V3frEuSnJ6Z3P","type":"tool_result","content":"     1→mod presets;\n     2→\n     3→use serde::de::DeserializeOwned;\n     4→use thiserror::Error;\n     5→\n     6→pub use presets::{\n     7→    PlantPreset, ProcessParamsPreset, Provenance, ScenarioPreset, ShrimpPreset, SourceWaterPreset,\n     8→    SubstratePreset,\n     9→};\n    10→\n    11→#[derive(Debug, Error)]\n    12→pub enum PresetError {\n    13→    #[error(\"unknown preset `{id}` in category `{category}`\")]\n    14→    UnknownPreset { category: &'static str, id: String },\n    15→    #[error(\"failed to parse preset `{id}` in category `{category}`: {message}\")]\n    16→    Parse {\n    17→        category: &'static str,\n    18→        id: String,\n    19→        message: String,\n    20→    },\n    21→    #[error(\"validation failed for preset `{id}` in category `{category}`: {message}\")]\n    22→    Validation {\n    23→        category: &'static str,\n    24→        id: String,\n    25→        message: String,\n    26→    },\n    27→}\n    28→\n    29→pub fn load_source_water(id: &str) -> Result<SourceWaterPreset, PresetError> {\n    30→    let preset: SourceWaterPreset = load_from_registry(\"source_water\", id, SOURCE_WATER_PRESETS)?;\n    31→    preset\n    32→        .validate()\n    33→        .map_err(|message| PresetError::Validation {\n    34→            category: \"source_water\",\n    35→            id: id.to_string(),\n    36→            message,\n    37→        })?;\n    38→    Ok(preset)\n    39→}\n    40→\n    41→pub fn load_substrate(id: &str) -> Result<SubstratePreset, PresetError> {\n    42→    load_from_registry(\"substrate\", id, SUBSTRATE_PRESETS)\n    43→}\n    44→\n    45→pub fn load_plant(id: &str) -> Result<PlantPreset, PresetError> {\n    46→    load_from_registry(\"plants\", id, PLANT_PRESETS)\n    47→}\n    48→\n    49→pub fn load_shrimp(id: &str) -> Result<ShrimpPreset, PresetError> {\n    50→    load_from_registry(\"shrimp\", id, SHRIMP_PRESETS)\n    51→}\n    52→\n    53→pub fn load_process_params(id: &str) -> Result<ProcessParamsPreset, PresetError> {\n    54→    let preset: ProcessParamsPreset = load_from_registry(\"process\", id, PROCESS_PRESETS)?;\n    55→    preset\n    56→        .validate()\n    57→        .map_err(|message| PresetError::Validation {\n    58→            category: \"process\",\n    59→            id: id.to_string(),\n    60→            message,\n    61→        })?;\n    62→    Ok(preset)\n    63→}\n    64→\n    65→pub fn load_scenario(id: &str) -> Result<ScenarioPreset, PresetError> {\n    66→    load_from_registry(\"scenarios\", id, SCENARIO_PRESETS)\n    67→}\n    68→\n    69→pub fn source_water_ids() -> &'static [&'static str] {\n    70→    &[\"soft_acidic\", \"moderate\", \"hard_shrimp\", \"ro_like\"]\n    71→}\n    72→\n    73→pub fn substrate_ids() -> &'static [&'static str] {\n    74→    &[\n    75→        \"inert_sand\",\n    76→        \"inert_gravel\",\n    77→        \"active_planted\",\n    78→        \"coarse_porous\",\n    79→    ]\n    80→}\n    81→\n    82→pub fn plant_ids() -> &'static [&'static str] {\n    83→    &[\"fast_stem\", \"root_rosette\"]\n    84→}\n    85→\n    86→pub fn shrimp_ids() -> &'static [&'static str] {\n    87→    &[\"neocaridina_davidi\"]\n    88→}\n    89→\n    90→pub fn process_ids() -> &'static [&'static str] {\n    91→    &[\"default\"]\n    92→}\n    93→\n    94→pub fn scenario_ids() -> &'static [&'static str] {\n    95→    &[\"nano_cycle\", \"medium_planted\", \"warm_room\"]\n    96→}\n    97→\n    98→fn load_from_registry<T>(\n    99→    category: &'static str,\n   100→    id: &str,\n   101→    registry: &[(&str, &str)],\n   102→) -> Result<T, PresetError>\n   103→where\n   104→    T: DeserializeOwned,\n   105→{\n   106→    let Some((_, raw)) = registry.iter().find(|(entry_id, _)| *entry_id == id) else {\n   107→        return Err(PresetError::UnknownPreset {\n   108→            category,\n   109→            id: id.to_string(),\n   110→        });\n   111→    };\n   112→\n   113→    toml::from_str(raw).map_err(|error| PresetError::Parse {\n   114→        category,\n   115→        id: id.to_string(),\n   116→        message: error.to_string(),\n   117→    })\n   118→}\n   119→\n   120→const SOURCE_WATER_PRESETS: &[(&str, &str)] = &[\n   121→    (\n   122→        \"soft_acidic\",\n   123→        include_str!(\"../data/source_water/soft_acidic.toml\"),\n   124→    ),\n   125→    (\n   126→        \"moderate\",\n   127→        include_str!(\"../data/source_water/moderate.toml\"),\n   128→    ),\n   129→    (\n   130→        \"hard_shrimp\",\n   131→        include_str!(\"../data/source_water/hard_shrimp.toml\"),\n   132→    ),\n   133→    (\"ro_like\", include_str!(\"../data/source_water/ro_like.toml\")),\n   134→];\n   135→\n   136→const SUBSTRATE_PRESETS: &[(&str, &str)] = &[\n   137→    (\n   138→        \"inert_sand\",\n   139→        include_str!(\"../data/substrate/inert_sand.toml\"),\n   140→    ),\n   141→    (\n   142→        \"inert_gravel\",\n   143→        include_str!(\"../data/substrate/inert_gravel.toml\"),\n   144→    ),\n   145→    (\n   146→        \"active_planted\",\n   147→        include_str!(\"../data/substrate/active_planted.toml\"),\n   148→    ),\n   149→    (\n   150→        \"coarse_porous\",\n   151→        include_str!(\"../data/substrate/coarse_porous.toml\"),\n   152→    ),\n   153→];\n   154→\n   155→const PLANT_PRESETS: &[(&str, &str)] = &[\n   156→    (\"fast_stem\", include_str!(\"../data/plants/fast_stem.toml\")),\n   157→    (\n   158→        \"root_rosette\",\n   159→        include_str!(\"../data/plants/root_rosette.toml\"),\n   160→    ),\n   161→];\n   162→\n   163→const SHRIMP_PRESETS: &[(&str, &str)] = &[(\n   164→    \"neocaridina_davidi\",\n   165→    include_str!(\"../data/shrimp/neocaridina_davidi.toml\"),\n   166→)];\n   167→\n   168→const PROCESS_PRESETS: &[(&str, &str)] =\n   169→    &[(\"default\", include_str!(\"../data/process/default.toml\"))];\n   170→\n   171→const SCENARIO_PRESETS: &[(&str, &str)] = &[\n   172→    (\n   173→        \"nano_cycle\",\n   174→        include_str!(\"../data/scenarios/nano_cycle.toml\"),\n   175→    ),\n   176→    (\n   177→        \"medium_planted\",\n   178→        include_str!(\"../data/scenarios/medium_planted.toml\"),\n   179→    ),\n   180→    (\n   181→        \"warm_room\",\n   182→        include_str!(\"../data/scenarios/warm_room.toml\"),\n   183→    ),\n   184→];\n   185→"}]},"parent_tool_use_id":"toolu_012jEMhEWvYFGYWRGz2ymnxp","session_id":"0854d63d-3c8e-45e0-9e18-d2c751830c9f","uuid":"5571bab9-b8fe-4876-be23-0aa8d28966d8"}
