9→        Self {\n   120→            particulate_organics_g_total: 0.0,\n   121→            fine_detritus_g_total: 0.0,\n   122→            dissolved_feed_residue_g_total: 0.0,\n   123→        }\n   124→    }\n   125→}\n   126→\n   127→impl PlantGuildState {\n   128→    pub fn water_column_uptake_bias(&self) -> f64 {\n   129→        match self.guild {\n   130→            PlantGuild::FastStem => 0.9,\n   131→            PlantGuild::RootFeedingRosette => 0.1,\n   132→        }\n   133→    }\n   134→\n   135→    pub fn substrate_uptake_bias(&self) -> f64 {\n   136→        match self.guild {\n   137→            PlantGuild::FastStem => 0.1,\n   138→            PlantGuild::RootFeedingRosette => 0.9,\n   139→        }\n   140→    }\n   141→}\n   142→\n   143→pub fn total_colonizable_area_cm2(\n   144→    substrate_layers: &[SubstrateLayerState],\n   145→    wall_area_cm2: f64,\n   146→) -> f64 {\n   147→    wall_area_cm2\n   148→        + substrate_layers\n   149→            .iter()\n   150→            .map(|layer| layer.colonizable_area_cm2)\n   151→            .sum::<f64>()\n   152→}\n   153→"}]},"parent_tool_use_id":"toolu_01QNfK3MMAsHMrHY8fFkskyB","session_id":"24615e58-d50c-4dac-86b6-bdc30a050fb6","uuid":"e919b83c-28ba-48fe-92bc-65ce38bb6a3e"}
