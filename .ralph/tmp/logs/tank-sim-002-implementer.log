{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0116wdxSkBMBDk38wQ8Croj1","type":"tool_result","content":"     1→mod presets;\n     2→\n     3→use serde::de::DeserializeOwned;\n     4→use thiserror::Error;\n     5→\n     6→pub use presets::{\n     7→    PlantPreset, ProcessParamsPreset, Provenance, ScenarioPreset, ShrimpPreset, SourceWaterPreset,\n     8→    SubstratePreset,\n     9→};\n    10→\n    11→#[derive(Debug, Error)]\n    12→pub enum PresetError {\n    13→    #[error(\"unknown preset `{id}` in category `{category}`\")]\n    14→    UnknownPreset { category: &'static str, id: String },\n    15→    #[error(\"failed to parse preset `{id}` in category `{category}`: {message}\")]\n    16→    Parse {\n    17→        category: &'static str,\n    18→        id: String,\n    19→        message: String,\n    20→    },\n    21→}\n    22→\n    23→pub fn load_source_water(id: &str) -> Result<SourceWaterPreset, PresetError> {\n    24→    load_from_registry(\"source_water\", id, SOURCE_WATER_PRESETS)\n    25→}\n    26→\n    27→pub fn load_substrate(id: &str) -> Result<SubstratePreset, PresetError> {\n    28→    load_from_registry(\"substrate\", id, SUBSTRATE_PRESETS)\n    29→}\n    30→\n    31→pub fn load_plant(id: &str) -> Result<PlantPreset, PresetError> {\n    32→    load_from_registry(\"plants\", id, PLANT_PRESETS)\n    33→}\n    34→\n    35→pub fn load_shrimp(id: &str) -> Result<ShrimpPreset, PresetError> {\n    36→    load_from_registry(\"shrimp\", id, SHRIMP_PRESETS)\n    37→}\n    38→\n    39→pub fn load_process_params(id: &str) -> Result<ProcessParamsPreset, PresetError> {\n    40→    load_from_registry(\"process\", id, PROCESS_PRESETS)\n    41→}\n    42→\n    43→pub fn load_scenario(id: &str) -> Result<ScenarioPreset, PresetError> {\n    44→    load_from_registry(\"scenarios\", id, SCENARIO_PRESETS)\n    45→}\n    46→\n    47→pub fn source_water_ids() -> &'static [&'static str] {\n    48→    &[\"soft_acidic\", \"moderate\", \"hard_shrimp\", \"ro_like\"]\n    49→}\n    50→\n    51→pub fn substrate_ids() -> &'static [&'static str] {\n    52→    &[\n    53→        \"inert_sand\",\n    54→        \"inert_gravel\",\n    55→        \"active_planted\",\n    56→        \"coarse_porous\",\n    57→    ]\n    58→}\n    59→\n    60→pub fn plant_ids() -> &'static [&'static str] {\n    61→    &[\"fast_stem\", \"root_rosette\"]\n    62→}\n    63→\n    64→pub fn shrimp_ids() -> &'static [&'static str] {\n    65→    &[\"neocaridina_davidi\"]\n    66→}\n    67→\n    68→pub fn process_ids() -> &'static [&'static str] {\n    69→    &[\"default\"]\n    70→}\n    71→\n    72→pub fn scenario_ids() -> &'static [&'static str] {\n    73→    &[\"nano_cycle\", \"medium_planted\", \"warm_room\"]\n    74→}\n    75→\n    76→fn load_from_registry<T>(\n    77→    category: &'static str,\n    78→    id: &str,\n    79→    registry: &[(&str, &str)],\n    80→) -> Result<T, PresetError>\n    81→where\n    82→    T: DeserializeOwned,\n    83→{\n    84→    let Some((_, raw)) = registry.iter().find(|(entry_id, _)| *entry_id == id) else {\n    85→        return Err(PresetError::UnknownPreset {\n    86→            category,\n    87→            id: id.to_string(),\n    88→        });\n    89→    };\n    90→\n    91→    toml::from_str(raw).map_err(|error| PresetError::Parse {\n    92→        category,\n    93→        id: id.to_string(),\n    94→        message: error.to_string(),\n    95→    })\n    96→}\n    97→\n    98→const SOURCE_WATER_PRESETS: &[(&str, &str)] = &[\n    99→    (\n   100→        \"soft_acidic\",\n   101→        include_str!(\"../data/source_water/soft_acidic.toml\"),\n   102→    ),\n   103→    (\n   104→        \"moderate\",\n   105→        include_str!(\"../data/source_water/moderate.toml\"),\n   106→    ),\n   107→    (\n   108→        \"hard_shrimp\",\n   109→        include_str!(\"../data/source_water/hard_shrimp.toml\"),\n   110→    ),\n   111→    (\"ro_like\", include_str!(\"../data/source_water/ro_like.toml\")),\n   112→];\n   113→\n   114→const SUBSTRATE_PRESETS: &[(&str, &str)] = &[\n   115→    (\n   116→        \"inert_sand\",\n   117→        include_str!(\"../data/substrate/inert_sand.toml\"),\n   118→    ),\n   119→    (\n   120→        \"inert_gravel\",\n   121→        include_str!(\"../data/substrate/inert_gravel.toml\"),\n   122→    ),\n   123→    (\n   124→        \"active_planted\",\n   125→        include_str!(\"../data/substrate/active_planted.toml\"),\n   126→    ),\n   127→    (\n   128→        \"coarse_porous\",\n   129→        include_str!(\"../data/substrate/coarse_porous.toml\"),\n   130→    ),\n   131→];\n   132→\n   133→const PLANT_PRESETS: &[(&str, &str)] = &[\n   134→    (\"fast_stem\", include_str!(\"../data/plants/fast_stem.toml\")),\n   135→    (\n   136→        \"root_rosette\",\n   137→        include_str!(\"../data/plants/root_rosette.toml\"),\n   138→    ),\n   139→];\n   140→\n   141→const SHRIMP_PRESETS: &[(&str, &str)] = &[(\n   142→    \"neocaridina_davidi\",\n   143→    include_str!(\"../data/shrimp/neocaridina_davidi.toml\"),\n   144→)];\n   145→\n   146→const PROCESS_PRESETS: &[(&str, &str)] =\n   147→    &[(\"default\", include_str!(\"../data/process/default.toml\"))];\n   148→\n   149→const SCENARIO_PRESETS: &[(&str, &str)] = &[\n   150→    (\n   151→        \"nano_cycle\",\n   152→        include_str!(\"../data/scenarios/nano_cycle.toml\"),\n   153→    ),\n   154→    (\n   155→        \"medium_planted\",\n   156→        include_str!(\"../data/scenarios/medium_planted.toml\"),\n   157→    ),\n   158→    (\n   159→        \"warm_room\",\n   160→        include_str!(\"../data/scenarios/warm_room.toml\"),\n   161→    ),\n   162→];\n   163→"}]},"parent_tool_use_id":"toolu_01NTJRfgX9Yf8u1ahRrw9C8p","session_id":"6caedeb9-3152-4257-893d-1059836ae04b","uuid":"120c142d-2e36-4819-a2b7-b8f26f95fbe9"}
