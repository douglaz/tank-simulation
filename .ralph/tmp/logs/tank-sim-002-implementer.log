{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BUXRCWUTDySPjDR75XJJ8V","type":"tool_result","content":"     1→use tank_core::{Engine, PlayerAction, SimError, SimSeed, SimulationEngine};\n     2→\n     3→#[test]\n     4→fn action_validation() {\n     5→    let mut engine = Engine::new(SimSeed(9));\n     6→\n     7→    assert_eq!(\n     8→        engine.apply_action(PlayerAction::Feed { grams: -0.1 }),\n     9→        Err(SimError::NegativeValue {\n    10→            field: \"grams\",\n    11→            value: -0.1,\n    12→        })\n    13→    );\n    14→    assert_eq!(\n    15→        engine.apply_action(PlayerAction::WaterChangePercent {\n    16→            percent: 120.0,\n    17→            source_profile_id: \"moderate\".to_string(),\n    18→        }),\n    19→        Err(SimError::PercentOutOfRange {\n    20→            field: \"percent\",\n    21→            value: 120.0,\n    22→        })\n    23→    );\n    24→    assert_eq!(\n    25→        engine.apply_action(PlayerAction::TrimPlants { fraction: 1.1 }),\n    26→        Err(SimError::FractionOutOfRange {\n    27→            field: \"fraction\",\n    28→            value: 1.1,\n    29→        })\n    30→    );\n    31→    assert_eq!(\n    32→        engine.apply_action(PlayerAction::CleanFilter { intensity: -0.5 }),\n    33→        Err(SimError::FractionOutOfRange {\n    34→            field: \"intensity\",\n    35→            value: -0.5,\n    36→        })\n    37→    );\n    38→    assert_eq!(\n    39→        engine.apply_action(PlayerAction::ChangeLightIntensity {\n    40→            intensity_index: 1.2,\n    41→        }),\n    42→        Err(SimError::FractionOutOfRange {\n    43→            field: \"intensity_index\",\n    44→            value: 1.2,\n    45→        })\n    46→    );\n    47→    assert_eq!(\n    48→        engine.apply_action(PlayerAction::ChangeAmbientTemperature { target_c: 0.0 }),\n    49→        Err(SimError::TemperatureTooLow {\n    50→            field: \"target_c\",\n    51→            value: 0.0,\n    52→        })\n    53→    );\n    54→}\n    55→\n    56→#[test]\n    57→fn action_queuing() -> Result<(), tank_core::SimError> {\n    58→    let mut engine = Engine::new(SimSeed(12));\n    59→\n    60→    engine.apply_action(PlayerAction::RemoveShrimp { count: 1 })?;\n    61→    engine.apply_action(PlayerAction::AddShrimp { count: 1 })?;\n    62→    engine.step_hours(1)?;\n    63→\n    64→    assert_eq!(engine.full_state().animal.adults_count, 1);\n    65→\n    66→    Ok(())\n    67→}\n    68→"}]},"parent_tool_use_id":"toolu_01NTJRfgX9Yf8u1ahRrw9C8p","session_id":"6caedeb9-3152-4257-893d-1059836ae04b","uuid":"2fd1005b-4983-4424-990b-a54a4ba36e35"}
