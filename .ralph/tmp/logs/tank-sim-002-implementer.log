{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EHDa45LWFWKinaWtKNE7Wk","type":"tool_result","content":"     1→use tank_core::{PlayerAction, TankSnapshot};\n     2→\n     3→#[derive(Debug, Clone, PartialEq)]\n     4→pub enum Screen {\n     5→    Overview,\n     6→    Chemistry,\n     7→    Biology,\n     8→    Actions,\n     9→    Log,\n    10→}\n    11→\n    12→#[derive(Debug, Clone, PartialEq)]\n    13→pub struct TuiApp {\n    14→    pub active_screen: Screen,\n    15→    pub snapshot: TankSnapshot,\n    16→    pub pending_actions: Vec<PlayerAction>,\n    17→}\n    18→\n    19→impl TuiApp {\n    20→    pub fn new(snapshot: TankSnapshot) -> Self {\n    21→        Self {\n    22→            active_screen: Screen::Overview,\n    23→            snapshot,\n    24→            pending_actions: Vec::new(),\n    25→        }\n    26→    }\n    27→\n    28→    pub fn queue_action(&mut self, action: PlayerAction) {\n    29→        self.pending_actions.push(action);\n    30→    }\n    31→\n    32→    pub fn update_snapshot(&mut self, snapshot: TankSnapshot) {\n    33→        self.snapshot = snapshot;\n    34→    }\n    35→}\n    36→"}]},"parent_tool_use_id":"toolu_01NTJRfgX9Yf8u1ahRrw9C8p","session_id":"6caedeb9-3152-4257-893d-1059836ae04b","uuid":"a8289ea4-7e40-47bb-90b4-8013548073ea"}
