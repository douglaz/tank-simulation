to `tank_core::ProcessParams`.\n    40→fn process_preset_to_params(preset: &tank_data::ProcessParamsPreset) -> ProcessParams {\n    41→    ProcessParams {\n    42→        mineralization_rate_per_day: preset.mineralization_rate_per_day,\n    43→        nitrification_vmax: preset.nitrification_vmax,\n    44→        reaeration_kla: preset.reaeration_kla,\n    45→        k_surface_w_per_m2_k: preset.k_surface_w_per_m2_k,\n    46→        k_wall_w_per_m2_k: preset.k_wall_w_per_m2_k,\n    47→    }\n    48→}\n    49→\n    50→/// Materializes a scenario preset into a fully resolved `TankState`.\n    51→///\n    52→/// - Geometry comes from the scenario.\n    53→/// - `environment.ambient_temp_c` comes from the scenario.\n    54→/// - Initial `WaterState` totals come from the source-water profile × fill volume.\n    55→/// - Substrate layers come from the scenario's substrate preset IDs.\n    56→/// - Plant guilds come from the scenario's plant preset IDs.\n    57→/// - Source-water catalog is populated with all known source-water presets.\n    58→/// - Process parameters come from the scenario's process params preset.\n    59→pub fn seeded_state(seed: SimSeed, scenario_id: &str) -> Result<TankState, tank_data::PresetError> {\n    60→    let scenario = load_named_scenario(scenario_id)?;\n    61→\n    62→    // Geometry\n    63→    let geometry = TankGeometry {\n    64→        length_cm: scenario.tank_length_cm,\n    65→        width_cm: scenario.tank_width_cm,\n    66→        height_cm: scenario.tank_height_cm,\n    67→        fill_height_cm: scenario.fill_height_cm,\n    68→        glass_thickness_mm: 5.0,\n    69→        open_top: true,\n    70→        lid_exchange_factor: 0.25,\n    71→    };\n    72→\n    73→    // Source water profile for initial fill\n    74→    let source_water_preset = tank_data::load_source_water(&scenario.source_water_id)?;\n    75→    let source_profile = source_water_to_profile(&source_water_preset);\n    76→\n    77→    // Initial water state from source-water profile\n    78→    let water = WaterState::from_source_profile(&source_profile, &geometry);\n    79→\n    80→    // Build source-water catalog with all known presets\n    81→    let mut source_water_catalog = BTreeMap::new();\n    82→    for sw_id in tank_data::source_water_ids() {\n    83→        let sw_preset = tank_data::load_source_water(sw_id)?;\n    84→        source_water_catalog.insert(sw_id.to_string(), source_water_to_profile(&sw_preset));\n    85→    }\n    86→\n    87→    // Process parameters\n    88→    let process_preset = tank_data::load_process_params(&scenario.process_params_id)?;\n    89→    let process_params = process_preset_to_params(&process_preset);\n    90→\n    91→    // Substrate layers\n    92→    let mut substrate_layers = Vec::new();\n    93→    for sub_id in &scenario.substrate_ids {\n    94→        let sub_preset = tank_data::load_substrate(sub_id)?;\n    95→        let footprint = geometry.footprint_area_cm2();\n    96→        substrate_layers.push(SubstrateLayerState {\n    97→            kind: match sub_preset.id.as_str() {\n    98→                \"inert_sand\" => tank_core::SubstrateKind::InertSand,\n    99→                \"inert_gravel\" => tank_core::SubstrateKind::InertGravel,\n   100→                \"active_planted\" => tank_core::SubstrateKind::ActivePlanted,\n   101→                \"coarse_porous\" => tank_core::SubstrateKind::CoarsePorous,\n   102→                _ => tank_core::SubstrateKind::InertSand,\n   103→            },\n   104→            depth_cm: sub_preset.depth_cm,\n   105→            nutrient_store_mg_n_total: sub_preset.nutrient_charge_mg_n_total,\n   106→            nutrient_store_mg_p_total: sub_preset.nutrient_charge_mg_p_total,\n   107→            cation_exchange_capacity_index: sub_preset.cation_exchange_capacity_index,\n   108→            detritus_trapping_index: sub_preset.detritus_trapping_index,\n   109→            colonizable_area_cm2: footprint * sub_preset.colonizable_area_factor,\n   110→            low_oxygen_tendency_index: sub_preset.low_oxygen_tendency_index,\n   111→            grazing_surface_index: sub_preset.grazing_surface_index,\n   112→        });\n   113→    }\n   114→    if substrate_layers.is_empty() {\n   115→        substrate_layers.push(SubstrateLayerState::default());\n   116→    }\n   117→\n   118→    // Plant guilds\n   119→    let mut plant_guilds = Vec::new();\n   120→    for plant_id in &scenario.plant_ids {\n   121→        let plant_preset = tank_data::load_plant(plant_id)?;\n   122→        let guild = match plant_preset.guild.as_str() {\n   123→            \"FastStem\" => PlantGuild::FastStem,\n   124→            \"RootFeedingRosette\" => PlantGuild::RootFeedingRosette,\n   125→            _ => PlantGuild::FastStem,\n   126→        };\n   127→        plant_guilds.push(PlantGuildState {\n   128→            guild,\n   129→            biomass_g: 5.0,\n   130→            health_index: 0.8,\n   131→            crowding_index: 0.1,\n   132→            habitat_index: if guild == PlantGuild::RootFeedingRosette {\n   133→                // Habitat factor depends on substrate quality\n   134→                substrate_layers\n   135→                    .iter()\n   136→                    .map(|l| l.cation_exchange_capacity_index)\n   137→                    .fold(0.0_f64, f64::max)\n   138→                    .max(0.3)\n   139→            } else {\n   140→                0.8\n   141→            },\n   142→        });\n   143→    }\n   144→    if plant_guilds.is_empty() {\n   145→        plant_guilds.push(PlantGuildState::default());\n   146→    }\n   147→\n   148→    // Environment\n   149→    let mut environment = tank_core::EnvironmentState::default();\n   150→    environment.ambient_temp_c = scenario.ambient_temp_c;\n   151→\n   152→    let mut state = TankState::new(seed);\n   153→    state.meta = SimMeta {\n   154→        scenario_id: Some(scenario.id),\n   155→        notes: Some(scenario.name),\n   156→    };\n   157→    state.geometry = geometry;\n   158→    state.environment = environment;\n   159→    state.water = water;\n   160→    state.substrate_layers = substrate_layers;\n   161→    state.plant_guilds = plant_guilds;\n   162→    state.source_water_catalog = source_water_catalog;\n   163→    state.process_params = process_params;\n   164→\n   165→    Ok(state)\n   166→}\n   167→"}]},"parent_tool_use_id":null,"session_id":"c9944199-0c8b-41af-af7d-6829c99add9b","uuid":"020fbaad-0b24-4df9-a067-8fc52bae91e2","tool_use_result":{"type":"text","file":{"filePath":"/root/tank-simulation/crates/tank_scenarios/src/lib.rs","content":"use std::collections::BTreeMap;\n\nuse tank_core::{\n    PlantGuild, PlantGuildState, ProcessParams, SimMeta, SimSeed, SourceWaterProfile,\n    SubstrateLayerState, TankGeometry, TankState, WaterState,\n};\nuse tank_data::{load_scenario, ScenarioPreset};\n\npub fn default_scenario_ids() -> &'static [&'static str] {\n    tank_data::scenario_ids()\n}\n\npub fn load_named_scenario(id: &str) -> Result<ScenarioPreset, tank_data::PresetError> {\n    load_scenario(id)\n}\n\n/// Converts a `tank_data::SourceWaterPreset` into a `tank_core::SourceWaterProfile`.\nfn source_water_to_profile(preset: &tank_data::SourceWaterPreset) -> SourceWaterProfile {\n    SourceWaterProfile {\n        temperature_c: preset.temperature_c,\n        ammonia_mg_n_per_l: preset.ammonia_mg_n_per_l,\n        nitrite_mg_n_per_l: preset.nitrite_mg_n_per_l,\n        nitrate_mg_n_per_l: preset.nitrate_mg_n_per_l,\n        phosphate_mg_p_per_l: preset.phosphate_mg_p_per_l,\n        dic_mg_c_per_l: preset.dic_mg_c_per_l,\n        doc_mg_c_per_l: preset.doc_mg_c_per_l,\n        don_mg_n_per_l: preset.don_mg_n_per_l,\n        alkalinity_meq_per_l: preset.alkalinity_meq_per_l,\n        calcium_mg_per_l: preset.calcium_mg_per_l,\n        magnesium_mg_per_l: preset.magnesium_mg_per_l,\n        sodium_mg_per_l: preset.sodium_mg_per_l,\n        potassium_mg_per_l: preset.potassium_mg_per_l,\n        bicarbonate_mg_per_l: preset.bicarbonate_mg_per_l,\n        chloride_mg_per_l: preset.chloride_mg_per_l,\n        sulfate_mg_per_l: preset.sulfate_mg_per_l,\n    }\n}\n\n/// Converts a `tank_data::ProcessParamsPreset` into `tank_core::ProcessParams`.\nfn process_preset_to_params(preset: &tank_data::ProcessParamsPreset) -> ProcessParams {\n    ProcessParams {\n        mineralization_rate_per_day: preset.mineralization_rate_per_day,\n        nitrification_vmax: preset.nitrification_vmax,\n        reaeration_kla: preset.reaeration_kla,\n        k_surface_w_per_m2_k: preset.k_surface_w_per_m2_k,\n        k_wall_w_per_m2_k: preset.k_wall_w_per_m2_k,\n    }\n}\n\n/// Materializes a scenario preset into a fully resolved `TankState`.\n///\n/// - Geometry comes from the scenario.\n/// - `environment.ambient_temp_c` comes from the scenario.\n/// - Initial `WaterState` totals come from the source-water profile × fill volume.\n/// - Substrate layers come from the scenario's substrate preset IDs.\n/// - Plant guilds come from the scenario's plant preset IDs.\n/// - Source-water catalog is populated with all known source-water presets.\n/// - Process parameters come from the scenario's process params preset.\npub fn seeded_state(seed: SimSeed, scenario_id: &str) -> Result<TankState, tank_data::PresetError> {\n    let scenario = load_named_scenario(scenario_id)?;\n\n    // Geometry\n    let geometry = TankGeometry {\n        length_cm: scenario.tank_length_cm,\n        width_cm: scenario.tank_width_cm,\n        height_cm: scenario.tank_height_cm,\n        fill_height_cm: scenario.fill_height_cm,\n        glass_thickness_mm: 5.0,\n        open_top: true,\n        lid_exchange_factor: 0.25,\n    };\n\n    // Source water profile for initial fill\n    let source_water_preset = tank_data::load_source_water(&scenario.source_water_id)?;\n    let source_profile = source_water_to_profile(&source_water_preset);\n\n    // Initial water state from source-water profile\n    let water = WaterState::from_source_profile(&source_profile, &geometry);\n\n    // Build source-water catalog with all known presets\n    let mut source_water_catalog = BTreeMap::new();\n    for sw_id in tank_data::source_water_ids() {\n        let sw_preset = tank_data::load_source_water(sw_id)?;\n        source_water_catalog.insert(sw_id.to_string(), source_water_to_profile(&sw_preset));\n    }\n\n    // Process parameters\n    let process_preset = tank_data::load_process_params(&scenario.process_params_id)?;\n    let process_params = process_preset_to_params(&process_preset);\n\n    // Substrate layers\n    let mut substrate_layers = Vec::new();\n    for sub_id in &scenario.substrate_ids {\n        let sub_preset = tank_data::load_substrate(sub_id)?;\n        let footprint = geometry.footprint_area_cm2();\n        substrate_layers.push(SubstrateLayerState {\n            kind: match sub_preset.id.as_str() {\n                \"inert_sand\" => tank_core::SubstrateKind::InertSand,\n                \"inert_gravel\" => tank_core::SubstrateKind::InertGravel,\n                \"active_planted\" => tank_core::SubstrateKind::ActivePlanted,\n                \"coarse_porous\" => tank_core::SubstrateKind::CoarsePorous,\n                _ => tank_core::SubstrateKind::InertSand,\n            },\n            depth_cm: sub_preset.depth_cm,\n            nutrient_store_mg_n_total: sub_preset.nutrient_charge_mg_n_total,\n            nutrient_store_mg_p_total: sub_preset.nutrient_charge_mg_p_total,\n            cation_exchange_capacity_index: sub_preset.cation_exchange_capacity_index,\n            detritus_trapping_index: sub_preset.detritus_trapping_index,\n            colonizable_area_cm2: footprint * sub_preset.colonizable_area_factor,\n            low_oxygen_tendency_index: sub_preset.low_oxygen_tendency_index,\n            grazing_surface_index: sub_preset.grazing_surface_index,\n        });\n    }\n    if substrate_layers.is_empty() {\n        substrate_layers.push(SubstrateLayerState::default());\n    }\n\n    // Plant guilds\n    let mut plant_guilds = Vec::new();\n    for plant_id in &scenario.plant_ids {\n        let plant_preset = tank_data::load_plant(plant_id)?;\n        let guild = match plant_preset.guild.as_str() {\n            \"FastStem\" => PlantGuild::FastStem,\n            \"RootFeedingRosette\" => PlantGuild::RootFeedingRosette,\n            _ => PlantGuild::FastStem,\n        };\n        plant_guilds.push(PlantGuildState {\n            guild,\n            biomass_g: 5.0,\n            health_index: 0.8,\n            crowding_index: 0.1,\n            habitat_index: if guild == PlantGuild::RootFeedingRosette {\n                // Habitat factor depends on substrate quality\n                substrate_layers\n                    .iter()\n                    .map(|l| l.cation_exchange_capacity_index)\n                    .fold(0.0_f64, f64::max)\n                    .max(0.3)\n            } else {\n                0.8\n            },\n        });\n    }\n    if plant_guilds.is_empty() {\n        plant_guilds.push(PlantGuildState::default());\n    }\n\n    // Environment\n    let mut environment = tank_core::EnvironmentState::default();\n    environment.ambient_temp_c = scenario.ambient_temp_c;\n\n    let mut state = TankState::new(seed);\n    state.meta = SimMeta {\n        scenario_id: Some(scenario.id),\n        notes: Some(scenario.name),\n    };\n    state.geometry = geometry;\n    state.environment = environment;\n    state.water = water;\n    state.substrate_layers = substrate_layers;\n    state.plant_guilds = plant_guilds;\n    state.source_water_catalog = source_water_catalog;\n    state.process_params = process_params;\n\n    Ok(state)\n}\n","numLines":167,"startLine":1,"totalLines":167}}}
