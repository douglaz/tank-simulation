{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013NMhdfu4LBt9YLGE67Xtzv","type":"tool_result","content":"     1→use std::{\n     2→    io::{self, Stdout},\n     3→    path::PathBuf,\n     4→    time::{Duration, SystemTime, UNIX_EPOCH},\n     5→};\n     6→\n     7→use anyhow::Context;\n     8→use crossterm::{\n     9→    event::{self, Event, KeyCode, KeyEventKind},\n    10→    execute,\n    11→    terminal::{disable_raw_mode, enable_raw_mode, EnterAlternateScreen, LeaveAlternateScreen},\n    12→};\n    13→use ratatui::{\n    14→    backend::CrosstermBackend,\n    15→    prelude::*,\n    16→    widgets::{Block, Borders, List, ListItem, Paragraph},\n    17→    Terminal,\n    18→};\n    19→use tank_core::{Engine, SimSeed};\n    20→use tank_scenarios::{load_named_scenario, seeded_state_with_overrides, ScenarioGeometryOverrides};\n    21→use tank_tui::{\n    22→    input::{handle_key_event, InputOutcome},\n    23→    TuiApp, AUTO_ADVANCE_INTERVAL, FILL_PRESETS, TANK_SIZE_PRESETS,\n    24→};\n    25→\n    26→fn main() -> anyhow::Result<()> {\n    27→    enable_raw_mode().context(\"failed to enable raw mode\")?;\n    28→    let mut stdout = io::stdout();\n    29→    execute!(stdout, EnterAlternateScreen).context(\"failed to enter alternate screen\")?;\n    30→    let backend = CrosstermBackend::new(stdout);\n    31→    let mut terminal = Terminal::new(backend).context(\"failed to initialize terminal\")?;\n    32→\n    33→    let result = run(&mut terminal);\n    34→    restore_terminal(&mut terminal)?;\n    35→    result\n    36→}\n    37→\n    38→fn run(terminal: &mut Terminal<CrosstermBackend<Stdout>>) -> anyhow::Result<()> {\n    39→    let Some(selection) = select_startup_config(terminal)? else {\n    40→        return Ok(());\n    41→    };\n    42→\n    43→    let scenario =\n    44→        load_named_scenario(selection.scenario_id()).context(\"failed to load scenario\")?;\n    45→    let overrides = ScenarioGeometryOverrides {\n    46→        size_scale: selection.size_preset().size_scale,\n    47→        fill_ratio: selection.fill_preset().fill_ratio,\n    48→    };\n    49→    let seed = SimSeed(seed_from_clock());\n    50→    let state = seeded_state_with_overrides(seed, selection.scenario_id(), overrides)\n    51→        .context(\"failed to materialize selected scenario\")?;\n    52→    let scenario_label = format!(\n    53→        \"{} · {} · fill {}\",\n    54→        scenario.name,\n    55→        selection.size_preset().label,\n    56→        selection.fill_preset().label\n    57→    );\n    58→    let save_file_path = default_save_path(selection.scenario_id());\n    59→    let engine = Engine::from_parts(state, vec![]);\n    60→    let mut app = TuiApp::new(engine, save_file_path, scenario_label);\n    61→\n    62→    loop {\n    63→        app.clear_expired_status();\n    64→        terminal\n    65→            .draw(|frame| app.render(frame))\n    66→            .context(\"failed to render TUI frame\")?;\n    67→\n    68→        if event::poll(AUTO_ADVANCE_INTERVAL).context(\"failed to poll for events\")? {\n    69→            if let Event::Key(key) = event::read().context(\"failed to read terminal event\")? {\n    70→                if key.kind == KeyEventKind::Press\n    71→                    && handle_key_event(&mut app, key) == InputOutcome::Quit\n    72→                {\n    73→                    break;\n    74→                }\n    75→            }\n    76→        } else if app.auto_advance {\n    77→            app.step_hours(1);\n    78→        }\n    79→    }\n    80→\n    81→    Ok(())\n    82→}\n    83→\n    84→fn restore_terminal(terminal: &mut Terminal<CrosstermBackend<Stdout>>) -> anyhow::Result<()> {\n    85→    disable_raw_mode().context(\"failed to disable raw mode\")?;\n    86→    execute!(terminal.backend_mut(), LeaveAlternateScreen)\n    87→        .context(\"failed to leave alternate screen\")?;\n    88→    terminal.show_cursor().context(\"failed to show cursor\")?;\n    89→    Ok(())\n    90→}\n    91→\n    92→fn default_save_path(scenario_id: &str) -> PathBuf {\n    93→    std::env::current_dir()\n    94→        .unwrap_or_else(|_| PathBuf::from(\".\"))\n    95→        .join(format!(\"{scenario_id}-save.json\"))\n    96→}\n    97→\n    98→fn seed_from_clock() -> u64 {\n    99→    SystemTime::now()\n   100→        .duration_since(UNIX_EPOCH)\n   101→        .unwrap_or(Duration::from_secs(0))\n   102→        .as_secs()\n   103→}\n   104→\n   105→#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n   106→enum SelectionField {\n   107→    Scenario,\n   108→    Size,\n   109→    Fill,\n   110→    Launch,\n   111→}\n   112→\n   113→#[derive(Debug, Clone, PartialEq, Eq)]\n   114→struct StartupSelection {\n   115→    scenario_index: usize,\n   116→    size_index: usize,\n   117→    fill_index: usize,\n   118→    field: SelectionField,\n   119→}\n   120→\n   121→impl Default for StartupSelection {\n   122→    fn default() -> Self {\n   123→        Self {\n   124→            scenario_index: 0,\n   125→            size_index: 1,\n   126→            fill_index: 1,\n   127→            field: SelectionField::Scenario,\n   128→        }\n   129→    }\n   130→}\n   131→\n   132→impl StartupSelection {\n   133→    fn scenario_id(&self) -> &'static str {\n   134→        tank_scenarios::default_scenario_ids()[self.scenario_index]\n   135→    }\n   136→\n   137→    fn size_preset(&self) -> tank_tui::TankSizePreset {\n   138→        TANK_SIZE_PRESETS[self.size_index]\n   139→    }\n   140→\n   141→    fn fill_preset(&self) -> tank_tui::FillPreset {\n   142→        FILL_PRESETS[self.fill_index]\n   143→    }\n   144→\n   145→    fn next_field(&mut self) {\n   146→        self.field = match self.field {\n   147→            SelectionField::Scenario => SelectionField::Size,\n   148→            SelectionField::Size => SelectionField::Fill,\n   149→            SelectionField::Fill => SelectionField::Launch,\n   150→            SelectionField::Launch => SelectionField::Scenario,\n   151→        };\n   152→    }\n   153→\n   154→    fn previous_field(&mut self) {\n   155→        self.field = match self.field {\n   156→            SelectionField::Scenario => SelectionField::Launch,\n   157→            SelectionField::Size => SelectionField::Scenario,\n   158→            SelectionField::Fill => SelectionField::Size,\n   159→            SelectionField::Launch => SelectionField::Fill,\n   160→        };\n   161→    }\n   162→\n   163→    fn adjust_left(&mut self) {\n   164→        match self.field {\n   165→            SelectionField::Scenario => {\n   166→                let options = tank_scenarios::default_scenario_ids();\n   167→                self.scenario_index = (self.scenario_index + options.len() - 1) % options.len();\n   168→            }\n   169→            SelectionField::Size => {\n   170→                self.size_index =\n   171→                    (self.size_index + TANK_SIZE_PRESETS.len() - 1) % TANK_SIZE_PRESETS.len();\n   172→            }\n   173→            SelectionField::Fill => {\n   174→                self.fill_index = (self.fill_index + FILL_PRESETS.len() - 1) % FILL_PRESETS.len();\n   175→            }\n   176→            SelectionField::Launch => {}\n   177→        }\n   178→    }\n   179→\n   180→    fn adjust_right(&mut self) {\n   181→        match self.field {\n   182→            SelectionField::Scenario => {\n   183→                self.scenario_index =\n   184→                    (self.scenario_index + 1) % tank_scenarios::default_scenario_ids().len();\n   185→            }\n   186→            SelectionField::Size => {\n   187→                self.size_index = (self.size_index + 1) % TANK_SIZE_PRESETS.len();\n   188→            }\n   189→            SelectionField::Fill => {\n   190→                self.fill_index = (self.fill_index + 1) % FILL_PRESETS.len();\n   191→            }\n   192→            SelectionField::Launch => {}\n   193→        }\n   194→    }\n   195→}\n   196→\n   197→fn select_startup_config(\n   198→    terminal: &mut Terminal<CrosstermBackend<Stdout>>,\n   199→) -> anyhow::Result<Option<StartupSelection>> {\n   200→    let mut selection = StartupSelection::default();\n   201→\n   202→    loop {\n   203→        terminal.draw(|frame| render_startup(frame, &selection))?;\n   204→\n   205→        if let Event::Key(key) = event::read().context(\"failed to read selection input\")? {\n   206→            if key.kind != KeyEventKind::Press {\n   207→                continue;\n   208→            }\n   209→\n   210→            match key.code {\n   211→                KeyCode::Char('q') => return Ok(None),\n   212→                KeyCode::Up => selection.previous_field(),\n   213→                KeyCode::Down => selection.next_field(),\n   214→                KeyCode::Left => selection.adjust_left(),\n   215→                KeyCode::Right => selection.adjust_right(),\n   216→                KeyCode::Enter if selection.field == SelectionField::Launch => {\n   217→                    return Ok(Some(selection));\n   218→                }\n   219→                KeyCode::Enter => selection.next_field(),\n   220→                _ => {}\n   221→            }\n   222→        }\n   223→    }\n   224→}\n   225→\n   226→fn render_startup(frame: &mut Frame<'_>, selection: &StartupSelection) {\n   227→    let area = centered_rect(frame.size(), 76, 70);\n   228→    let layout = Layout::vertical([\n   229→        Constraint::Length(4),\n   230→        Constraint::Length(10),\n   231→        Constraint::Min(6),\n   232→        Constraint::Length(3),\n   233→    ])\n   234→    .split(area);\n   235→\n   236→    let header = Paragraph::new(vec![\n   237→        Line::from(Span::styled(\n   238→            \"Tank Sim terminal UI\",\n   239→            Style::default()\n   240→                .fg(Color::Cyan)\n   241→                .add_modifier(Modifier::BOLD),\n   242→        )),\n   243→        Line::from(\"Choose a scenario, tank size, and fill height before launching.\"),\n   244→    ])\n   245→    .block(Block::default().title(\"Startup\").borders(Borders::ALL));\n   246→    frame.render_widget(header, layout[0]);\n   247→\n   248→    let scenario = load_named_scenario(selection.scenario_id()).ok();\n   249→    let fields = vec![\n   250→        startup_item(\n   251→            selection.field == SelectionField::Scenario,\n   252→            \"Scenario\",\n   253→            scenario\n   254→                .as_ref()\n   255→                .map(|item| format!(\"{} ({})\", item.name, item.id))\n   256→                .unwrap_or_else(|| selection.scenario_id().to_string()),\n   257→        ),\n   258→        startup_item(\n   259→            selection.field == SelectionField::Size,\n   260→            \"Tank size\",\n   261→            selection.size_preset().label.to_string(),\n   262→        ),\n   263→        startup_item(\n   264→            selection.field == SelectionField::Fill,\n   265→            \"Fill height\",\n   266→            selection.fill_preset().label.to_string(),\n   267→        ),\n   268→        startup_item(\n   269→            selection.field == SelectionField::Launch,\n   270→            \"Launch\",\n   271→            \"Press Enter to start\".to_string(),\n   272→        ),\n   273→    ];\n   274→    let options = List::new(fields).block(\n   275→        Block::default()\n   276→            .title(\"Configuration\")\n   277→            .borders(Borders::ALL),\n   278→    );\n   279→    frame.render_widget(options, layout[1]);\n   280→\n   281→    let summary = scenario\n   282→        .map(|item| {\n   283→            vec![\n   284→                Line::from(format!(\"Ambient {:.1} C\", item.ambient_temp_c)),\n   285→                Line::from(format!(\n   286→                    \"Base geometry {:.1} x {:.1} x {:.1} cm\",\n   287→                    item.tank_length_cm, item.tank_width_cm, item.fill_height_cm\n   288→                )),\n   289→                Line::from(format!(\"Source water {}\", item.source_water_id)),\n   290→                Line::from(format!(\"Plants {:?}\", item.plant_ids)),\n   291→                Line::from(format!(\"Substrates {:?}\", item.substrate_ids)),\n   292→            ]\n   293→        })\n   294→        .unwrap_or_else(|| vec![Line::from(\"Scenario details unavailable\")]);\n   295→    let summary_widget = Paragraph::new(summary)\n   296→        .block(\n   297→            Block::default()\n   298→                .title(\"Scenario summary\")\n   299→                .borders(Borders::ALL),\n   300→        )\n   301→        .wrap(ratatui::widgets::Wrap { trim: true });\n   302→    frame.render_widget(summary_widget, layout[2]);\n   303→\n   304→    let help = Paragraph::new(\n   305→        \"Up/Down move between fields, Left/Right change values, Enter advances, q quits.\",\n   306→    )\n   307→    .block(Block::default().borders(Borders::ALL));\n   308→    frame.render_widget(help, layout[3]);\n   309→}\n   310→\n   311→fn startup_item(selected: bool, label: &str, value: String) -> ListItem<'static> {\n   312→    let style = if selected {\n   313→        Style::default()\n   314→            .fg(Color::Yellow)\n   315→            .add_modifier(Modifier::BOLD)\n   316→    } else {\n   317→        Style::default()\n   318→    };\n   319→    ListItem::new(Line::from(vec![\n   320→        Span::styled(format!(\"{label}: \"), style),\n   321→        Span::raw(value),\n   322→    ]))\n   323→}\n   324→\n   325→fn centered_rect(area: Rect, width_percent: u16, height_percent: u16) -> Rect {\n   326→    let vertical = Layout::vertical([\n   327→        Constraint::Percentage((100 - height_percent) / 2),\n   328→        Constraint::Percentage(height_percent),\n   329→        Constraint::Percentage((100 - height_percent) / 2),\n   330→    ])\n   331→    .split(area);\n   332→    let horizontal = Layout::horizontal([\n   333→        Constraint::Percentage((100 - width_percent) / 2),\n   334→        Constraint::Percentage(width_percent),\n   335→        Constraint::Percentage((100 - width_percent) / 2),\n   336→    ])\n   337→    .split(vertical[1]);\n   338→    horizontal[1]\n   339→}\n   340→"}]},"parent_tool_use_id":"toolu_01MTbExgW5WnaXju2rbX1q9r","session_id":"52ade16c-d21b-4a80-87c4-793dd732d7a8","uuid":"0bf478b4-f032-4b65-b524-370cf8398cfa"}
