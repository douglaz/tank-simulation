{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GQcFzFVe36iVygmysMk1kC","type":"tool_result","content":"     1→use ratatui::{\n     2→    prelude::*,\n     3→    widgets::{Block, Borders, List, ListItem, Paragraph},\n     4→};\n     5→\n     6→use crate::TuiApp;\n     7→\n     8→pub fn render(frame: &mut Frame<'_>, area: Rect, app: &TuiApp) {\n     9→    let snapshot = &app.snapshot;\n    10→    let layout = Layout::vertical([\n    11→        Constraint::Length(9),\n    12→        Constraint::Length(6),\n    13→        Constraint::Min(6),\n    14→    ])\n    15→    .split(area);\n    16→    let top = Layout::horizontal([Constraint::Percentage(50), Constraint::Percentage(50)])\n    17→        .split(layout[0]);\n    18→    let middle = Layout::horizontal([Constraint::Percentage(50), Constraint::Percentage(50)])\n    19→        .split(layout[1]);\n    20→\n    21→    let chemistry = Paragraph::new(vec![\n    22→        Line::from(format!(\"Day {}  Hour {:02}\", snapshot.day, snapshot.hour)),\n    23→        Line::from(format!(\n    24→            \"Temp {:.2} C  Ambient {:.2} C\",\n    25→            snapshot.water_temp_c, snapshot.ambient_temp_c\n    26→        )),\n    27→        Line::from(format!(\n    28→            \"pH {:.2}  DO {:.2}/{:.2} mg/L\",\n    29→            snapshot.ph, snapshot.do_mg_l, snapshot.do_sat_mg_l\n    30→        )),\n    31→        Line::from(format!(\n    32→            \"TAN {:.3}  NH3 {:.4} mg/L\",\n    33→            snapshot.tan_mg_l, snapshot.nh3_mg_l\n    34→        )),\n    35→        Line::from(format!(\n    36→            \"NO2 {:.3}  NO3 {:.3} mg/L\",\n    37→            snapshot.nitrite_mg_l, snapshot.nitrate_mg_l\n    38→        )),\n    39→    ])\n    40→    .block(Block::default().title(\"Water column\").borders(Borders::ALL));\n    41→    frame.render_widget(chemistry, top[0]);\n    42→\n    43→    let systems = Paragraph::new(vec![\n    44→        Line::from(format!(\n    45→            \"Volume {:.1} L  DIC {:.2} mg/L\",\n    46→            snapshot.water_volume_l, snapshot.dissolved_inorganic_carbon_mg_l\n    47→        )),\n    48→        Line::from(format!(\n    49→            \"GH {:.2} d  KH {:.2} d  TDS {:.1}\",\n    50→            snapshot.gh_d, snapshot.kh_d, snapshot.tds_mg_l\n    51→        )),\n    52→        Line::from(format!(\n    53→            \"Light {} @ {:.2} for {:.1}h\",\n    54→            on_off(snapshot.light_enabled),\n    55→            snapshot.light_intensity_index,\n    56→            snapshot.photoperiod_hours\n    57→        )),\n    58→        Line::from(format!(\n    59→            \"Heater {} @ {:.1} C  Aeration {} @ {:.2}\",\n    60→            on_off(snapshot.heater_enabled),\n    61→            snapshot.heater_setpoint_c,\n    62→            on_off(snapshot.aeration_enabled),\n    63→            snapshot.aeration_intensity\n    64→        )),\n    65→    ])\n    66→    .block(Block::default().title(\"Hardware\").borders(Borders::ALL));\n    67→    frame.render_widget(systems, top[1]);\n    68→\n    69→    let plant_summary = Paragraph::new(vec![\n    70→        Line::from(format!(\n    71→            \"Total biomass {:.2} g\",\n    72→            snapshot.total_plant_biomass_g\n    73→        )),\n    74→        Line::from(format!(\n    75→            \"Fast stem {:.2} g  health {:.2}\",\n    76→            snapshot.fast_stem_biomass_g, snapshot.fast_stem_health_index\n    77→        )),\n    78→        Line::from(format!(\n    79→            \"Rosette {:.2} g  health {:.2}\",\n    80→            snapshot.root_feeding_rosette_biomass_g, snapshot.root_feeding_rosette_health_index\n    81→        )),\n    82→    ])\n    83→    .block(Block::default().title(\"Plant status\").borders(Borders::ALL));\n    84→    frame.render_widget(plant_summary, middle[0]);\n    85→\n    86→    let shrimp_summary = Paragraph::new(vec![\n    87→        Line::from(format!(\n    88→            \"Adults {}  Juveniles {}  Berried {}\",\n    89→            snapshot.adult_shrimp_count, snapshot.juveniles_count, snapshot.berried_females_count\n    90→        )),\n    91→        Line::from(format!(\n    92→            \"Condition {:.2}  Molt stress {:.2}\",\n    93→            snapshot.shrimp_condition_index, snapshot.shrimp_molt_stress_index\n    94→        )),\n    95→        Line::from(format!(\n    96→            \"Repro readiness {:.2}\",\n    97→            snapshot.shrimp_reproductive_readiness\n    98→        )),\n    99→    ])\n   100→    .block(\n   101→        Block::default()\n   102→            .title(\"Shrimp status\")\n   103→            .borders(Borders::ALL),\n   104→    );\n   105→    frame.render_widget(shrimp_summary, middle[1]);\n   106→\n   107→    let warnings = app.active_warning_lines();\n   108→    let warning_items = if warnings.is_empty() {\n   109→        vec![ListItem::new(\"No active warnings\")]\n   110→    } else {\n   111→        warnings\n   112→            .into_iter()\n   113→            .map(|warning| ListItem::new(warning).style(Style::default().fg(Color::Yellow)))\n   114→            .collect()\n   115→    };\n   116→    let warning_list = List::new(warning_items).block(\n   117→        Block::default()\n   118→            .title(\"Active warnings\")\n   119→            .borders(Borders::ALL),\n   120→    );\n   121→    frame.render_widget(warning_list, layout[2]);\n   122→}\n   123→\n   124→fn on_off(enabled: bool) -> &'static str {\n   125→    if enabled {\n   126→        \"on\"\n   127→    } else {\n   128→        \"off\"\n   129→    }\n   130→}\n   131→"}]},"parent_tool_use_id":"toolu_01MTbExgW5WnaXju2rbX1q9r","session_id":"52ade16c-d21b-4a80-87c4-793dd732d7a8","uuid":"c722c8d3-9f41-44d3-a961-f036b4050306"}
