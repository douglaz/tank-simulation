{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DggN9GcRShhtMYGpfQPFXN","type":"tool_result","content":"     1→pub fn is_light_on(hour_of_day: u8, photoperiod_hours: f64) -> bool {\n     2→    if photoperiod_hours <= 0.0 {\n     3→        return false;\n     4→    }\n     5→    if photoperiod_hours >= 24.0 {\n     6→        return true;\n     7→    }\n     8→\n     9→    let midpoint_hour = f64::from(hour_of_day % 24) + 0.5;\n    10→    let start_hour = 12.0 - photoperiod_hours / 2.0;\n    11→    let end_hour = 12.0 + photoperiod_hours / 2.0;\n    12→\n    13→    midpoint_hour >= start_hour && midpoint_hour < end_hour\n    14→}\n    15→\n    16→#[cfg(test)]\n    17→mod tests {\n    18→    use super::is_light_on;\n    19→\n    20→    #[test]\n    21→    fn centered_on_noon_for_even_photoperiod() {\n    22→        let lit_hours: Vec<u8> = (0..24).filter(|hour| is_light_on(*hour, 8.0)).collect();\n    23→        assert_eq!(lit_hours, vec![8, 9, 10, 11, 12, 13, 14, 15]);\n    24→    }\n    25→\n    26→    #[test]\n    27→    fn zero_and_full_day_photoperiods() {\n    28→        assert!(!(0..24).any(|hour| is_light_on(hour, 0.0)));\n    29→        assert!((0..24).all(|hour| is_light_on(hour, 24.0)));\n    30→    }\n    31→}\n    32→"}]},"parent_tool_use_id":null,"session_id":"1748b4fc-51d6-4391-af57-f472921254b7","uuid":"1c734504-51b3-4228-b471-952177afa969","tool_use_result":{"type":"text","file":{"filePath":"/root/tank-simulation/crates/tank_core/src/systems/light.rs","content":"pub fn is_light_on(hour_of_day: u8, photoperiod_hours: f64) -> bool {\n    if photoperiod_hours <= 0.0 {\n        return false;\n    }\n    if photoperiod_hours >= 24.0 {\n        return true;\n    }\n\n    let midpoint_hour = f64::from(hour_of_day % 24) + 0.5;\n    let start_hour = 12.0 - photoperiod_hours / 2.0;\n    let end_hour = 12.0 + photoperiod_hours / 2.0;\n\n    midpoint_hour >= start_hour && midpoint_hour < end_hour\n}\n\n#[cfg(test)]\nmod tests {\n    use super::is_light_on;\n\n    #[test]\n    fn centered_on_noon_for_even_photoperiod() {\n        let lit_hours: Vec<u8> = (0..24).filter(|hour| is_light_on(*hour, 8.0)).collect();\n        assert_eq!(lit_hours, vec![8, 9, 10, 11, 12, 13, 14, 15]);\n    }\n\n    #[test]\n    fn zero_and_full_day_photoperiods() {\n        assert!(!(0..24).any(|hour| is_light_on(hour, 0.0)));\n        assert!((0..24).all(|hour| is_light_on(hour, 24.0)));\n    }\n}\n","numLines":32,"startLine":1,"totalLines":32}}}
