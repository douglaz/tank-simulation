nk_core/src/systems/chemistry.rs\n    75→@@ -0,0 +1,78 @@\n    76→+use crate::types::TankState;\n    77→+\n    78→+const ADULT_SHRIMP_BIOMASS_G: f64 = 0.12;\n    79→+const JUVENILE_SHRIMP_BIOMASS_G: f64 = 0.05;\n    80→+const ALKALINITY_FEEDBACK_MEQ_PER_MG_C: f64 = 0.0002;\n    81→+\n    82→+pub fn compute_ph_from_totals(\n    83→+    alkalinity_meq_total: f64,\n    84→+    dissolved_inorganic_carbon_mg_c_total: f64,\n    85→+    volume_l: f64,\n    86→+) -> f64 {\n    87→+    if volume_l <= f64::EPSILON {\n    88→+        return 7.0;\n    89→+    }\n    90→+\n    91→+    let alkalinity_meq_l = alkalinity_meq_total / volume_l;\n    92→+    let dic_mmol_l = (dissolved_inorganic_carbon_mg_c_total / 12.0) / volume_l;\n    93→+\n    94→+    (6.3 + safe_log10(alkalinity_meq_l.max(0.05)) - safe_log10(dic_mmol_l.max(0.02)))\n    95→+        .clamp(5.5, 8.5)\n    96→+}\n    97→+\n    98→+pub fn compute_nh3_mg_l(tan_mg_l: f64, ph: f64, temp_c: f64) -> f64 {\n    99→+    let pka = 0.09018 + 2729.92 / (273.2 + temp_c);\n   100→+    let fraction_nh3 = 1.0 / (1.0 + 10.0_f64.powf(pka - ph));\n   101→+    tan_mg_l * fraction_nh3\n   102→+}\n   103→+\n   104→+pub fn step_hourly_chemistry(state: &mut TankState, light_on: bool) {\n   105→+    let volume_l = state.geometry.water_volume_l();\n   106→+    if volume_l <= f64::EPSILON {\n   107→+        return;\n   108→+    }\n   109→+\n   110→+    let respiration_dic_mg = state.process_params.respiration_dic_rate_mg_c_per_g_per_hour\n   111→+        * respiring_biomass_g(state);\n   112→+    let photosynthesis_dic_mg = if light_on {\n   113→+        state.process_params.photosynthesis_dic_rate_mg_c_per_g_per_hour\n   114→+            * photosynthetic_biomass_g(state)\n   115→+            * state.hardware.light.intensity_index\n   116→+    } else {\n   117→+        0.0\n   118→+    };\n   119→+    let net_dic_delta_mg = respiration_dic_mg - photosynthesis_dic_mg;\n   120→+\n   121→+    state.water.dissolved_inorganic_carbon_mg_c_total =\n   122→+        (state.water.dissolved_inorganic_carbon_mg_c_total + net_dic_delta_mg).max(0.0);\n   123→+    state.water.alkalinity_meq_total = (state.water.alkalinity_meq_total\n   124→+        - (net_dic_delta_mg * ALKALINITY_FEEDBACK_MEQ_PER_MG_C))\n   125→+        .max(0.0);\n   126→+    state.water.ph = compute_ph_from_totals(\n   127→+        state.water.alkalinity_meq_total,\n   128→+        state.water.dissolved_inorganic_carbon_mg_c_total,\n   129→+        volume_l,\n   130→+    );\n   131→+}\n   132→+\n   133→+pub(crate) fn respiring_biomass_g(state: &TankState) -> f64 {\n   134→+    let plant_biomass_g: f64 = state.plant_guilds.iter().map(|plant| plant.biomass_g).sum();\n   135→+    let algae_biomass_g = state.algae.suspended_biomass_g + state.algae.periphyton_biomass_g;\n   136→+    let microbe_biomass_g = state.microbe.decomposer_biomass_g\n   137→+        + state.microbe.ammonia_oxidizer_biomass_g\n   138→+        + state.microbe.nitrite_oxidizer_biomass_g\n   139→+        + state.microbe.comammox_biomass_g;\n   140→+    let shrimp_biomass_g = (f64::from(state.animal.adults_count) * ADULT_SHRIMP_BIOMASS_G)\n   141→+        + (f64::from(state.animal.juveniles_count) * JUVENILE_SHRIMP_BIOMASS_G);\n   142→+\n   143→+    plant_biomass_g + algae_biomass_g + microbe_biomass_g + shrimp_biomass_g\n   144→+}\n   145→+\n   146→+pub(crate) fn photosynthetic_biomass_g(state: &TankState) -> f64 {\n   147→+    let plant_biomass_g: f64 = state.plant_guilds.iter().map(|plant| plant.biomass_g).sum();\n   148→+    plant_biomass_g + state.algae.periphyton_biomass_g\n   149→+}\n   150→+\n   151→+fn safe_log10(value: f64) -> f64 {\n   152→+    value.max(f64::MIN_POSITIVE).log10()\n   153→+}\n   154→diff --git a/crates/tank_core/src/systems/dissolved_oxygen.rs b/crates/tank_core/src/systems/dissolved_oxygen.rs\n   155→new file mode 100644\n   156→index 0000000..e6ba2c5\n   157→--- /dev/null\n   158→+++ b/crates/tank_core/src/systems/dissolved_oxygen.rs\n   159→@@ -0,0 +1,38 @@\n   160→+use crate::{\n   161→+    systems::{\n   162→+        chemistry::{photosynthetic_biomass_g, respiring_biomass_g},\n   163→+        temperature::do_sat_mg_l,\n   164→+    },\n   165→+    types::TankState,\n   166→+};\n   167→+\n   168→+pub fn step_dissolved_oxygen(state: &mut TankState, light_on: bool) {\n   169→+    let volume_l = state.geometry.water_volume_l();\n   170→+    if volume_l <= f64::EPSILON {\n   171→+        return;\n   172→+    }\n   173→+\n   174→+    let do_sat_mg_l = do_sat_mg_l(state.water.temperature_c);\n   175→+    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n   176→+    let aeration_intensity = if state.hardware.aeration.enabled {\n   177→+        state.hardware.aeration.intensity\n   178→+    } else {\n   179→+        0.0\n   180→+    };\n   181→+    let k_la = (state.process_params.reaeration_kla_base * state.geometry.top_exchange_factor())\n   182→+        + (state.process_params.aeration_kla_boost * aeration_intensity);\n   183→+    let delta_do_reaeration_mg = k_la * (do_sat_mg_l - do_mg_l) * volume_l;\n   184→+\n   185→+    let background_bod_mg = state.process_params.background_bod_mg_o2_per_g_biomass_per_hour\n   186→+        * respiring_biomass_g(state);\n   187→+    let photosynthetic_o2_mg = if light_on {\n   188→+        state.process_params.plant_photosynthesis_o2_mg_per_g_per_hour\n   189→+            * photosynthetic_biomass_g(state)\n   190→+            * state.hardware.light.intensity_index\n   191→+    } else {\n   192→+        0.0\n   193→+    };\n   194→+\n   195→+    state.water.dissolved_oxygen_mg_total +=\n   196→+        delta_do_reaeration_mg + photosynthetic_o2_mg - background_bod_mg;\n   197→+}\n   198→diff --git a/crates/tank_core/src/systems/events.rs b/crates/tank_core/src/systems/events.rs\n   199→new file mode 100644\n   200→index 0000000..94c3868\n   201→--- /dev/null\n   202→+++ b/crates/tank_core/src/systems/events.rs\n   203→@@ -0,0 +1,67 @@\n   204→+use crate::{\n   205→+    systems::chemistry::compute_nh3_mg_l,\n   206→+    types::{EventCause, EventKind, EventSeverity, SimEvent, TankState},\n   207→+};\n   208→+\n   209→+pub fn emit_hourly_threshold_events(state: &mut TankState) {\n   210→+    let volume_l = state.geometry.water_volume_l();\n   211→+    if volume_l <= f64::EPSILON {\n   212→+        return;\n   213→+    }\n   214→+\n   215→+    let tan_mg_l = state.water.ammonia_total_mg_n_total / volume_l;\n   216→+    let nh3_mg_l = compute_nh3_mg_l(tan_mg_l, state.water.ph, state.water.temperature_c);\n   217→+    let nitrite_mg_l = state.water.nitrite_mg_n_total / volume_l;\n   218→+    let do_mg_l = state.water.dissolved_oxygen_mg_total / volume_l;\n   219→+\n   220→+    if nh3_mg_l >= 0.02 {\n   221→+        emit_once_per_day(\n   222→+            state,\n   223→+            EventSeverity::Warning,\n   224→+            EventKind::AmmoniaWarning,\n   225→+            vec![EventCause::HighAmmonia],\n   226→+            format!(\"Free ammonia reached {nh3_mg_l:.3} mg/L\"),\n   227→+        );\n   228→+    }\n   229→+    if nitrite_mg_l >= 0.5 {\n   230→+        emit_once_per_day(\n   231→+            state,\n   232→+            EventSeverity::Warning,\n   233→+            EventKind::NitriteWarning,\n   234→+            vec![EventCause::HighNitrite],\n   235→+            format!(\"Nitrite reached {nitrite_mg_l:.2} mg/L\"),\n   236→+        );\n   237→+    }\n   238→+    if do_mg_l < 4.0 {\n   239→+        emit_once_per_day(\n   240→+            state,\n   241→+            EventSeverity::Warning,\n   242→+            EventKind::OxygenDip,\n   243→+            vec![EventCause::LowOxygen],\n   244→+            format!(\"Dissolved oxygen dropped to {do_mg_l:.2} mg/L\"),\n   245→+        );\n   246→+    }\n   247→+}\n   248→+\n   249→+fn emit_once_per_day(\n   250→+    state: &mut TankState,\n   251→+    severity: EventSeverity,\n   252→+    kind: EventKind,\n   253→+    cause_codes: Vec<EventCause>,\n   254→+    summary: String,\n   255→+) {\n   256→+    let key = format!(\"{kind:?}\");\n   257→+    if state.last_event_day.get(&key) == Some(&state.environment.day) {\n   258→+        return;\n   259→+    }\n   260→+\n   261→+    state.event_log.push(SimEvent::new(\n   262→+        state.environment.day,\n   263→+        state.environment.hour_of_day,\n   264→+        severity,\n   265→+        kind,\n   266→+        cause_codes,\n   267→+        summary,\n   268→+    ));\n   269→+    state.last_event_day.insert(key, state.environment.day);\n   270→+}\n   271→diff --git a/crates/tank_core/src/systems/light.rs b/crates/tank_core/src/systems/light.rs\n   272→new file mode 100644\n   273→index 0000000..9d0f9dc\n   274→--- /dev/null\n   275→+++ b/crates/tank_core/src/systems/light.rs\n   276→@@ -0,0 +1,31 @@\n   277→+pub fn is_light_on(hour_of_day: u8, photoperiod_hours: f64) -> bool {\n   278→+    if photoperiod_hours <= 0.0 {\n   279→+        return false;\n   280→+    }\n   281→+    if photoperiod_hours >= 24.0 {\n   282→+        return true;\n   283→+    }\n   284→+\n   285→+    let midpoint_hour = f64::from(hour_of_day % 24) + 0.5;\n   286→+    let start_hour = 12.0 - photoperiod_hours / 2.0;\n   287→+    let end_hour = 12.0 + photoperiod_hours / 2.0;\n   288→+\n   289→+    midpoint_hour >= start_hour && midpoint_hour < end_hour\n   290→+}\n   291→+\n   292→+#[cfg(test)]\n   293→+mod tests {\n   294→+    use super::is_light_on;\n   295→+\n   296→+    #[test]\n   297→+    fn centered_on_noon_for_even_photoperiod() {\n   298→+        let lit_hours: Vec<u8> = (0..24).filter(|hour| is_light_on(*hour, 8.0)).collect();\n   299→+        assert_eq!(lit_hours, vec![8, 9, 10, 11, 12, 13, 14, 15]);\n   300→+    }\n   301→+\n   302→+    #[test]\n   303→+    fn zero_and_full_day_photoperiods() {\n   304→+        assert!(!(0..24).any(|hour| is_light_on(hour, 0.0)));\n   305→+        assert!((0..24).all(|hour| is_light_on(hour, 24.0)));\n   306→+    }\n   307→+}\n   308→diff --git a/crates/tank_core/src/systems/mod.rs b/crates/tank_core/src/systems/mod.rs\n   309→index 23b9ccf..b4ba5fe 100644\n   310→--- a/crates/tank_core/src/systems/mod.rs\n   311→+++ b/crates/tank_core/src/systems/mod.rs\n   312→@@ -1,2 +1,6 @@\n   313→+pub mod chemistry;\n   314→+pub mod dissolved_oxygen;\n   315→+pub mod events;\n   316→+pub mod light;\n   317→ pub mod temperature;\n   318→ pub mod water_change;\n   319→diff --git a/crates/tank_core/src/types/process.rs b/crates/tank_core/src/types/process.rs\n   320→index 3df4e7d..afcb35d 100644\n   321→--- a/crates/tank_core/src/types/process.rs\n   322→+++ b/crates/tank_core/src/types/process.rs\n   323→@@ -3,10 +3,16 @@ use serde::{Deserialize, Serialize};\n   324→ /// Runtime process parameters for heat-transfer coefficients and later chemistry systems.\n   325→ /// Stored in `TankState` for deterministic continuation.\n   326→ #[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n   327→+#[serde(default)]\n   328→ pub struct ProcessParams {\n   329→     pub mineralization_rate_per_day: f64,\n   330→     pub nitrification_vmax: f64,\n   331→-    pub reaeration_kla: f64,\n   332→+    pub reaeration_kla_base: f64,\n   333→+    pub aeration_kla_boost: f64,\n   334→+    pub background_bod_mg_o2_per_g_biomass_per_hour: f64,\n   335→+    pub plant_photosynthesis_o2_mg_per_g_per_hour: f64,\n   336→+    pub respiration_dic_rate_mg_c_per_g_per_hour: f64,\n   337→+    pub photosynthesis_dic_rate_mg_c_per_g_per_hour: f64,\n   338→     /// Surface (top) heat-transfer coefficient in W/(m²·K).\n   339→     pub k_surface_w_per_m2_k: f64,\n   340→     /// Wall heat-transfer coefficient in W/(m²·K).\n   341→@@ -18,7 +24,12 @@ impl Default for ProcessParams {\n   342→         Self {\n   343→             mineralization_rate_per_day: 0.15,\n   344→             nitrification_vmax: 0.08,\n   345→-            reaeration_kla: 0.4,\n   346→+            reaeration_kla_base: 0.35,\n   347→+            aeration_kla_boost: 0.9,\n   348→+            background_bod_mg_o2_per_g_biomass_per_hour: 0.05,\n   349→+            plant_photosynthesis_o2_mg_per_g_per_hour: 0.2,\n   350→+            respiration_dic_rate_mg_c_per_g_per_hour: 0.0,\n   351→+            photosynthesis_dic_rate_mg_c_per_g_per_hour: 0.0,\n   352→             k_surface_w_per_m2_k: 10.0,\n   353→             k_wall_w_per_m2_k: 5.0,\n   354→         }\n   355→diff --git a/crates/tank_core/src/types/snapshot.rs b/crates/tank_core/src/types/snapshot.rs\n   356→index 2dce57e..0be0a41 100644\n   357→--- a/crates/tank_core/src/types/snapshot.rs\n   358→+++ b/crates/tank_core/src/types/snapshot.rs\n   359→@@ -1,7 +1,7 @@\n   360→ use serde::{Deserialize, Serialize};\n   361→ \n   362→ use super::{SimEvent, TankState};\n   363→-use crate::systems::temperature::do_sat_mg_l;\n   364→+use crate::systems::{chemistry::compute_nh3_mg_l, temperature::do_sat_mg_l};\n   365→ \n   366→ #[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n   367→ pub struct TankSnapshot {\n   368→@@ -43,15 +43,8 @@ impl TankSnapshot {\n   369→         let conductivity_us_cm = tds_mg_l / 0.65;\n   370→         let gh_d = ((2.497 * ca_mg_l) + (4.118 * mg_mg_l)) / 17.848;\n   371→         let kh_d = (alkalinity_meq_l * 50.0) / 17.848;\n   372→-        let dic_mmol_l = safe_div(\n   373→-            state.water.dissolved_inorganic_carbon_mg_c_total / 12.0,\n   374→-            volume_l,\n   375→-        );\n   376→-        let ph = (6.3 + safe_log10(alkalinity_meq_l.max(0.05)) - safe_log10(dic_mmol_l.max(0.02)))\n   377→-            .clamp(5.5, 8.5);\n   378→-        let pka = 0.09018 + 2729.92 / (273.2 + state.water.temperature_c);\n   379→-        let fraction_nh3 = 1.0 / (1.0 + 10.0_f64.powf(pka - ph));\n   380→-        let nh3_mg_l = tan_mg_l * fraction_nh3;\n   381→+        let ph = state.water.ph;\n   382→+        let nh3_mg_l = compute_nh3_mg_l(tan_mg_l, ph, state.water.temperature_c);\n   383→ \n   384→         Self {\n   385→             day: state.environment.day,\n   386→@@ -85,7 +78,3 @@