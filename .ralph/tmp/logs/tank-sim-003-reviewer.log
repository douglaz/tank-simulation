l: f64,\n   432→     pub chloride_mg_total: f64,\n   433→     pub sulfate_mg_total: f64,\n   434→+    #[serde(default = \"default_ph\")]\n   435→+    pub ph: f64,\n   436→ }\n   437→ \n   438→ impl WaterState {\n   439→     pub fn default_for_geometry(geometry: &TankGeometry) -> Self {\n   440→         let volume_l = geometry.water_volume_l();\n   441→-        Self {\n   442→+        let mut state = Self {\n   443→             temperature_c: 24.0,\n   444→             ammonia_total_mg_n_total: 0.0,\n   445→             nitrite_mg_n_total: 0.0,\n   446→@@ -44,7 +50,14 @@ impl WaterState {\n   447→             bicarbonate_mg_total: 70.0 * volume_l,\n   448→             chloride_mg_total: 12.0 * volume_l,\n   449→             sulfate_mg_total: 8.0 * volume_l,\n   450→-        }\n   451→+            ph: default_ph(),\n   452→+        };\n   453→+        state.ph = crate::systems::chemistry::compute_ph_from_totals(\n   454→+            state.alkalinity_meq_total,\n   455→+            state.dissolved_inorganic_carbon_mg_c_total,\n   456→+            volume_l,\n   457→+        );\n   458→+        state\n   459→     }\n   460→ \n   461→     /// Creates initial water state from a source-water profile and tank geometry.\n   462→@@ -52,7 +65,7 @@ impl WaterState {\n   463→     pub fn from_source_profile(profile: &SourceWaterProfile, geometry: &TankGeometry) -> Self {\n   464→         let volume_l = geometry.water_volume_l();\n   465→         let do_sat = crate::systems::temperature::do_sat_mg_l(profile.temperature_c);\n   466→-        Self {\n   467→+        let mut state = Self {\n   468→             temperature_c: profile.temperature_c,\n   469→             ammonia_total_mg_n_total: profile.ammonia_mg_n_per_l * volume_l,\n   470→             nitrite_mg_n_total: profile.nitrite_mg_n_per_l * volume_l,\n   471→@@ -70,7 +83,14 @@ impl WaterState {\n   472→             bicarbonate_mg_total: profile.bicarbonate_mg_per_l * volume_l,\n   473→             chloride_mg_total: profile.chloride_mg_per_l * volume_l,\n   474→             sulfate_mg_total: profile.sulfate_mg_per_l * volume_l,\n   475→-        }\n   476→+            ph: default_ph(),\n   477→+        };\n   478→+        state.ph = crate::systems::chemistry::compute_ph_from_totals(\n   479→+            state.alkalinity_meq_total,\n   480→+            state.dissolved_inorganic_carbon_mg_c_total,\n   481→+            volume_l,\n   482→+        );\n   483→+        state\n   484→     }\n   485→ \n   486→     pub fn total_tracked_ions_mg(&self) -> f64 {\n   487→diff --git a/crates/tank_core/tests/chemistry.rs b/crates/tank_core/tests/chemistry.rs\n   488→new file mode 100644\n   489→index 0000000..eb0203f\n   490→--- /dev/null\n   491→+++ b/crates/tank_core/tests/chemistry.rs\n   492→@@ -0,0 +1,79 @@\n   493→+use tank_core::{\n   494→+    systems::chemistry::{compute_nh3_mg_l, compute_ph_from_totals},\n   495→+    Engine, ProcessParams, SimSeed, SimulationEngine, TankState,\n   496→+};\n   497→+\n   498→+fn chemistry_state(seed: SimSeed, hour_of_day: u8) -> TankState {\n   499→+    let mut state = TankState::new(seed);\n   500→+    state.environment.hour_of_day = hour_of_day;\n   501→+    state.hardware.light.photoperiod_hours = 8.0;\n   502→+    state.hardware.light.intensity_index = 1.0;\n   503→+    state.algae.periphyton_biomass_g = 2.5;\n   504→+    state.plant_guilds[0].biomass_g = 14.0;\n   505→+    state.plant_guilds[1].biomass_g = 8.0;\n   506→+    state.animal.adults_count = 20;\n   507→+    state.process_params = ProcessParams {\n   508→+        respiration_dic_rate_mg_c_per_g_per_hour: 0.20,\n   509→+        photosynthesis_dic_rate_mg_c_per_g_per_hour: 0.35,\n   510→+        ..ProcessParams::default()\n   511→+    };\n   512→+    state\n   513→+}\n   514→+\n   515→+#[test]\n   516→+fn ph_drifts_with_light_driven_dic_changes() -> Result<(), tank_core::SimError> {\n   517→+    let mut night_engine = Engine::from_parts(chemistry_state(SimSeed(4000), 0), vec![]);\n   518→+    let mut day_engine = Engine::from_parts(chemistry_state(SimSeed(4000), 12), vec![]);\n   519→+\n   520→+    let night_ph_before = night_engine.full_state().water.ph;\n   521→+    let day_ph_before = day_engine.full_state().water.ph;\n   522→+\n   523→+    night_engine.step_hours(1)?;\n   524→+    day_engine.step_hours(1)?;\n   525→+\n   526→+    let night_ph_after = night_engine.full_state().water.ph;\n   527→+    let day_ph_after = day_engine.full_state().water.ph;\n   528→+    let night_dic_after = night_engine.full_state().water.dissolved_inorganic_carbon_mg_c_total;\n   529→+    let day_dic_after = day_engine.full_state().water.dissolved_inorganic_carbon_mg_c_total;\n   530→+\n   531→+    assert!(\n   532→+        night_ph_after < night_ph_before,\n   533→+        \"night respiration should lower pH: before={night_ph_before:.3}, after={night_ph_after:.3}\"\n   534→+    );\n   535→+    assert!(\n   536→+        day_ph_after > day_ph_before,\n   537→+        \"day photosynthesis should raise pH: before={day_ph_before:.3}, after={day_ph_after:.3}\"\n   538→+    );\n   539→+    assert!(\n   540→+        day_dic_after < night_dic_after,\n   541→+        \"lit hours should consume more DIC than night hours\"\n   542→+    );\n   543→+\n   544→+    Ok(())\n   545→+}\n   546→+\n   547→+#[test]\n   548→+fn nh3_speciation_matches_reference_formula() {\n   549→+    let tan_mg_l = 1.2;\n   550→+    let ph = 7.8;\n   551→+    let temp_c = 25.0;\n   552→+\n   553→+    let expected = {\n   554→+        let pka = 0.09018 + 2729.92 / (273.2 + temp_c);\n   555→+        let fraction_nh3 = 1.0 / (1.0 + 10.0_f64.powf(pka - ph));\n   556→+        tan_mg_l * fraction_nh3\n   557→+    };\n   558→+\n   559→+    let computed = compute_nh3_mg_l(tan_mg_l, ph, temp_c);\n   560→+    assert!((computed - expected).abs() < 1e-12);\n   561→+    assert!(compute_nh3_mg_l(tan_mg_l, 8.4, temp_c) > computed);\n   562→+}\n   563→+\n   564→+#[test]\n   565→+fn ph_formula_uses_state_storage_bounds() {\n   566→+    let low = compute_ph_from_totals(0.01, 500.0, 20.0);\n   567→+    let high = compute_ph_from_totals(12.0, 0.01, 20.0);\n   568→+\n   569→+    assert!((5.5..=8.5).contains(&low));\n   570→+    assert!((5.5..=8.5).contains(&high));\n   571→+}\n   572→diff --git a/crates/tank_core/tests/dissolved_oxygen.rs b/crates/tank_core/tests/dissolved_oxygen.rs\n   573→new file mode 100644\n   574→index 0000000..a5b0a8f\n   575→--- /dev/null\n   576→+++ b/crates/tank_core/tests/dissolved_oxygen.rs\n   577→@@ -0,0 +1,118 @@\n   578→+use tank_core::{\n   579→+    systems::{light::is_light_on, temperature::do_sat_mg_l},\n   580→+    Engine, ProcessParams, SimSeed, SimulationEngine, TankState,\n   581→+};\n   582→+\n   583→+fn oxygen_test_state(seed: SimSeed) -> TankState {\n   584→+    let mut state = TankState::new(seed);\n   585→+    state.hardware.light.photoperiod_hours = 8.0;\n   586→+    state.hardware.light.intensity_index = 1.0;\n   587→+    state.hardware.aeration.enabled = false;\n   588→+    state.hardware.aeration.intensity = 0.0;\n   589→+    state.animal.adults_count = 30;\n   590→+    state.algae.periphyton_biomass_g = 3.0;\n   591→+    state.plant_guilds[0].biomass_g = 18.0;\n   592→+    state.plant_guilds[1].biomass_g = 10.0;\n   593→+    state.process_params = ProcessParams {\n   594→+        reaeration_kla_base: 0.08,\n   595→+        aeration_kla_boost: 1.2,\n   596→+        background_bod_mg_o2_per_g_biomass_per_hour: 0.24,\n   597→+        plant_photosynthesis_o2_mg_per_g_per_hour: 0.65,\n   598→+        respiration_dic_rate_mg_c_per_g_per_hour: 0.10,\n   599→+        photosynthesis_dic_rate_mg_c_per_g_per_hour: 0.18,\n   600→+        ..ProcessParams::default()\n   601→+    };\n   602→+    state\n   603→+}\n   604→+\n   605→+#[test]\n   606→+fn dissolved_oxygen_dips_at_night_relative_to_lit_hours() -> Result<(), tank_core::SimError> {\n   607→+    let mut engine = Engine::from_parts(oxygen_test_state(SimSeed(3000)), vec![]);\n   608→+    let photoperiod = engine.full_state().hardware.light.photoperiod_hours;\n   609→+\n   610→+    let mut night_values = Vec::new();\n   611→+    let mut lit_values = Vec::new();\n   612→+\n   613→+    for _ in 0..48 {\n   614→+        let hour = engine.full_state().environment.hour_of_day;\n   615→+        engine.step_hours(1)?;\n   616→+        let do_mg_l = engine.snapshot().do_mg_l;\n   617→+        if is_light_on(hour, photoperiod) {\n   618→+            lit_values.push(do_mg_l);\n   619→+        } else {\n   620→+            night_values.push(do_mg_l);\n   621→+        }\n   622→+    }\n   623→+\n   624→+    let lit_mean = lit_values.iter().sum::<f64>() / lit_values.len() as f64;\n   625→+    let night_mean = night_values.iter().sum::<f64>() / night_values.len() as f64;\n   626→+\n   627→+    assert!(\n   628→+        night_mean < lit_mean,\n   629→+        \"night DO should be lower than lit DO: night={night_mean:.2}, lit={lit_mean:.2}\"\n   630→+    );\n   631→+\n   632→+    Ok(())\n   633→+}\n   634→+\n   635→+#[test]\n   636→+fn aeration_recovers_do_faster_than_passive_exchange() -> Result<(), tank_core::SimError> {\n   637→+    let mut base_state = oxygen_test_state(SimSeed(3100));\n   638→+    base_state.water.dissolved_oxygen_mg_total = 2.0 * base_state.geometry.water_volume_l();\n   639→+    base_state.process_params.background_bod_mg_o2_per_g_biomass_per_hour = 0.0;\n   640→+    base_state.process_params.plant_photosynthesis_o2_mg_per_g_per_hour = 0.0;\n   641→+    base_state.algae.periphyton_biomass_g = 0.0;\n   642→+    for plant in &mut base_state.plant_guilds {\n   643→+        plant.biomass_g = 0.0;\n   644→+    }\n   645→+    base_state.animal.adults_count = 0;\n   646→+\n   647→+    let mut no_aeration = base_state.clone();\n   648→+    no_aeration.hardware.aeration.enabled = false;\n   649→+\n   650→+    let mut high_aeration = base_state;\n   651→+    high_aeration.hardware.aeration.enabled = true;\n   652→+    high_aeration.hardware.aeration.intensity = 1.0;\n   653→+\n   654→+    let mut passive_engine = Engine::from_parts(no_aeration, vec![]);\n   655→+    let mut aerated_engine = Engine::from_parts(high_aeration, vec![]);\n   656→+\n   657→+    passive_engine.step_hours(6)?;\n   658→+    aerated_engine.step_hours(6)?;\n   659→+\n   660→+    assert!(\n   661→+        aerated_engine.snapshot().do_mg_l > passive_engine.snapshot().do_mg_l,\n   662→+        \"aeration should accelerate recovery: passive={:.2}, aerated={:.2}\",\n   663→+        passive_engine.snapshot().do_mg_l,\n   664→+        aerated_engine.snapshot().do_mg_l\n   665→+    );\n   666→+\n   667→+    Ok(())\n   668→+}\n   669→+\n   670→+#[test]\n   671→+fn reaeration_converges_toward_saturation() -> Result<(), tank_core::SimError> {\n   672→+    let mut state = oxygen_test_state(SimSeed(3200));\n   673→+    state.water.dissolved_oxygen_mg_total = 0.0;\n   674→+    state.process_params.background_bod_mg_o2_per_g_biomass_per_hour = 0.0;\n   675→+    state.process_params.plant_photosynthesis_o2_mg_per_g_per_hour = 0.0;\n   676→+    state.process_params.reaeration_kla_base = 0.5;\n   677→+    state.algae.periphyton_biomass_g = 0.0;\n   678→+    for plant in &mut state.plant_guilds {\n   679→+        plant.biomass_g = 0.0;\n   680→+    }\n   681→+    state.animal.adults_count = 0;\n   682→+\n   683→+    let mut engine = Engine::from_parts(state, vec![]);\n   684→+    engine.step_hours(24)?;\n   685→+\n   686→+    let do_sat = do_sat_mg_l(engine.full_state().water.temperature_c);\n   687→+    let do_now = engine.snapshot().do_mg_l;\n   688→+    assert!(do_now > 0.0, \"reaeration should raise DO above zero\");\n   689→+    assert!(\n   690→+        (do_sat - do_now).abs() < 0.25,\n   691→+        \"DO should converge toward saturation: do={do_now:.2}, sat={do_sat:.2}\"\n   692→+    );\n   693→+\n   694→+    Ok(())\n   695→+}\n   696→diff --git a/crates/tank_core/tests/events.rs b/crates/tank_core/tests/events.rs\n   697→new file mode 100644\n   698→index 0000000..d13ab3b\n   699→--- /dev/null\n   700→+++ b/crates/tank_core/tests/events.rs\n   701→@@ -0,0 +1,62 @@\n   702→+use tank_core::{\n   703→+    EventKind, ProcessParams, SimSeed, SimulationEngine, TankState, Engine,\n   704→+};\n   705→+\n   706→+fn threshold_state(seed: SimSeed) -> TankState {\n   707→+    let mut state = TankState::new(seed);\n   708→+    let volume_l = state.geometry.water_volume_l();\n   709→+    state.water.alkalinity_meq_total = 8.0 * volume_l;\n   710→+    state.water.dissolved_inorganic_carbon_mg_c_total = 0.5 * volume_l;\n   711→+    state.water.ammonia_total_mg_n_total = 0.5 * volume_l;\n   712→+    state.water.nitrite_mg_n_total = 0.7 * volume_l;\n   713→+    state.water.dissolved_oxygen_mg_total = 3.0 * volume_l;\n   714→+    state.process_params = ProcessParams {\n   715→+        reaeration_kla_base: 0.0,\n   716→+        aeration_kla_boost: 0.0,\n   717→+        background_bod_mg_o2_per_g_biomass_per_hour: 0.0,\n   718→+        plant_photosynthesis_o2_mg_per_g_per_hour: 0.0,\n   719→+        respiration_dic_rate_mg_c_per_g_per_hour: 0.0,\n   720→+        photosynthesis_dic_rate_mg_c_per_g_per_hour: 0.0,\n   721→+        ..ProcessParams::default()\n   722→+    };\n   723→+    state\n   724→+}\n   725→+\n   726→+#[test]\n   727→+fn threshold_events_emit_with_cause_codes() -> Result<(), tank_core::SimError> {\n   728→+    let mut engine = Engine::from_parts(threshold_state(SimSeed(5000)), vec![]);\n   729→+    engine.step_hours(1)?;\n   730→+\n   731→+    let events = &engine.full_state().event_log;\n   732→+    assert!(events.iter().any(|event| event.kind == EventKind::AmmoniaWarning));\n   733→+    assert!(events.iter().any(|event| event.kind == EventKind::NitriteWarning));\n   734→+    assert!(events.iter().any(|event| event.kind == EventKind::OxygenDip));\n   735→+    assert!(events.iter().all(|event| !event.cause_codes.is_empty()));\n   736→+\n   737→+    Ok(())\n   738→+}\n   739→+\n   740→+#[test]\n   741→+fn threshold_events_are_deduplicated_per_day() -> Result<(), tank_core::SimError> {\n   742→+    let mut engine = Engine::from_parts(threshold_state(SimSeed(5100)), vec![]);\n   743→+\n   744→+    engine.step_hours(6)?;\n   745→+    let same_day_count = engine\n   746→+        .full_state()\n   747→+        .event_log\n   748→+        .iter()\n   749→+        .filter(|event| event.kind == EventKind::AmmoniaWarning)\n   750→+        .count();\n   751→+    assert_eq!(same_day_count, 1, \"ammonia warning should dedupe within a day\");\n   752→+\n   753→+    engine.step_hours(24)?;\n   754→+    let next_day_count = engine\n   755→+        .full_state()\n   756→+        .event_log\n   757→+        .iter()\n   758→+        .filter(|event| event.kind == EventKind::AmmoniaWarning)\n   759→+        .count();\n   760→+    assert_eq!(next_day_count, 2, \"warning should emit again on a new day\");\n   761→+\n   762→+    Ok(())\n   763→+}\n   764→diff --git a/crates/tank_core/tests/save_load.rs b/crates/tank_core/tests/save_load.rs\n   765→index 388282b..cbfb9af 100644\n   766→--- a/crates/tank_core/tests/save_load.rs\n   767→+++ b/crates/tank_core/tests/save_load.rs\n   768→@@ -55,7 +55,12 @@ fn save_load_with_source_water_catalog() -> Result<(), tank_core::SimError> {\n   769→     state.process_params = ProcessParams {\n   770→         mineralization_rate_per_day: 0.2,\n   771→         nitrification_vmax: 0.1,\n   772→-        reaeration_kla: 0.5,\n   773→+        reaeration_kla_base: 0.5,\n   774→+        aeration_kla_boost: 1.1,\n   775→+        background_bod_mg_o2_per_g_biomass_per_hour: 0.07,\n   776→+        plant_photosynthesis_o2_mg_per_g_per_hour: 0.22,\n   777→+        respiration_dic_rate_mg_c_per_g_per_hour: 0.09,\n   778→+        photosynthesis_dic_rate_mg_c_per_g_per_hour: 0.14,\n   779→         k_surface_w_per_m2_k: 12.0,\n   780→         k_wall_w_per_m2_k: 6.0,\n   781→     };\n   782→diff --git a/crates/tank_data/data/process/default.toml b/crates/tank_data/data/process/default.toml\n   783