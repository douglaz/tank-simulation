{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016ahQRcbPwwH9bPnCHQCLvf","type":"tool_result","content":"     1→use std::collections::VecDeque;\n     2→\n     3→use crate::{\n     4→    invariants::enforce_invariants,\n     5→    rng::SimSeed,\n     6→    systems,\n     7→    types::{\n     8→        EventCause, EventKind, EventSeverity, PlayerAction, SimError, SimEvent, TankSnapshot,\n     9→        TankState,\n    10→    },\n    11→};\n    12→\n    13→pub trait SimulationEngine {\n    14→    fn apply_action(&mut self, action: PlayerAction) -> Result<(), SimError>;\n    15→    fn step_hours(&mut self, hours: u32) -> Result<(), SimError>;\n    16→    fn snapshot(&self) -> TankSnapshot;\n    17→    fn full_state(&self) -> &TankState;\n    18→}\n    19→\n    20→#[derive(Debug, Clone, PartialEq)]\n    21→pub struct Engine {\n    22→    state: TankState,\n    23→    queued_actions: VecDeque<PlayerAction>,\n    24→}\n    25→\n    26→impl Engine {\n    27→    pub fn new(seed: SimSeed) -> Self {\n    28→        Self {\n    29→            state: TankState::new(seed),\n    30→            queued_actions: VecDeque::new(),\n    31→        }\n    32→    }\n    33→\n    34→    pub fn from_parts(state: TankState, queued_actions: Vec<PlayerAction>) -> Self {\n    35→        Self {\n    36→            state,\n    37→            queued_actions: queued_actions.into(),\n    38→        }\n    39→    }\n    40→\n    41→    pub fn queued_actions(&self) -> Vec<PlayerAction> {\n    42→        self.queued_actions.iter().cloned().collect()\n    43→    }\n    44→\n    45→    fn step_one_hour(&mut self) -> Result<(), SimError> {\n    46→        let actions_slice: Vec<_> = self.queued_actions.iter().cloned().collect();\n    47→        systems::water_change::validate_water_changes(&self.state, &actions_slice)?;\n    48→\n    49→        while let Some(action) = self.queued_actions.pop_front() {\n    50→            self.process_action(action);\n    51→        }\n    52→\n    53→        // Step 4: update water temperature from ambient and heater\n    54→        systems::temperature::step_temperature(&mut self.state);\n    55→\n    56→        // Step 5: compute light state for the current hour.\n    57→        let light_on = self.state.hardware.light.enabled\n    58→            && systems::light::is_light_on(\n    59→                self.state.environment.hour_of_day,\n    60→                self.state.hardware.light.photoperiod_hours,\n    61→            );\n    62→\n    63→        // Step 9: update DIC, alkalinity, and pH.\n    64→        systems::chemistry::step_hourly_chemistry(&mut self.state, light_on);\n    65→\n    66→        // Step 10 / 11-partial: update dissolved oxygen with background respiration and\n    67→        // light-driven photosynthetic support from existing biomass.\n    68→        systems::dissolved_oxygen::step_dissolved_oxygen(&mut self.state, light_on);\n    69→\n    70→        // Step 13: emit threshold-based chemistry warnings.\n    71→        systems::events::emit_hourly_threshold_events(&mut self.state);\n    72→\n    73→        self.state.environment.hour_of_day = (self.state.environment.hour_of_day + 1) % 24;\n    74→        if self.state.environment.hour_of_day == 0 {\n    75→            self.state.environment.day += 1;\n    76→        }\n    77→\n    78→        enforce_invariants(&mut self.state)\n    79→    }\n    80→\n    81→    fn process_action(&mut self, action: PlayerAction) {\n    82→        match action {\n    83→            PlayerAction::Feed { grams } => {\n    84→                self.state.detritus.particulate_organics_g_total += grams;\n    85→                self.push_event(\n    86→                    EventSeverity::Info,\n    87→                    EventKind::CycleProgressing,\n    88→                    vec![EventCause::Overfeeding],\n    89→                    format!(\"Queued feed processed: {grams:.2} g\"),\n    90→                );\n    91→            }\n    92→            PlayerAction::WaterChangePercent {\n    93→                percent,\n    94→                source_profile_id,\n    95→            } => {\n    96→                if percent <= 0.0 {\n    97→                    return;\n    98→                }\n    99→                // Profile was pre-validated; look it up (guaranteed to exist).\n   100→                let profile = self\n   101→                    .state\n   102→                    .source_water_catalog\n   103→                    .get(&source_profile_id)\n   104→                    .cloned();\n   105→                if let Some(profile) = profile {\n   106→                    systems::water_change::apply_water_change(\n   107→                        &mut self.state,\n   108→                        percent,\n   109→                        &profile,\n   110→                    );\n   111→                    self.push_event(\n   112→                        EventSeverity::Info,\n   113→                        EventKind::StabilityImproving,\n   114→                        vec![EventCause::WaterChange],\n   115→                        format!(\"Water change processed: {percent:.1}% with {source_profile_id}\"),\n   116→                    );\n   117→                }\n   118→            }\n   119→            PlayerAction::TrimPlants { fraction } => {\n   120→                for plant in &mut self.state.plant_guilds {\n   121→                    plant.biomass_g *= 1.0 - fraction;\n   122→                }\n   123→            }\n   124→            PlayerAction::SiphonDetritus { fraction } => {\n   125→                self.state.detritus.particulate_organics_g_total *= 1.0 - fraction;\n   126→                self.state.detritus.fine_detritus_g_total *= 1.0 - fraction;\n   127→            }\n   128→            PlayerAction::CleanFilter { intensity } => {\n   129→                self.state.hardware.filter.cleanliness_index = 1.0;\n   130→                self.state.filter_state.biofilter_maturity_index *= 1.0 - (intensity * 0.5);\n   131→                self.state.filter_state.clogging_index *= 1.0 - intensity;\n   132→                self.push_event(\n   133→                    EventSeverity::Warning,\n   134→                    EventKind::FilterCleaningSetback,\n   135→                    vec![EventCause::FilterMaintenance],\n   136→                    format!(\"Filter cleaned at intensity {intensity:.2}\"),\n   137→                );\n   138→            }\n   139→            PlayerAction::AddShrimp { count } => {\n   140→                self.state.animal.adults_count =\n   141→                    self.state.animal.adults_count.saturating_add(count);\n   142→            }\n   143→            PlayerAction::RemoveShrimp { count } => {\n   144→                self.state.animal.adults_count =\n   145→                    self.state.animal.adults_count.saturating_sub(count);\n   146→            }\n   147→            PlayerAction::ChangePhotoperiod { hours } => {\n   148→                self.state.hardware.light.photoperiod_hours = hours;\n   149→            }\n   150→            PlayerAction::ChangeLightIntensity { intensity_index } => {\n   151→                self.state.hardware.light.intensity_index = intensity_index;\n   152→            }\n   153→            PlayerAction::ChangeHeaterSetpoint { setpoint_c } => {\n   154→                self.state.hardware.heater.setpoint_c = setpoint_c;\n   155→            }\n   156→            PlayerAction::ChangeAmbientTemperature { target_c } => {\n   157→                self.state.environment.ambient_temp_c = target_c;\n   158→            }\n   159→            PlayerAction::ChangeAeration { enabled, intensity } => {\n   160→                self.state.hardware.aeration.enabled = enabled;\n   161→                self.state.hardware.aeration.intensity = intensity;\n   162→            }\n   163→        }\n   164→    }\n   165→\n   166→    fn push_event(\n   167→        &mut self,\n   168→        severity: EventSeverity,\n   169→        kind: EventKind,\n   170→        cause_codes: Vec<EventCause>,\n   171→        summary: String,\n   172→    ) {\n   173→        self.state.event_log.push(SimEvent::new(\n   174→            self.state.environment.day,\n   175→            self.state.environment.hour_of_day,\n   176→            severity,\n   177→            kind,\n   178→            cause_codes,\n   179→            summary,\n   180→        ));\n   181→    }\n   182→}\n   183→\n   184→impl SimulationEngine for Engine {\n   185→    fn apply_action(&mut self, action: PlayerAction) -> Result<(), SimError> {\n   186→        action.validate()?;\n   187→        self.queued_actions.push_back(action);\n   188→        Ok(())\n   189→    }\n   190→\n   191→    fn step_hours(&mut self, hours: u32) -> Result<(), SimError> {\n   192→        for _ in 0..hours {\n   193→            self.step_one_hour()?;\n   194→        }\n   195→        enforce_invariants(&mut self.state)\n   196→    }\n   197→\n   198→    fn snapshot(&self) -> TankSnapshot {\n   199→        TankSnapshot::from_state(&self.state)\n   200→    }\n   201→\n   202→    fn full_state(&self) -> &TankState {\n   203→        &self.state\n   204→    }\n   205→}\n   206→"}]},"parent_tool_use_id":null,"session_id":"1748b4fc-51d6-4391-af57-f472921254b7","uuid":"d3209717-5177-47b1-93fd-5945df06ff0d","tool_use_result":{"type":"text","file":{"filePath":"/root/tank-simulation/crates/tank_core/src/engine.rs","content":"use std::collections::VecDeque;\n\nuse crate::{\n    invariants::enforce_invariants,\n    rng::SimSeed,\n    systems,\n    types::{\n        EventCause, EventKind, EventSeverity, PlayerAction, SimError, SimEvent, TankSnapshot,\n        TankState,\n    },\n};\n\npub trait SimulationEngine {\n    fn apply_action(&mut self, action: PlayerAction) -> Result<(), SimError>;\n    fn step_hours(&mut self, hours: u32) -> Result<(), SimError>;\n    fn snapshot(&self) -> TankSnapshot;\n    fn full_state(&self) -> &TankState;\n}\n\n#[derive(Debug, Clone, PartialEq)]\npub struct Engine {\n    state: TankState,\n    queued_actions: VecDeque<PlayerAction>,\n}\n\nimpl Engine {\n    pub fn new(seed: SimSeed) -> Self {\n        Self {\n            state: TankState::new(seed),\n            queued_actions: VecDeque::new(),\n        }\n    }\n\n    pub fn from_parts(state: TankState, queued_actions: Vec<PlayerAction>) -> Self {\n        Self {\n            state,\n            queued_actions: queued_actions.into(),\n        }\n    }\n\n    pub fn queued_actions(&self) -> Vec<PlayerAction> {\n        self.queued_actions.iter().cloned().collect()\n    }\n\n    fn step_one_hour(&mut self) -> Result<(), SimError> {\n        let actions_slice: Vec<_> = self.queued_actions.iter().cloned().collect();\n        systems::water_change::validate_water_changes(&self.state, &actions_slice)?;\n\n        while let Some(action) = self.queued_actions.pop_front() {\n            self.process_action(action);\n        }\n\n        // Step 4: update water temperature from ambient and heater\n        systems::temperature::step_temperature(&mut self.state);\n\n        // Step 5: compute light state for the current hour.\n        let light_on = self.state.hardware.light.enabled\n            && systems::light::is_light_on(\n                self.state.environment.hour_of_day,\n                self.state.hardware.light.photoperiod_hours,\n            );\n\n        // Step 9: update DIC, alkalinity, and pH.\n        systems::chemistry::step_hourly_chemistry(&mut self.state, light_on);\n\n        // Step 10 / 11-partial: update dissolved oxygen with background respiration and\n        // light-driven photosynthetic support from existing biomass.\n        systems::dissolved_oxygen::step_dissolved_oxygen(&mut self.state, light_on);\n\n        // Step 13: emit threshold-based chemistry warnings.\n        systems::events::emit_hourly_threshold_events(&mut self.state);\n\n        self.state.environment.hour_of_day = (self.state.environment.hour_of_day + 1) % 24;\n        if self.state.environment.hour_of_day == 0 {\n            self.state.environment.day += 1;\n        }\n\n        enforce_invariants(&mut self.state)\n    }\n\n    fn process_action(&mut self, action: PlayerAction) {\n        match action {\n            PlayerAction::Feed { grams } => {\n                self.state.detritus.particulate_organics_g_total += grams;\n                self.push_event(\n                    EventSeverity::Info,\n                    EventKind::CycleProgressing,\n                    vec![EventCause::Overfeeding],\n                    format!(\"Queued feed processed: {grams:.2} g\"),\n                );\n            }\n            PlayerAction::WaterChangePercent {\n                percent,\n                source_profile_id,\n            } => {\n                if percent <= 0.0 {\n                    return;\n                }\n                // Profile was pre-validated; look it up (guaranteed to exist).\n                let profile = self\n                    .state\n                    .source_water_catalog\n                    .get(&source_profile_id)\n                    .cloned();\n                if let Some(profile) = profile {\n                    systems::water_change::apply_water_change(\n                        &mut self.state,\n                        percent,\n                        &profile,\n                    );\n                    self.push_event(\n                        EventSeverity::Info,\n                        EventKind::StabilityImproving,\n                        vec![EventCause::WaterChange],\n                        format!(\"Water change processed: {percent:.1}% with {source_profile_id}\"),\n                    );\n                }\n            }\n            PlayerAction::TrimPlants { fraction } => {\n                for plant in &mut self.state.plant_guilds {\n                    plant.biomass_g *= 1.0 - fraction;\n                }\n            }\n            PlayerAction::SiphonDetritus { fraction } => {\n                self.state.detritus.particulate_organics_g_total *= 1.0 - fraction;\n                self.state.detritus.fine_detritus_g_total *= 1.0 - fraction;\n            }\n            PlayerAction::CleanFilter { intensity } => {\n                self.state.hardware.filter.cleanliness_index = 1.0;\n                self.state.filter_state.biofilter_maturity_index *= 1.0 - (intensity * 0.5);\n                self.state.filter_state.clogging_index *= 1.0 - intensity;\n                self.push_event(\n                    EventSeverity::Warning,\n                    EventKind::FilterCleaningSetback,\n                    vec![EventCause::FilterMaintenance],\n                    format!(\"Filter cleaned at intensity {intensity:.2}\"),\n                );\n            }\n            PlayerAction::AddShrimp { count } => {\n                self.state.animal.adults_count =\n                    self.state.animal.adults_count.saturating_add(count);\n            }\n            PlayerAction::RemoveShrimp { count } => {\n                self.state.animal.adults_count =\n                    self.state.animal.adults_count.saturating_sub(count);\n            }\n            PlayerAction::ChangePhotoperiod { hours } => {\n                self.state.hardware.light.photoperiod_hours = hours;\n            }\n            PlayerAction::ChangeLightIntensity { intensity_index } => {\n                self.state.hardware.light.intensity_index = intensity_index;\n            }\n            PlayerAction::ChangeHeaterSetpoint { setpoint_c } => {\n                self.state.hardware.heater.setpoint_c = setpoint_c;\n            }\n            PlayerAction::ChangeAmbientTemperature { target_c } => {\n                self.state.environment.ambient_temp_c = target_c;\n            }\n            PlayerAction::ChangeAeration { enabled, intensity } => {\n                self.state.hardware.aeration.enabled = enabled;\n                self.state.hardware.aeration.intensity = intensity;\n            }\n        }\n    }\n\n    fn push_event(\n        &mut self,\n        severity: EventSeverity,\n        kind: EventKind,\n        cause_codes: Vec<EventCause>,\n        summary: String,\n    ) {\n        self.state.event_log.push(SimEvent::new(\n            self.state.environment.day,\n            self.state.environment.hour_of_day,\n            severity,\n            kind,\n            cause_codes,\n            summary,\n        ));\n    }\n}\n\nimpl SimulationEngine for Engine {\n    fn apply_action(&mut self, action: PlayerAction) -> Result<(), SimError> {\n        action.validate()?;\n        self.queued_actions.push_back(action);\n        Ok(())\n    }\n\n    fn step_hours(&mut self, hours: u32) -> Result<(), SimError> {\n        for _ in 0..hours {\n            self.step_one_hour()?;\n        }\n        enforce_invariants(&mut self.state)\n    }\n\n    fn snapshot(&self) -> TankSnapshot {\n        TankSnapshot::from_state(&self.state)\n    }\n\n    fn full_state(&self) -> &TankState {\n        &self.state\n    }\n}\n","numLines":206,"startLine":1,"totalLines":206}}}
