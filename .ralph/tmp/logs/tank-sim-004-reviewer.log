107\t    let alk_nitrifying = nitrifying.full_state().water.alkalinity_meq_total;\n   108\t    let alk_control = control.full_state().water.alkalinity_meq_total;\n   109\t    let ph_nitrifying = nitrifying.full_state().water.ph;\n   110\t    let ph_control = control.full_state().water.ph;\n   111\t\n   112\t    // Active nitrification should lower alkalinity relative to control\n   113\t    assert!(\n   114\t        alk_nitrifying < alk_control,\n   115\t        \"Nitrifying tank ({alk_nitrifying:.4}) should have lower alkalinity than control ({alk_control:.4})\"\n   116\t    );\n   117\t    assert!(\n   118\t        alk_nitrifying < alk_before,\n   119\t        \"Alkalinity should decrease from nitrification\"\n   120\t    );\n   121\t\n   122\t    // Active nitrification should lower pH relative to control\n   123\t    assert!(\n   124\t        ph_nitrifying < ph_control,\n   125\t        \"Nitrifying tank pH ({ph_nitrifying:.3}) should be lower than control ({ph_control:.3})\"\n   126\t    );\n   127\t\n   128\t    // pH must still be within invariant bounds\n   129\t    assert!((5.5..=8.5).contains(&ph_nitrifying));\n   130\t\n   131\t    Ok(())\n   132\t}\n","exit_code":0,"status":"completed"}}
