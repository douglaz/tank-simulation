{"type":"item.completed","item":{"id":"item_71","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/tests/cycling.rs | sed -n '1,390p'\"","aggregated_output":"     1\tuse tank_core::{Engine, EventKind, PlayerAction, SimSeed, SimulationEngine, TankState};\n     2\t\n     3\t/// Feed the engine a small pellet each day for the given number of days.\n     4\tfn feed_daily(engine: &mut Engine, days: u32, grams: f64) -> Result<(), tank_core::SimError> {\n     5\t    for _ in 0..days {\n     6\t        engine.apply_action(PlayerAction::Feed { grams })?;\n     7\t        engine.step_hours(24)?;\n     8\t    }\n     9\t    Ok(())\n    10\t}\n    11\t\n    12\t#[test]\n    13\tfn cycling_seeded_vs_unseeded() -> Result<(), tank_core::SimError> {\n    14\t    let (seeded_state, unseeded_state) = tank_scenarios::cycling_fixture_pair(SimSeed(9000));\n    15\t\n    16\t    let mut seeded = Engine::from_parts(seeded_state, vec![]);\n    17\t    let mut unseeded = Engine::from_parts(unseeded_state, vec![]);\n    18\t\n    19\t    // Feed both tanks identically: 0.3g/day for 30 days\n    20\t    let days = 30;\n    21\t    let feed_g = 0.3;\n    22\t\n    23\t    // Track peak TAN and nitrite for each\n    24\t    let mut unseeded_peak_tan = 0.0_f64;\n    25\t    let mut unseeded_peak_nitrite = 0.0_f64;\n    26\t\n    27\t    // Find first hour where TAN < 0.1 and nitrite < 0.1 for each\n    28\t    let mut seeded_stable_hour: Option<u32> = None;\n    29\t    let mut unseeded_stable_hour: Option<u32> = None;\n    30\t\n    31\t    for day in 0..days {\n    32\t        seeded.apply_action(PlayerAction::Feed { grams: feed_g })?;\n    33\t        unseeded.apply_action(PlayerAction::Feed { grams: feed_g })?;\n    34\t\n    35\t        for _h in 0..24 {\n    36\t            seeded.step_hours(1)?;\n    37\t            unseeded.step_hours(1)?;\n    38\t\n    39\t            let hour = day * 24 + _h + 1;\n    40\t            let vol_s = seeded.full_state().geometry.water_volume_l();\n    41\t            let vol_u = unseeded.full_state().geometry.water_volume_l();\n    42\t\n    43\t            let s_tan = seeded.full_state().water.ammonia_total_mg_n_total / vol_s;\n    44\t            let s_no2 = seeded.full_state().water.nitrite_mg_n_total / vol_s;\n    45\t            let u_tan = unseeded.full_state().water.ammonia_total_mg_n_total / vol_u;\n    46\t            let u_no2 = unseeded.full_state().water.nitrite_mg_n_total / vol_u;\n    47\t\n    48\t            unseeded_peak_tan = unseeded_peak_tan.max(u_tan);\n    49\t            unseeded_peak_nitrite = unseeded_peak_nitrite.max(u_no2);\n    50\t\n    51\t            if seeded_stable_hour.is_none() && s_tan < 0.1 && s_no2 < 0.1 && hour > 48 {\n    52\t                seeded_stable_hour = Some(hour);\n    53\t            }\n    54\t            if unseeded_stable_hour.is_none() && u_tan < 0.1 && u_no2 < 0.1 && hour > 48 {\n    55\t                unseeded_stable_hour = Some(hour);\n    56\t            }\n    57\t        }\n    58\t    }\n    59\t\n    60\t    // The unseeded tank must show non-zero TAN and nitrite peaks\n    61\t    assert!(\n    62\t        unseeded_peak_tan > 0.01,\n    63\t        \"Unseeded tank should have non-zero TAN peaks, got {unseeded_peak_tan:.4}\"\n    64\t    );\n    65\t    assert!(\n    66\t        unseeded_peak_nitrite > 0.001,\n    67\t        \"Unseeded tank should have non-zero nitrite peaks, got {unseeded_peak_nitrite:.4}\"\n    68\t    );\n    69\t\n    70\t    // The seeded tank must reach stable state earlier than the unseeded tank.\n    71\t    // If unseeded never stabilized, that's fine — seeded just needs to have stabilized.\n    72\t    match (seeded_stable_hour, unseeded_stable_hour) {\n    73\t        (Some(s), Some(u)) => {\n    74\t            assert!(\n    75\t                s < u,\n    76\t                \"Seeded tank should stabilize earlier: seeded={s}h, unseeded={u}h\"\n    77\t            );\n    78\t        }\n    79\t        (Some(_s), None) => {\n    80\t            // Seeded stabilized, unseeded never did — that's a pass\n    81\t        }\n    82\t        (None, _) => {\n    83\t            // Both had ongoing feed, so let's just check the seeded tank has lower final TAN\n    84\t            let vol_s = seeded.full_state().geometry.water_volume_l();\n    85\t            let vol_u = unseeded.full_state().geometry.water_volume_l();\n    86\t            let final_s_tan = seeded.full_state().water.ammonia_total_mg_n_total / vol_s;\n    87\t            let final_u_tan = unseeded.full_state().water.ammonia_total_mg_n_total / vol_u;\n    88\t            assert!(\n    89\t                final_s_tan < final_u_tan,\n    90\t                \"Seeded should have lower final TAN: seeded={final_s_tan:.4}, unseeded={final_u_tan:.4}\"\n    91\t            );\n    92\t        }\n    93\t    }\n    94\t\n    95\t    Ok(())\n    96\t}\n    97\t\n    98\t#[test]\n    99\tfn filter_cleaning_setback() -> Result<(), tank_core::SimError> {\n   100\t    let (seeded_state, _) = tank_scenarios::cycling_fixture_pair(SimSeed(9100));\n   101\t    let mut engine = Engine::from_parts(seeded_state, vec![]);\n   102\t\n   103\t    // Feed and run 10 days to build up cycle activity\n   104\t    feed_daily(&mut engine, 10, 0.3)?;\n   105\t\n   106\t    let aob_before = engine.full_state().microbe.ammonia_oxidizer_biomass_g;\n   107\t    let nob_before = engine.full_state().microbe.nitrite_oxidizer_biomass_g;\n   108\t\n   109\t    // Clean filter at high intensity\n   110\t    engine.apply_action(PlayerAction::CleanFilter { intensity: 0.8 })?;\n   111\t    engine.step_hours(1)?;\n   112\t\n   113\t    let aob_after = engine.full_state().microbe.ammonia_oxidizer_biomass_g;\n   114\t    let nob_after = engine.full_state().microbe.nitrite_oxidizer_biomass_g;\n   115\t\n   116\t    assert!(\n   117\t        aob_after < aob_before,\n   118\t        \"AOB should decrease after filter cleaning: before={aob_before:.6}, after={aob_after:.6}\"\n   119\t    );\n   120\t    assert!(\n   121\t        nob_after < nob_before,\n   122\t        \"NOB should decrease after filter cleaning: before={nob_before:.6}, after={nob_after:.6}\"\n   123\t    );\n   124\t\n   125\t    // Check that FilterCleaningSetback event was emitted\n   126\t    let has_setback_event = engine\n   127\t        .full_state()\n   128\t        .event_log\n   129\t        .iter()\n   130\t        .any(|e| e.kind == EventKind::FilterCleaningSetback);\n   131\t    assert!(has_setback_event, \"FilterCleaningSetback event should be emitted\");\n   132\t\n   133\t    // After cleaning, TAN should rise temporarily when feeding resumes\n   134\t    let tan_before_feed = engine.full_state().water.ammonia_total_mg_n_total;\n   135\t    feed_daily(&mut engine, 3, 0.3)?;\n   136\t    let tan_after_feed = engine.full_state().water.ammonia_total_mg_n_total;\n   137\t    assert!(\n   138\t        tan_after_feed > tan_before_feed,\n   139\t        \"TAN should rise after filter cleaning + feeding\"\n   140\t    );\n   141\t\n   142\t    Ok(())\n   143\t}\n   144\t\n   145\t#[test]\n   146\tfn limiter_correctness_no_negative_pools() -> Result<(), tank_core::SimError> {\n   147\t    // Extreme scenario: huge feed into tiny tank with zero DO and zero microbes\n   148\t    let mut state = TankState::new(SimSeed(9200));\n   149\t\n   150\t    // Zero out microbes\n   151\t    state.microbe.decomposer_biomass_g = 0.0;\n   152\t    state.microbe.ammonia_oxidizer_biomass_g = 0.0;\n   153\t    state.microbe.nitrite_oxidizer_biomass_g = 0.0;\n   154\t    state.microbe.comammox_biomass_g = 0.0;\n   155\t\n   156\t    // Zero DO\n   157\t    state.water.dissolved_oxygen_mg_total = 0.0;\n   158\t    // Disable aeration and reaeration\n   159\t    state.process_params.reaeration_kla_base = 0.0;\n   160\t    state.process_params.aeration_kla_boost = 0.0;\n   161\t\n   162\t    let mut engine = Engine::from_parts(state, vec![]);\n   163\t\n   164\t    // Massive feed\n   165\t    engine.apply_action(PlayerAction::Feed { grams: 50.0 })?;\n   166\t    engine.step_hours(100)?;\n   167\t\n   168\t    let s = engine.full_state();\n   169\t    assert!(s.water.ammonia_total_mg_n_total >= 0.0);\n   170\t    assert!(s.water.nitrite_mg_n_total >= 0.0);\n   171\t    assert!(s.water.nitrate_mg_n_total >= 0.0);\n   172\t    assert!(s.water.dissolved_oxygen_mg_total >= 0.0);\n   173\t    assert!(s.water.alkalinity_meq_total >= 0.0);\n   174\t    assert!(s.detritus.particulate_organics_g_total >= 0.0);\n   175\t    assert!(s.detritus.fine_detritus_g_total >= 0.0);\n   176\t    assert!(s.detritus.dissolved_feed_residue_g_total >= 0.0);\n   177\t    assert!(s.water.dissolved_organic_carbon_mg_c_total >= 0.0);\n   178\t    assert!(s.water.dissolved_organic_nitrogen_mg_n_total >= 0.0);\n   179\t\n   180\t    // All values must be finite\n   181\t    assert!(s.water.ammonia_total_mg_n_total.is_finite());\n   182\t    assert!(s.water.nitrite_mg_n_total.is_finite());\n   183\t    assert!(s.water.nitrate_mg_n_total.is_finite());\n   184\t\n   185\t    Ok(())\n   186\t}\n   187\t\n   188\t#[test]\n   189\tfn siphon_detritus_reduces_cycling_pressure() -> Result<(), tank_core::SimError> {\n   190\t    let (seeded_state, _) = tank_scenarios::cycling_fixture_pair(SimSeed(9300));\n   191\t\n   192\t    // Control: no siphoning\n   193\t    let mut control = Engine::from_parts(seeded_state.clone(), vec![]);\n   194\t    // Siphoned: siphon daily\n   195\t    let mut siphoned = Engine::from_parts(seeded_state, vec![]);\n   196\t\n   197\t    for day in 0..14 {\n   198\t        control.apply_action(PlayerAction::Feed { grams: 0.5 })?;\n   199\t        siphoned.apply_action(PlayerAction::Feed { grams: 0.5 })?;\n   200\t\n   201\t        if day % 2 == 0 {\n   202\t            siphoned.apply_action(PlayerAction::SiphonDetritus { fraction: 0.3 })?;\n   203\t        }\n   204\t\n   205\t        control.step_hours(24)?;\n   206\t        siphoned.step_hours(24)?;\n   207\t    }\n   208\t\n   209\t    // Siphoned tank should have lower detritus\n   210\t    assert!(\n   211\t        siphoned.full_state().detritus.particulate_organics_g_total\n   212\t            < control.full_state().detritus.particulate_organics_g_total,\n   213\t        \"Siphoning should reduce particulate detritus\"\n   214\t    );\n   215\t\n   216\t    // Siphoning must NOT directly remove dissolved TAN/nitrite/nitrate — that's handled\n   217\t    // only through the mineralization pathway. We verify the siphon doesn't zero them out\n   218\t    // by checking the control tank has more dissolved N (which was never siphoned away).\n   219\t    // The siphoned tank should have less TAN over time because less detritus = less mineralization.\n   220\t    let vol = control.full_state().geometry.water_volume_l();\n   221\t    let control_tan = control.full_state().water.ammonia_total_mg_n_total / vol;\n   222\t    let siphoned_tan = siphoned.full_state().water.ammonia_total_mg_n_total / vol;\n   223\t    // Note: this might not always hold if nitrification is very active, but with heavy feeding\n   224\t    // the control should accumulate more TAN due to higher detritus.\n   225\t    // We just verify pools are non-negative.\n   226\t    assert!(siphoned_tan >= 0.0);\n   227\t    assert!(control_tan >= 0.0);\n   228\t\n   229\t    Ok(())\n   230\t}\n   231\t\n   232\t/// Verify that when DO is very scarce, combined AOB + comammox oxidation is\n   233\t/// capped by the shared O2 budget and never exceeds available DO.\n   234\t#[test]\n   235\tfn limiter_shared_do_budget() -> Result<(), tank_core::SimError> {\n   236\t    let mut state = TankState::new(SimSeed(9400));\n   237\t    let vol = state.geometry.water_volume_l();\n   238\t\n   239\t    // Plenty of TAN substrate\n   240\t    state.water.ammonia_total_mg_n_total = 10.0 * vol;\n   241\t    // Very small DO pool — only enough for ~0.5 mg N total nitrification\n   242\t    // 0.5 mg N via AOB path costs 0.5 * 3.43 = 1.715 mg O2\n   243\t    // 0.5 mg N via comammox costs 0.5 * 4.57 = 2.285 mg O2\n   244\t    state.water.dissolved_oxygen_mg_total = 2.0; // tiny budget\n   245\t\n   246\t    // Large biomass to ensure kinetic potential exceeds DO budget\n   247\t    state.microbe.ammonia_oxidizer_biomass_g = 1.0;\n   248\t    state.microbe.comammox_biomass_g = 1.0;\n   249\t    state.microbe.nitrite_oxidizer_biomass_g = 0.5;\n   250\t    state.filter_state.biofilter_maturity_index = 0.8;\n   251\t\n   252\t    // Disable reaeration so DO is not replenished\n   253\t    state.process_params.reaeration_kla_base = 0.0;\n   254\t    state.process_params.aeration_kla_boost = 0.0;\n   255\t\n   256\t    let do_before = state.water.dissolved_oxygen_mg_total;\n   257\t\n   258\t    let mut engine = Engine::from_parts(state, vec![]);\n   259\t    engine.step_hours(1)?;\n   260\t\n   261\t    let s = engine.full_state();\n   262\t    assert!(\n   263\t        s.water.dissolved_oxygen_mg_total >= 0.0,\n   264\t        \"DO must remain non-negative, got {}\",\n   265\t        s.water.dissolved_oxygen_mg_total\n   266\t    );\n   267\t\n   268\t    // Total N consumed from TAN should be limited by the small DO pool\n   269\t    let tan_consumed = 10.0 * vol - s.water.ammonia_total_mg_n_total;\n   270\t    // Maximum possible from 2 mg O2: 2.0/3.43 ≈ 0.58 mg N (if all went to AOB)\n   271\t    // or 2.0/4.57 ≈ 0.44 mg N (if all went to comammox)\n   272\t    // Either way, total O2 consumed must not exceed the starting budget\n   273\t    let o2_consumed = do_before - s.water.dissolved_oxygen_mg_total;\n   274\t    assert!(\n   275\t        o2_consumed <= do_before + 1e-9,\n   276\t        \"O2 consumed ({o2_consumed:.6}) must not exceed initial budget ({do_before:.6})\"\n   277\t    );\n   278\t    // Sanity: some nitrification did happen\n   279\t    assert!(\n   280\t        tan_consumed > 0.0,\n   281\t        \"Some TAN should be consumed even with limited DO\"\n   282\t    );\n   283\t\n   284\t    Ok(())\n   285\t}\n   286\t\n   287\t/// Verify that when alkalinity is nearly exhausted, nitrification is limited\n   288\t/// to the supported fraction and alkalinity cannot go negative.\n   289\t#[test]\n   290\tfn limiter_low_alkalinity_caps_nitrification() -> Result<(), tank_core::SimError> {\n   291\t    let mut state = TankState::new(SimSeed(9500));\n   292\t    let vol = state.geometry.water_volume_l();\n   293\t\n   294\t    // Plenty of TAN and DO\n   295\t    state.water.ammonia_total_mg_n_total = 10.0 * vol;\n   296\t    state.water.dissolved_oxygen_mg_total = 50.0 * vol;\n   297\t    // Very low alkalinity: only enough for ~1 mg N at 0.1428 meq/mg N\n   298\t    state.water.alkalinity_meq_total = 0.15; // supports ~1.05 mg N total\n   299\t\n   300\t    state.microbe.ammonia_oxidizer_biomass_g = 0.5;\n   301\t    state.microbe.comammox_biomass_g = 0.3;\n   302\t    state.microbe.nitrite_oxidizer_biomass_g = 0.3;\n   303\t    state.filter_state.biofilter_maturity_index = 0.8;\n   304\t\n   305\t    let alk_before = state.water.alkalinity_meq_total;\n   306\t\n   307\t    let mut engine = Engine::from_parts(state, vec![]);\n   308\t    engine.step_hours(1)?;\n   309\t\n   310\t    let s = engine.full_state();\n   311\t    assert!(\n   312\t        s.water.alkalinity_meq_total >= 0.0,\n   313\t        \"Alkalinity must remain non-negative, got {}\",\n   314\t        s.water.alkalinity_meq_total\n   315\t    );\n   316\t\n   317\t    // Total alkalinity consumed should not exceed the starting budget\n   318\t    let alk_consumed = alk_before - s.water.alkalinity_meq_total;\n   319\t    assert!(\n   320\t        alk_consumed <= alk_before + 1e-9,\n   321\t        \"Alkalinity consumed ({alk_consumed:.6}) must not exceed initial budget ({alk_before:.6})\"\n   322\t    );\n   323\t\n   324\t    // Some nitrification should still have occurred\n   325\t    let tan_consumed = 10.0 * vol - s.water.ammonia_total_mg_n_total;\n   326\t    assert!(\n   327\t        tan_consumed > 0.0,\n   328\t        \"Some TAN should be consumed even with limited alkalinity\"\n   329\t    );\n   330\t\n   331\t    Ok(())\n   332\t}\n   333\t\n   334\t/// Verify that a dirty (clogged) filter reduces nitrification rate compared\n   335\t/// to a clean filter.\n   336\t#[test]\n   337\tfn dirty_filter_slows_nitrification() -> Result<(), tank_core::SimError> {\n   338\t    let base = {\n   339\t        let mut state = TankState::new(SimSeed(9600));\n   340\t        let vol = state.geometry.water_volume_l();\n   341\t        state.water.ammonia_total_mg_n_total = 5.0 * vol;\n   342\t        state.microbe.ammonia_oxidizer_biomass_g = 0.2;\n   343\t        state.microbe.nitrite_oxidizer_biomass_g = 0.15;\n   344\t        state.microbe.comammox_biomass_g = 0.03;\n   345\t        state.filter_state.biofilter_maturity_index = 0.6;\n   346\t        state\n   347\t    };\n   348\t\n   349\t    let mut clean_state = base.clone();\n   350\t    clean_state.filter_state.clogging_index = 0.0; // clean\n   351\t\n   352\t    let mut dirty_state = base;\n   353\t    dirty_state.filter_state.clogging_index = 0.9; // heavily clogged\n   354\t\n   355\t    let vol = clean_state.geometry.water_volume_l();\n   356\t\n   357\t    let mut clean_engine = Engine::from_parts(clean_state, vec![]);\n   358\t    let mut dirty_engine = Engine::from_parts(dirty_state, vec![]);\n   359\t\n   360\t    clean_engine.step_hours(24)?;\n   361\t    dirty_engine.step_hours(24)?;\n   362\t\n   363\t    let clean_tan = clean_engine.full_state().water.ammonia_total_mg_n_total / vol;\n   364\t    let dirty_tan = dirty_engine.full_state().water.ammonia_total_mg_n_total / vol;\n   365\t\n   366\t    // Clean filter should oxidize more TAN -> lower remaining TAN\n   367\t    assert!(\n   368\t        clean_tan < dirty_tan,\n   369\t        \"Clean filter TAN ({clean_tan:.4}) should be lower than dirty filter ({dirty_tan:.4})\"\n   370\t    );\n   371\t\n   372\t    Ok(())\n   373\t}\n","exit_code":0,"status":"completed"}}
