y, and pH.\n    71\t        systems::chemistry::step_hourly_chemistry(&mut self.state, light_on);\n    72\t\n    73\t        // Step 10 / 11-partial: update dissolved oxygen with background respiration and\n    74\t        // light-driven photosynthetic support from existing biomass.\n    75\t        systems::dissolved_oxygen::step_dissolved_oxygen(&mut self.state, light_on);\n    76\t\n    77\t        // Step 13: emit threshold-based chemistry warnings.\n    78\t        systems::events::emit_hourly_threshold_events(&mut self.state);\n    79\t\n    80\t        self.state.environment.hour_of_day = (self.state.environment.hour_of_day + 1) % 24;\n    81\t        if self.state.environment.hour_of_day == 0 {\n    82\t            self.state.environment.day += 1;\n    83\t            // Daily pipeline\n    84\t            self.run_daily_update();\n    85\t        }\n    86\t\n    87\t        enforce_invariants(&mut self.state)\n    88\t    }\n    89\t\n    90\t    fn run_daily_update(&mut self) {\n    91\t        // Step 6 (daily): biofilter maturity summary update\n    92\t        let maturity_delta =\n    93\t            systems::nitrogen_cycle::update_daily_biofilter_maturity(&mut self.state);\n    94\t        if maturity_delta > 0.005 {\n    95\t            self.push_event(\n    96\t                EventSeverity::Info,\n    97\t                EventKind::BiofilmMaturityIncrease,\n    98\t                vec![EventCause::BiofilterImmature],\n    99\t                format!(\n   100\t                    \"Biofilter maturity increased to {:.3}\",\n   101\t                    self.state.filter_state.biofilter_maturity_index\n   102\t                ),\n   103\t            );\n   104\t        }\n   105\t        // Emit CycleProgressing when maturity is actively growing\n   106\t        let current_maturity = self.state.filter_state.biofilter_maturity_index;\n   107\t        if maturity_delta > 0.001 && current_maturity < 0.9 {\n   108\t            systems::events::emit_once