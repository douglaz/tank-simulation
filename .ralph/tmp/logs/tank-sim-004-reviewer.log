{"type":"item.completed","item":{"id":"item_65","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/src/systems/nitrogen_cycle.rs | sed -n '1,260p'\"","aggregated_output":"     1\tuse crate::types::TankState;\n     2\t\n     3\t/// Result of one hourly nitrogen cycle step, carrying coupling values\n     4\t/// that downstream systems (DO, chemistry) need.\n     5\t#[derive(Debug, Clone, Copy, Default)]\n     6\tpub struct NitrogenCycleOutput {\n     7\t    /// Total mg N oxidized to nitrate this tick (AOB + NOB + comammox pathway).\n     8\t    pub total_mg_n_nitrified: f64,\n     9\t}\n    10\t\n    11\t/// Monod-style environmental factors shared across guilds.\n    12\tstruct EnvFactors {\n    13\t    f_temp: f64,\n    14\t    f_ph: f64,\n    15\t    maturity_factor: f64,\n    16\t    /// Dirty-filter penalty: 1.0 = clean, lower = clogged/dirty.\n    17\t    dirty_filter_factor: f64,\n    18\t}\n    19\t\n    20\tfn safe_rate(v: f64) -> f64 {\n    21\t    if v.is_finite() { v.max(0.0) } else { 0.0 }\n    22\t}\n    23\t\n    24\t/// Runs the full nitrogen-cycle phase for one hourly tick.\n    25\t///\n    26\t/// Order: feed leaching -> detritus breakdown/mineralization -> nitrification + guild growth/decay.\n    27\t///\n    28\t/// Returns coupling values for downstream DO and alkalinity systems.\n    29\tpub fn step_nitrogen_cycle(state: &mut TankState) -> NitrogenCycleOutput {\n    30\t    let volume_l = state.geometry.water_volume_l();\n    31\t    if volume_l <= f64::EPSILON {\n    32\t        return NitrogenCycleOutput::default();\n    33\t    }\n    34\t\n    35\t    let pp = &state.process_params;\n    36\t\n    37\t    // ---- 1. Feed leaching: particulate -> fine detritus ----\n    38\t    let leach_rate = safe_rate(pp.feed_leach_rate_per_hour);\n    39\t    let leached = (state.detritus.particulate_organics_g_total * leach_rate)\n    40\t        .min(state.detritus.particulate_organics_g_total);\n    41\t    state.detritus.particulate_organics_g_total -= leached;\n    42\t    state.detritus.fine_detritus_g_total += leached;\n    43\t\n    44\t    // ---- 2. Fine detritus dissolution: fine detritus -> dissolved organic pools ----\n    45\t    let diss_rate = safe_rate(pp.fine_detritus_dissolution_rate_per_hour);\n    46\t    let dissolved = (state.detritus.fine_detritus_g_total * diss_rate)\n    47\t        .min(state.detritus.fine_detritus_g_total);\n    48\t    state.detritus.fine_detritus_g_total -= dissolved;\n    49\t    // dissolved mass (g) -> mg for dissolved pools: 1 g = 1000 mg\n    50\t    // Split into DOC and DON using N:C ratio\n    51\t    let n_to_c = safe_rate(pp.feed_n_to_c_ratio);\n    52\t    let doc_mg = dissolved * 1000.0 / (1.0 + n_to_c); // carbon fraction\n    53\t    let don_mg = doc_mg * n_to_c; // nitrogen fraction\n    54\t    state.water.dissolved_organic_carbon_mg_c_total += doc_mg;\n    55\t    state.water.dissolved_organic_nitrogen_mg_n_total += don_mg;\n    56\t    // Track flow through dissolved_feed_residue (bookkeeping, decremented by mineralization)\n    57\t    state.detritus.dissolved_feed_residue_g_total += dissolved;\n    58\t\n    59\t    // ---- 3. Decomposer mineralization: DOC/DON -> TAN ----\n    60\t    let decomposer_biomass = state.microbe.decomposer_biomass_g;\n    61\t    let doc_total = state.water.dissolved_organic_carbon_mg_c_total;\n    62\t    let don_total = state.water.dissolved_organic_nitrogen_mg_n_total;\n    63\t    let do_total = state.water.dissolved_oxygen_mg_total;\n    64\t\n    65\t    // Environmental factors for decomposers\n    66\t    let temp = state.water.temperature_c;\n    67\t    let f_temp_decomp = temperature_factor(temp);\n    68\t    let f_do_decomp = do_total / (do_total + 2.0); // half-sat ~2 mg total\n    69\t\n    70\t    let decomp_vmax = safe_rate(pp.decomposer_vmax_per_hour);\n    71\t    let k_doc = pp.decomposer_k_doc_mg.max(0.01);\n    72\t    let monod_doc = doc_total / (doc_total + k_doc);\n    73\t\n    74\t    let potential_doc_consumed_mg = decomp_vmax * decomposer_biomass * 1000.0 // g->mg conversion for biomass effect\n    75\t        * f_temp_decomp * f_do_decomp * monod_doc;\n    76\t    let potential_doc_consumed_mg = safe_rate(potential_doc_consumed_mg);\n    77\t\n    78\t    // Clamp: cannot consume more DOC than exists\n    79\t    let doc_consumed_mg = potential_doc_consumed_mg.min(doc_total);\n    80\t    // Proportional DON consumed\n    81\t    let don_consumed_mg = if doc_total > f64::EPSILON {\n    82\t        doc_consumed_mg * (don_total / doc_total)\n    83\t    } else {\n    84\t        0.0\n    85\t    };\n    86\t    let don_consumed_mg = don_consumed_mg.min(don_total);\n    87\t\n    88\t    state.water.dissolved_organic_carbon_mg_c_total -= doc_consumed_mg;\n    89\t    state.water.dissolved_organic_nitrogen_mg_n_total -= don_consumed_mg;\n    90\t    // Mineralized DON becomes TAN\n    91\t    state.water.ammonia_total_mg_n_total += don_consumed_mg;\n    92\t    // Track residue pool depletion\n    93\t    let residue_consumed_g = doc_consumed_mg / 1000.0 * (1.0 + n_to_c);\n    94\t    state.detritus.dissolved_feed_residue_g_total =\n    95\t        (state.detritus.dissolved_feed_residue_g_total - residue_consumed_g).max(0.0);\n    96\t\n    97\t    // Decomposer growth/decay\n    98\t    let decomp_growth = safe_rate(pp.decomposer_growth_yield) * doc_consumed_mg / 1000.0; // mg->g\n    99\t    let decomp_decay = safe_rate(pp.decomposer_decay_rate_per_hour) * decomposer_biomass;\n   100\t    state.microbe.decomposer_biomass_g =\n   101\t        (state.microbe.decomposer_biomass_g + decomp_growth - decomp_decay).max(0.0);\n   102\t\n   103\t    // ---- 4. Nitrification: TAN -> nitrite -> nitrate (+ comammox TAN -> nitrate) ----\n   104\t    //\n   105\t    // Shared DO and alkalinity budgets enforce that combined nitrification\n   106\t    // can never consume more O2 or alkalinity than available this tick.\n   107\t    let env = compute_env_factors(state);\n   108\t    let combined_env = env.maturity_factor * env.dirty_filter_factor;\n   109\t\n   110\t    let mut do_budget = state.water.dissolved_oxygen_mg_total;\n   111\t    let alk_per_mg_n = safe_rate(pp.alkalinity_meq_per_mg_n_nitrified);\n   112\t    let mut alk_budget = state.water.alkalinity_meq_total;\n   113\t\n   114\t    // Stoichiometric O2 costs per mg N for each guild step\n   115\t    let o2_for_aob = 3.43_f64; // TAN -> nitrite\n   116\t    let o2_for_comammox = pp.o2_per_mg_n_nitrified; // TAN -> nitrate (4.57)\n   117\t    let o2_for_nob = 1.14_f64; // nitrite -> nitrate\n   118\t\n   119\t    // 4a. AOB: TAN -> nitrite\n   120\t    let aob_potential = monod_rate(\n   121\t        safe_rate(pp.aob_vmax_mg_n_per_g_per_hour),\n   122\t        state.microbe.ammonia_oxidizer_biomass_g,\n   123\t        combined_env,\n   124\t        env.f_temp,\n   125\t        env.f_ph,\n   126\t        do_budget / (do_budget + pp.aob_k_do_mg.max(0.01)),\n   127\t        state.water.ammonia_total_mg_n_total,\n   128\t        pp.aob_k_tan_mg.max(0.01),\n   129\t    );\n   130\t    let aob_rate = safe_rate(aob_potential)\n   131\t        .min(state.water.ammonia_total_mg_n_total)\n   132\t        .min(if o2_for_aob > 0.0 { do_budget / o2_for_aob } else { f64::MAX })\n   133\t        .min(if alk_per_mg_n > 0.0 { alk_budget / alk_per_mg_n } else { f64::MAX });\n   134\t\n   135\t    // Debit shared budgets for AOB\n   136\t    let aob_o2_cost = aob_rate * o2_for_aob;\n   137\t    let aob_alk_cost = aob_rate * alk_per_mg_n;\n   138\t    do_budget = (do_budget - aob_o2_cost).max(0.0);\n   139\t    alk_budget = (alk_budget - aob_alk_cost).max(0.0);\n   140\t\n   141\t    // 4b. Comammox: TAN -> nitrate directly (lower vmax)\n   142\t    let comammox_vmax = safe_rate(pp.aob_vmax_mg_n_per_g_per_hour * pp.comammox_vmax_fraction);\n   143\t    let tan_after_aob = (state.water.ammonia_total_mg_n_total - aob_rate).max(0.0);\n   144\t    let comammox_potential = monod_rate(\n   145\t        comammox_vmax,\n   146\t        state.microbe.comammox_biomass_g,\n   147\t        combined_env,\n   148\t        env.f_temp,\n   149\t        env.f_ph,\n   150\t        do_budget / (do_budget + pp.comammox_k_do_mg.max(0.01)),\n   151\t        tan_after_aob,\n   152\t        pp.comammox_k_tan_mg.max(0.01),\n   153\t    );\n   154\t    let comammox_rate = safe_rate(comammox_potential)\n   155\t        .min(tan_after_aob)\n   156\t        .min(if o2_for_comammox > 0.0 { do_budget / o2_for_comammox } else { f64::MAX })\n   157\t        .min(if alk_per_mg_n > 0.0 { alk_budget / alk_per_mg_n } else { f64::MAX });\n   158\t\n   159\t    // Debit shared budgets for comammox\n   160\t    let comammox_o2_cost = comammox_rate * o2_for_comammox;\n   161\t    let comammox_alk_cost = comammox_rate * alk_per_mg_n;\n   162\t    do_budget = (do_budget - comammox_o2_cost).max(0.0);\n   163\t    alk_budget = (alk_budget - comammox_alk_cost).max(0.0);\n   164\t\n   165\t    // Apply AOB + comammox TAN consumption\n   166\t    let total_tan_consumed = aob_rate + comammox_rate;\n   167\t    state.water.ammonia_total_mg_n_total =\n   168\t        (state.water.ammonia_total_mg_n_total - total_tan_consumed).max(0.0);\n   169\t    // AOB produces nitrite\n   170\t    state.water.nitrite_mg_n_total += aob_rate;\n   171\t    // Comammox produces nitrate directly\n   172\t    state.water.nitrate_mg_n_total += comammox_rate;\n   173\t\n   174\t    // Apply O2 costs so far (AOB + comammox) to state\n   175\t    state.water.dissolved_oxygen_mg_total =\n   176\t        (state.water.dissolved_oxygen_mg_total - aob_o2_cost - comammox_o2_cost).max(0.0);\n   177\t\n   178\t    // 4c. NOB: nitrite -> nitrate (uses remaining DO/alk budget)\n   179\t    let nob_potential = monod_rate(\n   180\t        safe_rate(pp.nob_vmax_mg_n_per_g_per_hour),\n   181\t        state.microbe.nitrite_oxidizer_biomass_g,\n   182\t        combined_env,\n   183\t        env.f_temp,\n   184\t        env.f_ph,\n   185\t        do_budget / (do_budget + pp.nob_k_do_mg.max(0.01)),\n   186\t        state.water.nitrite_mg_n_total,\n   187\t        pp.nob_k_nitrite_mg.max(0.01),\n   188\t    );\n   189\t    let nob_rate = safe_rate(nob_potential)\n   190\t        .min(state.water.nitrite_mg_n_total)\n   191\t        .min(if o2_for_nob > 0.0 { do_budget / o2_for_nob } else { f64::MAX })\n   192\t        .min(if alk_per_mg_n > 0.0 { alk_budget / alk_per_mg_n } else { f64::MAX });\n   193\t\n   194\t    let nob_o2_cost = nob_rate * o2_for_nob;\n   195\t\n   196\t    state.water.nitrite_mg_n_total = (state.water.nitrite_mg_n_total - nob_rate).max(0.0);\n   197\t    state.water.nitrate_mg_n_total += nob_rate;\n   198\t    state.water.dissolved_oxygen_mg_total =\n   199\t        (state.water.dissolved_oxygen_mg_total - nob_o2_cost).max(0.0);\n   200\t\n   201\t    // Total N fully nitrified to nitrate (for alkalinity coupling)\n   202\t    // AOB only takes TAN -> nitrite, NOB takes nitrite -> nitrate, comammox takes TAN -> nitrate\n   203\t    // Full pathway N: nob_rate (came from AOB path) + comammox_rate\n   204\t    let total_mg_n_nitrified = nob_rate + comammox_rate;\n   205\t\n   206\t    // ---- 5. Guild growth and decay ----\n   207\t    // AOB growth from TAN oxidized\n   208\t    let aob_growth = safe_rate(pp.aob_growth_yield) * aob_rate;\n   209\t    let aob_decay = safe_rate(pp.aob_decay_rate_per_hour) * state.microbe.ammonia_oxidizer_biomass_g;\n   210\t    state.microbe.ammonia_oxidizer_biomass_g =\n   211\t        (state.microbe.ammonia_oxidizer_biomass_g + aob_growth - aob_decay).max(0.0);\n   212\t\n   213\t    // NOB growth from nitrite oxidized\n   214\t    let nob_growth = safe_rate(pp.nob_growth_yield) * nob_rate;\n   215\t    let nob_decay = safe_rate(pp.nob_decay_rate_per_hour) * state.microbe.nitrite_oxidizer_biomass_g;\n   216\t    state.microbe.nitrite_oxidizer_biomass_g =\n   217\t        (state.microbe.nitrite_oxidizer_biomass_g + nob_growth - nob_decay).max(0.0);\n   218\t\n   219\t    // Comammox growth from TAN fully oxidized\n   220\t    let comammox_growth = safe_rate(pp.comammox_growth_yield) * comammox_rate;\n   221\t    let comammox_decay = safe_rate(pp.comammox_decay_rate_per_hour) * state.microbe.comammox_biomass_g;\n   222\t    state.microbe.comammox_biomass_g =\n   223\t        (state.microbe.comammox_biomass_g + comammox_growth - comammox_decay).max(0.0);\n   224\t\n   225\t    // ---- 6. Alkalinity consumption from nitrification ----\n   226\t    // AOB and comammox alkalinity was already tracked in the budget; apply the\n   227\t    // total consumption (AOB + comammox + NOB path) to state.\n   228\t    let total_alk_consumed = (aob_rate + comammox_rate + nob_rate) * alk_per_mg_n;\n   229\t    state.water.alkalinity_meq_total =\n   230\t        (state.water.alkalinity_meq_total - total_alk_consumed).max(0.0);\n   231\t\n   232\t    // Nitrification is a chemoautotrophic process that produces some DIC fixation\n   233\t    // but for simplicity we model it as a net DIC producer via mineralization pathway above.\n   234\t\n   235\t    NitrogenCycleOutput {\n   236\t        total_mg_n_nitrified,\n   237\t    }\n   238\t}\n   239\t\n   240\t/// Temperature factor: peaks around 25-30°C, drops off at extremes.\n   241\tfn temperature_factor(temp_c: f64) -> f64 {\n   242\t    // Bell-shaped factor peaking at 28°C with a half-width of ~10°C\n   243\t    let opt = 28.0;\n   244\t    let sigma = 10.0;\n   245\t    let diff = temp_c - opt;\n   246\t    (-(diff * diff) / (2.0 * sigma * sigma)).exp()\n   247\t}\n   248\t\n   249\t/// pH factor: nitrifiers prefer 7-8, reduced at extremes.\n   250\tfn ph_factor(ph: f64) -> f64 {\n   251\t    let opt = 7.5;\n   252\t    let sigma = 1.5;\n   253\t    let diff = ph - opt;\n   254\t    (-(diff * diff) / (2.0 * sigma * sigma)).exp()\n   255\t}\n   256\t\n   257\tfn compute_env_factors(state: &TankState) -> EnvFactors {\n   258\t    let f_temp = temperature_factor(state.water.temperature_c);\n   259\t    let f_ph = ph_factor(state.water.ph);\n   260\t\n","exit_code":0,"status":"completed"}}
