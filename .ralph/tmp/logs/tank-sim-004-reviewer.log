{"type":"item.completed","item":{"id":"item_72","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/tests/tank_size_thermal_response.rs | sed -n '135,210p'\"","aggregated_output":"   135\t\n   136\t    Ok(())\n   137\t}\n   138\t\n   139\t#[test]\n   140\tfn feed_pulse_tan_concentration_scales_with_volume() -> Result<(), tank_core::SimError> {\n   141\t    let mut state_10l = state_with_volume(SimSeed(2200), 10.0);\n   142\t    let mut state_100l = state_with_volume(SimSeed(2200), 100.0);\n   143\t\n   144\t    // Give both tanks some decomposer biomass to mineralize feed into TAN\n   145\t    state_10l.microbe.decomposer_biomass_g = 0.1;\n   146\t    state_100l.microbe.decomposer_biomass_g = 0.1;\n   147\t    // Same maturity so nitrification doesn't dominate the result\n   148\t    state_10l.filter_state.biofilter_maturity_index = 0.1;\n   149\t    state_100l.filter_state.biofilter_maturity_index = 0.1;\n   150\t    state_10l.microbe.ammonia_oxidizer_biomass_g = 0.01;\n   151\t    state_100l.microbe.ammonia_oxidizer_biomass_g = 0.01;\n   152\t    state_10l.microbe.nitrite_oxidizer_biomass_g = 0.01;\n   153\t    state_100l.microbe.nitrite_oxidizer_biomass_g = 0.01;\n   154\t    state_10l.microbe.comammox_biomass_g = 0.001;\n   155\t    state_100l.microbe.comammox_biomass_g = 0.001;\n   156\t\n   157\t    let mut engine_10l = Engine::from_parts(state_10l, vec![]);\n   158\t    let mut engine_100l = Engine::from_parts(state_100l, vec![]);\n   159\t\n   160\t    // Same feed pulse to both\n   161\t    let feed_g = 1.0;\n   162\t    engine_10l.apply_action(PlayerAction::Feed { grams: feed_g })?;\n   163\t    engine_100l.apply_action(PlayerAction::Feed { grams: feed_g })?;\n   164\t\n   165\t    // Track peak TAN mg/L over 7 days\n   166\t    let mut peak_tan_10l = 0.0_f64;\n   167\t    let mut peak_tan_100l = 0.0_f64;\n   168\t\n   169\t    for _ in 0..(7 * 24) {\n   170\t        engine_10l.step_hours(1)?;\n   171\t        engine_100l.step_hours(1)?;\n   172\t\n   173\t        let vol_10 = engine_10l.full_state().geometry.water_volume_l();\n   174\t        let vol_100 = engine_100l.full_state().geometry.water_volume_l();\n   175\t\n   176\t        let tan_10 = engine_10l.full_state().water.ammonia_total_mg_n_total / vol_10;\n   177\t        let tan_100 = engine_100l.full_state().water.ammonia_total_mg_n_total / vol_100;\n   178\t\n   179\t        peak_tan_10l = peak_tan_10l.max(tan_10);\n   180\t        peak_tan_100l = peak_tan_100l.max(tan_100);\n   181\t    }\n   182\t\n   183\t    assert!(\n   184\t        peak_tan_10l > 0.0,\n   185\t        \"10L tank should have non-zero peak TAN\"\n   186\t    );\n   187\t    assert!(\n   188\t        peak_tan_100l > 0.0,\n   189\t        \"100L tank should have non-zero peak TAN\"\n   190\t    );\n   191\t    assert!(\n   192\t        peak_tan_10l >= 5.0 * peak_tan_100l,\n   193\t        \"Peak TAN in 10L ({peak_tan_10l:.4} mg/L) should be >= 5x the 100L peak ({peak_tan_100l:.4} mg/L)\"\n   194\t    );\n   195\t\n   196\t    Ok(())\n   197\t}\n","exit_code":0,"status":"completed"}}
