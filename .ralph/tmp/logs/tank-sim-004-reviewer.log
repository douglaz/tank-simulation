{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_scenarios/src/lib.rs | sed -n '215,275p'\"","aggregated_output":"   215\t\n   216\t    Ok(state)\n   217\t}\n   218\t\n   219\t/// Creates a deterministic cycling fixture pair: one seeded, one unseeded.\n   220\t/// Both tanks are otherwise identical (~20L nano tank with moderate source water,\n   221\t/// fed daily, with aeration enabled).\n   222\t/// The seeded tank starts with elevated nitrifier biomass and higher maturity;\n   223\t/// the unseeded tank starts with minimal microbes and low maturity.\n   224\tpub fn cycling_fixture_pair(seed: SimSeed) -> (TankState, TankState) {\n   225\t    let base = cycling_base_state(seed);\n   226\t\n   227\t    let mut seeded = base.clone();\n   228\t    seeded.meta.scenario_id = Some(\"cycling_seeded\".to_string());\n   229\t    // Seeded: same decomposer biomass but much higher nitrifier biomass + maturity\n   230\t    seeded.microbe = MicrobeState {\n   231\t        decomposer_biomass_g: 0.1,\n   232\t        ammonia_oxidizer_biomass_g: 0.20,\n   233\t        nitrite_oxidizer_biomass_g: 0.15,\n   234\t        comammox_biomass_g: 0.05,\n   235\t        maturity_index: 0.6,\n   236\t    };\n   237\t    seeded.filter_state = FilterState {\n   238\t        biofilter_maturity_index: 0.6,\n   239\t        clogging_index: 0.0,\n   240\t        seeded_biomass_index: 0.8,\n   241\t    };\n   242\t\n   243\t    let mut unseeded = base;\n   244\t    unseeded.meta.scenario_id = Some(\"cycling_unseeded\".to_string());\n   245\t    // Unseeded: same decomposer biomass but minimal nitrifier biomass + maturity\n   246\t    unseeded.microbe = MicrobeState {\n   247\t        decomposer_biomass_g: 0.1,\n   248\t        ammonia_oxidizer_biomass_g: 0.005,\n   249\t        nitrite_oxidizer_biomass_g: 0.005,\n   250\t        comammox_biomass_g: 0.001,\n   251\t        maturity_index: 0.05,\n   252\t    };\n   253\t    unseeded.filter_state = FilterState {\n   254\t        biofilter_maturity_index: 0.05,\n   255\t        clogging_index: 0.0,\n   256\t        seeded_biomass_index: 0.0,\n   257\t    };\n   258\t\n   259\t    (seeded, unseeded)\n   260\t}\n   261\t\n   262\t/// Base state shared by both cycling fixtures.\n   263\tfn cycling_base_state(seed: SimSeed) -> TankState {\n   264\t    let geometry = TankGeometry {\n   265\t        length_cm: 30.0,\n   266\t        width_cm: 25.0,\n   267\t        height_cm: 30.0,\n   268\t        fill_height_cm: 26.0,\n   269\t        glass_thickness_mm: 5.0,\n   270\t        open_top: true,\n   271\t        lid_exchange_factor: 0.25,\n   272\t    };\n   273\t\n   274\t    let water = WaterState::default_for_geometry(&geometry);\n   275\t\n","exit_code":0,"status":"completed"}}
