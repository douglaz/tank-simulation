   let aob_growth = safe_rate(pp.aob_growth_yield) * aob_rate;\n   201\t    let aob_decay = safe_rate(pp.aob_decay_rate_per_hour) * state.microbe.ammonia_oxidizer_biomass_g;\n   202\t    state.microbe.ammonia_oxidizer_biomass_g =\n   203\t        (state.microbe.ammonia_oxidizer_biomass_g + aob_growth - aob_decay).max(0.0);\n   204\t\n   205\t    // NOB growth from nitrite oxidized\n   206\t    let nob_growth = safe_rate(pp.nob_growth_yield) * nob_rate;\n   207\t    let nob_decay = safe_rate(pp.nob_decay_rate_per_hour) * state.microbe.nitrite_oxidizer_biomass_g;\n   208\t    state.microbe.nitrite_oxidizer_biomass_g =\n   209\t        (state.microbe.nitrite_oxidizer_biomass_g + nob_growth - nob_decay).max(0.0);\n   210\t\n   211\t    // Comammox growth from TAN fully oxidized\n   212\t    let comammox_growth = safe_rate(pp.comammox_growth_yield) * comammox_rate;\n   213\t    let comammox_decay = safe_rate(pp.comammox_decay_rate_per_hour) * state.microbe.comammox_biomass_g;\n   214\t    state.microbe.comammox_biomass_g =\n   215\t        (state.microbe.comammox_biomass_g + comammox_growth - comammox_decay).max(0.0);\n   216\t\n   217\t    // ---- 6. Alkalinity and DIC coupling from nitrification ----\n   218\t    let alk_consumed = total_mg_n_nitrified * safe_rate(pp.alkalinity_meq_per_mg_n_nitrified);\n   219\t    state.water.alkalinity_meq_total = (state.water.alkalinity_meq_total - alk_consumed).max(0.0);\n   220\t\n   221\t    // Nitrification is a chemoautotrophic process that produces some DIC fixation\n   222\t    // but for simplicity we model it as a net DIC producer via mineralization pathway above.\n   223\t\n   224\t    NitrogenCycleOutput {\n   225\t        total_mg_n_nitrified,\n   226\t    }\n   227\t}\n   228\t\n   229\t/// Temperature factor: peaks around 25-30°C, drops off at extremes.\n   230\tfn temperature_factor(temp_c: f64) -> f64 {\n   231\t    // Bell-shaped factor peaking at 28°C with a half-width of ~10°C\n   232\t    let opt = 28.0;\n   233\