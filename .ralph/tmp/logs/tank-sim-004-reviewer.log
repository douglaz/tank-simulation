{"type":"item.completed","item":{"id":"item_64","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/src/systems/nitrogen_cycle.rs | sed -n '260,330p'\"","aggregated_output":"   260\t\n   261\t    // Maturity factor: immature filters slow nitrification\n   262\t    let maturity_factor = state.filter_state.biofilter_maturity_index.clamp(0.05, 1.0);\n   263\t\n   264\t    // Dirty-filter factor: clogged filters reduce nitrification efficiency.\n   265\t    // clogging_index of 0 = clean (factor=1), clogging_index of 1 = fully clogged (factor=0.2)\n   266\t    let dirty_filter_factor = (1.0 - 0.8 * state.filter_state.clogging_index).clamp(0.2, 1.0);\n   267\t\n   268\t    EnvFactors {\n   269\t        f_temp,\n   270\t        f_ph,\n   271\t        maturity_factor,\n   272\t        dirty_filter_factor,\n   273\t    }\n   274\t}\n   275\t\n   276\t/// Monod-style rate: vmax * biomass * maturity * f_temp * f_ph * f_do_monod * S/(K+S)\n   277\tfn monod_rate(\n   278\t    vmax: f64,\n   279\t    biomass_g: f64,\n   280\t    maturity_factor: f64,\n   281\t    f_temp: f64,\n   282\t    f_ph: f64,\n   283\t    f_do_monod: f64,\n   284\t    substrate: f64,\n   285\t    k_substrate: f64,\n   286\t) -> f64 {\n   287\t    let monod = substrate / (substrate + k_substrate);\n   288\t    safe_rate(vmax * biomass_g * maturity_factor * f_temp * f_ph * f_do_monod * monod)\n   289\t}\n   290\t\n   291\t/// Daily biofilter maturity update. Called every 24 ticks.\n   292\t/// Recomputes `filter_state.biofilter_maturity_index` from guild biomass.\n   293\tpub fn update_daily_biofilter_maturity(state: &mut TankState) -> f64 {\n   294\t    let prev = state.filter_state.biofilter_maturity_index;\n   295\t\n   296\t    // Capacity reference: a \"mature\" biofilter might have ~0.5g total nitrifier biomass\n   297\t    let capacity_g = 0.5;\n   298\t    let total_nitrifier_g = state.microbe.ammonia_oxidizer_biomass_g\n   299\t        + state.microbe.nitrite_oxidizer_biomass_g\n   300\t        + state.microbe.comammox_biomass_g;\n   301\t    let raw_maturity = (total_nitrifier_g / capacity_g).clamp(0.0, 1.0);\n   302\t\n   303\t    // Smooth towards raw_maturity\n   304\t    let alpha = 0.1;\n   305\t    let new_maturity = (prev + alpha * (raw_maturity - prev)).clamp(0.0, 1.0);\n   306\t    state.filter_state.biofilter_maturity_index = new_maturity;\n   307\t\n   308\t    new_maturity - prev\n   309\t}\n","exit_code":0,"status":"completed"}}
