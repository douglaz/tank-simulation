{"type":"item.completed","item":{"id":"item_70","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/tank_core/tests/events.rs | sed -n '1,140p'\"","aggregated_output":"     1\tuse tank_core::{\n     2\t    Engine, EventKind, PlayerAction, ProcessParams, SimSeed, SimulationEngine, TankState,\n     3\t};\n     4\t\n     5\tfn threshold_state(seed: SimSeed) -> TankState {\n     6\t    let mut state = TankState::new(seed);\n     7\t    let volume_l = state.geometry.water_volume_l();\n     8\t    state.water.alkalinity_meq_total = 8.0 * volume_l;\n     9\t    state.water.dissolved_inorganic_carbon_mg_c_total = 0.5 * volume_l;\n    10\t    state.water.ammonia_total_mg_n_total = 0.5 * volume_l;\n    11\t    state.water.nitrite_mg_n_total = 0.7 * volume_l;\n    12\t    state.water.dissolved_oxygen_mg_total = 3.0 * volume_l;\n    13\t    state.process_params = ProcessParams {\n    14\t        reaeration_kla_base: 0.0,\n    15\t        aeration_kla_boost: 0.0,\n    16\t        background_bod_mg_o2_per_g_biomass_per_hour: 0.0,\n    17\t        plant_photosynthesis_o2_mg_per_g_per_hour: 0.0,\n    18\t        respiration_dic_rate_mg_c_per_g_per_hour: 0.0,\n    19\t        photosynthesis_dic_rate_mg_c_per_g_per_hour: 0.0,\n    20\t        ..ProcessParams::default()\n    21\t    };\n    22\t    state\n    23\t}\n    24\t\n    25\t#[test]\n    26\tfn threshold_events_emit_with_cause_codes() -> Result<(), tank_core::SimError> {\n    27\t    let mut engine = Engine::from_parts(threshold_state(SimSeed(5000)), vec![]);\n    28\t    engine.step_hours(1)?;\n    29\t\n    30\t    let events = &engine.full_state().event_log;\n    31\t    assert!(events.iter().any(|event| event.kind == EventKind::AmmoniaWarning));\n    32\t    assert!(events.iter().any(|event| event.kind == EventKind::NitriteWarning));\n    33\t    assert!(events.iter().any(|event| event.kind == EventKind::OxygenDip));\n    34\t    assert!(events.iter().all(|event| !event.cause_codes.is_empty()));\n    35\t\n    36\t    Ok(())\n    37\t}\n    38\t\n    39\t#[test]\n    40\tfn threshold_events_are_deduplicated_per_day() -> Result<(), tank_core::SimError> {\n    41\t    let mut engine = Engine::from_parts(threshold_state(SimSeed(5100)), vec![]);\n    42\t\n    43\t    engine.step_hours(6)?;\n    44\t    let same_day_count = engine\n    45\t        .full_state()\n    46\t        .event_log\n    47\t        .iter()\n    48\t        .filter(|event| event.kind == EventKind::AmmoniaWarning)\n    49\t        .count();\n    50\t    assert_eq!(same_day_count, 1, \"ammonia warning should dedupe within a day\");\n    51\t\n    52\t    engine.step_hours(24)?;\n    53\t    let next_day_count = engine\n    54\t        .full_state()\n    55\t        .event_log\n    56\t        .iter()\n    57\t        .filter(|event| event.kind == EventKind::AmmoniaWarning)\n    58\t        .count();\n    59\t    assert_eq!(next_day_count, 2, \"warning should emit again on a new day\");\n    60\t\n    61\t    Ok(())\n    62\t}\n    63\t\n    64\t#[test]\n    65\tfn event_generation_warm_overfed_weak_aeration() -> Result<(), tank_core::SimError> {\n    66\t    // Warm, overfed, weak-aeration setup — designed to trigger AmmoniaWarning or OxygenDip\n    67\t    let mut state = TankState::new(SimSeed(5200));\n    68\t    let vol = state.geometry.water_volume_l();\n    69\t    state.water.temperature_c = 30.0;\n    70\t    state.environment.ambient_temp_c = 30.0;\n    71\t    // Higher pH pushes NH3 fraction up at 30°C\n    72\t    state.water.alkalinity_meq_total = 4.0 * vol;\n    73\t    state.water.dissolved_inorganic_carbon_mg_c_total = 5.0 * vol;\n    74\t    // Weak aeration\n    75\t    state.hardware.aeration.enabled = true;\n    76\t    state.hardware.aeration.intensity = 0.05;\n    77\t    // Low reaeration to allow DO to drop\n    78\t    state.process_params = ProcessParams {\n    79\t        reaeration_kla_base: 0.05,\n    80\t        aeration_kla_boost: 0.1,\n    81\t        ..ProcessParams::default()\n    82\t    };\n    83\t    // Strong decomposer biomass to mineralize feed quickly into TAN\n    84\t    state.microbe.decomposer_biomass_g = 0.5;\n    85\t    // Minimal nitrification so TAN accumulates\n    86\t    state.microbe.ammonia_oxidizer_biomass_g = 0.005;\n    87\t    state.microbe.nitrite_oxidizer_biomass_g = 0.005;\n    88\t    state.microbe.comammox_biomass_g = 0.001;\n    89\t    state.filter_state.biofilter_maturity_index = 0.05;\n    90\t\n    91\t    let mut engine = Engine::from_parts(state, vec![]);\n    92\t\n    93\t    // Heavy overfeeding for 14 days\n    94\t    for _ in 0..14 {\n    95\t        engine.apply_action(PlayerAction::Feed { grams: 3.0 })?;\n    96\t        engine.step_hours(24)?;\n    97\t    }\n    98\t\n    99\t    let events = &engine.full_state().event_log;\n   100\t\n   101\t    // Must emit at least one of AmmoniaWarning or OxygenDip\n   102\t    let has_ammonia = events.iter().any(|e| e.kind == EventKind::AmmoniaWarning);\n   103\t    let has_oxygen = events.iter().any(|e| e.kind == EventKind::OxygenDip);\n   104\t    assert!(\n   105\t        has_ammonia || has_oxygen,\n   106\t        \"Warm overfed tank should emit AmmoniaWarning or OxygenDip. Events: {:?}\",\n   107\t        events.iter().map(|e| &e.kind).collect::<Vec<_>>()\n   108\t    );\n   109\t\n   110\t    // All emitted events must have non-empty cause_codes\n   111\t    let relevant: Vec<_> = events\n   112\t        .iter()\n   113\t        .filter(|e| {\n   114\t            matches!(\n   115\t                e.kind,\n   116\t                EventKind::AmmoniaWarning | EventKind::OxygenDip | EventKind::NitriteWarning\n   117\t            )\n   118\t        })\n   119\t        .collect();\n   120\t    assert!(\n   121\t        relevant.iter().all(|e| !e.cause_codes.is_empty()),\n   122\t        \"Warning events must have non-empty cause_codes\"\n   123\t    );\n   124\t\n   125\t    Ok(())\n   126\t}\n","exit_code":0,"status":"completed"}}
