leached;\n    41\t\n    42\t    // ---- 2. Fine detritus dissolution: fine detritus -> dissolved organic pools ----\n    43\t    let diss_rate = safe_rate(pp.fine_detritus_dissolution_rate_per_hour);\n    44\t    let dissolved = (state.detritus.fine_detritus_g_total * diss_rate)\n    45\t        .min(state.detritus.fine_detritus_g_total);\n    46\t    state.detritus.fine_detritus_g_total -= dissolved;\n    47\t    // dissolved mass (g) -> mg for dissolved pools: 1 g = 1000 mg\n    48\t    // Split into DOC and DON using N:C ratio\n    49\t    let n_to_c = safe_rate(pp.feed_n_to_c_ratio);\n    50\t    let doc_mg = dissolved * 1000.0 / (1.0 + n_to_c); // carbon fraction\n    51\t    let don_mg = doc_mg * n_to_c; // nitrogen fraction\n    52\t    state.water.dissolved_organic_carbon_mg_c_total += doc_mg;\n    53\t    state.water.dissolved_organic_nitrogen_mg_n_total += don_mg;\n    54\t    // Track flow through dissolved_feed_residue (bookkeeping, decremented by mineralization)\n    55\t    state.detritus.dissolved_feed_residue_g_total += dissolved;\n    56\t\n    57\t    // ---- 3. Decomposer mineralization: DOC/DON -> TAN ----\n    58\t    let decomposer_biomass = state.microbe.decomposer_biomass_g;\n    59\t    let doc_total = state.water.dissolved_organic_carbon_mg_c_total;\n    60\t    let don_total = state.water.dissolved_organic_nitrogen_mg_n_total;\n    61\t    let do_total = state.water.dissolved_oxygen_mg_total;\n    62\t\n    63\t    // Environmental factors for decomposers\n    64\t    let temp = state.water.temperature_c;\n    65\t    let f_temp_decomp = temperature_factor(temp);\n    66\t    let f_do_decomp = do_total / (do_total + 2.0); // half-sat ~2 mg total\n    67\t\n    68\t    let decomp_vmax = safe_rate(pp.decomposer_vmax_per_hour);\n    69\t    let k_doc = pp.decomposer_k_doc_mg.max(0.01);\n    70\t    let monod_doc = doc_total / (doc_total + k_doc);\n    71\t\n    72\t    let potential_doc_consumed_mg = decomp_vmax * decomposer_biomass * 1000.0 // g->mg conversion for biomass effect\n    73\t        * f_temp_decomp * f_do_decomp * monod_doc;\n    74\t    let potential_doc_consumed_mg = safe_rate(potential_doc_consumed_mg);\n    75\t\n    76\t    // Clamp: cannot consume more DOC than exists\n    77\t    let doc_consumed_mg = potential_doc_consumed_mg.min(doc_total);\n    78\t    // Proportional DON consumed\n    79\t    let don_consumed_mg = if doc_total > f64::EPSILON {\n    80\t        doc_consumed_mg * (don_total / doc_total)\n    81\t    } else {\n    82\t        0.0\n    83\t    };\n    84\t    let don_consumed_mg = don_consumed_mg.min(don_total);\n    85\t\n    86\t    state.water.dissolved_organic_carbon_mg_c_total -= doc_consumed_mg;\n    87\t    state.water.dissolved_organic_nitrogen_mg_n_total -= don_consumed_mg;\n    88\t    // Mineralized DON becomes TAN\n    89\t    state.water.ammonia_total_mg_n_total += don_consumed_mg;\n    90\t    // Track residue pool depletion\n    91\t    let residue_consumed_g = doc_consumed_mg / 1000.0 * (1.0 + n_to_c);\n    92\t    state.detritus.dissolved_feed_residue_g_total =\n    93\t        (state.detritus.dissolved_feed_residue_g_total - residue_consumed_g).max(0.0);\n    94\t\n    95\t    // Decomposer growth/decay\n    96\t    let decomp_growth = safe_rate(pp.decomposer_growth_yield) * doc_consumed_mg / 1000.0; // mg->g\n    97\t    let decomp_decay = safe_rate(pp.decomposer_decay_rate_per_hour) * decomposer_biomass;\n    98\t    state.microbe.decomposer_biomass_g =\n    99\t        (state.microbe.decomposer_biomass_g + decomp_growth - decomp_decay).max(0.0);\n   100\t\n   101\t    // ---- 4. Nitrification: TAN -> nitrite -> nitrate (+ comammox TAN -> nitrate) ----\n   102\t    let env = compute_env_factors(state);\n   103\t\n   104\t    // 4a. AOB: TAN -> nitrite\n   105\t    let aob_potential = monod_rate(\n   106\t        safe_rate(pp.aob_vmax_mg_n_per_g_per_hour),\n   107\t        state.microbe.ammonia_oxidizer_biomass_g,\n   108\t        env.maturity_fac