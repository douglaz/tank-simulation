36→    /// Hourly decay rate of decomposer biomass under starvation.\n    37→    pub decomposer_decay_rate_per_hour: f64,\n    38→\n    39→    // -- Nitrifier guild kinetics --\n    40→    /// AOB vmax: max mg N oxidized per g AOB biomass per hour.\n    41→    pub aob_vmax_mg_n_per_g_per_hour: f64,\n    42→    /// AOB half-saturation for TAN (mg N total).\n    43→    pub aob_k_tan_mg: f64,\n    44→    /// AOB half-saturation for DO (mg total).\n    45→    pub aob_k_do_mg: f64,\n    46→    /// AOB growth yield (g biomass per mg N oxidized).\n    47→    pub aob_growth_yield: f64,\n    48→    /// AOB decay rate per hour.\n    49→    pub aob_decay_rate_per_hour: f64,\n    50→\n    51→    /// NOB vmax: max mg N oxidized per g NOB biomass per hour.\n    52→    pub nob_vmax_mg_n_per_g_per_hour: f64,\n    53→    /// NOB half-saturation for nitrite (mg N total).\n    54→    pub nob_k_nitrite_mg: f64,\n    55→    /// NOB half-saturation for DO (mg total).\n    56→    pub nob_k_do_mg: f64,\n    57→    /// NOB growth yield (g biomass per mg N oxidized).\n    58→    pub nob_growth_yield: f64,\n    59→    /// NOB decay rate per hour.\n    60→    pub nob_decay_rate_per_hour: f64,\n    61→\n    62→    /// Comammox vmax multiplier relative to AOB (must be < 1.0).\n    63→    pub comammox_vmax_fraction: f64,\n    64→    /// Comammox half-saturation for TAN (mg N total).\n    65→    pub comammox_k_tan_mg: f64,\n    66→    /// Comammox half-saturation for DO (mg total).\n    67→    pub comammox_k_do_mg: f64,\n    68→    /// Comammox growth yield (g biomass per mg N oxidized).\n    69→    pub comammox_growth_yield: f64,\n    70→    /// Comammox decay rate per hour.\n    71→    pub comammox_decay_rate_per_hour: f64,\n    72→\n    73→    // -- Stoichiometric constants --\n    74→    /// mg O2 consumed per mg N fully nitrified to nitrate.\n    75→    pub o2_per_mg_n_nitrified: f64,\n    76→    /// meq alkalinity consumed per mg N nitrified.\n    77→    pub alkalinity_meq_per_mg_n_nitrified