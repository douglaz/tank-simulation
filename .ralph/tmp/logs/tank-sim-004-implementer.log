to `tank_core::ProcessParams`.\n    40→fn process_preset_to_params(preset: &tank_data::ProcessParamsPreset) -> ProcessParams {\n    41→    ProcessParams {\n    42→        mineralization_rate_per_day: preset.mineralization_rate_per_day,\n    43→        nitrification_vmax: preset.nitrification_vmax,\n    44→        reaeration_kla_base: preset.reaeration_kla_base,\n    45→        aeration_kla_boost: preset.aeration_kla_boost,\n    46→        background_bod_mg_o2_per_g_biomass_per_hour: preset\n    47→            .background_bod_mg_o2_per_g_biomass_per_hour,\n    48→        plant_photosynthesis_o2_mg_per_g_per_hour: preset\n    49→            .plant_photosynthesis_o2_mg_per_g_per_hour,\n    50→        respiration_dic_rate_mg_c_per_g_per_hour: preset\n    51→            .respiration_dic_rate_mg_c_per_g_per_hour,\n    52→        photosynthesis_dic_rate_mg_c_per_g_per_hour: preset\n    53→            .photosynthesis_dic_rate_mg_c_per_g_per_hour,\n    54→        k_surface_w_per_m2_k: preset.k_surface_w_per_m2_k,\n    55→        k_wall_w_per_m2_k: preset.k_wall_w_per_m2_k,\n    56→    }\n    57→}\n    58→\n    59→/// Materializes a scenario preset into a fully resolved `TankState`.\n    60→///\n    61→/// - Geometry comes from the scenario.\n    62→/// - `environment.ambient_temp_c` comes from the scenario.\n    63→/// - Initial `WaterState` totals come from the source-water profile × fill volume.\n    64→/// - Substrate layers come from the scenario's substrate preset IDs.\n    65→/// - Plant guilds come from the scenario's plant preset IDs.\n    66→/// - Source-water catalog is populated with all known source-water presets.\n    67→/// - Process parameters come from the scenario's process params preset.\n    68→pub fn seeded_state(seed: SimSeed, scenario_id: &str) -> Result<TankState, tank_data::PresetError> {\n    69→    let scenario = load_named_scenario(scenario_id)?;\n    70→\n    71→    // Geometry\n    72→    let geometry = TankGeometry {\n    73→        length_cm: s