{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012ga48xCbBqYq5Ui3GTK1GD","type":"tool_result","content":"     1→use std::collections::VecDeque;\n     2→\n     3→use crate::{\n     4→    invariants::enforce_invariants,\n     5→    rng::SimSeed,\n     6→    systems,\n     7→    types::{\n     8→        EventCause, EventKind, EventSeverity, PlayerAction, SimError, SimEvent, TankSnapshot,\n     9→        TankState,\n    10→    },\n    11→};\n    12→\n    13→pub trait SimulationEngine {\n    14→    fn apply_action(&mut self, action: PlayerAction) -> Result<(), SimError>;\n    15→    fn step_hours(&mut self, hours: u32) -> Result<(), SimError>;\n    16→    fn snapshot(&self) -> TankSnapshot;\n    17→    fn full_state(&self) -> &TankState;\n    18→}\n    19→\n    20→#[derive(Debug, Clone, PartialEq)]\n    21→pub struct Engine {\n    22→    state: TankState,\n    23→    queued_actions: VecDeque<PlayerAction>,\n    24→}\n    25→\n    26→impl Engine {\n    27→    pub fn new(seed: SimSeed) -> Self {\n    28→        Self {\n    29→            state: TankState::new(seed),\n    30→            queued_actions: VecDeque::new(),\n    31→        }\n    32→    }\n    33→\n    34→    pub fn from_parts(state: TankState, queued_actions: Vec<PlayerAction>) -> Self {\n    35→        Self {\n    36→            state,\n    37→            queued_actions: queued_actions.into(),\n    38→        }\n    39→    }\n    40→\n    41→    pub fn queued_actions(&self) -> Vec<PlayerAction> {\n    42→        self.queued_actions.iter().cloned().collect()\n    43→    }\n    44→\n    45→    fn step_one_hour(&mut self) -> Result<(), SimError> {\n    46→        let actions_slice: Vec<_> = self.queued_actions.iter().cloned().collect();\n    47→        systems::water_change::validate_water_changes(&self.state, &actions_slice)?;\n    48→\n    49→        while let Some(action) = self.queued_actions.pop_front() {\n    50→            self.process_action(action);\n    51→        }\n    52→\n    53→        // Step 4: update water temperature from ambient and heater\n    54→        systems::temperature::step_temperature(&mut self.state);\n    55→\n    56→        // Step 5: compute light state for the current hour.\n    57→        let light_on = self.state.hardware.light.enabled\n    58→            && systems::light::is_light_on(\n    59→                self.state.environment.hour_of_day,\n    60→                self.state.hardware.light.photoperiod_hours,\n    61→            );\n    62→\n    63→        // Step 6-8: nitrogen cycle phase (feed leaching, detritus breakdown,\n    64→        // mineralization, nitrification, guild growth/decay).\n    65→        // This runs between light-state resolution and chemistry/DO/event phases.\n    66→        // Nitrification O2 consumption and alkalinity depletion are handled\n    67→        // internally by the nitrogen cycle system.\n    68→        let _nc_output = systems::nitrogen_cycle::step_nitrogen_cycle(&mut self.state);\n    69→\n    70→        // Step 9: update DIC, alkalinity, and pH.\n    71→        systems::chemistry::step_hourly_chemistry(&mut self.state, light_on);\n    72→\n    73→        // Step 10 / 11-partial: update dissolved oxygen with background respiration and\n    74→        // light-driven photosynthetic support from existing biomass.\n    75→        systems::dissolved_oxygen::step_dissolved_oxygen(&mut self.state, light_on);\n    76→\n    77→        // Step 13: emit threshold-based chemistry warnings.\n    78→        systems::events::emit_hourly_threshold_events(&mut self.state);\n    79→\n    80→        self.state.environment.hour_of_day = (self.state.environment.hour_of_day + 1) % 24;\n    81→        if self.state.environment.hour_of_day == 0 {\n    82→            self.state.environment.day += 1;\n    83→            // Daily pipeline\n    84→            self.run_daily_update();\n    85→        }\n    86→\n    87→        enforce_invariants(&mut self.state)\n    88→    }\n    89→\n    90→    fn run_daily_update(&mut self) {\n    91→        // Step 6 (daily): biofilter maturity summary update\n    92→        let maturity_delta =\n    93→            systems::nitrogen_cycle::update_daily_biofilter_maturity(&mut self.state);\n    94→        if maturity_delta > 0.005 {\n    95→            self.push_event(\n    96→                EventSeverity::Info,\n    97→                EventKind::BiofilmMaturityIncrease,\n    98→                vec![EventCause::BiofilterImmature],\n    99→                format!(\n   100→                    \"Biofilter maturity increased to {:.3}\",\n   101→                    self.state.filter_state.biofilter_maturity_index\n   102→                ),\n   103→            );\n   104→        }\n   105→        // Emit CycleProgressing when maturity is actively growing\n   106→        let current_maturity = self.state.filter_state.biofilter_maturity_index;\n   107→        if maturity_delta > 0.001 && current_maturity < 0.9 {\n   108→            systems::events::emit_once_per_day_pub(\n   109→                &mut self.state,\n   110→                EventSeverity::Info,\n   111→                EventKind::CycleProgressing,\n   112→                vec![EventCause::BiofilterImmature],\n   113→                format!(\"Nitrogen cycle progressing, maturity {current_maturity:.3}\"),\n   114→            );\n   115→        }\n   116→    }\n   117→\n   118→    fn process_action(&mut self, action: PlayerAction) {\n   119→        match action {\n   120→            PlayerAction::Feed { grams } => {\n   121→                self.state.detritus.particulate_organics_g_total += grams;\n   122→                self.push_event(\n   123→                    EventSeverity::Info,\n   124→                    EventKind::CycleProgressing,\n   125→                    vec![EventCause::Overfeeding],\n   126→                    format!(\"Queued feed processed: {grams:.2} g\"),\n   127→                );\n   128→            }\n   129→            PlayerAction::WaterChangePercent {\n   130→                percent,\n   131→                source_profile_id,\n   132→            } => {\n   133→                if percent <= 0.0 {\n   134→                    return;\n   135→                }\n   136→                // Profile was pre-validated; look it up (guaranteed to exist).\n   137→                let profile = self\n   138→                    .state\n   139→                    .source_water_catalog\n   140→                    .get(&source_profile_id)\n   141→                    .cloned();\n   142→                if let Some(profile) = profile {\n   143→                    systems::water_change::apply_water_change(\n   144→                        &mut self.state,\n   145→                        percent,\n   146→                        &profile,\n   147→                    );\n   148→                    self.push_event(\n   149→                        EventSeverity::Info,\n   150→                        EventKind::StabilityImproving,\n   151→                        vec![EventCause::WaterChange],\n   152→                        format!(\"Water change processed: {percent:.1}% with {source_profile_id}\"),\n   153→                    );\n   154→                }\n   155→            }\n   156→            PlayerAction::TrimPlants { fraction } => {\n   157→                for plant in &mut self.state.plant_guilds {\n   158→                    plant.biomass_g *= 1.0 - fraction;\n   159→                }\n   160→            }\n   161→            PlayerAction::SiphonDetritus { fraction } => {\n   162→                self.state.detritus.particulate_organics_g_total *= 1.0 - fraction;\n   163→                self.state.detritus.fine_detritus_g_total *= 1.0 - fraction;\n   164→            }\n   165→            PlayerAction::CleanFilter { intensity } => {\n   166→                self.state.hardware.filter.cleanliness_index = 1.0;\n   167→                self.state.filter_state.biofilter_maturity_index *= 1.0 - (intensity * 0.5);\n   168→                self.state.filter_state.clogging_index *= 1.0 - intensity;\n   169→                // Proportional setback in active nitrifier and decomposer biomass\n   170→                let setback = intensity * 0.5;\n   171→                self.state.microbe.decomposer_biomass_g *= 1.0 - setback;\n   172→                self.state.microbe.ammonia_oxidizer_biomass_g *= 1.0 - setback;\n   173→                self.state.microbe.nitrite_oxidizer_biomass_g *= 1.0 - setback;\n   174→                self.state.microbe.comammox_biomass_g *= 1.0 - setback;\n   175→                self.push_event(\n   176→                    EventSeverity::Warning,\n   177→                    EventKind::FilterCleaningSetback,\n   178→                    vec![EventCause::FilterMaintenance],\n   179→                    format!(\"Filter cleaned at intensity {intensity:.2}\"),\n   180→                );\n   181→            }\n   182→            PlayerAction::AddShrimp { count } => {\n   183→                self.state.animal.adults_count =\n   184→                    self.state.animal.adults_count.saturating_add(count);\n   185→            }\n   186→            PlayerAction::RemoveShrimp { count } => {\n   187→                self.state.animal.adults_count =\n   188→                    self.state.animal.adults_count.saturating_sub(count);\n   189→            }\n   190→            PlayerAction::ChangePhotoperiod { hours } => {\n   191→                self.state.hardware.light.photoperiod_hours = hours;\n   192→            }\n   193→            PlayerAction::ChangeLightIntensity { intensity_index } => {\n   194→                self.state.hardware.light.intensity_index = intensity_index;\n   195→            }\n   196→            PlayerAction::ChangeHeaterSetpoint { setpoint_c } => {\n   197→                self.state.hardware.heater.setpoint_c = setpoint_c;\n   198→            }\n   199→            PlayerAction::ChangeAmbientTemperature { target_c } => {\n   200→                self.state.environment.ambient_temp_c = target_c;\n   201→            }\n   202→            PlayerAction::ChangeAeration { enabled, intensity } => {\n   203→                self.state.hardware.aeration.enabled = enabled;\n   204→                self.state.hardware.aeration.intensity = intensity;\n   205→            }\n   206→        }\n   207→    }\n   208→\n   209→    fn push_event(\n   210→        &mut self,\n   211→        severity: EventSeverity,\n   212→        kind: EventKind,\n   213→        cause_codes: Vec<EventCause>,\n   214→        summary: String,\n   215→    ) {\n   216→        self.state.event_log.push(SimEvent::new(\n   217→            self.state.environment.day,\n   218→            self.state.environment.hour_of_day,\n   219→            severity,\n   220→            kind,\n   221→            cause_codes,\n   222→            summary,\n   223→        ));\n   224→    }\n   225→}\n   226→\n   227→impl SimulationEngine for Engine {\n   228→    fn apply_action(&mut self, action: PlayerAction) -> Result<(), SimError> {\n   229→        action.validate()?;\n   230→        self.queued_actions.push_back(action);\n   231→        Ok(())\n   232→    }\n   233→\n   234→    fn step_hours(&mut self, hours: u32) -> Result<(), SimError> {\n   235→        for _ in 0..hours {\n   236→            self.step_one_hour()?;\n   237→        }\n   238→        enforce_invariants(&mut self.state)\n   239→    }\n   240→\n   241→    fn snapshot(&self) -> TankSnapshot {\n   242→        TankSnapshot::from_state(&self.state)\n   243→    }\n   244→\n   245→    fn full_state(&self) -> &TankState {\n   246→        &self.state\n   247→    }\n   248→}\n   249→"}]},"parent_tool_use_id":null,"session_id":"af270d75-fd6d-4e84-9953-cdba41291cd7","uuid":"2d66cc78-4454-41e2-b237-6deff578ce91","tool_use_result":{"type":"text","file":{"filePath":"/root/tank-simulation/crates/tank_core/src/engine.rs","content":"use std::collections::VecDeque;\n\nuse crate::{\n    invariants::enforce_invariants,\n    rng::SimSeed,\n    systems,\n    types::{\n        EventCause, EventKind, EventSeverity, PlayerAction, SimError, SimEvent, TankSnapshot,\n        TankState,\n    },\n};\n\npub trait SimulationEngine {\n    fn apply_action(&mut self, action: PlayerAction) -> Result<(), SimError>;\n    fn step_hours(&mut self, hours: u32) -> Result<(), SimError>;\n    fn snapshot(&self) -> TankSnapshot;\n    fn full_state(&self) -> &TankState;\n}\n\n#[derive(Debug, Clone, PartialEq)]\npub struct Engine {\n    state: TankState,\n    queued_actions: VecDeque<PlayerAction>,\n}\n\nimpl Engine {\n    pub fn new(seed: SimSeed) -> Self {\n        Self {\n            state: TankState::new(seed),\n            queued_actions: VecDeque::new(),\n        }\n    }\n\n    pub fn from_parts(state: TankState, queued_actions: Vec<PlayerAction>) -> Self {\n        Self {\n            state,\n            queued_actions: queued_actions.into(),\n        }\n    }\n\n    pub fn queued_actions(&self) -> Vec<PlayerAction> {\n        self.queued_actions.iter().cloned().collect()\n    }\n\n    fn step_one_hour(&mut self) -> Result<(), SimError> {\n        let actions_slice: Vec<_> = self.queued_actions.iter().cloned().collect();\n        systems::water_change::validate_water_changes(&self.state, &actions_slice)?;\n\n        while let Some(action) = self.queued_actions.pop_front() {\n            self.process_action(action);\n        }\n\n        // Step 4: update water temperature from ambient and heater\n        systems::temperature::step_temperature(&mut self.state);\n\n        // Step 5: compute light state for the current hour.\n        let light_on = self.state.hardware.light.enabled\n            && systems::light::is_light_on(\n                self.state.environment.hour_of_day,\n                self.state.hardware.light.photoperiod_hours,\n            );\n\n        // Step 6-8: nitrogen cycle phase (feed leaching, detritus breakdown,\n        // mineralization, nitrification, guild growth/decay).\n        // This runs between light-state resolution and chemistry/DO/event phases.\n        // Nitrification O2 consumption and alkalinity depletion are handled\n        // internally by the nitrogen cycle system.\n        let _nc_output = systems::nitrogen_cycle::step_nitrogen_cycle(&mut self.state);\n\n        // Step 9: update DIC, alkalinity, and pH.\n        systems::chemistry::step_hourly_chemistry(&mut self.state, light_on);\n\n        // Step 10 / 11-partial: update dissolved oxygen with background respiration and\n        // light-driven photosynthetic support from existing biomass.\n        systems::dissolved_oxygen::step_dissolved_oxygen(&mut self.state, light_on);\n\n        // Step 13: emit threshold-based chemistry warnings.\n        systems::events::emit_hourly_threshold_events(&mut self.state);\n\n        self.state.environment.hour_of_day = (self.state.environment.hour_of_day + 1) % 24;\n        if self.state.environment.hour_of_day == 0 {\n            self.state.environment.day += 1;\n            // Daily pipeline\n            self.run_daily_update();\n        }\n\n        enforce_invariants(&mut self.state)\n    }\n\n    fn run_daily_update(&mut self) {\n        // Step 6 (daily): biofilter maturity summary update\n        let maturity_delta =\n            systems::nitrogen_cycle::update_daily_biofilter_maturity(&mut self.state);\n        if maturity_delta > 0.005 {\n            self.push_event(\n                EventSeverity::Info,\n                EventKind::BiofilmMaturityIncrease,\n                vec![EventCause::BiofilterImmature],\n                format!(\n                    \"Biofilter maturity increased to {:.3}\",\n                    self.state.filter_state.biofilter_maturity_index\n                ),\n            );\n        }\n        // Emit CycleProgressing when maturity is actively growing\n        let current_maturity = self.state.filter_state.biofilter_maturity_index;\n        if maturity_delta > 0.001 && current_maturity < 0.9 {\n            systems::events::emit_once_per_day_pub(\n                &mut self.state,\n                EventSeverity::Info,\n                EventKind::CycleProgressing,\n                vec![EventCause::BiofilterImmature],\n                format!(\"Nitrogen cycle progressing, maturity {current_maturity:.3}\"),\n            );\n        }\n    }\n\n    fn process_action(&mut self, action: PlayerAction) {\n        match action {\n            PlayerAction::Feed { grams } => {\n                self.state.detritus.particulate_organics_g_total += grams;\n                self.push_event(\n                    EventSeverity::Info,\n                    EventKind::CycleProgressing,\n                    vec![EventCause::Overfeeding],\n                    format!(\"Queued feed processed: {grams:.2} g\"),\n                );\n            }\n            PlayerAction::WaterChangePercent {\n                percent,\n                source_profile_id,\n            } => {\n                if percent <= 0.0 {\n                    return;\n                }\n                // Profile was pre-validated; look it up (guaranteed to exist).\n                let profile = self\n                    .state\n                    .source_water_catalog\n                    .get(&source_profile_id)\n                    .cloned();\n                if let Some(profile) = profile {\n                    systems::water_change::apply_water_change(\n                        &mut self.state,\n                        percent,\n                        &profile,\n                    );\n                    self.push_event(\n                        EventSeverity::Info,\n                        EventKind::StabilityImproving,\n                        vec![EventCause::WaterChange],\n                        format!(\"Water change processed: {percent:.1}% with {source_profile_id}\"),\n                    );\n                }\n            }\n            PlayerAction::TrimPlants { fraction } => {\n                for plant in &mut self.state.plant_guilds {\n                    plant.biomass_g *= 1.0 - fraction;\n                }\n            }\n            PlayerAction::SiphonDetritus { fraction } => {\n                self.state.detritus.particulate_organics_g_total *= 1.0 - fraction;\n                self.state.detritus.fine_detritus_g_total *= 1.0 - fraction;\n            }\n            PlayerAction::CleanFilter { intensity } => {\n                self.state.hardware.filter.cleanliness_index = 1.0;\n                self.state.filter_state.biofilter_maturity_index *= 1.0 - (intensity * 0.5);\n                self.state.filter_state.clogging_index *= 1.0 - intensity;\n                // Proportional setback in active nitrifier and decomposer biomass\n                let setback = intensity * 0.5;\n                self.state.microbe.decomposer_biomass_g *= 1.0 - setback;\n                self.state.microbe.ammonia_oxidizer_biomass_g *= 1.0 - setback;\n                self.state.microbe.nitrite_oxidizer_biomass_g *= 1.0 - setback;\n                self.state.microbe.comammox_biomass_g *= 1.0 - setback;\n                self.push_event(\n                    EventSeverity::Warning,\n                    EventKind::FilterCleaningSetback,\n                    vec![EventCause::FilterMaintenance],\n                    format!(\"Filter cleaned at intensity {intensity:.2}\"),\n                );\n            }\n            PlayerAction::AddShrimp { count } => {\n                self.state.animal.adults_count =\n                    self.state.animal.adults_count.saturating_add(count);\n            }\n            PlayerAction::RemoveShrimp { count } => {\n                self.state.animal.adults_count =\n                    self.state.animal.adults_count.saturating_sub(count);\n            }\n            PlayerAction::ChangePhotoperiod { hours } => {\n                self.state.hardware.light.photoperiod_hours = hours;\n            }\n            PlayerAction::ChangeLightIntensity { intensity_index } => {\n                self.state.hardware.light.intensity_index = intensity_index;\n            }\n            PlayerAction::ChangeHeaterSetpoint { setpoint_c } => {\n                self.state.hardware.heater.setpoint_c = setpoint_c;\n            }\n            PlayerAction::ChangeAmbientTemperature { target_c } => {\n                self.state.environment.ambient_temp_c = target_c;\n            }\n            PlayerAction::ChangeAeration { enabled, intensity } => {\n                self.state.hardware.aeration.enabled = enabled;\n                self.state.hardware.aeration.intensity = intensity;\n            }\n        }\n    }\n\n    fn push_event(\n        &mut self,\n        severity: EventSeverity,\n        kind: EventKind,\n        cause_codes: Vec<EventCause>,\n        summary: String,\n    ) {\n        self.state.event_log.push(SimEvent::new(\n            self.state.environment.day,\n            self.state.environment.hour_of_day,\n            severity,\n            kind,\n            cause_codes,\n            summary,\n        ));\n    }\n}\n\nimpl SimulationEngine for Engine {\n    fn apply_action(&mut self, action: PlayerAction) -> Result<(), SimError> {\n        action.validate()?;\n        self.queued_actions.push_back(action);\n        Ok(())\n    }\n\n    fn step_hours(&mut self, hours: u32) -> Result<(), SimError> {\n        for _ in 0..hours {\n            self.step_one_hour()?;\n        }\n        enforce_invariants(&mut self.state)\n    }\n\n    fn snapshot(&self) -> TankSnapshot {\n        TankSnapshot::from_state(&self.state)\n    }\n\n    fn full_state(&self) -> &TankState {\n        &self.state\n    }\n}\n","numLines":249,"startLine":1,"totalLines":249}}}
