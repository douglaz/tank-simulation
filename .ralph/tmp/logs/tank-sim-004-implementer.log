non_negative(\"bicarbonate_mg_total\", state.water.bicarbonate_mg_total)?;\n    36→    check_non_negative(\"chloride_mg_total\", state.water.chloride_mg_total)?;\n    37→    check_non_negative(\"sulfate_mg_total\", state.water.sulfate_mg_total)?;\n    38→    check_non_negative(\n    39→        \"particulate_organics_g_total\",\n    40→        state.detritus.particulate_organics_g_total,\n    41→    )?;\n    42→    check_non_negative(\n    43→        \"fine_detritus_g_total\",\n    44→        state.detritus.fine_detritus_g_total,\n    45→    )?;\n    46→    check_non_negative(\n    47→        \"dissolved_feed_residue_g_total\",\n    48→        state.detritus.dissolved_feed_residue_g_total,\n    49→    )?;\n    50→    check_non_negative(\"decomposer_biomass_g\", state.microbe.decomposer_biomass_g)?;\n    51→    check_non_negative(\n    52→        \"ammonia_oxidizer_biomass_g\",\n    53→        state.microbe.ammonia_oxidizer_biomass_g,\n    54→    )?;\n    55→    check_non_negative(\n    56→        \"nitrite_oxidizer_biomass_g\",\n    57→        state.microbe.nitrite_oxidizer_biomass_g,\n    58→    )?;\n    59→    check_non_negative(\"comammox_biomass_g\", state.microbe.comammox_biomass_g)?;\n    60→    for plant in &state.plant_guilds {\n    61→        check_non_negative(\"plant.biomass_g\", plant.biomass_g)?;\n    62→    }\n    63→    for layer in &state.substrate_layers {\n    64→        check_non_negative(\"substrate.depth_cm\", layer.depth_cm)?;\n    65→        check_non_negative(\n    66→            \"substrate.nutrient_store_mg_n_total\",\n    67→            layer.nutrient_store_mg_n_total,\n    68→        )?;\n    69→        check_non_negative(\n    70→            \"substrate.nutrient_store_mg_p_total\",\n    71→            layer.nutrient_store_mg_p_total,\n    72→        )?;\n    73→        check_non_negative(\"substrate.colonizable_area_cm2\", layer.colonizable_area_cm2)?;\n    74→    }\n    75→    check_non_negative(\"water.temperature_c\", state.water.temperature_c)?;\n    76→    if state.water.temperature_c <= 0.0 {\n    77→        return Err(SimError::TemperatureTooLow {\n    78→            field: \"water.temperature_c\",\n    79→            value: state.water.temperature_c,\n    80→        });\n    81→    }\n    82→    if !state.water.ph.is_finite() {\n    83→        return Err(SimError::InvariantViolation {\n    84→            field: \"water.ph\",\n    85→            value: state.water.ph,\n    86→        });\n    87→    }\n    88→    state.water.ph = state.water.ph.clamp(5.5, 8.5);\n    89→\n    90→    state.geometry.lid_exchange_factor = state.geometry.lid_exchange_factor.clamp(0.0, 1.0);\n    91→    state.hardware.light.intensity_index = state.hardware.light.intensity_index.clamp(0.0, 1.0);\n    92→    state.hardware.filter.cleanliness_index =\n    93→        state.hardware.filter.cleanliness_index.clamp(0.0, 1.0);\n    94→    state.hardware.aeration.intensity = state.hardware.aeration.intensity.clamp(0.0, 1.0);\n    95→    state.filter_state.biofilter_maturity_index =\n    96→        state.filter_state.biofilter_maturity_index.clamp(0.0, 1.0);\n    97→    state.filter_state.clogging_index = state.filter_state.clogging_index.clamp(0.0, 1.0);\n    98→    state.filter_state.seeded_biomass_index =\n    99→        state.filter_state.seeded_biomass_index.clamp(0.0, 1.0);\n   100→    state.algae.nuisance_index = state.algae.nuisance_index.clamp(0.0, 1.0);\n   101→    state.microbe.maturity_index = state.microbe.maturity_index.clamp(0.0, 1.0);\n   102→    state.microfauna.population_index = state.microfauna.population_index.clamp(0.0, 1.0);\n   103→    state.microfauna.grazing_pressure_index =\n   104→        state.microfauna.grazing_pressure_index.clamp(0.0, 1.0);\n   105→    state.animal.condition_index = state.animal.condition_index.clamp(0.0, 1.0);\n   106→    state.animal.molt_stress_index = state.animal.molt_stress_index.clamp(0.0, 1.0);\n   107→    state.animal.reproductive_readiness_index =\n   108→        state.animal.reproductive_readiness_index.clamp(0.0, 1.0);\n   109→\n   110→    for plant in &mut state.plant_guilds {\n   111→        plant.health_index = plant.health_index.clamp(0.0, 1.0);\n   112→        plant.crowding_index = plant.crowding_index.clamp(0.0, 1.0);\n   113→        plant.habitat_index = plant.habitat_index.clamp(0.0, 1.0);\n   114→    }\n   115→    for layer in &mut state.substrate_layers {\n   116→        layer.cation_exchange_capacity_index = layer.cation_exchange_capacity_index.clamp(0.0, 1.0);\n   117→        layer.detritus_trapping_index = layer.detritus_trapping_index.clamp(0.0, 1.0);\n   118→        layer.low_oxygen_tendency_index = layer.low_oxygen_tendency_index.clamp(0.0, 1.0);\n   119→        layer.grazing_surface_index = layer.grazing_surface_index.clamp(0.0, 1.0);\n   120→    }\n   121→\n   122→    if state.event_log.len() > 200 {\n   123→        let keep_from = state.event_log.len() - 200;\n   124→        state.event_log.drain(0..keep_from);\n   125→    }\n   126→\n   127→    Ok(())\n   128→}\n   129→\n   130→fn check_non_negative(field: &'static str, value: f64) -> Result<(), SimError> {\n   131→    if !value.is_finite() || value < 0.0 {\n   132→        Err(SimError::InvariantViolation { field, value })\n   133→    } else {\n   134→        Ok(())\n   135→    }\n   136→}\n   137→"}]},"parent_tool_use_id":"toolu_01SgsTaTMKAYX7FzYDgqSBUh","session_id":"86001031-e08b-4ab4-a078-b934bda46f61","uuid":"d1191306-1fc9-4eed-8c23-0cf4ae4af382"}
