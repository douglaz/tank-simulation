{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AEy6rEh1JLv8J8N4qqDmf8","type":"tool_result","content":"     1→use std::collections::BTreeMap;\n     2→\n     3→use tank_core::{\n     4→    FilterState, MicrobeState, PlantGuild, PlantGuildState, ProcessParams, SimMeta, SimSeed,\n     5→    SourceWaterProfile, SubstrateLayerState, TankGeometry, TankState, WaterState,\n     6→};\n     7→use tank_data::{load_scenario, ScenarioPreset};\n     8→\n     9→pub fn default_scenario_ids() -> &'static [&'static str] {\n    10→    tank_data::scenario_ids()\n    11→}\n    12→\n    13→pub fn load_named_scenario(id: &str) -> Result<ScenarioPreset, tank_data::PresetError> {\n    14→    load_scenario(id)\n    15→}\n    16→\n    17→/// Converts a `tank_data::SourceWaterPreset` into a `tank_core::SourceWaterProfile`.\n    18→fn source_water_to_profile(preset: &tank_data::SourceWaterPreset) -> SourceWaterProfile {\n    19→    SourceWaterProfile {\n    20→        temperature_c: preset.temperature_c,\n    21→        ammonia_mg_n_per_l: preset.ammonia_mg_n_per_l,\n    22→        nitrite_mg_n_per_l: preset.nitrite_mg_n_per_l,\n    23→        nitrate_mg_n_per_l: preset.nitrate_mg_n_per_l,\n    24→        phosphate_mg_p_per_l: preset.phosphate_mg_p_per_l,\n    25→        dic_mg_c_per_l: preset.dic_mg_c_per_l,\n    26→        doc_mg_c_per_l: preset.doc_mg_c_per_l,\n    27→        don_mg_n_per_l: preset.don_mg_n_per_l,\n    28→        alkalinity_meq_per_l: preset.alkalinity_meq_per_l,\n    29→        calcium_mg_per_l: preset.calcium_mg_per_l,\n    30→        magnesium_mg_per_l: preset.magnesium_mg_per_l,\n    31→        sodium_mg_per_l: preset.sodium_mg_per_l,\n    32→        potassium_mg_per_l: preset.potassium_mg_per_l,\n    33→        bicarbonate_mg_per_l: preset.bicarbonate_mg_per_l,\n    34→        chloride_mg_per_l: preset.chloride_mg_per_l,\n    35→        sulfate_mg_per_l: preset.sulfate_mg_per_l,\n    36→    }\n    37→}\n    38→\n    39→/// Converts a `tank_data::ProcessParamsPreset` into `tank_core::ProcessParams`.\n    40→fn process_preset_to_params(preset: &tank_data::ProcessParamsPreset) -> ProcessParams {\n    41→    ProcessParams {\n    42→        mineralization_rate_per_day: preset.mineralization_rate_per_day,\n    43→        nitrification_vmax: preset.nitrification_vmax,\n    44→        reaeration_kla_base: preset.reaeration_kla_base,\n    45→        aeration_kla_boost: preset.aeration_kla_boost,\n    46→        background_bod_mg_o2_per_g_biomass_per_hour: preset\n    47→            .background_bod_mg_o2_per_g_biomass_per_hour,\n    48→        plant_photosynthesis_o2_mg_per_g_per_hour: preset\n    49→            .plant_photosynthesis_o2_mg_per_g_per_hour,\n    50→        respiration_dic_rate_mg_c_per_g_per_hour: preset\n    51→            .respiration_dic_rate_mg_c_per_g_per_hour,\n    52→        photosynthesis_dic_rate_mg_c_per_g_per_hour: preset\n    53→            .photosynthesis_dic_rate_mg_c_per_g_per_hour,\n    54→        k_surface_w_per_m2_k: preset.k_surface_w_per_m2_k,\n    55→        k_wall_w_per_m2_k: preset.k_wall_w_per_m2_k,\n    56→\n    57→        feed_leach_rate_per_hour: preset.feed_leach_rate_per_hour,\n    58→        fine_detritus_dissolution_rate_per_hour: preset.fine_detritus_dissolution_rate_per_hour,\n    59→        feed_n_to_c_ratio: preset.feed_n_to_c_ratio,\n    60→\n    61→        decomposer_vmax_per_hour: preset.decomposer_vmax_per_hour,\n    62→        decomposer_k_doc_mg: preset.decomposer_k_doc_mg,\n    63→        decomposer_growth_yield: preset.decomposer_growth_yield,\n    64→        decomposer_decay_rate_per_hour: preset.decomposer_decay_rate_per_hour,\n    65→\n    66→        aob_vmax_mg_n_per_g_per_hour: preset.aob_vmax_mg_n_per_g_per_hour,\n    67→        aob_k_tan_mg: preset.aob_k_tan_mg,\n    68→        aob_k_do_mg: preset.aob_k_do_mg,\n    69→        aob_growth_yield: preset.aob_growth_yield,\n    70→        aob_decay_rate_per_hour: preset.aob_decay_rate_per_hour,\n    71→\n    72→        nob_vmax_mg_n_per_g_per_hour: preset.nob_vmax_mg_n_per_g_per_hour,\n    73→        nob_k_nitrite_mg: preset.nob_k_nitrite_mg,\n    74→        nob_k_do_mg: preset.nob_k_do_mg,\n    75→        nob_growth_yield: preset.nob_growth_yield,\n    76→        nob_decay_rate_per_hour: preset.nob_decay_rate_per_hour,\n    77→\n    78→        comammox_vmax_fraction: preset.comammox_vmax_fraction,\n    79→        comammox_k_tan_mg: preset.comammox_k_tan_mg,\n    80→        comammox_k_do_mg: preset.comammox_k_do_mg,\n    81→        comammox_growth_yield: preset.comammox_growth_yield,\n    82→        comammox_decay_rate_per_hour: preset.comammox_decay_rate_per_hour,\n    83→\n    84→        o2_per_mg_n_nitrified: preset.o2_per_mg_n_nitrified,\n    85→        alkalinity_meq_per_mg_n_nitrified: preset.alkalinity_meq_per_mg_n_nitrified,\n    86→    }\n    87→}\n    88→\n    89→/// Materializes a scenario preset into a fully resolved `TankState`.\n    90→///\n    91→/// - Geometry comes from the scenario.\n    92→/// - `environment.ambient_temp_c` comes from the scenario.\n    93→/// - Initial `WaterState` totals come from the source-water profile × fill volume.\n    94→/// - Substrate layers come from the scenario's substrate preset IDs.\n    95→/// - Plant guilds come from the scenario's plant preset IDs.\n    96→/// - Source-water catalog is populated with all known source-water presets.\n    97→/// - Process parameters come from the scenario's process params preset.\n    98→pub fn seeded_state(seed: SimSeed, scenario_id: &str) -> Result<TankState, tank_data::PresetError> {\n    99→    let scenario = load_named_scenario(scenario_id)?;\n   100→\n   101→    // Geometry\n   102→    let geometry = TankGeometry {\n   103→        length_cm: scenario.tank_length_cm,\n   104→        width_cm: scenario.tank_width_cm,\n   105→        height_cm: scenario.tank_height_cm,\n   106→        fill_height_cm: scenario.fill_height_cm,\n   107→        glass_thickness_mm: 5.0,\n   108→        open_top: true,\n   109→        lid_exchange_factor: 0.25,\n   110→    };\n   111→\n   112→    // Source water profile for initial fill\n   113→    let source_water_preset = tank_data::load_source_water(&scenario.source_water_id)?;\n   114→    let source_profile = source_water_to_profile(&source_water_preset);\n   115→\n   116→    // Initial water state from source-water profile\n   117→    let water = WaterState::from_source_profile(&source_profile, &geometry);\n   118→\n   119→    // Build source-water catalog with all known presets\n   120→    let mut source_water_catalog = BTreeMap::new();\n   121→    for sw_id in tank_data::source_water_ids() {\n   122→        let sw_preset = tank_data::load_source_water(sw_id)?;\n   123→        source_water_catalog.insert(sw_id.to_string(), source_water_to_profile(&sw_preset));\n   124→    }\n   125→\n   126→    // Process parameters\n   127→    let process_preset = tank_data::load_process_params(&scenario.process_params_id)?;\n   128→    let process_params = process_preset_to_params(&process_preset);\n   129→\n   130→    // Substrate layers\n   131→    let mut substrate_layers = Vec::new();\n   132→    for sub_id in &scenario.substrate_ids {\n   133→        let sub_preset = tank_data::load_substrate(sub_id)?;\n   134→        let footprint = geometry.footprint_area_cm2();\n   135→        substrate_layers.push(SubstrateLayerState {\n   136→            kind: match sub_preset.id.as_str() {\n   137→                \"inert_sand\" => tank_core::SubstrateKind::InertSand,\n   138→                \"inert_gravel\" => tank_core::SubstrateKind::InertGravel,\n   139→                \"active_planted\" => tank_core::SubstrateKind::ActivePlanted,\n   140→                \"coarse_porous\" => tank_core::SubstrateKind::CoarsePorous,\n   141→                other => {\n   142→                    return Err(tank_data::PresetError::Validation {\n   143→                        category: \"substrate\",\n   144→                        id: other.to_string(),\n   145→                        message: format!(\"unsupported substrate kind: `{other}`\"),\n   146→                    });\n   147→                }\n   148→            },\n   149→            depth_cm: sub_preset.depth_cm,\n   150→            nutrient_store_mg_n_total: sub_preset.nutrient_charge_mg_n_total,\n   151→            nutrient_store_mg_p_total: sub_preset.nutrient_charge_mg_p_total,\n   152→            cation_exchange_capacity_index: sub_preset.cation_exchange_capacity_index,\n   153→            detritus_trapping_index: sub_preset.detritus_trapping_index,\n   154→            colonizable_area_cm2: footprint * sub_preset.colonizable_area_factor,\n   155→            low_oxygen_tendency_index: sub_preset.low_oxygen_tendency_index,\n   156→            grazing_surface_index: sub_preset.grazing_surface_index,\n   157→        });\n   158→    }\n   159→    if substrate_layers.is_empty() {\n   160→        substrate_layers.push(SubstrateLayerState::default());\n   161→    }\n   162→\n   163→    // Plant guilds\n   164→    let mut plant_guilds = Vec::new();\n   165→    for plant_id in &scenario.plant_ids {\n   166→        let plant_preset = tank_data::load_plant(plant_id)?;\n   167→        let guild = match plant_preset.guild.as_str() {\n   168→            \"FastStem\" => PlantGuild::FastStem,\n   169→            \"RootFeedingRosette\" => PlantGuild::RootFeedingRosette,\n   170→            other => {\n   171→                return Err(tank_data::PresetError::Validation {\n   172→                    category: \"plants\",\n   173→                    id: plant_id.clone(),\n   174→                    message: format!(\"unsupported plant guild: `{other}`\"),\n   175→                });\n   176→            }\n   177→        };\n   178→        plant_guilds.push(PlantGuildState {\n   179→            guild,\n   180→            biomass_g: 5.0,\n   181→            health_index: 0.8,\n   182→            crowding_index: 0.1,\n   183→            habitat_index: if guild == PlantGuild::RootFeedingRosette {\n   184→                // Habitat factor depends on substrate quality\n   185→                substrate_layers\n   186→                    .iter()\n   187→                    .map(|l| l.cation_exchange_capacity_index)\n   188→                    .fold(0.0_f64, f64::max)\n   189→                    .max(0.3)\n   190→            } else {\n   191→                0.8\n   192→            },\n   193→        });\n   194→    }\n   195→    if plant_guilds.is_empty() {\n   196→        plant_guilds.push(PlantGuildState::default());\n   197→    }\n   198→\n   199→    // Environment\n   200→    let mut environment = tank_core::EnvironmentState::default();\n   201→    environment.ambient_temp_c = scenario.ambient_temp_c;\n   202→\n   203→    let mut state = TankState::new(seed);\n   204→    state.meta = SimMeta {\n   205→        scenario_id: Some(scenario.id),\n   206→        notes: Some(scenario.name),\n   207→    };\n   208→    state.geometry = geometry;\n   209→    state.environment = environment;\n   210→    state.water = water;\n   211→    state.substrate_layers = substrate_layers;\n   212→    state.plant_guilds = plant_guilds;\n   213→    state.source_water_catalog = source_water_catalog;\n   214→    state.process_params = process_params;\n   215→\n   216→    Ok(state)\n   217→}\n   218→\n   219→/// Creates a deterministic cycling fixture pair: one seeded, one unseeded.\n   220→/// Both tanks are otherwise identical (~20L nano tank with moderate source water,\n   221→/// fed daily, with aeration enabled).\n   222→/// The seeded tank starts with elevated nitrifier biomass and higher maturity;\n   223→/// the unseeded tank starts with minimal microbes and low maturity.\n   224→pub fn cycling_fixture_pair(seed: SimSeed) -> (TankState, TankState) {\n   225→    let base = cycling_base_state(seed);\n   226→\n   227→    let mut seeded = base.clone();\n   228→    seeded.meta.scenario_id = Some(\"cycling_seeded\".to_string());\n   229→    // Seeded: same decomposer biomass but much higher nitrifier biomass + maturity\n   230→    seeded.microbe = MicrobeState {\n   231→        decomposer_biomass_g: 0.1,\n   232→        ammonia_oxidizer_biomass_g: 0.20,\n   233→        nitrite_oxidizer_biomass_g: 0.15,\n   234→        comammox_biomass_g: 0.05,\n   235→        maturity_index: 0.6,\n   236→    };\n   237→    seeded.filter_state = FilterState {\n   238→        biofilter_maturity_index: 0.6,\n   239→        clogging_index: 0.0,\n   240→        seeded_biomass_index: 0.8,\n   241→    };\n   242→\n   243→    let mut unseeded = base;\n   244→    unseeded.meta.scenario_id = Some(\"cycling_unseeded\".to_string());\n   245→    // Unseeded: same decomposer biomass but minimal nitrifier biomass + maturity\n   246→    unseeded.microbe = MicrobeState {\n   247→        decomposer_biomass_g: 0.1,\n   248→        ammonia_oxidizer_biomass_g: 0.005,\n   249→        nitrite_oxidizer_biomass_g: 0.005,\n   250→        comammox_biomass_g: 0.001,\n   251→        maturity_index: 0.05,\n   252→    };\n   253→    unseeded.filter_state = FilterState {\n   254→        biofilter_maturity_index: 0.05,\n   255→        clogging_index: 0.0,\n   256→        seeded_biomass_index: 0.0,\n   257→    };\n   258→\n   259→    (seeded, unseeded)\n   260→}\n   261→\n   262→/// Base state shared by both cycling fixtures.\n   263→fn cycling_base_state(seed: SimSeed) -> TankState {\n   264→    let geometry = TankGeometry {\n   265→        length_cm: 30.0,\n   266→        width_cm: 25.0,\n   267→        height_cm: 30.0,\n   268→        fill_height_cm: 26.0,\n   269→        glass_thickness_mm: 5.0,\n   270→        open_top: true,\n   271→        lid_exchange_factor: 0.25,\n   272→    };\n   273→\n   274→    let water = WaterState::default_for_geometry(&geometry);\n   275→\n   276→    let mut state = TankState::new(seed);\n   277→    state.geometry = geometry;\n   278→    state.water = water;\n   279→    state.water.temperature_c = 25.0;\n   280→    state.environment.ambient_temp_c = 25.0;\n   281→\n   282→    // Enable moderate aeration\n   283→    state.hardware.aeration.enabled = true;\n   284→    state.hardware.aeration.intensity = 0.3;\n   285→\n   286→    // Single fast-stem plant\n   287→    state.plant_guilds = vec![PlantGuildState {\n   288→        guild: PlantGuild::FastStem,\n   289→        biomass_g: 3.0,\n   290→        health_index: 0.8,\n   291→        crowding_index: 0.1,\n   292→        habitat_index: 0.8,\n   293→    }];\n   294→\n   295→    state.process_params = ProcessParams::default();\n   296→\n   297→    state\n   298→}\n   299→"}]},"parent_tool_use_id":null,"session_id":"af270d75-fd6d-4e84-9953-cdba41291cd7","uuid":"d11b4e64-2a1e-4d1e-8219-f7ec8d646499","tool_use_result":{"type":"text","file":{"filePath":"/root/tank-simulation/crates/tank_scenarios/src/lib.rs","content":"use std::collections::BTreeMap;\n\nuse tank_core::{\n    FilterState, MicrobeState, PlantGuild, PlantGuildState, ProcessParams, SimMeta, SimSeed,\n    SourceWaterProfile, SubstrateLayerState, TankGeometry, TankState, WaterState,\n};\nuse tank_data::{load_scenario, ScenarioPreset};\n\npub fn default_scenario_ids() -> &'static [&'static str] {\n    tank_data::scenario_ids()\n}\n\npub fn load_named_scenario(id: &str) -> Result<ScenarioPreset, tank_data::PresetError> {\n    load_scenario(id)\n}\n\n/// Converts a `tank_data::SourceWaterPreset` into a `tank_core::SourceWaterProfile`.\nfn source_water_to_profile(preset: &tank_data::SourceWaterPreset) -> SourceWaterProfile {\n    SourceWaterProfile {\n        temperature_c: preset.temperature_c,\n        ammonia_mg_n_per_l: preset.ammonia_mg_n_per_l,\n        nitrite_mg_n_per_l: preset.nitrite_mg_n_per_l,\n        nitrate_mg_n_per_l: preset.nitrate_mg_n_per_l,\n        phosphate_mg_p_per_l: preset.phosphate_mg_p_per_l,\n        dic_mg_c_per_l: preset.dic_mg_c_per_l,\n        doc_mg_c_per_l: preset.doc_mg_c_per_l,\n        don_mg_n_per_l: preset.don_mg_n_per_l,\n        alkalinity_meq_per_l: preset.alkalinity_meq_per_l,\n        calcium_mg_per_l: preset.calcium_mg_per_l,\n        magnesium_mg_per_l: preset.magnesium_mg_per_l,\n        sodium_mg_per_l: preset.sodium_mg_per_l,\n        potassium_mg_per_l: preset.potassium_mg_per_l,\n        bicarbonate_mg_per_l: preset.bicarbonate_mg_per_l,\n        chloride_mg_per_l: preset.chloride_mg_per_l,\n        sulfate_mg_per_l: preset.sulfate_mg_per_l,\n    }\n}\n\n/// Converts a `tank_data::ProcessParamsPreset` into `tank_core::ProcessParams`.\nfn process_preset_to_params(preset: &tank_data::ProcessParamsPreset) -> ProcessParams {\n    ProcessParams {\n        mineralization_rate_per_day: preset.mineralization_rate_per_day,\n        nitrification_vmax: preset.nitrification_vmax,\n        reaeration_kla_base: preset.reaeration_kla_base,\n        aeration_kla_boost: preset.aeration_kla_boost,\n        background_bod_mg_o2_per_g_biomass_per_hour: preset\n            .background_bod_mg_o2_per_g_biomass_per_hour,\n        plant_photosynthesis_o2_mg_per_g_per_hour: preset\n            .plant_photosynthesis_o2_mg_per_g_per_hour,\n        respiration_dic_rate_mg_c_per_g_per_hour: preset\n            .respiration_dic_rate_mg_c_per_g_per_hour,\n        photosynthesis_dic_rate_mg_c_per_g_per_hour: preset\n            .photosynthesis_dic_rate_mg_c_per_g_per_hour,\n        k_surface_w_per_m2_k: preset.k_surface_w_per_m2_k,\n        k_wall_w_per_m2_k: preset.k_wall_w_per_m2_k,\n\n        feed_leach_rate_per_hour: preset.feed_leach_rate_per_hour,\n        fine_detritus_dissolution_rate_per_hour: preset.fine_detritus_dissolution_rate_per_hour,\n        feed_n_to_c_ratio: preset.feed_n_to_c_ratio,\n\n        decomposer_vmax_per_hour: preset.decomposer_vmax_per_hour,\n        decomposer_k_doc_mg: preset.decomposer_k_doc_mg,\n        decomposer_growth_yield: preset.decomposer_growth_yield,\n        decomposer_decay_rate_per_hour: preset.decomposer_decay_rate_per_hour,\n\n        aob_vmax_mg_n_per_g_per_hour: preset.aob_vmax_mg_n_per_g_per_hour,\n        aob_k_tan_mg: preset.aob_k_tan_mg,\n        aob_k_do_mg: preset.aob_k_do_mg,\n        aob_growth_yield: preset.aob_growth_yield,\n        aob_decay_rate_per_hour: preset.aob_decay_rate_per_hour,\n\n        nob_vmax_mg_n_per_g_per_hour: preset.nob_vmax_mg_n_per_g_per_hour,\n        nob_k_nitrite_mg: preset.nob_k_nitrite_mg,\n        nob_k_do_mg: preset.nob_k_do_mg,\n        nob_growth_yield: preset.nob_growth_yield,\n        nob_decay_rate_per_hour: preset.nob_decay_rate_per_hour,\n\n        comammox_vmax_fraction: preset.comammox_vmax_fraction,\n        comammox_k_tan_mg: preset.comammox_k_tan_mg,\n        comammox_k_do_mg: preset.comammox_k_do_mg,\n        comammox_growth_yield: preset.comammox_growth_yield,\n        comammox_decay_rate_per_hour: preset.comammox_decay_rate_per_hour,\n\n        o2_per_mg_n_nitrified: preset.o2_per_mg_n_nitrified,\n        alkalinity_meq_per_mg_n_nitrified: preset.alkalinity_meq_per_mg_n_nitrified,\n    }\n}\n\n/// Materializes a scenario preset into a fully resolved `TankState`.\n///\n/// - Geometry comes from the scenario.\n/// - `environment.ambient_temp_c` comes from the scenario.\n/// - Initial `WaterState` totals come from the source-water profile × fill volume.\n/// - Substrate layers come from the scenario's substrate preset IDs.\n/// - Plant guilds come from the scenario's plant preset IDs.\n/// - Source-water catalog is populated with all known source-water presets.\n/// - Process parameters come from the scenario's process params preset.\npub fn seeded_state(seed: SimSeed, scenario_id: &str) -> Result<TankState, tank_data::PresetError> {\n    let scenario = load_named_scenario(scenario_id)?;\n\n    // Geometry\n    let geometry = TankGeometry {\n        length_cm: scenario.tank_length_cm,\n        width_cm: scenario.tank_width_cm,\n        height_cm: scenario.tank_height_cm,\n        fill_height_cm: scenario.fill_height_cm,\n        glass_thickness_mm: 5.0,\n        open_top: true,\n        lid_exchange_factor: 0.25,\n    };\n\n    // Source water profile for initial fill\n    let source_water_preset = tank_data::load_source_water(&scenario.source_water_id)?;\n    let source_profile = source_water_to_profile(&source_water_preset);\n\n    // Initial water state from source-water profile\n    let water = WaterState::from_source_profile(&source_profile, &geometry);\n\n    // Build source-water catalog with all known presets\n    let mut source_water_catalog = BTreeMap::new();\n    for sw_id in tank_data::source_water_ids() {\n        let sw_preset = tank_data::load_source_water(sw_id)?;\n        source_water_catalog.insert(sw_id.to_string(), source_water_to_profile(&sw_preset));\n    }\n\n    // Process parameters\n    let process_preset = tank_data::load_process_params(&scenario.process_params_id)?;\n    let process_params = process_preset_to_params(&process_preset);\n\n    // Substrate layers\n    let mut substrate_layers = Vec::new();\n    for sub_id in &scenario.substrate_ids {\n        let sub_preset = tank_data::load_substrate(sub_id)?;\n        let footprint = geometry.footprint_area_cm2();\n        substrate_layers.push(SubstrateLayerState {\n            kind: match sub_preset.id.as_str() {\n                \"inert_sand\" => tank_core::SubstrateKind::InertSand,\n                \"inert_gravel\" => tank_core::SubstrateKind::InertGravel,\n                \"active_planted\" => tank_core::SubstrateKind::ActivePlanted,\n                \"coarse_porous\" => tank_core::SubstrateKind::CoarsePorous,\n                other => {\n                    return Err(tank_data::PresetError::Validation {\n                        category: \"substrate\",\n                        id: other.to_string(),\n                        message: format!(\"unsupported substrate kind: `{other}`\"),\n                    });\n                }\n            },\n            depth_cm: sub_preset.depth_cm,\n            nutrient_store_mg_n_total: sub_preset.nutrient_charge_mg_n_total,\n            nutrient_store_mg_p_total: sub_preset.nutrient_charge_mg_p_total,\n            cation_exchange_capacity_index: sub_preset.cation_exchange_capacity_index,\n            detritus_trapping_index: sub_preset.detritus_trapping_index,\n            colonizable_area_cm2: footprint * sub_preset.colonizable_area_factor,\n            low_oxygen_tendency_index: sub_preset.low_oxygen_tendency_index,\n            grazing_surface_index: sub_preset.grazing_surface_index,\n        });\n    }\n    if substrate_layers.is_empty() {\n        substrate_layers.push(SubstrateLayerState::default());\n    }\n\n    // Plant guilds\n    let mut plant_guilds = Vec::new();\n    for plant_id in &scenario.plant_ids {\n        let plant_preset = tank_data::load_plant(plant_id)?;\n        let guild = match plant_preset.guild.as_str() {\n            \"FastStem\" => PlantGuild::FastStem,\n            \"RootFeedingRosette\" => PlantGuild::RootFeedingRosette,\n            other => {\n                return Err(tank_data::PresetError::Validation {\n                    category: \"plants\",\n                    id: plant_id.clone(),\n                    message: format!(\"unsupported plant guild: `{other}`\"),\n                });\n            }\n        };\n        plant_guilds.push(PlantGuildState {\n            guild,\n            biomass_g: 5.0,\n            health_index: 0.8,\n            crowding_index: 0.1,\n            habitat_index: if guild == PlantGuild::RootFeedingRosette {\n                // Habitat factor depends on substrate quality\n                substrate_layers\n                    .iter()\n                    .map(|l| l.cation_exchange_capacity_index)\n                    .fold(0.0_f64, f64::max)\n                    .max(0.3)\n            } else {\n                0.8\n            },\n        });\n    }\n    if plant_guilds.is_empty() {\n        plant_guilds.push(PlantGuildState::default());\n    }\n\n    // Environment\n    let mut environment = tank_core::EnvironmentState::default();\n    environment.ambient_temp_c = scenario.ambient_temp_c;\n\n    let mut state = TankState::new(seed);\n    state.meta = SimMeta {\n        scenario_id: Some(scenario.id),\n        notes: Some(scenario.name),\n    };\n    state.geometry = geometry;\n    state.environment = environment;\n    state.water = water;\n    state.substrate_layers = substrate_layers;\n    state.plant_guilds = plant_guilds;\n    state.source_water_catalog = source_water_catalog;\n    state.process_params = process_params;\n\n    Ok(state)\n}\n\n/// Creates a deterministic cycling fixture pair: one seeded, one unseeded.\n/// Both tanks are otherwise identical (~20L nano tank with moderate source water,\n/// fed daily, with aeration enabled).\n/// The seeded tank starts with elevated nitrifier biomass and higher maturity;\n/// the unseeded tank starts with minimal microbes and low maturity.\npub fn cycling_fixture_pair(seed: SimSeed) -> (TankState, TankState) {\n    let base = cycling_base_state(seed);\n\n    let mut seeded = base.clone();\n    seeded.meta.scenario_id = Some(\"cycling_seeded\".to_string());\n    // Seeded: same decomposer biomass but much higher nitrifier biomass + maturity\n    seeded.microbe = MicrobeState {\n        decomposer_biomass_g: 0.1,\n        ammonia_oxidizer_biomass_g: 0.20,\n        nitrite_oxidizer_biomass_g: 0.15,\n        comammox_biomass_g: 0.05,\n        maturity_index: 0.6,\n    };\n    seeded.filter_state = FilterState {\n        biofilter_maturity_index: 0.6,\n        clogging_index: 0.0,\n        seeded_biomass_index: 0.8,\n    };\n\n    let mut unseeded = base;\n    unseeded.meta.scenario_id = Some(\"cycling_unseeded\".to_string());\n    // Unseeded: same decomposer biomass but minimal nitrifier biomass + maturity\n    unseeded.microbe = MicrobeState {\n        decomposer_biomass_g: 0.1,\n        ammonia_oxidizer_biomass_g: 0.005,\n        nitrite_oxidizer_biomass_g: 0.005,\n        comammox_biomass_g: 0.001,\n        maturity_index: 0.05,\n    };\n    unseeded.filter_state = FilterState {\n        biofilter_maturity_index: 0.05,\n        clogging_index: 0.0,\n        seeded_biomass_index: 0.0,\n    };\n\n    (seeded, unseeded)\n}\n\n/// Base state shared by both cycling fixtures.\nfn cycling_base_state(seed: SimSeed) -> TankState {\n    let geometry = TankGeometry {\n        length_cm: 30.0,\n        width_cm: 25.0,\n        height_cm: 30.0,\n        fill_height_cm: 26.0,\n        glass_thickness_mm: 5.0,\n        open_top: true,\n        lid_exchange_factor: 0.25,\n    };\n\n    let water = WaterState::default_for_geometry(&geometry);\n\n    let mut state = TankState::new(seed);\n    state.geometry = geometry;\n    state.water = water;\n    state.water.temperature_c = 25.0;\n    state.environment.ambient_temp_c = 25.0;\n\n    // Enable moderate aeration\n    state.hardware.aeration.enabled = true;\n    state.hardware.aeration.intensity = 0.3;\n\n    // Single fast-stem plant\n    state.plant_guilds = vec![PlantGuildState {\n        guild: PlantGuild::FastStem,\n        biomass_g: 3.0,\n        health_index: 0.8,\n        crowding_index: 0.1,\n        habitat_index: 0.8,\n    }];\n\n    state.process_params = ProcessParams::default();\n\n    state\n}\n","numLines":299,"startLine":1,"totalLines":299}}}
