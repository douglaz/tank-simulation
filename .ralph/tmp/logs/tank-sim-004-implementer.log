{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FnuVUTXDPghPdbbnqe6quo","type":"tool_result","content":"     1→use std::collections::BTreeMap;\n     2→\n     3→use tank_core::{\n     4→    PlantGuild, PlantGuildState, ProcessParams, SimMeta, SimSeed, SourceWaterProfile,\n     5→    SubstrateLayerState, TankGeometry, TankState, WaterState,\n     6→};\n     7→use tank_data::{load_scenario, ScenarioPreset};\n     8→\n     9→pub fn default_scenario_ids() -> &'static [&'static str] {\n    10→    tank_data::scenario_ids()\n    11→}\n    12→\n    13→pub fn load_named_scenario(id: &str) -> Result<ScenarioPreset, tank_data::PresetError> {\n    14→    load_scenario(id)\n    15→}\n    16→\n    17→/// Converts a `tank_data::SourceWaterPreset` into a `tank_core::SourceWaterProfile`.\n    18→fn source_water_to_profile(preset: &tank_data::SourceWaterPreset) -> SourceWaterProfile {\n    19→    SourceWaterProfile {\n    20→        temperature_c: preset.temperature_c,\n    21→        ammonia_mg_n_per_l: preset.ammonia_mg_n_per_l,\n    22→        nitrite_mg_n_per_l: preset.nitrite_mg_n_per_l,\n    23→        nitrate_mg_n_per_l: preset.nitrate_mg_n_per_l,\n    24→        phosphate_mg_p_per_l: preset.phosphate_mg_p_per_l,\n    25→        dic_mg_c_per_l: preset.dic_mg_c_per_l,\n    26→        doc_mg_c_per_l: preset.doc_mg_c_per_l,\n    27→        don_mg_n_per_l: preset.don_mg_n_per_l,\n    28→        alkalinity_meq_per_l: preset.alkalinity_meq_per_l,\n    29→        calcium_mg_per_l: preset.calcium_mg_per_l,\n    30→        magnesium_mg_per_l: preset.magnesium_mg_per_l,\n    31→        sodium_mg_per_l: preset.sodium_mg_per_l,\n    32→        potassium_mg_per_l: preset.potassium_mg_per_l,\n    33→        bicarbonate_mg_per_l: preset.bicarbonate_mg_per_l,\n    34→        chloride_mg_per_l: preset.chloride_mg_per_l,\n    35→        sulfate_mg_per_l: preset.sulfate_mg_per_l,\n    36→    }\n    37→}\n    38→\n    39→/// Converts a `tank_data::ProcessParamsPreset` into `tank_core::ProcessParams`.\n    40→fn process_preset_to_params(preset: &tank_data::ProcessParamsPreset) -> ProcessParams {\n    41→    ProcessParams {\n    42→        mineralization_rate_per_day: preset.mineralization_rate_per_day,\n    43→        nitrification_vmax: preset.nitrification_vmax,\n    44→        reaeration_kla_base: preset.reaeration_kla_base,\n    45→        aeration_kla_boost: preset.aeration_kla_boost,\n    46→        background_bod_mg_o2_per_g_biomass_per_hour: preset\n    47→            .background_bod_mg_o2_per_g_biomass_per_hour,\n    48→        plant_photosynthesis_o2_mg_per_g_per_hour: preset\n    49→            .plant_photosynthesis_o2_mg_per_g_per_hour,\n    50→        respiration_dic_rate_mg_c_per_g_per_hour: preset\n    51→            .respiration_dic_rate_mg_c_per_g_per_hour,\n    52→        photosynthesis_dic_rate_mg_c_per_g_per_hour: preset\n    53→            .photosynthesis_dic_rate_mg_c_per_g_per_hour,\n    54→        k_surface_w_per_m2_k: preset.k_surface_w_per_m2_k,\n    55→        k_wall_w_per_m2_k: preset.k_wall_w_per_m2_k,\n    56→    }\n    57→}\n    58→\n    59→/// Materializes a scenario preset into a fully resolved `TankState`.\n    60→///\n    61→/// - Geometry comes from the scenario.\n    62→/// - `environment.ambient_temp_c` comes from the scenario.\n    63→/// - Initial `WaterState` totals come from the source-water profile × fill volume.\n    64→/// - Substrate layers come from the scenario's substrate preset IDs.\n    65→/// - Plant guilds come from the scenario's plant preset IDs.\n    66→/// - Source-water catalog is populated with all known source-water presets.\n    67→/// - Process parameters come from the scenario's process params preset.\n    68→pub fn seeded_state(seed: SimSeed, scenario_id: &str) -> Result<TankState, tank_data::PresetError> {\n    69→    let scenario = load_named_scenario(scenario_id)?;\n    70→\n    71→    // Geometry\n    72→    let geometry = TankGeometry {\n    73→        length_cm: scenario.tank_length_cm,\n    74→        width_cm: scenario.tank_width_cm,\n    75→        height_cm: scenario.tank_height_cm,\n    76→        fill_height_cm: scenario.fill_height_cm,\n    77→        glass_thickness_mm: 5.0,\n    78→        open_top: true,\n    79→        lid_exchange_factor: 0.25,\n    80→    };\n    81→\n    82→    // Source water profile for initial fill\n    83→    let source_water_preset = tank_data::load_source_water(&scenario.source_water_id)?;\n    84→    let source_profile = source_water_to_profile(&source_water_preset);\n    85→\n    86→    // Initial water state from source-water profile\n    87→    let water = WaterState::from_source_profile(&source_profile, &geometry);\n    88→\n    89→    // Build source-water catalog with all known presets\n    90→    let mut source_water_catalog = BTreeMap::new();\n    91→    for sw_id in tank_data::source_water_ids() {\n    92→        let sw_preset = tank_data::load_source_water(sw_id)?;\n    93→        source_water_catalog.insert(sw_id.to_string(), source_water_to_profile(&sw_preset));\n    94→    }\n    95→\n    96→    // Process parameters\n    97→    let process_preset = tank_data::load_process_params(&scenario.process_params_id)?;\n    98→    let process_params = process_preset_to_params(&process_preset);\n    99→\n   100→    // Substrate layers\n   101→    let mut substrate_layers = Vec::new();\n   102→    for sub_id in &scenario.substrate_ids {\n   103→        let sub_preset = tank_data::load_substrate(sub_id)?;\n   104→        let footprint = geometry.footprint_area_cm2();\n   105→        substrate_layers.push(SubstrateLayerState {\n   106→            kind: match sub_preset.id.as_str() {\n   107→                \"inert_sand\" => tank_core::SubstrateKind::InertSand,\n   108→                \"inert_gravel\" => tank_core::SubstrateKind::InertGravel,\n   109→                \"active_planted\" => tank_core::SubstrateKind::ActivePlanted,\n   110→                \"coarse_porous\" => tank_core::SubstrateKind::CoarsePorous,\n   111→                other => {\n   112→                    return Err(tank_data::PresetError::Validation {\n   113→                        category: \"substrate\",\n   114→                        id: other.to_string(),\n   115→                        message: format!(\"unsupported substrate kind: `{other}`\"),\n   116→                    });\n   117→                }\n   118→            },\n   119→            depth_cm: sub_preset.depth_cm,\n   120→            nutrient_store_mg_n_total: sub_preset.nutrient_charge_mg_n_total,\n   121→            nutrient_store_mg_p_total: sub_preset.nutrient_charge_mg_p_total,\n   122→            cation_exchange_capacity_index: sub_preset.cation_exchange_capacity_index,\n   123→            detritus_trapping_index: sub_preset.detritus_trapping_index,\n   124→            colonizable_area_cm2: footprint * sub_preset.colonizable_area_factor,\n   125→            low_oxygen_tendency_index: sub_preset.low_oxygen_tendency_index,\n   126→            grazing_surface_index: sub_preset.grazing_surface_index,\n   127→        });\n   128→    }\n   129→    if substrate_layers.is_empty() {\n   130→        substrate_layers.push(SubstrateLayerState::default());\n   131→    }\n   132→\n   133→    // Plant guilds\n   134→    let mut plant_guilds = Vec::new();\n   135→    for plant_id in &scenario.plant_ids {\n   136→        let plant_preset = tank_data::load_plant(plant_id)?;\n   137→        let guild = match plant_preset.guild.as_str() {\n   138→            \"FastStem\" => PlantGuild::FastStem,\n   139→            \"RootFeedingRosette\" => PlantGuild::RootFeedingRosette,\n   140→            other => {\n   141→                return Err(tank_data::PresetError::Validation {\n   142→                    category: \"plants\",\n   143→                    id: plant_id.clone(),\n   144→                    message: format!(\"unsupported plant guild: `{other}`\"),\n   145→                });\n   146→            }\n   147→        };\n   148→        plant_guilds.push(PlantGuildState {\n   149→            guild,\n   150→            biomass_g: 5.0,\n   151→            health_index: 0.8,\n   152→            crowding_index: 0.1,\n   153→            habitat_index: if guild == PlantGuild::RootFeedingRosette {\n   154→                // Habitat factor depends on substrate quality\n   155→                substrate_layers\n   156→                    .iter()\n   157→                    .map(|l| l.cation_exchange_capacity_index)\n   158→                    .fold(0.0_f64, f64::max)\n   159→                    .max(0.3)\n   160→            } else {\n   161→                0.8\n   162→            },\n   163→        });\n   164→    }\n   165→    if plant_guilds.is_empty() {\n   166→        plant_guilds.push(PlantGuildState::default());\n   167→    }\n   168→\n   169→    // Environment\n   170→    let mut environment = tank_core::EnvironmentState::default();\n   171→    environment.ambient_temp_c = scenario.ambient_temp_c;\n   172→\n   173→    let mut state = TankState::new(seed);\n   174→    state.meta = SimMeta {\n   175→        scenario_id: Some(scenario.id),\n   176→        notes: Some(scenario.name),\n   177→    };\n   178→    state.geometry = geometry;\n   179→    state.environment = environment;\n   180→    state.water = water;\n   181→    state.substrate_layers = substrate_layers;\n   182→    state.plant_guilds = plant_guilds;\n   183→    state.source_water_catalog = source_water_catalog;\n   184→    state.process_params = process_params;\n   185→\n   186→    Ok(state)\n   187→}\n   188→"}]},"parent_tool_use_id":"toolu_01SgsTaTMKAYX7FzYDgqSBUh","session_id":"86001031-e08b-4ab4-a078-b934bda46f61","uuid":"878d2482-506a-46d8-a55f-73c04fc14133"}
