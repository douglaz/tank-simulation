{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NhD9iNroPqnnSGoqtSms16","type":"tool_result","content":"     1→pub fn is_light_on(hour_of_day: u8, photoperiod_hours: f64) -> bool {\n     2→    if photoperiod_hours <= 0.0 {\n     3→        return false;\n     4→    }\n     5→    if photoperiod_hours >= 24.0 {\n     6→        return true;\n     7→    }\n     8→\n     9→    let midpoint_hour = f64::from(hour_of_day % 24) + 0.5;\n    10→    let start_hour = 12.0 - photoperiod_hours / 2.0;\n    11→    let end_hour = 12.0 + photoperiod_hours / 2.0;\n    12→\n    13→    midpoint_hour >= start_hour && midpoint_hour < end_hour\n    14→}\n    15→\n    16→#[cfg(test)]\n    17→mod tests {\n    18→    use super::is_light_on;\n    19→\n    20→    #[test]\n    21→    fn centered_on_noon_for_even_photoperiod() {\n    22→        let lit_hours: Vec<u8> = (0..24).filter(|hour| is_light_on(*hour, 8.0)).collect();\n    23→        assert_eq!(lit_hours, vec![8, 9, 10, 11, 12, 13, 14, 15]);\n    24→    }\n    25→\n    26→    #[test]\n    27→    fn zero_and_full_day_photoperiods() {\n    28→        assert!(!(0..24).any(|hour| is_light_on(hour, 0.0)));\n    29→        assert!((0..24).all(|hour| is_light_on(hour, 24.0)));\n    30→    }\n    31→}\n    32→"}]},"parent_tool_use_id":"toolu_01SgsTaTMKAYX7FzYDgqSBUh","session_id":"86001031-e08b-4ab4-a078-b934bda46f61","uuid":"d21c2020-0656-401a-85b3-3b677eca7479"}
