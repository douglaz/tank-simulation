n_mg_n_per_l: 0.0,\n    45→            alkalinity_meq_per_l: 2.0,\n    46→            calcium_mg_per_l: 30.0,\n    47→            magnesium_mg_per_l: 8.0,\n    48→            sodium_mg_per_l: 12.0,\n    49→            potassium_mg_per_l: 3.0,\n    50→            bicarbonate_mg_per_l: 80.0,\n    51→            chloride_mg_per_l: 15.0,\n    52→            sulfate_mg_per_l: 10.0,\n    53→        },\n    54→    );\n    55→    state.process_params = ProcessParams {\n    56→        mineralization_rate_per_day: 0.2,\n    57→        nitrification_vmax: 0.1,\n    58→        reaeration_kla_base: 0.5,\n    59→        aeration_kla_boost: 1.1,\n    60→        background_bod_mg_o2_per_g_biomass_per_hour: 0.07,\n    61→        plant_photosynthesis_o2_mg_per_g_per_hour: 0.22,\n    62→        respiration_dic_rate_mg_c_per_g_per_hour: 0.09,\n    63→        photosynthesis_dic_rate_mg_c_per_g_per_hour: 0.14,\n    64→        k_surface_w_per_m2_k: 12.0,\n    65→        k_wall_w_per_m2_k: 6.0,\n    66→    };\n    67→\n    68→    let mut engine = Engine::from_parts(state, vec![]);\n    69→    engine.step_hours(1)?;\n    70→\n    71→    let save = SaveFile::from_engine(&engine);\n    72→    let json = save.to_json_pretty()?;\n    73→    let restored = SaveFile::from_json(&json)?;\n    74→    let restored_engine = restored.into_engine();\n    75→\n    76→    // Source water catalog and process params must survive roundtrip\n    77→    assert_eq!(\n    78→        engine.full_state().source_water_catalog,\n    79→        restored_engine.full_state().source_water_catalog\n    80→    );\n    81→    assert_eq!(\n    82→        engine.full_state().process_params,\n    83→        restored_engine.full_state().process_params\n    84→    );\n    85→    assert_eq!(\n    86→        engine.full_state().hardware.heater.last_output_w,\n    87→        restored_engine.full_state().hardware.heater.last_output_w\n    88→    );\n    89→    assert_eq!(engine.full_state(), restored_engine.full_state());\n    90→\n    91→    Ok(())\n    92→}\n    93→\n    94→#[test]\n    95→fn save_load_resume_determinism() -> Result<(), tank_core::SimError> {\n    96→    // Run 240 hours, save, load, run 480 more vs uninterrupted 720\n    97→    let mut engine_continuous = Engine::new(SimSeed(77));\n    98→    engine_continuous.step_hours(720)?;\n    99→\n   100→    let mut engine_split = Engine::new(SimSeed(77));\n   101→    engine_split.step_hours(240)?;\n   102→\n   103→    let save = SaveFile::from_engine(&engine_split);\n   104→    let json = save.to_json_pretty()?;\n   105→    let restored = SaveFile::from_json(&json)?;\n   106→    let mut engine_resumed = restored.into_engine();\n   107→    engine_resumed.step_hours(480)?;\n   108→\n   109→    assert_eq!(\n   110→        engine_continuous.full_state(),\n   111→        engine_resumed.full_state(),\n   112→        \"Save/load/resume must produce identical state to uninterrupted run\"\n   113→    );\n   114→\n   115→    Ok(())\n   116→}\n   117→"}]},"parent_tool_use_id":null,"session_id":"86001031-e08b-4ab4-a078-b934bda46f61","uuid":"720464ff-7065-4546-b6ae-72b8089b726c","tool_use_result":{"type":"text","file":{"filePath":"/root/tank-simulation/crates/tank_core/tests/save_load.rs","content":"use tank_core::{\n    Engine, PlayerAction, ProcessParams, SaveFile, SimSeed, SimulationEngine, SourceWaterProfile,\n    TankState,\n};\n\n#[test]\nfn save_load_roundtrip() -> Result<(), tank_core::SimError> {\n    let mut engine = Engine::new(SimSeed(42));\n    engine.apply_action(PlayerAction::Feed { grams: 1.25 })?;\n    engine.apply_action(PlayerAction::ChangeAmbientTemperature { target_c: 25.5 })?;\n    engine.step_hours(1)?;\n    engine.apply_action(PlayerAction::ChangeLightIntensity {\n        intensity_index: 0.6,\n    })?;\n\n    let save = SaveFile::from_engine(&engine);\n    let json = save.to_json_pretty()?;\n    let restored = SaveFile::from_json(&json)?;\n    let restored_engine = restored.clone().into_engine();\n\n    assert_eq!(save, restored);\n    assert_eq!(engine.full_state(), restored_engine.full_state());\n    assert_eq!(engine.queued_actions(), restored_engine.queued_actions());\n\n    Ok(())\n}\n\n#[test]\nfn save_load_with_source_water_catalog() -> Result<(), tank_core::SimError> {\n    let mut state = TankState::new(SimSeed(42));\n    state\n        .source_water_catalog\n        .insert(\"ro_like\".to_string(), SourceWaterProfile::zero());\n    state.source_water_catalog.insert(\n        \"custom\".to_string(),\n        SourceWaterProfile {\n            temperature_c: 25.0,\n            ammonia_mg_n_per_l: 0.0,\n            nitrite_mg_n_per_l: 0.0,\n            nitrate_mg_n_per_l: 10.0,\n            phosphate_mg_p_per_l: 0.5,\n            dic_mg_c_per_l: 15.0,\n            doc_mg_c_per_l: 0.0,\n            don_mg_n_per_l: 0.0,\n            alkalinity_meq_per_l: 2.0,\n            calcium_mg_per_l: 30.0,\n            magnesium_mg_per_l: 8.0,\n            sodium_mg_per_l: 12.0,\n            potassium_mg_per_l: 3.0,\n            bicarbonate_mg_per_l: 80.0,\n            chloride_mg_per_l: 15.0,\n            sulfate_mg_per_l: 10.0,\n        },\n    );\n    state.process_params = ProcessParams {\n        mineralization_rate_per_day: 0.2,\n        nitrification_vmax: 0.1,\n        reaeration_kla_base: 0.5,\n        aeration_kla_boost: 1.1,\n        background_bod_mg_o2_per_g_biomass_per_hour: 0.07,\n        plant_photosynthesis_o2_mg_per_g_per_hour: 0.22,\n        respiration_dic_rate_mg_c_per_g_per_hour: 0.09,\n        photosynthesis_dic_rate_mg_c_per_g_per_hour: 0.14,\n        k_surface_w_per_m2_k: 12.0,\n        k_wall_w_per_m2_k: 6.0,\n    };\n\n    let mut engine = Engine::from_parts(state, vec![]);\n    engine.step_hours(1)?;\n\n    let save = SaveFile::from_engine(&engine);\n    let json = save.to_json_pretty()?;\n    let restored = SaveFile::from_json(&json)?;\n    let restored_engine = restored.into_engine();\n\n    // Source water catalog and process params must survive roundtrip\n    assert_eq!(\n        engine.full_state().source_water_catalog,\n        restored_engine.full_state().source_water_catalog\n    );\n    assert_eq!(\n        engine.full_state().process_params,\n        restored_engine.full_state().process_params\n    );\n    assert_eq!(\n        engine.full_state().hardware.heater.last_output_w,\n        restored_engine.full_state().hardware.heater.last_output_w\n    );\n    assert_eq!(engine.full_state(), restored_engine.full_state());\n\n    Ok(())\n}\n\n#[test]\nfn save_load_resume_determinism() -> Result<(), tank_core::SimError> {\n    // Run 240 hours, save, load, run 480 more vs uninterrupted 720\n    let mut engine_continuous = Engine::new(SimSeed(77));\n    engine_continuous.step_hours(720)?;\n\n    let mut engine_split = Engine::new(SimSeed(77));\n    engine_split.step_hours(240)?;\n\n    let save = SaveFile::from_engine(&engine_split);\n    let json = save.to_json_pretty()?;\n    let restored = SaveFile::from_json(&json)?;\n    let mut engine_resumed = restored.into_engine();\n    engine_resumed.step_hours(480)?;\n\n    assert_eq!(\n        engine_continuous.full_state(),\n        engine_resumed.full_state(),\n        \"Save/load/resume must produce identical state to uninterrupted run\"\n    );\n\n    Ok(())\n}\n","numLines":117,"startLine":1,"totalLines":117}}}
