{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CBkUwU24woiH2yo2eh72PW","type":"tool_result","content":"     1→use tank_core::{Engine, SimSeed, SimulationEngine};\n     2→\n     3→#[test]\n     4→fn determinism_basic() -> Result<(), tank_core::SimError> {\n     5→    let mut left = Engine::new(SimSeed(7));\n     6→    let mut right = Engine::new(SimSeed(7));\n     7→\n     8→    left.step_hours(24)?;\n     9→    right.step_hours(24)?;\n    10→\n    11→    assert_eq!(left.snapshot(), right.snapshot());\n    12→    assert_eq!(left.full_state(), right.full_state());\n    13→\n    14→    Ok(())\n    15→}\n    16→"}]},"parent_tool_use_id":null,"session_id":"86001031-e08b-4ab4-a078-b934bda46f61","uuid":"1db0ae97-acba-4332-b0a1-29643da5c19c","tool_use_result":{"type":"text","file":{"filePath":"/root/tank-simulation/crates/tank_core/tests/determinism.rs","content":"use tank_core::{Engine, SimSeed, SimulationEngine};\n\n#[test]\nfn determinism_basic() -> Result<(), tank_core::SimError> {\n    let mut left = Engine::new(SimSeed(7));\n    let mut right = Engine::new(SimSeed(7));\n\n    left.step_hours(24)?;\n    right.step_hours(24)?;\n\n    assert_eq!(left.snapshot(), right.snapshot());\n    assert_eq!(left.full_state(), right.full_state());\n\n    Ok(())\n}\n","numLines":16,"startLine":1,"totalLines":16}}}
