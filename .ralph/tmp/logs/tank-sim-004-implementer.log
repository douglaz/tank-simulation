{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0124hiqhfbSWyMkQtqUsuNCu","type":"tool_result","content":"     1→use crate::types::TankState;\n     2→\n     3→/// Result of one hourly nitrogen cycle step, carrying coupling values\n     4→/// that downstream systems (DO, chemistry) need.\n     5→#[derive(Debug, Clone, Copy, Default)]\n     6→pub struct NitrogenCycleOutput {\n     7→    /// Total mg N oxidized to nitrate this tick (AOB + NOB + comammox pathway).\n     8→    pub total_mg_n_nitrified: f64,\n     9→}\n    10→\n    11→/// Monod-style environmental factors shared across guilds.\n    12→struct EnvFactors {\n    13→    f_temp: f64,\n    14→    f_ph: f64,\n    15→    maturity_factor: f64,\n    16→}\n    17→\n    18→fn safe_rate(v: f64) -> f64 {\n    19→    if v.is_finite() { v.max(0.0) } else { 0.0 }\n    20→}\n    21→\n    22→/// Runs the full nitrogen-cycle phase for one hourly tick.\n    23→///\n    24→/// Order: feed leaching -> detritus breakdown/mineralization -> nitrification + guild growth/decay.\n    25→///\n    26→/// Returns coupling values for downstream DO and alkalinity systems.\n    27→pub fn step_nitrogen_cycle(state: &mut TankState) -> NitrogenCycleOutput {\n    28→    let volume_l = state.geometry.water_volume_l();\n    29→    if volume_l <= f64::EPSILON {\n    30→        return NitrogenCycleOutput::default();\n    31→    }\n    32→\n    33→    let pp = &state.process_params;\n    34→\n    35→    // ---- 1. Feed leaching: particulate -> fine detritus ----\n    36→    let leach_rate = safe_rate(pp.feed_leach_rate_per_hour);\n    37→    let leached = (state.detritus.particulate_organics_g_total * leach_rate)\n    38→        .min(state.detritus.particulate_organics_g_total);\n    39→    state.detritus.particulate_organics_g_total -= leached;\n    40→    state.detritus.fine_detritus_g_total += leached;\n    41→\n    42→    // ---- 2. Fine detritus dissolution: fine detritus -> dissolved organic pools ----\n    43→    let diss_rate = safe_rate(pp.fine_detritus_dissolution_rate_per_hour);\n    44→    let dissolved = (state.detritus.fine_detritus_g_total * diss_rate)\n    45→        .min(state.detritus.fine_detritus_g_total);\n    46→    state.detritus.fine_detritus_g_total -= dissolved;\n    47→    // dissolved mass (g) -> mg for dissolved pools: 1 g = 1000 mg\n    48→    // Split into DOC and DON using N:C ratio\n    49→    let n_to_c = safe_rate(pp.feed_n_to_c_ratio);\n    50→    let doc_mg = dissolved * 1000.0 / (1.0 + n_to_c); // carbon fraction\n    51→    let don_mg = doc_mg * n_to_c; // nitrogen fraction\n    52→    state.water.dissolved_organic_carbon_mg_c_total += doc_mg;\n    53→    state.water.dissolved_organic_nitrogen_mg_n_total += don_mg;\n    54→    // Track flow through dissolved_feed_residue (bookkeeping, decremented by mineralization)\n    55→    state.detritus.dissolved_feed_residue_g_total += dissolved;\n    56→\n    57→    // ---- 3. Decomposer mineralization: DOC/DON -> TAN ----\n    58→    let decomposer_biomass = state.microbe.decomposer_biomass_g;\n    59→    let doc_total = state.water.dissolved_organic_carbon_mg_c_total;\n    60→    let don_total = state.water.dissolved_organic_nitrogen_mg_n_total;\n    61→    let do_total = state.water.dissolved_oxygen_mg_total;\n    62→\n    63→    // Environmental factors for decomposers\n    64→    let temp = state.water.temperature_c;\n    65→    let f_temp_decomp = temperature_factor(temp);\n    66→    let f_do_decomp = do_total / (do_total + 2.0); // half-sat ~2 mg total\n    67→\n    68→    let decomp_vmax = safe_rate(pp.decomposer_vmax_per_hour);\n    69→    let k_doc = pp.decomposer_k_doc_mg.max(0.01);\n    70→    let monod_doc = doc_total / (doc_total + k_doc);\n    71→\n    72→    let potential_doc_consumed_mg = decomp_vmax * decomposer_biomass * 1000.0 // g->mg conversion for biomass effect\n    73→        * f_temp_decomp * f_do_decomp * monod_doc;\n    74→    let potential_doc_consumed_mg = safe_rate(potential_doc_consumed_mg);\n    75→\n    76→    // Clamp: cannot consume more DOC than exists\n    77→    let doc_consumed_mg = potential_doc_consumed_mg.min(doc_total);\n    78→    // Proportional DON consumed\n    79→    let don_consumed_mg = if doc_total > f64::EPSILON {\n    80→        doc_consumed_mg * (don_total / doc_total)\n    81→    } else {\n    82→        0.0\n    83→    };\n    84→    let don_consumed_mg = don_consumed_mg.min(don_total);\n    85→\n    86→    state.water.dissolved_organic_carbon_mg_c_total -= doc_consumed_mg;\n    87→    state.water.dissolved_organic_nitrogen_mg_n_total -= don_consumed_mg;\n    88→    // Mineralized DON becomes TAN\n    89→    state.water.ammonia_total_mg_n_total += don_consumed_mg;\n    90→    // Track residue pool depletion\n    91→    let residue_consumed_g = doc_consumed_mg / 1000.0 * (1.0 + n_to_c);\n    92→    state.detritus.dissolved_feed_residue_g_total =\n    93→        (state.detritus.dissolved_feed_residue_g_total - residue_consumed_g).max(0.0);\n    94→\n    95→    // Decomposer growth/decay\n    96→    let decomp_growth = safe_rate(pp.decomposer_growth_yield) * doc_consumed_mg / 1000.0; // mg->g\n    97→    let decomp_decay = safe_rate(pp.decomposer_decay_rate_per_hour) * decomposer_biomass;\n    98→    state.microbe.decomposer_biomass_g =\n    99→        (state.microbe.decomposer_biomass_g + decomp_growth - decomp_decay).max(0.0);\n   100→\n   101→    // ---- 4. Nitrification: TAN -> nitrite -> nitrate (+ comammox TAN -> nitrate) ----\n   102→    let env = compute_env_factors(state);\n   103→\n   104→    // 4a. AOB: TAN -> nitrite\n   105→    let aob_potential = monod_rate(\n   106→        safe_rate(pp.aob_vmax_mg_n_per_g_per_hour),\n   107→        state.microbe.ammonia_oxidizer_biomass_g,\n   108→        env.maturity_factor,\n   109→        env.f_temp,\n   110→        env.f_ph,\n   111→        state.water.dissolved_oxygen_mg_total / (state.water.dissolved_oxygen_mg_total + pp.aob_k_do_mg.max(0.01)),\n   112→        state.water.ammonia_total_mg_n_total,\n   113→        pp.aob_k_tan_mg.max(0.01),\n   114→    );\n   115→    // Oxygen limitation: each mg N needs 3.43 mg O2 for TAN->nitrite step\n   116→    let o2_for_aob = 3.43;\n   117→    let aob_o2_limited = if o2_for_aob > 0.0 {\n   118→        state.water.dissolved_oxygen_mg_total / o2_for_aob\n   119→    } else {\n   120→        f64::MAX\n   121→    };\n   122→    let aob_rate = safe_rate(aob_potential)\n   123→        .min(state.water.ammonia_total_mg_n_total)\n   124→        .min(aob_o2_limited);\n   125→\n   126→    // 4b. Comammox: TAN -> nitrate directly (lower vmax)\n   127→    let comammox_vmax = safe_rate(pp.aob_vmax_mg_n_per_g_per_hour * pp.comammox_vmax_fraction);\n   128→    let comammox_potential = monod_rate(\n   129→        comammox_vmax,\n   130→        state.microbe.comammox_biomass_g,\n   131→        env.maturity_factor,\n   132→        env.f_temp,\n   133→        env.f_ph,\n   134→        state.water.dissolved_oxygen_mg_total / (state.water.dissolved_oxygen_mg_total + pp.comammox_k_do_mg.max(0.01)),\n   135→        state.water.ammonia_total_mg_n_total,\n   136→        pp.comammox_k_tan_mg.max(0.01),\n   137→    );\n   138→    let o2_for_comammox = pp.o2_per_mg_n_nitrified; // full 4.57 for TAN->NO3\n   139→    let comammox_o2_limited = if o2_for_comammox > 0.0 {\n   140→        state.water.dissolved_oxygen_mg_total / o2_for_comammox\n   141→    } else {\n   142→        f64::MAX\n   143→    };\n   144→    // Comammox + AOB compete for TAN; cap total TAN consumed\n   145→    let tan_available_for_comammox = (state.water.ammonia_total_mg_n_total - aob_rate).max(0.0);\n   146→    let comammox_rate = safe_rate(comammox_potential)\n   147→        .min(tan_available_for_comammox)\n   148→        .min(comammox_o2_limited);\n   149→\n   150→    // Apply AOB + comammox TAN consumption\n   151→    let total_tan_consumed = aob_rate + comammox_rate;\n   152→    state.water.ammonia_total_mg_n_total =\n   153→        (state.water.ammonia_total_mg_n_total - total_tan_consumed).max(0.0);\n   154→    // AOB produces nitrite\n   155→    state.water.nitrite_mg_n_total += aob_rate;\n   156→    // Comammox produces nitrate directly\n   157→    state.water.nitrate_mg_n_total += comammox_rate;\n   158→\n   159→    // O2 consumed so far by AOB and comammox\n   160→    let o2_consumed_aob = aob_rate * o2_for_aob;\n   161→    let o2_consumed_comammox = comammox_rate * o2_for_comammox;\n   162→    state.water.dissolved_oxygen_mg_total =\n   163→        (state.water.dissolved_oxygen_mg_total - o2_consumed_aob - o2_consumed_comammox).max(0.0);\n   164→\n   165→    // 4c. NOB: nitrite -> nitrate\n   166→    let nob_potential = monod_rate(\n   167→        safe_rate(pp.nob_vmax_mg_n_per_g_per_hour),\n   168→        state.microbe.nitrite_oxidizer_biomass_g,\n   169→        env.maturity_factor,\n   170→        env.f_temp,\n   171→        env.f_ph,\n   172→        state.water.dissolved_oxygen_mg_total / (state.water.dissolved_oxygen_mg_total + pp.nob_k_do_mg.max(0.01)),\n   173→        state.water.nitrite_mg_n_total,\n   174→        pp.nob_k_nitrite_mg.max(0.01),\n   175→    );\n   176→    // O2 for nitrite->nitrate: 4.57 - 3.43 = 1.14 mg O2 per mg N\n   177→    let o2_for_nob = 1.14;\n   178→    let nob_o2_limited = if o2_for_nob > 0.0 {\n   179→        state.water.dissolved_oxygen_mg_total / o2_for_nob\n   180→    } else {\n   181→        f64::MAX\n   182→    };\n   183→    let nob_rate = safe_rate(nob_potential)\n   184→        .min(state.water.nitrite_mg_n_total)\n   185→        .min(nob_o2_limited);\n   186→\n   187→    state.water.nitrite_mg_n_total = (state.water.nitrite_mg_n_total - nob_rate).max(0.0);\n   188→    state.water.nitrate_mg_n_total += nob_rate;\n   189→    let o2_consumed_nob = nob_rate * o2_for_nob;\n   190→    state.water.dissolved_oxygen_mg_total =\n   191→        (state.water.dissolved_oxygen_mg_total - o2_consumed_nob).max(0.0);\n   192→\n   193→    // Total N fully nitrified to nitrate (for alkalinity coupling)\n   194→    // AOB only takes TAN -> nitrite, NOB takes nitrite -> nitrate, comammox takes TAN -> nitrate\n   195→    // Full pathway N: nob_rate (came from AOB path) + comammox_rate\n   196→    let total_mg_n_nitrified = nob_rate + comammox_rate;\n   197→\n   198→    // ---- 5. Guild growth and decay ----\n   199→    // AOB growth from TAN oxidized\n   200→    let aob_growth = safe_rate(pp.aob_growth_yield) * aob_rate;\n   201→    let aob_decay = safe_rate(pp.aob_decay_rate_per_hour) * state.microbe.ammonia_oxidizer_biomass_g;\n   202→    state.microbe.ammonia_oxidizer_biomass_g =\n   203→        (state.microbe.ammonia_oxidizer_biomass_g + aob_growth - aob_decay).max(0.0);\n   204→\n   205→    // NOB growth from nitrite oxidized\n   206→    let nob_growth = safe_rate(pp.nob_growth_yield) * nob_rate;\n   207→    let nob_decay = safe_rate(pp.nob_decay_rate_per_hour) * state.microbe.nitrite_oxidizer_biomass_g;\n   208→    state.microbe.nitrite_oxidizer_biomass_g =\n   209→        (state.microbe.nitrite_oxidizer_biomass_g + nob_growth - nob_decay).max(0.0);\n   210→\n   211→    // Comammox growth from TAN fully oxidized\n   212→    let comammox_growth = safe_rate(pp.comammox_growth_yield) * comammox_rate;\n   213→    let comammox_decay = safe_rate(pp.comammox_decay_rate_per_hour) * state.microbe.comammox_biomass_g;\n   214→    state.microbe.comammox_biomass_g =\n   215→        (state.microbe.comammox_biomass_g + comammox_growth - comammox_decay).max(0.0);\n   216→\n   217→    // ---- 6. Alkalinity and DIC coupling from nitrification ----\n   218→    let alk_consumed = total_mg_n_nitrified * safe_rate(pp.alkalinity_meq_per_mg_n_nitrified);\n   219→    state.water.alkalinity_meq_total = (state.water.alkalinity_meq_total - alk_consumed).max(0.0);\n   220→\n   221→    // Nitrification is a chemoautotrophic process that produces some DIC fixation\n   222→    // but for simplicity we model it as a net DIC producer via mineralization pathway above.\n   223→\n   224→    NitrogenCycleOutput {\n   225→        total_mg_n_nitrified,\n   226→    }\n   227→}\n   228→\n   229→/// Temperature factor: peaks around 25-30°C, drops off at extremes.\n   230→fn temperature_factor(temp_c: f64) -> f64 {\n   231→    // Bell-shaped factor peaking at 28°C with a half-width of ~10°C\n   232→    let opt = 28.0;\n   233→    let sigma = 10.0;\n   234→    let diff = temp_c - opt;\n   235→    (-(diff * diff) / (2.0 * sigma * sigma)).exp()\n   236→}\n   237→\n   238→/// pH factor: nitrifiers prefer 7-8, reduced at extremes.\n   239→fn ph_factor(ph: f64) -> f64 {\n   240→    let opt = 7.5;\n   241→    let sigma = 1.5;\n   242→    let diff = ph - opt;\n   243→    (-(diff * diff) / (2.0 * sigma * sigma)).exp()\n   244→}\n   245→\n   246→fn compute_env_factors(state: &TankState) -> EnvFactors {\n   247→    let f_temp = temperature_factor(state.water.temperature_c);\n   248→    let f_ph = ph_factor(state.water.ph);\n   249→\n   250→    // Maturity factor: immature filters slow nitrification\n   251→    // Use filter_state.biofilter_maturity_index directly\n   252→    let maturity_factor = state.filter_state.biofilter_maturity_index.clamp(0.05, 1.0);\n   253→\n   254→    EnvFactors {\n   255→        f_temp,\n   256→        f_ph,\n   257→        maturity_factor,\n   258→    }\n   259→}\n   260→\n   261→/// Monod-style rate: vmax * biomass * maturity * f_temp * f_ph * f_do_monod * S/(K+S)\n   262→fn monod_rate(\n   263→    vmax: f64,\n   264→    biomass_g: f64,\n   265→    maturity_factor: f64,\n   266→    f_temp: f64,\n   267→    f_ph: f64,\n   268→    f_do_monod: f64,\n   269→    substrate: f64,\n   270→    k_substrate: f64,\n   271→) -> f64 {\n   272→    let monod = substrate / (substrate + k_substrate);\n   273→    safe_rate(vmax * biomass_g * maturity_factor * f_temp * f_ph * f_do_monod * monod)\n   274→}\n   275→\n   276→/// Daily biofilter maturity update. Called every 24 ticks.\n   277→/// Recomputes `filter_state.biofilter_maturity_index` from guild biomass.\n   278→pub fn update_daily_biofilter_maturity(state: &mut TankState) -> f64 {\n   279→    let prev = state.filter_state.biofilter_maturity_index;\n   280→\n   281→    // Capacity reference: a \"mature\" biofilter might have ~0.5g total nitrifier biomass\n   282→    let capacity_g = 0.5;\n   283→    let total_nitrifier_g = state.microbe.ammonia_oxidizer_biomass_g\n   284→        + state.microbe.nitrite_oxidizer_biomass_g\n   285→        + state.microbe.comammox_biomass_g;\n   286→    let raw_maturity = (total_nitrifier_g / capacity_g).clamp(0.0, 1.0);\n   287→\n   288→    // Smooth towards raw_maturity\n   289→    let alpha = 0.1;\n   290→    let new_maturity = (prev + alpha * (raw_maturity - prev)).clamp(0.0, 1.0);\n   291→    state.filter_state.biofilter_maturity_index = new_maturity;\n   292→\n   293→    new_maturity - prev\n   294→}\n   295→"}]},"parent_tool_use_id":null,"session_id":"af270d75-fd6d-4e84-9953-cdba41291cd7","uuid":"a7c5e477-01b5-4758-9d71-7797f407bc30","tool_use_result":{"type":"text","file":{"filePath":"/root/tank-simulation/crates/tank_core/src/systems/nitrogen_cycle.rs","content":"use crate::types::TankState;\n\n/// Result of one hourly nitrogen cycle step, carrying coupling values\n/// that downstream systems (DO, chemistry) need.\n#[derive(Debug, Clone, Copy, Default)]\npub struct NitrogenCycleOutput {\n    /// Total mg N oxidized to nitrate this tick (AOB + NOB + comammox pathway).\n    pub total_mg_n_nitrified: f64,\n}\n\n/// Monod-style environmental factors shared across guilds.\nstruct EnvFactors {\n    f_temp: f64,\n    f_ph: f64,\n    maturity_factor: f64,\n}\n\nfn safe_rate(v: f64) -> f64 {\n    if v.is_finite() { v.max(0.0) } else { 0.0 }\n}\n\n/// Runs the full nitrogen-cycle phase for one hourly tick.\n///\n/// Order: feed leaching -> detritus breakdown/mineralization -> nitrification + guild growth/decay.\n///\n/// Returns coupling values for downstream DO and alkalinity systems.\npub fn step_nitrogen_cycle(state: &mut TankState) -> NitrogenCycleOutput {\n    let volume_l = state.geometry.water_volume_l();\n    if volume_l <= f64::EPSILON {\n        return NitrogenCycleOutput::default();\n    }\n\n    let pp = &state.process_params;\n\n    // ---- 1. Feed leaching: particulate -> fine detritus ----\n    let leach_rate = safe_rate(pp.feed_leach_rate_per_hour);\n    let leached = (state.detritus.particulate_organics_g_total * leach_rate)\n        .min(state.detritus.particulate_organics_g_total);\n    state.detritus.particulate_organics_g_total -= leached;\n    state.detritus.fine_detritus_g_total += leached;\n\n    // ---- 2. Fine detritus dissolution: fine detritus -> dissolved organic pools ----\n    let diss_rate = safe_rate(pp.fine_detritus_dissolution_rate_per_hour);\n    let dissolved = (state.detritus.fine_detritus_g_total * diss_rate)\n        .min(state.detritus.fine_detritus_g_total);\n    state.detritus.fine_detritus_g_total -= dissolved;\n    // dissolved mass (g) -> mg for dissolved pools: 1 g = 1000 mg\n    // Split into DOC and DON using N:C ratio\n    let n_to_c = safe_rate(pp.feed_n_to_c_ratio);\n    let doc_mg = dissolved * 1000.0 / (1.0 + n_to_c); // carbon fraction\n    let don_mg = doc_mg * n_to_c; // nitrogen fraction\n    state.water.dissolved_organic_carbon_mg_c_total += doc_mg;\n    state.water.dissolved_organic_nitrogen_mg_n_total += don_mg;\n    // Track flow through dissolved_feed_residue (bookkeeping, decremented by mineralization)\n    state.detritus.dissolved_feed_residue_g_total += dissolved;\n\n    // ---- 3. Decomposer mineralization: DOC/DON -> TAN ----\n    let decomposer_biomass = state.microbe.decomposer_biomass_g;\n    let doc_total = state.water.dissolved_organic_carbon_mg_c_total;\n    let don_total = state.water.dissolved_organic_nitrogen_mg_n_total;\n    let do_total = state.water.dissolved_oxygen_mg_total;\n\n    // Environmental factors for decomposers\n    let temp = state.water.temperature_c;\n    let f_temp_decomp = temperature_factor(temp);\n    let f_do_decomp = do_total / (do_total + 2.0); // half-sat ~2 mg total\n\n    let decomp_vmax = safe_rate(pp.decomposer_vmax_per_hour);\n    let k_doc = pp.decomposer_k_doc_mg.max(0.01);\n    let monod_doc = doc_total / (doc_total + k_doc);\n\n    let potential_doc_consumed_mg = decomp_vmax * decomposer_biomass * 1000.0 // g->mg conversion for biomass effect\n        * f_temp_decomp * f_do_decomp * monod_doc;\n    let potential_doc_consumed_mg = safe_rate(potential_doc_consumed_mg);\n\n    // Clamp: cannot consume more DOC than exists\n    let doc_consumed_mg = potential_doc_consumed_mg.min(doc_total);\n    // Proportional DON consumed\n    let don_consumed_mg = if doc_total > f64::EPSILON {\n        doc_consumed_mg * (don_total / doc_total)\n    } else {\n        0.0\n    };\n    let don_consumed_mg = don_consumed_mg.min(don_total);\n\n    state.water.dissolved_organic_carbon_mg_c_total -= doc_consumed_mg;\n    state.water.dissolved_organic_nitrogen_mg_n_total -= don_consumed_mg;\n    // Mineralized DON becomes TAN\n    state.water.ammonia_total_mg_n_total += don_consumed_mg;\n    // Track residue pool depletion\n    let residue_consumed_g = doc_consumed_mg / 1000.0 * (1.0 + n_to_c);\n    state.detritus.dissolved_feed_residue_g_total =\n        (state.detritus.dissolved_feed_residue_g_total - residue_consumed_g).max(0.0);\n\n    // Decomposer growth/decay\n    let decomp_growth = safe_rate(pp.decomposer_growth_yield) * doc_consumed_mg / 1000.0; // mg->g\n    let decomp_decay = safe_rate(pp.decomposer_decay_rate_per_hour) * decomposer_biomass;\n    state.microbe.decomposer_biomass_g =\n        (state.microbe.decomposer_biomass_g + decomp_growth - decomp_decay).max(0.0);\n\n    // ---- 4. Nitrification: TAN -> nitrite -> nitrate (+ comammox TAN -> nitrate) ----\n    let env = compute_env_factors(state);\n\n    // 4a. AOB: TAN -> nitrite\n    let aob_potential = monod_rate(\n        safe_rate(pp.aob_vmax_mg_n_per_g_per_hour),\n        state.microbe.ammonia_oxidizer_biomass_g,\n        env.maturity_factor,\n        env.f_temp,\n        env.f_ph,\n        state.water.dissolved_oxygen_mg_total / (state.water.dissolved_oxygen_mg_total + pp.aob_k_do_mg.max(0.01)),\n        state.water.ammonia_total_mg_n_total,\n        pp.aob_k_tan_mg.max(0.01),\n    );\n    // Oxygen limitation: each mg N needs 3.43 mg O2 for TAN->nitrite step\n    let o2_for_aob = 3.43;\n    let aob_o2_limited = if o2_for_aob > 0.0 {\n        state.water.dissolved_oxygen_mg_total / o2_for_aob\n    } else {\n        f64::MAX\n    };\n    let aob_rate = safe_rate(aob_potential)\n        .min(state.water.ammonia_total_mg_n_total)\n        .min(aob_o2_limited);\n\n    // 4b. Comammox: TAN -> nitrate directly (lower vmax)\n    let comammox_vmax = safe_rate(pp.aob_vmax_mg_n_per_g_per_hour * pp.comammox_vmax_fraction);\n    let comammox_potential = monod_rate(\n        comammox_vmax,\n        state.microbe.comammox_biomass_g,\n        env.maturity_factor,\n        env.f_temp,\n        env.f_ph,\n        state.water.dissolved_oxygen_mg_total / (state.water.dissolved_oxygen_mg_total + pp.comammox_k_do_mg.max(0.01)),\n        state.water.ammonia_total_mg_n_total,\n        pp.comammox_k_tan_mg.max(0.01),\n    );\n    let o2_for_comammox = pp.o2_per_mg_n_nitrified; // full 4.57 for TAN->NO3\n    let comammox_o2_limited = if o2_for_comammox > 0.0 {\n        state.water.dissolved_oxygen_mg_total / o2_for_comammox\n    } else {\n        f64::MAX\n    };\n    // Comammox + AOB compete for TAN; cap total TAN consumed\n    let tan_available_for_comammox = (state.water.ammonia_total_mg_n_total - aob_rate).max(0.0);\n    let comammox_rate = safe_rate(comammox_potential)\n        .min(tan_available_for_comammox)\n        .min(comammox_o2_limited);\n\n    // Apply AOB + comammox TAN consumption\n    let total_tan_consumed = aob_rate + comammox_rate;\n    state.water.ammonia_total_mg_n_total =\n        (state.water.ammonia_total_mg_n_total - total_tan_consumed).max(0.0);\n    // AOB produces nitrite\n    state.water.nitrite_mg_n_total += aob_rate;\n    // Comammox produces nitrate directly\n    state.water.nitrate_mg_n_total += comammox_rate;\n\n    // O2 consumed so far by AOB and comammox\n    let o2_consumed_aob = aob_rate * o2_for_aob;\n    let o2_consumed_comammox = comammox_rate * o2_for_comammox;\n    state.water.dissolved_oxygen_mg_total =\n        (state.water.dissolved_oxygen_mg_total - o2_consumed_aob - o2_consumed_comammox).max(0.0);\n\n    // 4c. NOB: nitrite -> nitrate\n    let nob_potential = monod_rate(\n        safe_rate(pp.nob_vmax_mg_n_per_g_per_hour),\n        state.microbe.nitrite_oxidizer_biomass_g,\n        env.maturity_factor,\n        env.f_temp,\n        env.f_ph,\n        state.water.dissolved_oxygen_mg_total / (state.water.dissolved_oxygen_mg_total + pp.nob_k_do_mg.max(0.01)),\n        state.water.nitrite_mg_n_total,\n        pp.nob_k_nitrite_mg.max(0.01),\n    );\n    // O2 for nitrite->nitrate: 4.57 - 3.43 = 1.14 mg O2 per mg N\n    let o2_for_nob = 1.14;\n    let nob_o2_limited = if o2_for_nob > 0.0 {\n        state.water.dissolved_oxygen_mg_total / o2_for_nob\n    } else {\n        f64::MAX\n    };\n    let nob_rate = safe_rate(nob_potential)\n        .min(state.water.nitrite_mg_n_total)\n        .min(nob_o2_limited);\n\n    state.water.nitrite_mg_n_total = (state.water.nitrite_mg_n_total - nob_rate).max(0.0);\n    state.water.nitrate_mg_n_total += nob_rate;\n    let o2_consumed_nob = nob_rate * o2_for_nob;\n    state.water.dissolved_oxygen_mg_total =\n        (state.water.dissolved_oxygen_mg_total - o2_consumed_nob).max(0.0);\n\n    // Total N fully nitrified to nitrate (for alkalinity coupling)\n    // AOB only takes TAN -> nitrite, NOB takes nitrite -> nitrate, comammox takes TAN -> nitrate\n    // Full pathway N: nob_rate (came from AOB path) + comammox_rate\n    let total_mg_n_nitrified = nob_rate + comammox_rate;\n\n    // ---- 5. Guild growth and decay ----\n    // AOB growth from TAN oxidized\n    let aob_growth = safe_rate(pp.aob_growth_yield) * aob_rate;\n    let aob_decay = safe_rate(pp.aob_decay_rate_per_hour) * state.microbe.ammonia_oxidizer_biomass_g;\n    state.microbe.ammonia_oxidizer_biomass_g =\n        (state.microbe.ammonia_oxidizer_biomass_g + aob_growth - aob_decay).max(0.0);\n\n    // NOB growth from nitrite oxidized\n    let nob_growth = safe_rate(pp.nob_growth_yield) * nob_rate;\n    let nob_decay = safe_rate(pp.nob_decay_rate_per_hour) * state.microbe.nitrite_oxidizer_biomass_g;\n    state.microbe.nitrite_oxidizer_biomass_g =\n        (state.microbe.nitrite_oxidizer_biomass_g + nob_growth - nob_decay).max(0.0);\n\n    // Comammox growth from TAN fully oxidized\n    let comammox_growth = safe_rate(pp.comammox_growth_yield) * comammox_rate;\n    let comammox_decay = safe_rate(pp.comammox_decay_rate_per_hour) * state.microbe.comammox_biomass_g;\n    state.microbe.comammox_biomass_g =\n        (state.microbe.comammox_biomass_g + comammox_growth - comammox_decay).max(0.0);\n\n    // ---- 6. Alkalinity and DIC coupling from nitrification ----\n    let alk_consumed = total_mg_n_nitrified * safe_rate(pp.alkalinity_meq_per_mg_n_nitrified);\n    state.water.alkalinity_meq_total = (state.water.alkalinity_meq_total - alk_consumed).max(0.0);\n\n    // Nitrification is a chemoautotrophic process that produces some DIC fixation\n    // but for simplicity we model it as a net DIC producer via mineralization pathway above.\n\n    NitrogenCycleOutput {\n        total_mg_n_nitrified,\n    }\n}\n\n/// Temperature factor: peaks around 25-30°C, drops off at extremes.\nfn temperature_factor(temp_c: f64) -> f64 {\n    // Bell-shaped factor peaking at 28°C with a half-width of ~10°C\n    let opt = 28.0;\n    let sigma = 10.0;\n    let diff = temp_c - opt;\n    (-(diff * diff) / (2.0 * sigma * sigma)).exp()\n}\n\n/// pH factor: nitrifiers prefer 7-8, reduced at extremes.\nfn ph_factor(ph: f64) -> f64 {\n    let opt = 7.5;\n    let sigma = 1.5;\n    let diff = ph - opt;\n    (-(diff * diff) / (2.0 * sigma * sigma)).exp()\n}\n\nfn compute_env_factors(state: &TankState) -> EnvFactors {\n    let f_temp = temperature_factor(state.water.temperature_c);\n    let f_ph = ph_factor(state.water.ph);\n\n    // Maturity factor: immature filters slow nitrification\n    // Use filter_state.biofilter_maturity_index directly\n    let maturity_factor = state.filter_state.biofilter_maturity_index.clamp(0.05, 1.0);\n\n    EnvFactors {\n        f_temp,\n        f_ph,\n        maturity_factor,\n    }\n}\n\n/// Monod-style rate: vmax * biomass * maturity * f_temp * f_ph * f_do_monod * S/(K+S)\nfn monod_rate(\n    vmax: f64,\n    biomass_g: f64,\n    maturity_factor: f64,\n    f_temp: f64,\n    f_ph: f64,\n    f_do_monod: f64,\n    substrate: f64,\n    k_substrate: f64,\n) -> f64 {\n    let monod = substrate / (substrate + k_substrate);\n    safe_rate(vmax * biomass_g * maturity_factor * f_temp * f_ph * f_do_monod * monod)\n}\n\n/// Daily biofilter maturity update. Called every 24 ticks.\n/// Recomputes `filter_state.biofilter_maturity_index` from guild biomass.\npub fn update_daily_biofilter_maturity(state: &mut TankState) -> f64 {\n    let prev = state.filter_state.biofilter_maturity_index;\n\n    // Capacity reference: a \"mature\" biofilter might have ~0.5g total nitrifier biomass\n    let capacity_g = 0.5;\n    let total_nitrifier_g = state.microbe.ammonia_oxidizer_biomass_g\n        + state.microbe.nitrite_oxidizer_biomass_g\n        + state.microbe.comammox_biomass_g;\n    let raw_maturity = (total_nitrifier_g / capacity_g).clamp(0.0, 1.0);\n\n    // Smooth towards raw_maturity\n    let alpha = 0.1;\n    let new_maturity = (prev + alpha * (raw_maturity - prev)).clamp(0.0, 1.0);\n    state.filter_state.biofilter_maturity_index = new_maturity;\n\n    new_maturity - prev\n}\n","numLines":295,"startLine":1,"totalLines":295}}}
