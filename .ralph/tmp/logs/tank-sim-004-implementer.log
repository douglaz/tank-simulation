{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GrAidxuRYxt9FFMW1U6UPC","type":"tool_result","content":"     1→use tank_core::SimSeed;\n     2→\n     3→#[test]\n     4→fn nano_cycle_materializes_correctly() {\n     5→    let state = tank_scenarios::seeded_state(SimSeed(42), \"nano_cycle\")\n     6→        .expect(\"nano_cycle should materialize\");\n     7→\n     8→    // Geometry from scenario: 30×20, 20cm tall, 18cm filled\n     9→    assert!((state.geometry.length_cm - 30.0).abs() < f64::EPSILON);\n    10→    assert!((state.geometry.width_cm - 20.0).abs() < f64::EPSILON);\n    11→    assert!((state.geometry.height_cm - 20.0).abs() < f64::EPSILON);\n    12→    assert!((state.geometry.fill_height_cm - 18.0).abs() < f64::EPSILON);\n    13→\n    14→    // Volume: 30 * 20 * 18 / 1000 = 10.8L\n    15→    let expected_vol = 30.0 * 20.0 * 18.0 / 1000.0;\n    16→    let actual_vol = state.geometry.water_volume_l();\n    17→    assert!(\n    18→        (actual_vol - expected_vol).abs() < 0.01,\n    19→        \"Volume should be {expected_vol}, got {actual_vol}\"\n    20→    );\n    21→\n    22→    // Ambient from scenario\n    23→    assert!((state.environment.ambient_temp_c - 24.0).abs() < f64::EPSILON);\n    24→\n    25→    // Meta\n    26→    assert_eq!(state.meta.scenario_id.as_deref(), Some(\"nano_cycle\"));\n    27→    assert_eq!(state.meta.notes.as_deref(), Some(\"Nano Cycle\"));\n    28→\n    29→    // Source water catalog should contain all presets\n    30→    assert!(state.source_water_catalog.contains_key(\"soft_acidic\"));\n    31→    assert!(state.source_water_catalog.contains_key(\"moderate\"));\n    32→    assert!(state.source_water_catalog.contains_key(\"hard_shrimp\"));\n    33→    assert!(state.source_water_catalog.contains_key(\"ro_like\"));\n    34→\n    35→    // Initial water chemistry comes from soft_acidic profile\n    36→    let sw = &state.source_water_catalog[\"soft_acidic\"];\n    37→    let vol = state.geometry.water_volume_l();\n    38→    assert!(\n    39→        (state.water.calcium_mg_total - sw.calcium_mg_per_l * vol).abs() < 0.01,\n    40→        \"Calcium should match source water * volume\"\n    41→    );\n    42→    assert!(\n    43→        (state.water.temperature_c - sw.temperature_c).abs() < 0.01,\n    44→        \"Initial water temp should match source water\"\n    45→    );\n    46→\n    47→    // Substrate: single inert_sand layer\n    48→    assert_eq!(state.substrate_layers.len(), 1);\n    49→    assert_eq!(\n    50→        state.substrate_layers[0].kind,\n    51→        tank_core::SubstrateKind::InertSand\n    52→    );\n    53→\n    54→    // Plants: single fast_stem\n    55→    assert_eq!(state.plant_guilds.len(), 1);\n    56→    assert_eq!(state.plant_guilds[0].guild, tank_core::PlantGuild::FastStem);\n    57→\n    58→    // Process params should be non-default (loaded from preset)\n    59→    assert!(state.process_params.k_surface_w_per_m2_k > 0.0);\n    60→    assert!(state.process_params.k_wall_w_per_m2_k > 0.0);\n    61→}\n    62→\n    63→#[test]\n    64→fn medium_planted_materializes_with_two_substrates_and_plants() {\n    65→    let state = tank_scenarios::seeded_state(SimSeed(43), \"medium_planted\")\n    66→        .expect(\"medium_planted should materialize\");\n    67→\n    68→    // Two substrate layers\n    69→    assert_eq!(state.substrate_layers.len(), 2);\n    70→    assert_eq!(\n    71→        state.substrate_layers[0].kind,\n    72→        tank_core::SubstrateKind::ActivePlanted\n    73→    );\n    74→    assert_eq!(\n    75→        state.substrate_layers[1].kind,\n    76→        tank_core::SubstrateKind::CoarsePorous\n    77→    );\n    78→\n    79→    // Two plant guilds\n    80→    assert_eq!(state.plant_guilds.len(), 2);\n    81→\n    82→    // Geometry: 60×30, 36cm height, 32cm filled\n    83→    assert!((state.geometry.length_cm - 60.0).abs() < f64::EPSILON);\n    84→    assert!((state.geometry.fill_height_cm - 32.0).abs() < f64::EPSILON);\n    85→\n    86→    // Volume\n    87→    let expected_vol = 60.0 * 30.0 * 32.0 / 1000.0;\n    88→    let actual_vol = state.geometry.water_volume_l();\n    89→    assert!(\n    90→        (actual_vol - expected_vol).abs() < 0.01,\n    91→        \"Expected {expected_vol}L, got {actual_vol}L\"\n    92→    );\n    93→}\n    94→\n    95→#[test]\n    96→fn warm_room_materializes_with_high_ambient() {\n    97→    let state = tank_scenarios::seeded_state(SimSeed(44), \"warm_room\")\n    98→        .expect(\"warm_room should materialize\");\n    99→\n   100→    assert!((state.environment.ambient_temp_c - 29.0).abs() < f64::EPSILON);\n   101→}\n   102→\n   103→#[test]\n   104→fn deterministic_materialization() {\n   105→    let state_a = tank_scenarios::seeded_state(SimSeed(99), \"nano_cycle\")\n   106→        .expect(\"should materialize\");\n   107→    let state_b = tank_scenarios::seeded_state(SimSeed(99), \"nano_cycle\")\n   108→        .expect(\"should materialize\");\n   109→\n   110→    assert_eq!(state_a, state_b, \"Same seed + scenario must produce identical state\");\n   111→}\n   112→\n   113→#[test]\n   114→fn unknown_scenario_returns_error() {\n   115→    let result = tank_scenarios::seeded_state(SimSeed(1), \"nonexistent_scenario\");\n   116→    assert!(result.is_err());\n   117→}\n   118→"}]},"parent_tool_use_id":null,"session_id":"86001031-e08b-4ab4-a078-b934bda46f61","uuid":"80808760-5901-47da-8daa-71f84d7345cf","tool_use_result":{"type":"text","file":{"filePath":"/root/tank-simulation/crates/tank_scenarios/tests/materialization.rs","content":"use tank_core::SimSeed;\n\n#[test]\nfn nano_cycle_materializes_correctly() {\n    let state = tank_scenarios::seeded_state(SimSeed(42), \"nano_cycle\")\n        .expect(\"nano_cycle should materialize\");\n\n    // Geometry from scenario: 30×20, 20cm tall, 18cm filled\n    assert!((state.geometry.length_cm - 30.0).abs() < f64::EPSILON);\n    assert!((state.geometry.width_cm - 20.0).abs() < f64::EPSILON);\n    assert!((state.geometry.height_cm - 20.0).abs() < f64::EPSILON);\n    assert!((state.geometry.fill_height_cm - 18.0).abs() < f64::EPSILON);\n\n    // Volume: 30 * 20 * 18 / 1000 = 10.8L\n    let expected_vol = 30.0 * 20.0 * 18.0 / 1000.0;\n    let actual_vol = state.geometry.water_volume_l();\n    assert!(\n        (actual_vol - expected_vol).abs() < 0.01,\n        \"Volume should be {expected_vol}, got {actual_vol}\"\n    );\n\n    // Ambient from scenario\n    assert!((state.environment.ambient_temp_c - 24.0).abs() < f64::EPSILON);\n\n    // Meta\n    assert_eq!(state.meta.scenario_id.as_deref(), Some(\"nano_cycle\"));\n    assert_eq!(state.meta.notes.as_deref(), Some(\"Nano Cycle\"));\n\n    // Source water catalog should contain all presets\n    assert!(state.source_water_catalog.contains_key(\"soft_acidic\"));\n    assert!(state.source_water_catalog.contains_key(\"moderate\"));\n    assert!(state.source_water_catalog.contains_key(\"hard_shrimp\"));\n    assert!(state.source_water_catalog.contains_key(\"ro_like\"));\n\n    // Initial water chemistry comes from soft_acidic profile\n    let sw = &state.source_water_catalog[\"soft_acidic\"];\n    let vol = state.geometry.water_volume_l();\n    assert!(\n        (state.water.calcium_mg_total - sw.calcium_mg_per_l * vol).abs() < 0.01,\n        \"Calcium should match source water * volume\"\n    );\n    assert!(\n        (state.water.temperature_c - sw.temperature_c).abs() < 0.01,\n        \"Initial water temp should match source water\"\n    );\n\n    // Substrate: single inert_sand layer\n    assert_eq!(state.substrate_layers.len(), 1);\n    assert_eq!(\n        state.substrate_layers[0].kind,\n        tank_core::SubstrateKind::InertSand\n    );\n\n    // Plants: single fast_stem\n    assert_eq!(state.plant_guilds.len(), 1);\n    assert_eq!(state.plant_guilds[0].guild, tank_core::PlantGuild::FastStem);\n\n    // Process params should be non-default (loaded from preset)\n    assert!(state.process_params.k_surface_w_per_m2_k > 0.0);\n    assert!(state.process_params.k_wall_w_per_m2_k > 0.0);\n}\n\n#[test]\nfn medium_planted_materializes_with_two_substrates_and_plants() {\n    let state = tank_scenarios::seeded_state(SimSeed(43), \"medium_planted\")\n        .expect(\"medium_planted should materialize\");\n\n    // Two substrate layers\n    assert_eq!(state.substrate_layers.len(), 2);\n    assert_eq!(\n        state.substrate_layers[0].kind,\n        tank_core::SubstrateKind::ActivePlanted\n    );\n    assert_eq!(\n        state.substrate_layers[1].kind,\n        tank_core::SubstrateKind::CoarsePorous\n    );\n\n    // Two plant guilds\n    assert_eq!(state.plant_guilds.len(), 2);\n\n    // Geometry: 60×30, 36cm height, 32cm filled\n    assert!((state.geometry.length_cm - 60.0).abs() < f64::EPSILON);\n    assert!((state.geometry.fill_height_cm - 32.0).abs() < f64::EPSILON);\n\n    // Volume\n    let expected_vol = 60.0 * 30.0 * 32.0 / 1000.0;\n    let actual_vol = state.geometry.water_volume_l();\n    assert!(\n        (actual_vol - expected_vol).abs() < 0.01,\n        \"Expected {expected_vol}L, got {actual_vol}L\"\n    );\n}\n\n#[test]\nfn warm_room_materializes_with_high_ambient() {\n    let state = tank_scenarios::seeded_state(SimSeed(44), \"warm_room\")\n        .expect(\"warm_room should materialize\");\n\n    assert!((state.environment.ambient_temp_c - 29.0).abs() < f64::EPSILON);\n}\n\n#[test]\nfn deterministic_materialization() {\n    let state_a = tank_scenarios::seeded_state(SimSeed(99), \"nano_cycle\")\n        .expect(\"should materialize\");\n    let state_b = tank_scenarios::seeded_state(SimSeed(99), \"nano_cycle\")\n        .expect(\"should materialize\");\n\n    assert_eq!(state_a, state_b, \"Same seed + scenario must produce identical state\");\n}\n\n#[test]\nfn unknown_scenario_returns_error() {\n    let result = tank_scenarios::seeded_state(SimSeed(1), \"nonexistent_scenario\");\n    assert!(result.is_err());\n}\n","numLines":118,"startLine":1,"totalLines":118}}}
