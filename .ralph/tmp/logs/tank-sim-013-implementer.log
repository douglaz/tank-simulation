r.cleanliness_index =\ncrates/tank_core/src/invariants.rs:98:        state.hardware.filter.cleanliness_index.clamp(0.0, 1.0);\ncrates/tank_core/src/invariants.rs:102:    state.filter_state.clogging_index = state.filter_state.clogging_index.clamp(0.0, 1.0);\ncrates/tank_core/src/types/hardware.rs:23:pub struct FilterHardware {\ncrates/tank_core/src/types/hardware.rs:26:    pub cleanliness_index: f64,\ncrates/tank_core/src/types/hardware.rs:39:    pub filter: FilterHardware,\ncrates/tank_core/src/types/hardware.rs:44:pub struct FilterState {\ncrates/tank_core/src/types/hardware.rs:46:    pub clogging_index: f64,\ncrates/tank_core/src/types/hardware.rs:73:impl Default for FilterHardware {\ncrates/tank_core/src/types/hardware.rs:78:            cleanliness_index: 1.0,\ncrates/tank_core/src/types/hardware.rs:92:impl Default for FilterState {\ncrates/tank_core/src/types/hardware.rs:96:            clogging_index: 0.0,\ncrates/tank_core/src/types/mod.rs:23:    AerationState, FilterHardware, FilterState, HardwareState, HeaterState, LightState,\n","exit_code":0,"status":"completed"}}
